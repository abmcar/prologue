+/// EXP-181 (`srdiag`): the state-root task's times of the current block: task start, finish marker processed, all
+/// proofs processed, root computed, and the proof results received after the finish marker.
+static SR_TASK: Mutex<Option<(Instant, Instant, Instant, Instant, u64)>> = parking_lot::const_mutex(None);
+/// EXP-182 (`srdiag`): where the time of payload_validator `execute_block` outside the transactions goes, for the
+/// current block (µs): the EAP set-up (mode, state-root diagnostics, `BlockPrefetch::start`), the rest before the first
+/// transaction (EVM, precompile cache, receipt-root task, hooks), the transactions with the executor's finish, from there
+/// to the `BlockPrefetch` drop, the drop, and inside the drop the readers' join (the hand-off with `rdjoinlate`) and the
+/// rest after it (key trace, call counts, the `eap block` line). Timing only; logged and cleared in the `eap sr` line.
+static XB_TIMES: [AtomicU64; 7] = [
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+];
+
+/// EXP-182 (`srdiag`): records the instants of `execute_block`: its start, the EAP set-up done, the first transaction and
+/// the executor's finish (`tx`), the `BlockPrefetch` drop begun and done.
+pub fn xb_record(start: Instant, setup: Instant, tx: Option<(Instant, Instant)>, drop_start: Instant, drop_end: Instant) {
+    if !srdiag() {
+        return
+    }
+    let us = |a: Instant, b: Instant| b.saturating_duration_since(a).as_micros() as u64;
+    XB_TIMES[0].store(us(start, setup), Ordering::Relaxed);
+    if let Some((x0, x1)) = tx {
+        XB_TIMES[1].store(us(setup, x0), Ordering::Relaxed);
+        XB_TIMES[2].store(us(x0, x1), Ordering::Relaxed);
+        XB_TIMES[3].store(us(x1, drop_start), Ordering::Relaxed);
+    }
+    XB_TIMES[4].store(us(drop_start, drop_end), Ordering::Relaxed);
+}
+
+/// EXP-181 (`srdiag`): the end of execution and the proof workers' counters then (tid, major faults, run ns, wait ns).
+static SR_EXEC: Mutex<Option<(Instant, Vec<(u32, u64, u64, u64)>)>> = parking_lot::const_mutex(None);
+/// EXP-181 (`srdiag`): thread ids of the proof workers (threads named `proof-*`), found at a block's start.
+static PROOF_TIDS: Mutex<Vec<u32>> = parking_lot::const_mutex(Vec::new());
+
+/// EXP-181 (`srdiag`): whether the current block records the state-root diagnostics.
+pub fn srdiag() -> bool {
+    let m = current();
+    m.active && m.srdiag
+}
+
+/// EXP-181 (`srdiag`): finds the proof workers' thread ids (once, and again every 256 blocks).
+pub fn sr_block_start() {
+    if !srdiag() {
+        return
+    }
+    *SR_TASK.lock() = None;
+    *SR_EXEC.lock() = None;
+    let mut tids = PROOF_TIDS.lock();
+    if !tids.is_empty() && BLOCKS.load(Ordering::Relaxed) % 256 != 0 {
+        return
+    }
+    tids.clear();
+    if let Ok(rd) = std::fs::read_dir("/proc/self/task") {
+        for e in rd.flatten() {
+            let Some(tid) = e.file_name().to_str().and_then(|x| x.parse::<u32>().ok()) else { continue };
+            if std::fs::read_to_string(e.path().join("comm")).is_ok_and(|c| c.starts_with("proof-")) {
+                tids.push(tid);
+            }
+        }
+    }
+}
+
+/// Major faults, run ns and wait ns of thread `tid` of this process (0s when it is gone).
+fn thread_counters(tid: u32) -> (u64, u64, u64) {
+    let majflt = std::fs::read_to_string(format!("/proc/self/task/{tid}/stat"))
+        .ok()
+        .and_then(|s| s.rsplit_once(')').map(|(_, r)| r.split_whitespace().nth(9).and_then(|x| x.parse().ok()).unwrap_or(0)))
+        .unwrap_or(0);
+    let (run, wait) = std::fs::read_to_string(format!("/proc/self/task/{tid}/schedstat"))
+        .ok()
+        .map(|s| {
+            let mut it = s.split_whitespace().map(|x| x.parse::<u64>().unwrap_or(0));
+            (it.next().unwrap_or(0), it.next().unwrap_or(0))
+        })
+        .unwrap_or((0, 0));
+    (majflt, run, wait)
+}
+
+/// EXP-181 (`srdiag`): the execution of the block ended.
+pub fn sr_exec_end() {
+    if !srdiag() {
+        return
+    }
+    let t = Instant::now();
+    let tids = PROOF_TIDS.lock().clone();
+    let c = tids.iter().map(|&tid| {
+        let (f, r, w) = thread_counters(tid);
+        (tid, f, r, w)
+    });
+    *SR_EXEC.lock() = Some((t, c.collect()));
+    // EXP-183: the thread groups are sampled by the background thread, not here (the block's control tag pairs the two
+    // samples; the driver writes the block number there)
+    sr_bg_send(SrBg::ExecEnd(u64::from(current().tag), t));
+}
