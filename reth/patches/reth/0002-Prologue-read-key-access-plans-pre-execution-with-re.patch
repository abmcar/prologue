+/// EXP-199 (`ew`): a worker of EAP's own prewarm mechanism exits: transactions run (heavy among them), transactions
+/// skipped because the execution thread had passed them or the block had stopped, time from dispatch to start and run
+/// time of the heavy and the other transactions, and the thread's CPU time.
+#[expect(clippy::too_many_arguments)]
+pub fn ew_worker_exit(block: u64, worker: u32, reserved: bool, runs: u32, heavy: u32, skipped: u32, wait_ns: [u64; 2], run_ns: [u64; 2]) {
+    // X-031 (record only): summed for the block's xbtl2 line
+    let runq = raw_thread_runq_ns().saturating_sub(JOB_RUNQ0.with(|c| c.get()));
+    for (i, v) in [1, runs as u64, skipped as u64, wait_ns[0] + wait_ns[1], run_ns[0] + run_ns[1], thread_cpu_ns(), runq, heavy as u64]
+        .into_iter()
+        .enumerate()
+    {
+        EW_SUM[i].fetch_add(v, Ordering::Relaxed);
+    }
+    eap_info!(
+        target: "reth::eap",
+        block,
+        worker,
+        reserved,
+        runs,
+        heavy,
+        skipped,
+        heavy_wait_us = wait_ns[0] / 1000,
+        light_wait_us = wait_ns[1] / 1000,
+        heavy_run_us = run_ns[0] / 1000,
+        light_run_us = run_ns[1] / 1000,
+        cpu_us = thread_cpu_ns() / 1000,
+        "eap ew exit"
+    );
+    sr_thread_exit();
+}
