+    /// EXP-199 (`ewnear`): the window (the next `n` transactions after the one executing; before the first, the first `n`)
+    /// and the catch-up.
+    #[test]
+    fn ewnear_window() {
+        assert_eq!(near_state(0, u32::MAX, 2, false, false), (true, false));
+        assert_eq!(near_state(1, u32::MAX, 2, false, false), (true, false));
+        assert_eq!(near_state(2, u32::MAX, 2, false, false), (false, false));
+        assert_eq!(near_state(5, 4, 2, false, false), (true, false));
+        assert_eq!(near_state(6, 4, 2, false, false), (true, false));
+        assert_eq!(near_state(7, 4, 2, false, false), (false, false));
+        assert_eq!(near_state(4, 4, 2, false, false), (false, true));
+        assert_eq!(near_state(3, 4, 2, false, false), (false, true));
+        assert_eq!(near_state(5, 4, 1, false, false), (true, false));
+        assert_eq!(near_state(6, 4, 1, false, false), (false, false));
+        // the largest index a run can carry (`near_run` clamps to u32::MAX - 1)
+        assert_eq!(near_state(u32::MAX - 1, u32::MAX - 2, 2, false, false), (true, false));
+        assert_eq!(near_state(u32::MAX - 1, u32::MAX - 1, 2, false, false), (false, true));
+        assert_eq!(near_state(u32::MAX - 1, u32::MAX, 2, false, false), (false, false));
+        // X-029 (`ewnearkeep`): the executing transaction stays in the window, caught up only once the execution thread
+        // is past it; before the first transaction and beyond the window nothing changes
+        assert_eq!(near_state(4, 4, 2, true, false), (true, false));
+        assert_eq!(near_state(3, 4, 2, true, false), (false, true));
+        assert_eq!(near_state(5, 4, 2, true, false), (true, false));
+        assert_eq!(near_state(6, 4, 2, true, false), (true, false));
+        assert_eq!(near_state(7, 4, 2, true, false), (false, false));
+        assert_eq!(near_state(4, 4, 1, true, false), (true, false));
+        assert_eq!(near_state(0, u32::MAX, 2, true, false), (true, false));
+        assert_eq!(near_state(2, u32::MAX, 2, true, false), (false, false));
+        assert_eq!(near_state(u32::MAX - 1, u32::MAX - 1, 2, true, false), (true, false));
+        assert_eq!(near_state(u32::MAX - 2, u32::MAX - 1, 2, true, false), (false, true));
+        // X-029 (`ewnearkeep`): once the block's execution has ended nothing is raised or kept raised, the last
+        // transaction's run included; without the switch the end changes nothing
+        assert_eq!(near_state(4, 4, 2, true, true), (false, true));
+        assert_eq!(near_state(5, 4, 2, true, true), (false, true));
+        assert_eq!(near_state(0, u32::MAX, 2, true, true), (false, true));
+        assert_eq!(near_state(5, 4, 2, false, true), (true, false));
+        assert_eq!(near_state(4, 4, 2, false, true), (false, true));
+    }
