+    /// Prologue (`nocons`, EXP-252): an index-free site group and an index-free call group whose constraint fails
+    /// (`CD(4) < 2` with CD(4) = 3) are dropped as before with the switch off and taken with it on; the family groups,
+    /// bounded by their index condition lists, give the same keys and calls either way
+    #[test]
+    fn no_cons_takes_index_free_groups_and_keeps_families() {
+        let mut b = batch_plan();
