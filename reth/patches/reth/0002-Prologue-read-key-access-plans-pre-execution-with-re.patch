+/// EXP-233: whether an inspected cache-filling prewarm run reports the balances its compiled code reads (revmc's
+/// balance callback, [`crate::tree::reuse::pw_balance_hook`]): with `reusebal` and the run on compiled code.
+/// Interpreted runs observe through the inspector's `step`. The prewarm EVM build takes `reusebal` from the inspector's
+/// own mode ([`EapPwInspector::records_balances`]), so the two cannot differ.
+pub fn pw_balance_hook_on(m: &Mode) -> bool {
+    m.reusebal && pw_jit_real(m, true)
+}
+
+/// D1 (`upreuse=1`): the switch on a parsed mode (see [`Mode::upreuse`]).
+pub(crate) fn upreuse_on_mode(m: &Mode) -> bool {
+    m.active && m.upreuse && m.reuse == 0
+}
+
+/// D1 (`upreuse=1`): whether reth's own prewarm-result reuse is on for the current block regardless of the node flag.
+pub(crate) fn upreuse_on() -> bool {
+    upreuse_on_mode(&current())
+}
+
+/// EXP-206, EXP-233: the balance rule's switch for [`crate::tree::reuse::set_mode`]; with `pwjitreal` too, since the
+/// compiled prewarm frames report their balance reads.
+pub(crate) fn reuse_bal_on(m: &Mode) -> bool {
+    m.active && m.reusebal
+}
+
+/// EXP-180 (`pwnbinterp=1`): the speculative and history passes run in the interpreter.
+pub fn nb_interp() -> bool {
+    current().pwnbinterp
+}
+
+/// EXP-180 (`pwnbbhroot`): the highest block whose state root is known (set by [`sr_root_done`] on every block, with or
+/// without `srdiag`), and its condition variable for the history passes waiting for it.
+static BH_ROOT: (Mutex<u64>, parking_lot::Condvar) = (parking_lot::const_mutex(0), parking_lot::Condvar::new());
+
+/// EXP-180: block `block`'s state root is known.
+fn bh_root_known(block: u64) {
+    let mut g = BH_ROOT.0.lock();
+    if block > *g {
+        *g = block;
+    }
+    BH_ROOT.1.notify_all();
+}
+
+/// EXP-180 (`pwnbbhroot`): waits until block `block`'s state root is known, at most `timeout`; whether it is.
+pub fn bh_wait_root(block: u64, timeout: Duration) -> bool {
+    let deadline = Instant::now() + timeout;
+    let mut g = BH_ROOT.0.lock();
+    while *g < block {
+        if BH_ROOT.1.wait_until(&mut g, deadline).timed_out() {
+            return *g >= block
+        }
+    }
+    true
+}
+
+/// EXP-129 second segment: helper threads of the early-started pass (`pwnbearly`), 0 = not early.
+pub fn nb_early() -> u32 {
+    let m = current();
