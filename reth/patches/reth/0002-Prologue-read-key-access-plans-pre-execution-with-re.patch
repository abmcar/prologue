+    /// EXP-199 (`exrt`): without `exrt` the guard is `None` and nothing changes; with it the thread runs as SCHED_FIFO
+    /// while the guard lives (with RLIMIT_RTPRIO or CAP_SYS_NICE) and dropping the guard restores the class and the nice
+    /// value; or the change is refused, counted, and the thread stays as it was. A thread of its own, so no other test's
+    /// thread changes class. The priority is passed in and the outcome returned, so other tests calling `refresh` (which
+    /// resets `EX_RT` and `EX_RT_STATE`) in parallel do not disturb it; the refusal count only grows. The thread keeps the
+    /// class the test runner gave it (SCHED_OTHER or SCHED_BATCH, e.g. a build job under `chrt -b`); under another class
+    /// the raise-and-restore part is skipped, as the execution thread is never in one.
+    #[test]
+    fn exec_rt_raises_and_restores_or_counts_the_refusal() {
+        std::thread::spawn(|| {
+            // SAFETY: getpriority / sched_getscheduler read the calling thread only (who 0 = the calling thread).
+            let nice0 = unsafe { libc::getpriority(libc::PRIO_PROCESS, 0) };
+            let pol = || unsafe { libc::sched_getscheduler(0) } & !libc::SCHED_RESET_ON_FORK;
+            let pol0 = pol();
+            assert!(exec_rt_enter_with(0, false).is_none() && !exec_rt_on());
+            assert_eq!(pol(), pol0);
+            if pol0 != libc::SCHED_OTHER && pol0 != libc::SCHED_BATCH {
+                return
+            }
+            let refused0 = exec_rt_state().1;
+            let (g, state) = exec_rt_enter_with(1, false).expect("a guard for exrt=1");
+            if state == 1 {
+                assert_eq!(pol(), libc::SCHED_FIFO);
+                assert!(exec_rt_on());
+                drop(g);
+                assert_eq!(pol(), pol0);
+                assert_eq!(unsafe { libc::getpriority(libc::PRIO_PROCESS, 0) }, nice0);
+                assert!(!exec_rt_on());
+            } else {
+                let refused = exec_rt_state().1;
+                assert!(state < 0 && refused > refused0, "state {state}, refused {refused0} -> {refused}");
+                assert_eq!(pol(), pol0);
+                assert!(!exec_rt_on());
+                drop(g);
+                assert_eq!(pol(), pol0);
+            }
+        })
+        .join()
+        .unwrap();
+    }
