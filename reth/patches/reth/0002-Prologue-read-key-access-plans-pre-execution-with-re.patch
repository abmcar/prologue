+/// EXP-122: non-blocking pass parameters of the current block: (gas-limit threshold, use branch history).
+pub fn nb_params() -> Option<(u64, bool)> {
+    let m = current();
+    (m.active && m.pwnb && m.pwcs > 0).then_some((m.pwnbgas, m.pwnbhist))
+}
