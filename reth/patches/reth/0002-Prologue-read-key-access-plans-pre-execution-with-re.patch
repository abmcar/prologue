+/// EXP-199 (`ewprio`): the dispatch's plan predictions (transactions with a prediction, predicted uncached slots,
+/// transactions moved into the heavy class).
+pub fn ew_native_log(block: u64, pred: [u64; 3]) {
+    eap_info!(target: "reth::eap", block, pred_txs = pred[0], pred_slots = pred[1], pred_promoted = pred[2], "eap ew native");
