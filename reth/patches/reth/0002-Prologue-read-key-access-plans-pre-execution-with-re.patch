+/// X-029 (`ewfeed` bit 4): recovers the next transaction in claim order into its slot, sends it to the prewarm channel
+/// and wakes the releasing thread; false once every transaction is claimed (or the release stopped claims).
+fn claim_ordered<RawTx, Tx, TxEnv, InnerTx, Recovered, Err, C>(
+    sh: &OrderedRecovery<
+        RawTx,
+        Result<WithTxEnv<TxEnv, Recovered>, Err>,
+        C,
+        mpsc::SyncSender<(usize, WithTxEnv<TxEnv, Recovered>)>,
+    >,
+) -> bool
+where
+    Tx: ExecutableTxParts<TxEnv, InnerTx, Recovered = Recovered>,
+    InnerTx: alloy_consensus::Transaction,
+    Recovered: reth_evm::RecoveredTx<InnerTx>,
+    TxEnv: Clone,
+    C: ConvertTx<RawTx, Tx = Tx, Error = Err>,
+{
+    let c = sh.next.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    let Some(&i) = sh.order.get(c) else { return false };
+    let Some(raw_tx) = sh.raw[i].lock().take() else { return true };
+    let tx = sh.convert.convert(raw_tx).map(WithTxEnv::new);
+    if let (Some(prewarm_tx), Ok(t)) = (&sh.prewarm, &tx) {
+        let _ = prewarm_tx.send((i + sh.prefetch, t.clone()));
+    }
+    sh.slots.lock()[i] = Some(tx);
+    sh.cv.notify_one();
+    true
+}
