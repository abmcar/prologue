+/// EXP-240 (`srpf`): seeks `cursor` to the prefixes of the target's path, from one below its known
+/// parent (length 1 without one) to `depth`. Returns the number of seeks.
+fn srpf_trie_seeks(
+    cursor: &mut impl TrieCursor,
+    target: &ProofV2Target,
+    depth: usize,
+) -> Result<u64, DatabaseError> {
+    let from = target.parent.path_len().map_or(1, |len| len + 1);
+    let mut seeks = 0;
+    for len in from..=depth.min(target.key_nibbles.len()) {
+        cursor.seek_exact(target.key_nibbles.slice(..len))?;
+        seeks += 1;
+    }
+    Ok(seeks)
+}
