+/// The readers' queue counters: nanoseconds since the first call (a monotonic clock for the hand-off times of items).
+pub fn rq_now() -> u64 {
+    static T0: std::sync::LazyLock<Instant> = std::sync::LazyLock::new(Instant::now);
+    T0.elapsed().as_nanos() as u64
+}
+
+/// Calls per code hash seen by the prewarm workers since the node started (`pwmin`).
+static CALLS: std::sync::LazyLock<Mutex<HashMap<B256, u32>>> = std::sync::LazyLock::new(Default::default);
+
+/// Counts a call to `code` and returns whether its plan may be used under `pwmin` (compile-triggered plans).
+fn compiled(code: B256, pwmin: u32) -> bool {
+    // EXP-160: count also when `pwmin=0`, so that `cnt=1` blocks without the gate count for the blocks that have it
+    let mut g = reth_execution_cache::lkprof::lock(reth_execution_cache::lkprof::CALLS, &CALLS);
+    let c = g.entry(code).or_insert(0);
+    *c = c.saturating_add(1);
+    pwmin == 0 || *c > pwmin
+}
+
+/// EXP-160 (`sysk=1`): storage slots written by the block-start system calls, whose original values are read first:
+/// EIP-4788 beacon roots (timestamp % 8191 and the root slot + 8191) and EIP-2935 block hashes ((number - 1) % 8191).
+fn sys_slots(info: &BlockInfo) -> [(Address, Vec<U256>); 2] {
+    let w = U256::from(8191u64);
+    let ts = info.timestamp % w;
+    let n = info.number.saturating_sub(U256::from(1u64)) % w;
+    [
+        (address!("0x000F3df6D732807Ef1319fB7B8bB8522d0Beac02"), vec![ts, ts + w]),
+        (address!("0x0000F90827F1C53a10cb7A02335B175320002935"), vec![n]),
+    ]
+}
+
+/// EXP-169 (`sysn`): the storage slots the block-start system calls of the block after `info` write, whose original
+/// values that block reads first: EIP-2935 block hashes (number % 8191) and EIP-4788 beacon roots (timestamp % 8191 and
+/// + 8191) for the next slot (+ 12 s), with `both` also for the slot after it (+ 24 s, one missed slot). The + 24 s guess
+/// also covers the EIP-4788 slots of the block after next (EXP-169 section 7.1).
+pub fn sys_slots_next(info: &BlockInfo, both: bool) -> [(Address, Vec<U256>); 2] {
+    let w = U256::from(8191u64);
+    let n = info.number % w;
+    let t1 = (info.timestamp + U256::from(12u64)) % w;
+    let mut ts = vec![t1, t1 + w];
+    if both {
+        let t2 = (info.timestamp + U256::from(24u64)) % w;
+        ts.extend([t2, t2 + w]);
+    }
+    [(address!("0x0000F90827F1C53a10cb7A02335B175320002935"), vec![n]), (address!("0x000F3df6D732807Ef1319fB7B8bB8522d0Beac02"), ts)]
+}
+
+/// EXP-169: this block's `sysn` switch (0 off, 1 the next slot, 2 also the slot after it).
+pub fn sysn() -> u8 {
+    let m = current();
+    if m.active { m.sysn } else { 0 }
+}
+
+/// EXP-169: this thread's (CPU time, run-queue wait) in nanoseconds (schedstat).
+pub fn thread_sched_ns() -> (u64, u64) {
+    let s = std::fs::read_to_string("/proc/thread-self/schedstat").unwrap_or_default();
+    let mut it = s.split_whitespace().map(|x| x.parse::<u64>().unwrap_or(0));
+    (it.next().unwrap_or(0), it.next().unwrap_or(0))
+}
+
+/// EXP-247 (`pwru`, X-029): a reader job's run-queue wait, the calling thread's schedstat run_delay (the file
+/// [`thread_cpu_ns`] reads). `start(true)` reads it, `start(false)` reads nothing; `add_to` adds the wait since the start
+/// to a counter, and does nothing when not started.
+#[derive(Debug)]
+struct RdWait(Option<u64>);
+
+impl RdWait {
+    fn start(on: bool) -> Self {
+        Self(on.then(|| thread_sched_ns().1))
+    }
+
+    fn add_to(&self, c: &AtomicU64) {
+        if let Some(w0) = self.0 {
+            c.fetch_add(thread_sched_ns().1.saturating_sub(w0), Ordering::Relaxed);
+        }
+    }
+}
+
+/// EXP-169: the next block's system-call slots were read at block end: slots inserted, already cached, read time.
+pub fn sysn_log(block: u64, inserted: u32, cached: u32, read_us: u64) {
+    eap_info!(target: "reth::eap", block, inserted, cached, read_us, "eap sysn");
+}
+
+/// EXP-235 (`pl`): the read lists of `EAP_PL` by block number, loaded at the first block with `pl=1` (a later line of a
+/// block replaces an earlier one; empty without `EAP_PL` or when the file cannot be opened).
+static PL_LISTS: OnceLock<HashMap<u64, Box<[PlKey]>>> = OnceLock::new();
+
+/// EXP-235 (`pl`): the read lists of `EAP_PL` ([`PL_LISTS`]); the load logs one `eap pl loaded` line (blocks, lines
+/// that do not parse, load time).
+fn pl_lists() -> &'static HashMap<u64, Box<[PlKey]>> {
+    PL_LISTS.get_or_init(|| {
+        let Some(path) = std::env::var_os("EAP_PL") else {
+            warn!(target: "reth::eap", "pl=1 without EAP_PL, no read lists");
+            return HashMap::new()
+        };
+        let t0 = Instant::now();
+        let file = match std::fs::File::open(&path) {
+            Ok(f) => f,
+            Err(err) => {
+                warn!(target: "reth::eap", %err, "cannot open EAP_PL, no read lists");
+                return HashMap::new()
+            }
+        };
+        let mut lists = HashMap::new();
+        let mut bad_lines = 0u64;
+        for line in std::io::BufRead::lines(std::io::BufReader::new(file)) {
+            // a read error ends the load (counted as a bad line)
+            let Ok(line) = line else {
+                bad_lines += 1;
+                break
+            };
+            match reth_execution_cache::pl_parse_line(&line) {
+                Some((block, keys)) => {
+                    lists.insert(block, keys.into_boxed_slice());
+                }
+                None => bad_lines += 1,
+            }
+        }
+        info!(
+            target: "reth::eap",
+            blocks = lists.len(),
+            bad_lines,
+            load_ms = t0.elapsed().as_millis() as u64,
+            "eap pl loaded"
+        );
+        lists
+    })
+}
+
+/// EXP-235 (`pl`): a block's recorded read list as reader items in first-read order, tagged `CC_SRC_EAP_PL`: an account
+/// as [`Item::Acct`], a code as [`Item::Code`], and each run of consecutive slots of one address as one [`Item::Keys`]
+/// (a reader reads its first slot and hands the others to the readers' slot channel, as for any `Keys` item).
+fn pl_items(keys: &[PlKey]) -> Vec<Item> {
+    let src = reth_execution_cache::CC_SRC_EAP_PL;
+    let mut out = Vec::new();
+    for key in keys {
+        match *key {
+            PlKey::Account(a) => out.push(Item::Acct(a, src, u32::MAX)),
+            PlKey::Code(h) => out.push(Item::Code(h, src)),
+            PlKey::Storage(a, slot) => {
+                let k = U256::from_be_bytes(slot.0);
+                if let Some(Item::Keys(run)) = out.last_mut() &&
+                    run.0 == a
+                {
+                    run.1.push(k);
+                } else {
+                    out.push(Item::Keys(Box::new((a, vec![k], u32::MAX, src, rq_now()))));
+                }
+            }
+        }
+    }
+    out
+}
+
+/// EXP-235 (`pl`): sends the block's recorded read list (`None`: `EAP_PL` has none for the block) to the readers and
+/// counts its keys by kind.
+fn pl_send(tx: &Sender<Item>, stats: &Stats, keys: Option<&[PlKey]>) {
+    let Some(keys) = keys else {
+        stats.pl_missing_block.fetch_add(1, Ordering::Relaxed);
+        return
+    };
+    for key in keys {
+        let c = match key {
+            PlKey::Account(_) => &stats.pl_accts,
+            PlKey::Storage(..) => &stats.pl_slots,
+            PlKey::Code(_) => &stats.pl_codes,
+        };
+        c.fetch_add(1, Ordering::Relaxed);
+    }
+    for it in pl_items(keys) {
+        let _ = tx.send(it);
+    }
+}
