+        let sys = ru.ru_stime.tv_sec as u64 * 1_000_000 + ru.ru_stime.tv_usec as u64;
+        (cpu, ru.ru_minflt as u64, ru.ru_nvcsw as u64, ru.ru_nivcsw as u64, sys)
+    }
+
+    fn record_usage(i: usize) {
+        let (cpu, flt, vcs, ics, sys) = thread_usage();
+        SYS[i].store(sys, Ordering::Relaxed);
+        C[i].store(cpu + 1, Ordering::Relaxed);
+        FLT[i].store(flt, Ordering::Relaxed);
+        VCS[i].store(vcs, Ordering::Relaxed);
+        ICS[i].store(ics, Ordering::Relaxed);
+    }
