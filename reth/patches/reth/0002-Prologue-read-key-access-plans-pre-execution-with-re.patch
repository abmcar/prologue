+        let mut g = reth_execution_cache::lkprof::lock(reth_execution_cache::lkprof::EWQUEUE, &self.inner);
+        if g.split {
+            let mut waiting = false;
+            loop {
+                if heavy_only && !g.closed {
+                    if let Some(j) = g.hq.pop() {
+                        if waiting {
+                            g.waiting_res -= 1;
+                        }
+                        return Some(j)
+                    }
+                    if !waiting {
+                        g.waiting_res += 1;
+                        waiting = true;
+                    }
+                } else {
+                    if waiting {
+                        g.waiting_res -= 1;
+                        waiting = false;
+                    }
+                    // a heavy job handed to a waiting reserved worker stays its own until the dispatch has ended
+                    if g.closed && let Some(j) = g.hq.pop() {
+                        return Some(j)
+                    }
+                    if let Some((_, j)) = g.ordered.pop_first() {
+                        return Some(j)
+                    }
+                    if g.closed {
+                        return None
+                    }
+                }
+                self.cv.wait(&mut g);
+            }
+        }
+        loop {
+            let closed = g.closed;
+            if g.heap.peek().is_some_and(|j| j.heavy || !heavy_only || closed) {
+                return g.heap.pop()
+            }
+            if closed && g.heap.is_empty() {
+                return None
+            }
+            if g.targeted {
+                // X-029: a reserved worker waits for a heavy job (or the close) on its own condition variable. Light jobs
+                // left here mean the heavy job it was signalled for went to another worker: the wake-up goes on to an idle
+                // non-reserved worker (parking_lot's condition variables do not wake spuriously)
+                if heavy_only {
+                    if !g.heap.is_empty() && g.idle_any > 0 {
+                        g.idle_any -= 1;
+                        g.woken += 1;
+                        self.cv.notify_one();
+                    }
+                    g.idle_res += 1;
+                    self.cv_res.wait(&mut g);
+                } else {
+                    g.idle_any += 1;
+                    self.cv.wait(&mut g);
+                }
+            } else {
+                self.cv.wait(&mut g);
+            }
+        }
+    }
+}
