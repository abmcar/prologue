+    /// Prologue (`srrt`): priority 0 gives no guard and changes nothing; otherwise the thread runs as SCHED_FIFO while the
+    /// guard lives (with RLIMIT_RTPRIO or CAP_SYS_NICE), with its own I/O priority best-effort, and dropping it restores
+    /// the class, the nice value and the I/O priority; or the change is refused (minus the errno) and the thread stays as
+    /// it was, also after the guard drops. A thread of its own, so no other test's thread changes class; under a class
+    /// other than normal or batch (a test runner's choice) the raise is not attempted and the outcome is 0.
+    #[test]
+    fn sr_rt_raises_and_restores_or_reports_the_refusal() {
+        std::thread::spawn(|| {
+            // SAFETY: getpriority / sched_getscheduler read the calling thread only (who 0 = the calling thread).
+            let nice0 = unsafe { libc::getpriority(libc::PRIO_PROCESS, 0) };
+            let pol = || unsafe { libc::sched_getscheduler(0) } & !libc::SCHED_RESET_ON_FORK;
+            let pol0 = pol();
+            // SAFETY: ioprio_get with IOPRIO_WHO_PROCESS and who 0 reads the calling thread only.
+            let io = || unsafe { libc::syscall(libc::SYS_ioprio_get, IOPRIO_WHO_PROCESS, 0) };
+            let io0 = io();
+            assert!(sr_rt_enter(0).is_none());
+            assert_eq!(pol(), pol0);
+            let (g, state) = sr_rt_enter(1).expect("a guard for srrt=1");
+            if pol0 != libc::SCHED_OTHER && pol0 != libc::SCHED_BATCH && pol0 != libc::SCHED_IDLE {
+                assert_eq!((state, g.io), (0, 0));
+            } else if state == 1 {
+                assert_eq!(pol(), libc::SCHED_FIFO);
+                assert_eq!(g.io, i64::from(IOPRIO_CLASS_BE));
+                assert_eq!(io(), i64::from((IOPRIO_CLASS_BE << IOPRIO_CLASS_SHIFT) | IOPRIO_NORM));
+                drop(g);
+                assert_eq!(pol(), pol0);
+                assert_eq!(unsafe { libc::getpriority(libc::PRIO_PROCESS, 0) }, nice0);
+                assert_eq!(io(), io0);
+            } else {
+                assert!(state < 0, "state {state}");
+                assert_eq!((pol(), g.io, io()), (pol0, 0, io0));
+                drop(g);
+                assert_eq!((pol(), io()), (pol0, io0));
+            }
+        })
+        .join()
+        .unwrap();
+    }
