+    /// a beneficiary loaded with balance `loaded` and holding `now`
+    fn ben_state(ben: Address, loaded: u64, now: u64) -> PendingState {
+        let mut st = PendingState::default();
+        st.insert_account(
+            ben,
+            Some(AccountInfo { balance: U256::from(loaded), ..Default::default() }),
+            Some(AccountInfo { balance: U256::from(now), ..Default::default() }),
+        );
+        st
+    }
