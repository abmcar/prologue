+fn nb_log_read(a: Address, k: U256, v: U256, src: u8) {
+    if !nb_dump() {
+        return
+    }
+    let t = NB_T0.with(|c| c.get().map(|t0| t0.elapsed().as_nanos() as u64).unwrap_or(0));
+    NB_READS.with(|r| r.borrow_mut().push((a, k, v, src, t)));
+}
