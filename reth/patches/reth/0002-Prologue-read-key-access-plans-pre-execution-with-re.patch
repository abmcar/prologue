+/// Transaction fields handed to the reader threads at block start.
+#[derive(Debug)]
+pub struct TxInfo {
+    /// Index of the transaction in the block (`usize::MAX` for mempool-stage transactions).
+    idx: usize,
+    caller: Address,
+    to: Option<Address>,
+    input: Bytes,
+    value: U256,
+}
+
+/// Returns a sender for the transaction-arrival stage when it is enabled for this block; the
+/// receiver is kept for [`BlockPrefetch::start`]. Also starts the block's calldata-address channel (EXP-184).
+pub fn tx_sender() -> Option<Sender<TxInfo>> {
+    let m = current();
+    if !(m.active && m.tx) {
+        return None
+    }
+    // Prologue (`rdkick` with `prep`): the channel built between blocks
+    let (s, r) = m.rdkick.then(|| PREP_TXCH.lock().take()).flatten().unwrap_or_else(crossbeam_channel::unbounded);
+    *TX_RX.lock() = Some(r);
+    Some(s)
+}
+
+/// Prologue (`rdkick`): the readers' start job waiting for the converting thread, the transactions sent so far and the
+/// block's count, and whether the converting thread still looks at the slot.
+struct Kick {
+    job: Option<Box<dyn FnOnce() + Send>>,
+    sent: usize,
+    total: usize,
+    open: bool,
+}
+static KICK: Mutex<Kick> = parking_lot::const_mutex(Kick { job: None, sent: 0, total: 0, open: false });
+/// Prologue (`rdkick`): `KICK.open`, read without the lock on every transaction sent.
+static KICK_OPEN: AtomicBool = AtomicBool::new(false);
+/// Prologue (`rdkick`): this block's state for the `eap xbtl2` line: 1 handed over by the converting thread, 0 by the
+/// execution thread, -1 not used.
+pub static KICK_STATE: std::sync::atomic::AtomicI64 = std::sync::atomic::AtomicI64::new(-1);
+/// Prologue (`rdkick`): the previous block's pre-execution structures, dropped by the readers' start job.
+static KICK_OLD: Mutex<Option<Box<dyn std::any::Any + Send>>> = parking_lot::const_mutex(None);
+/// Prologue (`rdkick` with `prep`): the next block's readers' transaction channel, built between blocks.
+static PREP_TXCH: Mutex<Option<(Sender<TxInfo>, Receiver<TxInfo>)>> = parking_lot::const_mutex(None);
+
+/// Prologue (`rdkick`): at the transaction iterator's start, on the execution thread: opens the slot for a block of
+/// `total` transactions when the switch is on (closed for an empty block or without the transaction stage).
+pub fn kick_begin(total: usize) {
+    let m = current();
+    KICK_STATE.store(-1, Ordering::Relaxed);
+    let open = m.active && m.rdkick && m.tx && total > 0;
+    let mut g = KICK.lock();
+    g.job = None;
+    g.sent = 0;
+    g.total = total;
+    g.open = open;
+    KICK_OPEN.store(open, Ordering::Release);
+}
+
+/// Prologue (`rdkick`): on the execution thread, puts the readers' start job into the slot while the converting thread
+/// still looks at it (true); otherwise hands it back (false) for the caller to hand over itself.
+fn kick_post(job: Box<dyn FnOnce() + Send>) -> Result<(), Box<dyn FnOnce() + Send>> {
+    let mut g = KICK.lock();
+    if g.open {
+        g.job = Some(job);
+        Ok(())
+    } else {
+        Err(job)
+    }
+}
+
+/// Prologue (`rdkick`): closes the slot and hands a start job still in it to the helper thread (the converting thread
+/// did not take it).
+fn kick_reclaim() {
+    let job = {
+        let mut g = KICK.lock();
+        g.open = false;
+        KICK_OPEN.store(false, Ordering::Release);
+        g.job.take()
+    };
+    if let Some(job) = job {
+        rdstart(job);
+    }
+}
+
+/// Prologue (`rdkick`): on the converting thread, after a transaction was sent: counts it, closes the slot after the
+/// block's last one, and hands a waiting start job to the helper thread.
+fn kick_note_sent() {
+    let job = {
+        let mut g = KICK.lock();
+        g.sent += 1;
+        if g.sent >= g.total {
+            g.open = false;
+            KICK_OPEN.store(false, Ordering::Release);
+        }
+        g.job.take()
+    };
+    if let Some(job) = job {
+        rdstart(job);
+    }
+}
+
+/// EXP-130: the block's transactions (sender, recipient, selector, batch count of the calldata, creations a prewarm
+/// worker observed when it ran the transaction, when known) for the cross-transaction shift of created-address
+/// progressions ([`eap_lx::LxTracker::shift`]); indexed by transaction.
+static BLOCK_TXS: Mutex<Vec<Option<(Address, Option<Address>, u32, usize, Option<usize>, Bytes)>>> = parking_lot::const_mutex(Vec::new());
+
+/// EXP-151 (`c2rec`): the block's transactions before `cur` with recipient `to` and selector `sel` (sender, calldata),
+/// in block order.
+fn block_txs_before(cur: u32, to: Address, sel: u32) -> Vec<(Address, Bytes)> {
+    let g = BLOCK_TXS.lock();
+    g.iter().take(cur as usize).flatten().filter(|t| t.1 == Some(to) && t.2 == sel).map(|t| (t.0, t.5.clone())).collect()
+}
+
+/// EXP-151 (`c2rec`): the salt-template records of the directory `EAP_C2REC`, loaded once.
+fn c2records() -> Option<&'static eap_lx::c2rec::C2Records> {
+    static R: std::sync::OnceLock<Option<eap_lx::c2rec::C2Records>> = std::sync::OnceLock::new();
+    R.get_or_init(|| {
+        let dir = std::env::var_os("EAP_C2REC")?;
+        let (r, bad) = eap_lx::c2rec::C2Records::load(std::path::Path::new(&dir));
+        info!(target: "reth::eap", codes = r.by_code.len(), rejected = bad, "salt-template records loaded");
+        Some(r)
+    })
+    .as_ref()
+}
+
+/// EXP-130: addresses created by the block's earlier transactions of the same sender, recipient and selector as
+/// transaction `cur` (the sum of their observed creation counts, else the batch counts of their calldata), or 0.
+fn lx_shift_for(cur: u32) -> usize {
+    let g = BLOCK_TXS.lock();
+    let Some(Some(me)) = g.get(cur as usize) else { return 0 };
+    g[..cur as usize].iter().flatten().filter(|t| t.0 == me.0 && t.1 == me.1 && t.2 == me.2).map(|t| t.4.unwrap_or(t.3)).sum::<usize>().min(65536)
+}
+
+/// EXP-130: a prewarm worker finished transaction `tx` having seen `created` creations.
+fn lx_note_created(tx: u32, created: usize) {
+    let mut g = BLOCK_TXS.lock();
+    if let Some(Some(t)) = g.get_mut(tx as usize) {
+        t.4 = Some(created);
+    }
+}
+
+/// Forwards one converted transaction (sender `caller`) to the transaction-arrival stage.
+///
+/// X-027: 2.5.1 took revm's `TxEnv` (`Transaction` trait with `caller()`); 2.9.0 has no revm, so the sender is passed
+/// next to the transaction (`*recovered.signer()`, `recovered.inner()`).
+pub fn send_tx<T: alloy_consensus::Transaction + ?Sized>(sink: &Option<Sender<TxInfo>>, idx: usize, caller: Address, tx: &T) {
+    {
+        let m = current();
+        // X-027: the calldata-address channel (`cdaddr`, `cdst`, `cdscan`) is not ported
+        if m.pwlx && (m.pwlxc2 || m.c2rec) {
+            let input = tx.input();
+            let sel = input.get(..4).map(|b| u32::from_be_bytes([b[0], b[1], b[2], b[3]])).unwrap_or(0);
+            let count = eap_lx::lx_batch_count(input, m.pwlxn as usize).unwrap_or(0);
+            let mut g = BLOCK_TXS.lock();
+            if g.len() <= idx {
+                g.resize(idx + 1, None);
+            }
+            g[idx] = Some((caller, tx.kind().to().copied(), sel, count, None, if m.c2rec { input.clone() } else { Bytes::new() }));
+        }
+    }
+    if let Some(s) = sink {
+        let _ = s.send(TxInfo {
+            idx,
+            caller,
+            to: tx.kind().to().copied(),
+            input: tx.input().clone(),
+            value: tx.value(),
+        });
+    }
+    // Prologue (`rdkick`): the readers' start job waiting for this thread
+    if KICK_OPEN.load(Ordering::Acquire) {
+        kick_note_sent();
+    }
+}
+
+/// Builds a cache-filling state provider over the parent state for one reader thread.
+pub type ProviderFactory = Arc<dyn Fn() -> ProviderResult<EvmStateProviderBox> + Send + Sync>;
+
+/// EXP-240 (`accwarm`): the latest state without the execution cache, for the readers' warm reads of accounts the
+/// filter answered "absent"; set by the payload validator for the block it executes (`None` when the switch is off).
+static WARM_FACTORY: Mutex<Option<ProviderFactory>> = parking_lot::const_mutex(None);
+
+/// EXP-240 (`accwarm`): sets the provider factory of the block's warm reads.
+pub fn set_warm_factory(f: Option<ProviderFactory>) {
+    *WARM_FACTORY.lock() = f;
+}
+
+/// Block environment fields used by the plans.
+#[derive(Clone, Copy, Debug)]
+pub struct BlockInfo {
+    number: U256,
+    timestamp: U256,
+    coinbase: Address,
+    gas_limit: u64,
+    basefee: u64,
+    prevrandao: U256,
+}
+
+impl BlockInfo {
+    /// Reads the fields from an evm2 block environment (2.5.1: revm's `Block`; `gas_limit` and `basefee` were `u64`
+    /// there and saturate here, `prevrandao` was `Option<B256>`, `None` read as zero).
+    pub fn from_block<E>(b: &evm2::evm::env::BlockEnvExt<E>) -> Self {
+        Self {
+            number: b.number,
+            timestamp: b.timestamp,
+            coinbase: b.beneficiary,
+            gas_limit: b.gas_limit.saturating_to(),
+            basefee: b.basefee.saturating_to(),
+            prevrandao: b.prevrandao,
+        }
+    }
+
+    /// Block number.
+    pub const fn number(&self) -> U256 {
+        self.number
+    }
+
+    fn env(&self, caller: Address, origin: Address, addr: Address, value: U256, cd_len: usize) -> [U256; N_ENV] {
+        // CALLER ORIGIN ADDRESS CALLVALUE CALLDATASIZE NUMBER TIMESTAMP CHAINID COINBASE GASLIMIT
+        // BASEFEE PREVRANDAO BLOBBASEFEE CODESIZE, as in frame_plan's fp_run
+        [
+            a2u(caller),
+            a2u(origin),
+            a2u(addr),
+            value,
+            U256::from(cd_len),
+            self.number,
+            self.timestamp,
+            U256::from(1u8),
+            a2u(self.coinbase),
+            U256::from(self.gas_limit),
+            U256::from(self.basefee),
+            self.prevrandao,
+            U256::from(1u8),
+            U256::ZERO,
+        ]
+    }
+}
+
+fn a2u(a: Address) -> U256 {
+    U256::from_be_slice(a.as_slice())
+}
+
+fn new_scratch() -> Scratch {
+    let mut sc = Scratch::default();
+    sc.interval = true;
+    sc.improved = FPIMP.load(Ordering::Relaxed);
+    sc.sat_classes = SATCLS.load(Ordering::Relaxed);
+    sc.no_cons = NOCONS.load(Ordering::Relaxed);
+    sc
+}
+
+/// A thread's kept scratch for this block's instantiations: made on first use, with the block's plan-solver choice
+/// (`fpimp`) and satisfying-set cache (`satcls`) set every time, since the scratch outlives the block it was made in.
+/// Taken before a frame's instantiation, so `sat_classes` changes only between frames (frame_plan_v3 60f67280: never
+/// from off to on between `instantiate` and `instantiate_calls` of one frame, whose cache was sized for the setting).
+fn scratch_for_block(sc: &mut Option<Scratch>) -> &mut Scratch {
+    scratch_with(sc, FPIMP.load(Ordering::Relaxed), SATCLS.load(Ordering::Relaxed))
+}
+
+/// [`scratch_for_block`] with the choices given
+fn scratch_with(sc: &mut Option<Scratch>, improved: bool, sat_classes: bool) -> &mut Scratch {
+    let s = sc.get_or_insert_with(new_scratch);
+    s.improved = improved;
+    s.sat_classes = sat_classes;
+    s.no_cons = NOCONS.load(Ordering::Relaxed);
+    s
+}
+
+/// Counters of one block.
+#[derive(Debug, Default)]
+pub struct Stats {
+    frames: AtomicU64,
+    frames_plan: AtomicU64,
+    cs_keys: AtomicU64,
+    cs_ns: AtomicU64,
+    inst_ns: AtomicU64,
+    txs: AtomicU64,
+    txs_plan: AtomicU64,
+    tx_keys: AtomicU64,
+    reads: AtomicU64,
+    dup: AtomicU64,
+    read_ns: AtomicU64,
+    reader_busy_ns: AtomicU64,
+    /// EXP-150: readers inside `busy` right now (read at block end: readers still working when the block stops)
+    readers_busy: AtomicUsize,
+    miss_unpred: AtomicU64,
+    miss_queued: AtomicU64,
+    miss_inflight: AtomicU64,
+    miss_done: AtomicU64,
+    join_wait_ns: AtomicU64,
+    /// Call-start frames with a plan, by depth (outermost call of a transaction, inner call), and the
+    /// keys they predicted.
+    frames_plan_d0: AtomicU64,
+    frames_plan_d1: AtomicU64,
+    frames_d0: AtomicU64,
+    cs_keys_d0: AtomicU64,
+    cs_keys_d1: AtomicU64,
+    /// Misses on slots that were issued (queued or in flight) but not yet read, by issue source
+    /// (transaction arrival, outermost call start, inner call start).
+    miss_late_src: [AtomicU64; N_SRC],
+    /// Reads issued by the readers, by source.
+    reads_src: [AtomicU64; N_SRC],
+    /// Prewarm-worker call-start hook: frames seen, frames with a plan sent, keys predicted, hook time.
+    pw_frames: AtomicU64,
+    pw_jobs: AtomicU64,
+    pw_keys: AtomicU64,
+    pw_hook_ns: AtomicU64,
+    /// X-031 (EXP-269, record only): inside the hook, the plan's instantiation, the wait for the `PROBE` and `issued`
+    /// locks, and the dedup under `issued`; outside it, the worker's `pwlx` after the hook and in `step`.
+    pw_inst_ns: AtomicU64,
+    pw_lockw_ns: AtomicU64,
+    pw_dedup_ns: AtomicU64,
+    pw_lx_ns: AtomicU64,
+    pw_lxstep_ns: AtomicU64,
+    /// X-031 (EXP-269, record only): the execution thread's wait to take the `issued` lock at its cache misses; the
+    /// readers' hold time of it in `slot` and `queue` (sum, maximum, holds over 50 us).
+    ex_lockw_ns: AtomicU64,
