+    /// Prologue (`reusediag`): how a failed check records the run's observation of its account's balance, next to
+    /// `reusebal`'s decision on the same account, which still refuses every observed balance (the run read 5, the check
+    /// reads 7): observations not recorded (`-`), not observed (0, the only one accepted), read (1), only value sent out
+    /// of it, 7 covering the total (`2,y`, also when equal) or not (`2,n`), read and sent (3); `s` unknown when the check
+    /// read no balance (kind 1 for a sender the run did not load).
+    #[test]
+    fn reusediag_balance_observation_and_the_decision() {
+        let _g = GLOBAL.lock();
+        let (a, sender, ben) = (Address::repeat_byte(0xaa), Address::repeat_byte(0x11), Address::repeat_byte(0xbe));
+        let info = |b: u64| Some(AccountInfo { balance: U256::from(b), nonce: 1, ..Default::default() });
+        let mut st = PendingState::default();
+        st.insert_account(a, info(5), info(5));
+        let entry = |obs| Entry {
+            state: st.clone(),
+            result: Box::new(()),
+            touched: Vec::new(),
+            fee_only: false,
+            full_check: false,
+            run: 0,
+            bal_obs: obs,
+        };
+        let seen = |bits, sent: u64| {
+            Some(AddressMap::from_iter([(a, BalObs { bits, sent: U256::from(sent), ..Default::default() })]))
+        };
+        set_mode(2, 0, true, true, 0, false, 0);
+        for (obs, (o, s, accepted)) in [
+            (None, (None, None, false)),
+            (reads(&[]), (Some(0), None, true)),
+            (reads(&[a]), (Some(BalObs::READ), None, false)),
+            (seen(BalObs::SENT, 6), (Some(BalObs::SENT), Some(true), false)),
+            (seen(BalObs::SENT, 7), (Some(BalObs::SENT), Some(true), false)),
+            (seen(BalObs::SENT, 8), (Some(BalObs::SENT), Some(false), false)),
+            (seen(BalObs::READ | BalObs::SENT, 1), (Some(3), None, false)),
+        ] {
+            let e = entry(obs);
+            let acc = e.state.account_changes_for(&a).unwrap();
+            let relaxed = bal_relax(&e, &acc, info(7).as_ref(), acc.original, sender, ben).is_some();
+            let f = changed_info(&e, &acc, info(7).as_ref(), sender, ben);
+            assert_eq!((f.kind, f.diff, f.obs, f.covers, relaxed), (3, Some(1), o, s, accepted));
+        }
+        let f = fail(1, Some(a)).observed(&entry(seen(BalObs::SENT, 1)), None);
+        assert_eq!((f.obs, f.covers), (Some(BalObs::SENT), None));
+        set_mode(0, 0, false, false, 0, false, 0);
+    }
