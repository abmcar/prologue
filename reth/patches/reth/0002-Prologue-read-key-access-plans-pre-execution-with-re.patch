+            assert_eq!(p.fcgroups.len(), if ver >= 3 { 1 } else { 0 });
+            assert_eq!(p.cgroups.len(), if ver >= 2 { 1 } else { 0 });
+            if ver >= 3 { assert_eq!(p.fcgroups[0], b.fcgroups[0]); assert_eq!(p.fcalts[0], b.fcalts[0]); assert_eq!(p.fc_sel, vec![(S, 0, 1)]); }
