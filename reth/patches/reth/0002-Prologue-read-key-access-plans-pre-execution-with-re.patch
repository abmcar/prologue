+mod sr_threads_tests {
+    use super::{exit_supplement, group_window, sample_threads, sr_group, thread_exit_sample, ThreadSample};
+    use std::{
+        collections::HashMap,
+        time::{Duration, Instant},
+    };
+
+    /// EXP-183 (Master 10-26): a helper thread that ends inside the window is still counted, from its totals at its end
+    /// minus its first sample (or from zero when it started after the first sample); an end before the window or a thread
+    /// still alive at the second sample adds nothing.
+    #[test]
+    fn a_thread_ending_inside_the_window_is_still_counted() {
+        let s0 = Instant::now();
+        let (t_in, s1) = (s0 + Duration::from_millis(1), s0 + Duration::from_millis(2));
+        let a: ThreadSample = HashMap::from_iter([(2, (5, 2_000_000, 0)), (3, (6, 1_000_000, 0)), (4, (5, 0, 0))]);
+        let b: ThreadSample = HashMap::from_iter([(4, (5, 9_000_000, 0))]);
+        let exits = HashMap::from_iter([
+            (2, (t_in, 5, 5_000_000, 1_000_000)),   // ended inside the window
+            (7, (t_in, 5, 400_000, 100_000)),       // started after the first sample, ended inside
+            (3, (s0 - Duration::from_millis(1), 6, 3_000_000, 0)), // ended before the window
+            (4, (t_in, 5, 1, 1)),                   // still alive at the second sample: already counted
+        ]);
+        let (n, run, wait) = exit_supplement(&a, &b, &exits, s0, s1);
+        assert_eq!((n[5], run[5], wait[5]), (2, 3_000 + 400, 1_000 + 100));
+        assert_eq!((n[6], run[6], wait[6]), (0, 0, 0));
+        // without the supplement the ended thread's 3 ms after the first sample would be lost
+        let w = group_window(&a, &b);
+        assert_eq!((w.ended[5], w.run_us[5]), (1, 9_000));
+    }
+
+    /// EXP-183: a thread reads its own id and totals at its end.
+    #[test]
+    fn a_thread_reads_its_own_totals_at_its_end() {
+        let (tid, run, _) = std::thread::Builder::new()
+            .name("eap-nb".into())
+            .spawn(|| {
+                let t0 = Instant::now();
+                let mut x = 0u64;
+                while t0.elapsed() < Duration::from_millis(20) {
+                    x = x.wrapping_add(1);
+                }
+                std::hint::black_box(x);
+                let s = thread_exit_sample().unwrap();
+                // SAFETY: gettid has no preconditions
+                assert_eq!(s.0, unsafe { libc::gettid() } as u32);
+                s
+            })
+            .unwrap()
+            .join()
+            .unwrap();
+        assert!(tid > 0 && run > 0);
+    }
+
+    /// EXP-183: thread names map to the sampler's groups (names as the kernel keeps them, at most 15 bytes).
+    #[test]
+    fn thread_names_map_to_groups() {
+        for (c, g) in [
+            ("proof-strg-3", 0),
+            ("proof-acct-0", 0),
+            ("sparse-trie", 1),
+            ("engine", 2),
+            ("storage-workers", 3),
+            ("account-workers", 3),
+            ("prewarm", 4),
+            ("prewarm-txs", 4),
+            ("eap-nb", 5),
+            ("eap-heavy", 6),
+            ("eap-split", 7),
+            ("eap-read-12", 8),
+            ("trie-hashing", 9),
+            ("hash-post-state", 9),
+            ("tokio-rt", 10),
+            ("eap-srbg", 10),
+        ] {
+            assert_eq!(sr_group(c), g, "{c}");
+        }
+    }
+
+    /// EXP-183: the window between two samples counts surviving threads' run and wait deltas, threads that ended (no
+    /// delta) and threads that started (counted from zero), per group.
+    #[test]
+    fn group_window_counts_survivors_ended_and_started() {
+        let a: ThreadSample = HashMap::from_iter([(1, (0, 1_000_000, 500_000)), (2, (5, 2_000_000, 0)), (3, (8, 0, 0))]);
+        let b: ThreadSample = HashMap::from_iter([(1, (0, 4_000_000, 1_500_000)), (3, (8, 7_000, 3_000)), (4, (5, 250_000, 1_000_000))]);
+        let w = group_window(&a, &b);
+        assert_eq!((w.n0[0], w.n1[0], w.run_us[0], w.wait_us[0]), (1, 1, 3_000, 1_000));
+        assert_eq!((w.n0[5], w.n1[5], w.ended[5], w.started[5], w.run_us[5], w.wait_us[5]), (1, 1, 1, 1, 250, 1_000));
+        assert_eq!((w.run_us[8], w.wait_us[8]), (7, 3));
+    }
+
+    /// EXP-183: sampling this process finds its threads with their names' groups and nonzero run time.
+    #[test]
+    fn sampling_this_process_finds_named_threads() {
+        let stop = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let s = stop.clone();
+        let t = std::thread::Builder::new()
+            .name("eap-nb".into())
+            .spawn(move || {
+                let mut x = 0u64;
+                while !s.load(std::sync::atomic::Ordering::Relaxed) {
+                    x = x.wrapping_add(1);
+                }
+                x
+            })
+            .unwrap();
+        std::thread::sleep(std::time::Duration::from_millis(30));
+        let mut groups = HashMap::default();
+        let sample = sample_threads(&mut groups);
+        stop.store(true, std::sync::atomic::Ordering::Relaxed);
+        t.join().unwrap();
+        assert!(sample.values().any(|&(g, run, _)| g == 5 && run > 0), "no running eap-nb thread in {sample:?}");
+    }
