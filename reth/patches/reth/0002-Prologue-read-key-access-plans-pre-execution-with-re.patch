+#[cfg(test)]
+mod rdwait_tests {
+    use super::{thread_sched_ns, RdWait};
+    use std::{
+        sync::{
+            atomic::{AtomicBool, AtomicU64, Ordering},
+            Arc,
+        },
+        time::{Duration, Instant},
+    };
+
+    /// Keeps the calling thread busy for `ms` milliseconds of wall time.
+    fn spin(ms: u64) {
+        let t0 = Instant::now();
+        let mut x = 0u64;
+        while t0.elapsed() < Duration::from_millis(ms) {
+            x = x.wrapping_add(1);
+        }
+        std::hint::black_box(x);
+    }
+
+    /// EXP-247 (`pwru`, X-029): a reader job's run-queue wait is read only with `pwru`. Off, nothing is read and the
+    /// counter stays 0. On, with a busy sibling on the same single CPU, the thread has to wait for the core, and the
+    /// counter takes the run_delay the thread gained in between (no more than direct reads before and after show). A
+    /// thread of its own (its CPU set changes); the second part is skipped where schedstat or a one-CPU set is not
+    /// available.
+    #[test]
+    fn reader_wait_is_read_only_with_pwru() {
+        std::thread::spawn(|| {
+            let c = AtomicU64::new(0);
+            let off = RdWait::start(false);
+            assert!(off.0.is_none());
+            spin(10);
+            off.add_to(&c);
+            assert_eq!(c.load(Ordering::Relaxed), 0);
+            if std::fs::read_to_string("/proc/thread-self/schedstat").is_err() {
+                return
+            }
+            // SAFETY: a zeroed cpu_set_t is valid; sched_getaffinity / sched_setaffinity with pid 0 read or change only the
+            // calling thread's mask; CPU_ISSET and CPU_SET only read or write bits of the given sets.
+            let pinned = unsafe {
+                let n = std::mem::size_of::<libc::cpu_set_t>();
+                let mut full: libc::cpu_set_t = std::mem::zeroed();
+                let first = if libc::sched_getaffinity(0, n, &mut full) == 0 {
+                    (0..libc::CPU_SETSIZE as usize).find(|c| libc::CPU_ISSET(*c, &full))
+                } else {
+                    None
+                };
+                first.is_some_and(|cpu| {
+                    let mut one: libc::cpu_set_t = std::mem::zeroed();
+                    libc::CPU_SET(cpu, &mut one);
+                    libc::sched_setaffinity(0, n, &one) == 0
+                })
+            };
+            if !pinned {
+                return
+            }
+            // a busy sibling on the same CPU (a new thread takes its creator's set)
+            let stop = Arc::new(AtomicBool::new(false));
+            let s2 = stop.clone();
+            let sib = std::thread::spawn(move || {
+                let mut x = 0u64;
+                while !s2.load(Ordering::Relaxed) {
+                    x = x.wrapping_add(1);
+                }
+                std::hint::black_box(x);
+            });
+            let w0 = thread_sched_ns().1;
+            let on = RdWait::start(true);
+            assert!(on.0.is_some());
+            spin(60);
+            on.add_to(&c);
+            let w1 = thread_sched_ns().1;
+            stop.store(true, Ordering::Relaxed);
+            sib.join().unwrap();
+            let got = c.load(Ordering::Relaxed);
+            assert!(got > 0, "no run-queue wait counted with a busy sibling on the same CPU");
+            assert!(got <= w1.saturating_sub(w0), "counted {got} ns, run_delay grew by {} ns", w1.saturating_sub(w0));
+        })
+        .join()
+        .unwrap();
+    }
+}
