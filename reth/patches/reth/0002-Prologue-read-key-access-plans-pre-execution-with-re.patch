+/// Starts a speculative run on this thread: cache-filling providers return the placeholder value 1 for storage slots
+/// that are not in the execution cache, without reading or caching them, and collect their keys.
+pub fn cc_discover_begin() {
+    cc_discover_begin_with(0);
+}
+
+/// [`cc_discover_begin`] with placeholder kind `ph` (0: the value 1, 1: every byte 0x01).
+pub fn cc_discover_begin_with(ph: u8) {
+    CC_PH.with(|c| c.set(ph));
+    CC_DISCOVER.with(|d| *d.borrow_mut() = Some(Vec::new()));
+    DIAG_PW_SUPPRESS.with(|c| c.set(true));
+}
