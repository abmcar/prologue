+/// Nanoseconds since the diagnostics base (0 when diagnostics are off).
+#[inline]
+pub fn diag_now_ns() -> u64 {
+    if DIAG_PATH.is_some() { DIAG_BASE.elapsed().as_nanos() as u64 } else { 0 }
+}
