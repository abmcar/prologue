+/// EXP-199 (Master 11-02): the run-queue wait (ns) in the text of `/proc/thread-self/schedstat` (time on the CPU, time
+/// runnable but waiting, timeslices); 0 when it cannot be read.
+fn schedstat_wait_ns(text: &str) -> u64 {
+    text.split_whitespace().nth(1).and_then(|v| v.parse().ok()).unwrap_or(0)
+}
+
+/// The calling thread's run-queue wait so far (us), from its schedstat (0 when the file cannot be read).
+fn thread_runq_us() -> u64 {
+    std::fs::read_to_string("/proc/thread-self/schedstat").map_or(0, |t| schedstat_wait_ns(&t) / 1000)
+}
+
+/// The calling thread's CPU time (us), voluntary and involuntary context switches, major page faults and run-queue
+/// wait (us). `start`: the schedstat file is read first, otherwise last, so that a run's CPU time (the difference of two
+/// readings) leaves out the file reads at both ends.
+fn thread_usage(start: bool) -> [u64; 5] {
+    let runq0 = if start { thread_runq_us() } else { 0 };
+    // SAFETY: zeroed timespec and rusage are valid outputs; both calls only read the calling thread's counters.
+    unsafe {
+        let mut ts: libc::timespec = std::mem::zeroed();
+        libc::clock_gettime(libc::CLOCK_THREAD_CPUTIME_ID, &mut ts);
+        let mut ru: libc::rusage = std::mem::zeroed();
+        libc::getrusage(libc::RUSAGE_THREAD, &mut ru);
+        [
+            ts.tv_sec as u64 * 1_000_000 + ts.tv_nsec as u64 / 1000,
+            ru.ru_nvcsw as u64,
+            ru.ru_nivcsw as u64,
+            ru.ru_majflt as u64,
+            if start { runq0 } else { thread_runq_us() },
+        ]
+    }
+}
