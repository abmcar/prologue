+/// Starts counting this thread's backend storage reads for a new prewarm transaction; `trigger` > 0 hands the run to
+/// discovery once that many slots have been read from the backend (EXP-023).
+pub fn cc_tx_begin(trigger: u32) {
+    CC_TX.with(|c| c.set((0, trigger, 0)));
