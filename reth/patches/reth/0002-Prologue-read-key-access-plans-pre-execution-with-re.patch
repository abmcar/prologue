diff --git a/crates/storage/storage-overlay/src/acc_filter.rs b/crates/storage/storage-overlay/src/acc_filter.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1873397b0d001c549a036090c542747171b56995
--- /dev/null
+++ b/crates/storage/storage-overlay/src/acc_filter.rs
@@ -0,0 +1,805 @@
+//! EXP-232 (`accflt`): a membership filter of the hashed addresses in `HashedAccounts`, so that the latest-state lookup
+//! of an account that does not exist can return `None` without walking the table.
+//!
+//! The filter is a cache-line blocked Bloom filter (512-bit blocks, 7 bits per key; 9.585 bits per key gives a
+//! false-positive rate of about 1.2%, EXP-232 sections 11-13). It is built once, offline and read-only, from a
+//! datadir (`reth db eap-acc-filter`), saved to a file with the block it describes, and loaded at node start when
+//! `EAP_ACCFILTER` names the file. It is used only when the file's block, block hash and `HashedAccounts` entry count
+//! equal the database's (else it stays off and a warning is logged).
+//!
+//! Correctness rests on one invariant: every key ever present in `HashedAccounts` since the file's block is in the
+//! filter. Keys are only ever added (a deleted or unwound account stays in the filter, which costs a false positive
+//! and a database lookup, never a wrong answer). Every write of an account to `HashedAccounts` in the database
+//! provider inserts its key first, in the same thread and before the transaction commits; a reader that sees the
+//! committed entry therefore sees the key. Blocks not yet persisted are served from the in-memory state before the
+//! database is asked.
+//!
+//! Whether the filter is consulted is switched per block (`set_use`, from the EAP mode `accflt=1`); insertions run
+//! whenever a filter is loaded. With `set_check_every(n)`, every n-th "absent" answer is also looked up in the
+//! database; a mismatch (the account exists) is logged, counted, the database's answer is returned, and the filter is
+//! turned off for the rest of the process.
+//!
+//! X-027 (reth 2.9.0): this module lives in `reth-storage-overlay`, below `reth-provider`, because 2.9.0's execution
+//! reads reach the database through `OverlayStateProvider::basic_account_from_db` in this crate; `reth-provider`
+//! re-exports it as `reth_provider::acc_filter`, the 2.5.1 path.
+//!
+//! EXP-240 (`accwarm=1`, [`set_warm`]): an "absent" answer skips the `HashedAccounts` lookup, and with it the read of
+//! the table page where the key would be. That is the page the state root reads when it inserts the new account, so the
+//! read moves from execution to after it, onto the root's critical path (EXP-240 README 2.7). With the switch, an
+//! account looked up through [`lookup_account`] and answered "absent" is also queued by address ([`WarmQueue`], at most
+//! [`WARM_CAP`]; a full queue drops the new address); a reader takes it ([`warm_pop`]) and looks it up through the
+//! database provider, whose account read goes to `HashedAccounts` without the filter. The caller's answer stays
+//! "absent", and the warm read writes neither the filter nor (no execution cache on that provider) the cache.
+
+use alloy_primitives::{Address, B256};
+use parking_lot::Mutex;
+use std::{
+    alloc::{alloc_zeroed, dealloc, Layout},
+    collections::VecDeque,
+    io::{Read, Write},
+    path::Path,
+    sync::{
+        atomic::{fence, AtomicBool, AtomicU64, AtomicUsize, Ordering},
+        OnceLock,
+    },
+    time::Instant,
+};
+use tracing::{info, warn};
+
+/// File magic and version.
+pub const MAGIC: [u8; 8] = *b"EAPACCF1";
+/// Bits set per key.
+pub const K: u32 = 7;
+/// Bits per block (one 64-byte cache line).
+pub const BLOCK_BITS: u32 = 512;
+/// Bits per key used to size the filter.
+pub const BITS_PER_KEY: f64 = 9.585;
+/// Header size in bytes; the blocks follow.
+pub const HEADER_LEN: usize = 128;
+
+/// The database state a filter file describes.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Base {
+    /// Last block of the persisted state (`Finish` stage checkpoint).
+    pub block_number: u64,
+    /// Canonical hash of that block.
+    pub block_hash: B256,
+    /// `Execution` stage checkpoint (equal to `block_number` on a consistent database).
+    pub execution_checkpoint: u64,
+    /// Entries of `HashedAccounts`.
+    pub accounts: u64,
+}
+
+/// One 64-byte block of the filter.
+#[repr(C, align(64))]
+#[allow(missing_debug_implementations)]
+pub struct Block([AtomicU64; 8]);
+
+/// A cache-line blocked Bloom filter of 32-byte hashed keys.
+pub struct AccFilter {
+    blocks: *mut Block,
+    nblocks: u64,
+    base: Base,
+    /// Keys inserted after the build (in this process).
+    inserted: AtomicU64,
+}
+
+// SAFETY: the blocks are only accessed through atomics; the allocation lives as long as the filter.
+unsafe impl Send for AccFilter {}
+// SAFETY: as above.
+unsafe impl Sync for AccFilter {}
+
+impl AccFilter {
+    /// An empty filter sized for `keys` keys, describing `base`.
+    pub fn with_capacity(keys: u64, base: Base) -> Self {
+        let nblocks = ((keys.max(1) as f64 * BITS_PER_KEY / BLOCK_BITS as f64).ceil() as u64).max(1);
+        Self::alloc(nblocks, base).unwrap_or_else(|e| panic!("eap acc filter: {e}"))
+    }
+
+    fn alloc(nblocks: u64, base: Base) -> Result<Self, String> {
+        let layout = Self::try_layout(nblocks).ok_or_else(|| format!("{nblocks} blocks overflow"))?;
+        // SAFETY: nblocks >= 1, so the layout has a non-zero size; zeroed memory is a valid array of atomics.
+        let blocks = unsafe { alloc_zeroed(layout) } as *mut Block;
+        if blocks.is_null() {
+            return Err(format!("allocation of {} bytes failed", layout.size()))
+        }
+        advise_huge(blocks as *mut u8, layout.size());
+        Ok(Self { blocks, nblocks, base, inserted: AtomicU64::new(0) })
+    }
+
+    fn layout(nblocks: u64) -> Layout {
+        Self::try_layout(nblocks).expect("eap acc filter: size overflow")
+    }
+
+    fn try_layout(nblocks: u64) -> Option<Layout> {
+        Layout::array::<Block>(usize::try_from(nblocks).ok()?).ok()
+    }
+
+    /// Number of blocks.
+    pub const fn nblocks(&self) -> u64 {
+        self.nblocks
+    }
+
+    /// Bytes of the blocks.
+    pub const fn bytes(&self) -> u64 {
+        self.nblocks * 64
+    }
+
+    /// The database state the filter was built for.
+    pub const fn base(&self) -> Base {
+        self.base
+    }
+
+    /// Keys inserted after the build.
+    pub fn inserted(&self) -> u64 {
+        self.inserted.load(Ordering::Relaxed)
+    }
+
+    #[inline(always)]
+    fn block(&self, key: &B256) -> &Block {
+        // The key is a keccak hash: bytes 0..8 choose the block, bytes 8..16 the bits inside it.
+        let h = u64::from_be_bytes(key.0[0..8].try_into().unwrap());
+        let i = ((h as u128 * self.nblocks as u128) >> 64) as usize;
+        // SAFETY: i < nblocks.
+        unsafe { &*self.blocks.add(i) }
+    }
+
+    #[inline(always)]
+    fn bits(key: &B256) -> u64 {
+        u64::from_be_bytes(key.0[8..16].try_into().unwrap())
+    }
+
+    /// Whether the key may be present (`false`: it was never inserted).
+    #[inline]
+    pub fn may_contain(&self, key: &B256) -> bool {
+        let b = self.block(key);
+        let h = Self::bits(key);
+        for i in 0..K {
+            let bit = (h >> (9 * i)) & 511;
+            if b.0[(bit >> 6) as usize].load(Ordering::Relaxed) >> (bit & 63) & 1 == 0 {
+                return false
+            }
+        }
+        true
+    }
+
+    /// Adds a key.
+    #[inline]
+    pub fn insert(&self, key: &B256) {
+        let b = self.block(key);
+        let h = Self::bits(key);
+        for i in 0..K {
+            let bit = (h >> (9 * i)) & 511;
+            b.0[(bit >> 6) as usize].fetch_or(1u64 << (bit & 63), Ordering::Relaxed);
+        }
+    }
+
+    fn words(&self) -> impl Iterator<Item = u64> + '_ {
+        // SAFETY: nblocks blocks are allocated.
+        let s = unsafe { std::slice::from_raw_parts(self.blocks, self.nblocks as usize) };
+        s.iter().flat_map(|b| b.0.iter().map(|w| w.load(Ordering::Relaxed)))
+    }
+
+    fn checksum(&self) -> u64 {
+        checksum(self.words())
+    }
+
+    /// Writes the filter to `path` (through a temporary file renamed at the end).
+    pub fn save(&self, path: &Path) -> std::io::Result<()> {
+        let tmp = path.with_extension("tmp");
+        {
+            let mut f = std::io::BufWriter::with_capacity(1 << 22, std::fs::File::create(&tmp)?);
+            f.write_all(&self.header())?;
+            for w in self.words() {
+                f.write_all(&w.to_le_bytes())?;
+            }
+            f.flush()?;
+            f.get_ref().sync_all()?;
+        }
+        std::fs::rename(&tmp, path)
+    }
+
+    fn header(&self) -> [u8; HEADER_LEN] {
+        let mut h = [0u8; HEADER_LEN];
+        h[0..8].copy_from_slice(&MAGIC);
+        h[8..12].copy_from_slice(&K.to_le_bytes());
+        h[12..16].copy_from_slice(&BLOCK_BITS.to_le_bytes());
+        h[16..24].copy_from_slice(&self.nblocks.to_le_bytes());
+        h[24..32].copy_from_slice(&self.base.block_number.to_le_bytes());
+        h[32..64].copy_from_slice(self.base.block_hash.as_slice());
+        h[64..72].copy_from_slice(&self.base.accounts.to_le_bytes());
+        h[72..80].copy_from_slice(&self.base.execution_checkpoint.to_le_bytes());
+        h[80..88].copy_from_slice(&self.checksum().to_le_bytes());
+        h
+    }
+
+    /// Reads a filter file (checks magic, parameters, length and checksum; not the database).
+    pub fn load(path: &Path) -> Result<Self, String> {
+        let mut f = std::fs::File::open(path).map_err(|e| format!("open {}: {e}", path.display()))?;
+        let len = f.metadata().map_err(|e| e.to_string())?.len();
+        let mut h = [0u8; HEADER_LEN];
+        f.read_exact(&mut h).map_err(|e| format!("header: {e}"))?;
+        if h[0..8] != MAGIC {
+            return Err("bad magic".into())
+        }
+        let u32_at = |o: usize| u32::from_le_bytes(h[o..o + 4].try_into().unwrap());
+        let u64_at = |o: usize| u64::from_le_bytes(h[o..o + 8].try_into().unwrap());
+        if u32_at(8) != K || u32_at(12) != BLOCK_BITS {
+            return Err(format!("parameters k={} block_bits={} differ", u32_at(8), u32_at(12)))
+        }
+        let nblocks = u64_at(16);
+        if nblocks == 0 ||
+            nblocks.checked_mul(64).and_then(|b| b.checked_add(HEADER_LEN as u64)) != Some(len)
+        {
+            return Err(format!("length {len} does not match {nblocks} blocks"))
+        }
+        let base = Base {
+            block_number: u64_at(24),
+            block_hash: B256::from_slice(&h[32..64]),
+            accounts: u64_at(64),
+            execution_checkpoint: u64_at(72),
+        };
+        if cfg!(target_endian = "big") {
+            return Err("big-endian hosts are not supported".into())
+        }
+        let filter = Self::alloc(nblocks, base)?;
+        // SAFETY: the allocation holds nblocks * 64 bytes; atomics are plain integers in memory and nothing else
+        // accesses the filter yet.
+        let bytes = unsafe { std::slice::from_raw_parts_mut(filter.blocks as *mut u8, (nblocks * 64) as usize) };
+        f.read_exact(bytes).map_err(|e| format!("blocks: {e}"))?;
+        let sum = filter.checksum();
+        if sum != u64_at(80) {
+            return Err(format!("checksum {sum:#x} differs from the header's {:#x}", u64_at(80)))
+        }
+        Ok(filter)
+    }
+}
+
+impl Drop for AccFilter {
+    fn drop(&mut self) {
+        // SAFETY: allocated in `with_capacity` / `load` with this layout.
+        unsafe { dealloc(self.blocks as *mut u8, Self::layout(self.nblocks)) }
+    }
+}
+
+impl std::fmt::Debug for AccFilter {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("AccFilter").field("nblocks", &self.nblocks).field("base", &self.base).finish()
+    }
+}
+
+fn checksum(words: impl Iterator<Item = u64>) -> u64 {
+    let mut c = 0xcbf29ce484222325u64;
+    for w in words {
+        c = (c ^ w).wrapping_mul(0x100000001b3).rotate_left(29);
+    }
+    c
+}
+
+#[cfg(target_os = "linux")]
+fn advise_huge(p: *mut u8, len: usize) {
+    unsafe extern "C" {
+        fn madvise(addr: *mut std::ffi::c_void, len: usize, advice: i32) -> i32;
+    }
+    // MADV_HUGEPAGE: the lookups touch one random cache line each; huge pages save the page walk (EXP-232 12.2).
+    // Advisory only: failure leaves normal pages.
+    let page = 4096usize;
+    let start = (p as usize).next_multiple_of(page);
+    let end = (p as usize + len) & !(page - 1);
+    if end > start {
+        // SAFETY: the range lies inside a live allocation; madvise does not change its contents.
+        let _ = unsafe { madvise(start as *mut std::ffi::c_void, end - start, 14) };
+    }
+}
+
+#[cfg(not(target_os = "linux"))]
+const fn advise_huge(_p: *mut u8, _len: usize) {}
+
+/// The database state `p` sees: what a filter built from it describes, and what a loaded file must match.
+pub fn base_of<P>(p: &P) -> reth_errors::ProviderResult<Base>
+where
+    P: reth_storage_api::DBProvider
+        + reth_storage_api::BlockNumReader
+        + reth_storage_api::BlockHashReader
+        + reth_storage_api::StageCheckpointReader,
+{
+    use reth_db_api::transaction::DbTx;
+    let block_number = p.best_block_number()?;
+    Ok(Base {
+        block_number,
+        block_hash: p.block_hash(block_number)?.unwrap_or_default(),
+        execution_checkpoint: p
+            .get_stage_checkpoint(reth_stages_types::StageId::Execution)?
+            .map(|c| c.block_number)
+            .unwrap_or_default(),
+        accounts: p.tx_ref().entries::<reth_db_api::tables::HashedAccounts>()? as u64,
+    })
+}
+
+// ---- the process's filter, its switches and counters ----
+
+/// A value on its own cache-line pair: the switches read by every lookup do not share a line with the counters the
+/// lookups of other threads write.
+#[repr(align(128))]
+struct Padded<T>(T);
+
+impl<T> std::ops::Deref for Padded<T> {
+    type Target = T;
+    fn deref(&self) -> &T {
+        &self.0
+    }
+}
+
+static FILTER: OnceLock<AccFilter> = OnceLock::new();
+/// Loaded and consistent with the database, and not turned off by a failed check.
+static VALID: AtomicBool = AtomicBool::new(false);
+/// Consulted in this block (`accflt=1`).
+static USE: AtomicBool = AtomicBool::new(false);
+/// Every n-th "absent" answer is checked against the database (0: none).
+static CHECK_EVERY: AtomicU64 = AtomicU64::new(0);
+static LOAD_US: Padded<AtomicU64> = Padded(AtomicU64::new(0));
+
+/// Per-block counters, taken by [`take_counters`].
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
+pub struct Counters {
+    /// Lookups that consulted the filter.
+    pub lookups: u64,
+    /// Lookups the filter answered "absent".
+    pub absent: u64,
+    /// "May be present" answers for which the database had no account.
+    pub false_positive: u64,
+    /// Keys inserted (database writes of accounts).
+    pub inserts: u64,
+    /// "Absent" answers also looked up in the database.
+    pub checks: u64,
+    /// Checks that found the account (the filter was wrong).
+    pub check_mismatch: u64,
+    /// EXP-240 (`accwarm`): "absent" answers queued for a warm read.
+    pub warm_queued: u64,
+    /// EXP-240: "absent" answers not queued because the queue was full.
+    pub warm_dropped: u64,
+    /// EXP-240: warm reads whose lookup returned ([`warm_done`] with `true`).
+    pub warm_reads: u64,
+    /// EXP-240: queued addresses taken for a warm read but not looked up: the provider could not be built or the lookup
+    /// returned an error ([`warm_done`] with `false`). Queued minus read minus these were still queued when the block's
+    /// readers stopped.
+    pub warm_err: u64,
+}
+
+static C_LOOKUPS: Padded<AtomicU64> = Padded(AtomicU64::new(0));
+static C_ABSENT: Padded<AtomicU64> = Padded(AtomicU64::new(0));
+static C_FP: Padded<AtomicU64> = Padded(AtomicU64::new(0));
+static C_INSERTS: Padded<AtomicU64> = Padded(AtomicU64::new(0));
+static C_CHECKS: Padded<AtomicU64> = Padded(AtomicU64::new(0));
+static C_MISMATCH: Padded<AtomicU64> = Padded(AtomicU64::new(0));
+static ABSENT_SEQ: Padded<AtomicU64> = Padded(AtomicU64::new(0));
+static C_WARM_QUEUED: Padded<AtomicU64> = Padded(AtomicU64::new(0));
+static C_WARM_DROPPED: Padded<AtomicU64> = Padded(AtomicU64::new(0));
+static C_WARM_READS: Padded<AtomicU64> = Padded(AtomicU64::new(0));
+static C_WARM_ERR: Padded<AtomicU64> = Padded(AtomicU64::new(0));
+
+/// EXP-240: the bound of the process's warm queue (a block answers at most a few hundred lookups "absent", EXP-240
+/// README 2.7).
+pub const WARM_CAP: usize = 4096;
+
+/// EXP-240 (`accwarm`): whether "absent" answers are queued ([`set_warm`]).
+static WARM: AtomicBool = AtomicBool::new(false);
+
+/// EXP-240: the process's warm queue.
+static WARM_Q: WarmQueue = WarmQueue::new(WARM_CAP);
+
+/// EXP-240: a bounded FIFO of addresses; a push to a full queue is refused (the new address is dropped).
+pub struct WarmQueue {
+    cap: usize,
+    len: AtomicUsize,
+    q: Mutex<VecDeque<Address>>,
+}
+
+impl WarmQueue {
+    /// An empty queue of at most `cap` addresses.
+    pub const fn new(cap: usize) -> Self {
+        Self { cap, len: AtomicUsize::new(0), q: parking_lot::const_mutex(VecDeque::new()) }
+    }
+
+    /// Appends `a`; false when the queue is full (`a` is not queued).
+    pub fn push(&self, a: Address) -> bool {
+        let mut q = self.q.lock();
+        if q.len() >= self.cap {
+            return false
+        }
+        q.push_back(a);
+        self.len.store(q.len(), Ordering::Relaxed);
+        true
+    }
+
+    /// The oldest address, if any (no lock taken when the queue looks empty).
+    pub fn pop(&self) -> Option<Address> {
+        if self.len.load(Ordering::Relaxed) == 0 {
+            return None
+        }
+        let mut q = self.q.lock();
+        let a = q.pop_front();
+        self.len.store(q.len(), Ordering::Relaxed);
+        a
+    }
+
+    /// Drops every queued address.
+    pub fn clear(&self) {
+        let mut q = self.q.lock();
+        q.clear();
+        self.len.store(0, Ordering::Relaxed);
+    }
+}
+
+thread_local! {
+    /// Under `cargo test` the other tests run as threads of the same process: once a test gated the filter
+    /// ([`test_gate_this_thread`]), only the threads that called it use the filter.
+    static TEST_THREAD: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+    /// EXP-240 (`accwarm`): set on a thread while [`bypassed`] runs: [`lookup_account`] reads without the filter.
+    static BYPASS: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+/// X-027: set by [`test_gate_this_thread`] only (tests); never set in a node. In 2.5.1 the gate was `cfg(test)` of the
+/// provider crate; the filter now lives in a lower crate and the writers' tests run in `reth-provider`'s test binary,
+/// where this crate is not compiled with `cfg(test)`, so the gate is a runtime switch.
+static TEST_GATE: Padded<AtomicBool> = Padded(AtomicBool::new(false));
+
+/// Tests only: from now on only threads that called this function use the process's filter (insertions and lookups).
+#[doc(hidden)]
+pub fn test_gate_this_thread() {
+    TEST_GATE.store(true, Ordering::Relaxed);
+    TEST_THREAD.with(|t| t.set(true));
+}
+
+#[inline(always)]
+fn this_thread_uses() -> bool {
+    !TEST_GATE.load(Ordering::Relaxed) || TEST_THREAD.with(|t| t.get())
+}
+
+/// Installs a loaded filter after its base was compared with the database (`db`). Returns whether it is in use.
+pub fn install(filter: AccFilter, db: Base, load_us: u64) -> bool {
+    let file = filter.base();
+    LOAD_US.store(load_us, Ordering::Relaxed);
+    if file != db {
+        warn!(target: "reth::eap", ?file, ?db, "eap accflt: the filter file does not describe this database, filter off");
+        return false
+    }
+    if FILTER.set(filter).is_err() {
+        warn!(target: "reth::eap", "eap accflt: a filter is already installed, the new one is ignored");
+        return VALID.load(Ordering::Acquire)
+    }
+    VALID.store(true, Ordering::Release);
+    info!(target: "reth::eap", block = file.block_number, accounts = file.accounts, load_us, "eap accflt loaded");
+    true
+}
+
+/// Loads `EAP_ACCFILTER` (if set) and installs it when `db` (computed by the caller from the database before any block
+/// is written) matches the file. Returns whether the filter is in use.
+pub fn load_from_env(db: impl FnOnce() -> Result<Base, String>) -> bool {
+    let Some(path) = std::env::var_os("EAP_ACCFILTER") else { return false };
+    let t0 = Instant::now();
+    let filter = match AccFilter::load(Path::new(&path)) {
+        Ok(f) => f,
+        Err(err) => {
+            warn!(target: "reth::eap", %err, path = ?path, "eap accflt: cannot load the filter file, filter off");
+            return false
+        }
+    };
+    let load_us = t0.elapsed().as_micros() as u64;
+    match db() {
+        Ok(db) => install(filter, db, load_us),
+        Err(err) => {
+            warn!(target: "reth::eap", %err, "eap accflt: cannot read the database's state, filter off");
+            false
+        }
+    }
+}
+
+/// Whether the filter is consulted for this block.
+pub fn set_use(on: bool) {
+    USE.store(on, Ordering::Relaxed);
+}
+
+/// Every n-th "absent" answer is also looked up in the database (0: no checks).
+pub fn set_check_every(n: u64) {
+    CHECK_EVERY.store(n, Ordering::Relaxed);
+}
+
+/// Whether a filter is loaded and valid (insertions run), and whether it is consulted in this block.
+pub fn state() -> (bool, bool) {
+    let valid = VALID.load(Ordering::Relaxed);
+    (valid, valid && USE.load(Ordering::Relaxed))
+}
+
+/// Microseconds the file took to load (0: not loaded).
+pub fn load_us() -> u64 {
+    LOAD_US.load(Ordering::Relaxed)
+}
+
+/// Keys inserted since the load.
+pub fn inserted_total() -> u64 {
+    FILTER.get().map_or(0, |f| f.inserted())
+}
+
+/// Takes and resets the counters.
+pub fn take_counters() -> Counters {
+    Counters {
+        lookups: C_LOOKUPS.swap(0, Ordering::Relaxed),
+        absent: C_ABSENT.swap(0, Ordering::Relaxed),
+        false_positive: C_FP.swap(0, Ordering::Relaxed),
+        inserts: C_INSERTS.swap(0, Ordering::Relaxed),
+        checks: C_CHECKS.swap(0, Ordering::Relaxed),
+        check_mismatch: C_MISMATCH.swap(0, Ordering::Relaxed),
+        warm_queued: C_WARM_QUEUED.swap(0, Ordering::Relaxed),
+        warm_dropped: C_WARM_DROPPED.swap(0, Ordering::Relaxed),
+        warm_reads: C_WARM_READS.swap(0, Ordering::Relaxed),
+        warm_err: C_WARM_ERR.swap(0, Ordering::Relaxed),
+    }
+}
+
+/// EXP-240 (`accwarm`): switches the queueing of "absent" answers, per block; every call empties the queue, so a block
+/// never warms the previous block's addresses.
+pub fn set_warm(on: bool) {
+    WARM.store(on, Ordering::Relaxed);
+    WARM_Q.clear();
+}
+
+/// EXP-240: the oldest queued address, taken for a warm read; `None` when the queue is empty or the switch is off. The
+/// caller reports the read with [`warm_done`].
+pub fn warm_pop() -> Option<Address> {
+    if !WARM.load(Ordering::Relaxed) {
+        return None
+    }
+    WARM_Q.pop()
+}
+
+/// EXP-240: counts the warm read of an address from [`warm_pop`]: `ok` when the lookup returned, `false` when the
+/// provider could not be built or the lookup returned an error.
+pub fn warm_done(ok: bool) {
+    (if ok { &C_WARM_READS } else { &C_WARM_ERR }).fetch_add(1, Ordering::Relaxed);
+}
+
+/// EXP-240 (`accwarm`): runs `f` with the filter bypassed on this thread: a latest-state account lookup inside it reads
+/// `HashedAccounts` directly, is not counted and queues nothing. The readers' warm reads go through the block's
+/// `OverlayStateProvider`, whose latest-state lookup is [`lookup_account`]; without this, a warm read of an address
+/// the filter answers "absent" reads nothing and queues the address again. The flag is cleared when `f` returns or
+/// unwinds.
+pub fn bypassed<R>(f: impl FnOnce() -> R) -> R {
+    struct Reset;
+    impl Drop for Reset {
+        fn drop(&mut self) {
+            BYPASS.with(|b| b.set(false));
+        }
+    }
+    BYPASS.with(|b| b.set(true));
+    let _reset = Reset;
+    f()
+}
+
+/// Records that `key` is about to be written to `HashedAccounts`. Called before the write, in the writing
+/// transaction's thread; a no-op without a loaded filter. Insertions continue after a failed check (`VALID` off),
+/// which keeps them cheap and harmless.
+#[inline]
+pub fn insert(key: &B256) {
+    if let Some(f) = FILTER.get().filter(|_| this_thread_uses()) {
+        f.insert(key);
+        f.inserted.fetch_add(1, Ordering::Relaxed);
+        C_INSERTS.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// Called after a batch of [`insert`]s and before the transaction commits (orders the bits before the commit's own
+/// synchronisation; the commit already provides it, this keeps the argument local).
+#[inline]
+pub fn inserted_batch_done() {
+    if FILTER.get().is_some() {
+        fence(Ordering::SeqCst);
+    }
+}
+
+/// The function [`disable`] runs when the filter turns itself off ([`set_on_disable`]).
+static ON_DISABLE: parking_lot::Mutex<Option<Box<dyn Fn() + Send + Sync>>> = parking_lot::const_mutex(None);
+
+/// Sets the function [`disable`] runs once, right after the filter turns itself off and before [`disable`] returns,
+/// so before the lookup whose check turned it off returns. Any "absent" answer given while the filter was on may have
+/// been wrong, and a cache that holds one would keep serving it after the filter is off: the engine drops the cached
+/// state of every execution cache there (`reth_execution_cache::invalidate_all_execution_caches`). A later call
+/// replaces the function; `None` removes it. While the filter stays valid the function never runs.
+pub fn set_on_disable(f: Option<Box<dyn Fn() + Send + Sync>>) {
+    *ON_DISABLE.lock() = f;
+}
+
+/// Turns the filter off for the rest of the process (a writer that bypasses [`insert`] is about to run, or a check
+/// found an existing account the filter did not contain), then runs the function of [`set_on_disable`].
+pub fn disable(reason: &'static str) {
+    if VALID.swap(false, Ordering::AcqRel) {
+        warn!(target: "reth::eap", reason, "eap accflt: filter off");
+        let f = ON_DISABLE.lock().take();
+        if let Some(f) = f {
+            f();
+        }
+    }
+}
+
+/// The latest-state lookup of the account `address` through the filter. `get` reads `HashedAccounts`; `key` is the
+/// hashed address. EXP-240: with [`set_warm`] on, an "absent" answer given without a database lookup also queues
+/// `address` for a warm read.
+pub fn lookup_account<T, E>(
+    key: &B256,
+    address: &Address,
+    get: impl FnOnce() -> Result<Option<T>, E>,
+) -> Result<Option<T>, E> {
+    let (_, on) = state();
+    let Some(f) = FILTER.get().filter(|_| on && this_thread_uses() && !BYPASS.with(|b| b.get())) else { return get() };
+    C_LOOKUPS.fetch_add(1, Ordering::Relaxed);
+    if f.may_contain(key) {
+        let v = get()?;
+        if v.is_none() {
+            C_FP.fetch_add(1, Ordering::Relaxed);
+        }
+        return Ok(v)
+    }
+    C_ABSENT.fetch_add(1, Ordering::Relaxed);
+    let every = CHECK_EVERY.load(Ordering::Relaxed);
+    if every == 0 || !(ABSENT_SEQ.fetch_add(1, Ordering::Relaxed) + 1).is_multiple_of(every) {
+        if WARM.load(Ordering::Relaxed) {
+            let c = if WARM_Q.push(*address) { &C_WARM_QUEUED } else { &C_WARM_DROPPED };
+            c.fetch_add(1, Ordering::Relaxed);
+        }
+        return Ok(None)
+    }
+    C_CHECKS.fetch_add(1, Ordering::Relaxed);
+    let v = get()?;
+    if v.is_some() {
+        C_MISMATCH.fetch_add(1, Ordering::Relaxed);
+        warn!(target: "reth::eap", %key, "eap accflt: the filter said absent but the account exists");
+        disable("check found an existing account the filter did not contain");
+    }
+    Ok(v)
+}
+
+#[cfg(test)]
+mod tests {
