+/// EXP-181 (`srdiag`): the state root is known (`finish_us`: the wait in `state_root_job.finish`); logs `eap sr`.
+pub fn sr_root_done(block: u64, finish_us: u64) {
+    // X-027: no state-root boost to end (`srboost` is not ported)
+    // EXP-180 (`pwnbbhroot`): a history pass waiting for this block's root may start now
+    bh_root_known(block);
+    // EXP-240 (`srtl`): the block's proof-job timeline, before the next block resets it
+    if reth_trie_parallel::proof_task::srtl::on() {
+        srtl_log(block);
+    }
+    // EXP-240 (`srmk`): the finish marker's way, before the next block resets it
+    if reth_trie_parallel::proof_task::srmk::on() {
+        srmk_log(block);
+    }
+    if !srdiag() {
+        return
+    }
+    let now = Instant::now();
+    let Some((xend, before)) = SR_EXEC.lock().take() else { return };
+    let task = SR_TASK.lock().take();
+    let rel = |t: Instant| -> i64 {
+        if t >= xend { t.duration_since(xend).as_micros() as i64 } else { -(xend.duration_since(t).as_micros() as i64) }
+    };
+    let (mut flt, mut run, mut wait) = (0u64, 0u64, 0u64);
+    for (tid, f0, r0, w0) in &before {
+        let (f1, r1, w1) = thread_counters(*tid);
+        flt += f1.saturating_sub(*f0);
+        run += r1.saturating_sub(*r0);
+        wait += w1.saturating_sub(*w0);
+    }
+    let (start_us, finished_us, drained_us, rooted_us, drain_proofs) =
+        task.map_or((0, 0, 0, 0, 0), |(s, f, d, r, n)| (rel(s), rel(f), rel(d), rel(r), n));
+    // EXP-240 (`srpf`): the page prefetch of this block's proof jobs, so far (chunks of jobs done by now are skipped)
+    use reth_trie_parallel::proof_task::srpf;
+    let pf = srpf::snapshot();
+    info!(
+        target: "reth::eap",
+        block,
+        finish_us,
+        done_after_exec_us = now.duration_since(xend).as_micros() as u64,
+        task_start_us = start_us,
+        finished_marker_us = finished_us,
+        proofs_drained_us = drained_us,
+        root_us = rooted_us,
+        drain_proofs,
+        proof_threads = before.len(),
+        proof_majflt = flt,
+        proof_run_us = run / 1000,
+        proof_wait_us = wait / 1000,
+        srpf = current().srpf,
+        srpf_threads = reth_trie_parallel::proof_task::srpf::started(),
+        srpf_offered = pf[srpf::OFFERED],
+        srpf_walked = pf[srpf::WALKED],
+        srpf_skipped = pf[srpf::SKIPPED],
+        srpf_lookups = pf[srpf::LOOKUPS],
+        srpf_us = pf[srpf::WALK_NS] / 1000,
+        srpf_cpu_us = pf[srpf::CPU_NS] / 1000,
+        srpf_majflt = pf[srpf::MAJFLT],
+        srpfmk = current().srpfmk,
+        srpf_held = pf[srpf::HELD],
+        srpf_flushed = pf[srpf::FLUSHED],
+        srtx = current().srtx,
+        srtx_txs = SRTX_STATS[0].load(Ordering::Relaxed),
+        srtx_accts = SRTX_STATS[1].load(Ordering::Relaxed),
+        srtx_slots = SRTX_STATS[2].load(Ordering::Relaxed),
+        srtx_msgs = SRTX_STATS[3].load(Ordering::Relaxed),
+        xb_eap_setup_us = XB_TIMES[0].load(Ordering::Relaxed),
+        xb_pre_us = XB_TIMES[1].load(Ordering::Relaxed),
+        xb_tx_us = XB_TIMES[2].load(Ordering::Relaxed),
+        xb_post_us = XB_TIMES[3].load(Ordering::Relaxed),
+        xb_drop_us = XB_TIMES[4].load(Ordering::Relaxed),
+        xb_drop_join_us = XB_TIMES[5].load(Ordering::Relaxed),
+        xb_drop_tail_us = XB_TIMES[6].load(Ordering::Relaxed),
+        "eap sr"
+    );
+    // X-027: the `eap srh` line (proof hints by source, `srh`) is not ported
+    for a in SRTX_STATS.iter().chain(XB_TIMES.iter()) {
+        a.store(0, Ordering::Relaxed);
+    }
+    sr_bg_send(SrBg::Root(block, now));
+}
+
+/// EXP-183 (`srdiag`): thread groups, by thread name, sampled when execution ends and when the root is known.
+const SR_GROUPS: [&str; 11] = ["proof", "sparse", "engine", "workers", "prewarm", "nbh", "heavy", "split", "read", "trie", "other"];
+
+/// EXP-183: the group of a thread name (`comm`, at most 15 bytes).
+fn sr_group(comm: &str) -> usize {
+    let p = |x: &str| comm.starts_with(x);
+    if p("proof-") {
+        0
+    } else if p("sparse-trie") {
+        1
+    } else if comm == "engine" {
+        2
+    } else if p("storage-worker") || p("account-worke") {
+        3
+    } else if p("prewarm") || p("eap-warm") {
+        4
+    } else if p("eap-nb") {
+        5
+    } else if p("eap-heavy") {
+        6
+    } else if p("eap-split") {
+        7
+    } else if p("eap-read") {
+        8
+    } else if p("trie-hashing") || p("hash-post-state") || p("receipt-root") || p("deferred-trie") {
+        9
+    } else {
+        10
+    }
+}
+
+/// EXP-183: one sample of this process's threads: thread id -> (group, run ns, ready-queue wait ns).
+type ThreadSample = HashMap<u32, (usize, u64, u64)>;
+
+/// EXP-183: reads every thread's `schedstat` (and, for a thread not seen before, its `comm`, kept in `groups`).
+fn sample_threads(groups: &mut HashMap<u32, usize>) -> ThreadSample {
+    let mut out = HashMap::default();
+    let Ok(rd) = std::fs::read_dir("/proc/self/task") else { return out };
+    for e in rd.flatten() {
+        let Some(tid) = e.file_name().to_str().and_then(|x| x.parse::<u32>().ok()) else { continue };
+        let g = match groups.get(&tid) {
+            Some(g) => *g,
+            None => {
+                let c = std::fs::read_to_string(e.path().join("comm")).unwrap_or_default();
+                let g = sr_group(c.trim_end());
+                groups.insert(tid, g);
+                g
+            }
+        };
+        let Ok(st) = std::fs::read_to_string(e.path().join("schedstat")) else { continue };
+        let mut it = st.split_whitespace().map(|x| x.parse::<u64>().unwrap_or(0));
+        out.insert(tid, (g, it.next().unwrap_or(0), it.next().unwrap_or(0)));
+    }
+    out
+}
+
+/// EXP-183: per group between two samples: threads in the first and in the second, threads that ended in between (their
+/// run and wait after the first sample are lost), threads that started in between (counted from their start), and the
+/// run and ready-queue wait (us) of the threads in the window.
+#[derive(Debug, Default, PartialEq, Eq)]
+struct GroupWindow {
+    n0: [u32; 11],
+    n1: [u32; 11],
+    ended: [u32; 11],
+    started: [u32; 11],
+    run_us: [u64; 11],
+    wait_us: [u64; 11],
+}
+
+fn group_window(a: &ThreadSample, b: &ThreadSample) -> GroupWindow {
+    let mut w = GroupWindow::default();
+    for (tid, &(g, r0, w0)) in a {
+        w.n0[g] += 1;
+        match b.get(tid) {
+            Some(&(_, r1, w1)) => {
+                w.run_us[g] += r1.saturating_sub(r0) / 1000;
+                w.wait_us[g] += w1.saturating_sub(w0) / 1000;
+            }
+            None => w.ended[g] += 1,
+        }
+    }
+    for (tid, &(g, r1, w1)) in b {
+        w.n1[g] += 1;
+        if !a.contains_key(tid) {
+            w.started[g] += 1;
+            w.run_us[g] += r1 / 1000;
+            w.wait_us[g] += w1 / 1000;
+        }
+    }
+    w
+}
+
+/// EXP-183: messages to the background sampler.
+#[derive(Debug)]
+enum SrBg {
+    /// the block's control tag and the end of execution
+    ExecEnd(u64, Instant),
+    Root(u64, Instant),
+    /// a helper thread's totals when it ended: thread id, time, group, run ns, wait ns
+    Exit(u32, Instant, usize, u64, u64),
+}
+
+/// EXP-183 (`srdiag`, Master 10-26): a helper thread ending inside the window between the samples would lose its run and
+/// wait after the first sample, and the speculative-pass helpers (history pass) and dedicated threads may end exactly
+/// there; so they send their own totals when they end. Only when the sampler exists (made by the engine thread), so a
+/// helper never makes it.
+pub fn sr_thread_exit() {
+    if !srdiag() {
+        return
+    }
+    if let (Some(Some(tx)), Some((tid, run, wait))) = (SR_BG.get(), thread_exit_sample()) {
+        let g = sr_group(thread::current().name().unwrap_or(""));
+        let _ = tx.send(SrBg::Exit(tid, Instant::now(), g, run, wait));
+    }
+}
+
+/// EXP-183: the calling thread's id and its run and ready-queue wait totals (ns).
+fn thread_exit_sample() -> Option<(u32, u64, u64)> {
+    let st = std::fs::read_to_string("/proc/thread-self/schedstat").ok()?;
+    let mut it = st.split_whitespace().map(|x| x.parse::<u64>().unwrap_or(0));
+    let (run, wait) = (it.next()?, it.next()?);
+    // SAFETY: gettid has no preconditions and only returns the calling thread's id
+    let tid = unsafe { libc::gettid() } as u32;
+    Some((tid, run, wait))
+}
+
+/// EXP-183: calls [`sr_thread_exit`] when dropped, i.e. at every return of a helper thread's body.
+#[derive(Debug)]
+pub struct SrExitGuard;
+
+impl Drop for SrExitGuard {
+    fn drop(&mut self) {
+        sr_thread_exit();
+    }
+}
+
+/// EXP-183: what the helper threads that ended inside the window `[s0, s1]` add, per group: such threads, and their run and
+/// wait (us) after the first sample (a thread not in the first sample started after it and counts from its start). Ends
+/// outside the window and threads still alive at the second sample add nothing.
+fn exit_supplement(
+    a: &ThreadSample,
+    b: &ThreadSample,
+    exits: &HashMap<u32, (Instant, usize, u64, u64)>,
+    s0: Instant,
+    s1: Instant,
+) -> ([u32; 11], [u64; 11], [u64; 11]) {
+    let (mut n, mut run, mut wait) = ([0u32; 11], [0u64; 11], [0u64; 11]);
+    for (tid, &(t, g, r1, w1)) in exits {
+        if t < s0 || t > s1 || b.contains_key(tid) {
+            continue
+        }
+        let (r0, w0) = a.get(tid).map_or((0, 0), |&(_, r, w)| (r, w));
+        n[g] += 1;
+        run[g] += r1.saturating_sub(r0) / 1000;
+        wait[g] += w1.saturating_sub(w0) / 1000;
+    }
+    (n, run, wait)
+}
+
+/// EXP-183 (`srdiag`): the background sampler (`eap-srbg`), made at the first block with `srdiag` by the engine thread.
+/// The newPayload path only sends a timestamp; the sampler reads `/proc` at once, so the window it measures starts
+/// `d0_us` after the end of execution and ends `d1_us` after the root, both logged with the samples' own reading times.
+static SR_BG: OnceLock<Option<Sender<SrBg>>> = OnceLock::new();
+
+fn sr_bg_send(m: SrBg) {
+    let tx = SR_BG.get_or_init(|| {
+        let (tx, rx) = crossbeam_channel::unbounded();
+        thread::Builder::new().name("eap-srbg".into()).spawn(move || sr_bg_loop(rx)).ok().map(|_| tx)
+    });
+    if let Some(tx) = tx {
+        let _ = tx.send(m);
+    }
+}
+
+fn sr_bg_loop(rx: Receiver<SrBg>) {
+    use std::fmt::Write as _;
+    let mut groups: HashMap<u32, usize> = HashMap::default();
+    let mut first: Option<(u64, Instant, Instant, u64, ThreadSample)> = None;
+    // windows dropped because the end-of-execution sample belonged to another block (X-018's review)
+    let mut mismatched = 0u64;
+    let mut exits: HashMap<u32, (Instant, usize, u64, u64)> = HashMap::default();
+    let mut n = 0u64;
+    let us = |a: Instant, b: Instant| b.saturating_duration_since(a).as_micros() as u64;
+    while let Ok(m) = rx.recv() {
+        match m {
+            SrBg::ExecEnd(tag, xend) => {
+                // thread ids are reused only after the id space wraps; the name cache is renewed now and then anyway
+                n += 1;
+                if n % 256 == 0 {
+                    groups.clear();
+                }
+                let s0 = Instant::now();
+                let a = sample_threads(&mut groups);
+                exits.clear();
+                first = Some((tag, xend, s0, us(s0, Instant::now()), a));
+            }
+            SrBg::Exit(tid, t, g, run, wait) => {
+                exits.insert(tid, (t, g, run, wait));
+            }
+            SrBg::Root(block, root) => {
+                let Some((tag, xend, s0, read0, a)) = first.take() else { continue };
+                if tag != 0 && tag != block {
+                    mismatched += 1;
+                    continue
+                }
+                let s1 = Instant::now();
+                let b = sample_threads(&mut groups);
+                let read1 = us(s1, Instant::now());
+                let w = group_window(&a, &b);
+                let (xn, xrun, xwait) = exit_supplement(&a, &b, &exits, s0, s1);
+                let mut f = String::new();
+                for (i, g) in SR_GROUPS.iter().enumerate() {
+                    let _ = write!(
+                        f,
+                        " {g}_n0={} {g}_n1={} {g}_ended={} {g}_started={} {g}_run_us={} {g}_wait_us={} {g}_xn={} {g}_xrun_us={} {g}_xwait_us={}",
+                        w.n0[i], w.n1[i], w.ended[i], w.started[i], w.run_us[i], w.wait_us[i], xn[i], xrun[i], xwait[i]
+                    );
+                }
+                info!(
+                    target: "reth::eap",
+                    "eap sr threads block={block} d0_us={} read0_us={read0} d1_us={} read1_us={read1} window_us={} mismatched={mismatched}{f}",
+                    us(xend, s0),
+                    us(root, s1),
+                    us(s0, s1)
+                );
+            }
+        }
+    }
+}
+
+/// EXP-174 (`pwlxrd`): the block has an extrapolation job; the extra readers start working.
+fn lx_gate_open() {
+    // the gate's lock is not held while the extra readers are spawned
+    let g = LX_GATE.lock().clone();
+    if let Some(g) = g {
+        g.open();
+    }
+}
+
+/// Spawns `n = mode.readers` reader threads sharing `stats` and `issued`. `done`, when given,
+/// makes them exit once idle and records when the last one did.
+#[expect(clippy::too_many_arguments)]
+fn spawn_readers(
+    name: &str,
+    mode: Mode,
+    factory: ProviderFactory,
+    info: BlockInfo,
+    stats: &Arc<Stats>,
+    issued: &Arc<Mutex<Issued>>,
+    cs_rx: Receiver<Item>,
+    pw_rx: Option<Receiver<Item>>,
+    txs: Option<Receiver<TxInfo>>,
+    stop: &Arc<AtomicBool>,
+    done: Option<Arc<Done>>,
+    stop_rx: &Receiver<()>,
+    caches: Option<reth_execution_cache::ExecutionCache>,
+) -> Vec<ReaderHandle> {
+    // single slots handed out by a reader after instantiating a frame or transaction
+    let (sl_tx, sl_rx) = crossbeam_channel::unbounded::<Item>();
+    let (lo_tx, lo_rx) = crossbeam_channel::unbounded::<Item>();
+    *NB_SL_TX.lock() = Some(sl_tx.clone());
+    let pwq = mode.pwprio.then(|| Arc::new(Mutex::new(PwQueue::default())));
+    // EXP-174 (`pwlxrd`): the block-time readers get `pwlxrd` extra readers behind the block's extrapolation gate
+    let n_extra = if name == "eap-read" { mode.pwlxrd as usize } else { 0 };
+    let gate = if name == "eap-read" {
+        let g = (n_extra > 0).then(|| Arc::new(LxGate::new(stop.clone())));
+        *LX_GATE.lock() = g.clone();
+        g
+    } else {
+        None
+    };
+    // EXP-183: the block readers go to the persistent pool with `rdpool=1` (not with `rdnice`, see `Mode::rdpool`); with
+    // `ewcore` too, since every job takes the block's core set at its start (`leave_exec_core_reader` below)
+    let pooled = mode.rdpool && ((mode.rdnice == 0 && !mode.rdidle) || mode.rdnicepool) && name == "eap-read";
+    // EXP-182: reader `i` (the extra ones are spawned by the gate when it opens, see `LxGate::open`)
+    let spawn_one = {
+        let name = name.to_string();
+        let (factory, cs_rx, pw_rx, sl_tx, sl_rx, txs, stop, stats, issued, done, pwq, lo_tx, lo_rx, stop_rx) = (
+            factory.clone(),
+            cs_rx.clone(),
+            pw_rx.clone(),
+            sl_tx.clone(),
+            sl_rx.clone(),
+            txs.clone(),
+            stop.clone(),
+            stats.clone(),
+            issued.clone(),
+            done.clone(),
+            pwq.clone(),
+            lo_tx.clone(),
+            lo_rx.clone(),
+            stop_rx.clone(),
+        );
+        let caches = caches.clone();
+        // EXP-240 (`accwarm`): the block readers take the warm queue
+        let warm_main = name == "eap-read" && mode.accflt && mode.accwarm;
+        // Prologue (`rdlate`): only the block readers wait
+        let late_us = if name == "eap-read" { mode.rdlate } else { 0 };
+        move |i: usize| -> Option<ReaderHandle> {
+            let gate: Option<Arc<LxGate>> = None;
+            let caches = caches.clone();
+            let pwq = pwq.clone();
+            let (lo_tx, lo_rx) = (lo_tx.clone(), lo_rx.clone());
+            let stop_rx = stop_rx.clone();
+            let (factory, cs_rx, pw_rx, sl_tx, sl_rx, txs, stop, stats, issued, done) = (
+                factory.clone(),
+                cs_rx.clone(),
+                pw_rx.clone(),
+                sl_tx.clone(),
+                sl_rx.clone(),
+                txs.clone(),
+                stop.clone(),
+                stats.clone(),
+                issued.clone(),
+                done.clone(),
+            );
+            let job = move || {
+                    // EXP-183: the readers' processor time of this block (a pool thread's counter spans earlier blocks)
+                    let cpu0 = thread_cpu_ns();
+                    // EXP-247 (`pwru`, X-029): the reader's run-queue wait over this job, read only with `pwru`
+                    let rdwait = RdWait::start(mode.active && mode.pwru);
+                    set_own_nice(mode.rdnice);
+                    // Prologue (`rdidle`): this block's reader yields every CPU to the other threads
+                    if mode.rdidle {
+                        set_own_idle();
+                        // Prologue (`rdidleio`): its reads keep the best-effort I/O class
+                        if mode.rdidleio {
+                            crate::tree::eap::rdidle_io();
+                        }
+                    }
+                    // EXP-199 (`ewcore`): off the execution thread's reserved core, or back to the full set (a reader created by
+                    // a mechanism worker inherits the worker's set, a pool thread keeps its previous job's); a reader's class
+                    // follows `pwbatch` as a reader's (SCHED_BATCH only with 1)
+                    crate::tree::eap_ew::leave_exec_core_reader();
+                    // Prologue (`rdlate`): the prewarm workers start first
+                    if late_us > 0 {
+                        thread::sleep(Duration::from_micros(u64::from(late_us)));
+                    }
+                    // the tag source of the reader's cache fills and, for `bigra=2`, the large-value read-ahead of the
+                    // readers' (plan-guided) reads; on a pool thread also anything an earlier block's job left behind
+                    reader_thread_reset();
+                    let ev = reth_execution_cache::cc_diag_block();
+                    if let Some(d) = &ev {
+                        d.event("reader_build_start");
+                    }
+                    let built = factory();
+                    if let Some(d) = &ev {
+                        d.event("reader_build_done");
+                    }
+                    if let Ok(provider) = built {
+                        let idle_exit = done.is_some();
+                        let stats2 = stats.clone();
+                        // bound first: a guard taken inside the `Reader { .. }.run(..)` statement would be held
+                        // until `run` returns, i.e. for the whole block
+                        let exec_idx = PW_EXEC.lock().clone();
+                        Reader {
+                            provider,
+                            mode,
+                            info,
+                            stats,
+                            issued,
+                            sc: reader_scratch(mode, &stats2),
+                            sl_tx,
+                            lo_tx,
+                            idle_exit,
+                            exec_idx,
+                            pwq: pwq.clone(),
+                            stop: stop.clone(),
+                            gate,
+                            caches,
+                            warm: warm_main.then(|| WARM_FACTORY.lock().clone()).flatten().map(|f| (f, None)),
+                        }
+                            .run(sl_rx, cs_rx, pw_rx, txs, stop, lo_rx, stop_rx);
+                        stats2.reader_cpu_ns.fetch_add(thread_cpu_ns().saturating_sub(cpu0), Ordering::Relaxed);
+                        rdwait.add_to(&stats2.reader_wait_ns);
+                    }
+                    if let Some(d) = done {
+                        d.exit();
+                    }
+            };
+            // EXP-183 (`rdpool=1`): the block readers on persistent threads; other readers keep a thread of their own
+            if pooled {
+                if mode.rdnice > 0 { READER_POOL_NICE.submit(&name, Box::new(job)) } else { READER_POOL.submit(&name, Box::new(job)) }
+            } else {
+                thread::Builder::new().name(format!("{}-{i}", name)).spawn(job).ok().map(ReaderHandle::Thread)
+            }
+        }
+    };
+    if let Some(g) = &gate {
+        let spawn_one = spawn_one.clone();
+        let (base, stats) = (mode.readers, stats.clone());
+        *g.spawner.lock() = Some(Box::new(move || {
+            let t: Vec<_> = (base..base + n_extra).filter_map(&spawn_one).collect();
+            stats.lx_rd_woken.fetch_add(t.len() as u64, Ordering::Relaxed);
+            t
+        }));
+    }
+    // EXP-240 (`rdspawn`): the block readers created by the helper thread; everything above (channels, the gate and its
+    // spawner, `NB_SL_TX`) is already set up, so only the thread creation moves off the execution thread
+    if mode.rdspawn && name == "eap-read" && let Some(helper) = RD_SPAWNER.as_ref() {
+        let (tx, rx) = crossbeam_channel::bounded(1);
+        let (n, t_submit) = (mode.readers, Instant::now());
+        let job: Box<dyn FnOnce() + Send> = Box::new(move || {
+            let lag_us = t_submit.elapsed().as_micros() as u64;
+            let t0 = Instant::now();
+            let handles: Vec<_> = (0..n).filter_map(spawn_one).collect();
+            let _ = tx.send((handles, lag_us, t0.elapsed().as_micros() as u64));
+        });
+        // the helper is gone only if its thread ended: then the job runs here, as without the switch
+        if let Err(e) = helper.send(job) {
+            (e.into_inner())();
+        }
+        return vec![ReaderHandle::Spawning(rx)]
+    }
+    (0..mode.readers).filter_map(spawn_one).collect()
+}
+
+/// EXP-240 (`rdspawn`): the helper thread that creates the block readers, started at the first block with the switch
+/// (`None` if it could not be created: the readers are then created on the execution thread). Each job first leaves the
+/// execution thread's reserved core, as a reader does, so the readers it creates start off that core; they set their own
+/// nice value and class at their start as before. A job's panic ends the job, not the helper (the job's result sender is
+/// dropped, so the block end finds no readers to join).
+static RD_SPAWNER: std::sync::LazyLock<Option<Sender<Box<dyn FnOnce() + Send>>>> = std::sync::LazyLock::new(|| {
+    let (tx, rx) = crossbeam_channel::unbounded::<Box<dyn FnOnce() + Send>>();
+    thread::Builder::new()
+        .name("eap-rdspawn".into())
+        .spawn(move || {
+            for job in rx {
+                crate::tree::eap_ew::leave_exec_core_reader();
+                let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(job));
+            }
+        })
+        .ok()
+        .map(|_| tx)
+});
+
+/// Completion of a mempool stage: the time from the feed until its last reader went idle.
+#[derive(Debug)]
+struct Done {
+    alive: AtomicUsize,
+    t0: Instant,
+    /// 0 while any reader is still working.
+    ns: AtomicU64,
+}
+
+impl Done {
+    fn exit(&self) {
+        if self.alive.fetch_sub(1, Ordering::AcqRel) == 1 {
+            self.ns.store((self.t0.elapsed().as_nanos() as u64).max(1), Ordering::Release);
+        }
+    }
+}
+
+/// A reader's handle: a thread of its own, or a job on a [`ReaderPool`] thread (`rdpool=1`). Joining a pooled reader
+/// waits until its job has returned and everything the job owned (the reader with its provider, i.e. its read-only
+/// transaction) has been dropped; the thread itself stays for later blocks.
+#[derive(Debug)]
+enum ReaderHandle {
+    Thread(thread::JoinHandle<()>),
+    Pooled(Arc<JobDone>),
+    /// EXP-240 (`rdspawn`): the readers the helper thread is creating, with its lag and creation time (µs); resolved
+    /// into their handles at the block end ([`BlockPrefetch`]'s drop) before anything looks at them.
+    Spawning(Receiver<(Vec<ReaderHandle>, u64, u64)>),
+}
+
+impl ReaderHandle {
+    fn join(self) {
+        match self {
+            Self::Thread(t) => {
+                let _ = t.join();
+            }
+            Self::Pooled(d) => d.wait(),
+            Self::Spawning(rx) => {
+                for t in rx.recv().map(|(v, ..)| v).unwrap_or_default() {
+                    t.join();
+                }
+            }
+        }
+    }
+
+    fn is_finished(&self) -> bool {
+        match self {
+            Self::Thread(t) => t.is_finished(),
+            Self::Pooled(d) => d.is_done(),
+            Self::Spawning(_) => false,
+        }
+    }
+}
+
+/// Completion of one pool job, set after the job's closure (and everything it captured) has been dropped.
+#[derive(Debug, Default)]
+struct JobDone {
+    done: Mutex<bool>,
+    cv: parking_lot::Condvar,
+}
+
+impl JobDone {
+    fn set(&self) {
+        *self.done.lock() = true;
+        self.cv.notify_all();
+    }
+
+    fn wait(&self) {
+        let mut g = self.done.lock();
+        while !*g {
+            self.cv.wait(&mut g);
+        }
+    }
+
+    fn is_done(&self) -> bool {
+        *self.done.lock()
+    }
+}
+
+/// One job of a [`ReaderPool`].
+struct PoolJob {
+    run: Box<dyn FnOnce() + Send>,
+    done: Arc<JobDone>,
+}
+
+impl PoolJob {
+    /// Runs the job and returns its completion, to be set by the caller (a pool thread first counts itself idle again,
+    /// so a submit right after the join finds it); a panic ends the job, not the thread (the panic hook has logged it).
+    fn execute(self) -> Arc<JobDone> {
+        let Self { run, done } = self;
+        let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(run));
+        done
+    }
+}
+
+/// EXP-183 (`rdpool=1`): persistent threads for the block readers. A submitted job takes an idle thread or, when none is
+/// idle, a new one, so every job starts at once: a block reader runs until its block stops, and a job queued behind one
+/// would not run before then. Between blocks the threads wait for the next job instead of exiting, so neither the
+/// block's start (thread creation) nor its end (thread exit) pays per thread. Threads end when the pool is dropped
+/// (only test pools; the node's pool lives as long as the process).
+#[derive(Debug)]
+struct ReaderPool {
+    tx: Sender<PoolJob>,
+    rx: Receiver<PoolJob>,
+    /// at most this many threads
+    max: usize,
+    /// threads created so far
+    threads: Arc<AtomicUsize>,
+    /// threads waiting for a job and not yet reserved by a submit
+    idle: Arc<AtomicUsize>,
+    /// threads running a job
+    busy: Arc<AtomicUsize>,
+    /// most threads running a job at once since the last reset (the block's start)
+    busy_peak: Arc<AtomicUsize>,
+    /// jobs that found the pool at `max` with no idle thread and ran on a thread of their own
+    overflow: AtomicU64,
+    /// nice value of the thread that made the pool (the engine thread, at the first block's start); a new pool thread
+    /// inherits its creator's nice and could not lower it again, so a submit from a thread with another nice value that
+    /// needs a new thread runs the job on a thread of its own instead (X-018's review)
+    nice: i32,
+    /// jobs run on a thread of their own because the submitting thread's nice differed from `nice`
+    nice_unpooled: AtomicU64,
+    /// Prologue (`rdnicepool`): the nice value every thread of this pool sets for itself when it is created; then the
+    /// submitting thread's nice does not matter
+    set_nice: Option<u32>,
+}
+
+/// EXP-183: the reader pool's limit. Its readers hold read-only transactions only while a job runs (reth opens the
+/// database with `MDBX_NOSTICKYTHREADS`: a reader slot belongs to a transaction, not a thread, and a dropped one goes back
+/// to the shared pool of reset handles, `libmdbx-rs` `txn_pool.rs`), so an idle pool thread holds no reader slot; the most
+/// pooled jobs at once are a block's readers (`readers`, 8) plus its extra readers behind the gate (`pwlxrd`, 8) plus, with
+/// `rdjoinlate`, the previous block's still running (at most as many again): 32, against 32,000 reader slots
+/// (`DEFAULT_MAX_READERS`, `db/src/implementation/mdbx/mod.rs`). 64 leaves room for twice that.
+const RDPOOL_MAX: usize = 64;
+
+/// EXP-183 (`rdpool=1`): the thread-local state a reader job may leave on its thread, reset at the start of every reader
+/// job (a pool thread runs the readers of many blocks): the tag source of its cache fills, the large-value read-ahead
+/// mark, the execution cache's speculative-discovery buffer, prewarm-transaction counter and fill counters, and this
+/// module's prewarm transaction index.
+fn reader_thread_reset() {
+    reth_execution_cache::cc_set_tag_source(reth_execution_cache::CC_SRC_EAP_TX);
+    reth_db::mdbx::set_thread_large_readahead(true);
+    if reth_execution_cache::cc_discovering() {
+        let _ = reth_execution_cache::cc_discover_end();
+    }
+    reth_execution_cache::cc_tx_begin(0);
+    let _ = reth_execution_cache::cc_fill_take();
+    // EXP-184: a job that panicked between `cd_fill_begin` and `cd_fill_end` left this thread counting
+    let _ = reth_execution_cache::cd_fill_end();
+    PW_CUR_TX.with(|c| c.set(u32::MAX));
+    PW_TX_JOBS.with(|c| c.set(0));
+}
+
+impl std::fmt::Debug for PoolJob {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("PoolJob").finish_non_exhaustive()
+    }
+}
+
+impl ReaderPool {
+    fn new() -> Self {
+        Self::with_max(RDPOOL_MAX)
+    }
+
+    fn with_max(max: usize) -> Self {
+        let (tx, rx) = crossbeam_channel::unbounded();
+        let z = || Arc::new(AtomicUsize::new(0));
+        Self {
+            tx,
+            rx,
+            max,
+            threads: z(),
+            idle: z(),
+            busy: z(),
+            busy_peak: z(),
+            overflow: AtomicU64::new(0),
+            nice: own_nice(),
+            nice_unpooled: AtomicU64::new(0),
+            set_nice: None,
+        }
+    }
+
+    fn threads(&self) -> usize {
+        self.threads.load(Ordering::Relaxed)
+    }
+
+    /// Runs `run` on an idle pool thread, or on a new one (named `{name}-{k}`) when none is idle, or, when none is idle
+    /// and the pool is at its limit, on a thread of its own (named `{name}-x`).
+    fn submit(&self, name: &str, run: Box<dyn FnOnce() + Send>) -> Option<ReaderHandle> {
+        // a thread counts itself idle before it waits; a submit reserves one by taking that count
+        if self.idle.fetch_update(Ordering::AcqRel, Ordering::Acquire, |n| n.checked_sub(1)).is_ok() {
+            let done = Arc::new(JobDone::default());
+            self.tx.send(PoolJob { run, done: done.clone() }).ok()?;
+            return Some(ReaderHandle::Pooled(done))
+        }
+        if self.set_nice.is_none() && own_nice() != self.nice {
+            self.nice_unpooled.fetch_add(1, Ordering::Relaxed);
+            return thread::Builder::new().name(format!("{name}-n")).spawn(run).ok().map(ReaderHandle::Thread)
+        }
+        let Ok(k) = self.threads.fetch_update(Ordering::AcqRel, Ordering::Acquire, |n| (n < self.max).then_some(n + 1)) else {
+            self.overflow.fetch_add(1, Ordering::Relaxed);
+            return thread::Builder::new().name(format!("{name}-x")).spawn(run).ok().map(ReaderHandle::Thread)
+        };
+        let done = Arc::new(JobDone::default());
+        let job = PoolJob { run, done: done.clone() };
+        let (rx, idle, busy, peak) = (self.rx.clone(), self.idle.clone(), self.busy.clone(), self.busy_peak.clone());
+        let set_nice = self.set_nice;
+        if thread::Builder::new()
+            .name(format!("{name}-{k}"))
+            .spawn(move || {
+                if let Some(n) = set_nice {
+                    set_own_nice(n);
+                }
+                let mut next = Some(job);
+                while let Some(j) = next.take() {
+                    peak.fetch_max(busy.fetch_add(1, Ordering::AcqRel) + 1, Ordering::AcqRel);
+                    let done = j.execute();
+                    busy.fetch_sub(1, Ordering::AcqRel);
+                    // idle again before the join can return: a submit right after it takes this thread
+                    idle.fetch_add(1, Ordering::AcqRel);
+                    done.set();
+                    next = rx.recv().ok();
+                }
+            })
+            .is_err()
+        {
+            self.threads.fetch_sub(1, Ordering::Relaxed);
+            return None
+        }
+        Some(ReaderHandle::Pooled(done))
+    }
+}
+
+/// EXP-183 (`rdpool=1`): the node's reader pool. It is made by its first access, which is the engine thread's in
+/// `BlockPrefetch::start` (before any reader or extrapolation gate of the block exists, and nothing else touches the pool
+/// earlier), so the pool's nice value (`ReaderPool::nice`) is the engine thread's.
+static READER_POOL: std::sync::LazyLock<ReaderPool> = std::sync::LazyLock::new(ReaderPool::new);
+
+/// Prologue (`rdnicepool`): the pool of the readers of blocks with `rdnice=N > 0`; its threads set nice N themselves
+/// (`set_nice`, the first such block's value: a mode with another N later still gets nice N threads, which is what
+/// [`Mode::rdnicepool`] documents for one value per run).
+static READER_POOL_NICE: std::sync::LazyLock<ReaderPool> = std::sync::LazyLock::new(|| {
+    let mut p = ReaderPool::new();
+    p.set_nice = Some(current().rdnice.max(1));
+    p
+});
+
