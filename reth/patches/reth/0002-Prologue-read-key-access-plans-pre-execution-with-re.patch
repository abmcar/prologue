+            Inspector::<BaseEvmTypes>::step_end(&mut self.pw, interp);
+        }
+        fn call(&mut self, interp: &mut Interpreter<'_, '_, BaseEvmTypes>, m: &mut Message<BaseEvmTypes>) -> Option<MessageResult<BaseEvmTypes>> {
+            self.pw.call(interp, m)
+        }
+        fn call_end(&mut self, interp: &mut Interpreter<'_, '_, BaseEvmTypes>, m: &Message<BaseEvmTypes>, r: &mut MessageResult<BaseEvmTypes>) {
+            self.pw.call_end(interp, m, r);
+        }
+        fn create(&mut self, interp: &mut Interpreter<'_, '_, BaseEvmTypes>, m: &mut Message<BaseEvmTypes>) -> Option<MessageResult<BaseEvmTypes>> {
+            self.pw.create(interp, m)
+        }
+        fn create_end(&mut self, interp: &mut Interpreter<'_, '_, BaseEvmTypes>, m: &Message<BaseEvmTypes>, r: &mut MessageResult<BaseEvmTypes>) {
+            self.pw.create_end(interp, m, r);
+        }
+    }
+
+    /// Runs one transaction to `to` under the prewarm inspector (`pwcs=1 pwsync=1`: inner calls with a plan, keys
+    /// instantiated on the worker) and returns the keys it handed to the readers and the SLOADs the run executed.
+    fn run_case(db: MemDb, to: Address) -> (HashSet<(Address, U256)>, HashSet<(Address, U256)>, bool) {
+        install_plans();
+        let (tx, rx) = crossbeam_channel::unbounded();
+        let mode = Mode::parse("tx=1 pwcs=1 pwsync=1 pwk=0 pwmin=0");
+        assert!(mode.active && mode.pwcs == 1 && mode.pwsync && !mode.pwdedup && !mode.pwlx);
+        let mut rec = Rec {
+            pw: EapPwInspector {
+                tx: Some(tx),
+                stats: Some(Arc::new(Stats::default())),
+                all_depths: false,
+                mode,
+                exec_idx: Arc::new(AtomicUsize::new(0)),
+                info: info(),
+                lx: eap_lx::LxTracker::default(),
+                lx_dec_done: 0,
+                c2_done: 0,
+                lx_tx_ns: 0,
+                ended: None,
+                rdepth: 0,
+                tx_to: None,
+                tx_input: Bytes::new(),
+                lxk: 0,
+                lx_sent_cur: u32::MAX,
+                lx_kbuf: Vec::new(),
+                lx_kn: 0,
+                lx_gate: HashMap::new(),
+                lx_gate_cur: u32::MAX,
+            },
+            sloads: HashSet::new(),
+        };
+        let mut evm = evm(db);
+        let res = run(&mut evm, 0, to, &mut rec);
+        drop(rec.pw);
+        let mut keys = HashSet::new();
+        for it in rx.try_iter() {
+            match it {
+                Item::Keys(b) => {
+                    assert_eq!(b.3, reth_execution_cache::CC_SRC_EAP_PW);
+                    keys.extend(b.1.iter().map(|k| (b.0, *k)));
+                }
+                _ => panic!("pwsync=1 sends only keys"),
+            }
+        }
+        (keys, rec.sloads, res.status)
+    }
+
+    fn balance_slot(holder: Address) -> U256 {
+        let mut b = [0u8; 64];
+        b[12..32].copy_from_slice(holder.as_slice());
+        U256::from_be_bytes(keccak256(b).0)
+    }
+
+    /// `CALL(gas, target, 0, 0, 0, 0, 0)` and POP.
+    fn call(code: &mut Vec<u8>, target: Address, call_op: u8) {
+        let zeros = if call_op == op::CALL { 5 } else { 4 };
+        code.extend(std::iter::repeat_n(op::PUSH0, zeros));
+        push20(code, target);
+        code.extend([op::GAS, call_op, op::POP]);
+    }
+
+    /// CALL: the entry contract calls the token; the token's plan with the call's arguments (CALLER = the entry) gives
+    /// exactly the slots the token reads.
+    #[test]
+    fn call_keys_equal_the_callees_sloads() {
+        let mut db = MemDb::with_sender();
+        db.code(TOKEN, &TOKEN_CODE);
+        let mut entry = Vec::new();
+        call(&mut entry, TOKEN, op::CALL);
+        entry.push(op::STOP);
+        db.code(ENTRY, &entry);
+        let (keys, sloads, ok) = run_case(db, ENTRY);
+        assert!(ok);
+        assert_eq!(sloads, HashSet::from([(TOKEN, balance_slot(ENTRY)), (TOKEN, U256::from(1u8))]));
+        assert_eq!(keys, sloads);
+    }
+
+    /// EXP-236 (`cs=1`): the block executor's inspector, on a run without instruction hooks, counts every call frame and
+    /// hands the readers one frame job per call whose code has a plan: here the token called by the entry contract
+    /// (depth 1, caller = the entry), not the entry itself (no plan); the job instantiates to the slots the token reads.
+    #[test]
+    fn exec_inspector_queues_frames_with_plans() {
+        install_plans();
+        let mut db = MemDb::with_sender();
+        db.code(TOKEN, &TOKEN_CODE);
+        let mut entry = Vec::new();
+        call(&mut entry, TOKEN, op::CALL);
+        entry.push(op::STOP);
+        db.code(ENTRY, &entry);
+        let (tx, rx) = crossbeam_channel::unbounded();
+        let stats = Arc::new(Stats::default());
+        let mut insp = EapExecInspector { tx, stats: stats.clone() };
+        assert!(!Inspector::<BaseEvmTypes>::instruction_hooks(&insp) && Inspector::<BaseEvmTypes>::allows_compiled_frames(&insp));
+        let mut evm = evm(db);
+        assert!(run(&mut evm, 0, ENTRY, &mut insp).status);
+        let jobs: Vec<_> = rx.try_iter().map(|it| match it {
+            Item::Frame(j) => j,
+            _ => panic!("the execution-thread inspector sends only frame jobs"),
+        }).collect();
+        assert_eq!(jobs.len(), 1);
+        let j = &jobs[0];
+        assert_eq!((j.target, j.caller, j.origin, j.depth, j.pw, j.nb, j.tx), (TOKEN, ENTRY, SENDER, 1, false, false, u32::MAX));
+        let g = |a: &AtomicU64| a.load(Ordering::Relaxed);
+        assert_eq!((g(&stats.frames), g(&stats.frames_d0), g(&stats.frames_plan), g(&stats.frames_plan_d0), g(&stats.frames_plan_d1)), (2, 1, 1, 0, 1));
+        let mut sc = new_scratch();
+        sc.instantiate(&j.plan, &Frame { calldata: &j.input, env: info().env(j.caller, j.origin, j.target, j.value, j.input.len()), sload: None });
+        let keys: HashSet<U256> = sc.out.iter().copied().collect();
+        assert_eq!(keys, HashSet::from([balance_slot(ENTRY), U256::from(1u8)]));
+    }
+
+    /// DELEGATECALL through a proxy: the implementation's plan runs on the proxy's storage with the proxy's caller (the
+    /// entry), as the implementation's SLOADs do.
+    #[test]
+    fn delegatecall_through_a_proxy_keys_equal_the_sloads() {
+        let mut db = MemDb::with_sender();
+        db.code(TOKEN, &TOKEN_CODE);
+        let mut proxy = Vec::new();
+        call(&mut proxy, TOKEN, op::DELEGATECALL);
+        proxy.push(op::STOP);
+        db.code(PROXY, &proxy);
+        let mut entry = Vec::new();
+        call(&mut entry, PROXY, op::CALL);
+        entry.push(op::STOP);
+        db.code(ENTRY, &entry);
+        let (keys, sloads, ok) = run_case(db, ENTRY);
+        assert!(ok);
+        assert_eq!(sloads, HashSet::from([(PROXY, balance_slot(ENTRY)), (PROXY, U256::from(1u8))]));
+        assert_eq!(keys, sloads);
+    }
+
+    /// CREATE2: the factory deploys the token's code and calls the new contract; the call's plan (found by the deployed
+    /// code's hash) gives the new contract's slots with the factory as CALLER.
+    #[test]
+    fn create2_then_call_keys_equal_the_sloads() {
+        let mut db = MemDb::with_sender();
+        // init code: PUSH19 <token code> PUSH0 MSTORE PUSH1 19 PUSH1 13 RETURN (27 bytes)
+        let mut init = vec![op::PUSH19];
+        init.extend_from_slice(&TOKEN_CODE);
+        init.extend([op::PUSH0, op::MSTORE, op::PUSH1, 19, op::PUSH1, 13, op::RETURN]);
+        assert_eq!(init.len(), 27);
+        // factory: PUSH27 <init> PUSH0 MSTORE; CREATE2(0, 5, 27, SALT); CALL(gas, created, 0, 0, 0, 0, 0)
+        let mut f = vec![op::PUSH27];
+        f.extend_from_slice(&init);
+        f.extend([op::PUSH0, op::MSTORE, op::PUSH1, SALT, op::PUSH1, 27, op::PUSH1, 5, op::PUSH0, op::CREATE2]);
+        f.extend([op::PUSH0, op::PUSH0, op::PUSH0, op::PUSH0, op::PUSH0, op::DUP6, op::GAS, op::CALL, op::POP, op::POP, op::STOP]);
+        db.code(FACTORY, &f);
+        let child = FACTORY.create2(B256::left_padding_from(&[SALT]), keccak256(&init));
+        let (keys, sloads, ok) = run_case(db, FACTORY);
+        assert!(ok);
+        assert_eq!(sloads, HashSet::from([(child, balance_slot(FACTORY)), (child, U256::from(1u8))]));
+        assert_eq!(keys, sloads);
+    }
+}
