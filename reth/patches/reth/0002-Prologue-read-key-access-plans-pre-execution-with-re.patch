+    /// Prologue (`reusediag`): an account's last writer is the last commit that changed its info, not one that changed
+    /// only its storage; a slot's is the later of its own last change and the account's last creation, destruction or
+    /// storage wipe.
+    #[test]
+    fn reusediag_writer_of_an_account_and_a_slot() {
+        let (a, k) = (Address::repeat_byte(0xaa), U256::from(7));
+        let info = |balance: u64| Some(AccountInfo { balance: U256::from(balance), nonce: 1, ..Default::default() });
+        let update = |original, current, wiped, slot: bool| StateUpdate {
+            accounts: vec![AccountUpdate {
+                address: a,
+                original,
+                current,
+                created: false,
+                wiped,
+                storage: if slot { vec![(k, StorageSlot::new_changed(U256::ZERO, U256::from(1)))] } else { Vec::new() },
+            }],
+        };
+        let tx = |index| Writer::Tx { index, reused: false };
+        let mut d = Diag::default();
+        d.record(&update(info(5), info(5), false, true));
+        assert_eq!((d.writer(a, None), d.writer(a, Some(k))), (None, Some(Writer::PreBlock)), "storage only");
+        d.cur = tx(1);
+        d.record(&update(info(5), info(6), false, false));
+        assert_eq!((d.writer(a, None), d.writer(a, Some(k))), (Some(tx(1)), Some(Writer::PreBlock)), "balance");
+        d.cur = tx(2);
+        d.record(&update(info(6), info(6), true, false));
+        assert_eq!((d.writer(a, None), d.writer(a, Some(k))), (Some(tx(1)), Some(tx(2))), "storage wiped");
+        d.cur = tx(3);
+        d.record(&update(info(6), info(6), false, true));
+        assert_eq!(d.writer(a, Some(k)), Some(tx(3)), "written again after the wipe");
+        assert_eq!(d.writer(Address::repeat_byte(0xbb), None), None, "never written");
+    }
