+            assert!(g.missed.is_empty());
+        }
+        for c in [
+            &stats.miss_unpred,
+            &stats.miss_queued,
+            &stats.miss_inflight,
+            &stats.miss_done,
+            &stats.join_wait_ns,
+            &stats.claimed,
+        ] {
+            assert_eq!(c.load(Ordering::Relaxed), 0);
+        }
+        assert_eq!(take_inflight_counts(&counts), [1u64, 2, 1, 1]);
+        assert_eq!(take_inflight_counts(&counts), [0u64; 4]);
+    }
+
+    /// X-029 (`infprobe`): off unless a control line asks for it; no row of the final table does.
+    #[test]
+    fn infprobe_is_off_unless_asked() {
+        for (name, ctrl) in AB_NG {
+            assert!(!Mode::parse(ctrl).infprobe, "{name}");
+        }
+        assert!(!Mode::parse("prewarm=1 ewinf=1").infprobe);
+        assert!(Mode::parse("prewarm=1 ewinf=1 infprobe=1").infprobe);
+    }
+
+    /// EXP-240 (`rdspawn`): off unless a control line asks for it; the helper thread runs a job that creates readers, and
+    /// the handle of readers being created joins all of them.
+    #[test]
+    fn rdspawn_helper_creates_and_joins() {
+        for (name, ctrl) in AB_NG {
+            assert!(!Mode::parse(ctrl).rdspawn, "{name}");
+        }
+        assert!(Mode::parse("prewarm=1 rdspawn=1").rdspawn);
+        let helper = RD_SPAWNER.as_ref().expect("the helper thread starts");
+        let ran = Arc::new(AtomicUsize::new(0));
+        let (tx, rx) = crossbeam_channel::bounded(1);
+        let r = ran.clone();
+        let job: Box<dyn FnOnce() + Send> = Box::new(move || {
+            let handles: Vec<_> = (0..3)
+                .filter_map(|_| {
+                    let r = r.clone();
+                    thread::Builder::new()
+                        .spawn(move || {
+                            r.fetch_add(1, Ordering::Relaxed);
+                        })
+                        .ok()
+                        .map(ReaderHandle::Thread)
+                })
+                .collect();
+            let _ = tx.send((handles, 0, 0));
+        });
+        assert!(helper.send(job).is_ok());
+        ReaderHandle::Spawning(rx).join();
+        assert_eq!(ran.load(Ordering::Relaxed), 3);
+    }
+}
