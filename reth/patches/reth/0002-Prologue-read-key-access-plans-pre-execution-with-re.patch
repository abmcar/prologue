+thread_local! {
+    /// Prewarm worker: block index of the transaction it is executing.
+    static PW_CUR_TX: std::cell::Cell<u32> = const { std::cell::Cell::new(u32::MAX) };
+    /// Prewarm worker: plan jobs issued in the current transaction (EXP-080 candidates).
+    static PW_TX_JOBS: std::cell::Cell<u32> = const { std::cell::Cell::new(0) };
+    /// Prewarm worker: scratch space for synchronous instantiation (`pwsync=1`).
+    static PW_SCRATCH: std::cell::RefCell<Option<Scratch>> = const { std::cell::RefCell::new(None) };
+    /// EXP-187 (`pwjitkec=1`): KECCAK256 inputs compiled prewarm code hashed on this thread, with the transaction
+    /// ([`PW_CUR_TX`]) they belong to; emptied when the thread's prewarm EVM is built for a block and when a
+    /// transaction starts, taken by the inspector's next frame hook.
+    static PW_KECCAK: std::cell::RefCell<Vec<(u32, Box<[u8]>)>> = const { std::cell::RefCell::new(Vec::new()) };
+    /// EXP-187: this thread's callbacks, inputs kept and inputs dropped since the last [`pw_keccak_flush`].
+    static PW_KECCAK_STAT: std::cell::Cell<[u64; 3]> = const { std::cell::Cell::new([0; 3]) };
+    /// Prologue (`ixpf`): whether this thread's KECCAK256 callback keeps inputs in [`PW_KECCAK`] (`pwjitkec`); the
+    /// callback is also installed for the index-key extrapolation alone, which must not feed the loop-call extrapolation.
+    static PW_KECCAK_FEED: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+/// EXP-187: callbacks, inputs kept and inputs dropped (buffer busy or full, thread-local storage gone) since the last
+/// `eap block` line, summed over the prewarm threads at [`pw_keccak_flush`].
+static PW_KECCAK_COUNTS: [AtomicU64; 3] = [AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0)];
+
+/// EXP-187: inputs kept per transaction at most (beyond them the extrapolation's preimage table is full anyway).
+const PW_KECCAK_CAP: usize = 4096;
+
+/// EXP-187 (`pwjitkec=1`): revmc's KECCAK256 callback on the prewarm threads that run compiled code. With the feed on
+/// ([`pw_keccak_feed`]) it keeps the inputs the inspector's `step` would see in an interpreted frame (85 bytes, or 32 to
+/// 160 bytes), tagged with the current transaction, and counts its calls; without it, nothing is kept or counted.
+/// Prologue (`ixpf`): a 64-byte input also goes to the thread's index-key extrapolation, if it has one ([`ix`]).
+///
+/// It is called from inside compiled code (a revmc builtin), where a panic cannot unwind and aborts the process, so it
+/// uses only non-panicking accessors: an input that cannot be kept (the buffer is borrowed or full, the thread-local
+/// storage is gone) is dropped and counted.
+pub fn pw_keccak_hook(m: &[u8]) {
+    ix::keccak_input(m);
+    if !PW_KECCAK_FEED.try_with(|f| f.get()).unwrap_or(false) {
+        return
+    }
+    let kept = if m.len() != 85 && !(32..=160).contains(&m.len()) {
+        None
+    } else {
+        let cur = PW_CUR_TX.try_with(|c| c.get()).unwrap_or(u32::MAX);
+        Some(
+            PW_KECCAK
+                .try_with(|b| match b.try_borrow_mut() {
+                    Ok(mut b) if b.len() < PW_KECCAK_CAP => {
+                        b.push((cur, m.into()));
+                        true
+                    }
+                    _ => false,
+                })
+                .unwrap_or(false),
+        )
+    };
+    let _ = PW_KECCAK_STAT.try_with(|s| {
+        let mut v = s.get();
+        v[0] += 1;
+        match kept {
+            Some(true) => v[1] += 1,
+            Some(false) => v[2] += 1,
+            None => {}
+        }
+        s.set(v);
+    });
+}
+
+/// EXP-187: adds this thread's callback counts to the block's totals (`eap block` line: kec_calls, kec_kept,
+/// kec_dropped).
+fn pw_keccak_flush() {
+    if let Ok(v) = PW_KECCAK_STAT.try_with(|s| s.replace([0; 3])) &&
+        v[0] > 0
+    {
+        for (c, x) in PW_KECCAK_COUNTS.iter().zip(v) {
+            c.fetch_add(x, Ordering::Relaxed);
+        }
+    }
+}
+
+/// Prologue (`ixpf`): whether this thread's KECCAK256 callback keeps inputs for the loop-call extrapolation (`pwjitkec`),
+/// set with the callback when the thread builds its prewarm EVM for a block.
+pub fn pw_keccak_feed(on: bool) {
+    let _ = PW_KECCAK_FEED.try_with(|f| f.set(on));
+}
+
+/// EXP-187: empties this thread's KECCAK256 inputs (a new block's prewarm EVM, a new transaction).
+pub fn pw_keccak_reset() {
+    pw_keccak_flush();
+    PW_KECCAK.with(|b| b.borrow_mut().clear());
+}
+
+/// EXP-187: takes this thread's KECCAK256 inputs of transaction `cur`; inputs of any other transaction are dropped.
+fn pw_keccak_take(cur: u32) -> Vec<Box<[u8]>> {
+    pw_keccak_flush();
+    PW_KECCAK.with(|b| {
+        let mut b = b.borrow_mut();
+        if b.is_empty() {
+            return Vec::new()
+        }
+        b.drain(..).filter(|(t, _)| *t == cur).map(|(_, m)| m).collect()
+    })
+}
