+    static DIAG_EV_SHARD: usize = DIAG_EV_NEXT.fetch_add(1, Ordering::Relaxed) % DIAG_EV_SHARDS;
+    /// X-027: the execution thread's block diagnostics, taken once per block (no global lock per transaction).
+    static DIAG_EXEC_BLOCK: std::cell::RefCell<Option<Arc<DiagBlock>>> = const { std::cell::RefCell::new(None) };
+}
+
+impl DiagBlock {
+    fn new(t0: u64, ru: bool) -> Self {
+        Self { t0, inner: Default::default(), ru, ev: std::array::from_fn(|_| Default::default()) }
+    }
+
+    fn push(&self, e: DiagEv) {
+        self.ev[DIAG_EV_SHARD.with(|s| *s)].lock().push(e);
+    }
+
+    /// Applies the buffered records to `g` in time order (each thread's own records are in its order already).
+    fn settle(&self, g: &mut DiagInner) {
+        let mut all = Vec::new();
+        for sh in &self.ev {
+            all.append(&mut sh.lock());
+        }
+        all.sort_by_key(DiagEv::key);
+        fn tx(g: &mut DiagInner, i: u32) -> &mut DiagTx {
+            let i = i as usize;
+            if g.txs.len() <= i {
+                g.txs.resize(i + 1, DiagTx::default());
+            }
+            &mut g.txs[i]
+        }
+        for e in all {
+            match e {
+                DiagEv::Dispatch { i, t, skipped } => {
+                    let x = tx(g, i);
+                    x.dispatch = t;
+                    x.status = if skipped { diag_status::SKIP_DISPATCH } else { diag_status::DISPATCHED };
+                }
+                DiagEv::Start { i, t } => tx(g, i).ws = t,
+                DiagEv::Skip { i, t, status } => {
+                    let x = tx(g, i);
+                    x.status = status;
+                    x.ws = t;
+                }
+                DiagEv::End { i, t, pw, ru, ok } => {
+                    let x = tx(g, i);
+                    x.we = t;
+                    x.pw = pw;
+                    x.ru = ru;
+                    x.status = if ok { diag_status::DONE } else { diag_status::ERROR };
+                }
+                DiagEv::ExecStart { i, t } => tx(g, i).es = t,
+                DiagEv::ExecEnd { i, t } => tx(g, i).ee = t,
+                DiagEv::Exec { i, lk, mut misses, mut other, mut frames, .. } => {
+                    let dst = match i {
+                        DIAG_PRE => &mut g.pre,
+                        DIAG_POST => &mut g.post,
+                        i => &mut tx(g, i).lk,
+                    };
+                    for k in 0..4 {
+                        dst[k] += lk[k];
+                    }
+                    g.misses.append(&mut misses);
+                    g.other.append(&mut other);
+                    g.frames.append(&mut frames);
+                }
+                DiagEv::Event { name, t } => g.events.push((name, t)),
+            }
+        }
+    }
+
+    /// Prewarm task saw transaction `i`; `skipped` when the execution thread had already executed it.
+    pub fn pw_dispatch(&self, i: usize, skipped: bool) {
+        self.push(DiagEv::Dispatch { i: i as u32, t: diag_now_ns(), skipped });
+    }
+
+    /// Prewarm worker returned without executing transaction `i`.
+    pub fn pw_skip(&self, i: usize, status: u8) {
+        self.push(DiagEv::Skip { i: i as u32, t: diag_now_ns(), status });
+    }
+
+    /// Prewarm worker starts executing transaction `i`; resets this thread's fill-miss counters.
+    pub fn pw_start(&self, i: usize) {
+        DIAG_FILL.with(|c| c.set([(0, 0); 3]));
+        DIAG_PW_TX.with(|c| c.set(i as u32));
+        DIAG_FRAMES.with(|f| f.borrow_mut().clear());
+        DIAG_STACK.with(|f| f.borrow_mut().clear());
+        if self.ru {
+            PWRU_START.with(|c| c.set(thread_usage(true)));
+        }
+        self.push(DiagEv::Start { i: i as u32, t: diag_now_ns() });
+    }
+
+    /// Prewarm worker finished executing transaction `i`.
+    pub fn pw_end(&self, i: usize, ok: bool) {
+        let t = diag_now_ns();
+        let ru = if self.ru {
+            let (u0, u1) = (PWRU_START.with(|c| c.get()), thread_usage(false));
+            [0, 1, 2, 3, 4].map(|k| u1[k].saturating_sub(u0[k]).min(u64::from(u32::MAX)) as u32)
+        } else {
+            [0; 5]
+        };
+        let pw = DIAG_FILL.with(|c| c.get());
+        DIAG_PW_TX.with(|c| c.set(u32::MAX));
+        let frames = DIAG_FRAMES.with(|f| std::mem::take(&mut *f.borrow_mut()));
+        if !frames.is_empty() {
+            self.push(DiagEv::Exec { i: DIAG_POST, t, lk: [0; 4], misses: Vec::new(), other: Vec::new(), frames });
+        }
+        self.push(DiagEv::End { i: i as u32, t, pw, ru, ok });
+    }
+
+    /// EXP-169: the block's diagnostics time base (`diag_now_ns()` at the block start).
+    pub const fn t0(&self) -> u64 {
+        self.t0
+    }
+
+    /// Records a named per-block value (a time is given as `diag_now_ns()`).
+    pub fn mark(&self, name: &'static str, v: u64) {
+        crate::lkprof::lock(crate::lkprof::DIAG, &self.inner).marks.push((name, v));
+    }
+
+    /// Records a named event time that may occur many times per block (EXP-019 debugging).
+    pub fn event(&self, name: &'static str) {
+        self.push(DiagEv::Event { name, t: diag_now_ns() });
+    }
+
+    /// X-027 (tests of the prewarm paths): a block's diagnostics that is not the current block's (`cc_diag_block`
+    /// returns only the block started by [`cc_diag_reset`] while `EAP_DIAG` is set).
+    #[doc(hidden)]
+    pub fn detached() -> Self {
+        Self::new(diag_now_ns(), false)
+    }
+
+    /// X-027 (tests): transaction `i`'s prewarm status and its dispatch, worker start and worker end times (ns, 0 when
+    /// not set), when it has a record.
+    #[doc(hidden)]
+    pub fn tx_times(&self, i: usize) -> Option<(u8, u64, u64, u64)> {
+        let mut g = crate::lkprof::lock(crate::lkprof::DIAG, &self.inner);
+        self.settle(&mut g);
+        g.txs.get(i).map(|x| (x.status, x.dispatch, x.ws, x.we))
+    }
+
+    /// X-027 (tests): the names of the events recorded so far, in order.
+    #[doc(hidden)]
+    pub fn event_names(&self) -> Vec<&'static str> {
+        let mut g = crate::lkprof::lock(crate::lkprof::DIAG, &self.inner);
+        self.settle(&mut g);
+        g.events.iter().map(|(n, _)| *n).collect()
+    }
+}
