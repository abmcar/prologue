+
+    fn lookup_request(code: &[u8]) -> LookupRequest {
+        LookupRequest {
+            key: RuntimeCacheKey { code_hash: keccak256(code), spec_id: SpecId::CANCUN },
+            code: Bytes::copy_from_slice(code),
+        }
+    }
+
+    /// An unobserved factory's lookups neither count towards hotness nor trigger compilation, but
+    /// run what the observing handles got compiled.
+    #[test]
+    fn unobserved_lookups_only_read_compiled_code() {
+        // PUSH1 0x42 PUSH0 MSTORE PUSH1 0x20 PUSH0 RETURN
+        const CODE: &[u8] = &[0x60, 0x42, 0x5f, 0x52, 0x60, 0x20, 0x5f, 0xf3];
+        let backend = JitBackend::new(RuntimeConfig {
+            enabled: true,
+            tuning: RuntimeTuning {
+                jit_hot_threshold: 1,
+                jit_worker_count: 1,
+                ..Default::default()
+            },
+            ..Default::default()
+        })
+        .unwrap();
+        let mut factory = RethEvmFactory::new(backend.clone());
+        assert!(factory.jit_observation());
+        factory.set_jit_observation(false);
+        let unobserved = factory.backend().clone();
+        assert!(!unobserved.observes() && backend.observes());
+
+        for _ in 0..10 {
+            assert!(matches!(
+                unobserved.lookup(lookup_request(CODE)),
+                LookupDecision::Unavailable(LookupMissReason::NotReady)
+            ));
+        }
+        std::thread::sleep(Duration::from_millis(200));
+        let stats = backend.stats();
+        assert_eq!((stats.lookup_hits, stats.lookup_misses), (0, 0));
+        assert_eq!(stats.compilations_dispatched, 0);
+        assert_eq!((stats.unobserved_hits, stats.unobserved_misses), (0, 10));
+
+        let deadline = Instant::now() + Duration::from_secs(60);
+        while !matches!(backend.lookup(lookup_request(CODE)), LookupDecision::Compiled(_)) {
+            assert!(Instant::now() < deadline, "not compiled within 60 s");
+            std::thread::sleep(Duration::from_millis(20));
+        }
+        assert!(matches!(unobserved.lookup(lookup_request(CODE)), LookupDecision::Compiled(_)));
+        assert_eq!(backend.stats().unobserved_hits, 1);
+    }
+
+    static KECCAK_SEEN: std::sync::Mutex<Vec<Vec<u8>>> = std::sync::Mutex::new(Vec::new());
+
+    fn record_keccak(m: &[u8]) {
+        KECCAK_SEEN.lock().unwrap().push(m.to_vec());
+    }
+
+    /// Runs `code` once as a top-level message on an EVM configured by `factory` (the runner the
+    /// factory installs); returns the KECCAK256 inputs the thread's callback saw during the run and
+    /// whether the run returned without error.
+    fn call_once(factory: &RethEvmFactory, code: &[u8]) -> (Vec<Vec<u8>>, bool) {
+        let me = Address::repeat_byte(0x11);
+        let mut database = InMemoryDB::default();
+        database.insert_account_info(
+            &me,
+            AccountInfo::default().with_code(Bytecode::new_legacy(Bytes::copy_from_slice(code))),
+        );
+        let mut evm = Evm::<BaseEvmTypes>::new(
+            SpecId::CANCUN,
+            BlockEnvExt::default(),
+            ethereum_tx_registry(SpecId::CANCUN),
+            database,
+            Precompiles::base(SpecId::CANCUN),
+        );
+        EvmFactory::configure_evm(factory, &mut evm);
+        let tx_env = TxEnvExt::default();
+        let mut message = MessageExt {
+            gas_limit: 1_000_000,
+            destination: me,
+            code_address: me,
+            code: Bytecode::new_legacy(Bytes::copy_from_slice(code)),
+            ..MessageExt::default()
+        };
+        KECCAK_SEEN.lock().unwrap().clear();
+        let ok = Host::execute_message(&mut evm, &tx_env, &mut message).is_ok();
+        (std::mem::take(&mut *KECCAK_SEEN.lock().unwrap()), ok)
+    }
+
+    /// The KECCAK256 callback (EXP-187 `pwjitkec`): compiled code hands every KECCAK256 input to the
+    /// callback of the thread it runs on; the interpreter does not call it, nor does compiled code
+    /// once the callback is removed.
+    #[test]
+    fn compiled_keccak_inputs_reach_the_thread_callback() {
+        // PUSH1 0x40 PUSH0 KECCAK256 POP STOP: hashes 64 bytes of (zero) memory
+        const CODE: &[u8] = &[0x60, 0x40, 0x5f, 0x20, 0x50, 0x00];
+        let backend =
+            JitBackend::new(RuntimeConfig { enabled: true, blocking: true, ..Default::default() })
+                .unwrap();
+        let mut factory = RethEvmFactory::new(backend.clone());
+        factory.set_jit_support(true);
+        reth_evm::JitBackend::set_keccak_hook(&factory, Some(record_keccak as fn(&[u8])));
+        let (seen, ok) = call_once(&factory, CODE);
+        assert!(ok);
+        assert!(backend.stats().compilations_succeeded > 0, "the code ran compiled");
+        assert_eq!(seen, vec![vec![0u8; 64]]);
+
+        let mut interpreted = RethEvmFactory::new(backend);
+        interpreted.set_jit_support(false);
+        let (seen, ok) = call_once(&interpreted, CODE);
+        assert!(ok && seen.is_empty(), "the interpreter does not call the callback");
+
+        reth_evm::JitBackend::set_keccak_hook(&factory, None);
+        let (seen, ok) = call_once(&factory, CODE);
+        assert!(ok && seen.is_empty(), "no callback once removed");
+    }
+
+    /// The balance callback is supported by the factory and reaches evm2-jit's thread-local hook.
+    #[test]
+    fn balance_hook_is_supported() {
+        let factory = RethEvmFactory::disabled();
+        assert!(reth_evm::JitBackend::set_balance_hook(&factory, Some(|_a: Address| {})));
+        assert!(reth_evm::JitBackend::set_balance_hook(&factory, None));
+    }
+}
