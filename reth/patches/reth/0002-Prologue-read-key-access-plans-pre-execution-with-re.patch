+/// X-027 (`bigra`, EXP-158): a value larger than one page reads back unchanged with the large-value
+/// read-ahead off, on for every thread (1) and on for marked threads only (2), in a read-only transaction.
+#[test]
+fn test_large_value_readahead_modes() {
+    use std::sync::atomic::Ordering;
+    let dir = tempdir().unwrap();
+    let env = Environment::builder().open(dir.path()).unwrap();
+    let big: Vec<u8> = (0..20_000u32).map(|i| (i % 251) as u8).collect();
+    let txn = env.begin_rw_txn().unwrap();
+    let db = txn.open_db(None).unwrap();
+    txn.put(db.dbi(), b"big", &big, WriteFlags::empty()).unwrap();
+    txn.put(db.dbi(), b"small", b"v", WriteFlags::empty()).unwrap();
+    txn.commit().unwrap();
+    for (mode, marked) in [(0u8, false), (1, false), (2, false), (2, true)] {
+        LARGE_READAHEAD.store(mode, Ordering::Relaxed);
+        set_thread_large_readahead(marked);
+        let txn = env.begin_ro_txn().unwrap();
+        let db = txn.open_db(None).unwrap();
+        let v: Vec<u8> = txn.get(db.dbi(), b"big").unwrap().unwrap();
+        assert_eq!(v, big, "mode {mode} marked {marked}");
+        assert_eq!(txn.get::<Vec<u8>>(db.dbi(), b"small").unwrap(), Some(b"v".to_vec()));
+    }
+    LARGE_READAHEAD.store(0, Ordering::Relaxed);
+    set_thread_large_readahead(false);
+}
