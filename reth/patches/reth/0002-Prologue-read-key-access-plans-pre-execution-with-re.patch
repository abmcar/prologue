+/// EXP-199 (`ewinf`): on the execution thread after the block's execution: its misses that found their slot in flight, of
+/// them answered from the cache after the wait, the time waited and the waits that reached the limit; the counters are
+/// reset at every block, so they belong to this block.
+/// EXP-210 (`lkprof`): on the execution thread after the block's execution: the waits for the profiled global locks since
+/// the previous block's line (taken and reset at every block, logged only with the switch).
+pub fn lk_log(block: u64) {
+    let line = reth_execution_cache::lkprof::take_line();
+    // `ewlf` bit 1 (lock-free block-write tables) is not ported (X-027): no overflow map, the field reads 0
+    let overflows = 0u64;
+    if current().lkprof {
+        info!(target: "reth::eap", "eap lk block={block} lf_overflows={overflows}{line}");
+    }
+}
+
+/// EXP-199 (`ewinf`): the `eap inflight` line of the block just executed (the execution cache's in-flight counters).
+/// X-029 (Master 11-04, `infprobe`): with the switch, the line also carries the found misses of the execution thread
+/// by their slot's state among the slots handed to the readers at the miss: `unpred` not handed out, `queued`,
+/// `reading` (a reader is reading it), `read`. Both kinds of counters are taken and reset every block; without the
+/// switch the line is as before. Prologue (`infwait`): both forms carry the block's bound of the wait (`infwait_us`).
+pub fn inflight_log(block: u64) {
+    let [found, joined, wait_ns, timeouts] = reth_execution_cache::inflight_take();
+    let [unpred, queued, reading, read] = take_inflight_counts(&INF_PROBE);
+    let m = current();
+    if m.ewinf && m.infprobe {
+        info!(
+            target: "reth::eap",
+            block,
+            found,
+            joined,
+            wait_us = wait_ns / 1000,
+            timeouts,
+            infprobe = true,
+            unpred,
+            queued,
+            reading,
+            read,
+            infwait_us = m.infwait,
+            "eap inflight"
+        );
+    } else if m.ewinf {
+        info!(
+            target: "reth::eap",
+            block,
+            found,
+            joined,
+            wait_us = wait_ns / 1000,
+            timeouts,
+            infwait_us = m.infwait,
+            "eap inflight"
+        );
+    }
+}
