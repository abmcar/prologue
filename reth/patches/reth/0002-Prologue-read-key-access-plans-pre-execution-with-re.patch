+thread_local! {
+    /// Storage discovery (EXP-019): storage keys a speculative run on this thread wanted but the execution cache did
+    /// not hold; `Some` while a speculative run is active.
+    static CC_DISCOVER: std::cell::RefCell<Option<Vec<(Address, StorageKey)>>> = const { std::cell::RefCell::new(None) };
+}
