+        // a damaged block is caught by the checksum, a truncated file by the length
+        let mut b = std::fs::read(&p).unwrap();
+        b[HEADER_LEN + 5] ^= 1;
+        std::fs::write(&p, &b).unwrap();
+        assert!(AccFilter::load(&p).unwrap_err().contains("checksum"));
+        b.truncate(b.len() - 1);
+        std::fs::write(&p, &b).unwrap();
+        assert!(AccFilter::load(&p).unwrap_err().contains("length"));
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
+
+    // The process-wide filter: one test, since it can be installed once.
+    #[test]
+    fn install_checks_base_lookup_counts_and_check_mismatch() {
+        test_gate_this_thread();
+        // a file for another block is refused and nothing is installed
+        let f = AccFilter::with_capacity(1000, base(5));
+        assert!(!install(f, base(6), 1));
+        let mut other_hash = base(5);
+        other_hash.block_hash = key(99);
+        assert!(!install(AccFilter::with_capacity(1000, base(5)), other_hash, 1));
+        let mut other_count = base(5);
+        other_count.accounts += 1;
+        assert!(!install(AccFilter::with_capacity(1000, base(5)), other_count, 1));
+        assert_eq!(state(), (false, false));
+        set_use(true);
+        // without a valid filter every lookup goes to the database and nothing is counted
+        assert_eq!(lookup::<u8, ()>(&key(1), || Ok(Some(1))), Ok(Some(1)));
+        assert_eq!(take_counters(), Counters::default());
+
+        let f = AccFilter::with_capacity(1000, base(5));
+        for i in 0..500 {
+            f.insert(&key(i));
+        }
+        assert!(install(f, base(5), 1));
+        assert_eq!(state(), (true, true));
+        // present keys go to the database
+        assert_eq!(lookup::<u8, ()>(&key(3), || Ok(Some(3))), Ok(Some(3)));
+        // an absent key the filter rejects never reaches the database
+        let absent = (10_000..).map(key).find(|k| !FILTER.get().unwrap().may_contain(k)).unwrap();
+        assert_eq!(lookup::<u8, ()>(&absent, || panic!("database asked")), Ok(None));
+        // a false positive is counted
+        let fp = (10_000..).map(key).find(|k| FILTER.get().unwrap().may_contain(k)).unwrap();
+        assert_eq!(lookup::<u8, ()>(&fp, || Ok(None)), Ok(None));
+        // insertion makes a key visible to the lookup
+        let new = (20_000..).map(key).find(|k| !FILTER.get().unwrap().may_contain(k)).unwrap();
+        insert(&new);
+        inserted_batch_done();
+        assert_eq!(lookup::<u8, ()>(&new, || Ok(Some(9))), Ok(Some(9)));
+        let c = take_counters();
+        assert_eq!((c.lookups, c.absent, c.false_positive, c.inserts, c.checks), (4, 1, 1, 1, 0));
+        // switched off for a block: no counting, database asked
+        set_use(false);
+        assert_eq!(lookup::<u8, ()>(&absent, || Ok(None)), Ok(None));
+        assert_eq!(take_counters().lookups, 0);
+        set_use(true);
+        // checks: every "absent" answer checked; an existing account turns the filter off and its value is returned
+        set_check_every(1);
+        assert_eq!(lookup::<u8, ()>(&absent, || Ok(None)), Ok(None));
+        // a cache holding the filter's earlier "absent" answer for that account (as the execution cache holds the
+        // prewarm threads' answers): the function of `set_on_disable` drops it before the tripping lookup returns, so
+        // the next lookup through the cache misses and reads the account
+        let cache = std::sync::Arc::new(std::sync::Mutex::new(std::collections::HashMap::from([(absent, None::<u8>)])));
+        let calls = std::sync::Arc::new(AtomicU64::new(0));
+        {
+            let (cache, calls) = (cache.clone(), calls.clone());
+            set_on_disable(Some(Box::new(move || {
+                cache.lock().unwrap().clear();
+                calls.fetch_add(1, Ordering::Relaxed);
+            })));
+        }
+        assert_eq!(lookup::<u8, ()>(&absent, || Ok(Some(4))), Ok(Some(4)));
+        assert_eq!(calls.load(Ordering::Relaxed), 1);
+        assert!(cache.lock().unwrap().is_empty());
+        let c = take_counters();
+        assert_eq!((c.absent, c.checks, c.check_mismatch), (2, 2, 1));
+        assert_eq!(state(), (false, false));
+        let cached = cache.lock().unwrap().get(&absent).copied();
+        assert_eq!(cached.map_or_else(|| lookup::<u8, ()>(&absent, || Ok(Some(4))), Ok), Ok(Some(4)));
+        assert_eq!(take_counters().lookups, 0);
+        // the function runs once: a later call finds the filter off already
+        disable("test");
+        assert_eq!(calls.load(Ordering::Relaxed), 1);
+    }
+}
