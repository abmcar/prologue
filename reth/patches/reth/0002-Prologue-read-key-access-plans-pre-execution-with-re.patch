+
+#[inline]
+fn diag_fill_miss(kind: usize, t0: u64) {
+    if DIAG_PATH.is_some() {
+        let d = diag_now_ns().saturating_sub(t0);
+        DIAG_FILL.with(|c| {
+            let mut v = c.get();
+            v[kind].0 += 1;
+            v[kind].1 += d;
+            c.set(v);
+        });
