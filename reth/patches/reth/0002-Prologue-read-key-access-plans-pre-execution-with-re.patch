+/// Index of a tag source in the per-source statistics.
+const fn src_index(src: u8) -> usize {
+    (src - reth_execution_cache::CC_SRC_EAP_TX) as usize
+}
+
+/// Number of issue sources in the per-source statistics (transaction arrival, outermost call start, inner call
+/// start, prewarm-worker call start, storage discovery, call records, non-blocking pass, EXP-235's recorded read
+/// lists, Prologue's index-key extrapolation). The index-key extrapolation's source is the last one
+/// (`CC_SRC_EAP_IX` = 10, after the recorded read lists' `CC_SRC_EAP_PL` = 9; the non-blocking pass's
+/// `CC_SRC_EAP_NB` = 8 since the eap-x141b/eap-x150 merge 79d27a3, which renumbered it from 7 when the call-record
+/// source took 7); every source must index inside the arrays, or a reader thread or the execution thread panics on
+/// the first key of that source (EXP-180 v1, 2026-10-26).
+const N_SRC: usize = 9;
+const _: () = assert!(src_index(reth_execution_cache::CC_SRC_EAP_IX) < N_SRC);
+const _: () = assert!(src_index(reth_execution_cache::CC_SRC_EAP_PL) < N_SRC);
+const _: () = assert!(src_index(reth_execution_cache::CC_SRC_EAP_NB) < N_SRC);
+const _: () = assert!(src_index(reth_execution_cache::CC_SRC_EAP_CT) < N_SRC);
+
+impl std::fmt::Debug for FrameJob {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("FrameJob").field("target", &self.target).finish_non_exhaustive()
+    }
+}
