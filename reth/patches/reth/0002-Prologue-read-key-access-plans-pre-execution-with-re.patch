+#[cfg(test)]
+mod nb_tests {
+    use super::{evm_test_utils::*, *};
+
+    const C: Address = address!("0x000000000000000000000000000000000000c0de");
+    const B: Address = address!("0x000000000000000000000000000000000000b0de");
+
+    /// The speculative pass's database over `db`, with an empty execution cache.
+    fn nb_db(db: MemDb, caches: &reth_execution_cache::ExecutionCache, tx: Sender<Item>) -> NbDb<MemDb> {
+        NbDb { inner: db, caches: Some(caches.clone()), tx, wait_ns: 0, prio: false, val: 0, ew: None }
+    }
+
+    /// The slots handed to the readers (storage address, key), in order.
+    fn handed(rx: &Receiver<Item>) -> Vec<(Address, U256)> {
+        rx.try_iter()
+            .flat_map(|it| match it {
+                Item::Keys(b) => {
+                    assert_eq!(b.3, reth_execution_cache::CC_SRC_EAP_NB);
+                    b.1.iter().map(|k| (b.0, *k)).collect::<Vec<_>>()
+                }
+                _ => panic!("pwnbprio=0 hands slots out as keys"),
+            })
+            .collect()
+    }
+
+    /// One pass: [`NbInspector::begin`], the transaction, its counters.
+    fn pass(evm: &mut evm2::Evm<'_, evm2::BaseEvmTypes>, nb: &mut NbInspector, nonce: u64, to: Address) -> evm2::TxResult<evm2::BaseEvmTypes> {
+        nb.begin();
+        run(evm, nonce, to, nb)
+    }
+
+    /// The value of slot 5 of C, returned as the output: `RETURN(SLOAD(5))`.
+    const RET_SLOT5: [u8; 10] = [op::PUSH1, 5, op::SLOAD, op::PUSH0, op::MSTORE, op::PUSH1, 32, op::PUSH0, op::RETURN, op::STOP];
+
+    /// An uncached slot is handed to the readers and answered with the placeholder (zero); the next level, run after
+    /// the readers filled the slot, sees the real value only when the EVM's read cache was emptied before it
+    /// (`take_state_cache`): otherwise the placeholder of the previous pass is read back.
+    #[test]
+    fn placeholders_do_not_survive_when_the_cache_is_taken() {
+        let mut db = MemDb::with_sender();
+        db.code(C, &RET_SLOT5);
+        db.storage.insert((C, U256::from(5u8)), U256::from(42u8));
+        let caches = reth_execution_cache::ExecutionCache::new(1 << 20);
+        let (tx, rx) = crossbeam_channel::unbounded();
+        let mut evm = evm(nb_db(db, &caches, tx));
+        let _mode = MODE_TEST_LOCK.lock();
+        assert!(!current().active);
+        let mut nb = NbInspector::new(false);
+        let r = pass(&mut evm, &mut nb, 0, C);
+        assert!(r.status);
+        assert_eq!(U256::from_be_slice(&r.output), U256::ZERO, "an uncached slot reads as the placeholder");
+        assert_eq!(handed(&rx), vec![(C, U256::from(5u8))]);
+        assert!(nb.unknown.contains(&(C, U256::from(5u8))));
+        // the readers fill the slot into the execution cache
+        caches.insert_storage(C, B256::from(U256::from(5u8)), Some(U256::from(42u8)));
+        // next level without emptying the read cache: the placeholder survives and the slot never reaches `NbDb`
+        let r = pass(&mut evm, &mut nb, 0, C);
+        assert_eq!(U256::from_be_slice(&r.output), U256::ZERO, "evm2's overlay keeps the placeholder");
+        assert!(handed(&rx).is_empty());
+        // emptied as the driver does before every pass (reth_evm `take_state_cache`): the reader-filled value
+        drop(std::mem::take(&mut evm.overlay_db_mut().cache));
+        let r = pass(&mut evm, &mut nb, 0, C);
+        assert_eq!(U256::from_be_slice(&r.output), U256::from(42u8));
+        assert!(handed(&rx).is_empty(), "a cached slot is not handed out again");
+        assert!(nb.unknown.is_empty());
+    }
+
+    /// A JUMPI on an unknown value whose fall-through arm reverts is turned to the other arm (2.5.1's static revert
+    /// rule), and the slot read there is handed to the readers.
+    #[test]
+    fn tainted_jumpi_avoids_the_reverting_arm() {
+        let mut db = MemDb::with_sender();
+        // 0: PUSH1 5 SLOAD PUSH1 9 JUMPI | 6: PUSH0 PUSH0 REVERT | 9: JUMPDEST PUSH1 6 SLOAD POP STOP
+        db.code(C, &[op::PUSH1, 5, op::SLOAD, op::PUSH1, 9, op::JUMPI, op::PUSH0, op::PUSH0, op::REVERT, op::JUMPDEST, op::PUSH1, 6, op::SLOAD, op::POP, op::STOP]);
+        let caches = reth_execution_cache::ExecutionCache::new(1 << 20);
+        let (tx, rx) = crossbeam_channel::unbounded();
+        let mut evm = evm(nb_db(db, &caches, tx));
+        let _mode = MODE_TEST_LOCK.lock();
+        assert!(!current().active);
+        let mut nb = NbInspector::new(false);
+        let r = pass(&mut evm, &mut nb, 0, C);
+        assert!(r.status, "the pass took the non-reverting arm");
+        assert_eq!(nb.forced, 1);
+        assert_eq!(handed(&rx), vec![(C, U256::from(5u8)), (C, U256::from(6u8))]);
+    }
+
+    /// A call to an unknown target is skipped and its success flag is unknown: evm2 runs the callee inside the CALL
+    /// instruction, so the caller's `step_end` comes after the callee's `call_end`; the flag's taint must still be on top
+    /// of the caller's taint stack after the operands are popped (a port that pushed in `call_end` and popped seven in
+    /// `step_end` would lose it, and the JUMPI below would not count as forced).
+    #[test]
+    fn skipped_call_leaves_an_unknown_success_flag() {
+        let mut db = MemDb::with_sender();
+        // 0: PUSH0 x5, PUSH1 5 SLOAD (target), GAS CALL | 10: ISZERO PUSH1 19 JUMPI | 14: PUSH1 7 SLOAD POP STOP
+        // 19: JUMPDEST PUSH0 PUSH0 REVERT
+        db.code(
+            C,
+            &[
+                op::PUSH0, op::PUSH0, op::PUSH0, op::PUSH0, op::PUSH0, op::PUSH1, 5, op::SLOAD, op::GAS, op::CALL, op::ISZERO,
+                op::PUSH1, 19, op::JUMPI, op::PUSH1, 7, op::SLOAD, op::POP, op::STOP, op::JUMPDEST, op::PUSH0, op::PUSH0,
+                op::REVERT,
+            ],
+        );
+        let caches = reth_execution_cache::ExecutionCache::new(1 << 20);
+        let (tx, rx) = crossbeam_channel::unbounded();
+        let mut evm = evm(nb_db(db, &caches, tx));
+        let _mode = MODE_TEST_LOCK.lock();
+        assert!(!current().active);
+        let mut nb = NbInspector::new(false);
+        let r = pass(&mut evm, &mut nb, 0, C);
+        assert!(r.status);
+        assert_eq!((nb.skipped, nb.forced), (1, 1));
+        assert_eq!(handed(&rx), vec![(C, U256::from(5u8)), (C, U256::from(7u8))]);
+    }
+
+    /// Per-frame bookkeeping across an entered call: the callee's unknown return data reaches the caller's memory at the
+    /// return range taken from the CALL operands (evm2's messages carry none), the call's own success flag stays known
+    /// (no forced branch on it), and a branch on the returned word is forced.
+    #[test]
+    fn callee_return_taint_reaches_the_callers_return_range() {
+        let mut db = MemDb::with_sender();
+        // B: RETURN(SLOAD(5))
+        db.code(B, &RET_SLOT5);
+        // C: CALL(gas, B, 0, 0, 0, 0, 32) | 29: PUSH1 35 JUMPI | 32: PUSH0 PUSH0 REVERT | 35: JUMPDEST PUSH0 MLOAD PUSH1 44
+        // JUMPI | 41: PUSH0 PUSH0 REVERT | 44: JUMPDEST STOP
+        let mut c = vec![op::PUSH1, 32, op::PUSH0, op::PUSH0, op::PUSH0, op::PUSH0];
+        push20(&mut c, B);
+        c.extend([op::GAS, op::CALL, op::PUSH1, 35, op::JUMPI, op::PUSH0, op::PUSH0, op::REVERT]);
+        assert_eq!(c.len(), 35);
+        c.extend([op::JUMPDEST, op::PUSH0, op::MLOAD, op::PUSH1, 44, op::JUMPI, op::PUSH0, op::PUSH0, op::REVERT, op::JUMPDEST, op::STOP]);
+        db.code(C, &c);
+        let caches = reth_execution_cache::ExecutionCache::new(1 << 20);
+        let (tx, rx) = crossbeam_channel::unbounded();
+        let mut evm = evm(nb_db(db, &caches, tx));
+        let _mode = MODE_TEST_LOCK.lock();
+        assert!(!current().active);
+        let mut nb = NbInspector::new(false);
+        let r = pass(&mut evm, &mut nb, 0, C);
+        assert!(r.status, "the branch on the returned (placeholder) word was turned away from REVERT");
+        assert_eq!((nb.skipped, nb.forced), (0, 1));
+        assert_eq!(handed(&rx), vec![(B, U256::from(5u8))]);
+        assert!(nb.frames.is_empty(), "every frame was popped at its end");
+    }
+}
