+/// EXP-199 (`ewprio`): the storage slots the target contract's access plan predicts for a transaction (its calldata, the
+/// block environment) that are not in the execution cache. `None` (no prediction) when the target account is not cached
+/// (its code hash is unknown without a read), when its code has no storage plan (no plan, an EIP-7702 delegation or a
+/// code without summary), or when its plan is not usable yet (`pwmin`, as for the call-start plans). Only the cache is
+/// consulted: nothing is read from the backend.
+pub fn predicted_uncached(
+    caches: &reth_execution_cache::ExecutionCache,
+    info: &BlockInfo,
+    caller: Address,
+    to: Address,
+    value: U256,
+    input: &[u8],
+    sc: &mut Scratch,
+) -> Option<u32> {
+    let acct = caches.peek_account(&to)?;
+    let h = acct.and_then(|a| a.bytecode_hash).filter(|h| *h != KECCAK256_EMPTY)?;
+    let plan = plans()?.get(&h).filter(|p| p.kind == 0)?;
+    if !compiled_peek(h, current().pwmin) {
+        return None
+    }
+    let env = info.env(caller, caller, to, value, input.len());
+    sc.instantiate(&plan, &Frame { calldata: input, env, sload: None });
+    let n = sc.out.iter().filter(|k| caches.peek_storage(to, B256::from(**k)).is_none()).count();
+    Some(n as u32)
+}
+
+/// EXP-199 (`ewprio`): a scratch for [`predicted_uncached`] on the dispatch thread.
+pub fn ew_scratch() -> Scratch {
+    new_scratch()
+}
