+#[cfg(test)]
+mod reader_scratch_tests {
+    use super::*;
+
+    #[test]
+    fn reader_scratch_reuses_capacity_and_resets_choices() {
+        READER_SCRATCH.with(|slot| *slot.borrow_mut() = None);
+        let stats = Arc::new(Stats::default());
+        let mut sc = Scratch::default();
+        sc.out = Vec::with_capacity(1024);
+        sc.out.push(U256::from(1));
+        sc.calls.push(frame_plan::CallOut { kind: 0, target: U256::ZERO, payload: Some(vec![1, 2]) });
+        sc.improved = false; sc.sat_classes = true; sc.no_cons = true;
+        retain_reader_scratch(sc, &stats);
+        let mode = Mode::parse("prewarm=1 rdpool=1 rdscratch=1 fpimp=1 satcls=0 nocons=0");
+        let reused = reader_scratch(mode, &stats);
+        assert!(reused.out.is_empty() && reused.calls.is_empty());
+        assert_eq!(reused.out.capacity(), 1024);
+        assert!(reused.interval && reused.improved && !reused.sat_classes && !reused.no_cons);
+        assert_eq!(stats.scratch_reused.load(Ordering::Relaxed), 1);
+        assert_eq!(stats.scratch_retained.load(Ordering::Relaxed), 1);
+        assert!(stats.scratch_bytes.load(Ordering::Relaxed) >= 32768);
+        READER_SCRATCH.with(|slot| assert!(slot.borrow().is_none()));
+    }
+
+    #[test]
+    fn reader_scratch_disabled_or_unpooled_drops_cached_capacity() {
+        for line in ["rdpool=1", "rdscratch=1", "rdpool=1 rdscratch=1 rdnice=1"] {
+            READER_SCRATCH.with(|slot| *slot.borrow_mut() = None);
+            let stats = Arc::new(Stats::default());
+            let mut sc = Scratch::default();sc.out.reserve(64);
+            retain_reader_scratch(sc, &stats);
+            let fresh = reader_scratch(Mode::parse(line), &stats);
+            assert_eq!(fresh.out.capacity(), 0);
+            assert_eq!(stats.scratch_reused.load(Ordering::Relaxed), 0);
+            READER_SCRATCH.with(|slot| assert!(slot.borrow().is_none()));
+        }
+        assert!(!Mode::OFF.rdscratch);
+        assert!(!Mode::parse("rdscratch=1 rdscratch=0").rdscratch);
+    }
+
+    #[test]
+    fn reader_scratch_rejects_capacity_above_limit() {
+        READER_SCRATCH.with(|slot| *slot.borrow_mut() = None);
+        let stats = Arc::new(Stats::default());
+        let mut sc = Scratch::default();
+        sc.out.reserve_exact(READER_SCRATCH_LIMIT / std::mem::size_of::<U256>() + 1);
+        retain_reader_scratch(sc, &stats);
+        assert_eq!(stats.scratch_discarded.load(Ordering::Relaxed), 1);
+        assert_eq!(stats.scratch_retained.load(Ordering::Relaxed), 0);
+        READER_SCRATCH.with(|slot| assert!(slot.borrow().is_none()));
+    }
+}
diff --git a/crates/engine/tree/src/tree/eap/exec_cs.rs b/crates/engine/tree/src/tree/eap/exec_cs.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b67b5b88a06819a0a6b17b5135f120ac18ca8e94
--- /dev/null
+++ b/crates/engine/tree/src/tree/eap/exec_cs.rs
@@ -0,0 +1,79 @@
+//! EXP-236 (`cs=1`): access plans instantiated on the block executor at each call start (the placement of dowse's
+//! `PrefetchInspector`), with the readers as before.
+//!
+//! The execution thread's EVM carries [`EapExecInspector`] for the block. At each call message it looks up the callee's
+//! plan without waiting for the plan table's lock ([`PlanStore::try_get`](crate::tree::plan_store::PlanStore::try_get))
+//! and hands the plan and the call's arguments to the readers as a frame job; a reader instantiates the plan and reads
+//! the slots (`Reader::frame`, sources `CC_SRC_EAP_CS0` for a transaction's outermost call, `CC_SRC_EAP_CS1` for inner
+//! calls). Compiled frames keep running as compiled code ([`Inspector::allows_compiled_frames`]) and interpreted frames
+//! run in the plain interpreter ([`Inspector::instruction_hooks`]), so the hook is the only cost on the execution thread.
+//! 2.5.1 counterpart: `EapInspector` (eap-x199c eap.rs 5733-5880) and `BlockPrefetch::inspector`.
+
+use super::{msg_depth, plans, BlockPrefetch, FrameJob, Item, Stats};
+use crossbeam_channel::Sender;
+use evm2::{
+    interpreter::{Interpreter, Message, MessageResult},
+    EvmTypes, Inspector,
+};
+use std::{
+    sync::{atomic::Ordering, Arc},
+    time::Instant,
+};
+
+/// Inspector of the block executor that queues call-start plan instantiations to the readers (`cs=1`).
+#[derive(Debug)]
+pub struct EapExecInspector {
+    pub(super) tx: Sender<Item>,
+    pub(super) stats: Arc<Stats>,
+}
+
+impl BlockPrefetch {
+    /// The block executor's inspector for this block: `Some` only with `cs=1` and running readers.
+    pub fn exec_inspector(&self) -> Option<EapExecInspector> {
+        let tx = self.cs_tx.clone().filter(|_| self.mode.cs)?;
+        Some(EapExecInspector { tx, stats: self.stats.clone() })
+    }
+}
+
+impl<T: EvmTypes> Inspector<T> for EapExecInspector {
+    fn allows_compiled_frames(&self) -> bool {
+        true
+    }
+
+    fn instruction_hooks(&self) -> bool {
+        false
+    }
+
+    fn call(&mut self, interp: &mut Interpreter<'_, '_, T>, message: &mut Message<T>) -> Option<MessageResult<T>> {
+        let t0 = Instant::now();
+        let depth = msg_depth(interp, message);
+        let s = &self.stats;
+        s.frames.fetch_add(1, Ordering::Relaxed);
+        if depth == 0 {
+            s.frames_d0.fetch_add(1, Ordering::Relaxed);
+        }
+        let h = message.code.hash_slow();
+        if let Some(plan) = plans().and_then(|p| p.try_get(&h)) {
+            s.frames_plan.fetch_add(1, Ordering::Relaxed);
+            if depth == 0 {
+                s.frames_plan_d0.fetch_add(1, Ordering::Relaxed);
+            } else {
+                s.frames_plan_d1.fetch_add(1, Ordering::Relaxed);
+            }
+            let _ = self.tx.send(Item::Frame(Box::new(FrameJob {
+                plan,
+                input: message.input.clone(),
+                caller: message.caller,
+                origin: interp.tx_env().origin,
+                target: message.destination,
+                value: message.value,
+                depth,
+                pw: false,
+                nb: false,
+                tx: u32::MAX,
+            })));
+        }
+        s.cs_ns.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        None
+    }
+}
diff --git a/crates/engine/tree/src/tree/eap/ix.rs b/crates/engine/tree/src/tree/eap/ix.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6bc313f942cff23f1364a8f6594281e482d6443a
--- /dev/null
+++ b/crates/engine/tree/src/tree/eap/ix.rs
@@ -0,0 +1,1053 @@
+//! Prologue (`ixpf`): index-key loop extrapolation on the prewarm workers.
+//!
+//! In EXP-251's two slowest blocks (EXP-247 README 8.59) one HEX transaction ends a stake of about 2,000 days and reads
+//! the `dailyData` mapping (slot 6) day after day, one cold storage read after another. The prewarm worker runs the
+//! same transaction at nearly the same time as the execution thread and cannot get ahead of such a chain, and the
+//! access plans do not express the loop.
+//!
+//! With the switch, a prewarm worker keeps its last [`RING`] 64-byte KECCAK256 inputs whose first word (the index i) is
+//! below 2^64, from the prewarm inspector's `step` in interpreted frames and from revmc's callback
+//! ([`super::pw_keccak_hook`]) in compiled ones. At each of its storage reads (the execution cache's per-thread hook,
+//! [`reth_execution_cache::set_slot_read_hook`]) it looks for an input whose hash h lies at most 7 below the key (a
+//! struct field at offset j = key - h). The matches of one storage address and second word c form a pattern; once the
+//! index has moved by the same step d (1 <= |d| <= 16) [`CONFIRM`] times after the step that set d, the keys
+//! keccak256(i . c) + j of the next indices go to the readers' slot channel, which they serve first, as items of
+//! source [`CC_SRC_EAP_IX`]: [`RAMP0`] indices ahead of the last one read, twice as many at each further confirmation,
+//! at most the switch's value. The reads are only hints: a reader loads the base-state value into the execution cache,
+//! as for its other items.
+//!
+//! Everything the two hooks reach is panic-free (no `unwrap`, no indexing, `try_with` and `try_borrow_mut`): the
+//! KECCAK256 callback runs inside compiled code, where a panic cannot unwind and aborts the process.
+
+use super::{rq_now, Item, Mode, NB_SL_TX, PW_CUR_TX};
+use alloy_primitives::{keccak256, Address, B256, U256};
+use crossbeam_channel::Sender;
+use parking_lot::Mutex;
+use reth_execution_cache::CC_SRC_EAP_IX;
+use std::{
+    cell::RefCell,
+    collections::VecDeque,
+    sync::{
+        atomic::{AtomicI64, AtomicU64, Ordering},
+        Arc,
+    },
+};
+use tracing::info;
+
+/// KECCAK256 inputs a worker keeps.
+const RING: usize = 4;
+/// Patterns a worker follows at once (a new one replaces the least recently used).
+const PATS: usize = 4;
+/// Struct field offsets a pattern keeps.
+const OFFS: u32 = 4;
+/// A key belongs to an input when it lies less than this many slots above the input's hash (offsets 0 to 7).
+const MAX_OFF: u8 = 8;
+/// Largest step |d| between consecutive indices of a pattern.
+const MAX_STEP: u64 = 16;
+/// Steps of d confirmed after the one that set it before keys are issued.
+const CONFIRM: u32 = 4;
+/// Indices issued ahead of the last one read at the [`CONFIRM`]-th confirmation; twice as many at each further one.
+const RAMP0: u32 = 16;
+/// Keys a worker issues per transaction at most.
+const TX_CAP: u32 = 4096;
+/// Keys the workers issue per block at most.
+const BLOCK_CAP: u64 = 8192;
+/// `eap ixpat` lines per block at most.
+const LINES: usize = 16;
+
+thread_local! {
+    /// The calling prewarm worker's state for its block (`None`: the switch is off on this thread).
+    static IX: RefCell<Option<IxState>> = const { RefCell::new(None) };
+}
+
+/// The current block's counts and pattern records, shared by its workers and readers.
+static IX_BLOCK: IxBlock = IxBlock::new();
+
+/// Sets the calling prewarm worker's state for the block of mode `m` and installs its storage-read hook; the guard
+/// clears both when dropped, at the block's end with the block's prewarm EVM state, on this thread. `None`, with this
+/// thread's hook and state cleared, when the switch is off or the block has no readers.
+pub fn ix_worker_begin(m: &Mode) -> Option<IxGuard> {
+    if !(m.active && m.ixpf > 0 && m.prefetch()) {
+        clear();
+        return None
+    }
+    // the readers of a block start after its prewarm, so the first workers may find no channel yet (taken later)
+    let sl = NB_SL_TX.lock().clone();
+    Some(begin(IxState::new(m.ixpf, &IX_BLOCK, sl, true).guarded(m.ixpfw)))
+}
+
+/// Clears the calling thread's index-key extrapolation (state and storage-read hook) when dropped; made by
+/// [`ix_worker_begin`] and dropped on the same thread.
+#[derive(Debug)]
+pub struct IxGuard(());
+
+impl Drop for IxGuard {
+    fn drop(&mut self) {
+        clear();
+    }
+}
+
+/// Sets `s` as the calling thread's state and installs the storage-read hook.
+fn begin(s: IxState) -> IxGuard {
+    let _ = IX.try_with(|x| {
+        if let Ok(mut x) = x.try_borrow_mut() {
+            *x = Some(s);
+        }
+    });
+    reth_execution_cache::set_slot_read_hook(Some(slot_hook));
+    IxGuard(())
+}
+
+/// Clears the calling thread's state and storage-read hook.
+fn clear() {
+    reth_execution_cache::set_slot_read_hook(None);
+    let _ = IX.try_with(|x| {
+        if let Ok(mut x) = x.try_borrow_mut() {
+            *x = None;
+        }
+    });
+}
+
+/// Runs `f` on the calling thread's state, if it has one and it is not borrowed.
+fn with_state(f: impl FnOnce(&mut IxState)) {
+    let _ = IX.try_with(|x| {
+        if let Ok(mut x) = x.try_borrow_mut() &&
+            let Some(s) = x.as_mut()
+        {
+            f(s);
+        }
+    });
+}
+
+/// A transaction starts on the calling worker: its patterns, inputs and key count start empty.
+pub(super) fn tx_begin() {
+    with_state(IxState::tx_begin);
+}
+
+/// A KECCAK256 input of the calling worker (any length; only 64-byte inputs with an index-like first word are kept).
+pub(super) fn keccak_input(m: &[u8]) {
+    if m.len() == 64 {
+        with_state(|s| s.input(m));
+    }
+}
+
+/// The storage-read hook of a worker with the switch on ([`reth_execution_cache::set_slot_read_hook`]).
+fn slot_hook(a: Address, key: B256) {
+    let fills = reth_execution_cache::cc_thread_storage_fills();
+    with_state(|s| s.slot_with(a, U256::from_be_bytes(key.0), fills));
+}
+
+/// A block starts: the previous block's workers stop issuing, the counts, key budget and records start empty.
+pub(super) fn block_start() {
+    IX_BLOCK.reset();
+}
+
+/// A reader found an extrapolated key in the execution cache, or already read or being read, and did not read it.
+pub(super) fn note_cached() {
+    IX_BLOCK.cached.fetch_add(1, Ordering::Relaxed);
+}
+
+/// A reader read an extrapolated key in `ns` nanoseconds; `filled`: from the backend (else it was in the cache).
+pub(super) fn note_read(filled: bool, ns: u64) {
+    IX_BLOCK.note_read(filled, ns);
+}
+
+/// The current block's counts for its `eap block` line.
+pub(super) fn counts() -> IxCounts {
+    IX_BLOCK.counts()
+}
+
+/// One `eap ixpat` line per pattern record of the current block (taken).
+pub(super) fn log_patterns(block: u64) {
+    IX_BLOCK.log_patterns(block);
+}
+
+/// A block's counts of the index-key extrapolation (`eap block` line).
+#[derive(Debug)]
+pub(super) struct IxCounts {
+    /// Hashes the workers' storage-read hooks computed.
+    pub(super) hash: u64,
+    /// Patterns that reached the confirmations.
+    pub(super) pat: u64,
+    /// Keys handed to the readers.
+    pub(super) keys: u64,
+    /// Keys not issued because of the transaction or block cap.
+    pub(super) capped: u64,
+    /// Keys the readers read from the backend, and the time of those reads.
+    pub(super) reads: u64,
+    pub(super) read_us: u64,
+    /// From the block's first hand-off to the end of its last backend read.
+    pub(super) span_us: u64,
+    /// Keys the readers found in the execution cache, or already read or being read, and did not read.
+    pub(super) cached: u64,
+    /// Prologue (`ixpfw`): patterns that reached the streak without a backend read among their reads (not issued)
+    pub(super) wskip: u64,
+}
+
+/// One block's counts, key budget and pattern records, shared by the block's workers and readers.
+struct IxBlock {
+    /// Advanced when a block starts; a worker's state set for an earlier block does nothing.
+    epoch: AtomicU64,
+    hash: AtomicU64,
+    pat: AtomicU64,
+    keys: AtomicU64,
+    capped: AtomicU64,
+    /// Keys counted against [`BLOCK_CAP`].
+    budget: AtomicU64,
+    reads: AtomicU64,
+    read_ns: AtomicU64,
+    cached: AtomicU64,
+    wskip: AtomicU64,
+    /// [`rq_now`] at the block's first hand-off and at the end of its last backend read (0: none).
+    first_ns: AtomicU64,
+    last_ns: AtomicU64,
+    /// Records of the patterns that reached the confirmations, at most [`LINES`].
+    recs: Mutex<Vec<Arc<PatRec>>>,
+}
+
+impl IxBlock {
+    const fn new() -> Self {
+        Self {
+            epoch: AtomicU64::new(0),
+            hash: AtomicU64::new(0),
+            pat: AtomicU64::new(0),
+            keys: AtomicU64::new(0),
+            capped: AtomicU64::new(0),
+            budget: AtomicU64::new(0),
+            reads: AtomicU64::new(0),
+            read_ns: AtomicU64::new(0),
+            cached: AtomicU64::new(0),
+            wskip: AtomicU64::new(0),
+            first_ns: AtomicU64::new(0),
+            last_ns: AtomicU64::new(0),
+            recs: parking_lot::const_mutex(Vec::new()),
+        }
+    }
+
+    fn reset(&self) {
+        self.epoch.fetch_add(1, Ordering::AcqRel);
+        for c in [
+            &self.hash,
+            &self.pat,
+            &self.keys,
+            &self.capped,
+            &self.budget,
+            &self.reads,
+            &self.read_ns,
+            &self.cached,
+            &self.wskip,
+            &self.first_ns,
+            &self.last_ns,
+        ] {
+            c.store(0, Ordering::Relaxed);
+        }
+        self.recs.lock().clear();
+    }
+
+    fn note_read(&self, filled: bool, ns: u64) {
+        if filled {
+            self.reads.fetch_add(1, Ordering::Relaxed);
+            self.read_ns.fetch_add(ns, Ordering::Relaxed);
+            self.last_ns.fetch_max(rq_now(), Ordering::Relaxed);
+        } else {
+            self.cached.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+
+    fn counts(&self) -> IxCounts {
+        let g = |a: &AtomicU64| a.load(Ordering::Relaxed);
+        let (first, last) = (g(&self.first_ns), g(&self.last_ns));
+        IxCounts {
+            hash: g(&self.hash),
+            pat: g(&self.pat),
+            keys: g(&self.keys),
+            capped: g(&self.capped),
+            reads: g(&self.reads),
+            read_us: g(&self.read_ns) / 1000,
+            span_us: if first > 0 { last.saturating_sub(first) / 1000 } else { 0 },
+            cached: g(&self.cached),
+            wskip: g(&self.wskip),
+        }
+    }
+
+    /// `eap ixpat` lines: the transaction, storage address `addr`, second word `c`, the run's first index `i0` and the
+    /// last one read `i1`, step `d`, keys issued, the first index issued (`i_first`, -1: none) and when
+    /// (`t_first_us`: microseconds since the block's diagnostics base, the time base of its `EAP_DIAG` records; -1:
+    /// none, or diagnostics off).
+    fn log_patterns(&self, block: u64) {
+        let recs = std::mem::take(&mut *self.recs.lock());
+        for r in recs {
+            let first = r.first.load(Ordering::Relaxed);
+            let i_first = if first == u64::MAX { None } else { step(r.i0, r.d, first) };
+            if crate::tree::eap::logq() {
+                continue
+            }
+            info!(
+                target: "reth::eap",
+                block,
+                tx = r.tx,
+                addr = %r.a,
+                c = %r.c,
+                i0 = %r.i0,
+                i1 = %step(r.i0, r.d, r.pos.load(Ordering::Relaxed)).unwrap_or_default(),
+                d = r.d,
+                keys = r.keys.load(Ordering::Relaxed),
+                i_first = %i_first.map_or_else(|| "-1".to_string(), |i| i.to_string()),
+                t_first_us = r.t_first_us.load(Ordering::Relaxed),
+                "eap ixpat"
+            );
+        }
+    }
+}
+
+/// A pattern's run for its `eap ixpat` line: fixed when the run reaches the confirmations (transaction, storage
+/// address, second word, first index, step), then updated by its worker: indices read after the first one (`pos`), keys
+/// issued, the first index issued (as indices after the first one; `u64::MAX`: none yet) and when.
+struct PatRec {
+    tx: u32,
+    a: Address,
+    c: U256,
+    i0: U256,
+    d: i64,
+    pos: AtomicU64,
+    keys: AtomicU64,
+    first: AtomicU64,
+    t_first_us: AtomicI64,
+}
+
+/// A kept 64-byte KECCAK256 input (i . c) and its hash once a storage read has looked for it.
+#[derive(Clone, Copy)]
+struct Input {
+    i: U256,
+    c: U256,
+    h: Option<U256>,
+}
+
+/// A worker's pattern: storage reads of `a` at keccak256(i . c) + j.
+struct Pat {
+    a: Address,
+    c: U256,
+    /// The run's first index and the last one read.
+    i0: U256,
+    last: U256,
+    /// Indices read after the run's first one.
+    pos: u64,
+    /// The step, set by the run's second index (0 before).
+    d: i64,
+    /// Steps of `d` confirmed after the one that set it.
+    streak: u32,
+    /// Prologue (`ixpfw`): the run's reads that went to the backend on this thread (seen at the thread's next read).
+    cold: u32,
+    /// Offsets j read at the run's indices, one bit each (at most [`OFFS`]).
+    offs: u8,
+    /// Indices after `last` whose keys were issued or counted as capped.
+    lead: u32,
+    /// The run's record, from its confirmations on (none beyond the block's [`LINES`]).
+    rec: Option<Arc<PatRec>>,
+    /// The worker's match count at the pattern's last match (the least recently used is replaced).
+    used: u64,
+}
+
+impl Pat {
+    const fn new(a: Address, c: U256, i: U256, j: u8, used: u64) -> Self {
+        Self { a, c, i0: i, last: i, pos: 0, d: 0, streak: 0, cold: 0, offs: bit(j), lead: 0, rec: None, used }
+    }
+
+    /// Starts a new run at index `i`, offset `j` (the old run's record keeps its values).
+    fn restart(&mut self, i: U256, j: u8) {
+        *self = Self::new(self.a, self.c, i, j, self.used);
+    }
+
+    const fn add_off(&mut self, j: u8) {
+        if self.offs.count_ones() < OFFS {
+            self.offs |= bit(j);
+        }
+    }
+}
+
+/// A prewarm worker's state for one block.
+struct IxState {
+    /// The switch: indices issued ahead of the last one read at most.
+    n: u32,
+    blk: &'static IxBlock,
+    /// `blk.epoch` when the state was set.
+    epoch: u64,
+    /// The readers' slot channel; with `lazy`, taken from `NB_SL_TX` while missing.
+    sl: Option<Sender<Item>>,
+    lazy: bool,
+    /// Kept inputs, the newest last.
+    ring: VecDeque<Input>,
+    pats: Vec<Pat>,
+    /// Storage reads matched to an input so far.
+    tick: u64,
+    /// Keys issued in the current transaction.
+    tx_keys: u32,
+    /// Prologue (`ixpfw`): the waste guard. A pattern issues only after one of its reads went to the backend, and at
+    /// most as many indices ahead as it has followed.
+    guard: bool,
+    /// The thread's backend storage fills at the previous read, and that read's pattern (to count its reads that went to
+    /// the backend).
+    fills: u64,
+    prev: Option<(Address, U256)>,
+}
+
+impl IxState {
+    fn new(n: u32, blk: &'static IxBlock, sl: Option<Sender<Item>>, lazy: bool) -> Self {
+        Self {
+            n,
+            blk,
+            epoch: blk.epoch.load(Ordering::Acquire),
+            sl,
+            lazy,
+            ring: VecDeque::with_capacity(RING),
+            pats: Vec::with_capacity(PATS),
+            tick: 0,
+            tx_keys: 0,
+            guard: false,
+            fills: 0,
+            prev: None,
+        }
+    }
+
+    /// Prologue (`ixpfw=1`): turns the waste guard on.
+    const fn guarded(mut self, on: bool) -> Self {
+        self.guard = on;
+        self
+    }
+
+    fn tx_begin(&mut self) {
+        self.ring.clear();
+        self.pats.clear();
+        self.tx_keys = 0;
+    }
+
+    /// Keeps a 64-byte input whose first word is below 2^64 (an index; an address-keyed mapping's key is not).
+    fn input(&mut self, m: &[u8]) {
+        if m.len() != 64 {
+            return
+        }
+        let (Some((iw, _)), Some((_, cw))) = (m.split_first_chunk::<32>(), m.split_last_chunk::<32>()) else { return };
+        let i = U256::from_be_bytes(*iw);
+        if i > U256::from(u64::MAX) {
+            return
+        }
+        let c = U256::from_be_bytes(*cw);
+        // the same input again (an element's key hashed twice) keeps its hash and becomes the newest
+        let e = match self.ring.iter().position(|e| e.i == i && e.c == c) {
+            Some(p) => self.ring.remove(p),
+            None => None,
+        };
+        if e.is_none() && self.ring.len() >= RING {
+            self.ring.pop_front();
+        }
+        self.ring.push_back(e.unwrap_or(Input { i, c, h: None }));
+    }
+
+    /// A storage read of `a` at `key`: matched to the newest kept input whose hash lies less than [`MAX_OFF`] below it
+    /// (hashes computed once, as needed), then followed as a pattern. The hook passes the thread's fills
+    /// ([`Self::slot_with`]); this form, without them, is the tests'.
+    #[cfg(test)]
+    fn slot(&mut self, a: Address, key: U256) {
+        self.slot_with(a, key, self.fills);
+    }
+
+    /// [`Self::slot`] with the thread's backend storage fills so far (`fills`): when they grew since the previous read,
+    /// that read went to the backend, and it counts for the pattern it was matched to (Prologue `ixpfw`).
+    fn slot_with(&mut self, a: Address, key: U256, fills: u64) {
+        if fills > self.fills &&
+            let Some((pa, pc)) = self.prev &&
+            let Some(pat) = self.pats.iter_mut().find(|p| p.a == pa && p.c == pc)
+        {
+            pat.cold = pat.cold.saturating_add(1);
+        }
+        self.fills = fills;
+        self.prev = None;
+        if self.blk.epoch.load(Ordering::Relaxed) != self.epoch {
+            return
+        }
+        let blk = self.blk;
+        let hit = self.ring.iter_mut().rev().find_map(|e| {
+            let h = match e.h {
+                Some(h) => h,
+                None => {
+                    blk.hash.fetch_add(1, Ordering::Relaxed);
+                    let h = slot_of(e.i, e.c);
+                    e.h = Some(h);
+                    h
+                }
+            };
+            let j = key.checked_sub(h).filter(|j| *j < U256::from(MAX_OFF))?;
+            Some((e.i, e.c, j.saturating_to::<u8>()))
+        });
+        if let Some((i, c, j)) = hit {
+            self.prev = Some((a, c));
+            self.observe(a, c, i, j);
+        }
+    }
+
+    /// Element `i` (offset `j`) of the mapping at `c` of `a` was read: the same element adds its offset; the run's
+    /// second index sets d (1 <= |d| <= [`MAX_STEP`]); the next index by d confirms it; anything else starts a new run.
+    /// From [`CONFIRM`] confirmations on, each confirmation issues keys ahead ([`Self::issue`]).
+    fn observe(&mut self, a: Address, c: U256, i: U256, j: u8) {
+        self.tick = self.tick.wrapping_add(1);
+        let (tick, blk) = (self.tick, self.blk);
+        let Some(p) = self.pats.iter().position(|p| p.a == a && p.c == c) else {
+            let new = Pat::new(a, c, i, j, tick);
+            if self.pats.len() < PATS {
+                self.pats.push(new);
+            } else if let Some(old) = self.pats.iter_mut().min_by_key(|p| p.used) {
+                *old = new;
+            }
+            return
+        };
+        let Some(pat) = self.pats.get_mut(p) else { return };
+        pat.used = tick;
+        if i == pat.last {
+            pat.add_off(j);
+            return
+        }
+        let next = if pat.d == 0 {
+            step_between(pat.last, i)
+        } else {
+            (step(pat.last, pat.d, 1) == Some(i)).then_some(pat.d)
+        };
+        let Some(d) = next else {
+            pat.restart(i, j);
+            return
+        };
+        if pat.d == 0 {
+            pat.d = d;
+        } else {
+            pat.streak = pat.streak.saturating_add(1);
+        }
+        pat.last = i;
+        pat.pos = pat.pos.saturating_add(1);
+        pat.lead = pat.lead.saturating_sub(1);
+        pat.add_off(j);
+        if pat.streak == CONFIRM {
+            reached(blk, pat);
+        }
+        if let Some(r) = &pat.rec {
+            r.pos.store(pat.pos, Ordering::Relaxed);
+        }
+        if self.guard && pat.cold == 0 {
+            if pat.streak == CONFIRM {
+                blk.wskip.fetch_add(1, Ordering::Relaxed);
+            }
+            return
+        }
+        if pat.streak >= CONFIRM {
+            self.issue(p);
+        }
+    }
+
+    /// Issues the keys of pattern `p` for the indices not issued yet up to the distance its confirmations allow
+    /// ([`RAMP0`] doubled per confirmation after the [`CONFIRM`]-th, at most `n`): keccak256(i . c) + j for each of its
+    /// offsets, in index order, while the transaction's and the block's caps allow (the rest is counted); stops at the
+    /// end of the index range. Without the readers' channel nothing is issued (a later read issues it).
+    fn issue(&mut self, p: usize) {
+        if self.sl.is_none() && self.lazy {
+            self.sl = NB_SL_TX.lock().clone();
+        }
+        let blk = self.blk;
+        let (Some(sl), Some(pat)) = (self.sl.as_ref(), self.pats.get_mut(p)) else { return };
+        let mut ahead = (RAMP0 << pat.streak.saturating_sub(CONFIRM).min(6)).min(self.n);
+        // Prologue (`ixpfw`): no further ahead than the run has gone, so a short loop wastes at most its own length
+        if self.guard {
+            ahead = ahead.min(u32::try_from(pat.pos).unwrap_or(u32::MAX));
+        }
+        let (tx, a, c, offs) = (cur_tx(), pat.a, pat.c, pat.offs);
+        let (mut sent, mut first) = (0u64, None);
+        for k in pat.lead.saturating_add(1)..=ahead {
+            let Some(i) = step(pat.last, pat.d, u64::from(k)) else { break };
+            pat.lead = k;
+            // caps reached: the index's keys are counted without being hashed
+            if self.tx_keys >= TX_CAP || blk.budget.load(Ordering::Relaxed) >= BLOCK_CAP {
+                blk.capped.fetch_add(u64::from(offs.count_ones()), Ordering::Relaxed);
+                continue
+            }
+            let h = slot_of(i, c);
+            for j in (0..MAX_OFF).filter(|j| offs & bit(*j) != 0) {
+                let Some(key) = h.checked_add(U256::from(j)) else { continue };
+                if self.tx_keys >= TX_CAP ||
+                    blk.budget
+                        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |v| (v < BLOCK_CAP).then_some(v + 1))
+                        .is_err()
+                {
+                    blk.capped.fetch_add(1, Ordering::Relaxed);
+                    continue
+                }
+                self.tx_keys = self.tx_keys.saturating_add(1);
+                let now = rq_now();
+                if sl.send(Item::Slot(a, B256::from(key), CC_SRC_EAP_IX, tx, now)).is_ok() {
+                    sent += 1;
+                    if first.is_none() {
+                        first = Some((k, now));
+                    }
+                }
+            }
+        }
+        let Some((k, now)) = first else { return };
+        blk.keys.fetch_add(sent, Ordering::Relaxed);
+        let _ = blk.first_ns.compare_exchange(0, now.max(1), Ordering::Relaxed, Ordering::Relaxed);
+        if let Some(r) = &pat.rec {
+            r.keys.fetch_add(sent, Ordering::Relaxed);
+            if r.first.load(Ordering::Relaxed) == u64::MAX {
+                r.first.store(pat.pos.saturating_add(u64::from(k)), Ordering::Relaxed);
+                r.t_first_us.store(diag_us(), Ordering::Relaxed);
+            }
+        }
+    }
+}
+
+/// A pattern reached the confirmations: counted, and recorded for an `eap ixpat` line while the block has fewer than
+/// [`LINES`].
+fn reached(blk: &IxBlock, pat: &mut Pat) {
+    blk.pat.fetch_add(1, Ordering::Relaxed);
+    let mut recs = blk.recs.lock();
+    if recs.len() < LINES {
+        let r = Arc::new(PatRec {
+            tx: cur_tx(),
+            a: pat.a,
+            c: pat.c,
+            i0: pat.i0,
+            d: pat.d,
+            pos: AtomicU64::new(pat.pos),
+            keys: AtomicU64::new(0),
+            first: AtomicU64::new(u64::MAX),
+            t_first_us: AtomicI64::new(-1),
+        });
+        recs.push(r.clone());
+        pat.rec = Some(r);
+    }
+}
+
+/// The block index of the transaction the calling worker runs (`u32::MAX`: none).
+fn cur_tx() -> u32 {
+    PW_CUR_TX.try_with(|c| c.get()).unwrap_or(u32::MAX)
+}
+
+/// Now in microseconds since the block's diagnostics base (the time base of its `EAP_DIAG` records); -1 without
+/// diagnostics.
+fn diag_us() -> i64 {
+    reth_execution_cache::cc_diag_block()
+        .map_or(-1, |d| (reth_execution_cache::diag_now_ns() as i64 - d.t0() as i64) / 1000)
+}
+
+/// The bit of offset `j` (none past [`MAX_OFF`]).
+const fn bit(j: u8) -> u8 {
+    if j < MAX_OFF { 1 << j } else { 0 }
+}
+
+/// The slot keccak256(i . c): element i of the mapping at slot c.
+fn slot_of(i: U256, c: U256) -> U256 {
+    U256::from_be_bytes(keccak256(B256::from(i).concat_const::<32, 64>(B256::from(c))).0)
+}
+
+/// `base + d * k`; `None` past either end of the index range (no wrapping).
+fn step(base: U256, d: i64, k: u64) -> Option<U256> {
+    let m = U256::from(d.unsigned_abs()).checked_mul(U256::from(k))?;
+    if d >= 0 { base.checked_add(m) } else { base.checked_sub(m) }
+}
+
+/// The step d from index `from` to index `to` when 1 <= |d| <= [`MAX_STEP`].
+fn step_between(from: U256, to: U256) -> Option<i64> {
+    let (diff, up) = match to.checked_sub(from) {
+        Some(x) => (x, true),
+        None => (from.checked_sub(to)?, false),
+    };
+    let d = u64::try_from(diff).ok().filter(|d| (1..=MAX_STEP).contains(d))? as i64;
+    Some(if up { d } else { -d })
+}
