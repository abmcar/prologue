+        for h in t {
+            h.join();
+        }
+        assert!(g.open_us.load(Ordering::Relaxed) > 0);
+
+        let stop2 = Arc::new(AtomicBool::new(false));
+        let g2 = LxGate::new(stop2.clone());
+        let c2 = calls.clone();
+        *g2.spawner.lock() = Some(Box::new(move || {
+            c2.fetch_add(1, Ordering::Relaxed);
+            vec![super::ReaderHandle::Thread(std::thread::spawn(|| {}))]
+        }));
+        stop2.store(true, Ordering::Relaxed);
+        g2.open();
+        assert_eq!(calls.load(Ordering::Relaxed), 1);
+        assert!(g2.take_spawned().is_empty());
+    }
+}
