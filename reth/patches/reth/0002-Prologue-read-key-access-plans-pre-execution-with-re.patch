+/// X-027: empties the values evm2's EVM read in earlier transactions, so that every read of the next transaction reaches
+/// the provider (for a prewarm worker: [`EwOverlay`] answers from the writes of the transactions before the next one).
+/// The provider keeps the shared execution cache. As reth 2.9.0's own prewarm does before each reusable run.
+pub fn fresh_reads<E: reth_evm::Evm + ?Sized>(evm: &mut E) {
+    drop(evm.take_state_cache());
+}
+
+
+/// Core reservation (`ewcore=1`): the execution thread's CPU set at the current block's start, and the set the mechanism's
+/// threads use while a reservation is in force for the block (`None`: no reservation).
+///
+/// The execution thread itself is not pinned: a thread inherits its creator's CPU set, and the execution thread creates
+/// threads of reth's runtime during the block, which would then stay on one core. Keeping the mechanism's threads off
+/// one core leaves that core to the execution thread and reth's other threads; the scheduler places the waking execution
+/// thread on an idle core of its set. With `exphys` it is pinned to the reserved core, from its execution start to its
+/// end only ([`exphys_exec_start`]), and the mechanism's set also leaves that core's SMT siblings.
+static CORES: Mutex<(Option<libc::cpu_set_t>, Option<libc::cpu_set_t>)> = parking_lot::const_mutex((None, None));
+
+fn own_affinity() -> Option<libc::cpu_set_t> {
+    // SAFETY: a zeroed cpu_set_t is valid; sched_getaffinity with pid 0 reads the calling thread's mask.
+    unsafe {
+        let mut s: libc::cpu_set_t = std::mem::zeroed();
+        (libc::sched_getaffinity(0, std::mem::size_of::<libc::cpu_set_t>(), &mut s) == 0).then_some(s)
+    }
+}
+
+fn set_own_affinity(s: &libc::cpu_set_t) -> bool {
+    // SAFETY: sched_setaffinity with pid 0 changes only the calling thread's mask.
+    unsafe { libc::sched_setaffinity(0, std::mem::size_of::<libc::cpu_set_t>(), s) == 0 }
+}
+
+/// Execution thread, at each block's start (before the block's threads start): with `on`, the mechanism's threads of this
+/// block will use the calling thread's CPU set without its lowest CPU (at least two CPUs needed); without, no
+/// reservation. Returns the reserved CPU. The calling thread's set is the one it had before `excore` first pinned it.
+///
+/// Prologue (`exphys`, with `on`): the set also leaves the reserved CPU's SMT siblings ([`reserved_set`]), and, unless
+/// `excore` pins the execution thread already ([`excore_block_start`]), the execution thread pins itself to the
+/// reserved CPU from its execution start to its end ([`exphys_exec_start`]). The block's [`ExphysState`] starts anew
+/// either way.
+pub fn reserve_exec_core(on: bool, exphys: bool, excore: bool) -> Option<usize> {
+    let mut g = reth_execution_cache::lkprof::lock(reth_execution_cache::lkprof::CORES, &CORES);
+    *g = (exec_base_set(), None);
+    let mut phys = PHYS.lock();
+    *phys = ExphysState::OFF;
+    if !on {
+        return None
+    }
+    let full = g.0?;
+    // SAFETY: CPU_ISSET only reads bits of the given set.
+    let cpus: Vec<usize> =
+        unsafe { (0..libc::CPU_SETSIZE as usize).filter(|c| libc::CPU_ISSET(*c, &full)).collect() };
+    if cpus.len() < 2 {
+        return None
+    }
+    let c = cpus[0];
+    let siblings = if exphys { thread_siblings(c) } else { Vec::new() };
+    let (others, removed) = reserved_set(&full, c, &siblings);
+    g.1 = Some(others);
+    if exphys {
+        phys.cpu = (!excore).then_some(c);
+        phys.siblings = removed.unwrap_or(0);
+        phys.fallback = removed.is_none();
+    }
+    Some(c)
+}
+
+/// Prologue (`rdsplit`, EXP-269): the current block's (workers' set, readers' set) when the mechanism's set is split.
+static SPLIT: Mutex<Option<(libc::cpu_set_t, libc::cpu_set_t)>> = parking_lot::const_mutex(None);
+
+/// Prologue (`rdsplit`, EXP-269): after [`reserve_exec_core`] at the block's start: with `n > 0` and a reservation in
+/// force, the readers will use the highest `n` CPUs of the mechanism's set and the other mechanism threads the rest (at
+/// least two CPUs must be left to them); otherwise one set for all.
+pub fn split_readers(n: u32) {
+    let others = reth_execution_cache::lkprof::lock(reth_execution_cache::lkprof::CORES, &CORES).1;
+    let mut g = SPLIT.lock();
+    *g = None;
+    let (Some(others), true) = (others, n > 0) else { return };
+    // SAFETY: CPU_ISSET only reads bits of the given set.
+    let cpus: Vec<usize> = unsafe { (0..libc::CPU_SETSIZE as usize).filter(|c| libc::CPU_ISSET(*c, &others)).collect() };
+    let n = n as usize;
+    if cpus.len() < n + 2 {
+        return
+    }
+    let (mut workers, mut readers) = (others, others);
+    // SAFETY: CPU_CLR only writes bits of the given sets.
+    unsafe {
+        for (i, c) in cpus.iter().enumerate() {
+            if i < cpus.len() - n {
+                libc::CPU_CLR(*c, &mut readers);
+            } else {
+                libc::CPU_CLR(*c, &mut workers);
+            }
+        }
+    }
+    *g = Some((workers, readers));
+}
+
+/// A thread of the mechanism (worker, reader, speculative-pass helper), at its start: moves off the reserved core (with
+/// `exphys`, also off its SMT siblings) when a reservation is in force for the current block, else back to the
+/// execution thread's full set (a thread created by a thread that had left the core inherits the narrowed set).
+pub fn leave_exec_core() {
+    prewarm_sched();
+    leave_exec_core_set(false);
+}
+
+/// [`leave_exec_core`] for a reader: its scheduling class follows `pwbatch` as a reader's ([`reader_sched`]).
+pub fn leave_exec_core_reader() {
+    reader_sched();
+    leave_exec_core_set(true);
+}
+
+fn leave_exec_core_set(reader: bool) {
+    // Prologue (`rdsplit`): the readers' or the workers' part of the split set
+    if let Some((workers, readers)) = *SPLIT.lock() {
+        set_own_affinity(if reader { &readers } else { &workers });
+        return
+    }
+    let (full, others) = *reth_execution_cache::lkprof::lock(reth_execution_cache::lkprof::CORES, &CORES);
+    if let Some(s) = others.or(full) {
+        set_own_affinity(&s);
+    }
+}
+
+/// `excore` (EXP-199, after EXP-218: about a quarter of the execution thread's time is spent waiting for a core): during the
+/// execution of a block with the switch the execution thread runs alone on the lowest core `c` of its set. It pins itself
+/// at the block's start ([`excore_block_start`]); a sweeper thread (`eap-excore`) then moves every other thread of the
+/// node whose set contains `c` off it (the mechanism's threads also leave it themselves, [`reserve_exec_core`]). At the
+/// end of the execution ([`excore_exec_end`]) the execution thread takes its set back, and the sweeper counts the threads
+/// found on `c` (those the execution thread created during the block inherit `c` alone), logs the block's `eap excore`
+/// line and gives every moved thread its set back (a thread that had `c` alone gets the execution thread's set), so
+/// nothing of a block with the switch carries into the state-root wait or the next block. While the switch was never on
+/// nothing is done.
+static EC_EVER: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+/// the core the execution thread is alone on, plus one (0: none)
+static EC_ON: AtomicUsize = AtomicUsize::new(0);
+/// the execution thread's set before it was first pinned
+static EC_FULL: Mutex<Option<libc::cpu_set_t>> = parking_lot::const_mutex(None);
+static EC_TX: std::sync::OnceLock<Option<crossbeam_channel::Sender<EcCmd>>> = std::sync::OnceLock::new();
+
+/// `excore`: the sweeper's work.
+#[derive(Debug)]
+enum EcCmd {
+    /// the execution thread `engine` was pinned to `c` at `t` for the block with control tag `tag`; `clear`: the CPUs
+    /// the other threads leave (`c`, and with `exsmt` its SMT siblings)
+    Pin { c: usize, clear: Vec<usize>, engine: i32, tag: u64, t: std::time::Instant },
+    /// the block's execution ended: count, log and give the moved threads their sets back
+    ExecEnd { tag: u64 },
+    /// a block without the switch while the previous block's end was not seen: give the moved threads their sets back
+    Unpin,
+}
+
+/// The execution thread's set for the block's core computations: the one it had before `excore` first pinned it.
+fn exec_base_set() -> Option<libc::cpu_set_t> {
+    if EC_EVER.load(Ordering::Relaxed) { *EC_FULL.lock() } else { own_affinity() }
+}
+
+/// `excore`: the lowest CPU of `full` and the set of that CPU alone, when `full` has at least two CPUs.
+fn excore_core(full: &libc::cpu_set_t) -> Option<(usize, libc::cpu_set_t)> {
+    // SAFETY: a zeroed cpu_set_t is valid; CPU_ISSET and CPU_SET only read or write bits of the given sets.
+    unsafe {
+        let cpus: Vec<usize> = (0..libc::CPU_SETSIZE as usize).filter(|c| libc::CPU_ISSET(*c, full)).collect();
+        if cpus.len() < 2 {
+            return None
+        }
+        let mut one: libc::cpu_set_t = std::mem::zeroed();
+        libc::CPU_SET(cpus[0], &mut one);
+        Some((cpus[0], one))
+    }
+}
+
+/// Execution thread, at each block's start (`refresh`, before [`reserve_exec_core`]): with `on`, pins itself to the lowest
+/// CPU of its set and has the sweeper move the node's other threads off it (the end of the execution, [`excore_exec_end`],
+/// undoes both); without, nothing, unless the previous block's end was not seen (then it takes its set back and has the
+/// sweeper restore the threads it moved). `tag`: the block's control tag (the driver writes the block number). Returns the
+/// core.
+pub fn excore_block_start(on: bool, smt: bool, tag: u64) -> Option<usize> {
+    if !on && !EC_EVER.load(Ordering::Relaxed) {
+        return None
+    }
+    let full = {
+        let mut g = EC_FULL.lock();
+        if g.is_none() {
+            *g = own_affinity();
+        }
+        (*g)?
+    };
+    if !on {
+        // normally the end of the previous block's execution unpinned already
+        if EC_ON.swap(0, Ordering::Relaxed) != 0 {
+            set_own_affinity(&full);
+            ec_send(EcCmd::Unpin);
+        }
+        return None
+    }
+    let (c, one) = excore_core(&full)?;
+    // Prologue (`exsmt`): the core's SMT siblings are cleared as well (only `c` when they cannot be read)
+    let mut clear = vec![c];
+    if smt {
+        clear.extend(thread_siblings(c).into_iter().filter(|s| *s != c));
+    }
+    EC_EVER.store(true, Ordering::Relaxed);
+    // the sweeper is made before the pin, so it does not start on the core
+    let tx = ec_sender();
+    if !set_own_affinity(&one) {
+        return None
+    }
+    EC_ON.store(c + 1, Ordering::Relaxed);
+    // SAFETY: gettid has no preconditions and only returns the calling thread's id.
+    let engine = unsafe { libc::gettid() };
+    if let Some(tx) = tx {
+        let _ = tx.send(EcCmd::Pin { c, clear, engine, tag, t: std::time::Instant::now() });
+    }
+    Some(c)
+}
+
+/// Execution thread, at the end of the block's execution: takes its set back; the sweeper counts the threads that
+/// appeared on the core during the block, logs the block's `eap excore` line and gives the moved threads their sets back.
+pub fn excore_exec_end(tag: u64) {
+    if EC_ON.swap(0, Ordering::Relaxed) != 0 {
+        if let Some(full) = *EC_FULL.lock() {
+            set_own_affinity(&full);
+        }
+        ec_send(EcCmd::ExecEnd { tag });
+    }
+}
+
+fn ec_sender() -> Option<&'static crossbeam_channel::Sender<EcCmd>> {
+    EC_TX
+        .get_or_init(|| {
+            let (tx, rx) = crossbeam_channel::unbounded();
+            std::thread::Builder::new().name("eap-excore".into()).spawn(move || ec_sweeper(rx)).ok().map(|_| tx)
+        })
+        .as_ref()
+}
+
+fn ec_send(cmd: EcCmd) {
+    if let Some(tx) = ec_sender() {
+        let _ = tx.send(cmd);
+    }
+}
+
+/// The sweeper: moves threads off the execution thread's core and back.
+fn ec_sweeper(rx: crossbeam_channel::Receiver<EcCmd>) {
+    // SAFETY: gettid has no preconditions and only returns the calling thread's id.
+    let me = unsafe { libc::gettid() };
+    // threads moved off the core: thread id -> (the set given, the set to give back)
+    let mut moved: HashMap<i32, (libc::cpu_set_t, libc::cpu_set_t)> = HashMap::new();
+    // the pinned block: core, CPUs cleared, execution thread, tag, threads moved at the pin, microseconds from the pin to
+    // the sweep's end
+    let mut cur: Option<(usize, Vec<usize>, i32, u64, u32, u64)> = None;
+    while let Ok(cmd) = rx.recv() {
+        // the execution thread's set (a thread that has the core alone gets it, less the core, then back)
+        let Some(full) = *EC_FULL.lock() else { continue };
+        match cmd {
+            EcCmd::Pin { c, clear, engine, tag, t } => {
+                if cur.is_some() {
+                    ec_restore(&mut moved);
+                }
+                // this thread off the core (and, with `exsmt`, its siblings) as well
+                if let Some(s) = own_affinity() &&
+                    let Some(s) = clear_cpus(&s, &clear, None)
+                {
+                    set_own_affinity(&s);
+                }
+                let (n, _) = ec_sweep(task_ids(), &clear, &[engine, me], &full, &mut moved);
+                cur = Some((c, clear, engine, tag, n, t.elapsed().as_micros() as u64));
+            }
+            EcCmd::ExecEnd { tag } => {
+                if let Some((c, clear, engine, pin_tag, pin_moved, pin_us)) = cur.take() {
+                    let t0 = std::time::Instant::now();
+                    // threads on the core now: created during the block by the execution thread, or that set their own set
+                    let (new, scanned) = ec_sweep(task_ids(), &clear, &[engine, me], &full, &mut moved);
+                    let restored = ec_restore(&mut moved);
+                    tracing::info!(
+                        target: "reth::eap",
+                        block = tag,
+                        cpu = c,
+                        smt = clear.len() - 1,
+                        pin_moved,
+                        pin_us,
+                        new,
+                        scanned,
+                        restored,
+                        sweep_us = t0.elapsed().as_micros() as u64,
+                        same_block = pin_tag == tag,
+                        "eap excore"
+                    );
+                }
+            }
+            EcCmd::Unpin => {
+                if cur.take().is_some() {
+                    ec_restore(&mut moved);
+                }
+            }
+        }
+    }
+}
+
+/// The ids of this process's threads.
+fn task_ids() -> Vec<i32> {
+    std::fs::read_dir("/proc/self/task")
+        .map(|d| d.filter_map(|e| e.ok()?.file_name().to_str()?.parse().ok()).collect())
+        .unwrap_or_default()
+}
+
+fn thread_affinity(tid: i32) -> Option<libc::cpu_set_t> {
+    // SAFETY: a zeroed cpu_set_t is valid; sched_getaffinity writes the given thread's mask into it.
+    unsafe {
+        let mut s: libc::cpu_set_t = std::mem::zeroed();
+        (libc::sched_getaffinity(tid, std::mem::size_of::<libc::cpu_set_t>(), &mut s) == 0).then_some(s)
+    }
+}
+
+fn set_thread_affinity(tid: i32, s: &libc::cpu_set_t) -> bool {
+    // SAFETY: sched_setaffinity changes only the given thread's mask (a thread of this process).
+    unsafe { libc::sched_setaffinity(tid, std::mem::size_of::<libc::cpu_set_t>(), s) == 0 }
+}
+
+/// `excore`: moves the threads `tids` (except `keep`) whose set contains a CPU of `clear` off those CPUs: to their set less
+/// `clear`, or, for a thread left with none (e.g. created by the pinned execution thread), to `full` less `clear`.
+/// Remembers for each thread the set given and the set to give back (its own, or `full` for a thread that had only CPUs of
+/// `clear`); returns the threads moved and the threads looked at.
+fn ec_sweep(
+    tids: Vec<i32>,
+    clear: &[usize],
+    keep: &[i32],
+    full: &libc::cpu_set_t,
+    moved: &mut HashMap<i32, (libc::cpu_set_t, libc::cpu_set_t)>,
+) -> (u32, u32) {
+    let (mut n, mut seen) = (0u32, 0u32);
+    for tid in tids {
+        if keep.contains(&tid) {
+            continue
+        }
+        seen += 1;
+        let Some(before) = thread_affinity(tid) else { continue };
+        let Some(s) = clear_cpus(&before, clear, Some(full)) else { continue };
+        // a thread that had only CPUs of `clear` gets `full` back at the end
+        // SAFETY: CPU_COUNT and CPU_ISSET only read bits of the given set.
+        let only_cleared = unsafe { (0..libc::CPU_SETSIZE as usize).all(|x| !libc::CPU_ISSET(x, &before) || clear.contains(&x)) };
+        let back = if only_cleared { *full } else { before };
+        // SAFETY: CPU_COUNT only reads bits of the given set.
+        if unsafe { libc::CPU_COUNT(&s) } > 0 && set_thread_affinity(tid, &s) {
+            // a thread moved again keeps the set to give back from its first move
+            moved.entry(tid).and_modify(|e| e.0 = s).or_insert((s, back));
+            n += 1;
+        }
+    }
+    (n, seen)
+}
+
+/// `excore` (`exsmt`): `set` less the CPUs of `clear`, or `None` when `set` has none of them. When nothing of `set` is
+/// left, `fallback` less `clear` (`None` without a fallback or when that is empty too).
+fn clear_cpus(set: &libc::cpu_set_t, clear: &[usize], fallback: Option<&libc::cpu_set_t>) -> Option<libc::cpu_set_t> {
+    // SAFETY: CPU_ISSET, CPU_CLR and CPU_COUNT only read or write bits of the given sets.
+    unsafe {
+        if !clear.iter().any(|c| libc::CPU_ISSET(*c, set)) {
+            return None
+        }
+        let mut s = *set;
+        for c in clear {
+            libc::CPU_CLR(*c, &mut s);
+        }
+        if libc::CPU_COUNT(&s) == 0 {
+            s = *fallback?;
+            for c in clear {
+                libc::CPU_CLR(*c, &mut s);
+            }
+        }
+        (libc::CPU_COUNT(&s) > 0).then_some(s)
+    }
+}
+
+/// `excore`: gives the moved threads their sets back, unless a thread changed its set since the move (it keeps its own);
+/// returns the threads given back.
+fn ec_restore(moved: &mut HashMap<i32, (libc::cpu_set_t, libc::cpu_set_t)>) -> u32 {
+    let mut n = 0;
+    for (tid, (given, back)) in moved.drain() {
+        let Some(now) = thread_affinity(tid) else { continue };
+        // SAFETY: CPU_EQUAL only reads bits of the given sets.
+        if unsafe { libc::CPU_EQUAL(&now, &given) } && set_thread_affinity(tid, &back) {
+            n += 1;
+        }
+    }
+    n
+}
+
+/// Prologue (`exphys`, EXP-247 8.66): the current block's state of the switch, set by [`reserve_exec_core`] at the
+/// block's start and by the execution thread at its execution start and end; read for the `eap sched` line.
+static PHYS: Mutex<ExphysState> = parking_lot::const_mutex(ExphysState::OFF);
+
+thread_local! {
+    /// Prologue (`exphys`): the CPU set the execution thread had before it pinned itself to the reserved CPU, to go
+    /// back to (`None`: not pinned by `exphys`).
+    static PHYS_BEFORE: Cell<Option<libc::cpu_set_t>> = const { Cell::new(None) };
+}
+
+/// Prologue (`exphys`, `eap sched` line): what the switch did in the current block.
+#[derive(Clone, Copy, Debug)]
+pub struct ExphysState {
+    /// The CPU the execution thread pins itself to at its execution start (`None`: no pin in the block).
+    cpu: Option<usize>,
+    /// The reserved CPU's SMT siblings removed from the set the mechanism's threads use (`exphys_sib`): 0 without the
+    /// switch, without a reservation, without a sibling in the set, or on the fallback.
+    pub siblings: u32,
+    /// Removing the siblings would have left the mechanism's threads no CPU, so their set leaves the reserved CPU
+    /// alone, as without the switch (`exphys_fb`).
+    pub fallback: bool,
+    /// The execution thread's pin at its execution start (`exphys_pin`): 1 pinned; 0 no pin (none asked for the block,
+    /// or no execution start); negative: minus the errno of a refused change (the thread kept its set).
+    pub pin: i64,
+    /// The change back at its execution end (`exphys_back`): 1 done; 0 none (not pinned, or the end was not reached:
+    /// the next block's start changes it back); negative: minus the errno of a refused change (tried again at the next
+    /// block's start and execution start).
+    pub back: i64,
+    /// The thread `srrt` raised, moved to the mechanism's set for the pin ([`SR_PHYS`], `exphys_sr`): 1 moved (by the
+    /// execution thread before its pin, or by the raised thread itself when it was raised during the pin); 0 none (no
+    /// pin, no raised thread, or no CPU of its set in the mechanism's set); negative: minus the errno of a refused
+    /// change (the thread kept its set).
+    pub sr: i64,
+    /// Its change back at the execution end (`exphys_sr_back`): 1 done; 0 none (not moved, or its task ended first and
+    /// it went back itself); negative: minus the errno of a refused change (tried again at the next block's start and
+    /// execution start, and by the thread itself when its task ends).
+    pub sr_back: i64,
+}
+
+impl ExphysState {
+    /// A block without the switch, and the state at each block's start.
+    const OFF: Self = Self { cpu: None, siblings: 0, fallback: false, pin: 0, back: 0, sr: 0, sr_back: 0 };
+}
+
+/// Prologue (`exphys` with `srrt`, EXP-247 8.71): the sparse-trie task's thread while `srrt` keeps it real-time
+/// ([`sr_rt_enter`]), as `SCHED_FIFO` at the execution thread's `exrt` priority in the main configuration (both 1). A
+/// waking real-time thread does not preempt a running one of its own priority, and the pinned execution thread cannot
+/// go to another CPU: had the raised thread been running on the reserved CPU at the execution thread's wake-up, the
+/// execution thread would wait there until the raised thread blocks. So from the execution thread's pin to its change
+/// back the raised thread uses the mechanism's set of the block (without the reserved CPU and, with the siblings
+/// removed, without its SMT siblings), as the mechanism's threads and the recovery threads that `exrt` raises
+/// ([`recovery_rt_enter`]) do. With `excore` the sweeper moves every thread off the reserved CPU already. Of the other
+/// real-time raises, the `ewnear` workers and the recovery threads keep off the reserved CPU by themselves; the dispatch
+/// thread of `ewfeed` bit 8 ([`dispatch_rt_enter`]) does not. None of these three raises is on in the main
+/// configuration (`ewnear=0`, `ewfeed=0`).
+static SR_PHYS: Mutex<SrPhys> = parking_lot::const_mutex(SrPhys::NONE);
+
+/// Prologue (`exphys` with `srrt`): the thread `srrt` raised and its set, see [`SR_PHYS`].
+#[derive(Debug)]
+struct SrPhys {
+    /// The raised thread's id, from its raise to the guard's drop; one at a time (the sparse-trie task of one block
+    /// ends before the next block's starts; a second one raised meanwhile is not tracked).
+    tid: Option<libc::pid_t>,
+    /// From the execution thread's pin to its change back: the set the raised thread uses (the mechanism's set).
+    narrow: Option<libc::cpu_set_t>,
+    /// The raised thread's set before it was moved, to go back to (`None`: not moved).
+    before: Option<libc::cpu_set_t>,
+}
+
+impl SrPhys {
+    const NONE: Self = Self { tid: None, narrow: None, before: None };
+}
+
+/// [`SR_PHYS`]: moves the raised thread to its set less the CPUs outside the pin's set, keeping its set to go back to.
+/// Returns 1 when moved; 0 when there is nothing to do (no pin, no raised thread, moved already, or no CPU of its set
+/// left); minus the errno of a refused change (the thread keeps its set).
+fn sr_phys_move(p: &mut SrPhys) -> i64 {
+    let (Some(tid), Some(narrow), None) = (p.tid, p.narrow, p.before) else { return 0 };
+    let errno = || -i64::from(std::io::Error::last_os_error().raw_os_error().unwrap_or(0));
+    let Some(before) = thread_affinity(tid) else { return errno() };
+    let mut s = before;
+    // SAFETY: CPU_ISSET, CPU_CLR and CPU_COUNT only read or write bits of the given sets, at indices below CPU_SETSIZE.
+    unsafe {
+        for c in 0..libc::CPU_SETSIZE as usize {
+            if !libc::CPU_ISSET(c, &narrow) {
+                libc::CPU_CLR(c, &mut s);
+            }
+        }
+        if libc::CPU_COUNT(&s) == 0 {
+            return 0
+        }
+    }
+    if !set_thread_affinity(tid, &s) {
+        return errno()
+    }
+    p.before = Some(before);
+    1
+}
+
+/// [`SR_PHYS`]: the raised thread back to the set it had before [`sr_phys_move`]. Returns 1 when given back, 0 when not
+/// moved, minus the errno of a refused change (the set stays kept for the next try).
+fn sr_phys_back(p: &mut SrPhys) -> i64 {
+    let (Some(tid), Some(before)) = (p.tid, p.before) else { return 0 };
+    if !set_thread_affinity(tid, &before) {
+        return -i64::from(std::io::Error::last_os_error().raw_os_error().unwrap_or(0))
+    }
+    p.before = None;
+    1
+}
+
+/// Execution thread, before its pin: the pin's set is `narrow` (the mechanism's set of the block) and the raised thread,
+/// if any, moves to it ([`sr_phys_move`]).
+fn sr_phys_pin(slot: &Mutex<SrPhys>, narrow: Option<libc::cpu_set_t>) -> i64 {
+    let mut p = slot.lock();
+    p.narrow = narrow;
+    sr_phys_move(&mut p)
+}
+
+/// Execution thread, at its change back (and at a block's start or execution start, for a pin whose end was not
+/// reached): no pin's set any more, and the raised thread goes back ([`sr_phys_back`]).
+fn sr_phys_unpin(slot: &Mutex<SrPhys>) -> i64 {
+    let mut p = slot.lock();
+    p.narrow = None;
+    sr_phys_back(&mut p)
+}
+
+/// The raised thread `tid` (the calling thread), right after its raise: tracked until [`sr_phys_leave`], and moved at
+/// once when the execution thread is pinned already. Returns [`sr_phys_move`]'s outcome; 0 when another raised thread
+/// is tracked.
+fn sr_phys_join(slot: &Mutex<SrPhys>, tid: libc::pid_t) -> i64 {
+    let mut p = slot.lock();
+    if p.tid.is_some() {
+        return 0
+    }
+    p.tid = Some(tid);
+    p.before = None;
+    sr_phys_move(&mut p)
+}
+
+/// The raised thread `tid` (the calling thread), when its guard drops: back to its own set if moved, and no longer
+/// tracked. Nothing for a thread that is not the tracked one.
+fn sr_phys_leave(slot: &Mutex<SrPhys>, tid: libc::pid_t) {
+    let mut p = slot.lock();
+    if p.tid != Some(tid) {
+        return
+    }
+    sr_phys_back(&mut p);
+    *p = SrPhys { narrow: p.narrow, ..SrPhys::NONE };
+}
+
+/// Prologue (`exphys`): the set the mechanism's threads use while CPU `c` of `full` is reserved for the execution
+/// thread: `full` less `c` and less those of `siblings` (`c`'s SMT siblings, `c` among them, [`thread_siblings`]) that
+/// are in `full`, with the number of siblings so removed besides `c`. When that leaves no CPU, `full` less `c` and
+/// `None` (the fallback, as without the switch). `c` is below `CPU_SETSIZE`; siblings at or above it are ignored.
+fn reserved_set(full: &libc::cpu_set_t, c: usize, siblings: &[usize]) -> (libc::cpu_set_t, Option<u32>) {
+    let mut one_less = *full;
+    // SAFETY: CPU_CLR, CPU_ISSET and CPU_COUNT only read or write bits of the given sets, at indices below CPU_SETSIZE.
+    unsafe {
+        libc::CPU_CLR(c, &mut one_less);
+        let mut others = one_less;
+        let mut removed = 0;
+        for &s in siblings.iter().filter(|&&s| s < libc::CPU_SETSIZE as usize) {
+            if libc::CPU_ISSET(s, &others) {
+                libc::CPU_CLR(s, &mut others);
+                removed += 1;
+            }
+        }
+        if libc::CPU_COUNT(&others) > 0 { (others, Some(removed)) } else { (one_less, None) }
+    }
+}
+
+/// Prologue (`exphys`): CPU `c`'s SMT siblings, `c` among them, from
+/// `/sys/devices/system/cpu/cpu<c>/topology/thread_siblings_list`, read once per CPU (the topology does not change
+/// while the node runs). Empty when the file cannot be read or parsed: then only `c` is reserved, as without the
+/// switch.
+fn thread_siblings(c: usize) -> Vec<usize> {
+    static READ: Mutex<Vec<(usize, Vec<usize>)>> = parking_lot::const_mutex(Vec::new());
+    let mut read = READ.lock();
+    if let Some((_, siblings)) = read.iter().find(|(cpu, _)| *cpu == c) {
+        return siblings.clone()
+    }
+    let siblings = std::fs::read_to_string(format!("/sys/devices/system/cpu/cpu{c}/topology/thread_siblings_list"))
+        .map(|s| parse_cpu_list(&s))
+        .unwrap_or_default();
+    read.push((c, siblings.clone()));
+    siblings
+}
+
+/// Prologue (`exphys`): the CPUs of a kernel CPU list such as a `thread_siblings_list` file (`0-1`, `0,16`,
+/// `0-1,32-33`, `3`; whitespace around the list and its items is ignored). Empty for anything else, or for a CPU at or
+/// above `CPU_SETSIZE`.
+fn parse_cpu_list(s: &str) -> Vec<usize> {
+    let mut cpus = Vec::new();
+    for item in s.trim().split(',') {
+        let (lo, hi) = item.split_once('-').unwrap_or((item, item));
+        if let (Ok(lo), Ok(hi)) = (lo.trim().parse::<usize>(), hi.trim().parse::<usize>()) &&
+            lo <= hi &&
+            hi < libc::CPU_SETSIZE as usize
+        {
+            cpus.extend(lo..=hi);
+        } else {
+            return Vec::new()
+        }
+    }
+    cpus
+}
+
+/// Prologue (`exphys`): execution thread, at each block's start (`refresh`, before [`excore_block_start`] and
+/// [`reserve_exec_core`] take its CPU set): a pin whose execution end was not reached goes back, and so does the thread
+/// `srrt` raised ([`SR_PHYS`]).
+pub fn exphys_block_start() {
+    exphys_unpin();
+    sr_phys_unpin(&SR_PHYS);
+}
+
+/// Prologue (`exphys`, EXP-247 8.66): execution thread, at its execution start (`execute_transactions`): pins itself to
+/// the reserved CPU alone when its block asks for it ([`reserve_exec_core`]: `exphys` with a reservation, without
+/// `excore`) until [`exphys_exec_end`]; `exphys_pin` in the `eap sched` line. A pin an earlier block left (its
+/// execution end was not reached) goes back first. Before the pin, the thread `srrt` raised moves to the mechanism's set
+/// until the change back ([`SR_PHYS`], `exphys_sr`), so that the pinned thread does not find it running on the reserved
+/// CPU; no other thread is moved. A thread the execution thread creates while pinned inherits the reserved CPU alone:
+/// the mechanism's threads leave it at their start ([`leave_exec_core`]), any other thread keeps it (such as reth's
+/// `drop` worker, which `spawn_drop` creates at its first use, reached during the execution with reth's own prewarm
+/// reuse).
+pub fn exphys_exec_start() {
+    let cpu = PHYS.lock().cpu;
+    sr_phys_unpin(&SR_PHYS);
+    let sr = match cpu {
+        Some(_) => sr_phys_pin(
+            &SR_PHYS,
+            reth_execution_cache::lkprof::lock(reth_execution_cache::lkprof::CORES, &CORES).1,
+        ),
+        None => 0,
+    };
+    let pin = exphys_exec_start_with(cpu);
+    let mut phys = PHYS.lock();
+    phys.pin = pin;
+    phys.sr = sr;
+}
+
+/// [`exphys_exec_start`] with the block's CPU `cpu` (`None`: no pin): a kept pin goes back, then the thread is pinned
+/// to `cpu`. Returns the pin's outcome as in [`ExphysState::pin`].
+fn exphys_exec_start_with(cpu: Option<usize>) -> i64 {
+    exphys_unpin();
+    cpu.map_or(0, exphys_pin)
+}
+
+/// Prologue (`exphys`): execution thread, at its execution end (`validate_block_with_state`, before the code there that
+/// may create a thread): back to the set it had before [`exphys_exec_start`], and the thread `srrt` raised back to its
+/// own; `exphys_back` and `exphys_sr_back` in the `eap sched` line. Nothing when it is not pinned.
+pub fn exphys_exec_end() {
+    let back = exphys_unpin();
+    let sr_back = sr_phys_unpin(&SR_PHYS);
+    if back != 0 || sr_back != 0 {
+        let mut phys = PHYS.lock();
+        if back != 0 {
+            phys.back = back;
+        }
+        if sr_back != 0 {
+            phys.sr_back = sr_back;
+        }
+    }
+}
+
+/// Prologue (`exphys`, `eap sched` line): the current block's state of the switch.
+pub fn exphys_state() -> ExphysState {
+    *PHYS.lock()
+}
+
+/// Pins the calling thread to CPU `c` (below `CPU_SETSIZE`) alone and keeps the set it had to go back to; a set still
+/// kept (its change back was refused) stays the one to go back to. Returns 1, or minus the errno of a refused change.
+fn exphys_pin(c: usize) -> i64 {
+    let errno = || -i64::from(std::io::Error::last_os_error().raw_os_error().unwrap_or(0));
+    let Some(before) = PHYS_BEFORE.with(|b| b.get()).or_else(own_affinity) else { return errno() };
+    // SAFETY: a zeroed cpu_set_t is valid; CPU_SET only writes a bit of the local set.
+    let one = unsafe {
+        let mut one: libc::cpu_set_t = std::mem::zeroed();
+        libc::CPU_SET(c, &mut one);
+        one
+    };
+    if !set_own_affinity(&one) {
+        return errno()
+    }
+    PHYS_BEFORE.with(|b| b.set(Some(before)));
+    1
+}
+
+/// Gives the calling thread back the set it had before [`exphys_pin`]: 1 when given back, 0 when it is not pinned,
+/// minus the errno of a refused change (the set stays kept for the next try).
+fn exphys_unpin() -> i64 {
+    let Some(before) = PHYS_BEFORE.with(|b| b.get()) else { return 0 };
+    if !set_own_affinity(&before) {
+        return -i64::from(std::io::Error::last_os_error().raw_os_error().unwrap_or(0))
+    }
+    PHYS_BEFORE.with(|b| b.set(None));
+    1
+}
+
+/// EXP-218 (`exslice`, `pwbatch`): the execution thread's slice (us, 0: default) and whether prewarm threads run as
+/// SCHED_BATCH, for the current block.
+static EX_SLICE_US: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+static PW_BATCH: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(0);
+/// whether `pwbatch` was on in any block so far (until then `prewarm_sched` makes no system call at all)
+static PW_BATCH_EVER: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// EXP-199 (`exrt`): the execution thread's real-time priority for the current block (0: off).
+static EX_RT: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+/// EXP-199 (`exrt`): for the `eap block` line, the outcome of the block's change at its execution start: the priority
+/// the execution thread ran its transactions at (0: normal, reset by `set_sched` at every block), or minus the errno of
+/// a refused change (EPERM without RLIMIT_RTPRIO or CAP_SYS_NICE); and the number of refused changes so far (one per
+/// execution: a block executed again after a failed background check of `reusechkbg` counts again).
+static EX_RT_STATE: std::sync::atomic::AtomicI64 = std::sync::atomic::AtomicI64::new(0);
+static EX_RT_REFUSED: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+/// X-029 (`exio`): whether the execution thread sets its own I/O priority to best-effort while it runs real-time by
+/// `exrt`, for the current block.
+static EX_IO: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+/// X-029 (`exio`): for the `eap sched` line, the I/O class the execution thread ran the block's transactions with by
+/// its own change ([`IOPRIO_CLASS_BE`]; 0: none of its own, so the class follows its CPU policy), or minus the errno of a
+/// refused change. Reset by `set_sched` at every block.
+static EX_IO_STATE: std::sync::atomic::AtomicI64 = std::sync::atomic::AtomicI64::new(0);
+
+/// `ioprio_set(2)`, `ioprio_get(2)`: `who` is a thread id (0: the calling thread).
+const IOPRIO_WHO_PROCESS: libc::c_int = 1;
+/// `ioprio_set(2)`: the bit offset of the class in a priority value.
+const IOPRIO_CLASS_SHIFT: libc::c_int = 13;
+/// `ioprio_set(2)`: the best-effort class, the class of a normal thread's reads.
+const IOPRIO_CLASS_BE: libc::c_int = 2;
+/// `ioprio_set(2)`: the level within the class a normal thread at nice 0 gets.
+const IOPRIO_NORM: libc::c_int = 4;
+
+thread_local! {
+    /// the slice this thread last set for itself (us, 0: default)
+    static SLICE_SET: Cell<u32> = const { Cell::new(0) };
+    /// EXP-199 (`exrt`): the real-time priority this thread runs at by its own change (0: none), and the policy and
+    /// nice value it had before, to go back to
+    static RT_SET: Cell<u32> = const { Cell::new(0) };
+    static RT_BEFORE: Cell<(u32, i32)> = const { Cell::new((0, 0)) };
+    /// X-029 (`exio`): the I/O priority value this thread had before it set its own by [`apply_exec_io`], to go back
+    /// to (`None`: not set by it)
+    static IO_BEFORE: Cell<Option<libc::c_int>> = const { Cell::new(None) };
+}
+
+/// EXP-199 (`exrt`): the priority the execution thread ran the current block's transactions at (0: normal; negative:
+/// minus the errno of a refused change) and the refused changes so far.
+pub fn exec_rt_state() -> (i64, u64) {
+    (EX_RT_STATE.load(Ordering::Relaxed), EX_RT_REFUSED.load(Ordering::Relaxed))
+}
+
+/// X-029 (`eap sched` line, `exio`): the I/O class the execution thread ran the current block's transactions with by
+/// its own change (2: best-effort; 0: none of its own; negative: minus the errno of a refused change).
+pub fn exec_io_state() -> i64 {
+    EX_IO_STATE.load(Ordering::Relaxed)
+}
+
+/// EXP-199 (`eap sched` line): the scheduling slice the calling thread last set for itself (us; 0: the kernel's default).
+/// Called on the engine thread, which executes the blocks, it is the slice the execution thread ran the last block with.
+pub fn exec_slice_set() -> u32 {
+    SLICE_SET.with(|c| c.get())
+}
+
+/// EXP-199 (`eap sched` line): the core reserved for the execution thread in the current block by [`reserve_exec_core`]
+/// (`ewcore`, `excore`): the core of the execution thread's set that the mechanism's threads leave; `None` without a
+/// reservation.
+pub fn exec_core_reserved() -> Option<usize> {
+    let g = reth_execution_cache::lkprof::lock(reth_execution_cache::lkprof::CORES, &CORES);
+    reserved_core(g.0, g.1)
+}
+
+/// The core of `full` that `others` leaves out (the first one), `None` when either set is missing.
+fn reserved_core(full: Option<libc::cpu_set_t>, others: Option<libc::cpu_set_t>) -> Option<usize> {
+    let (Some(full), Some(others)) = (full, others) else { return None };
+    // SAFETY: CPU_ISSET only reads bits of the given sets.
+    unsafe { (0..libc::CPU_SETSIZE as usize).find(|c| libc::CPU_ISSET(*c, &full) && !libc::CPU_ISSET(*c, &others)) }
+}
+
+/// Sets the block's scheduling switches (`refresh`).
+pub fn set_sched(exslice_us: u32, pwbatch: u8, exrt: u32, exio: bool) {
+    EX_RT.store(exrt, Ordering::Relaxed);
+    EX_RT_STATE.store(0, Ordering::Relaxed);
+    EX_IO.store(exio, Ordering::Relaxed);
+    EX_IO_STATE.store(0, Ordering::Relaxed);
+    EX_SLICE_US.store(exslice_us, Ordering::Relaxed);
+    PW_BATCH.store(pwbatch, Ordering::Relaxed);
+    if pwbatch > 0 {
+        PW_BATCH_EVER.store(true, Ordering::Relaxed);
+    }
+}
+
+/// `struct sched_attr` of `sched_setattr(2)` (the fields up to `sched_period`).
+#[repr(C)]
+#[derive(Default)]
+struct SchedAttr {
+    size: u32,
+    policy: u32,
+    flags: u64,
+    nice: i32,
+    priority: u32,
+    runtime: u64,
+    deadline: u64,
+    period: u64,
+}
+
+/// The execution thread at its block's execution start: its slice set to the block's `exslice` (only when it differs
+/// from what this thread last set). The policy and nice value are kept; reset on fork, so threads it creates keep the
+/// default slice. Needs no privilege for a normal or batch thread.
+///
+/// EXP-199 (`exrt`): a thread still at a real-time priority here (an [`ExecRt`] that was not dropped) goes back first.
+pub fn apply_exec_slice() {
+    if RT_SET.with(|c| c.get()) != 0 {
+        leave_exec_rt(EX_SLICE_US.load(Ordering::Relaxed));
+        return
+    }
+    apply_exec_slice_us(EX_SLICE_US.load(Ordering::Relaxed));
+}
+
+/// EXP-199 (`exrt=<prio>`): the execution thread at its block's execution start, after [`apply_exec_slice`]: with `exrt`
+/// it runs the block's transactions as SCHED_FIFO at that priority, reset on fork (threads it creates start as normal
+/// threads), until the returned guard is dropped at the end of the execution; then it goes back to the policy and nice
+/// value it had, with the block's slice. So the state-root wait, the fork-choice update and the next block's
+/// preparation run as before. Raising a thread to a real-time policy needs RLIMIT_RTPRIO of at least the priority (or
+/// CAP_SYS_NICE); a refused change leaves the thread as it was and is counted (`exrt_state`, `exrt_refused` in the
+/// `eap block` line). Without `exrt` nothing happens (`None`).
+///
+/// X-029 (`exio`): once the thread runs real-time, it also sets its own I/O priority to best-effort
+/// ([`apply_exec_io`]) until it goes back to its normal policy. Without an I/O priority of its own a `SCHED_FIFO`
+/// thread's reads get the real-time class, and mq-deadline dispatches no best-effort read while a real-time one is
+/// queued or in flight (EXP-247 README 8.47).
+pub fn exec_rt_enter() -> Option<ExecRt> {
+    exec_rt_enter_with(EX_RT.load(Ordering::Relaxed), EX_IO.load(Ordering::Relaxed)).map(|(g, _)| g)
+}
+
+/// [`exec_rt_enter`] at priority `rt` (0: nothing) and with `exio` as `io`, with the outcome as in `exrt_state`.
+fn exec_rt_enter_with(rt: u32, io: bool) -> Option<(ExecRt, i64)> {
+    (rt > 0).then(|| {
+        let state = apply_exec_rt(rt);
+        // only while real-time (a normal thread's reads are best-effort anyway); otherwise a priority still set after a
+        // change back that failed goes back here
+        if io && state > 0 {
+            apply_exec_io();
+        } else {
+            leave_exec_io();
+        }
+        (ExecRt, state)
+    })
+}
+
+/// Guard of [`exec_rt_enter`]: the thread back to its normal policy when dropped (also on an early return or a panic).
+#[derive(Debug)]
+pub struct ExecRt;
+
+impl Drop for ExecRt {
+    fn drop(&mut self) {
+        if RT_SET.with(|c| c.get()) != 0 {
+            leave_exec_rt(EX_SLICE_US.load(Ordering::Relaxed));
+        }
+    }
+}
+
+/// EXP-199 (`exrt`): whether the calling thread runs at a real-time priority by [`exec_rt_enter`]. A real-time thread's
+/// `sched_yield` lets only real-time threads of its priority run, so a bounded wait for another thread sleeps briefly
+/// instead of yielding while this holds.
+pub fn exec_rt_on() -> bool {
+    RT_SET.with(|c| c.get()) != 0
+}
+
+/// [`exec_rt_enter`]: SCHED_FIFO at `prio` (only when this thread does not run at it already); returns the outcome it
+/// stores for the `eap block` line (the priority, or minus the errno of a refused change).
+fn apply_exec_rt(prio: u32) -> i64 {
+    if RT_SET.with(|c| c.get()) == prio {
+        EX_RT_STATE.store(i64::from(prio), Ordering::Relaxed);
+        return i64::from(prio)
+    }
+    let mut a = SchedAttr::default();
+    let size = std::mem::size_of::<SchedAttr>() as u32;
+    // SAFETY: as in `apply_exec_slice_us`: pid 0, a valid sched_attr buffer of `size` bytes.
+    unsafe {
+        if libc::syscall(libc::SYS_sched_getattr, 0, &mut a as *mut SchedAttr, size, 0) != 0 {
+            let err = std::io::Error::last_os_error().raw_os_error().unwrap_or(0);
+            EX_RT_STATE.store(-i64::from(err), Ordering::Relaxed);
+            EX_RT_REFUSED.fetch_add(1, Ordering::Relaxed);
+            return -i64::from(err)
+        }
+        // the thread's own normal policy and nice value, to go back to (not overwritten while it runs at a priority)
+        if RT_SET.with(|c| c.get()) == 0 {
+            RT_BEFORE.with(|c| c.set((a.policy, a.nice)));
+        }
+        let rt = SchedAttr {
+            size,
+            policy: libc::SCHED_FIFO as u32,
+            flags: 1, // SCHED_FLAG_RESET_ON_FORK
+            priority: prio,
+            ..Default::default()
+        };
+        if libc::syscall(libc::SYS_sched_setattr, 0, &rt as *const SchedAttr, 0) == 0 {
+            RT_SET.with(|c| c.set(prio));
+            EX_RT_STATE.store(i64::from(prio), Ordering::Relaxed);
+            i64::from(prio)
+        } else {
+            let err = std::io::Error::last_os_error().raw_os_error().unwrap_or(0);
+            EX_RT_STATE.store(-i64::from(err), Ordering::Relaxed);
+            EX_RT_REFUSED.fetch_add(1, Ordering::Relaxed);
+            -i64::from(err)
+        }
+    }
+}
+
+/// The end of [`exec_rt_enter`]'s guard: back to the policy and nice value the thread had, with the block's slice (`us`,
+/// 0: default). Lowering needs no privilege (the nice value is the one kept while at the real-time priority). Reset on
+/// fork stays set, as the kernel allows clearing it only with CAP_SYS_NICE; it changes a child only when the thread's
+/// nice value is negative (the node runs at 0). `exrt_state` keeps the priority the block ran at. Should the change
+/// fail, the thread stays real-time until the next block's [`apply_exec_slice`] tries again (not counted). With `exio`
+/// the I/O priority goes back once the thread is normal again ([`leave_exec_io`]).
+fn leave_exec_rt(us: u32) {
+    let (policy, nice) = RT_BEFORE.with(|c| c.get());
+    let size = std::mem::size_of::<SchedAttr>() as u32;
+    let back = SchedAttr {
+        size,
+        policy: if policy == libc::SCHED_BATCH as u32 { policy } else { libc::SCHED_OTHER as u32 },
+        flags: 1, // SCHED_FLAG_RESET_ON_FORK
+        nice,
+        runtime: u64::from(us) * 1000,
+        ..Default::default()
+    };
+    // SAFETY: as in `apply_exec_slice_us`.
+    if unsafe { libc::syscall(libc::SYS_sched_setattr, 0, &back as *const SchedAttr, 0) } == 0 {
+        RT_SET.with(|c| c.set(0));
+        SLICE_SET.with(|c| c.set(us));
+        leave_exec_io();
+    }
+}
+
+/// X-029 (`exio`, [`exec_rt_enter`]): the calling thread's own I/O priority set to best-effort at level 4, what a
+/// normal thread at nice 0 gets (only when it has not set it already); the value it had before is kept to go back to.
+/// Needs no privilege. The kernel takes a thread's own priority over the one its CPU policy implies, and copies it to
+/// the threads it creates meanwhile. Stores the outcome for the `eap sched` line (`exio_state`) and returns it: the class
+/// set, or minus the errno of a refused change (the thread stays as it was).
+fn apply_exec_io() -> i64 {
+    if IO_BEFORE.with(|c| c.get()).is_none() {
+        match set_own_io_best_effort() {
+            Ok(before) => IO_BEFORE.with(|c| c.set(Some(before))),
+            Err(err) => {
+                EX_IO_STATE.store(err, Ordering::Relaxed);
+                return err
+            }
+        }
+    }
+    EX_IO_STATE.store(i64::from(IOPRIO_CLASS_BE), Ordering::Relaxed);
+    i64::from(IOPRIO_CLASS_BE)
+}
+
+/// The calling thread's own I/O priority set to best-effort at level 4 (what a normal thread at nice 0 gets); returns the
+/// value it had set before (0, no class, when none), or minus the errno of a refused change (the thread stays as it was).
+/// Needs no privilege. Used while a thread runs real-time ([`apply_exec_io`], [`sr_rt_enter`]): without a priority of its
+/// own a `SCHED_FIFO` thread's reads get the real-time class.
+pub(crate) fn set_own_io_best_effort() -> Result<libc::c_int, i64> {
+    // SAFETY: ioprio_get and ioprio_set with IOPRIO_WHO_PROCESS and who 0 read or change the calling thread only;
+    // ioprio_get returns the value the thread set (0, no class, when it set none), not the one it runs with.
+    let before = unsafe { libc::syscall(libc::SYS_ioprio_get, IOPRIO_WHO_PROCESS, 0) };
+    let value = (IOPRIO_CLASS_BE << IOPRIO_CLASS_SHIFT) | IOPRIO_NORM;
+    if let Ok(before) = libc::c_int::try_from(before) &&
+        before >= 0 &&
+        unsafe { libc::syscall(libc::SYS_ioprio_set, IOPRIO_WHO_PROCESS, 0, value) } == 0
+    {
+        Ok(before)
+    } else {
+        Err(-i64::from(std::io::Error::last_os_error().raw_os_error().unwrap_or(0)))
+    }
+}
+
+/// The calling thread's own I/O priority back to `before` (from [`set_own_io_best_effort`]); returns whether it went back.
+fn restore_own_io(before: libc::c_int) -> bool {
+    // SAFETY: as in `set_own_io_best_effort`.
+    unsafe { libc::syscall(libc::SYS_ioprio_set, IOPRIO_WHO_PROCESS, 0, before) == 0 }
+}
+
+/// The end of [`apply_exec_io`]: the thread back to the I/O priority value it had (for the node's threads none, so the
+/// class follows the CPU policy again); nothing when it did not set one. Should the change fail, the thread keeps the
+/// best-effort priority until the next block's [`exec_rt_enter`] tries again.
+fn leave_exec_io() {
+    let Some(before) = IO_BEFORE.with(|c| c.get()) else { return };
+    if restore_own_io(before) {
+        IO_BEFORE.with(|c| c.set(None));
+    }
+}
+
+/// X-029 (`ewfeed` bit 8): the own prewarm's dispatch thread as SCHED_FIFO at the execution thread's `exrt` priority
+/// (reset on fork) until the returned guard drops, so the threads at that priority (the execution thread, the raised
+/// `ewnear` workers) do not keep it from handing transactions to the workers. `None` without `exrt`, for a thread not of a
+/// normal class, or when the change is refused (the thread stays as it was).
+pub fn dispatch_rt_enter() -> Option<DispatchRt> {
+    let prio = EX_RT.load(Ordering::Relaxed);
+    if prio == 0 {
+        return None
+    }
+    let mut a = SchedAttr::default();
+    let size = std::mem::size_of::<SchedAttr>() as u32;
+    // SAFETY: as in `apply_exec_slice_us`: pid 0 (the calling thread), a valid sched_attr buffer of `size` bytes.
+    unsafe {
+        if libc::syscall(libc::SYS_sched_getattr, 0, &mut a as *mut SchedAttr, size, 0) != 0 ||
+            ![libc::SCHED_OTHER as u32, libc::SCHED_BATCH as u32, libc::SCHED_IDLE as u32].contains(&a.policy)
+        {
+            return None
+        }
+        let rt = SchedAttr {
+            size,
+            policy: libc::SCHED_FIFO as u32,
+            flags: 1, // SCHED_FLAG_RESET_ON_FORK
+            priority: prio,
+            ..Default::default()
+        };
+        if libc::syscall(libc::SYS_sched_setattr, 0, &rt as *const SchedAttr, 0) != 0 {
+            return None
+        }
+    }
+    Some(DispatchRt { policy: a.policy, nice: a.nice, runtime: a.runtime })
+}
+
+/// Guard of [`dispatch_rt_enter`]: the thread back to the policy, nice value and slice it had when dropped (lowering
+/// needs no privilege; the reset-on-fork flag stays set).
+#[derive(Debug)]
+pub struct DispatchRt {
+    policy: u32,
+    nice: i32,
+    runtime: u64,
+}
+
+impl Drop for DispatchRt {
+    fn drop(&mut self) {
+        let back = SchedAttr {
+            size: std::mem::size_of::<SchedAttr>() as u32,
+            policy: self.policy,
+            flags: 1, // SCHED_FLAG_RESET_ON_FORK
+            nice: self.nice,
+            runtime: self.runtime,
+            ..Default::default()
+        };
+        // SAFETY: as in `apply_exec_slice_us`.
+        unsafe { libc::syscall(libc::SYS_sched_setattr, 0, &back as *const SchedAttr, 0) };
+    }
+}
+
+/// X-029 (`ewfeed` bit 16, `EWF_RECRT`): recovery threads raised now, and the block's counts of pieces raised, pieces
+/// left as they were because the limit was reached, and refused changes (see [`recovery_rt_enter`]).
+static REC_RT_RUNNING: AtomicUsize = AtomicUsize::new(0);
+static REC_RT_COUNTS: [AtomicU64; 3] = [AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0)];
+
+/// X-029 (`ewfeed` bit 16, `EWF_RECRT`, Master 11-03: Prologue's recovery windows took 15.7-17.2 us per transaction
+/// against stock's 8.4-13.3 with the same processor time per recovery, so the recovery got about two cores): a thread of
+/// the cpu pool that recovers a piece of the block's transactions (a window's share, a `pwheavyfirst` pick, the ordered
+/// claims) runs as SCHED_FIFO at the execution thread's `exrt` priority (reset on fork) and off the core reserved for
+/// the execution thread (`ewcore`; with `exphys`, also off its SMT siblings) until the returned guard drops; then it
+/// goes back to the policy, nice value, slice and CPU set it had. At most the reserved set's cores less one run raised
+/// at once, so one core of the set stays with the workers and readers. `None` (the thread stays as it was) without
+/// `exrt`, without a reservation for the block, at the limit (counted), or when a change is refused (counted). The
+/// caller checks the bit.
+pub fn recovery_rt_enter() -> Option<RecoveryRt> {
+    let others = reth_execution_cache::lkprof::lock(reth_execution_cache::lkprof::CORES, &CORES).1;
+    recovery_rt_enter_with(EX_RT.load(Ordering::Relaxed), others)
+}
+
+/// [`recovery_rt_enter`] at priority `prio` (0: nothing) with the set `others` the raised thread keeps to (`None`:
+/// nothing).
+fn recovery_rt_enter_with(prio: u32, others: Option<libc::cpu_set_t>) -> Option<RecoveryRt> {
+    let others = others?;
+    if prio == 0 {
+        return None
+    }
+    // SAFETY: CPU_COUNT only reads the given set.
+    let limit = (unsafe { libc::CPU_COUNT(&others) } as usize).saturating_sub(1).max(1);
+    if REC_RT_RUNNING.fetch_add(1, Ordering::AcqRel) >= limit {
+        REC_RT_RUNNING.fetch_sub(1, Ordering::AcqRel);
+        REC_RT_COUNTS[1].fetch_add(1, Ordering::Relaxed);
+        return None
+    }
+    let refused = || {
+        REC_RT_RUNNING.fetch_sub(1, Ordering::AcqRel);
+        REC_RT_COUNTS[2].fetch_add(1, Ordering::Relaxed);
+        None
+    };
+    let Some(cpus) = own_affinity() else { return refused() };
+    let mut a = SchedAttr::default();
+    let size = std::mem::size_of::<SchedAttr>() as u32;
+    // SAFETY: as in `apply_exec_slice_us`: pid 0 (the calling thread), a valid sched_attr buffer of `size` bytes.
+    if unsafe { libc::syscall(libc::SYS_sched_getattr, 0, &mut a as *mut SchedAttr, size, 0) } != 0 ||
+        ![libc::SCHED_OTHER as u32, libc::SCHED_BATCH as u32, libc::SCHED_IDLE as u32].contains(&a.policy)
+    {
+        return refused()
+    }
+    // off the execution thread's core first, so the thread never runs there at the raised priority
+    if !set_own_affinity(&others) {
+        return refused()
+    }
+    let rt = SchedAttr {
+        size,
+        policy: libc::SCHED_FIFO as u32,
+        flags: 1, // SCHED_FLAG_RESET_ON_FORK
+        priority: prio,
+        ..Default::default()
+    };
+    // SAFETY: as above.
+    if unsafe { libc::syscall(libc::SYS_sched_setattr, 0, &rt as *const SchedAttr, 0) } != 0 {
+        set_own_affinity(&cpus);
+        return refused()
+    }
+    REC_RT_COUNTS[0].fetch_add(1, Ordering::Relaxed);
+    Some(RecoveryRt { policy: a.policy, nice: a.nice, runtime: a.runtime, cpus })
+}
+
+/// Guard of [`recovery_rt_enter`]: when dropped, the thread back to the policy, nice value and slice it had (lowering
+/// needs no privilege; the reset-on-fork flag stays set), then to its CPU set.
+pub struct RecoveryRt {
+    policy: u32,
+    nice: i32,
+    runtime: u64,
+    cpus: libc::cpu_set_t,
+}
+
+impl std::fmt::Debug for RecoveryRt {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("RecoveryRt").field("policy", &self.policy).field("nice", &self.nice).finish_non_exhaustive()
+    }
+}
+
+impl Drop for RecoveryRt {
+    fn drop(&mut self) {
+        let back = SchedAttr {
+            size: std::mem::size_of::<SchedAttr>() as u32,
+            policy: self.policy,
+            flags: 1, // SCHED_FLAG_RESET_ON_FORK
+            nice: self.nice,
+            runtime: self.runtime,
+            ..Default::default()
+        };
+        // SAFETY: as in `apply_exec_slice_us`.
+        unsafe { libc::syscall(libc::SYS_sched_setattr, 0, &back as *const SchedAttr, 0) };
+        set_own_affinity(&self.cpus);
+        REC_RT_RUNNING.fetch_sub(1, Ordering::AcqRel);
+    }
+}
+
+/// X-029 (`EWF_RECRT`): the block's `eap recrt` line, written by the transaction-iterator thread when the block's
+/// recovery has ended: the pieces raised, left as they were at the limit, and refused since the last line.
+pub fn recovery_rt_log() {
+    let [raised, full, refused] = [0, 1, 2].map(|k| REC_RT_COUNTS[k].swap(0, Ordering::Relaxed));
+    tracing::info!(target: "reth::eap", "eap recrt tag={} raised={raised} full={full} refused={refused}", crate::tree::eap::current().tag);
+}
+
+/// EXP-199 (`ewnear=<prio>`, Master 11-02 after `pwpre199`: the runs the execution thread caught up with had been
+/// preempted before the catch-up): a worker of the mechanism's own prewarm whose transaction is among the next
+/// `ewnearn` after the one the execution thread is executing runs as SCHED_FIFO at this priority (reset on fork) until
+/// its run ends or the execution thread reaches its transaction; then it goes back to the policy and nice value it had.
+/// Each worker changes only itself: at the start of a run and before each backend read ([`near_check`], the execution
+/// cache's read hook), so the execution thread makes no system call. 0: off.
+static NEAR_PRIO: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+static NEAR_N: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(2);
+/// X-029 (`ewnearkeep`): the transaction being executed counts as in the window, so its worker goes back only when the
+/// execution thread moves past it (set by [`set_near`] at every block)
+static NEAR_KEEP: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+/// X-029 (`ewnearkeep`): the generation ([`NEAR_GEN`]) whose block's execution has ended ([`near_exec_end`]; `u32::MAX`:
+/// none). From then on no worker of that block is raised or kept raised, also not the one of the block's last
+/// transaction, which the execution thread never moves past
+static NEAR_DONE: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(u32::MAX);
+/// EXP-199 (`ewnear`): the block's raises, refused raises, changes back and time at the real-time priority (us), for the
+/// `eap block` line (reset by [`set_near`] at every block; a run that spans the next block's start counts there)
+static NEAR_COUNTS: [std::sync::atomic::AtomicU64; 4] = [const { std::sync::atomic::AtomicU64::new(0) }; 4];
+/// EXP-199 (`ewnear`): the block's number among the blocks since start (incremented by [`set_near`]); a run that started in
+/// an earlier block is treated as caught up (its block's execution has ended), so it is never raised in the next block
+static NEAR_GEN: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+/// EXP-199 (`ewnear`): the raised workers are kept off the execution thread's core only by its own real-time priority
+/// (`exrt` without `excore`): then a worker is raised only while the execution thread runs real-time (`EX_RT_STATE` > 0,
+/// set at its execution start, reset at `refresh`), not during the block's preparation or when `exrt` was refused
+static NEAR_NEEDS_EXRT: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+thread_local! {
+    /// EXP-199 (`ewnear`): the transaction of this worker's current run (`u32::MAX`: none, or the switch is off), the
+    /// priority it runs at by its own change (0: none), when it was raised, and the policy and nice value it had before
+    static NEAR_TX: Cell<u32> = const { Cell::new(u32::MAX) };
+    static NEAR_SET: Cell<u32> = const { Cell::new(0) };
+    static NEAR_T: Cell<Option<std::time::Instant>> = const { Cell::new(None) };
+    static NEAR_BEFORE: Cell<(u32, i32)> = const { Cell::new((0, 0)) };
+    /// the block (`NEAR_GEN`) the current run started in, and the last block in which a raise of this thread was refused
+    /// (not tried again in that block)
+    static NEAR_RUN_GEN: Cell<u32> = const { Cell::new(0) };
+    static NEAR_REFUSED_GEN: Cell<u32> = const { Cell::new(u32::MAX) };
+}
+
+/// EXP-199 (`ewnear`): sets the block's priority (0: off), window and whether a raise waits for the execution thread's
+/// real-time priority (`refresh`), starts a new block generation, resets the block's counts and installs the execution
+/// cache's read hook (once).
+pub fn set_near(prio: u32, n: u32, keep: bool, needs_exrt: bool) {
+    NEAR_GEN.fetch_add(1, Ordering::Relaxed);
+    NEAR_NEEDS_EXRT.store(needs_exrt, Ordering::Relaxed);
+    NEAR_PRIO.store(prio, Ordering::Relaxed);
+    NEAR_N.store(n.max(1), Ordering::Relaxed);
+    NEAR_KEEP.store(keep, Ordering::Relaxed);
+    for c in &NEAR_COUNTS {
+        c.store(0, Ordering::Relaxed);
+    }
+    if prio > 0 {
+        reth_execution_cache::set_pw_read_hook(near_check);
+    }
+}
+
+/// EXP-199 (`ewnear`): the priority in effect for the current block (0: off), after `refresh`'s rule.
+pub fn near_prio() -> u32 {
+    NEAR_PRIO.load(Ordering::Relaxed)
+}
+
+/// EXP-199 (`ewnear`): the current block's generation, read by a worker when it starts its block's work and passed to
+/// every [`near_run`] of that work, so a run is stamped with its own block even if the next block starts meanwhile.
+pub fn near_gen() -> u32 {
+    NEAR_GEN.load(Ordering::Relaxed)
+}
+
+/// EXP-199 (`ewnear`): the block's raises, refused raises, changes back and microseconds at the real-time priority.
+pub fn near_counts() -> [u64; 4] {
+    NEAR_COUNTS.each_ref().map(|c| c.load(Ordering::Relaxed))
+}
+
+/// EXP-199 (`ewnear`): for a run of transaction `tx` while the execution thread executes `exec` (`u32::MAX`: not started),
+/// whether `tx` is among the next `n` transactions (raise) and whether the execution thread has reached it (set back).
+/// X-029 (`keep`): `tx` itself while the execution thread executes it is in the window too, and the run is caught up only
+/// once the execution thread is past it or the block's execution has ended (`ended`, read only with `keep`).
+fn near_state(tx: u32, exec: u32, n: u32, keep: bool, ended: bool) -> (bool, bool) {
+    if keep && ended {
+        return (false, true)
+    }
+    if exec == u32::MAX {
+        return (tx < n, false)
+    }
+    if keep {
+        return (tx >= exec && tx - exec <= n, tx < exec)
+    }
+    (tx > exec && tx - exec <= n, tx <= exec)
+}
+
+/// X-029 (`ewnearkeep`): the execution thread at the end of its block's execution (after the transactions, also when
+/// the execution failed): with the switch, a worker still raised goes back at its next check and no worker of the block
+/// is raised any more. Without the switch nothing changes (every run is caught up by then).
+pub fn near_exec_end() {
+    NEAR_DONE.store(NEAR_GEN.load(Ordering::Relaxed), Ordering::Relaxed);
+}
+
+/// EXP-199 (`ewnear`): a worker starts a run of transaction `tx` (after `pw_set_tx`): with the switch it is watched until
+/// the returned guard is dropped (the end of the worker's work on the transaction, also on an early `continue` or a panic),
+/// and raised at once if it is near the execution thread already. Without the switch the guard does nothing.
+pub fn near_run(tx: usize, run_gen: u32) -> NearRun {
+    // a change back that failed at the end of an earlier run is tried again first
+    if NEAR_SET.with(|c| c.get()) != 0 {
+        near_back();
+    }
+    if NEAR_PRIO.load(Ordering::Relaxed) == 0 {
+        NEAR_TX.with(|c| c.set(u32::MAX));
+        return NearRun(false)
+    }
+    NEAR_TX.with(|c| c.set(tx.min(u32::MAX as usize - 1) as u32));
+    NEAR_RUN_GEN.with(|c| c.set(run_gen));
+    near_check();
+    NearRun(true)
+}
+
+/// Guard of [`near_run`]: when dropped, the run is no longer watched and the worker goes back to its normal policy if it
+/// was raised.
+#[derive(Debug)]
+pub struct NearRun(bool);
+
+impl Drop for NearRun {
+    fn drop(&mut self) {
+        if self.0 {
+            NEAR_TX.with(|c| c.set(u32::MAX));
+            if NEAR_SET.with(|c| c.get()) != 0 {
+                near_back();
+            }
+        }
+    }
+}
+
+/// EXP-199 (`ewnear`): the check of a watched run (the start of the run and each backend read): raise when near, set
+/// back once the execution thread has reached the run's transaction. Other threads return after one thread-local read.
+pub fn near_check() {
+    let tx = NEAR_TX.with(|c| c.get());
+    if tx == u32::MAX {
+        return
+    }
+    let cur_gen = NEAR_GEN.load(Ordering::Relaxed);
+    if NEAR_RUN_GEN.with(|c| c.get()) != cur_gen {
+        // a run from an earlier block: no longer watched (the next block's start resets the execution thread's index)
+        NEAR_TX.with(|c| c.set(u32::MAX));
+        if NEAR_SET.with(|c| c.get()) != 0 {
+            near_back();
+        }
+        return
+    }
+    let prio = NEAR_PRIO.load(Ordering::Relaxed);
+    let (near, caught) = near_state(
+        tx,
+        crate::tree::eap::fs_exec_current(),
+        NEAR_N.load(Ordering::Relaxed),
+        NEAR_KEEP.load(Ordering::Relaxed),
+        NEAR_DONE.load(Ordering::Relaxed) == cur_gen,
+    );
+    let set = NEAR_SET.with(|c| c.get());
+    if set != 0 && (caught || prio == 0) {
+        near_back();
+    } else if set == 0 &&
+        near &&
+        prio > 0 &&
+        NEAR_REFUSED_GEN.with(|c| c.get()) != cur_gen &&
+        (!NEAR_NEEDS_EXRT.load(Ordering::Relaxed) || EX_RT_STATE.load(Ordering::Relaxed) > 0) &&
+        near_raise(prio) <= 0
+    {
+        NEAR_REFUSED_GEN.with(|c| c.set(cur_gen));
+    }
+}
+
+/// EXP-199 (`ewnear`): whether the calling thread runs at a real-time priority by [`near_run`]. A bounded wait for another
+/// thread on such a thread sleeps briefly instead of yielding or spinning ([`near_relax`]).
+pub fn near_on() -> bool {
+    NEAR_SET.with(|c| c.get()) != 0
+}
+
+/// EXP-199 (`ewnear`): one step of a bounded wait for another thread: a real-time thread's `sched_yield` lets only
+/// real-time threads of its priority run, and spinning keeps a normal thread it waits for off a shared core, so a raised
+/// worker sleeps 10 us; otherwise `otherwise` (the wait's usual step: yield or spin).
+pub fn near_relax(otherwise: impl FnOnce()) {
+    if near_on() {
+        std::thread::sleep(std::time::Duration::from_micros(10));
+    } else {
+        otherwise();
+    }
+}
+
+/// EXP-199 (`ewnear`): this thread as SCHED_FIFO at `prio`, reset on fork, remembering its policy and nice value; returns
+/// the priority, 0 for a thread not of a normal class (left alone), or minus the errno of a refused change (counted; the
+/// thread stays as it was). The reset-on-fork flag stays set after going back (clearing it needs CAP_SYS_NICE), so a later
+/// unprivileged policy change of the thread must keep it.
+fn near_raise(prio: u32) -> i64 {
+    let mut a = SchedAttr::default();
+    let size = std::mem::size_of::<SchedAttr>() as u32;
+    let refused = || {
+        NEAR_COUNTS[1].fetch_add(1, Ordering::Relaxed);
+        -i64::from(std::io::Error::last_os_error().raw_os_error().unwrap_or(0))
+    };
+    // SAFETY: as in `apply_exec_slice_us`: pid 0 (the calling thread), a valid sched_attr buffer of `size` bytes.
+    unsafe {
+        if libc::syscall(libc::SYS_sched_getattr, 0, &mut a as *mut SchedAttr, size, 0) != 0 {
+            return refused()
+        }
+        // only a thread of a normal class (other, batch, idle) is raised; going back restores one of these
+        if ![libc::SCHED_OTHER as u32, libc::SCHED_BATCH as u32, libc::SCHED_IDLE as u32].contains(&a.policy) {
+            return 0
+        }
+        let rt = SchedAttr {
+            size,
+            policy: libc::SCHED_FIFO as u32,
+            flags: 1, // SCHED_FLAG_RESET_ON_FORK
+            priority: prio,
+            ..Default::default()
+        };
+        if libc::syscall(libc::SYS_sched_setattr, 0, &rt as *const SchedAttr, 0) != 0 {
+            return refused()
+        }
+    }
+    NEAR_BEFORE.with(|c| c.set((a.policy, a.nice)));
+    NEAR_SET.with(|c| c.set(prio));
+    NEAR_T.with(|c| c.set(Some(std::time::Instant::now())));
+    NEAR_COUNTS[0].fetch_add(1, Ordering::Relaxed);
+    i64::from(prio)
+}
+
+/// EXP-199 (`ewnear`): back to the policy (normal, batch or idle) and nice value the thread had before [`near_raise`],
+/// with the default slice. Lowering needs no privilege. Should the change fail, the thread stays raised and the next
+/// check of the run tries again, or, once the run's guard has dropped, the start of the thread's next run (not counted).
+/// Returns whether it went back.
+fn near_back() -> bool {
+    let (policy, nice) = NEAR_BEFORE.with(|c| c.get());
+    let size = std::mem::size_of::<SchedAttr>() as u32;
+    let normal = [libc::SCHED_BATCH as u32, libc::SCHED_IDLE as u32].contains(&policy);
+    let back = SchedAttr {
+        size,
+        policy: if normal { policy } else { libc::SCHED_OTHER as u32 },
+        flags: 1, // SCHED_FLAG_RESET_ON_FORK
+        nice,
+        ..Default::default()
+    };
+    // SAFETY: as in `apply_exec_slice_us`.
+    if unsafe { libc::syscall(libc::SYS_sched_setattr, 0, &back as *const SchedAttr, 0) } != 0 {
+        return false
+    }
+    NEAR_SET.with(|c| c.set(0));
+    if let Some(t) = NEAR_T.with(|c| c.take()) {
+        NEAR_COUNTS[3].fetch_add(t.elapsed().as_micros() as u64, Ordering::Relaxed);
+    }
+    NEAR_COUNTS[2].fetch_add(1, Ordering::Relaxed);
+    true
+}
+
