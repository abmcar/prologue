+/// EXP-199 (`srboost`, off in the final configuration and not ported): 2.5.1 ended an open state-root boost here; no
+/// boost is ever opened in this port, so there is nothing to end (2.5.1 also did nothing without an open boost).
+pub fn srboost_end() {}
+
+/// Prologue (`srrt=<prio>`, EXP-240 README 28.13: in the last milliseconds of execution the sparse-trie task's thread was
+/// ready but not running 0.5 ms more under Prologue than under stock): the calling thread as SCHED_FIFO at `prio`, reset
+/// on fork, until the returned guard is dropped; then back to the normal policy and nice value it had. Returns `None` when
+/// `prio` is 0; otherwise the guard with the outcome: the priority, 0 for a thread not of a normal class (left alone), or
+/// minus the errno of a refused change (the thread stays as it was and the guard does nothing). Raising needs
+/// RLIMIT_RTPRIO of at least the priority (or CAP_SYS_NICE); lowering needs no privilege.
+///
+/// Once raised, the thread's own I/O priority is best-effort at level 4 until the guard drops, as `exio` does for the
+/// execution thread: without it a `SCHED_FIFO` thread's reads get the real-time class, and mq-deadline dispatches no
+/// best-effort read while a real-time one is queued or in flight (EXP-247 README 8.47), which would hold up the proof
+/// workers' and the readers' reads. [`SrRt::io`] is the outcome of that (the class set, or minus the errno).
+///
+/// While raised it is tracked for `exphys` ([`SR_PHYS`]): from the pin of the execution thread to its change back, it
+/// uses the mechanism's set of the block, without the reserved CPU (`exphys_sr`, `exphys_sr_back`).
+pub fn sr_rt_enter(prio: u32) -> Option<(SrRt, i64)> {
+    if prio == 0 {
+        return None
+    }
+    let mut a = SchedAttr::default();
+    let size = std::mem::size_of::<SchedAttr>() as u32;
+    let refused = || -i64::from(std::io::Error::last_os_error().raw_os_error().unwrap_or(0));
+    // SAFETY: as in `apply_exec_slice_us`: pid 0 (the calling thread), a valid sched_attr buffer of `size` bytes.
+    unsafe {
+        if libc::syscall(libc::SYS_sched_getattr, 0, &mut a as *mut SchedAttr, size, 0) != 0 {
+            return Some((SrRt::default(), refused()))
+        }
+        // only a thread of a normal class (other, batch, idle) is raised; going back restores one of these
+        if ![libc::SCHED_OTHER as u32, libc::SCHED_BATCH as u32, libc::SCHED_IDLE as u32].contains(&a.policy) {
+            return Some((SrRt::default(), 0))
+        }
+        let rt = SchedAttr {
+            size,
+            policy: libc::SCHED_FIFO as u32,
+            flags: 1, // SCHED_FLAG_RESET_ON_FORK
+            priority: prio,
+            ..Default::default()
+        };
+        if libc::syscall(libc::SYS_sched_setattr, 0, &rt as *const SchedAttr, 0) != 0 {
+            return Some((SrRt::default(), refused()))
+        }
+    }
+    let io_before = set_own_io_best_effort();
+    let io = io_before.map_or_else(|err| err, |_| i64::from(IOPRIO_CLASS_BE));
+    // Prologue (`exphys`): tracked while raised, so that it keeps off the core of an execution thread pinned by
+    // `exphys` (moved at once when the pin is in force already).
+    // SAFETY: gettid has no preconditions and only returns the calling thread's id.
+    let sr = sr_phys_join(&SR_PHYS, unsafe { libc::gettid() });
+    if sr != 0 {
+        PHYS.lock().sr = sr;
+    }
+    Some((SrRt { before: Some((a.policy, a.nice)), io_before: io_before.ok(), io }, i64::from(prio)))
+}
+
+/// Guard of [`sr_rt_enter`]: the thread back to the CPU set it had if `exphys` moved it ([`SR_PHYS`]), to the policy and
+/// nice value it had before the raise, and to its own I/O priority, when dropped (also on an early return or a panic);
+/// nothing when the raise did not happen.
+#[derive(Debug, Default)]
+pub struct SrRt {
+    /// The policy and nice value before the raise; `None` when the thread was not raised.
+    before: Option<(u32, i32)>,
+    /// The thread's own I/O priority value before it was set to best-effort; `None` when it was not set.
+    io_before: Option<libc::c_int>,
+    /// The outcome of setting the I/O priority: the class set, minus the errno of a refused change, 0 when not raised.
+    pub io: i64,
+}
+
+impl Drop for SrRt {
+    fn drop(&mut self) {
+        let Some((policy, nice)) = self.before else { return };
+        // SAFETY: gettid has no preconditions and only returns the calling thread's id.
+        sr_phys_leave(&SR_PHYS, unsafe { libc::gettid() });
+        let back = SchedAttr {
+            size: std::mem::size_of::<SchedAttr>() as u32,
+            policy,
+            flags: 1, // SCHED_FLAG_RESET_ON_FORK
+            nice,
+            ..Default::default()
+        };
+        // SAFETY: as in `apply_exec_slice_us`. Going back to a normal class needs no privilege; should it fail, the
+        // thread stays real-time and the next raise leaves it alone (not of a normal class).
+        unsafe { libc::syscall(libc::SYS_sched_setattr, 0, &back as *const SchedAttr, 0) };
+        // with the normal class back, the I/O class follows it again
+        if let Some(before) = self.io_before {
+            restore_own_io(before);
+        }
+    }
+}
+
+/// [`apply_exec_slice`] with the slice given.
+fn apply_exec_slice_us(us: u32) {
+    if SLICE_SET.with(|c| c.get()) == us {
+        return
+    }
+    let mut a = SchedAttr::default();
+    let size = std::mem::size_of::<SchedAttr>() as u32;
+    // SAFETY: sched_getattr / sched_setattr with pid 0 read and change only the calling thread; `a` is a valid buffer of
+    // `size` bytes laid out as the kernel's sched_attr (first version, 48 bytes).
+    unsafe {
+        if libc::syscall(libc::SYS_sched_getattr, 0, &mut a as *mut SchedAttr, size, 0) != 0 {
+            return
+        }
+        if a.policy != libc::SCHED_OTHER as u32 && a.policy != libc::SCHED_BATCH as u32 {
+            return
+        }
+        a.size = size;
+        a.flags = 1; // SCHED_FLAG_RESET_ON_FORK
+        a.runtime = u64::from(us) * 1000;
+        if libc::syscall(libc::SYS_sched_setattr, 0, &a as *const SchedAttr, 0) == 0 {
+            SLICE_SET.with(|c| c.set(us));
+        }
+    }
+}
+
+/// A prewarm thread at the start of its block's work: SCHED_BATCH with the block's `pwbatch`, back to SCHED_OTHER
+/// without it; a thread in another class (SCHED_IDLE helpers) is left alone. Nice is kept (`sched_setscheduler` leaves
+/// it for these classes). One `sched_getscheduler` per call; the class is set only when it differs.
+pub fn prewarm_sched() {
+    if !PW_BATCH_EVER.load(Ordering::Relaxed) {
+        return
+    }
+    prewarm_sched_to(batch_class(PW_BATCH.load(Ordering::Relaxed), false));
+}
+
+/// [`prewarm_sched`] for a reader (EXP-199 `pwbatch=2`: readers stay SCHED_OTHER).
+pub fn reader_sched() {
+    if !PW_BATCH_EVER.load(Ordering::Relaxed) {
+        return
+    }
+    prewarm_sched_to(batch_class(PW_BATCH.load(Ordering::Relaxed), true));
+}
+
+/// Whether a prewarm thread runs as SCHED_BATCH under `pwbatch` = `mode`: 1 every prewarm thread, 2 all but the readers.
+fn batch_class(mode: u8, reader: bool) -> bool {
+    match mode {
+        1 => true,
+        2 => !reader,
+        _ => false,
+    }
+}
+
+/// [`prewarm_sched`] with the class given (`batch`: SCHED_BATCH, else SCHED_OTHER).
+fn prewarm_sched_to(batch: bool) {
+    let want = if batch { libc::SCHED_BATCH } else { libc::SCHED_OTHER };
+    // SAFETY: both calls with pid 0 read or change only the calling thread's policy.
+    unsafe {
+        // the policy comes back with SCHED_RESET_ON_FORK or'ed in when the thread has it; it is kept
+        let raw = libc::sched_getscheduler(0);
+        if raw < 0 {
+            return
+        }
+        let (cur, keep) = (raw & !libc::SCHED_RESET_ON_FORK, raw & libc::SCHED_RESET_ON_FORK);
+        if (cur == libc::SCHED_OTHER || cur == libc::SCHED_BATCH) && cur != want {
+            let p = libc::sched_param { sched_priority: 0 };
+            libc::sched_setscheduler(0, want | keep, &p);
+        }
+    }
+}
+
+/// `ewbud` (EXP-199 round 3): the counted cores of the mechanism. Cores of the execution thread's CPU set at the block's
+/// start; one is the execution thread's; `EW_BUSY` workers are running a pre-execution and `NB_BUSY` helpers a
+/// speculative pass. A core is idle for a speculative pass when the count leaves one free. Other threads of the node
+/// (readers, which mostly wait on the disk, reth's proof workers) are not counted; the helpers run at the speculative
+/// pass's nice value, so the scheduler gives such threads the core first.
+static EW_BUSY: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+static NB_BUSY: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+
+/// Number of CPUs in the execution thread's set at the current block's start (the machine's parallelism before any block).
+pub fn exec_cores() -> usize {
+    let full = CORES.lock().0;
+    // SAFETY: CPU_COUNT only reads the given set.
+    full.map(|s| unsafe { libc::CPU_COUNT(&s) } as usize)
+        .filter(|n| *n > 0)
+        .unwrap_or_else(|| std::thread::available_parallelism().map_or(1, |n| n.get()))
+}
+
+/// Holds one counted core until dropped.
+#[derive(Debug)]
+pub struct BusyGuard(&'static std::sync::atomic::AtomicUsize);
+
+impl Drop for BusyGuard {
+    fn drop(&mut self) {
+        self.0.fetch_sub(1, std::sync::atomic::Ordering::AcqRel);
+    }
+}
+
+/// A worker running a pre-execution (counted while the guard lives).
+pub fn worker_busy() -> BusyGuard {
+    EW_BUSY.fetch_add(1, std::sync::atomic::Ordering::AcqRel);
+    BusyGuard(&EW_BUSY)
+}
+
+/// A core for a speculative pass, when the count leaves one: `cores` (see [`exec_cores`], read once by the caller) - 1
+/// (execution thread) - running workers - running passes >= 0 after taking it. `None`: no idle core now.
+pub fn nb_try_core(cores: usize) -> Option<BusyGuard> {
+    use std::sync::atomic::Ordering::AcqRel;
+    let n = NB_BUSY.fetch_add(1, AcqRel) + 1;
+    let used = 1 + EW_BUSY.load(std::sync::atomic::Ordering::Acquire) + n;
+    if used <= cores {
+        Some(BusyGuard(&NB_BUSY))
+    } else {
+        NB_BUSY.fetch_sub(1, AcqRel);
+        None
+    }
+}
+
+/// `ewbud`: rates learned from the blocks run so far (sums since the node started, no smoothing constant): slots the
+/// pre-execution read from the backend per gas-limit unit; the execution thread's time per unit of the block's gas limits;
+/// a reader's time per backend read.
+static RATE: Mutex<[u128; 6]> = parking_lot::const_mutex([0; 6]);
+
+/// A pre-execution run: backend slot reads and the transaction's gas limit (the rate is per gas-limit unit, the unit
+/// [`late`] and the dispatch order multiply it with).
+pub fn note_run(reads: u64, gas_limit: u64) {
+    let mut g = reth_execution_cache::lkprof::lock(reth_execution_cache::lkprof::RATE, &RATE);
+    g[0] += u128::from(reads);
+    g[1] += u128::from(gas_limit);
+}
+
+/// A block's execution: time from the dispatch's start to the block's end, and the sum of its transactions' gas limits.
+pub fn note_exec(ns: u64, gas_limits: u64) {
+    let mut g = reth_execution_cache::lkprof::lock(reth_execution_cache::lkprof::RATE, &RATE);
+    g[2] += u128::from(ns);
+    g[3] += u128::from(gas_limits);
+}
+
+/// A block's readers: time spent in backend reads and their number.
+pub fn note_reads(ns: u64, n: u64) {
+    let mut g = reth_execution_cache::lkprof::lock(reth_execution_cache::lkprof::RATE, &RATE);
+    g[4] += u128::from(ns);
+    g[5] += u128::from(n);
+}
+
+/// (backend reads per gas-limit unit, execution ns per gas-limit unit, ns per backend read); 0 where nothing was seen yet.
+pub fn rates() -> (f64, f64, f64) {
+    let g = *reth_execution_cache::lkprof::lock(reth_execution_cache::lkprof::RATE, &RATE);
+    let q = |a: u128, b: u128| if b == 0 { 0.0 } else { a as f64 / b as f64 };
+    (q(g[0], g[1]), q(g[2], g[3]), q(g[4], g[5]))
+}
+
+/// `ewbud`: whether a transaction's pre-execution would still be reading when the execution thread arrives: its expected
+/// backend reads (gas limit x reads per gas) at the read time, against the gas limits ahead of it in the block at the
+/// execution thread's time per gas-limit unit. False until the rates have been seen.
+pub fn late(gas_limit: u64, gas_limits_ahead: u64) -> bool {
+    let (rpg, exec, rd) = rates();
+    exec > 0.0 && gas_limit as f64 * rpg * rd > gas_limits_ahead as f64 * exec
+}
+
+/// `ewpool`: a job for a pool thread.
+pub type PoolJob = Box<dyn FnOnce() + Send + 'static>;
+
+/// `ewpool`: counts a block's running pool jobs; the dispatch waits on it where it joined the threads made for the block.
+#[derive(Debug, Default)]
+pub struct EwLatch {
+    n: Mutex<usize>,
+    cv: parking_lot::Condvar,
+}
+
+impl EwLatch {
+    fn add(&self) {
+        *self.n.lock() += 1;
+    }
+
+    fn done(&self) {
+        let mut n = self.n.lock();
+        *n = n.saturating_sub(1);
+        if *n == 0 {
+            self.cv.notify_all();
+        }
+    }
+
+    /// Waits until every job counted here has returned and dropped what it captured.
+    pub fn wait(&self) {
+        let mut n = self.n.lock();
+        while *n > 0 {
+            self.cv.wait(&mut n);
+        }
+    }
+}
+
+/// `ewpool`: persistent threads of one role (`name`, which the CPU accounting by thread name reads), nice value and
+/// scheduling class. An unprivileged thread cannot lower its nice value again (RLIMIT_NICE is 0 on the node), so a thread
+/// keeps the nice value and class it was made with and runs only jobs that set the same ones; each job sets the CPU set
+/// itself ([`leave_exec_core`], every block). A thread is added when no thread of the pool is idle; none is removed.
+struct Pool {
+    name: &'static str,
+    nice: u32,
+    idle_class: bool,
+    tx: crossbeam_channel::Sender<(PoolJob, Option<Arc<EwLatch>>)>,
+    rx: crossbeam_channel::Receiver<(PoolJob, Option<Arc<EwLatch>>)>,
+    /// threads waiting for a job and not yet claimed by a submitter
+    idle: AtomicUsize,
+}
+
+static POOLS: Mutex<Vec<Arc<Pool>>> = parking_lot::const_mutex(Vec::new());
+/// `ewpool`: threads made by the pools so far.
+static POOL_MADE: AtomicU64 = AtomicU64::new(0);
+
+/// `ewpool`: runs `job` on a persistent thread of the role `name` with nice value `nice` (with `idle_class`, in the idle
+/// scheduling class): an idle thread of that pool if one is free, else a new one. With `done`, the job is counted there
+/// until it has returned and dropped everything it captured (the block's cache handles among them), also when it
+/// panics. False if no thread could be made: the job is dropped and `done` does not count it.
+pub fn pool_spawn(name: &'static str, nice: u32, idle_class: bool, done: Option<Arc<EwLatch>>, job: PoolJob) -> bool {
+    let pool = {
+        let mut pools = POOLS.lock();
+        if let Some(p) = pools.iter().find(|p| p.name == name && p.nice == nice && p.idle_class == idle_class) {
+            p.clone()
+        } else {
+            let (tx, rx) = crossbeam_channel::unbounded();
+            let p = Arc::new(Pool { name, nice, idle_class, tx, rx, idle: AtomicUsize::new(0) });
+            pools.push(p.clone());
+            p
+        }
+    };
+    if let Some(d) = &done {
+        d.add();
+    }
+    // an idle thread is claimed before the job is sent, so a sent job always has a thread waiting for it
+    if pool.idle.fetch_update(Ordering::AcqRel, Ordering::Acquire, |n| n.checked_sub(1)).is_ok() {
+        // the pool holds the receiver, so the send does not fail
+        let _ = pool.tx.send((job, done));
+        return true
+    }
+    let i = POOL_MADE.fetch_add(1, Ordering::Relaxed);
+    let (p, d) = (pool.clone(), done.clone());
+    let made = std::thread::Builder::new().name(format!("{name}-{i}")).spawn(move || pool_thread(&p, job, d)).is_ok();
+    if !made {
+        POOL_MADE.fetch_sub(1, Ordering::Relaxed);
+        if let Some(d) = &done {
+            d.done();
+        }
+    }
+    made
+}
+
+/// `ewpool`: threads made by the pools so far (flat once every pool has as many threads as a block uses at once).
+pub fn pool_made() -> u64 {
+    POOL_MADE.load(Ordering::Relaxed)
+}
+
+fn pool_thread(pool: &Pool, first: PoolJob, done: Option<Arc<EwLatch>>) {
+    crate::tree::eap::set_own_nice(pool.nice);
+    if pool.idle_class {
+        crate::tree::eap::set_own_idle();
+    }
+    let mut next = (first, done);
+    loop {
+        let (job, done) = next;
+        crate::tree::eap::job_cpu_start();
+        // the job and its captures are dropped before `done` counts it out, also when it unwinds
+        let ok = std::panic::catch_unwind(std::panic::AssertUnwindSafe(job)).is_ok();
+        // idle again before the waiter can go on, so a job submitted right after the join finds this thread; after a
+        // panic the thread ends, as a thread made for the job would
+        if ok {
+            pool.idle.fetch_add(1, Ordering::AcqRel);
+        }
+        if let Some(d) = done {
+            d.done();
+        }
+        if !ok {
+            return
+        }
+        match pool.rx.recv() {
+            Ok(j) => next = j,
+            Err(_) => return,
+        }
+    }
+}
+
