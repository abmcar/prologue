+    /// Resets the counters and turns recording on or off for the next block.
+    pub fn begin_block(on: bool) {
+        BASE.get_or_init(Instant::now);
+        for s in &STATS {
+            s.store(0, Ordering::Relaxed);
+        }
+        STATS[POST_FIRST_DISPATCH_NS].store(u64::MAX, Ordering::Relaxed);
+        MARK_NS.store(u64::MAX, Ordering::Relaxed);
+        TAIL.store(false, Ordering::Relaxed);
+        BLOCK_NS.store(ns(Instant::now()), Ordering::Relaxed);
+        ON.store(on, Ordering::Release);
+    }
