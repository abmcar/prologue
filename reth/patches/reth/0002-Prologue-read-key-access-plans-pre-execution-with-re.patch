+/// The prewarm workers' inspector for the block being processed, when the block asks for prewarm-worker call-start
+/// prediction or frame recording; `None` keeps the stock prewarm EVM.
+/// EXP-171 cache guard: one line per block when its writes are applied to the execution cache, with the number of cache
+/// fills dropped since the previous block's writes were applied (fills by threads of an earlier block that ran past
+/// it; must be 0, a warning otherwise).
+/// EXP-176 (diagnostic): one line per block with helper threads: the prewarm task's wait for the split helpers and the
+/// dedicated heavy-transaction threads before `FinishedTxExecution` (the joins of the EXP-171 / EXP-174 fixes).
+/// EXP-199 (`iqc`): one `eap iqc` line per block: for each issue source, the slots the readers read, split into
+/// cached at read and used by the execution thread (`cu`), cached and not used (`cn`), read from the backend and used
+/// (`du`), read from the backend and not used (`dn`), and slots issued but never read (`uf`, queued or in flight at the
+/// block's end). "Used" means the execution thread looked the slot up in this block (hit or miss).
+fn iqc_log(block: u64, g: &Issued) {
+    let touched = reth_execution_cache::iqc_take_touched();
+    let mut c = [[0u64; 5]; N_SRC];
+    for (key, (st, src)) in &g.slots {
+        let i = src_index((*src).max(reth_execution_cache::CC_SRC_EAP_TX)).min(N_SRC - 1);
+        let k = if *st != 2 {
+            4
+        } else {
+            let used = touched.contains(key);
+            match (g.iqc_disk.contains(key), used) {
+                (false, true) => 0,
+                (false, false) => 1,
+                (true, true) => 2,
+                (true, false) => 3,
+            }
+        };
+        c[i][k] += 1;
+    }
+    let names = ["tx", "cs0", "cs1", "pw", "sd", "ct", "nb", "pl", "ix"];
+    let mut out = String::new();
+    for (i, n) in names.iter().enumerate().take(N_SRC) {
+        use std::fmt::Write as _;
+        let _ = write!(out, " {n}_cu={} {n}_cn={} {n}_du={} {n}_dn={} {n}_uf={}", c[i][0], c[i][1], c[i][2], c[i][3], c[i][4]);
+    }
+    info!(target: "reth::eap", block, touched = touched.len(), "eap iqc{}", out);
+}
