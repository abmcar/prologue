+/// EXP-160 (`rdnice`, `hvnice`): lowers the calling thread's scheduling priority to nice `n` (raising the nice value needs
+/// no privilege; the thread cannot lower it again, so only threads created for one block use this).
+pub fn set_own_nice(n: u32) {
+    if n > 0 {
+        // SAFETY: setpriority on PRIO_PROCESS with who = 0 changes only the calling thread on Linux.
+        unsafe {
+            libc::setpriority(libc::PRIO_PROCESS, 0, n as libc::c_int);
+        }
+    }
+}
+
+/// EXP-180: the calling thread's nice value (for the pre-check of `pwnbnice`).
+pub fn own_nice() -> i32 {
+    // SAFETY: getpriority on PRIO_PROCESS with who = 0 reads only the calling thread's nice value on Linux.
+    unsafe { libc::getpriority(libc::PRIO_PROCESS, 0) }
+}
