+    #[test]
+    fn stale_readers_and_self_check() {
+        let w = EwWrites::default();
+        let k = (Address::repeat_byte(1), B256::repeat_byte(2));
+        let put = |tx: u32, seq: u32, v: u64| {
+            insert_sorted(w.slots.write().entry(k).or_default(), tx, (seq, U256::from(v)));
+        };
+        // transaction 5 read the parent state; transaction 3 then records a write: 5 is stale
+        assert_eq!(w.register_reads(5, 1, &[(k, 0)]), Some(false));
+        put(3, 1, 7);
+        assert_eq!(w.stale_readers(3, &[k]), vec![5]);
+        // a reader registering after the write finds it itself; one that read that record is not stale
+        assert_eq!(w.register_reads(6, 1, &[(k, 0)]), Some(true));
+        assert_eq!(w.register_reads(7, 1, &[(k, 1)]), Some(false));
+        // a redo of 3 with a new value (new sequence number) makes 7 stale; a writer after 7 never does
+        put(3, 2, 8);
+        assert_eq!(w.stale_readers(3, &[k]), vec![5, 6, 7]);
+        assert_eq!(w.stale_readers(8, &[k]), Vec::<u32>::new());
+        // a later run's registration replaces the old one; an older run's is refused
+        assert_eq!(w.register_reads(7, 2, &[(k, 2)]), Some(false));
+        assert_eq!(w.register_reads(7, 1, &[(k, 0)]), None);
+        assert_eq!(w.readers.lock().0.get(&k).map(|v| v.iter().filter(|(i, _)| *i == 7).count()), Some(1));
+    }
