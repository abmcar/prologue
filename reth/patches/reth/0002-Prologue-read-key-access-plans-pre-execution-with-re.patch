+    #[test]
+    fn warm_queue_is_bounded_fifo_and_refuses_when_full() {
+        let q = WarmQueue::new(3);
+        let a = |i: u8| Address::repeat_byte(i);
+        assert_eq!(q.pop(), None);
+        assert!(q.push(a(1)) && q.push(a(2)) && q.push(a(3)));
+        assert!(!q.push(a(4)));
+        assert_eq!((q.pop(), q.pop()), (Some(a(1)), Some(a(2))));
+        assert!(q.push(a(5)));
+        assert_eq!((q.pop(), q.pop(), q.pop()), (Some(a(3)), Some(a(5)), None));
+        assert!(q.push(a(6)));
+        q.clear();
+        assert_eq!(q.pop(), None);
+    }
