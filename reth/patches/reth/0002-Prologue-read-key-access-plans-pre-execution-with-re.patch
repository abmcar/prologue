+    static ON: AtomicBool = AtomicBool::new(false);
+    static T: [AtomicU64; N] = [const { AtomicU64::new(0) }; N];
+    /// X-031: at each instant reached on the thread that began the block, that thread's CPU time (ns + 1), minor
+    /// faults, voluntary and involuntary switches; 0: not reached there.
+    static C: [AtomicU64; N] = [const { AtomicU64::new(0) }; N];
+    static FLT: [AtomicU64; N] = [const { AtomicU64::new(0) }; N];
+    static VCS: [AtomicU64; N] = [const { AtomicU64::new(0) }; N];
+    static ICS: [AtomicU64; N] = [const { AtomicU64::new(0) }; N];
