+#[cfg(test)]
+mod pl_tests {
+    use super::*;
+
+    /// EXP-235 (`pl`): a recorded read list goes to the readers' channel in first-read order with source 9: accounts as
+    /// `Acct`, codes as `Code`, each run of consecutive slots of one address as one `Keys` item (a later slot of an
+    /// address after another key starts a new item); the keys are counted by kind, and a block without a list counts
+    /// as missing and sends nothing.
+    #[test]
+    fn read_list_becomes_reader_items() {
+        let (a, b) = (Address::with_last_byte(0xa1), Address::with_last_byte(0xb2));
+        let (s1, s2, s3) = (B256::with_last_byte(1), B256::with_last_byte(2), B256::with_last_byte(3));
+        let h = B256::repeat_byte(0xc3);
+        let keys = [
+            PlKey::Account(a),
+            PlKey::Storage(a, s1),
+            PlKey::Storage(a, s2),
+            PlKey::Code(h),
+            PlKey::Storage(b, s3),
+            PlKey::Storage(a, s3),
+            PlKey::Account(b),
+        ];
+        let (tx, rx) = crossbeam_channel::unbounded();
+        let stats = Stats::default();
+        pl_send(&tx, &stats, Some(&keys));
+        let items: Vec<_> = rx.try_iter().collect();
+        let src = reth_execution_cache::CC_SRC_EAP_PL;
+        assert_eq!(src, 9);
+        assert_eq!(items.len(), 6);
+        let keys_of = |it: &Item| match it {
+            Item::Keys(k) => {
+                assert_eq!((k.2, k.3), (u32::MAX, src));
+                Some((k.0, k.1.iter().map(|k| B256::from(*k)).collect::<Vec<_>>()))
+            }
+            _ => None,
+        };
+        assert!(matches!(items[0], Item::Acct(x, s, u32::MAX) if x == a && s == src));
+        assert_eq!(keys_of(&items[1]), Some((a, vec![s1, s2])));
+        assert!(matches!(items[2], Item::Code(x, s) if x == h && s == src));
+        assert_eq!(keys_of(&items[3]), Some((b, vec![s3])));
+        assert_eq!(keys_of(&items[4]), Some((a, vec![s3])));
+        assert!(matches!(items[5], Item::Acct(x, s, u32::MAX) if x == b && s == src));
+        let g = |c: &AtomicU64| c.load(Ordering::Relaxed);
+        assert_eq!((g(&stats.pl_accts), g(&stats.pl_slots), g(&stats.pl_codes), g(&stats.pl_missing_block)), (2, 4, 1, 0));
+        pl_send(&tx, &stats, None);
+        assert!(rx.try_recv().is_err());
+        assert_eq!(g(&stats.pl_missing_block), 1);
+    }
+}
