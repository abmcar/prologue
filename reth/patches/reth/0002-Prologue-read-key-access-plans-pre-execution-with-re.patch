+/// EXP-240 (`srtl`): logs the block's proof-job timeline (`eap srtl`; times in µs after the state-root task's finish
+/// marker, except the summed waits and run times).
+/// EXP-240 (`srmk`): the `eap srmk` line of the block whose root is now known. Times in µs after the marker's send
+/// (-1: not reached); `send_to_now_us` is the time from the send to this call, so the send relative to the end of
+/// execution is the `eap sr` line's `done_after_exec_us` minus it (both taken in [`sr_root_done`]).
+fn srmk_log(block: u64) {
+    use reth_trie_parallel::proof_task::srmk;
+    let s = srmk::snapshot();
+    let after = |i: usize| -> i64 {
+        if s[srmk::SEND_NS] == 0 || s[i] == 0 { -1 } else { (s[i].saturating_sub(s[srmk::SEND_NS]) / 1000) as i64 }
+    };
+    info!(
+        target: "reth::eap",
+        block,
+        sent = s[srmk::SEND_NS] != 0,
+        send_qlen = s[srmk::SEND_QLEN],
+        fwd_us = after(srmk::FWD_NS),
+        fwd_qlen = s[srmk::FWD_QLEN],
+        recv_us = after(srmk::RECV_NS),
+        leave_us = after(srmk::LEAVE_NS),
+        send_to_now_us = srmk::us_since_send().map_or(-1, |v| v as i64),
+        hash_msgs = s[srmk::HASH_MSGS],
+        hash_us = s[srmk::HASH_NS] / 1000,
+        hashed = s[srmk::HASHED],
+        hashed_us = s[srmk::HASHED_NS] / 1000,
+        hints = s[srmk::HINTS],
+        hints_us = s[srmk::HINTS_NS] / 1000,
+        proofs = s[srmk::PROOFS],
+        proofs_us = s[srmk::PROOFS_NS] / 1000,
+        returns = s[srmk::RETURNS],
+        returns_us = s[srmk::RETURNS_NS] / 1000,
+        "eap srmk"
+    );
+}
