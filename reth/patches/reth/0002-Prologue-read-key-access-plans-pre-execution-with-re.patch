diff --git a/crates/engine/execution-cache/src/lkprof.rs b/crates/engine/execution-cache/src/lkprof.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9d14a8b0a29401016c28e610053277bcc3a06023
--- /dev/null
+++ b/crates/engine/execution-cache/src/lkprof.rs
@@ -0,0 +1,169 @@
+//! EXP-210 (`lkprof=1`): contention of the global locks the prewarm threads take. With the switch on, an acquisition
+//! first tries the lock and only when that fails waits for it and records the wait (one count, the time waited, the
+//! longest wait) for the lock's name; with it off, the acquisition is the plain one after one relaxed load. Counting only:
+//! nothing changes which thread gets a lock or when. The counters are taken (and reset) once per block by the execution
+//! thread after the block's execution (`eap lk` line).
+use parking_lot::{Mutex, MutexGuard, RwLock, RwLockReadGuard, RwLockWriteGuard};
+use std::{
+    sync::atomic::{AtomicBool, AtomicU64, Ordering},
+    time::Instant,
+};
+
+/// The profiled locks, by index.
+pub const NAMES: [&str; 14] = [
+    "mode",       // eap.rs MODE (current(): a copy of the mode, 3-4 times per prewarm transaction)
+    "calls",      // eap.rs CALLS (per inner call frame under cnt/pwmin)
+    "rate",       // eap_ew.rs RATE (note_run per transaction of the mechanism)
+    "ew_written", // eap_ew.rs EwWrites::written (record, per transaction)
+    "ew_slots_w", // eap_ew.rs EwWrites::slots, write (record)
+    "ew_slots_r", // eap_ew.rs EwWrites::slots, read (every storage read of the mechanism's workers)
+    "ew_accts",   // eap_ew.rs EwWrites::accounts, read and write
+    "inflight",   // cached_state.rs INF (twice per backend storage read with ewinf; execution-thread misses)
+    "diag",       // cached_state.rs DiagBlock::inner (diagnostics, per prewarm transaction)
+    "reuse",      // reuse.rs SLOTS (store per prewarm transaction with reuse)
+    "ewqueue",    // prewarm.rs EwQueue::inner (push and pop per transaction of the mechanism)
+    "hints",      // prewarm.rs state-root hint slot (per transaction of the mechanism)
+    "cores",      // eap_ew.rs CORES (per thread start of the mechanism)
+    "cache_gen",  // cached_state.rs ExecutionCache gen_lock, read (per fill of the execution cache)
+];
+pub const MODE: usize = 0;
+pub const CALLS: usize = 1;
+pub const RATE: usize = 2;
+pub const EW_WRITTEN: usize = 3;
+pub const EW_SLOTS_W: usize = 4;
+pub const EW_SLOTS_R: usize = 5;
+pub const EW_ACCTS: usize = 6;
+pub const INFLIGHT: usize = 7;
+pub const DIAG: usize = 8;
+pub const REUSE: usize = 9;
+pub const EWQUEUE: usize = 10;
+pub const HINTS: usize = 11;
+pub const CORES: usize = 12;
+pub const CACHE_GEN: usize = 13;
+
+static ON: AtomicBool = AtomicBool::new(false);
+
+/// (contended acquisitions, ns waited, longest wait in ns), one cache line per lock
+#[repr(align(64))]
+struct Ctr([AtomicU64; 3]);
+
+static CTR: [Ctr; NAMES.len()] = [const { Ctr([AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0)]) }; NAMES.len()];
+
+/// Turns the profiling on or off (set per block).
+pub fn enable(on: bool) {
+    ON.store(on, Ordering::Relaxed);
+}
+
+/// Whether the profiling is on for the current block.
+#[inline]
+pub fn on() -> bool {
+    ON.load(Ordering::Relaxed)
+}
+
+#[cold]
+fn note(id: usize, t0: Instant) {
+    let ns = t0.elapsed().as_nanos() as u64;
+    let c = &CTR[id].0;
+    c[0].fetch_add(1, Ordering::Relaxed);
+    c[1].fetch_add(ns, Ordering::Relaxed);
+    c[2].fetch_max(ns, Ordering::Relaxed);
+}
+
+/// Locks `m`, recording a wait under `id` when the profiling is on.
+#[inline]
+pub fn lock<T: ?Sized>(id: usize, m: &Mutex<T>) -> MutexGuard<'_, T> {
+    if on() {
+        if let Some(g) = m.try_lock() {
+            return g
+        }
+        let t0 = Instant::now();
+        let g = m.lock();
+        note(id, t0);
+        g
+    } else {
+        m.lock()
+    }
+}
+
+/// Read-locks `m`, recording a wait under `id` when the profiling is on.
+#[inline]
+pub fn read<T: ?Sized>(id: usize, m: &RwLock<T>) -> RwLockReadGuard<'_, T> {
+    if on() {
+        if let Some(g) = m.try_read() {
+            return g
+        }
+        let t0 = Instant::now();
+        let g = m.read();
+        note(id, t0);
+        g
+    } else {
+        m.read()
+    }
+}
+
+/// Write-locks `m`, recording a wait under `id` when the profiling is on.
+#[inline]
+pub fn write<T: ?Sized>(id: usize, m: &RwLock<T>) -> RwLockWriteGuard<'_, T> {
+    if on() {
+        if let Some(g) = m.try_write() {
+            return g
+        }
+        let t0 = Instant::now();
+        let g = m.write();
+        note(id, t0);
+        g
+    } else {
+        m.write()
+    }
+}
+
+/// The counters since the last call, by lock: (name, contended acquisitions, ns waited, longest wait in ns); resets them.
+pub fn take() -> Vec<(&'static str, [u64; 3])> {
+    NAMES
+        .iter()
+        .zip(CTR.iter())
+        .map(|(n, c)| (*n, [0, 1, 2].map(|i| c.0[i].swap(0, Ordering::Relaxed))))
+        .collect()
+}
+
+/// One line of the block's counters (`name=contended/us waited/longest us`, locks without a contended acquisition left
+/// out).
+pub fn take_line() -> String {
+    use std::fmt::Write as _;
+    let mut s = String::new();
+    for (n, [k, ns, mx]) in take() {
+        if k > 0 {
+            let _ = write!(s, " {n}={k}/{}/{}", ns / 1000, mx / 1000);
+        }
+    }
+    s
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// a wait is recorded only when the switch is on and the lock is held by another thread
+    #[test]
+    fn records_only_contended_waits() {
+        let m = std::sync::Arc::new(Mutex::new(0u32));
+        enable(false);
+        drop(lock(RATE, &m));
+        enable(true);
+        drop(lock(RATE, &m));
+        assert_eq!(take()[RATE].1[0], 0);
+        let g = m.lock();
+        let m2 = m.clone();
+        let h = std::thread::spawn(move || {
+            *lock(RATE, &m2) += 1;
+        });
+        std::thread::sleep(std::time::Duration::from_millis(5));
+        drop(g);
+        h.join().unwrap();
+        let r = take()[RATE].1;
+        assert_eq!(r[0], 1);
+        assert!(r[1] >= 1_000_000 && r[2] == r[1], "{r:?}");
+        enable(false);
+        assert!(take_line().is_empty());
+    }
+}
