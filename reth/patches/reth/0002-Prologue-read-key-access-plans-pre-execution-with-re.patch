+    /// X-027 (coordinator): the prewarm inspector (`eap::EapPwInspector`) decides whether the run's body loaded the
+    /// beneficiary from evm2's transaction overlay (`State::loaded_accounts`). evm2 warms the coinbase (EIP-3651, on
+    /// from Shanghai) in its pre-warmed set without loading it, and credits the fee after the top-level frame ends, so a
+    /// transfer between two other accounts reports "not loaded" (a fee-only beneficiary update), while a body that reads
+    /// the beneficiary's balance or sends it value reports "loaded", as revm's journal did in 2.5.1.
+    #[test]
+    fn prewarm_inspector_sees_only_the_body_loading_the_beneficiary() {
+        let _g = GLOBAL.lock();
+        let _mode = EAP_MODE_TEST.write();
+        crate::tree::eap::set_mode_for_test("tag=1 reuse=2");
+        set_mode(2, 0, false, false, 0, false, 0);
+        let s = Address::repeat_byte(0x11);
+        let probe = Address::repeat_byte(0xc4);
+        let mut parent = funded(&[s]);
+        // PROBE: BALANCE(COINBASE), POP, STOP
+        parent.insert_account_info(&probe, contract(vec![0x41, 0x31, 0x50, 0x00]));
+        parent.insert_account_info(&BEN, AccountInfo { balance: U256::from(7), ..Default::default() });
+        let cfg = EthEvmConfig::mainnet();
+        let n = Bytes::new();
+        let cases: [(TxSpec, u8); 3] = [
+            ((s, 0, Address::repeat_byte(0x99), 1, 21_000, 10, n.clone()), 2),
+            ((s, 0, probe, 0, 100_000, 10, n.clone()), 1),
+            ((s, 0, BEN, 1, 21_000, 10, n.clone()), 1),
+        ];
+        let exec_idx = std::sync::Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        for (spec, want) in cases {
+            let tx = txs_of(&[spec]).remove(0);
+            let env = evm_env(true);
+            let info = crate::tree::eap::BlockInfo::from_block(reth_evm::EvmEnv::block_env(&env));
+            let insp = crate::tree::eap::pw_inspector(&exec_idx, info).expect("reuse needs the prewarm inspector");
+            let mut evm = cfg.evm_with_env(parent.clone(), env);
+            tx_begin();
+            let (_, res) = reth_evm::Evm::transact_with_inspector(&mut evm, &cfg.tx_env(tx), insp).unwrap();
+            assert!(!res.result.is_revert());
+            // the fee credit reached the beneficiary in every case, after the inspector's decision
+            assert!(res.pending_state.account_changes_for(&BEN).is_some());
+            assert_eq!(CB_BODY.with(|c| c.get()), want, "body-loaded flag");
+        }
+        set_mode(0, 0, false, false, 0, false, 0);
+        crate::tree::eap::set_mode_for_test("");
+    }
+
+    /// EXP-179: the reused state of a fee-only beneficiary sends the same state-root update as the execution thread's own
+    /// run, which loads it with its current balance (150 here; the prewarm run loaded the parent block's 100)
+    #[test]
+    fn fee_only_beneficiary_update_equals_own_run() {
+        let ben = Address::repeat_byte(0xbe);
+        let cur = AccountInfo { balance: U256::from(150), ..Default::default() };
+        // zero priority fee: unchanged in both runs, left out of the update
+        let mut st = ben_state(ben, 100, 100);
+        assert!(as_committed(&mut st, ben, Some(cur.clone())));
+        assert_eq!(state_update(&st), state_update(&ben_state(ben, 150, 150)));
+        assert!(state_update(&st).accounts.is_empty());
+        // priority fee 5
+        let mut st = ben_state(ben, 100, 105);
+        assert!(as_committed(&mut st, ben, Some(cur)));
+        assert_eq!(st.account_changes_for(&ben).unwrap().current.unwrap().balance, U256::from(155));
+        assert_eq!(state_update(&st), state_update(&ben_state(ben, 150, 155)));
+        // X-027: an absent beneficiary with a zero fee stays absent; an existing empty one cannot be committed detached
+        let mut st = ben_state(ben, 0, 0);
+        assert!(as_committed(&mut st, ben, None));
+        assert!(state_update(&st).accounts.is_empty());
+        let mut st = ben_state(ben, 0, 0);
+        assert!(!as_committed(&mut st, ben, Some(AccountInfo::default())));
+    }
+
+    /// Safety fix (PORT_X027.md item 1): a maximum cost beyond `U256::MAX` gives no cost at all (the wrapping sum here
+    /// would be 0, which any balance covers); every cost that fits, up to `U256::MAX` itself, equals the wrapping sum
+    /// the code used before, so no decision on such a transaction changes.
+    #[test]
+    fn max_cost_beyond_u256_gives_none() {
+        let (gas, fee) = (21_000u64, 10u128);
+        let base = U256::from(gas) * U256::from(fee);
+        let wraps_to_zero = U256::MAX - base + U256::from(1);
+        assert_eq!(tx_max_cost(gas, fee, wraps_to_zero, 0, 0), None);
+        assert_eq!(tx_max_cost(gas, fee, U256::MAX, 0, 0), None);
+        assert_eq!(tx_max_cost(gas, fee, U256::MAX - base, 1, 1), None);
+        assert_eq!(tx_max_cost(gas, fee, U256::MAX - base, 0, 0), Some(U256::MAX));
+        for (g, f, v, bg, bf) in [
+            (21_000u64, 10u128, U256::from(5), 0u64, 0u128),
+            (30_000_000, 10u128.pow(12), U256::from(10u128.pow(20)), 131_072, 10u128.pow(9)),
+            (u64::MAX, u128::MAX, U256::ZERO, u64::MAX, u128::MAX),
+        ] {
+            let wrapping = U256::from(g) * U256::from(f) + v + U256::from(bg) * U256::from(bf);
+            assert_eq!(tx_max_cost(g, f, v, bg, bf), Some(wrapping));
+        }
+    }
