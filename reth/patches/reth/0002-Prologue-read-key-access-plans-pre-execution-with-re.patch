+/// Prologue (`xbtl=1`, EXP-258): the execution thread's instants of one block, from `validate_block_with_state`'s start
+/// to the root, and the `eap xbtl` line with them in µs after the start (-1: not reached). Only the execution thread
+/// writes them, one block at a time; off, every call is one relaxed load.
+pub mod xbtl {
+    use std::{
+        sync::{
+            atomic::{AtomicBool, AtomicU64, Ordering},
+            OnceLock,
+        },
+        time::Instant,
+    };
+    use tracing::info;
+
+    /// `validate_block_with_state` starts (before the previous block's readers are joined).
+    pub const VAL: usize = 0;
+    /// The previous block's readers are joined (`late_join`).
+    pub const JOINED: usize = 1;
+    /// The parent header is known and the payload's conversion is spawned.
+    pub const PARENT: usize = 2;
+    /// The state-root job is prepared (`state_root_strategy.prepare`, its streams taken).
+    pub const SRJOB: usize = 3;
+    /// `spawn_payload_processor` returned (reth's prewarm and Prologue's pre-execution started).
+    pub const SPAWNED: usize = 4;
+    /// Just before `execute_block` (providers and the execution cache set up).
+    pub const PRE_EXEC: usize = 5;
+    /// `BlockPrefetch::start` begins (the readers' dispatch).
+    pub const PF_START: usize = 6;
+    /// `BlockPrefetch::start` returned.
+    pub const PF_RET: usize = 7;
+    /// The execution timer starts (`execution_start`).
+    pub const EXEC: usize = 8;
+    /// The execution timer stops.
+    pub const EXEC_END: usize = 9;
+    /// The readers are dropped (`drop(eap_prefetch)`: stop, hand-off or join, block-end statistics, the `eap block` line).
+    pub const DROPPED: usize = 10;
+    /// `execute_block` returned to `validate_block_with_state`.
+    pub const RET: usize = 11;
+    /// The block-end calls after execution are done (`exphys`, `plrec`, `srdiag`, `excore`, `ewnear`, state-provider
+    /// metrics), just before the caching task is terminated.
+    pub const HOOKS: usize = 12;
+    /// The caching task is terminated (`terminate_caching`) and the hashed post state's computation is spawned.
+    pub const TERM: usize = 13;
+    /// The receipts root is received (`wait_receipt_root`).
+    pub const RCPT: usize = 14;
+    /// The post-execution checks are done (`validate_post_execution`).
+    pub const POST: usize = 15;
+    /// The root wait starts (`root_start`).
+    pub const ROOT_START: usize = 16;
+    /// The root is known (`state_root_job.finish` returned).
+    pub const ROOT_DONE: usize = 17;
+    /// Number of instants.
+    pub const N: usize = 18;
+    /// Names in the `eap xbtl` line, in index order.
+    pub const NAMES: [&str; N] = [
+        "val", "joined", "parent", "srjob", "spawned", "pre_exec", "pf_start", "pf_ret", "exec", "exec_end", "dropped",
+        "ret", "hooks", "term", "rcpt", "post", "root_start", "root_done",
+    ];
+
+    static ON: AtomicBool = AtomicBool::new(false);
+    static BASE: OnceLock<Instant> = OnceLock::new();
+    /// ns after [`BASE`] + 1 (0: not reached).
+    static T: [AtomicU64; N] = [const { AtomicU64::new(0) }; N];
+
+    fn now_ns() -> u64 {
+        Instant::now().duration_since(*BASE.get_or_init(Instant::now)).as_nanos() as u64 + 1
+    }
+
+    /// Starts the block's record when `on` (clears the previous block's instants) and marks [`VAL`].
+    pub fn begin(on: bool) {
+        if on {
+            for t in &T {
+                t.store(0, Ordering::Relaxed);
+            }
+            T[VAL].store(now_ns(), Ordering::Relaxed);
+        }
+        ON.store(on, Ordering::Relaxed);
+    }
+
+    /// Whether the current block records.
+    #[inline]
+    pub fn on() -> bool {
+        ON.load(Ordering::Relaxed)
+    }
+
+    /// The block reaches instant `i` (the first time counts).
+    #[inline]
+    pub fn mark(i: usize) {
+        if on() && T[i].load(Ordering::Relaxed) == 0 {
+            T[i].store(now_ns(), Ordering::Relaxed);
+        }
+    }
+
+    /// The instants in µs after [`VAL`], -1 for those not reached (all -1 when the block did not record).
+    pub fn snapshot() -> [i64; N] {
+        let v0 = T[VAL].load(Ordering::Relaxed);
+        core::array::from_fn(|i| rel_us(v0, T[i].load(Ordering::Relaxed)))
+    }
+
+    /// µs of stored instant `v` after the start `v0` (both ns + 1, 0 = not reached); -1 when either is missing or `v`
+    /// is before the start.
+    pub(crate) const fn rel_us(v0: u64, v: u64) -> i64 {
+        if v0 == 0 || v == 0 || v < v0 {
+            -1
+        } else {
+            ((v - v0) / 1000) as i64
+        }
+    }
+
+    /// The `eap xbtl` line of block `block` (when it recorded); recording stops until the next [`begin`].
+    pub fn log(block: u64) {
+        if !on() {
+            return
+        }
+        let v = snapshot();
+        let mut line = format!("eap xbtl block={block}");
+        for (name, us) in NAMES.iter().zip(v) {
+            line.push_str(&format!(" {name}_us={us}"));
+        }
+        info!(target: "reth::eap", "{line}");
+        ON.store(false, Ordering::Relaxed);
+    }
+}
