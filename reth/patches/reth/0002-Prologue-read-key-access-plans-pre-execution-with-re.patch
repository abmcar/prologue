+/// EXP-199 (`ew`): the block's dispatch of EAP's own prewarm mechanism: workers (reserved), transactions queued, heavy
+/// among them and skipped at dispatch, time from the dispatch start to the last queued transaction, the join of the
+/// workers, with `ewov` the reads answered from the block's writes (slots, accounts) and the transactions recorded, and
+/// with `ewredo` the transactions found stale and not redone (over the limit or passed), the redo runs queued and those
+/// started (a queued redo the execution thread passes before a worker takes it is dropped), and where redos are queued
+/// (`ewredoq`).
+#[expect(clippy::too_many_arguments)]
+pub fn ew_block_log(
+    block: u64,
+    threads: u32,
+    reserved: u32,
+    txs: [u32; 3],
+    dispatch_us: u64,
+    join_us: u64,
+    ov: [u64; 6],
+    redo_q: u32,
+) {
+    eap_info!(
+        target: "reth::eap",
+        block,
+        threads,
+        reserved,
+        queued = txs[0],
+        heavy = txs[1],
+        skipped = txs[2],
+        dispatch_us,
+        join_us,
+        ov_slot_reads = ov[0],
+        ov_acct_reads = ov[1],
+        ov_txs = ov[2],
+        redo_skipped = ov[3],
+        redo_runs = ov[4],
+        redo_started = ov[5],
+        redoq = redo_q,
+        "eap ew block"
+    );
+}
