+    /// EXP-199 (`ewov`): entries found that read the block's earlier prewarm writes (full check), and of them valid
+    full_found: AtomicU64,
+    full_valid: AtomicU64,
+    /// EXP-206 (`reusebal`): accounts accepted with their balance change applied as an increment, and the valid results
+    /// that needed at least one
+    bal_relaxed: AtomicU64,
+    bal_valid: AtomicU64,
+    /// `reusebalsend`: of the accounts accepted, those the run observed (only by sending value out of them), which only
+    /// that switch accepts
+    bal_send: AtomicU64,
+    /// EXP-215 (`reusechkbg`, EXP-190 with EXP-191 v2's log): background checks submitted, found different, that could
+    /// not run (or timed out), and the block's wait for them at its end
+    bg_checks: AtomicU64,
+    bg_diff: AtomicU64,
+    bg_err: AtomicU64,
+    bg_wait_ns: AtomicU64,
+    /// processor time of the background check threads on this block's checks
+    bg_cpu_ns: AtomicU64,
+    /// the execution thread's ready-queue time (schedstat run_delay) at [`begin_exec`], for its time in the block
+    exec_runq0_ns: AtomicU64,
+    /// commits appended to the block's log by the execution thread and its time doing it
+    log_n: AtomicU64,
+    log_ns: AtomicU64,
+}
