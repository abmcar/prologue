+        assert!(pw_keccak_take(3).is_empty());
+        pw_keccak_hook(&[1; 64]);
+        assert!(pw_keccak_take(4).is_empty(), "inputs of transaction 3 are not handed to transaction 4");
+        pw_keccak_hook(&[1; 64]);
