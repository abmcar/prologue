+/// EXP-129: bounded wait of the non-blocking pass for handed-out slots, in nanoseconds (0 = none).
+pub fn nb_wait_ns() -> u64 {
+    let m = current();
+    if m.active && m.pwnb { m.pwnbwait * 1000 } else { 0 }
+}
+
+/// EXP-129: whether the branch history is built by the post-block history pass of the helper thread (`pwnbbh=1`).
+pub fn nb_bh() -> bool {
+    let m = current();
+    m.active && m.pwnb && m.pwnbsep && m.pwnbbh
