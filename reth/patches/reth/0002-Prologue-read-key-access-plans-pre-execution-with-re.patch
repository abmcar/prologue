+    /// Safety fix (PORT_X027.md item 1): with reuse on (`reuse=2`), a transaction whose gas limit times gas price plus
+    /// value exceeds `U256::MAX` is given back for the usual execution instead of being reused, and is counted as
+    /// failure kind 6 (balance does not cover the maximum cost), whether or not a prewarm-style run left a result.
+    #[test]
+    fn overflowing_max_cost_is_not_reused() {
+        let _g = GLOBAL.lock();
+        let s = Address::repeat_byte(0x31);
+        let parent = funded(&[s]);
+        let (gas, price) = (21_000u64, 10u128);
+        let value = U256::MAX - U256::from(gas) * U256::from(price) + U256::from(1);
+        let tx = Recovered::new_unchecked(
+            TransactionSigned::new_unhashed(
+                Transaction::Legacy(TxLegacy {
+                    chain_id: Some(1),
+                    nonce: 0,
+                    gas_price: price,
+                    gas_limit: gas,
+                    to: TxKind::Call(Address::repeat_byte(0x99)),
+                    value,
+                    input: Bytes::new(),
+                }),
+                Signature::test_signature(),
+            ),
+            s,
+        );
+        let cfg = EthEvmConfig::mainnet();
+        let block = B256::repeat_byte(0xb1);
+        set_mode(2, 0, true, true, 0, false, 0);
+        begin_exec(block);
+        TRIPPED.store(false, Ordering::Relaxed);
+        // the prewarm threads' kind of run (no nonce or balance check), stored when it gives a result
+        let mut evm = cfg.evm_with_env(parent.clone(), evm_env(true));
+        tx_begin();
+        let insp = ObsInspector { record: true, ..Default::default() };
+        if let Ok((_, res)) = reth_evm::Evm::transact_with_inspector(&mut evm, &cfg.tx_env(tx.clone()), insp) {
+            store_checked(block, 0, &res, false, 0);
+        }
+        let evm = cfg.evm_with_env(parent.clone(), evm_env(false));
+        let mut ex = cfg.block_executor_factory().create_executor(evm, ctx());
+        ex.apply_pre_execution_changes().unwrap();
+        let reused = STATS.reused.load(Ordering::Relaxed);
+        let short = STATS.fail[6].load(Ordering::Relaxed);
+        let back = run_tx(&mut ex, &cfg, block, 1, BEN, 0, tx).unwrap();
+        assert!(back.is_some(), "a maximum cost beyond U256::MAX is not reused");
+        assert_eq!(STATS.reused.load(Ordering::Relaxed), reused);
+        assert!(STATS.fail[6].load(Ordering::Relaxed) > short);
+        finish_exec(1, 1);
+        set_mode(0, 0, false, false, 0, false, 0);
+    }
+
+    /// Prologue (`reusefb`): the fallback applies only with the switch and reuse on for the block, to the block whose
+    /// execution `begin_exec` started last, and only when that execution committed a reused result; then it returns
+    /// the count once and drops the block's remaining results, keeping other blocks'. Otherwise nothing is dropped.
+    /// `fallback_pending` tells the same without taking anything.
+    #[test]
+    fn fallback_takes_only_this_blocks_reused_results() {
+        let _g = GLOBAL.lock();
+        let _mode = EAP_MODE_TEST.write();
+        let (block, other) = (B256::repeat_byte(0xf1), B256::repeat_byte(0xf2));
+        let entry = || {
+            Box::new(Entry {
+                state: PendingState::default(),
+                result: Box::new(()),
+                touched: Vec::new(),
+                fee_only: false,
+                full_check: false,
+                run: 0,
+                bal_obs: None,
+            })
+        };
+        crate::tree::eap::set_mode_for_test("tag=1 reuse=2 reusefb=1");
+        set_mode(2, 0, false, false, 0, false, 0);
+        begin_exec(block);
+        assert_eq!(fallback_reused(block), None, "nothing reused");
+        STATS.reused.store(2, Ordering::Relaxed);
+        SLOTS.lock().extend([((block, 3), entry()), ((other, 3), entry())]);
+        assert_eq!(fallback_reused(other), None, "another block's counters");
+        crate::tree::eap::set_mode_for_test("tag=1 reuse=2");
+        assert_eq!(fallback_reused(block), None, "switch off");
+        crate::tree::eap::set_mode_for_test("tag=1 reuse=2 reusefb=1");
+        set_mode(0, 0, false, false, 0, false, 0);
+        assert_eq!(fallback_reused(block), None, "reuse off for the block");
+        assert!(SLOTS.lock().contains_key(&(block, 3)), "nothing dropped without a fallback");
+        set_mode(2, 0, false, false, 0, false, 0);
+        assert!(fallback_pending(block) && !fallback_pending(other));
+        assert!(SLOTS.lock().contains_key(&(block, 3)), "nothing dropped by the check");
+        assert_eq!(fallback_reused(block), Some(2));
+        let kept: Vec<_> = SLOTS.lock().keys().copied().collect();
+        assert_eq!(kept, vec![(other, 3)], "the block's remaining results dropped, another block's kept");
+        assert!(!fallback_pending(block), "taken");
+        assert_eq!(fallback_reused(block), None, "taken once");
+        SLOTS.lock().clear();
+        set_mode(0, 0, false, false, 0, false, 0);
+        crate::tree::eap::set_mode_for_test("");
+    }
