+    fn now_ns() -> u64 {
+        static BASE: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();
+        std::time::Instant::now().duration_since(*BASE.get_or_init(std::time::Instant::now)).as_nanos() as u64 + 1
+    }
+
+    /// At validate_block_with_state's start: clears the instants and records the start when `on`.
+    pub fn begin(on: bool) {
+        if on {
+            for t in T.iter().chain(&C) {
+                t.store(0, Ordering::Relaxed);
+            }
+            // the start's time first, as before the usage was added: xbtl2's instants share xbtl's start within a few
+            // nanoseconds, and the usage's two system calls fall inside the first segment
+            T[VAL].store(now_ns(), Ordering::Relaxed);
+            OWNER.store(my_id(), Ordering::Relaxed);
+            record_usage(VAL);
+            // X-031: the execution thread's precompile-cache counts start with the block
+            let _ = reth_evm::precompile_cache::take_thread_counts();
+            for a in &super::EW_SUM {
