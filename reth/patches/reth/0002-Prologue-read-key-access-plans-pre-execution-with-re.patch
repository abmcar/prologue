+
+/// Prologue (`spin`, X-031 diagnostic, Master 11-13): the resident spin threads' shared state: (generation, threads that
+/// spin this block, CPU µs each).
+static SPIN: (std::sync::Mutex<(u64, u32, u32, u32)>, std::sync::Condvar) = (std::sync::Mutex::new((0, 0, 0, 0)), std::sync::Condvar::new());
+static SPIN_THREADS: AtomicUsize = AtomicUsize::new(0);
+
+/// Prologue (`spin=N spinus=U`, X-031 diagnostic): at a block's start (after the reservation), wakes `n` resident threads
+/// (`eap-spin-#`, created on first use), each spending about `us` µs of its own CPU time in 50 µs busy slices separated by
+/// 50 µs sleeps, ending at most 60 ms after the block's start. They move off the reserved execution core as a reader
+/// does. `n = 0`: nothing (threads already created stay asleep).
+pub fn spin_block(n: u32, us: u32, win: u32) {
+    if n == 0 {
+        return
+    }
+    while SPIN_THREADS.load(Ordering::Relaxed) < n as usize {
+        let i = SPIN_THREADS.fetch_add(1, Ordering::Relaxed);
+        let _ = std::thread::Builder::new().name(format!("eap-spin-{i}")).spawn(move || spin_loop(i as u32));
+    }
+    let mut g = SPIN.0.lock().unwrap_or_else(|e| e.into_inner());
+    *g = (g.0 + 1, n, us, win);
+    SPIN.1.notify_all();
+}
+
+fn thread_cpu_ns() -> u64 {
+    let mut ts = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    // SAFETY: clock_gettime writes the given timespec only.
+    unsafe { libc::clock_gettime(libc::CLOCK_THREAD_CPUTIME_ID, &mut ts) };
+    ts.tv_sec as u64 * 1_000_000_000 + ts.tv_nsec as u64
+}
+
+fn spin_loop(i: u32) {
+    let mut seen = 0u64;
+    loop {
+        let (n, us, win) = {
+            let mut g = SPIN.0.lock().unwrap_or_else(|e| e.into_inner());
+            while g.0 == seen {
+                g = SPIN.1.wait(g).unwrap_or_else(|e| e.into_inner());
+            }
+            seen = g.0;
+            (g.1, g.2, g.3)
+        };
+        if i >= n {
+            continue
+        }
+        leave_exec_core_reader();
+        let start = std::time::Instant::now();
+        let c0 = thread_cpu_ns();
+        let want = u64::from(us) * 1000;
+        // Prologue (`spinwin`): the slices spread over the window; without it 50 µs busy, 50 µs asleep within 60 ms
+        let (rest_us, end) = if win > 0 && us > 0 {
+            let slices = (u64::from(us) / 50).max(1);
+            ((u64::from(win) / slices).saturating_sub(50), std::time::Duration::from_micros(u64::from(win) + 10_000))
+        } else {
+            (50, std::time::Duration::from_millis(60))
+        };
+        while thread_cpu_ns().saturating_sub(c0) < want && start.elapsed() < end {
+            let s = std::time::Instant::now();
+            while s.elapsed() < std::time::Duration::from_micros(50) {
+                std::hint::spin_loop();
+            }
+            if rest_us > 0 {
+                std::thread::sleep(std::time::Duration::from_micros(rest_us));
+            }
+        }
+    }
+}
diff --git a/crates/engine/tree/src/tree/eap_probe.rs b/crates/engine/tree/src/tree/eap_probe.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cb79a6c67fcdb06bdc0d384b356bdf8e19065d98
--- /dev/null
+++ b/crates/engine/tree/src/tree/eap_probe.rs
@@ -0,0 +1,65 @@
+//! EngineAccessPlan research prototype: a provider wrapper placed below the execution cache on the
+//! execution thread, so every storage read that reaches it is an execution-cache miss. Each miss is
+//! classified against the slots the access-plan readers predicted for this block (see `eap.rs`).
+//!
+//! X-027 (reth 2.9.0): the execution thread's provider implements only `EvmStateProvider`, so the wrapper does too
+//! (2.5.1 also forwarded the state-root, proof and hashed-state traits, which the execution thread never calls).
+
+use alloy_primitives::{Address, StorageKey, StorageValue, B256};
+use reth_errors::ProviderResult;
+use reth_primitives_traits::{Account, Bytecode};
+use reth_provider::EvmStateProvider;
+
+/// Execution-thread provider wrapper that classifies storage misses.
+#[derive(Debug)]
+pub struct EapProbe<S>(pub S);
+
+impl<S: EvmStateProvider> EvmStateProvider for EapProbe<S> {
+    fn basic_account(&self, address: &Address) -> ProviderResult<Option<Account>> {
+        self.0.basic_account(address)
+    }
+
+    fn block_hash(&self, number: alloy_primitives::BlockNumber) -> ProviderResult<Option<B256>> {
+        self.0.block_hash(number)
+    }
+
+    fn bytecode_by_hash(&self, code_hash: &B256) -> ProviderResult<Option<Bytecode>> {
+        self.0.bytecode_by_hash(code_hash)
+    }
+
+    fn storage(
+        &self,
+        account: Address,
+        storage_key: StorageKey,
+    ) -> ProviderResult<Option<StorageValue>> {
+        crate::tree::eap::probe_storage_miss(account, storage_key);
+        self.0.storage(account, storage_key)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use alloy_primitives::U256;
+    use reth_provider::{
+        test_utils::{ExtendedAccount, MockEthProvider},
+        StateProvider,
+    };
+
+    /// The wrapper answers every read from the wrapped provider (a storage read is also reported to the probe, which
+    /// does nothing outside a block).
+    #[test]
+    fn probe_forwards_reads() {
+        let (address, key) = (Address::repeat_byte(1), StorageKey::repeat_byte(2));
+        let provider = MockEthProvider::default();
+        provider.extend_accounts(vec![(
+            address,
+            ExtendedAccount::new(3, U256::from(4)).extend_storage(vec![(key, U256::from(5))]),
+        )]);
+        let probe = EapProbe(provider.into_evm_state_provider());
+        assert_eq!(probe.storage(address, key).unwrap(), Some(U256::from(5)));
+        assert_eq!(probe.storage(address, StorageKey::repeat_byte(9)).unwrap(), None);
+        assert_eq!(probe.basic_account(&address).unwrap().map(|a| a.nonce), Some(3));
+        assert_eq!(probe.bytecode_by_hash(&B256::repeat_byte(7)).unwrap(), None);
+    }
+}
