+    /// Prologue (`reusediag`), end to end with `reusebal` on: W sends its caller the amount in the calldata. s1 pays W 50
+    /// wei; s2 and s3 take 80 and 90 wei out of W, whose runs read it at 100 while it then holds 150 and 70; s4 pays C 7
+    /// wei; K stores BALANCE(C); s6 pays W 1 wei. With recorded runs, transaction 1's run observed W only by sending
+    /// value, and 150 covers the 80 it sent (`2,y`; counted once, though the instruction and the call both observe it),
+    /// transaction 2's 90 is not covered by 70 (`2,n`), transaction 4's run read C (`1,-`): all three are executed, with
+    /// the full and with the restricted check, while s6's run, which did not observe W, is reused with W's balance as an
+    /// increment. With unrecorded runs every observation is `-` and no balance change is accepted. Every case gives the
+    /// block without reuse.
+    #[test]
+    fn reusediag_records_how_the_balance_was_observed() {
+        let _g = GLOBAL.lock();
+        let (s1, s2, s3) = (Address::repeat_byte(0x11), Address::repeat_byte(0x22), Address::repeat_byte(0x23));
+        let (s4, s5, s6) = (Address::repeat_byte(0x24), Address::repeat_byte(0x25), Address::repeat_byte(0x26));
+        let (w, c, k) = (Address::repeat_byte(0x77), Address::repeat_byte(0x33), Address::repeat_byte(0x55));
+        let mut parent = funded(&[s1, s2, s3, s4, s5, s6]);
+        // W: CALL(GAS, CALLER, CALLDATALOAD(0), 0, 0, 0, 0), POP, STOP
+        let w_code = vec![0x60, 0x00, 0x60, 0x00, 0x60, 0x00, 0x60, 0x00, 0x60, 0x00, 0x35, 0x33, 0x5a, 0xf1, 0x50, 0x00];
+        parent.insert_account_info(&w, AccountInfo { balance: U256::from(100), ..contract(w_code) });
+        parent.insert_account_info(&c, AccountInfo { balance: U256::from(1000), nonce: 1, ..Default::default() });
+        // K: PUSH20 C, BALANCE, PUSH1 0, SSTORE, STOP
+        parent.insert_account_info(&k, contract([vec![0x73], c.to_vec(), vec![0x31, 0x60, 0x00, 0x55, 0x00]].concat()));
+        let amount = |v: u64| Bytes::from(U256::from(v).to_be_bytes::<32>());
+        let n = Bytes::new();
+        let spec: Vec<TxSpec> = vec![
+            (s1, 0, w, 50, 100_000, 10, n.clone()),
+            (s2, 0, w, 0, 100_000, 10, amount(80)),
+            (s3, 0, w, 0, 100_000, 10, amount(90)),
+            (s4, 0, c, 7, 21_000, 10, n.clone()),
+            (s5, 0, k, 0, 100_000, 10, n.clone()),
+            (s6, 0, w, 1, 100_000, 10, n),
+        ];
+        let reference = run_block(&parent, &spec, 0, 0, true, false, 0x70, true);
+        // W paid s2 80 wei and could not pay s3 90: 100 + 50 - 80 + 1
+        let w_balance = reference.bundle.state.get(&w).and_then(|x| x.info.as_ref()).map(|x| x.balance);
+        assert_eq!(w_balance, Some(U256::from(71)));
+        let (w, c) = (format!("{w:#x}"), format!("{c:#x}"));
+        set_diag(true);
+        for (tag, fast) in [(0x71, true), (0x72, false)] {
+            let o = run_block(&parent, &spec, 2, 0, fast, true, tag, true);
+            assert_eq!((o.bundle, o.receipts), (reference.bundle.clone(), reference.receipts.clone()), "fast {fast}");
+            assert_eq!((o.counts[0], o.counts[1]), (3, 1), "fast {fast}: s6's result reused with W's balance moved");
+            let want = format!("1,3,0,1,1,0,2,y,{w};2,3,1,0,1,0,2,n,{w};4,3,3,1,1,0,1,-,{c}");
+            assert_eq!(diag_items(&DIAG.lock().items), want, "fast {fast}");
+        }
+        let o = run_block(&parent, &spec, 2, 0, true, true, 0x73, false);
+        set_diag(false);
+        assert_eq!((o.bundle, o.receipts), (reference.bundle, reference.receipts));
+        assert_eq!((o.counts[0], o.counts[1]), (2, 0), "unrecorded runs: no balance change accepted");
+        let want = format!("1,3,0,1,1,0,-,-,{w};2,3,1,0,1,0,-,-,{w};4,3,3,1,1,0,-,-,{c};5,3,1,0,1,0,-,-,{w}");
+        assert_eq!(diag_items(&DIAG.lock().items), want);
+    }
+
+    /// `reusebalsend` on while it lives; dropped also when a test fails, so that the other tests run with it off
+    struct BalSendOn;
+
+    impl BalSendOn {
+        fn new() -> Self {
+            set_bal_send(true);
+            Self
+        }
+    }
+
+    impl Drop for BalSendOn {
+        fn drop(&mut self) {
+            set_bal_send(false);
+        }
+    }
+
+    /// A contract that, called with value, only receives it; otherwise it sends `sink` the amount in its calldata's
+    /// first word, calls the address in the second word without value, and sends `sink` the amount in the third word
+    /// ([`sends`]). A call that fails does not stop it.
+    fn sender_code(sink: Address) -> Vec<u8> {
+        // CALL(GAS, to, value, 0, 0, 0, 0), POP, with `value` and `to` as the code that pushes them
+        let call = |value: Vec<u8>, to: Vec<u8>| {
+            [vec![0x5f, 0x5f, 0x5f, 0x5f], value, to, vec![0x5a, 0xf1, 0x50]].concat()
+        };
+        // PUSH1 offset, CALLDATALOAD
+        let word = |offset: u8| vec![0x60, offset, 0x35];
+        let to_sink = [vec![0x73], sink.to_vec()].concat();
+        // CALLVALUE, PUSH1 <receive>, JUMPI, the three calls, STOP, receive: JUMPDEST, STOP
+        let mut code = [
+            vec![0x34, 0x60, 0x00, 0x57],
+            call(word(0), to_sink.clone()),
+            call(vec![0x5f], word(0x20)),
+            call(word(0x40), to_sink),
+            vec![0x00, 0x5b, 0x00],
+        ]
+        .concat();
+        code[2] = u8::try_from(code.len() - 2).unwrap();
+        code
+    }
+
+    /// The calldata of [`sender_code`]: send `first`, call `to`, send `second`.
+    fn sends(first: u64, to: Address, second: u64) -> Bytes {
+        let word = |x: u64| U256::from(x).to_be_bytes::<32>();
+        [word(first), to.into_word().0, word(second)].concat().into()
+    }
+
+    /// F: CALL(GAS, CALLER, 100, 0, 0, 0, 0), POP, STOP: sends its caller 100 wei.
+    const PAYS_CALLER_100: [u8; 11] = [0x5f, 0x5f, 0x5f, 0x5f, 0x60, 0x64, 0x33, 0x5a, 0xf1, 0x50, 0x00];
+
+    /// Prologue (`reusebalsend`): the rule case by case, with `reusebal` on, for an account that read 5 and holds 7
+    /// (`d` = 2) or 3 (`d` = -2) now: observed only by sending value, every transfer succeeded and the least balance
+    /// one left covers a decrease (2 covers 2, 1 does not); not after a failed transfer, not when the balance was read,
+    /// not with the switch off (as without it). The other conditions of `reusebal` still apply, and an unobserved
+    /// account is decided as without the switch.
+    #[test]
+    fn balance_sent_only_rule() {
+        let _g = GLOBAL.lock();
+        let (a, sender, ben) = (Address::repeat_byte(0xaa), Address::repeat_byte(0x11), Address::repeat_byte(0xbe));
+        let info = |b: u64, n: u64| Some(AccountInfo { balance: U256::from(b), nonce: n, ..Default::default() });
+        let mut st = PendingState::default();
+        for x in [a, sender, ben] {
+            st.insert_account(x, info(5, 1), info(5, 1));
+        }
+        let entry = |obs: Option<AddressMap<BalObs>>| Entry {
+            state: st.clone(),
+            result: Box::new(()),
+            touched: Vec::new(),
+            fee_only: false,
+            full_check: false,
+            run: 0,
+            bal_obs: obs,
+        };
+        // the run observed `a`, the sender and the beneficiary by `bits`; its transfers left at least `min_slack`
+        let seen = |bits, min_slack: Option<u64>| {
+            let o = BalObs { bits, sent: U256::from(9), min_slack: min_slack.map(U256::from) };
+            Some(AddressMap::from_iter([a, sender, ben].map(|x| (x, o))))
+        };
+        let relax = |e: &Entry, x: Address, cur: Option<AccountInfo>, exp: Option<AccountInfo>| {
+            bal_relax(e, &e.state.account_changes_for(&x).unwrap(), cur.as_ref(), exp.as_ref(), sender, ben)
+        };
+        let sent = entry(seen(BalObs::SENT, Some(2)));
+        set_mode(2, 0, true, true, 0, false, 0);
+        assert!(relax(&sent, a, info(7, 1), info(5, 1)).is_none(), "switch off, d = 2");
+        assert!(relax(&sent, a, info(3, 1), info(5, 1)).is_none(), "switch off, d = -2");
+        let _on = BalSendOn::new();
+        assert_eq!(relax(&sent, a, info(7, 1), info(5, 1)), Some((a, U256::from(5), U256::from(7))), "d = 2");
+        assert_eq!(relax(&sent, a, info(3, 1), info(5, 1)), Some((a, U256::from(5), U256::from(3))), "2 covers -2");
+        let short = entry(seen(BalObs::SENT, Some(1)));
+        assert!(relax(&short, a, info(3, 1), info(5, 1)).is_none(), "1 does not cover -2");
+        assert!(relax(&short, a, info(7, 1), info(5, 1)).is_some(), "1 left, d = 2");
+        assert!(relax(&entry(seen(BalObs::SENT, Some(0))), a, info(7, 1), info(5, 1)).is_some(), "all sent, d = 2");
+        assert!(relax(&entry(seen(BalObs::SENT, None)), a, info(7, 1), info(5, 1)).is_none(), "failed, d = 2");
+        assert!(relax(&entry(seen(BalObs::READ | BalObs::SENT, Some(2))), a, info(7, 1), info(5, 1)).is_none(), "read");
+        assert!(relax(&entry(seen(BalObs::READ, Some(2))), a, info(7, 1), info(5, 1)).is_none(), "read only");
+        assert!(relax(&entry(None), a, info(7, 1), info(5, 1)).is_none(), "run not observed");
+        assert!(relax(&sent, sender, info(7, 1), info(5, 1)).is_none(), "sender");
+        assert!(relax(&sent, ben, info(7, 1), info(5, 1)).is_none(), "beneficiary");
+        assert!(relax(&sent, a, info(7, 2), info(5, 1)).is_none(), "nonce changed");
+        assert!(relax(&sent, a, info(7, 0), None).is_none(), "did not exist");
+        assert!(relax(&entry(seen(BalObs::SENT, Some(5))), a, info(0, 0), info(5, 0)).is_none(), "empty now");
+        // not observed: accepted as without the switch, a decrease too
+        assert_eq!(relax(&entry(reads(&[])), a, info(3, 1), info(5, 1)), Some((a, U256::from(5), U256::from(3))));
+        set_mode(2, 0, true, false, 0, false, 0);
+        assert!(relax(&sent, a, info(7, 1), info(5, 1)).is_none(), "`reusebal` off");
+        set_mode(0, 0, false, false, 0, false, 0);
+    }
+
+    /// Prologue (`reusebalsend`): what a run records of the transfers out of an account, the same with every frame's
+    /// instruction hooks (interpreted prewarm frames) and with only the message hooks (as compiled prewarm frames run).
+    /// A (10 wei) sends 9, leaving 1; calls F, which sends A 100; sends 50, leaving 51: the least left is 1, of 59
+    /// sent, F's 900 of 100. K (10 wei) creates with 4, leaving 6, then with 20, which fails: none, of 24 sent.
+    #[test]
+    fn transfers_out_record_the_least_balance_left() {
+        let (s, sink) = (Address::repeat_byte(0x11), Address::repeat_byte(0x5c));
+        let (a, f, k) = (Address::repeat_byte(0xa6), Address::repeat_byte(0xf0), Address::repeat_byte(0x6b));
+        let mut parent = funded(&[s]);
+        parent.insert_account_info(&sink, AccountInfo { balance: U256::from(1), nonce: 1, ..Default::default() });
+        parent.insert_account_info(&a, AccountInfo { balance: U256::from(10), ..contract(sender_code(sink)) });
+        parent.insert_account_info(&f, contract(PAYS_CALLER_100.to_vec()));
+        // K: CREATE(4, 0, 0), POP, CREATE(20, 0, 0), POP, STOP
+        let k_code = vec![0x5f, 0x5f, 0x60, 0x04, 0xf0, 0x50, 0x5f, 0x5f, 0x60, 0x14, 0xf0, 0x50, 0x00];
+        parent.insert_account_info(&k, AccountInfo { balance: U256::from(10), ..contract(k_code) });
+        let sent = |x: Address, sent: u64, min_slack: Option<u64>| {
+            (x, BalObs { bits: BalObs::SENT, sent: U256::from(sent), min_slack: min_slack.map(U256::from) })
+        };
+        let cases: [(TxSpec, Vec<(Address, BalObs)>); 2] = [
+            ((s, 0, a, 0, 200_000, 10, sends(9, f, 50)), vec![sent(a, 59, Some(1)), sent(f, 100, Some(900))]),
+            ((s, 0, k, 0, 200_000, 10, Bytes::new()), vec![sent(k, 24, None)]),
+        ];
+        let cfg = EthEvmConfig::mainnet();
+        for message_hooks_only in [false, true] {
+            for (spec, want) in &cases {
+                let tx = txs_of(std::slice::from_ref(spec)).remove(0);
+                let mut evm = cfg.evm_with_env(parent.clone(), evm_env(true));
+                tx_begin();
+                let insp = ObsInspector { record: true, message_hooks_only };
+                let (_, res) = reth_evm::Evm::transact_with_inspector(&mut evm, &cfg.tx_env(tx), insp).unwrap();
+                assert!(res.result.status);
+                let got = take_obs(CB_BODY.with(|c| c.get()));
+                assert_eq!(got, Some(AddressMap::from_iter(want.iter().copied())), "hooks only: {message_hooks_only}");
+            }
+        }
+    }
+
+    /// Prologue (`reusebalsend`): with Amsterdam (EIP-8037) CREATE checks the creator's balance itself and, when it is
+    /// short, pushes 0 without starting a frame. The instruction hook keeps that as a failed transfer of K, so K is not
+    /// accepted; with only the message hooks (as compiled frames run) K is not observed at all, as for `reusebal`.
+    #[test]
+    fn amsterdam_create_short_of_balance_is_a_failed_transfer() {
+        let (s, k) = (Address::repeat_byte(0x11), Address::repeat_byte(0x6b));
+        let mut parent = funded(&[s]);
+        // K: CREATE(20, 0, 0), POP, STOP
+        let k_code = vec![0x5f, 0x5f, 0x60, 0x14, 0xf0, 0x50, 0x00];
+        parent.insert_account_info(&k, AccountInfo { balance: U256::from(10), ..contract(k_code) });
+        let tx = txs_of(&[(s, 0, k, 0, 1_000_000, 10, Bytes::new())]).remove(0);
+        let cfg = EthEvmConfig::mainnet();
+        let short = (k, BalObs { bits: BalObs::SENT, sent: U256::ZERO, min_slack: None });
+        for (message_hooks_only, want) in [(false, vec![short]), (true, Vec::new())] {
+            let mut env = EthEvmEnv::new(SpecId::AMSTERDAM, evm_env(true).block, 1);
+            env.version.features.remove(EvmFeatures::NONCE_CHECK | EvmFeatures::BALANCE_CHECK);
+            let mut evm = cfg.evm_with_env(parent.clone(), env);
+            tx_begin();
+            let insp = ObsInspector { record: true, message_hooks_only };
+            let (_, res) = reth_evm::Evm::transact_with_inspector(&mut evm, &cfg.tx_env(tx.clone()), insp).unwrap();
+            assert!(res.result.status);
+            let got = take_obs(CB_BODY.with(|c| c.get()));
+            assert_eq!(got, Some(AddressMap::from_iter(want)), "message hooks only: {message_hooks_only}");
+        }
+    }
+
+    /// Prologue (`reusebalsend`), end to end with `reusebal` on. A1 to A6 ([`sender_code`], 10 wei each) are first
+    /// paid 5 (A1, A4, A5) or send 2 (A2, A3, A6); then
+    /// 1. A1 sends 3, leaving 7, with `d` = 5: accepted;
+    /// 2. A2 sends 5, leaving 5, which covers `d` = -2: accepted;
+    /// 3. A3 sends 9, leaving 1, which does not: executed (A3 cannot pay 9 out of 8);
+    /// 4. A4 sends 12, which fails on 10: executed although `d` = 5 (A4 pays 12 out of 15);
+    /// 5. A5 sends 3 and R stores BALANCE(A5): read, executed;
+    /// 6. A6 sends 9 (leaving 1), is paid 100 by F, sends 50 (leaving 51): `d` = -2 is not covered by the least balance
+    ///    left, although the current 8 and the 100 received cover the 59 sent: executed.
+    ///
+    /// The sink, only paid, is accepted by `reusebal` itself from the third transaction on. With the switch on the
+    /// results of 1 and 2 are reused, with A1 and A2 counted as the switch's, and check mode finds no difference; with
+    /// it off they are executed and the count is 0. Every case gives the block without reuse.
+    #[test]
+    fn balance_sent_only_end_to_end() {
+        let _g = GLOBAL.lock();
+        let (sink, f, r) = (Address::repeat_byte(0x5c), Address::repeat_byte(0xf0), Address::repeat_byte(0x7e));
+        let a: Vec<_> = (1..=6).map(|i| Address::repeat_byte(0xa0 + i)).collect();
+        let s: Vec<_> = (0..12).map(|i| Address::repeat_byte(0x30 + i)).collect();
+        let mut parent = funded(&s);
+        parent.insert_account_info(&sink, AccountInfo { balance: U256::from(1), nonce: 1, ..Default::default() });
+        for x in &a {
+            parent.insert_account_info(x, AccountInfo { balance: U256::from(10), ..contract(sender_code(sink)) });
+        }
+        parent.insert_account_info(&f, contract(PAYS_CALLER_100.to_vec()));
+        // R: CALLER, BALANCE, PUSH0, SSTORE, STOP
+        parent.insert_account_info(&r, contract(vec![0x33, 0x31, 0x5f, 0x55, 0x00]));
+        let (n, gas) = (Bytes::new(), 200_000);
+        let spec: Vec<TxSpec> = vec![
+            (s[0], 0, a[0], 5, gas, 10, n.clone()),
+            (s[1], 0, a[1], 0, gas, 10, sends(2, sink, 0)),
+            (s[2], 0, a[2], 0, gas, 10, sends(2, sink, 0)),
+            (s[3], 0, a[3], 5, gas, 10, n.clone()),
+            (s[4], 0, a[4], 5, gas, 10, n),
+            (s[5], 0, a[5], 0, gas, 10, sends(2, sink, 0)),
+            (s[6], 0, a[0], 0, gas, 10, sends(3, sink, 0)),
+            (s[7], 0, a[1], 0, gas, 10, sends(5, sink, 0)),
+            (s[8], 0, a[2], 0, gas, 10, sends(9, sink, 0)),
+            (s[9], 0, a[3], 0, gas, 10, sends(12, sink, 0)),
+            (s[10], 0, a[4], 0, gas, 10, sends(3, r, 0)),
+            (s[11], 0, a[5], 0, gas, 10, sends(9, f, 50)),
+        ];
+        let reference = run_block(&parent, &spec, 0, 0, true, false, 0x80, true);
+        assert!(reference.receipts.iter().all(|x| x.success));
+        // the refused cases depend on the balance: A3 kept 8, A4 paid 12 out of 15, R stored 12, A6 ended with 58
+        let state = &reference.bundle.state;
+        let balance = |x: &Address| state.get(x).and_then(|acc| acc.info.as_ref()).map(|i| i.balance);
+        assert_eq!(a.iter().map(balance).collect::<Vec<_>>(), [12, 3, 8, 3, 12, 58].map(|b| Some(U256::from(b))));
+        let stored = state.get(&r).and_then(|acc| acc.storage.get(&U256::ZERO)).map(|x| x.present_value());
+        assert_eq!(stored, Some(U256::from(12)));
+        for (tag, fast) in [(0x81, true), (0x82, false)] {
+            let o = run_block(&parent, &spec, 2, 0, fast, true, tag, true);
+            assert_eq!((o.bundle, o.receipts), (reference.bundle.clone(), reference.receipts.clone()), "off, {fast}");
+            assert_eq!((o.counts[0], o.counts[1], o.counts[5]), (6, 2, 0), "switch off, fast {fast}: 1 and 2 executed");
+        }
+        let _on = BalSendOn::new();
+        for (tag, fast) in [(0x83, true), (0x84, false)] {
+            let o = run_block(&parent, &spec, 2, 0, fast, true, tag, true);
+            assert_eq!((o.bundle, o.receipts), (reference.bundle.clone(), reference.receipts.clone()), "on, {fast}");
+            assert_eq!((o.counts[0], o.counts[1], o.counts[5]), (8, 4, 2), "switch on, fast {fast}: 1 and 2 reused");
+        }
+        // check mode: the results of 1 and 2 accepted, executed and compared
+        let o = run_block(&parent, &spec, 1, 0, true, true, 0x85, true);
+        assert_eq!((o.bundle, o.receipts), (reference.bundle.clone(), reference.receipts.clone()));
+        assert_eq!((o.counts[2], o.counts[3], o.counts[4], o.counts[5]), (0, 0, 8, 2), "check mode");
+        // runs not recorded: no balance change accepted by either rule
+        let o = run_block(&parent, &spec, 2, 0, true, true, 0x86, false);
+        assert_eq!((o.bundle, o.receipts), (reference.bundle, reference.receipts));
+        assert_eq!((o.counts[0], o.counts[5]), (4, 0), "unrecorded runs");
+    }
+}
