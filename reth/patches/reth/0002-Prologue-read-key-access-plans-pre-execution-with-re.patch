+            op::PUSH1, i0, op::JUMPDEST, op::DUP1, op::PUSH0, op::MSTORE, op::PUSH1, 6, op::PUSH1, 32, op::MSTORE,
+            op::PUSH1, 64, op::PUSH0, op::KECCAK256, op::SLOAD, op::POP, op::PUSH1, 1, op::ADD, op::DUP1, op::PUSH1,
+            i0 + n_el, op::GT, op::PUSH1, 2, op::JUMPI, op::STOP,
+        ];
+        let provider = MockEthProvider::default();
+        provider.add_account(SENDER, ExtendedAccount::new(0, U256::from(10u64).pow(U256::from(20u8))));
+        provider.add_account(looped, ExtendedAccount::new(0, U256::ZERO).with_bytecode(Bytes::from(code)));
+        let db = StateProviderDatabase::new(CachedStateProvider::new_prewarm(
+            provider.into_evm_state_provider(),
+            ExecutionCache::new(1 << 20),
+        ));
+        let blk: &'static IxBlock = Box::leak(Box::new(IxBlock::new()));
+        let (tx, rx) = crossbeam_channel::unbounded();
+        let g = begin(IxState::new(32, blk, Some(tx), false));
+        pw_set_tx(0);
+        let mode = Mode::parse("prewarm=1 tx=1 ixpf=32");
+        let mut insp = EapPwInspector {
+            tx: None,
+            stats: Some(Arc::new(Stats::default())),
+            all_depths: false,
+            mode,
+            exec_idx: Arc::new(AtomicUsize::new(0)),
+            info: info(),
+            lx: eap_lx::LxTracker::default(),
+            lx_dec_done: 0,
+            c2_done: 0,
+            lx_tx_ns: 0,
+            ended: None,
+            rdepth: 0,
+            tx_to: None,
+            tx_input: Bytes::new(),
+            lxk: 0,
+            lx_sent_cur: u32::MAX,
+            lx_kbuf: Vec::new(),
+            lx_kn: 0,
+            lx_gate: std::collections::HashMap::new(),
+            lx_gate_cur: u32::MAX,
+        };
+        let mut evm = evm(db);
+        assert!(run(&mut evm, 0, looped, &mut insp).status, "the loop runs");
+        drop(g);
+        let last = u64::from(i0 + n_el - 1);
+        assert_eq!(sent_of(&rx, looped), keys(u(u64::from(i0) + 6..=last + 32), &[0]));
+        let c = blk.counts();
+        assert_eq!((c.hash, c.pat, c.capped), (u64::from(n_el), 1, 0));
+    }
+
+    /// The worker reads field `j` of element `i` with the thread's backend storage fills `f` so far
+    /// ([`IxState::slot_with`]).
+    fn read_f(s: &mut IxState, i: u64, j: u64, f: u64) {
+        s.input(&input(U256::from(i), C));
+        s.slot_with(A, slot_of(U256::from(i), U256::from(C)) + U256::from(j), f);
+    }
+
+    /// Prologue (`ixpfw`): with every read going to the backend, the first issue (fourth confirmation, sixth index
+    /// read, five indices followed) reaches five indices ahead instead of 16, and the distance then grows with the run.
+    #[test]
+    fn guard_bounds_the_distance_by_the_run() {
+        let (s, rx, blk) = state(256);
+        let mut s = s.guarded(true);
+        for (f, i) in (100..=105).enumerate() {
+            read_f(&mut s, i, 0, f as u64 + 1);
+        }
+        assert_eq!(sent(&rx), keys(u(106..=110), &[0]));
+        read_f(&mut s, 106, 0, 7);
+        assert_eq!(sent(&rx), keys(u(111..=112), &[0]));
+        assert_eq!(blk.counts().wskip, 0);
+    }
+
+    /// Prologue (`ixpfw`): a run whose reads all hit the cache (the thread's backend fills do not grow) issues nothing
+    /// and is counted once as skipped; once one of its reads went to the backend (seen at the next read), it issues, no
+    /// further ahead than it has followed.
+    #[test]
+    fn guard_waits_for_a_backend_read() {
+        let (s, rx, blk) = state(256);
+        let mut s = s.guarded(true);
+        for i in 100..=110 {
+            read_f(&mut s, i, 0, 0);
+        }
+        assert!(sent(&rx).is_empty());
+        assert_eq!(blk.counts().wskip, 1);
+        read_f(&mut s, 111, 0, 1);
+        assert_eq!(sent(&rx), keys(u(112..=122), &[0]));
+        assert_eq!(blk.counts().wskip, 1);
+    }
+
+    /// Prologue (`ixpfw`): a backend read counts for the pattern of the read that made it: here contract `b`'s reads go to
+    /// the backend (the fills grow by the next read) and [`A`]'s hit the cache, so only `b`'s run issues.
+    #[test]
+    fn guard_counts_backend_reads_per_pattern() {
+        let (s, rx, blk) = state(256);
+        let mut s = s.guarded(true);
+        let b = address!("0x00000000000000000000000000000000000000b1");
+        for (f, i) in (100..=110).enumerate() {
+            s.input(&input(U256::from(i), C));
+            s.slot_with(b, slot_of(U256::from(i), U256::from(C)), f as u64);
+            read_f(&mut s, i, 0, f as u64 + 1);
+        }
+        let to: Vec<Address> = rx
+            .try_iter()
+            .map(|it| match it {
+                Item::Slot(sa, ..) => sa,
+                other => panic!("a slot item, not {other:?}"),
+            })
+            .collect();
+        assert!(!to.is_empty() && to.iter().all(|x| *x == b));
+        assert_eq!(blk.counts().wskip, 1);
+    }
+}
diff --git a/crates/engine/tree/src/tree/eap_ew.rs b/crates/engine/tree/src/tree/eap_ew.rs
new file mode 100644
index 0000000000000000000000000000000000000000..bcde8eca2deabd6e7fb96f5eb1e2a0b07a212d78
--- /dev/null
+++ b/crates/engine/tree/src/tree/eap_ew.rs
@@ -0,0 +1,3215 @@
+//! EngineAccessPlan research prototype (EXP-199, X-020): native state of EAP's own prewarm mechanism (`ew`).
+//!
+//! - [`EwWrites`]: the block's writes as the mechanism's workers prewarmed them, by key, each with its transaction index
+//!   (`ewov=1`). A worker prewarming transaction `i` reads a key from the latest write of a transaction `j < i` that was
+//!   already prewarmed, instead of the parent state, so that its run follows the path the execution thread will take
+//!   more often; the value-speculative pass uses the same writes as its predictions.
+//! - [`EwOverlay`]: the provider wrapper that answers the prewarm EVM's account and storage reads from [`EwWrites`] and
+//!   passes everything else to the cache-filling provider below it. An answer from the writes is not filled into the
+//!   execution cache, which keeps holding the parent state.
+//! - Core reservation (`ewcore=1`): the mechanism's threads (workers, readers, speculative-pass helpers) keep off one core
+//!   of the execution thread's allowed set, leaving it to the execution thread and reth's other threads. With
+//!   `exphys=1` they also keep off that core's SMT siblings, and the execution thread runs on that core alone during
+//!   its execution, while the sparse-trie thread that `srrt` raises keeps off the core and its siblings.
+//! - Persistent threads (`ewpool=1`, [`pool_spawn`]): the block's workers and speculative-pass helpers run on threads kept
+//!   across blocks instead of threads made for the block before its dispatch starts.
+//!
+//! X-027 port to reth 2.9.0: the lock-free tables (`ewlf`) and the state-root boost (`srboost`) are not ported (off in
+//! the final configuration); the locks keep the lock profiler (`lkprof`) as in 2.5.1.
+
+use alloy_primitives::{Address, BlockNumber, StorageKey, StorageValue, B256, U256};
+use parking_lot::{Mutex, RwLock};
+use reth_errors::ProviderResult;
+use reth_primitives_traits::{Account, Bytecode};
+use reth_provider::{EvmStateProvider, EvmStateProviderBox};
+use std::{
+    cell::Cell,
+    collections::HashMap,
+    sync::{
+        atomic::{AtomicU64, AtomicUsize, Ordering},
+        Arc,
+    },
+};
+
+/// The block's writes as prewarmed by the mechanism's workers.
+#[derive(Debug, Default)]
+pub struct EwWrites {
+    /// slot -> [(transaction, record sequence number, value)] sorted by transaction; the sequence number identifies the
+    /// record (a redo of the same transaction gets a new one)
+    slots: RwLock<HashMap<(Address, B256), Vec<(u32, (u32, U256))>>>,
+    accounts: RwLock<HashMap<Address, Vec<(u32, Account)>>>,
+    /// reads answered from the writes (slots, accounts), and transactions recorded
+    hits: [AtomicU64; 2],
+    recorded: AtomicU64,
+    /// the last record's sequence number (0 stands for the parent state)
+    seq: std::sync::atomic::AtomicU32,
+    /// per transaction: the run number of its accepted record and the slots that record wrote (a later record that no
+    /// longer writes a slot removes its entry; a record of an older run is refused)
+    written: Mutex<HashMap<u32, (u32, Vec<(Address, B256)>)>>,
+    /// `ewredo`: slot -> [(transaction, sequence number it read)] of each transaction's accepted registration, and per
+    /// transaction the run number and slots of that registration (an older run's registration is refused)
+    readers: Mutex<(HashMap<(Address, B256), Vec<(u32, u32)>>, HashMap<u32, (u32, Vec<(Address, B256)>)>)>,
+    /// `ewredo`: stale transactions not redone (over the limit or passed), redo runs queued, detections of a transaction
+    /// already queued, redo runs started
+    redo: [AtomicU64; 4],
+}
+
+impl EwWrites {
+    /// The block's writes. `lf` (`ewlf` bit 1, lock-free tables) is not ported: the locked tables are used always.
+    pub fn new(lf: bool) -> Self {
+        let _ = lf;
+        Self::default()
+    }
+
+    /// The value transaction `tx` reads for `key` of `address`: the write of the latest earlier transaction recorded so
+    /// far, if any.
+    pub fn slot_before(&self, address: Address, key: B256, tx: u32) -> Option<U256> {
+        self.slot_version_value(address, key, tx).map(|(_, v)| v)
+    }
+
+    /// As [`Self::slot_before`], with the record's sequence number.
+    pub fn slot_version_value(&self, address: Address, key: B256, tx: u32) -> Option<(u32, U256)> {
+        let g = reth_execution_cache::lkprof::read(reth_execution_cache::lkprof::EW_SLOTS_R, &self.slots);
+        let v = latest_before(g.get(&(address, key))?, tx)?;
+        self.hits[0].fetch_add(1, Ordering::Relaxed);
+        Some(v)
+    }
+
+    /// The account transaction `tx` reads for `address` from the earlier transactions' writes, if any.
+    pub fn account_before(&self, address: Address, tx: u32) -> Option<Account> {
+        let g = reth_execution_cache::lkprof::read(reth_execution_cache::lkprof::EW_ACCTS, &self.accounts);
+        let v = latest_before(g.get(&address)?, tx)?;
+        self.hits[1].fetch_add(1, Ordering::Relaxed);
+        Some(v)
+    }
+
+    /// Records the writes of run `run` of transaction `tx` (runs of one transaction are numbered from 1; without redo
+    /// every run is 1): every changed slot, and the nonce and balance of every account whose code did not change (an
+    /// account created or self-destructed in the run is skipped, so the overlay never points the EVM at code the
+    /// database does not hold). The block's beneficiary (`skip`) is not recorded: every run credits it the fee, so every
+    /// later run would read it from the writes, and out-of-order runs make its balance meaningless.
+    ///
+    /// A slot written with the value an earlier record of `tx` already holds keeps that record's sequence number; the
+    /// slots an earlier record of `tx` wrote and this one does not are removed. Returns the slots whose entry changed
+    /// (for [`Self::stale_readers`]), or `None` when a record of a later run of `tx` was already accepted (this run's
+    /// results are then dropped).
+    ///
+    /// X-027: from evm2's detached transaction state. An account missing before or after the run (`None`) counts as the
+    /// empty account, as revm's loaded-but-absent account did in 2.5.1; `touched` is evm2's (loaded-only accounts are
+    /// not touched, as in revm).
+    pub fn record(
+        &self,
+        tx: u32,
+        run: u32,
+        state: &evm2::evm::PendingState,
+        skip: Address,
+    ) -> Option<Vec<(Address, B256)>> {
+        let (slots, accounts) = changed_lists(state.account_changes(), skip);
+        self.record_lists(tx, run, slots, accounts)
+    }
+    /// [`Self::record`] from the run's changed slots and accounts.
+    pub(crate) fn record_lists(
+        &self,
+        tx: u32,
+        run: u32,
+        slots: Vec<((Address, B256), U256)>,
+        accounts: Vec<(Address, Account)>,
+    ) -> Option<Vec<(Address, B256)>> {
+        // the run check and the table update under the `written` lock, so records of one transaction apply in run order
+        let mut w = reth_execution_cache::lkprof::lock(reth_execution_cache::lkprof::EW_WRITTEN, &self.written);
+        if w.get(&tx).is_some_and(|(r, _)| *r > run) {
+            return None
+        }
+        let keys: Vec<(Address, B256)> = slots.iter().map(|(k, _)| *k).collect();
+        let old = w.insert(tx, (run, keys.clone())).map(|(_, k)| k).unwrap_or_default();
+        let kept: std::collections::HashSet<(Address, B256)> = keys.iter().copied().collect();
+        let removed: Vec<(Address, B256)> = old.into_iter().filter(|k| !kept.contains(k)).collect();
+        let mut changed = Vec::new();
+        if !slots.is_empty() || !removed.is_empty() {
+            let seq = self.seq.fetch_add(1, Ordering::AcqRel) + 1;
+            let mut g = reth_execution_cache::lkprof::write(reth_execution_cache::lkprof::EW_SLOTS_W, &self.slots);
+            for (key, v) in slots {
+                let e = g.entry(key).or_default();
+                let i = e.partition_point(|(j, _)| *j < tx);
+                if e.get(i).is_some_and(|(j, (_, old))| *j == tx && *old == v) {
+                    continue
+                }
+                insert_sorted(e, tx, (seq, v));
+                changed.push(key);
+            }
+            for key in removed {
+                if let Some(v) = g.get_mut(&key) {
+                    v.retain(|(j, _)| *j != tx);
+                }
+                changed.push(key);
+            }
+        }
+        if !accounts.is_empty() {
+            let mut g = reth_execution_cache::lkprof::write(reth_execution_cache::lkprof::EW_ACCTS, &self.accounts);
+            for (a, v) in accounts {
+                insert_sorted(g.entry(a).or_default(), tx, v);
+            }
+        }
+        drop(w);
+        self.recorded.fetch_add(1, Ordering::Relaxed);
+        Some(changed)
+    }
+
+    /// `ewredo`: the later transactions whose registered read of one of `changed` (slots whose entry transaction `w`'s
+    /// record just changed) no longer matches the entry they would read now.
+    pub fn stale_readers(&self, w: u32, changed: &[(Address, B256)]) -> Vec<u32> {
+        let rg = self.readers.lock();
+        let sg = self.slots.read();
+        let mut out = Vec::new();
+        for k in changed {
+            if let Some(rs) = rg.0.get(k) {
+                for (i, s) in rs {
+                    if *i > w && seq_before(&sg, k, *i) != *s {
+                        out.push(*i);
+                    }
+                }
+            }
+        }
+        out.sort_unstable();
+        out.dedup();
+        out
+    }
+
+    /// `ewredo`: registers the reads of run `run` of transaction `tx` (replacing the registration of an earlier run), then
+    /// checks them against the writes recorded so far: whether an entry the run would read now differs from the one it
+    /// read. `None` when a later run of `tx` already registered (this run is dropped). Lock order readers -> slots, as in
+    /// [`Self::stale_readers`]; a record takes `written` and then the slots, never the readers, so a write recorded before
+    /// this check is found here and one recorded after the registration is found by its writer: none is missed (both may
+    /// find the same one).
+    pub fn register_reads(&self, tx: u32, run: u32, reads: &[((Address, B256), u32)]) -> Option<bool> {
+        let mut rg = self.readers.lock();
+        if rg.1.get(&tx).is_some_and(|(r, _)| *r > run) {
+            return None
+        }
+        if let Some((_, old)) = rg.1.remove(&tx) {
+            for k in old {
+                if let Some(v) = rg.0.get_mut(&k) {
+                    v.retain(|(i, _)| *i != tx);
+                }
+            }
+        }
+        for (k, s) in reads {
+            rg.0.entry(*k).or_default().push((tx, *s));
+        }
+        rg.1.insert(tx, (run, reads.iter().map(|(k, _)| *k).collect()));
+        let sg = self.slots.read();
+        Some(reads.iter().any(|(k, s)| seq_before(&sg, k, tx) != *s))
+    }
+
+    /// `ewredo`: counts a stale transaction: 0 not redone (over its limit or passed), 1 redo queued, 2 already queued;
+    /// or 3 a queued redo run started.
+    pub fn count_redo(&self, kind: usize) {
+        self.redo[kind.min(3)].fetch_add(1, Ordering::Relaxed);
+    }
+
+    /// `ewredo`: (stale and not redone, redo runs queued, redo runs started) of the block.
+    pub fn redo_counts(&self) -> (u64, u64, u64) {
+        let [skipped, queued, _, started] = &self.redo;
+        (skipped.load(Ordering::Relaxed), queued.load(Ordering::Relaxed), started.load(Ordering::Relaxed))
+    }
+
+    /// (slot reads answered, account reads answered, transactions recorded) of the block.
+    pub fn counts(&self) -> (u64, u64, u64) {
+        (
+            self.hits[0].load(Ordering::Relaxed),
+            self.hits[1].load(Ordering::Relaxed),
+            self.recorded.load(Ordering::Relaxed),
+        )
+    }
+}
+
+/// The changed slots and the changed accounts of a run for [`EwWrites::record`] (see there), the beneficiary `skip`
+/// left out.
+fn changed_lists<'a>(
+    changes: impl Iterator<Item = evm2::evm::AccountChanges<'a>>,
+    skip: Address,
+) -> (Vec<((Address, B256), U256)>, Vec<(Address, Account)>) {
+    let mut slots = Vec::new();
+    let mut accounts = Vec::new();
+    let empty = evm2::evm::AccountInfo::default();
+    for acc in changes {
+        let address = acc.address;
+        if address == skip || acc.created || acc.selfdestructed || !acc.touched {
+            continue
+        }
+        for (k, s) in &acc.storage.slots {
+            if s.value.is_changed() {
+                slots.push(((address, B256::from(*k)), s.value.current));
+            }
+        }
+        let (info, orig) = (acc.current.unwrap_or(&empty), acc.original.unwrap_or(&empty));
+        if info.code_hash == orig.code_hash && (info.nonce != orig.nonce || info.balance != orig.balance) {
+            accounts.push((address, Account::from(info)));
+        }
+    }
+    (slots, accounts)
+}
+
+/// The sequence number of the entry transaction `tx` reads for `key` (0: the parent state).
+fn seq_before(g: &HashMap<(Address, B256), Vec<(u32, (u32, U256))>>, key: &(Address, B256), tx: u32) -> u32 {
+    g.get(key).and_then(|v| latest_before(v, tx)).map_or(0, |(s, _)| s)
+}
+
+fn latest_before<V: Copy>(v: &[(u32, V)], tx: u32) -> Option<V> {
+    // sorted by transaction index; the last entry with an index below `tx`
+    let i = v.partition_point(|(j, _)| *j < tx);
+    (i > 0).then(|| v[i - 1].1)
+}
+
+fn insert_sorted<V>(v: &mut Vec<(u32, V)>, tx: u32, value: V) {
+    let i = v.partition_point(|(j, _)| *j < tx);
+    if v.get(i).is_some_and(|(j, _)| *j == tx) {
+        v[i].1 = value;
+    } else {
+        v.insert(i, (tx, value));
+    }
+}
+
+thread_local! {
+    /// Whether the current prewarm run read a value from the block's writes (its reuse entry then needs the full check).
+    static USED: Cell<bool> = const { Cell::new(false) };
+    /// `ewredo`: whether this thread logs its run's storage reads, and the log ((address, key), sequence number of the
+    /// record read, 0 for the parent state).
+    static LOG_ON: Cell<bool> = const { Cell::new(false) };
+    static READ_LOG: std::cell::RefCell<Vec<((Address, B256), u32)>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+
+/// Starts a run on this thread: no value from the writes read yet; with `log`, its storage reads are logged (`ewredo`).
+pub fn run_begin_logged(log: bool) {
+    USED.with(|c| c.set(false));
+    LOG_ON.with(|c| c.set(log));
+    READ_LOG.with(|r| r.borrow_mut().clear());
+}
+
+/// Starts a run on this thread: no value from the writes read yet.
+pub fn run_begin() {
+    run_begin_logged(false);
+}
+
+/// `ewredo`: the storage reads of the run on this thread since [`run_begin_logged`]; empties the log.
+pub fn take_read_log() -> Vec<((Address, B256), u32)> {
+    READ_LOG.with(|r| std::mem::take(&mut *r.borrow_mut()))
+}
+
+/// Whether the run on this thread read a value from the block's writes since [`run_begin`].
+pub fn run_used_writes() -> bool {
+    USED.with(|c| c.get())
+}
+
+/// EXP-212 (`pwsl=1`): runs `f`, a plan's storage read-back on a prewarm worker, outside the run's bookkeeping: a read of a
+/// value from the block's writes inside `f` does not mark the run ([`run_used_writes`]: no forced full reuse check) and is
+/// not logged for `ewredo`. The prewarm EVM reads [`EwOverlay`] directly through `StateProviderDatabase` (no revm `State`
+/// cache) and `f` bypasses the journal, so a later read of the same slot by the run itself still reaches the overlay and is
+/// marked and logged there.
+pub fn outside_run<T>(f: impl FnOnce() -> T) -> T {
+    /// puts the marks back also when `f` unwinds
+    struct Restore(bool, bool);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            USED.with(|c| c.set(self.0));
+            LOG_ON.with(|c| c.set(self.1));
+        }
+    }
+    let _g = Restore(USED.with(|c| c.get()), LOG_ON.with(|c| c.replace(false)));
+    f()
+}
+
+
+/// Prewarm EVM provider wrapper answering account and storage reads from [`EwWrites`] for the transaction this thread is
+/// prewarming (`eap::pw_cur_tx`); outside a transaction, and for keys no earlier transaction wrote, the reads go to the
+/// provider below.
+///
+/// X-027: on reth 2.9.0 the prewarm EVM reads an [`EvmStateProvider`] (no proof or root methods). evm2's EVM keeps the
+/// values it read across transactions, so the worker empties that cache before every transaction ([`fresh_reads`]):
+/// otherwise a later transaction would see the values an earlier one read instead of asking this overlay.
+pub struct EwOverlay {
+    inner: EvmStateProviderBox,
+    writes: Arc<EwWrites>,
+}
+impl std::fmt::Debug for EwOverlay {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("EwOverlay").finish_non_exhaustive()
+    }
+}
+
+impl EwOverlay {
+    /// Wraps `inner`.
+    pub fn new(inner: EvmStateProviderBox, writes: Arc<EwWrites>) -> Self {
+        Self { inner, writes }
+    }
+
+    fn tx() -> Option<u32> {
+        let t = crate::tree::eap::pw_cur_tx();
+        (t != u32::MAX).then_some(t)
+    }
+}
+
+impl EvmStateProvider for EwOverlay {
+    fn basic_account(&self, address: &Address) -> ProviderResult<Option<Account>> {
+        if let Some(tx) = Self::tx() &&
+            let Some(a) = self.writes.account_before(*address, tx)
+        {
+            USED.with(|c| c.set(true));
+            return Ok(Some(a))
+        }
+        self.inner.basic_account(address)
+    }
+
+    fn block_hash(&self, number: BlockNumber) -> ProviderResult<Option<B256>> {
+        self.inner.block_hash(number)
+    }
+
+    fn bytecode_by_hash(&self, code_hash: &B256) -> ProviderResult<Option<Bytecode>> {
+        self.inner.bytecode_by_hash(code_hash)
+    }
+
+    fn storage(
+        &self,
+        account: Address,
+        storage_key: StorageKey,
+    ) -> ProviderResult<Option<StorageValue>> {
+        let tx = Self::tx();
+        if let Some(tx) = tx &&
+            let Some((seq, v)) = self.writes.slot_version_value(account, storage_key, tx)
+        {
+            USED.with(|c| c.set(true));
+            if LOG_ON.with(|c| c.get()) {
+                READ_LOG.with(|r| r.borrow_mut().push(((account, storage_key), seq)));
+            }
+            return Ok((!v.is_zero()).then_some(v))
+        }
+        if tx.is_some() && LOG_ON.with(|c| c.get()) {
+            READ_LOG.with(|r| r.borrow_mut().push(((account, storage_key), 0)));
+        }
+        self.inner.storage(account, storage_key)
+    }
+}
