diff --git a/crates/eap-lx/src/c2rec.rs b/crates/eap-lx/src/c2rec.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9e79de42647f2c880368ceecb151cbfcc72d50fc
--- /dev/null
+++ b/crates/eap-lx/src/c2rec.rs
@@ -0,0 +1,372 @@
+//! EXP-151 (`c2rec`): compile-time CREATE2 salt templates (EXP-145 records, `raw/c2records/<code hash>.json`).
+//!
+//! A record describes one CREATE2 site (or one 85-byte CREATE2 address computation) of a contract under one function
+//! selector: the creator, the salt as segments (constant bytes, words from the calldata, the environment or storage,
+//! loop indices, calldata-array elements), the init-code hash, and the storage counters the function advances per call
+//! or per created proxy. Evaluated when a transaction reaches the contract, it yields every proxy address of the
+//! transaction without observing any call; the extrapolation then takes these addresses as known sequences.
+
+use crate::lx_batch_count;
+use alloy_primitives::{keccak256, Address, B256, U256};
+use serde::Deserialize;
+use std::collections::HashMap;
+
+/// Most addresses enumerated per record.
+pub const C2_MAX: usize = 4096;
+
+/// One storage-free or storage-reading value.
+#[derive(Debug, Clone, Deserialize)]
+#[serde(tag = "kind", rename_all = "lowercase")]
+pub enum Val {
+    Const { hex: String },
+    /// calldata word at a fixed byte offset
+    Cd { off: usize },
+    /// calldata word at `add + CD(off_word)`
+    Cdat { add: usize, off_word: usize },
+    Address,
+    Caller,
+    Origin,
+    Sload { key: Box<Val> },
+    Kec { words: Vec<Val> },
+    Lin { base: Num, val: Box<Val> },
+    Shr { by: usize, val: Box<Val> },
+    /// the current word of another salt segment (an inner count keyed by the outer element)
+    Segref { i: usize },
+}
+
+/// A number written as a JSON integer or as a 0x-hex string (256-bit, two's complement for negative values).
+#[derive(Debug, Clone, Deserialize)]
+#[serde(untagged)]
+pub enum Num {
+    Int(i64),
+    Hex(String),
+}
+
+impl Num {
+    fn u(&self) -> U256 {
+        match self {
+            Num::Int(i) if *i >= 0 => U256::from(*i as u64),
+            Num::Int(i) => U256::ZERO.wrapping_sub(U256::from(i.unsigned_abs())),
+            Num::Hex(h) => U256::from_str_radix(h.trim_start_matches("0x"), 16).unwrap_or_default(),
+        }
+    }
+}
+
+/// One byte segment of a salt (or creator / init code).
+#[derive(Debug, Clone, Deserialize)]
+#[serde(tag = "kind", rename_all = "lowercase")]
+pub enum Seg {
+    Const { hex: String },
+    /// bytes `lo..hi` of the word `val`
+    Val { val: Val, lo: usize, hi: usize },
+    /// loop index: word = from + base + k, k = 0 .. count-1 (count from `bound` - start, or `count`)
+    Index { from: Option<Val>, base: Num, bound: Option<Val>, count: Option<Val>, lo: usize, hi: usize },
+    /// calldata array element: word = CD[first + CD(off_word) + stride * k], k < len
+    Cdarr { off_word: usize, first: usize, stride: usize, len: Option<Val>, lo: usize, hi: usize },
+}
+
+#[derive(Debug, Clone, Deserialize)]
+pub struct Salt {
+    pub form: String,
+    pub segs: Vec<Seg>,
+}
+
+#[derive(Debug, Clone, Deserialize)]
+pub struct Init {
+    pub hash: Option<String>,
+    pub segs: Option<Vec<Seg>>,
+    pub hash_val: Option<Val>,
+}
+
+/// A storage counter the record's function advances: per call by `delta`, or per created proxy.
+#[derive(Debug, Clone, Deserialize)]
+pub struct Update {
+    pub key: Val,
+    pub delta: Val,
+    pub per: String,
+}
+
+#[derive(Debug, Clone, Deserialize)]
+pub struct Rec {
+    pub sel: Option<String>,
+    pub site: String,
+    pub pc: u32,
+    pub creator: Option<Vec<Seg>>,
+    pub salt: Salt,
+    pub init: Option<Init>,
+    #[serde(default)]
+    pub updates: Vec<Update>,
+}
+
+#[derive(Debug, Deserialize)]
+struct File {
+    codehash: String,
+    records: Vec<Rec>,
+}
+
+/// Records by code hash and selector (`None` selector: any).
+#[derive(Debug, Default)]
+pub struct C2Records {
+    pub by_code: HashMap<B256, Vec<Rec>>,
+}
+
+impl C2Records {
+    /// Loads every `*.json` of `dir`; a damaged file is skipped (and counted).
+    pub fn load(dir: &std::path::Path) -> (Self, usize) {
+        let mut out = Self::default();
+        let mut bad = 0;
+        let Ok(rd) = std::fs::read_dir(dir) else { return (out, 0) };
+        for e in rd.flatten() {
+            if e.path().extension().is_none_or(|x| x != "json") {
+                continue
+            }
+            match std::fs::read(e.path()).ok().and_then(|b| serde_json::from_slice::<File>(&b).ok()) {
+                Some(f) => {
+                    let Ok(h) = f.codehash.parse::<B256>() else {
+                        bad += 1;
+                        continue
+                    };
+                    if !f.records.is_empty() {
+                        out.by_code.insert(h, f.records);
+                    }
+                }
+                None => bad += 1,
+            }
+        }
+        (out, bad)
+    }
+
+    /// The records of `code` that apply to calldata `input`.
+    pub fn matching<'a>(&'a self, code: &B256, input: &[u8]) -> impl Iterator<Item = &'a Rec> + 'a {
+        let sel = input.get(..4).map(|s| format!("{:02x}{:02x}{:02x}{:02x}", s[0], s[1], s[2], s[3]));
+        self.by_code.get(code).into_iter().flatten().filter(move |r| r.sel.is_none() || r.sel == sel)
+    }
+}
+
+/// What a record is evaluated against: the frame's address, caller, the transaction origin and the calldata.
+#[derive(Debug, Clone, Copy)]
+pub struct Env<'a> {
+    pub address: Address,
+    pub caller: Address,
+    pub origin: Address,
+    pub input: &'a [u8],
+}
+
+/// State access while evaluating: storage of the frame's address (block-start state) and code existence.
+pub trait State {
+    fn sload(&mut self, key: U256) -> U256;
+    fn has_code(&mut self, a: Address) -> bool;
+}
+
+fn word(input: &[u8], off: usize) -> U256 {
+    let mut b = [0u8; 32];
+    if off < input.len() {
+        let n = (input.len() - off).min(32);
+        b[..n].copy_from_slice(&input[off..off + n]);
+    }
+    U256::from_be_bytes(b)
+}
+
+fn addr_word(a: Address) -> U256 {
+    let mut b = [0u8; 32];
+    b[12..].copy_from_slice(a.as_slice());
+    U256::from_be_bytes(b)
+}
+
+fn hexbytes(h: &str) -> Vec<u8> {
+    alloy_primitives::hex::decode(h.trim_start_matches("0x")).unwrap_or_default()
+}
+
+struct Ctx<'e, 's> {
+    env: Env<'e>,
+    st: &'s mut dyn State,
+    ov: &'s HashMap<U256, U256>,
+    segvals: HashMap<usize, U256>,
+}
+
+impl Ctx<'_, '_> {
+    fn val(&mut self, v: &Val) -> Option<U256> {
+        Some(match v {
+            Val::Const { hex } => U256::from_str_radix(hex.trim_start_matches("0x"), 16).ok()?,
+            Val::Cd { off } => word(self.env.input, *off),
+            Val::Cdat { add, off_word } => {
+                let o = word(self.env.input, *off_word);
+                if o > U256::from(1u64 << 32) {
+                    return None
+                }
+                word(self.env.input, add + o.to::<usize>())
+            }
+            Val::Address => addr_word(self.env.address),
+            Val::Caller => addr_word(self.env.caller),
+            Val::Origin => addr_word(self.env.origin),
+            Val::Sload { key } => {
+                let k = self.val(key)?;
+                self.st.sload(k).wrapping_add(self.ov.get(&k).copied().unwrap_or_default())
+            }
+            Val::Kec { words } => {
+                let mut buf = Vec::with_capacity(32 * words.len());
+                for w in words {
+                    buf.extend_from_slice(&self.val(w)?.to_be_bytes::<32>());
+                }
+                U256::from_be_bytes(keccak256(&buf).0)
+            }
+            Val::Lin { base, val } => base.u().wrapping_add(self.val(val)?),
+            Val::Shr { by, val } => self.val(val)? >> *by,
+            Val::Segref { i } => *self.segvals.get(i)?,
+        })
+    }
+
+    fn seg_bytes(&mut self, s: &Seg, w: Option<U256>) -> Option<Vec<u8>> {
+        Some(match s {
+            Seg::Const { hex } => hexbytes(hex),
+            Seg::Val { val, lo, hi } => self.val(val)?.to_be_bytes::<32>()[*lo..*hi].to_vec(),
+            Seg::Index { lo, hi, .. } | Seg::Cdarr { lo, hi, .. } => w?.to_be_bytes::<32>()[*lo..*hi].to_vec(),
+        })
+    }
+}
+
+/// Counts that the record leaves open: a creating site and a computation whose index starts from the calldata take
+/// the calldata batch-count rule; a computation over existing proxies whose index starts from storage or zero is
+/// probed (the first address without code ends it).
+fn rule_count(rec: &Rec, s: &Seg, input: &[u8]) -> Option<usize> {
+    let from_cd = matches!(s, Seg::Cdarr { .. }) ||
+        matches!(s, Seg::Index { from: Some(Val::Cd { .. } | Val::Cdat { .. } | Val::Shr { .. }), .. });
+    if rec.site == "CREATE2" || from_cd {
+        lx_batch_count(input, 4)
+    } else {
+        None
+    }
+}
+
+/// Every address of `rec` for the frame `env` (`None` when a value cannot be evaluated or the record has no init
+/// hash); `ov` adds the block's earlier transactions' counter updates to storage values.
+pub fn enumerate(rec: &Rec, env: Env<'_>, st: &mut dyn State, ov: &HashMap<U256, U256>) -> Option<Vec<Address>> {
+    let mut cx = Ctx { env, st, ov, segvals: HashMap::new() };
+    let creator = match &rec.creator {
+        None => env.address,
+        Some(segs) => {
+            let mut b = Vec::new();
+            for s in segs {
+                b.extend(cx.seg_bytes(s, None)?);
+            }
+            if b.len() != 20 {
+                return None
+            }
+            Address::from_slice(&b)
+        }
+    };
+    let init = rec.init.as_ref()?;
+    let ih: B256 = if let Some(h) = &init.hash {
+        h.parse().ok()?
+    } else if let Some(v) = &init.hash_val {
+        B256::from(cx.val(v)?.to_be_bytes::<32>())
+    } else {
+        let mut b = Vec::new();
+        for s in init.segs.as_ref()? {
+            b.extend(cx.seg_bytes(s, None)?);
+        }
+        keccak256(&b)
+    };
+    let dims: Vec<usize> = rec.salt.segs.iter().enumerate().filter(|(_, s)| matches!(s, Seg::Index { .. } | Seg::Cdarr { .. })).map(|(i, _)| i).collect();
+    let mut out = Vec::new();
+    let mut probe_dim = None;
+    enum_rec(rec, &mut cx, &dims, 0, creator, ih, &mut out, &mut probe_dim)?;
+    // a computation over existing proxies whose count the record leaves open: keep the addresses up to the first
+    // without code (bisection over the enumerated progression)
+    if probe_dim.is_some() && !out.is_empty() {
+        let (mut lo, mut hi) = (0usize, out.len());
+        if !cx.st.has_code(out[0]) {
+            return Some(Vec::new())
+        }
+        while hi - lo > 1 {
+            let mid = (lo + hi) / 2;
+            if cx.st.has_code(out[mid]) { lo = mid } else { hi = mid }
+        }
+        out.truncate(hi);
+    }
+    Some(out)
+}
+
+#[allow(clippy::too_many_arguments)]
+fn enum_rec(rec: &Rec, cx: &mut Ctx<'_, '_>, dims: &[usize], d: usize, creator: Address, ih: B256, out: &mut Vec<Address>, probe_dim: &mut Option<usize>) -> Option<()> {
+    if out.len() >= C2_MAX {
+        return Some(())
+    }
+    if d == dims.len() {
+        let mut pre = Vec::new();
+        for (i, s) in rec.salt.segs.iter().enumerate() {
+            let w = cx.segvals.get(&i).copied();
+            pre.extend(cx.seg_bytes(s, w)?);
+        }
+        let salt = if rec.salt.form == "kec" { keccak256(&pre) } else if pre.len() == 32 { B256::from_slice(&pre) } else { return None };
+        out.push(crate::lx_create2(creator, U256::from_be_bytes(salt.0), ih));
+        return Some(())
+    }
+    let i = dims[d];
+    let seg = &rec.salt.segs[i];
+    let words: Vec<U256> = match seg {
+        Seg::Index { from, base, bound, count, .. } => {
+            let start = match from { Some(v) => cx.val(v)?, None => U256::ZERO }.wrapping_add(base.u());
+            let n = if let Some(b) = bound {
+                let b = cx.val(b)?;
+                if b > start { (b - start).min(U256::from(C2_MAX)).to::<usize>() } else { 0 }
+            } else if let Some(c) = count {
+                cx.val(c)?.min(U256::from(C2_MAX)).to::<usize>()
+            } else if let Some(c) = rule_count(rec, seg, cx.env.input) {
+                c
+            } else {
+                *probe_dim = Some(i);
+                C2_MAX
+            };
+            (0..n).map(|k| start.wrapping_add(U256::from(k))).collect()
+        }
+        Seg::Cdarr { off_word, first, stride, len, .. } => {
+            let o = word(cx.env.input, *off_word);
+            if o > U256::from(1u64 << 32) {
+                return None
+            }
+            let base = first + o.to::<usize>();
+            let n = match len {
+                Some(v) => cx.val(v)?.min(U256::from(C2_MAX)).to::<usize>(),
+                None => rule_count(rec, seg, cx.env.input).unwrap_or(1),
+            };
+            (0..n).map(|k| word(cx.env.input, base + stride * k)).collect()
+        }
+        _ => return None,
+    };
+    for w in words {
+        cx.segvals.insert(i, w);
+        enum_rec(rec, cx, dims, d + 1, creator, ih, out, probe_dim)?;
+        if out.len() >= C2_MAX {
+            break
+        }
+    }
+    cx.segvals.remove(&i);
+    Some(())
+}
+
+/// Storage overrides from the block's earlier transactions to the same contract and selector (`earlier`: their
+/// senders and calldata, in block order): each applies `rec.updates` in its own environment (per call: the delta; per
+/// proxy: the delta times its batch count).
+pub fn overrides(rec: &Rec, address: Address, earlier: &[(Address, &[u8])], st: &mut dyn State) -> HashMap<U256, U256> {
+    let mut ov: HashMap<U256, U256> = HashMap::new();
+    if rec.updates.is_empty() {
+        return ov
+    }
+    for &(sender, input) in earlier {
+        let env = Env { address, caller: sender, origin: sender, input };
+        let snapshot = ov.clone();
+        let mut cx = Ctx { env, st: &mut *st, ov: &snapshot, segvals: HashMap::new() };
+        let mut adds = Vec::new();
+        for u in &rec.updates {
+            let (Some(k), Some(d)) = (cx.val(&u.key), cx.val(&u.delta)) else { continue };
+            let d = if u.per == "item" { d.wrapping_mul(U256::from(lx_batch_count(input, 4).unwrap_or(0))) } else { d };
+            adds.push((k, d));
+        }
+        for (k, d) in adds {
+            let e = ov.entry(k).or_default();
+            *e = e.wrapping_add(d);
+        }
+    }
+    ov
+}
diff --git a/crates/eap-lx/src/lib.rs b/crates/eap-lx/src/lib.rs
new file mode 100644
index 0000000000000000000000000000000000000000..db9bc9de3f6086c09834f0767a345d9964e0c910
--- /dev/null
+++ b/crates/eap-lx/src/lib.rs
@@ -0,0 +1,717 @@
+//! EXP-130: loop-call extrapolation. Inner calls of a transaction are grouped by (selector, calldata length); on the
+//! first `n` calls of a group every 32-byte argument word, the target and the caller are fitted as a constant, a
+//! transaction-calldata word at `o + k * stride`, or (targets and callers) the k-th created address of one creator
+//! (CREATE nonce progression, CREATE2 salt progression, or a CREATE2 salt that is the hash of one template with a
+//! progressing word); the calls k >= n are then predicted. The node's prewarm inspector and the offline test bench
+//! (`eap-taint --lx-bench`) link this same module.
+
+use alloy_primitives::{keccak256, Address, Bytes, B256, U256};
+use std::collections::HashMap;
+
+pub mod c2rec;
+pub mod txdec;
+
+/// Parameters of the extrapolation (the node's `pwlxn`, `pwlxmax`, `pwlxc2`).
+#[derive(Debug, Clone, Copy)]
+pub struct LxParams {
+    /// calls observed before fitting
+    pub n: usize,
+    /// most predicted calls per group
+    pub max: usize,
+    /// fit created addresses (targets and callers that are the transaction's CREATE / CREATE2 results)
+    pub c2: bool,
+    /// verification gate: the fit's first `v` predicted calls are compared with the calls the worker then really
+    /// makes; the rest is handed out only when they match (0: hand out at the fit)
+    pub v: usize,
+    /// EXP-151 (`c2rec`): calls observed before fitting a group whose callers or targets lie on a known address
+    /// sequence (compile-time salt templates); 0: the known sequences are not used
+    pub known_n: usize,
+    /// EXP-151 (`pwlxcnt`): an unbounded group's count is capped by the number of same-selector inner calls a
+    /// structure decoder found in the transaction ([`LxTracker::dec_counts`])
+    pub cnt: bool,
+}
+
+/// One predicted inner call. `context` is the storage context (the target for CALL/STATICCALL, the delegating
+/// contract for DELEGATECALL/CALLCODE); `code_hint` skips the account read when the callee's code hash is known.
+#[derive(Debug, Clone)]
+pub struct LxCall {
+    pub kind: u8,
+    pub context: Address,
+    pub target: Address,
+    pub code_hint: Option<B256>,
+    pub payload: Vec<u8>,
+    /// the predicted frame's caller when it differs per call (a proxy per iteration calling one contract); `None`:
+    /// the group's first caller
+    pub caller: Option<Address>,
+    /// a created / computed address of an unbounded progression (count from the cap, not from the calldata): the
+    /// reader checks that it has code and stops the job at the first that has none (a claim over existing proxies
+    /// ends where the proxies end; a creating batch gives no such signal, its count comes from the calldata)
+    pub probe: Option<Address>,
+}
+
+/// An observed inner call: target (storage context), code hash, caller, calldata.
+pub type Seen = (Address, B256, Address, Bytes);
+
+/// How one 32-byte word (or the target / caller) of the predicted calls is derived.
+#[derive(Debug, Clone)]
+pub enum LxFit {
+    Const,
+    /// transaction calldata word at `o + k * stride` (byte offsets)
+    Cd(usize, usize),
+    /// CREATE2 (or CREATE with an all-zero hash) address of creator `creator` with salt `s0 + k * step`
+    Create { creator: Address, s0: U256, step: U256, hash: B256 },
+    /// CREATE2 address whose salt is keccak256 of `template` with the 32 bytes at byte offset `w` set to `v0 + k * step`
+    Create2Pre { creator: Address, hash: B256, template: Box<[u8]>, w: usize, v0: U256, step: U256 },
+    /// EXP-151: the `j0 + k`-th address of a known sequence (a compile-time salt template evaluated for this
+    /// transaction); the sequence's length is the count
+    Known { list: std::sync::Arc<[Address]>, j0: usize },
+}
+
+/// Why a group was not fitted.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum LxReject {
+    /// callers vary and are not created addresses in progression
+    Caller,
+    /// an argument word is neither constant nor a calldata progression
+    Word,
+    /// targets vary and are neither a calldata progression nor created addresses
+    Target,
+    /// nothing varies and no count: not a loop over calldata
+    Const,
+    /// a predicted call differed from the call the worker really made (verification gate)
+    Verify,
+}
+
+/// What a successful fit looked like.
+#[derive(Debug, Clone, Copy, Default)]
+pub struct LxFitInfo {
+    /// 0 constant target, 1 calldata target, 2 created target
+    pub target: u8,
+    pub caller_fit: bool,
+    /// the count came from an ABI length word or from adjacent arrays (else from the calldata end or the cap)
+    pub bounded: bool,
+    pub capped: bool,
+    /// predicted count of loop iterations (calls 0..count; calls n..count are returned)
+    pub count: usize,
+    /// a created progression shifted past the batches of earlier transactions: the worker's own later calls are
+    /// those of the first batch, so they cannot confirm the prediction (the verification gate is skipped)
+    pub shifted: bool,
+    /// EXP-151: callers or targets on a known address sequence (exact addresses and count; no gate, no shift)
+    pub known: bool,
+    /// EXP-151: the count was capped by the decoded inner calls of the transaction
+    pub dec_capped: bool,
+}
+
+#[derive(Debug, Default)]
+pub struct LxGroup {
+    /// the observed calls (the first `n`; with `keep_after`, every later call too)
+    pub seen: Vec<Seen>,
+    pub done: bool,
+    /// a fit waiting for verification: predicted calls, fit info, calls verified so far
+    pub pending: Option<(Vec<LxCall>, LxFitInfo, usize)>,
+}
+
+/// Outcome of observing one inner call.
+#[derive(Debug)]
+pub enum LxObserve {
+    /// not grouped (short input, code-less target, a proxy's repeated call, or the group is already fitted)
+    Skipped,
+    /// recorded, fewer than `n` calls so far
+    Pending,
+    /// the `n`-th call (or, with a verification gate, the call that completed the verification): the group was fitted;
+    /// `calls` are the calls still to predict (after the verified ones)
+    Fitted { key: (u32, usize, bool), seen: Vec<Seen>, calls: Vec<LxCall>, info: LxFitInfo },
+    /// the `n`-th call: the group was rejected
+    Rejected { key: (u32, usize, bool), reason: LxReject },
+}
+
+/// Per-transaction state: groups, created addresses and small keccak preimages.
+#[derive(Debug, Default)]
+pub struct LxTracker {
+    pub cur: u32,
+    /// groups keyed by (selector, calldata length, caller is a created / computed address of this transaction): an
+    /// entry's calls to its proxies and the proxies' calls onwards may share selector and length
+    pub groups: HashMap<(u32, usize, bool), LxGroup>,
+    /// addresses this transaction created (CREATE2: salt and init-code hash; CREATE: nonce and an all-zero hash) or
+    /// computed with a CREATE2 formula (an 85-byte 0xff-prefixed KECCAK256 preimage): address -> (creator, salt, hash)
+    pub c2obs: HashMap<Address, (Address, U256, B256)>,
+    /// small KECCAK256 preimages (hash -> preimage), so that a salt that is itself a hash can be traced to its loop
+    /// index (capped)
+    pub pre: HashMap<B256, Box<[u8]>>,
+    /// Cross-transaction shift of created-address progressions: the number of addresses that earlier transactions of
+    /// the block by the same sender to the same entry with the same selector create ([`lx_batch_count`]). The prewarm
+    /// worker runs this transaction on the pre-block state, so the creations it observes are those of the first such
+    /// batch; the real ones follow `shift` steps later, and all `count` calls are predicted (the observed ones too).
+    pub shift: usize,
+    /// addresses this transaction really created (CREATE / CREATE2 executed; computed CREATE2 addresses of a claim
+    /// over existing proxies do not count): the shift applies only to creating batches, whose index comes from a
+    /// storage counter the earlier batches advanced
+    pub n_created: usize,
+    /// EXP-151 (`c2rec`): the transaction's proxy address sequences known from compile-time salt templates (the true
+    /// sequences, used for prediction) and as this worker observes them (`known_view`, used for matching)
+    pub known: Vec<std::sync::Arc<[Address]>>,
+    pub known_view: Vec<std::sync::Arc<[Address]>>,
+    /// address -> (sequence, position) over `known`
+    pub known_pos: HashMap<Address, (usize, usize)>,
+    /// EXP-151 (`pwlxcnt`): per selector, inner calls a structure decoder found in the transaction's calldata
+    pub dec_counts: HashMap<u32, usize>,
+}
+
+/// Hash of empty code.
+pub const KECCAK256_EMPTY: B256 = alloy_primitives::KECCAK256_EMPTY;
+
+/// Byte offsets at which `word` occurs in `cd` (any alignment: arguments nested in a bytes parameter, such as a Safe
+/// transaction's data, are 32-byte aligned relative to the blob, not to the selector).
+pub fn lx_positions(cd: &[u8], word: &[u8]) -> Vec<usize> {
+    cd.windows(32).enumerate().filter(|(_, w)| *w == word).map(|(i, _)| i).collect()
+}
+
+/// EXP-159: positions in a transaction's calldata of a set of 32-byte words, found in one pass over the calldata. Fitting
+/// scanned the whole calldata once per word and observed call ([`lx_positions`]), then tried every pair of positions of
+/// the first two calls with a linear search in the others; on a 59.5 KB calldata in which the zero word occurs at 12,541
+/// byte offsets this ran for two minutes on one prewarm thread (EXP-159, block 26,229,740, transaction 139).
+#[derive(Debug, Default)]
+pub struct CdIndex {
+    pos: alloy_primitives::map::B256Map<Vec<usize>>,
+    len: usize,
+}
+
+impl CdIndex {
+    /// Positions (any byte alignment, as [`lx_positions`]) of each of `words` in `cd`.
+    pub fn new<'a>(cd: &[u8], words: impl IntoIterator<Item = &'a [u8]>) -> Self {
+        let mut pos = alloy_primitives::map::B256Map::<Vec<usize>>::default();
+        for w in words {
+            if w.len() == 32 {
+                pos.entry(B256::from_slice(w)).or_default();
+            }
+        }
+        if !pos.is_empty() && cd.len() >= 32 {
+            for i in 0..=cd.len() - 32 {
+                if let Some(v) = pos.get_mut(&B256::from_slice(&cd[i..i + 32])) {
+                    v.push(i);
+                }
+            }
+        }
+        Self { pos, len: cd.len() }
+    }
+
+    /// Positions of `word` (empty when it was not indexed or does not occur).
+    pub fn get(&self, word: &[u8]) -> &[usize] {
+        if word.len() != 32 {
+            return &[]
+        }
+        self.pos.get(&B256::from_slice(word)).map_or(&[], |v| &v[..])
+    }
+}
+
+/// EXP-159: (first-call position, second-call position) pairs one fit may try in [`lx_fit_words_ix`], over all its words;
+/// when the budget runs out the word counts as not fitted. The pair search is what grew without bound (two minutes on one
+/// transaction); the constant-word check of [`lx_const_as_array_ix`] is linear in the word's positions and has its own,
+/// larger cap ([`LX_CONST_CHECKS`]).
+pub const LX_FIT_CHECKS: usize = 1 << 16;
+
+/// EXP-159: positions one fit may test in [`lx_const_as_array_ix`], over all its constant words and strides (a safety cap
+/// only: at about 10 ns per position it bounds the check to tens of milliseconds).
+pub const LX_CONST_CHECKS: usize = 1 << 22;
+
+/// EXP-159: words whose pair search ran out of [`LX_FIT_CHECKS`] since the process started (for the node log).
+pub static LX_FIT_BUDGET_OUT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// EXP-159: constant-word checks that ran out of [`LX_CONST_CHECKS`] since the process started (for the node log).
+pub static LX_CONST_BUDGET_OUT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+fn spend(budget: &mut usize) -> bool {
+    if *budget == 0 {
+        LX_FIT_BUDGET_OUT.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        return false
+    }
+    *budget -= 1;
+    true
+}
+
+fn spend_const(budget: &mut usize) -> bool {
+    if *budget == 0 {
+        LX_CONST_BUDGET_OUT.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        return false
+    }
+    *budget -= 1;
+    true
+}
+
+/// Fit of `words` (one per observed call, in order) as a constant or a calldata progression.
+pub fn lx_fit_words(cd: &[u8], words: &[&[u8]]) -> Option<LxFit> {
+    if words.iter().all(|w| *w == words[0]) {
+        return Some(LxFit::Const)
+    }
+    let ix = CdIndex::new(cd, words.iter().copied());
+    let mut budget = LX_FIT_CHECKS;
+    lx_fit_words_ix(&ix, words, &mut budget)
+}
+
+/// [`lx_fit_words`] on a prebuilt index, with a shared budget of candidate checks. Same result as the per-word scan
+/// while the budget lasts: the first (x, y) in the order of the positions of the first and second call.
+pub fn lx_fit_words_ix(ix: &CdIndex, words: &[&[u8]], budget: &mut usize) -> Option<LxFit> {
+    if words.iter().all(|w| *w == words[0]) {
+        return Some(LxFit::Const)
+    }
+    if words.len() < 2 {
+        return None
+    }
+    // ascending positions: membership by binary search, nothing built per word
+    let rest: Vec<&[usize]> = words[2..].iter().map(|w| ix.get(w)).collect();
+    let ys = ix.get(words[1]);
+    for &x in ix.get(words[0]) {
+        // positions are ascending: the pairs with y <= x, which the per-word scan skipped one by one, are skipped at once
+        for &y in &ys[ys.partition_point(|&y| y <= x)..] {
+            if !spend(budget) {
+                return None
+            }
+            let st = y - x;
+            if rest.iter().enumerate().all(|(i, s)| s.binary_search(&(x + (i + 2) * st)).is_ok()) {
+                return Some(LxFit::Cd(x, st))
+            }
+        }
+    }
+    None
+}
+
+/// A word equal on the first `n` calls that is nevertheless an array entry: it occurs at `x + k * st` for k < n with the
+/// stride `st` of another progressing word, at an offset congruent to that word's array start, and the array goes on
+/// past the n-th entry.
+pub fn lx_const_as_array(cd: &[u8], word: &[u8], n: usize, strides: &[(usize, usize)]) -> Option<LxFit> {
+    let ix = CdIndex::new(cd, std::iter::once(word));
+    let mut budget = LX_CONST_CHECKS;
+    lx_const_as_array_ix(&ix, word, n, strides, &mut budget)
+}
+
+/// [`lx_const_as_array`] on a prebuilt index (EXP-159), with a shared cap of tested positions ([`LX_CONST_CHECKS`]).
+pub fn lx_const_as_array_ix(ix: &CdIndex, word: &[u8], n: usize, strides: &[(usize, usize)], budget: &mut usize) -> Option<LxFit> {
+    let ps = ix.get(word);
+    for &(o, st) in strides {
+        if st == 0 {
+            continue
+        }
+        for &x in ps {
+            if !spend_const(budget) {
+                return None
+            }
+            if (x.abs_diff(o)) % st == 0 && (1..n).all(|k| ps.binary_search(&(x + k * st)).is_ok()) && x + (n + 1) * st <= ix.len {
+                return Some(LxFit::Cd(x, st))
+            }
+        }
+    }
+    None
+}
+
+/// The batch count a transaction's calldata suggests: the smallest 32-byte word in [n, 4096] (a batch minter's number
+/// of proxies is an argument; offset words are larger); `None` without one.
+pub fn lx_batch_count(txin: &[u8], n: usize) -> Option<usize> {
+    if txin.len() < 36 {
+        return None
+    }
+    let mut best = usize::MAX;
+    for w in 0..(txin.len() - 4) / 32 {
+        let v = U256::from_be_slice(&txin[4 + 32 * w..36 + 32 * w]);
+        if v < U256::from(n) || v > U256::from(4096u32) {
+            continue
+        }
+        let v = v.to::<usize>();
+        // an ABI offset word (a multiple of 32 pointing at a length word inside the calldata) is not a count
+        if v % 32 == 0 && 4 + v + 32 <= txin.len() {
+            let lw = U256::from_be_slice(&txin[4 + v..36 + v]);
+            if lw <= U256::from((txin.len() - 4 - v) / 32) {
+                continue
+            }
+        }
+        best = best.min(v);
+    }
+    (best != usize::MAX).then_some(best)
+}
+
+/// CREATE2 address.
+pub fn lx_create2(caller: Address, salt: U256, init_hash: B256) -> Address {
+    let mut buf = [0u8; 85];
+    buf[0] = 0xff;
+    buf[1..21].copy_from_slice(caller.as_slice());
+    buf[21..53].copy_from_slice(&salt.to_be_bytes::<32>());
+    buf[53..85].copy_from_slice(init_hash.as_slice());
+    Address::from_slice(&keccak256(buf)[12..])
+}
+
+/// The address of creator `creator` with salt (or nonce, when `hash` is zero) `v`.
+pub fn lx_created(creator: Address, v: U256, hash: B256) -> Option<Address> {
+    if hash == B256::ZERO {
+        return Some(creator.create(v.try_into().ok()?))
+    }
+    Some(lx_create2(creator, v, hash))
+}
+
+/// The address a created-address fit gives for call `k`.
+pub fn lx_fit_addr(f: &LxFit, k: usize) -> Option<Address> {
+    match f {
+        LxFit::Create { creator, s0, step, hash } => lx_created(*creator, s0.wrapping_add(step.wrapping_mul(U256::from(k))), *hash),
+        LxFit::Known { list, j0 } => list.get(j0 + k).copied(),
+        LxFit::Create2Pre { creator, hash, template, w, v0, step } => {
+            let mut buf = template.to_vec();
+            buf[*w..*w + 32].copy_from_slice(&v0.wrapping_add(step.wrapping_mul(U256::from(k))).to_be_bytes::<32>());
+            Some(lx_create2(*creator, U256::from_be_bytes(keccak256(&buf).0), *hash))
+        }
+        _ => None,
+    }
+}
+
+impl LxTracker {
+    /// Starts a new transaction (the caller sets `shift` afterwards when it knows the block's earlier batches).
+    pub fn reset(&mut self, cur: u32) {
+        *self = Self { cur, ..Default::default() };
+    }
+
+    /// EXP-151: the transaction's known proxy address sequences (from salt templates), each as (view, truth): `view`
+    /// is what this worker observes (the transaction run on the block-start state), `truth` the sequence after the
+    /// block's earlier transactions advanced the counters (equal to `view` when none did). Observed addresses are matched
+    /// on `view`; predictions take `truth` at the same positions. Empty sequences are dropped.
+    pub fn set_known(&mut self, lists: Vec<(Vec<Address>, Vec<Address>)>) {
+        for (view, truth) in lists.into_iter().filter(|(v, t)| !v.is_empty() && !t.is_empty()) {
+            let i = self.known.len();
+            for (j, a) in view.iter().enumerate() {
+                self.known_pos.entry(*a).or_insert((i, j));
+            }
+            self.known_view.push(view.into());
+            self.known.push(truth.into());
+        }
+    }
+
+    /// EXP-151 (`pwlxcnt`): counts, per selector, the inner calls a structure decoder finds in the transaction's
+    /// calldata (a call to `to` with `txin`).
+    pub fn set_dec_counts(&mut self, to: Address, txin: &[u8]) {
+        let mut calls = Vec::new();
+        if txdec::txdec(to, to, txin, 4096, 3, &mut calls) {
+            for c in &calls {
+                if c.payload.len() >= 4 {
+                    *self.dec_counts.entry(u32::from_be_bytes([c.payload[0], c.payload[1], c.payload[2], c.payload[3]])).or_default() += 1;
+                }
+            }
+        }
+    }
+
+    /// EXP-151: the known sequence on which `addrs` lie consecutively, with the position of the first.
+    pub fn known_fit(&self, addrs: &[Address]) -> Option<LxFit> {
+        let &(i, j0) = self.known_pos.get(addrs.first()?)?;
+        let view = &self.known_view[i];
+        (j0 < self.known[i].len() && addrs.iter().enumerate().all(|(k, a)| view.get(j0 + k) == Some(a))).then(|| LxFit::Known { list: self.known[i].clone(), j0 })
+    }
+
+    /// A computed CREATE2 address (or any created address; see [`Self::created_real`]).
+    pub fn created(&mut self, caller: Address, salt: U256, init_hash: B256, created: Address) {
+        if self.c2obs.len() < 4096 {
+            self.c2obs.insert(created, (caller, salt, init_hash));
+        }
+    }
+
+    /// A CREATE / CREATE2 the transaction executed.
+    pub fn created_real(&mut self, caller: Address, salt: U256, init_hash: B256, created: Address) {
+        self.n_created += 1;
+        self.created(caller, salt, init_hash, created);
+    }
+
+    /// A KECCAK256 input of the transaction: an 85-byte 0xff-prefixed buffer is a CREATE2 address computation; other
+    /// small inputs are kept as possible salt preimages.
+    pub fn keccak(&mut self, m: &[u8]) {
+        if m.len() == 85 && m[0] == 0xff {
+            let creator = Address::from_slice(&m[1..21]);
+            let salt = U256::from_be_slice(&m[21..53]);
+            let hash = B256::from_slice(&m[53..85]);
+            let addr = Address::from_slice(&keccak256(m)[12..]);
+            self.created(creator, salt, hash, addr);
+        } else if (32..=160).contains(&m.len()) && self.pre.len() < 2048 {
+            // an 85-byte input that is not a CREATE2 address computation is a salt preimage like any other
+            // (EXP-145: 0x6ef3ef48's and 0x2f848984's templates are exactly 85 bytes; they were dropped before)
+            self.pre.entry(keccak256(m)).or_insert_with(|| m.to_vec().into_boxed_slice());
+        }
+    }
+
+    /// Records an inner call in its (selector, length) group; at the `n`-th call fits the group. With `keep_after`
+    /// the later calls of a fitted group are still recorded (for the offline comparison with the prediction).
+    #[allow(clippy::too_many_arguments)]
+    pub fn observe(&mut self, p: &LxParams, target: Address, code_hash: B256, caller: Address, input: Bytes, kind: u8, txin: &[u8], keep_after: bool) -> LxObserve {
+        if input.len() < 4 {
+            return LxObserve::Skipped
+        }
+        // a call to an address without code (e.g. the USDT distributor's probe call to address <count> before its
+        // transfers) carries nothing to extrapolate and would pollute the group's fit
+        if code_hash == KECCAK256_EMPTY || code_hash == B256::ZERO {
+            return LxObserve::Skipped
+        }
+        let sel = u32::from_be_bytes([input[0], input[1], input[2], input[3]]);
+        let key = (sel, input.len(), self.c2obs.contains_key(&caller));
+        let g = self.groups.entry(key).or_default();
+        if g.done && g.pending.is_none() && !keep_after {
+            return LxObserve::Skipped
+        }
+        // a proxy's delegatecall repeats the call it received (same context, caller and calldata); calls of one
+        // contract from different callers with the same calldata (clones calling XEN) are distinct iterations
+        if g.seen.last().is_some_and(|s| s.0 == target && s.2 == caller && s.3 == input) {
+            return LxObserve::Skipped
+        }
+        g.seen.push((target, code_hash, caller, input));
+        // verification gate: a pending fit is checked against the calls that really follow
+        if let Some((calls, _info, verified)) = g.pending.as_mut() {
+            let real = g.seen.last().unwrap();
+            let c = &calls[*verified];
+            let ok = c.target == real.0 && c.payload[..] == real.3[..] && c.caller.is_none_or(|a| a == real.2);
+            if !ok {
+                g.pending = None;
+                return LxObserve::Rejected { key, reason: LxReject::Verify }
+            }
+            *verified += 1;
+            if *verified < p.v.min(calls.len()) {
+                return LxObserve::Pending
+            }
+            let (mut calls, info, verified) = g.pending.take().unwrap();
+            calls.drain(..verified);
+            let seen = if keep_after { g.seen.clone() } else { std::mem::take(&mut g.seen) };
+            return if calls.is_empty() { LxObserve::Skipped } else { LxObserve::Fitted { key, seen, calls, info } }
+        }
+        if g.done {
+            return LxObserve::Skipped
+        }
+        // a group whose first call's caller or target lies on a known sequence is fitted after `known_n` calls
+        let need = match g.seen.first() {
+            Some(s) if p.known_n > 0 && (self.known_pos.contains_key(&s.2) || self.known_pos.contains_key(&s.0)) => p.known_n.min(p.n),
+            _ => p.n,
+        };
+        if g.seen.len() < need {
+            return LxObserve::Pending
+        }
+        g.done = true;
+        let seen = g.seen.clone();
+        let fit = self.fit(p, &seen, txin, kind);
+        let g = self.groups.get_mut(&key).unwrap();
+        match fit {
+            Ok((calls, info)) => {
+                // hold the prediction until the first v predicted calls are confirmed by the worker's real calls;
+                // not for shifted progressions (the worker runs the first batch, its calls never match the shifted
+                // prediction) nor when the prediction is no longer than the gate
+                if p.v > 0 && calls.len() > p.v && !info.shifted && !info.known {
+                    g.pending = Some((calls, info, 0));
+                    return LxObserve::Pending
+                }
+                if !keep_after {
+                    g.seen.clear();
+                }
+                LxObserve::Fitted { key, seen, calls, info }
+            }
+            Err(reason) => LxObserve::Rejected { key, reason },
+        }
+    }
+
+    /// Addresses (targets or callers of the observed calls) that are created or computed CREATE2 addresses of one
+    /// creator with one init code, with salts in progression or salts that are hashes of one template with a
+    /// progressing word (the loop index); `None` otherwise.
+    pub fn fit_created(&self, addrs: &[Address]) -> Option<LxFit> {
+        let n = addrs.len();
+        if !addrs.iter().all(|a| self.c2obs.contains_key(a)) {
+            return None
+        }
+        let o: Vec<(Address, U256, B256)> = addrs.iter().map(|a| self.c2obs[a]).collect();
+        if !o.iter().all(|x| x.0 == o[0].0 && x.2 == o[0].2) {
+            return None
+        }
+        let step = o[1].1.wrapping_sub(o[0].1);
+        if step != U256::ZERO && (2..n).all(|k| o[k].1.wrapping_sub(o[k - 1].1) == step) {
+            return Some(LxFit::Create { creator: o[0].0, s0: o[0].1, step, hash: o[0].2 })
+        }
+        let pres: Vec<&[u8]> = o.iter().filter_map(|x| self.pre.get(&B256::from(x.1)).map(|b| &b[..])).collect();
+        if pres.len() != n || pres.iter().any(|x| x.len() != pres[0].len() || x.len() < 32) {
+            return None
+        }
+        // the index word may sit at any byte offset (e.g. a 53-byte preimage 0x01 ++ index ++ user address)
+        for w in 0..=(pres[0].len() - 32) {
+            let v: Vec<U256> = pres.iter().map(|x| U256::from_be_slice(&x[w..w + 32])).collect();
+            let d = v[1].wrapping_sub(v[0]);
+            if d == U256::ZERO || !(2..n).all(|k| v[k].wrapping_sub(v[k - 1]) == d) {
+                continue
+            }
+            let others_equal = pres.iter().all(|x| x[..w] == pres[0][..w] && x[w + 32..] == pres[0][w + 32..]);
+            if others_equal {
+                return Some(LxFit::Create2Pre { creator: o[0].0, hash: o[0].2, template: pres[0].to_vec().into_boxed_slice(), w, v0: v[0], step: d })
+            }
+        }
+        None
+    }
+
+    /// Fits a group's words, targets and callers on the observed calls and returns the predicted calls k >= n.
+    pub fn fit(&self, p: &LxParams, seen: &[Seen], txin: &[u8], kind: u8) -> Result<(Vec<LxCall>, LxFitInfo), LxReject> {
+        let n = seen.len();
+        let mut info = LxFitInfo::default();
+        // the caller: constant, or a created / computed proxy per iteration
+        let cfit = if seen.iter().all(|s| s.2 == seen[0].2) {
+            None
+        } else if let Some(f) = (p.known_n > 0).then(|| self.known_fit(&seen.iter().map(|s| s.2).collect::<Vec<_>>())).flatten() {
+            info.known = true;
+            Some(f)
+        } else if p.c2 {
+            let callers: Vec<Address> = seen.iter().map(|s| s.2).collect();
+            Some(self.fit_created(&callers).ok_or(LxReject::Caller)?)
+        } else {
+            return Err(LxReject::Caller)
+        };
+        let len = seen[0].3.len();
+        let nw = (len - 4) / 32;
+        // EXP-159: one pass over the calldata for every word of the observed calls and their targets, and one budget
+        // of candidate checks for the whole fit
+        let twords: Vec<[u8; 32]> = seen.iter().map(|s| { let mut b = [0u8; 32]; b[12..].copy_from_slice(s.0.as_slice()); b }).collect();
+        let ix = CdIndex::new(
+            txin,
+            seen.iter().flat_map(|s| (0..nw).map(move |w| &s.3[4 + 32 * w..4 + 32 * (w + 1)])).chain(twords.iter().map(|w| &w[..])),
+        );
+        let mut budget = LX_FIT_CHECKS;
+        let mut const_budget = LX_CONST_CHECKS;
+        let mut fits = Vec::with_capacity(nw);
+        for w in 0..nw {
+            let words: Vec<&[u8]> = seen.iter().map(|s| &s.3[4 + 32 * w..4 + 32 * (w + 1)]).collect();
+            fits.push(lx_fit_words_ix(&ix, &words, &mut budget).ok_or(LxReject::Word)?);
+        }
+        // a word equal on the first n calls may still be an array entry (the USDT distributor's token array starts
+        // with n equal tokens): when another word progresses with stride `st`, a constant word found at x, x + st, ...
+        // in the calldata, at an offset congruent to that array's start, is taken as the parallel array
+        let strides: Vec<(usize, usize)> = fits.iter().filter_map(|f| if let LxFit::Cd(o, st) = f { Some((*o, *st)) } else { None }).collect();
+        if !strides.is_empty() {
+            for w in 0..nw {
+                if matches!(fits[w], LxFit::Const) {
+                    if let Some(f) = lx_const_as_array_ix(&ix, &seen[0].3[4 + 32 * w..4 + 32 * (w + 1)], n, &strides, &mut const_budget) {
+                        fits[w] = f;
+                    }
+                }
+            }
+        }
+        // the target: constant, a calldata word, or a created-address progression
+        let tfit = if seen.iter().all(|s| s.0 == seen[0].0) {
+            match lx_const_as_array_ix(&ix, &twords[0], n, &strides, &mut const_budget) {
+                Some(f) => {
+                    info.target = 1;
+                    f
+                }
+                None => LxFit::Const,
+            }
+        } else if let Some(f) = (p.known_n > 0).then(|| self.known_fit(&seen.iter().map(|s| s.0).collect::<Vec<_>>())).flatten() {
+            info.target = 2;
+            info.known = true;
+            f
+        } else if p.c2 && seen.iter().all(|s| self.c2obs.contains_key(&s.0)) {
+            let targets: Vec<Address> = seen.iter().map(|s| s.0).collect();
+            info.target = 2;
+            self.fit_created(&targets).ok_or(LxReject::Target)?
+        } else {
+            let refs: Vec<&[u8]> = twords.iter().map(|w| &w[..]).collect();
+            info.target = 1;
+            match lx_fit_words_ix(&ix, &refs, &mut budget) { Some(LxFit::Cd(o, st)) => LxFit::Cd(o, st), _ => return Err(LxReject::Target) }
+        };
+        // the code of the predicted callees: known when the targets are constant or are the created proxies (the
+        // delegate's code); otherwise the reader reads the account
+        let code_hint = if seen.iter().all(|s| s.1 == seen[0].1) && !matches!(tfit, LxFit::Cd(..)) { Some(seen[0].1) } else { None };
+        // how many calls: the ABI length word before the first progressed array when plausible, else the calldata end
+        let mut count = p.max;
+        let mut bounded = false;
+        for f in fits.iter().chain(std::iter::once(&tfit)) {
+            if let LxFit::Cd(o, st) = f {
+                let (o, st) = (*o, *st);
+                let by_end = (txin.len().saturating_sub(o)) / st;
+                if o >= 36 {
+                    let lw = U256::from_be_slice(&txin[o - 32..o]);
+                    if lw > U256::ZERO && lw <= U256::from(by_end.max(1)) && lw <= U256::from(4096u32) {
+                        count = count.min(lw.to::<usize>());
+                        bounded = true;
+                    }
+                }
+                count = count.min(by_end);
+            }
+        }
+        // several arrays progressing with one stride lie one after another in the calldata (ABI arrays of one length):
+        // the number of entries is the distance between the starts of adjacent arrays divided by the stride
+        {
+            let mut cds: Vec<(usize, usize)> = fits.iter().chain(std::iter::once(&tfit)).filter_map(|f| if let LxFit::Cd(o, st) = f { Some((*o, *st)) } else { None }).collect();
+            cds.sort_unstable();
+            cds.dedup();
+            for i in 1..cds.len() {
+                let ((o1, st1), (o2, st2)) = (cds[i - 1], cds[i]);
+                if st1 == st2 && st1 > 0 && (o2 - o1) % st1 == 0 && (o2 - o1) / st1 >= n {
+                    count = count.min((o2 - o1) / st1);
+                    bounded = true;
+                }
+            }
+        }
+        if !bounded && cfit.is_none() && matches!(tfit, LxFit::Const) && fits.iter().all(|f| matches!(f, LxFit::Const)) {
+            return Err(LxReject::Const) // nothing varies: not a loop over calldata
+        }
+        // EXP-151: a known sequence gives the count exactly (the iterations from the first observed call to its end); it
+        // replaces the calldata rules, within the cap
+        let mut kc: Option<usize> = None;
+        for f in cfit.iter().chain(std::iter::once(&tfit)) {
+            if let LxFit::Known { list, j0 } = f {
+                let c = list.len() - j0;
+                kc = Some(kc.map_or(c, |x| x.min(c)));
+            }
+        }
+        if let Some(c) = kc {
+            count = c.min(p.max);
+            bounded = true;
+        }
+        // EXP-151 (`pwlxcnt`): a structure-decoded transaction (Safe, MultiSend, Multicall3, handleOps) gives the
+        // number of its inner calls with this selector: an unbounded group does not predict more
+        if p.cnt && !bounded {
+            let sel = u32::from_be_bytes([seen[0].3[0], seen[0].3[1], seen[0].3[2], seen[0].3[3]]);
+            if let Some(&c) = self.dec_counts.get(&sel) {
+                if c >= n {
+                    count = count.min(c);
+                    bounded = true;
+                    info.dec_capped = true;
+                }
+            }
+        }
+        info.caller_fit = cfit.is_some();
+        info.bounded = bounded;
+        info.capped = count >= p.max || (!bounded && count == 256);
+        if !bounded && (cfit.is_some() || matches!(tfit, LxFit::Create { .. } | LxFit::Create2Pre { .. })) {
+            // the creation count is not in a recognisable place: the smallest calldata word in [n, 4096] (a batch
+            // minter's number of proxies is an argument; an offset word is larger) bounds it, else 256. Over-prediction
+            // costs useless reads of the keys of proxies that are never created (6 keys per call on XEN), so the
+            // smaller candidate is taken
+            count = count.min(lx_batch_count(txin, n).unwrap_or(256));
+        }
+        info.count = count;
+        // a shifted created progression: the observed calls belong to an earlier batch, every call is predicted
+        let created = cfit.is_some() || matches!(tfit, LxFit::Create { .. } | LxFit::Create2Pre { .. });
+        let shift = if created && self.n_created > 0 && !info.known { self.shift } else { 0 };
+        info.shifted = shift > 0;
+        let probe_needed = created && !bounded && self.n_created == 0;
+        let mut out = Vec::new();
+        'calls: for k in (if shift > 0 { 0 } else { n })..count {
+            let mut payload = seen[0].3.to_vec();
+            for (w, f) in fits.iter().enumerate() {
+                if let LxFit::Cd(o, st) = f {
+                    let pos = *o + k * *st;
+                    if pos + 32 > txin.len() {
+                        break 'calls
+                    }
+                    payload[4 + 32 * w..4 + 32 * (w + 1)].copy_from_slice(&txin[pos..pos + 32]);
+                }
+            }
+            let target = match &tfit {
+                LxFit::Const => seen[0].0,
+                LxFit::Cd(o, st) => {
+                    let pos = o + k * st;
+                    if pos + 32 > txin.len() {
+                        break
+                    }
+                    Address::from_slice(&txin[pos + 12..pos + 32])
+                }
+                f => match lx_fit_addr(f, k + shift) { Some(a) => a, None => break },
+            };
+            let caller = match &cfit { Some(f) => match lx_fit_addr(f, k + shift) { Some(a) => Some(a), None => break }, None => None };
+            let probe = if probe_needed { caller.or(Some(target)) } else { None };
+            out.push(LxCall { kind, context: target, target, code_hint, payload, caller, probe });
+        }
+        if out.is_empty() { Err(LxReject::Const) } else { Ok((out, info)) }
+    }
+}
diff --git a/crates/eap-lx/src/txdec.rs b/crates/eap-lx/src/txdec.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ddffeebe905679267ba82fc27a1abb795e2302d5
--- /dev/null
+++ b/crates/eap-lx/src/txdec.rs
@@ -0,0 +1,204 @@
+//! EXP-130 (merged from EXP-134's eap-x131 decoder): inner calls that an entry transaction's calldata gives in clear,
+//! decoded at transaction arrival without executing anything — Safe `execTransaction` (and its `multiSend` payload),
+//! Multicall3 `aggregate*`, ERC-4337 `handleOps`, and a contract's own `multicall(bytes[])`. Decoded calls whose
+//! payload is again one of these structures are decoded recursively (EXP-142: a Safe calling a distributor's
+//! `multicall(bytes[])` which transfers), to `depth` levels. The calls are returned as [`LxCall`]s for the reader's
+//! shared path (`lx_follow`), as a complement to the loop extrapolation for the entry's first call.
+
+use crate::LxCall;
+use alloy_primitives::Address;
+
+const SEL_EXEC_TRANSACTION: [u8; 4] = [0x6a, 0x76, 0x12, 0x02];
+const SEL_MULTI_SEND: [u8; 4] = [0x8d, 0x80, 0xff, 0x0a];
+const SEL_AGGREGATE: [u8; 4] = [0x25, 0x2d, 0xba, 0x42];
+const SEL_TRY_AGGREGATE: [u8; 4] = [0xbc, 0xe3, 0x8b, 0xd7];
+const SEL_AGGREGATE3: [u8; 4] = [0x82, 0xad, 0x56, 0xcb];
+const SEL_AGGREGATE3_VALUE: [u8; 4] = [0x17, 0x4d, 0xea, 0x71];
+const SEL_HANDLE_OPS_V6: [u8; 4] = [0x1f, 0xad, 0x94, 0x8c];
+const SEL_HANDLE_OPS_V7: [u8; 4] = [0x76, 0x5e, 0x82, 0x7f];
+const SEL_SELF_MULTICALL: [u8; 4] = [0xac, 0x96, 0x50, 0xd8];
+const SEL_SELF_MULTICALL_DEADLINE: [u8; 4] = [0x5a, 0xe4, 0x01, 0xdc];
+const SEL_SELF_MULTICALL_PREV: [u8; 4] = [0x1f, 0x04, 0x64, 0xd1];
+
+/// Which structure a selector is (None: not a decodable structure).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum TxDecKind {
+    Safe,
+    MultiSend,
+    Multicall3,
+    HandleOps,
+    SelfMulticall,
+}
+
+/// The structure kind of `input`'s selector.
+pub fn txdec_kind(input: &[u8]) -> Option<TxDecKind> {
+    let sel: [u8; 4] = input.get(..4)?.try_into().ok()?;
+    Some(match sel {
+        SEL_EXEC_TRANSACTION => TxDecKind::Safe,
+        SEL_MULTI_SEND => TxDecKind::MultiSend,
+        SEL_AGGREGATE | SEL_TRY_AGGREGATE | SEL_AGGREGATE3 | SEL_AGGREGATE3_VALUE => TxDecKind::Multicall3,
+        SEL_HANDLE_OPS_V6 | SEL_HANDLE_OPS_V7 => TxDecKind::HandleOps,
+        SEL_SELF_MULTICALL | SEL_SELF_MULTICALL_DEADLINE | SEL_SELF_MULTICALL_PREV => TxDecKind::SelfMulticall,
+        _ => return None,
+    })
+}
+
+/// Decodes the inner calls of a call to `to` with calldata `input` (storage context `context`: `to` for a CALL, the
+/// delegating contract for a DELEGATECALL), recursively to `depth` levels, at most `max` calls in all. Returns whether
+/// the selector was a decodable structure. Decoded calls carry no code hint; the reader resolves the callee's code.
+pub fn txdec(to: Address, context: Address, input: &[u8], max: usize, depth: u32, out: &mut Vec<LxCall>) -> bool {
+    let Some(kind) = txdec_kind(input) else { return false };
+    let mut calls = Vec::new();
+    let ok = match kind {
+        TxDecKind::Safe => txdec_safe(context, input, max, &mut calls),
+        TxDecKind::MultiSend => txdec_multisend(context, &input[4..], max, &mut calls),
+        TxDecKind::Multicall3 => txdec_multicall(input, max, &mut calls),
+        TxDecKind::HandleOps => txdec_handleops(input, max, &mut calls),
+        TxDecKind::SelfMulticall => txdec_self_multicall(context, input, max, &mut calls),
+    };
+    if !ok {
+        return false
+    }
+    let _ = to;
+    for c in calls {
+        if out.len() >= max {
+            break
+        }
+        // a decoded call that is itself a structure: its own inner calls replace it (the structure's frame reads
+        // little); the context of a DELEGATECALL element stays the delegating contract
+        if depth > 0 && txdec_kind(&c.payload).is_some() {
+            let mut inner = Vec::new();
+            if txdec(c.target, c.context, &c.payload, max - out.len(), depth - 1, &mut inner) && !inner.is_empty() {
+                out.extend(inner);
+                continue
+            }
+        }
+        out.push(c);
+    }
+    true
+}
+
+/// ABI word at `off` as a small unsigned integer (None when it does not fit in 64 bits).
+fn abi_u(d: &[u8], off: usize) -> Option<usize> {
+    let w = d.get(off..off + 32)?;
+    if w[..24] != [0u8; 24] {
+        return None
+    }
+    Some(u64::from_be_bytes(w[24..].try_into().ok()?) as usize)
+}
+
+/// ABI word at `off` as an address (None when the high 12 bytes are not zero).
+fn abi_addr(d: &[u8], off: usize) -> Option<Address> {
+    let w = d.get(off..off + 32)?;
+    if w[..12] != [0u8; 12] {
+        return None
+    }
+    Some(Address::from_slice(&w[12..]))
+}
+
+/// A `bytes` value whose offset word is at `off_word`, the offset being relative to `base` (the enclosing tuple).
+fn abi_bytes(d: &[u8], base: usize, off_word: usize) -> Option<&[u8]> {
+    let off = base.checked_add(abi_u(d, off_word)?)?;
+    let len = abi_u(d, off)?;
+    d.get(off.checked_add(32)?..off.checked_add(32)?.checked_add(len)?)
+}
+
+fn call(kind: u8, context: Address, target: Address, data: &[u8]) -> LxCall {
+    LxCall { kind, context, target, code_hint: None, payload: data.to_vec(), caller: None, probe: None }
+}
+
+/// `multicall(bytes[])` and its deadline / previous-blockhash variants (Uniswap periphery style): every element is a
+/// DELEGATECALL of the contract to itself.
+fn txdec_self_multicall(me: Address, input: &[u8], max: usize, out: &mut Vec<LxCall>) -> bool {
+    let sel: [u8; 4] = input[..4].try_into().unwrap();
+    let d = &input[4..];
+    let head = if sel == SEL_SELF_MULTICALL { 0 } else { 32 };
+    let Some(arr) = abi_u(d, head) else { return false };
+    let Some(n) = abi_u(d, arr) else { return false };
+    let elems = arr + 32;
+    for i in 0..n.min(max) {
+        let Some(data) = abi_bytes(d, elems, elems + 32 * i) else { break };
+        if out.len() >= max {
+            break
+        }
+        out.push(call(2, me, me, data));
+    }
+    true
+}
+
+/// Safe `execTransaction(to, value, data, operation, ...)`: the inner call, unpacked when `data` is a `multiSend`
+/// (operation 1 is a DELEGATECALL in the Safe's context).
+fn txdec_safe(safe: Address, input: &[u8], max: usize, out: &mut Vec<LxCall>) -> bool {
+    let d = &input[4..];
+    let (Some(to), Some(op)) = (abi_addr(d, 0), abi_u(d, 96)) else { return false };
+    let Some(data) = abi_bytes(d, 0, 64) else { return false };
+    if data.len() >= 4 && data[..4] == SEL_MULTI_SEND {
+        return txdec_multisend(safe, &data[4..], max, out)
+    }
+    if out.len() < max {
+        let (kind, context) = if op == 1 { (2u8, safe) } else { (0u8, to) };
+        out.push(call(kind, context, to, data));
+    }
+    true
+}
+
+/// `multiSend(bytes)` payload (packed `operation(1) to(20) value(32) len(32) data`), executed in `context` (the Safe
+/// delegate-calls the MultiSend library).
+fn txdec_multisend(context: Address, d: &[u8], max: usize, out: &mut Vec<LxCall>) -> bool {
+    let Some(packed) = abi_bytes(d, 0, 0) else { return false };
+    let mut p = 0;
+    while p + 85 <= packed.len() && out.len() < max {
+        let op = packed[p] as usize;
+        let to = Address::from_slice(&packed[p + 1..p + 21]);
+        let Some(len) = abi_u(packed, p + 53) else { break };
+        let Some(data) = packed.get(p + 85..p + 85 + len) else { break };
+        let (kind, ctx) = if op == 1 { (2u8, context) } else { (0u8, to) };
+        out.push(call(kind, ctx, to, data));
+        p += 85 + len;
+    }
+    true
+}
+
+/// Multicall3 `aggregate(Call[])`, `tryAggregate(bool, Call[])`, `aggregate3(Call3[])`, `aggregate3Value(Call3Value[])`.
+fn txdec_multicall(input: &[u8], max: usize, out: &mut Vec<LxCall>) -> bool {
+    let sel: [u8; 4] = input[..4].try_into().unwrap();
+    let d = &input[4..];
+    let (head, data_word) = match sel {
+        SEL_AGGREGATE => (0usize, 1usize),
+        SEL_TRY_AGGREGATE => (32, 1),
+        SEL_AGGREGATE3 => (0, 2),
+        SEL_AGGREGATE3_VALUE => (0, 3),
+        _ => return false,
+    };
+    let Some(arr) = abi_u(d, head) else { return false };
+    let Some(n) = abi_u(d, arr) else { return false };
+    let elems = arr + 32;
+    for i in 0..n.min(max) {
+        let Some(off) = abi_u(d, elems + 32 * i) else { break };
+        let base = elems + off;
+        let (Some(target), Some(data)) = (abi_addr(d, base), abi_bytes(d, base, base + 32 * data_word)) else { break };
+        if out.len() >= max {
+            break
+        }
+        out.push(call(0, target, target, data));
+    }
+    true
+}
+
+/// ERC-4337 `handleOps(ops[], beneficiary)` (v0.6 and v0.7): each account's `callData` call from the entry point.
+fn txdec_handleops(input: &[u8], max: usize, out: &mut Vec<LxCall>) -> bool {
+    let d = &input[4..];
+    let Some(arr) = abi_u(d, 0) else { return false };
+    let Some(n) = abi_u(d, arr) else { return false };
+    let elems = arr + 32;
+    for i in 0..n.min(max) {
+        let Some(off) = abi_u(d, elems + 32 * i) else { break };
+        let base = elems + off;
+        let (Some(sender), Some(data)) = (abi_addr(d, base), abi_bytes(d, base, base + 32 * 3)) else { break };
+        if out.len() >= max {
+            break
+        }
+        out.push(call(0, sender, sender, data));
+    }
+    true
+}
