+#[cfg(test)]
+mod x027_shard_tests {
+    use super::*;
+
+    /// The sharded prewarm key registry holds what the single map held: the first source that tagged a key, for any
+    /// order of tagging, from one thread or several; a reset empties it.
+    #[test]
+    fn sharded_tags_equal_the_single_map() {
+        let shards = CcTagShards::default();
+        let mut reference = CcPrewarmTags::default();
+        let mut seed = 0x9e37_79b9_7f4a_7c15u64;
+        let mut next = || {
+            seed ^= seed << 13;
+            seed ^= seed >> 7;
+            seed ^= seed << 17;
+            seed
+        };
+        for n in 0..20_000u64 {
+            let a = Address::with_last_byte((next() % 200) as u8);
+            let k = StorageKey::from(U256::from(next() % 50));
+            let h = B256::with_last_byte((next() % 250) as u8);
+            let src = (next() % 9) as u8;
+            match n % 3 {
+                0 => {
+                    shards.tag_account(&a, src);
+                    reference.accounts.entry(a).or_insert(src);
+                }
+                1 => {
+                    shards.tag_storage(a, k, src, n);
+                    reference.storage.entry((a, k)).or_insert((src, n));
+                }
+                _ => {
+                    shards.tag_code(&h, src);
+                    reference.code.entry(h).or_insert(src);
+                }
+            }
+        }
+        for (a, s) in &reference.accounts {
+            assert_eq!(shards.account(a), Some(*s));
+        }
+        for ((a, k), v) in &reference.storage {
+            assert_eq!(shards.storage(*a, *k), Some(*v));
+        }
+        for (h, s) in &reference.code {
+            assert_eq!(shards.code(h), Some(*s));
+        }
+        let held: usize = shards.0.iter().map(|sh| sh.read().storage.len()).sum();
+        assert_eq!(held, reference.storage.len());
+        assert_eq!(shards.account(&Address::with_last_byte(250)), None);
+
+        // several threads tagging the same keys: each key holds one of the sources that tagged it, exactly once
+        let shared = Arc::new(CcTagShards::default());
+        let threads: Vec<_> = (0..8u8)
+            .map(|src| {
+                let s = shared.clone();
+                std::thread::spawn(move || {
+                    for j in 0..2_000u64 {
+                        s.tag_storage(Address::with_last_byte((j % 64) as u8), StorageKey::from(U256::from(j)), src, j);
+                    }
+                })
+            })
+            .collect();
+        for t in threads {
+            t.join().unwrap();
+        }
+        for j in 0..2_000u64 {
+            let (src, t) = shared.storage(Address::with_last_byte((j % 64) as u8), StorageKey::from(U256::from(j))).unwrap();
+            assert!(src < 8 && t == j);
+        }
+        shared.clear();
+        assert_eq!(shared.storage(Address::with_last_byte(1), StorageKey::from(U256::from(1))), None);
+    }
+
+    /// The buffered per-transaction records end as the records written in place did: dispatch, worker start / skip / end,
+    /// execution start / end and lookup counters, from several threads; a later read applies records added since.
+    #[test]
+    fn buffered_diag_records_equal_direct_ones() {
+        let b = Arc::new(DiagBlock::new(0, false));
+        // dispatch thread, then two prewarm workers, as the prewarm task orders them
+        b.pw_dispatch(0, false);
+        b.pw_dispatch(1, false);
+        b.pw_dispatch(2, true);
+        let w = {
+            let b = b.clone();
+            std::thread::spawn(move || {
+                b.pw_start(0);
+                b.pw_end(0, true);
+                b.pw_skip(1, diag_status::SKIP_WORKER);
+                b.event("tw_enter");
+            })
+        };
+        w.join().unwrap();
+        let w = {
+            let b = b.clone();
+            std::thread::spawn(move || {
+                b.pw_start(3);
+                b.pw_end(3, false);
+            })
+        };
+        w.join().unwrap();
+        // execution-thread lookup counters of transaction 0 and the post-execution part
+        b.push(DiagEv::Exec { i: 0, t: 0, lk: [1, 2, 3, 4], misses: Vec::new(), other: Vec::new(), frames: Vec::new() });
+        b.push(DiagEv::Exec { i: 0, t: 0, lk: [1, 0, 0, 1], misses: Vec::new(), other: Vec::new(), frames: Vec::new() });
+        b.push(DiagEv::Exec { i: DIAG_POST, t: 0, lk: [0, 0, 5, 0], misses: Vec::new(), other: Vec::new(), frames: Vec::new() });
+        b.push(DiagEv::ExecStart { i: 0, t: 0 });
+        b.push(DiagEv::ExecEnd { i: 0, t: 0 });
+        assert_eq!(b.tx_times(0).map(|x| x.0), Some(diag_status::DONE));
+        assert_eq!(b.tx_times(1).map(|x| x.0), Some(diag_status::SKIP_WORKER));
+        assert_eq!(b.tx_times(2).map(|x| x.0), Some(diag_status::SKIP_DISPATCH));
+        assert_eq!(b.tx_times(3).map(|x| x.0), Some(diag_status::ERROR));
+        let g = b.inner.lock();
+        assert_eq!(g.txs[0].lk, [2, 2, 3, 5]);
+        assert_eq!(g.post, [0, 0, 5, 0]);
+        assert_eq!(g.events.iter().map(|e| e.0).collect::<Vec<_>>(), ["tw_enter"]);
+        drop(g);
+        // records added after a read are applied by the next read
+        b.pw_dispatch(4, false);
+        assert_eq!(b.tx_times(4).map(|x| x.0), Some(diag_status::DISPATCHED));
+    }
+}
