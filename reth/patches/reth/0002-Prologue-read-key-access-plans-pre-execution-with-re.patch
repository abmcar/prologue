+
+thread_local! {
+    /// Placeholder kind of the active speculative run (0: value 1, 1: every byte 0x01).
+    static CC_PH: Cell<u8> = const { Cell::new(0) };
+    /// Prewarm transaction on this thread: (slots read from the backend so far, discovery trigger, handed over).
+    static CC_TX: Cell<(u32, u32, u8)> = const { Cell::new((0, 0, 0)) };
