+    /// X-029 (`EWF_RECRT`): without a reserved set or without `exrt` nothing changes; at the limit (the set's CPUs less
+    /// one) a piece is left as it was and counted; otherwise the thread runs as SCHED_FIFO inside the set while the
+    /// guard lives and gets its class, nice value and CPU set back when it drops, or the change is refused (no
+    /// RLIMIT_RTPRIO), counted, and the thread stays as it was. A thread of its own; no other test uses the counts.
+    #[test]
+    fn recovery_rt_raises_within_the_set_and_restores() {
+        std::thread::spawn(|| {
+            // SAFETY: getpriority / sched_getscheduler read the calling thread only; CPU_* only touch the given sets.
+            let pol = || unsafe { libc::sched_getscheduler(0) } & !libc::SCHED_RESET_ON_FORK;
+            let nice = || unsafe { libc::getpriority(libc::PRIO_PROCESS, 0) };
+            let (pol0, nice0) = (pol(), nice());
+            let full = own_affinity().expect("the thread's CPU set");
+            let same = |s: &libc::cpu_set_t| unsafe { libc::CPU_EQUAL(&own_affinity().unwrap(), s) };
+            let cpus: Vec<usize> =
+                (0..libc::CPU_SETSIZE as usize).filter(|c| unsafe { libc::CPU_ISSET(*c, &full) }).collect();
+            assert!(recovery_rt_enter_with(1, None).is_none());
+            if cpus.len() < 3 || (pol0 != libc::SCHED_OTHER && pol0 != libc::SCHED_BATCH) {
+                return
+            }
+            // a set of two CPUs without the lowest: one thread at a time
+            let mut two: libc::cpu_set_t = unsafe { std::mem::zeroed() };
+            unsafe {
+                libc::CPU_SET(cpus[1], &mut two);
+                libc::CPU_SET(cpus[2], &mut two);
+            }
+            let count = |k: usize| REC_RT_COUNTS[k].load(Ordering::Relaxed);
+            assert!(recovery_rt_enter_with(0, Some(two)).is_none());
+            assert!(pol() == pol0 && same(&full));
+            REC_RT_RUNNING.fetch_add(1, Ordering::AcqRel);
+            let full0 = count(1);
+            assert!(recovery_rt_enter_with(1, Some(two)).is_none());
+            assert!(count(1) > full0 && pol() == pol0 && same(&full));
+            REC_RT_RUNNING.fetch_sub(1, Ordering::AcqRel);
+            let (raised0, refused0) = (count(0), count(2));
+            match recovery_rt_enter_with(1, Some(two)) {
+                Some(g) => {
+                    assert!(count(0) > raised0);
+                    assert_eq!(pol(), libc::SCHED_FIFO);
+                    assert!(same(&two));
+                    drop(g);
+                    assert!(pol() == pol0 && nice() == nice0 && same(&full));
+                }
+                None => assert!(count(2) > refused0 && pol() == pol0 && same(&full)),
+            }
+            assert_eq!(REC_RT_RUNNING.load(Ordering::Acquire), 0);
+        })
+        .join()
+        .unwrap();
+    }
