+#[derive(Debug, Default)]
+struct Issued {
+    /// (state, tag source of the prediction that issued the slot); state 0 predicted and queued,
+    /// 1 being read, 2 read
+    slots: HashMap<(Address, B256), (u8, u8)>,
+    accounts: HashSet<Address>,
+    codes: HashSet<B256>,
+    /// EXP-112 round 2: keys the execution thread missed while they were not issued (to count keys issued after their miss began).
+    missed: HashSet<(Address, B256)>,
+    /// EXP-199 (`iqc`): read slots a reader read from the backend (the others were in the execution cache already).
+    iqc_disk: HashSet<(Address, B256)>,
+}
+
+/// EXP-112 round 2: a key newly issued by `src`; counts it when the execution thread already missed it.
+fn note_issue(g: &Issued, stats: &Stats, a: Address, k: B256, src: u8) {
+    if LIC.load(Ordering::Relaxed) && g.missed.contains(&(a, k)) {
+        stats.late_issue_src[src_index(src)].fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+struct Reader {
+    provider: EvmStateProviderBox,
+    mode: Mode,
+    info: BlockInfo,
+    stats: Arc<Stats>,
+    issued: Arc<Mutex<Issued>>,
+    sc: ReaderScratch,
+    sl_tx: Sender<Item>,
+    /// Low-priority queue for storage-discovery keys (`sdlow=1`).
+    lo_tx: Sender<Item>,
+    /// Exit once the transaction channel is closed and no handed-out slot is left (mempool
+    /// stage); block-time readers run until stopped.
+    idle_exit: bool,
+    /// The execution thread's next transaction index (prewarm-worker jobs, `pwstale`).
+    exec_idx: Option<Arc<AtomicUsize>>,
+    /// Shared priority queue of prewarm-worker jobs (`pwprio`).
+    pwq: Option<Arc<Mutex<PwQueue>>>,
+    /// EXP-150: the block's stop flag (checked before each slot read when `rdstop=1`)
+    stop: Arc<AtomicBool>,
+    /// EXP-174 (`pwlxrd`): an extra reader waits behind this gate before its loop
+    gate: Option<Arc<LxGate>>,
+    /// EXP-199 (`rdpeek`): the block's execution cache, looked up before a read (`None`: the switch is off or the block has
+    /// no execution cache)
+    caches: Option<reth_execution_cache::ExecutionCache>,
+    /// EXP-240 (`accwarm`): the provider factory without the execution cache and, once built, its provider, for the
+    /// warm reads (`None`: the switch is off or this is not a block reader)
+    warm: Option<(ProviderFactory, Option<EvmStateProviderBox>)>,
+}
+
+impl Reader {
+    fn run(
+        mut self,
+        sl_rx: Receiver<Item>,
+        cs_rx: Receiver<Item>,
+        pw_rx: Option<Receiver<Item>>,
+        txs: Option<Receiver<TxInfo>>,
+        stop: Arc<AtomicBool>,
+        lo_rx: Receiver<Item>,
+        stop_rx: Receiver<()>,
+    ) {
+        // EXP-174 (`pwlxrd`): an extra reader starts only once the block has an extrapolation job
+        if let Some(g) = self.gate.take() {
+            if !g.wait(&stop) {
+                return
+            }
+            self.stats.lx_rd_woken.fetch_add(1, Ordering::Relaxed);
+        }
+        // EXP-150: the stop channel's sender is dropped at block end when `rdstop=1`; until then `recv_timeout` on it is
+        // the same 200 us back-off as the sleep it replaces, and the select arm never fires
+        let backoff = |rx: &Receiver<()>| {
+            let _ = rx.recv_timeout(Duration::from_micros(200));
+        };
+        let never = crossbeam_channel::never::<TxInfo>();
+        let never_item = crossbeam_channel::never::<Item>();
+        let pwr = pw_rx.as_ref().unwrap_or(&never_item);
+        let mut tx_open = txs.is_some();
+        // `EWB_RDGATE`: the extra readers (`pwlxrd`) start once the work waiting for the readers outnumbers them
+        let mut rd_gate = self.bud(EWB_RDGATE) && self.mode.pwlxrd > 0;
+        loop {
+            if stop.load(Ordering::Relaxed) {
+                break
+            }
+            // the readers' backlog (counting only)
+            let backlog = (sl_rx.len() + cs_rx.len() + pwr.len() + lo_rx.len()) as u64;
+            self.stats.rq_len_max.fetch_max(backlog, Ordering::Relaxed);
+            self.stats.rq_len_sum.fetch_add(backlog, Ordering::Relaxed);
+            self.stats.rq_len_n.fetch_add(1, Ordering::Relaxed);
+            if rd_gate && sl_rx.len() + pwr.len() > self.mode.readers {
+                lx_gate_open();
+                self.stats.rd_gate_backlog.fetch_add(1, Ordering::Relaxed);
+                rd_gate = false;
+            }
+            // X-027: the calldata-address channel (EXP-184) is not ported
+            // handed-out slots first, then call-start frames: both are needed sooner than the
+            // remaining transactions
+            if let Ok(it) = sl_rx.try_recv() {
+                self.busy(|r| r.sl_item(it, &sl_rx));
+                continue
+            }
+            if let Ok(it) = cs_rx.try_recv() {
+                self.busy(|r| r.item(it));
+                continue
+            }
+            // EXP-240 (`accwarm`): an account the filter answered "absent", looked up in the database while the block
+            // still executes
+            if self.warm.is_some() && let Some(a) = reth_provider::acc_filter::warm_pop() {
+                self.busy(|r| r.warm_account(a));
+                continue
+            }
+            if let Some(it) = self.next_pw(pwr) {
+                if self.defer_low(&it) {
+                    let _ = self.lo_tx.send(it);
+                } else {
+                    self.busy(|r| r.item(it));
+                }
+                continue
+            }
+            // EXP-033: storage-discovery keys only when nothing else is waiting
+            if let Ok(it) = lo_rx.try_recv() {
+                self.busy(|r| r.item(it));
+                continue
+            }
+            if self.idle_exit && !tx_open && sl_rx.is_empty() {
+                break
+            }
+            let txr = if tx_open { txs.as_ref().unwrap_or(&never) } else { &never };
+            crossbeam_channel::select_biased! {
+                recv(stop_rx) -> _ => break,
+                recv(sl_rx) -> m => match m {
+                    Ok(it) => self.busy(|r| r.sl_item(it, &sl_rx)),
+                    Err(_) => backoff(&stop_rx),
+                },
+                recv(cs_rx) -> m => match m {
+                    Ok(it) => self.busy(|r| r.item(it)),
+                    Err(_) => backoff(&stop_rx),
+                },
+                recv(pwr) -> m => match m {
+                    Ok(it) => {
+                        let it = self.accept_pw(it);
+                        if let Some(it) = it {
+                            if self.defer_low(&it) {
+                                let _ = self.lo_tx.send(it);
+                            } else {
+                                self.busy(|r| r.item(it));
+                            }
+                        }
+                    }
+                    Err(_) => backoff(&stop_rx),
+                },
+                recv(lo_rx) -> m => match m {
+                    Ok(it) => self.busy(|r| r.item(it)),
+                    Err(_) => backoff(&stop_rx),
+                },
+                recv(txr) -> m => match m {
+                    Ok(t) => self.busy(|r| r.tx(t)),
+                    Err(_) => tx_open = false,
+                },
+                default(Duration::from_millis(1)) => {}
+            }
+        }
+    }
+
+    /// Whether a prewarm-worker job is for a transaction the execution thread has already executed.
+    /// Whether an item received from the prewarm channel is a storage-discovery batch to defer (`sdlow=1`).
+    fn defer_low(&self, it: &Item) -> bool {
+        self.mode.sdlow && matches!(it, Item::Keys(k) if k.3 == reth_execution_cache::CC_SRC_EAP_SD)
+    }
+
+    /// Whether the execution thread has already executed transaction `tx` (`u32::MAX`: never).
+    fn stale_tx(&self, tx: u32) -> bool {
+        tx != u32::MAX && self.exec_idx.as_ref().is_some_and(|e| (tx as usize) < e.load(Ordering::Relaxed))
+    }
+
+    /// EXP-199 round 3: an `ewbud` bit in force (only with the mechanism on).
+    fn bud(&self, bit: u32) -> bool {
+        self.mode.ew > 0 && self.mode.ewbud & bit != 0
+    }
+
+    fn stale(&self, tx: u32) -> bool {
+        self.mode.pwstale &&
+            tx != u32::MAX &&
+            self.exec_idx.as_ref().is_some_and(|e| (tx as usize) < e.load(Ordering::Relaxed))
+    }
+
+    /// A prewarm-worker job received from the channel: queued by priority (`pwprio`, then the best queued job is
+    /// returned) or returned as is; stale jobs are dropped.
+    fn accept_pw(&mut self, it: Item) -> Option<Item> {
+        if let Some(q) = &self.pwq {
+            let mut g = q.lock();
+            g.seq += 1;
+            let seq = g.seq;
+            g.heap.push(PwEntry(it.pw_tx(), seq, it));
+            drop(g);
+            return self.pop_pw()
+        }
+        if self.stale(it.pw_tx()) {
+            self.stats.pw_stale.fetch_add(1, Ordering::Relaxed);
+            kt_drop(&it);
+            return None
+        }
+        Some(it)
+    }
+
+    fn pop_pw(&mut self) -> Option<Item> {
+        let q = self.pwq.as_ref()?;
+        loop {
+            let e = q.lock().heap.pop()?;
+            if self.stale(e.0) {
+                self.stats.pw_stale.fetch_add(1, Ordering::Relaxed);
+                kt_drop(&e.2);
+                continue
+            }
+            return Some(e.2)
+        }
+    }
+
+    /// Next prewarm-worker job: everything waiting in the channel goes to the priority queue first (`pwprio`).
+    fn next_pw(&mut self, pwr: &Receiver<Item>) -> Option<Item> {
+        if self.pwq.is_some() {
+            while let Ok(it) = pwr.try_recv() {
+                let q = self.pwq.as_ref().unwrap();
+                let mut g = q.lock();
+                g.seq += 1;
+                let seq = g.seq;
+                g.heap.push(PwEntry(it.pw_tx(), seq, it));
+            }
+            return self.pop_pw()
+        }
+        while let Ok(it) = pwr.try_recv() {
+            if let Some(it) = self.accept_pw(it) {
+                return Some(it)
+            }
+        }
+        None
+    }
+
+    /// An item from the readers' channel. X-027: the batched page walk of `pwrdpf` (EXP-181, `eap_pf`) is not ported, so
+    /// the item is served alone, as in 2.5.1 with `pwrdpf` below 2.
+    fn sl_item(&mut self, it: Item, _sl_rx: &Receiver<Item>) {
+        self.item(it)
+    }
+
+    /// The readers' queue counters: a slot or key item handed out at `t` ([`rq_now`]) is taken now.
+    fn rq_wait(&self, t: u64) {
+        self.stats.rq_wait_ns.fetch_add(rq_now().saturating_sub(t), Ordering::Relaxed);
+        self.stats.rq_wait_items.fetch_add(1, Ordering::Relaxed);
+    }
+
+    /// EXP-240 (`accwarm`): looks account `a` up through the block's state provider without the execution cache, so the
+    /// table page where the state root will insert it is read now; the answer is dropped. The provider is the block's
+    /// `OverlayStateProvider`, whose latest-state lookup goes through the filter, so the lookup runs with the filter
+    /// bypassed (`acc_filter::bypassed`: e240w, without it every warm read was answered "absent" and requeued).
+    fn warm_account(&mut self, a: Address) {
+        let Some((factory, provider)) = self.warm.as_mut() else { return };
+        if provider.is_none() {
+            *provider = factory().ok();
+        }
+        // counted once the lookup returned; a provider that could not be built or a failed lookup counts as an error
+        let ok = provider
+            .as_ref()
+            .is_some_and(|p| reth_provider::acc_filter::bypassed(|| p.basic_account(&a).is_ok()));
+        reth_provider::acc_filter::warm_done(ok);
+    }
+
+    fn busy(&mut self, f: impl FnOnce(&mut Self)) {
+        let t0 = Instant::now();
+        self.stats.readers_busy.fetch_add(1, Ordering::Relaxed);
+        f(self);
+        self.stats.readers_busy.fetch_sub(1, Ordering::Relaxed);
+        self.stats.reader_busy_ns.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+    }
+
+    fn queue(&self, a: Address, keys: &[U256], src: u8) {
+        let mut g = self.issued.lock();
+        let th = Instant::now();
+        for k in keys {
+            let kk = B256::from(*k);
+            if let std::collections::hash_map::Entry::Vacant(v) = g.slots.entry((a, kk)) {
+                v.insert((0, src));
+                note_issue(&g, &self.stats, a, kk, src);
+            }
+        }
+        drop(g);
+        self.note_hold(th);
+    }
+
+    /// X-031 (EXP-269, record only): a hold of the `issued` lock that began at `th`.
+    fn note_hold(&self, th: Instant) {
+        let ns = th.elapsed().as_nanos() as u64;
+        self.stats.rd_hold_ns.fetch_add(ns, Ordering::Relaxed);
+        self.stats.rd_hold_max_ns.fetch_max(ns, Ordering::Relaxed);
+        if ns > 50_000 {
+            self.stats.rd_hold_long.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+
+    fn slot(&self, a: Address, k: B256, src: u8) {
+        if self.mode.rdstop && self.stop.load(Ordering::Relaxed) {
+            return
+        }
+        // Prologue (`ixpf`): the index-key extrapolation's keys are counted by outcome (`ix_cached`, `ix_reads`)
+        let is_ix = src == reth_execution_cache::CC_SRC_EAP_IX;
+        {
+            let mut g = self.issued.lock();
+            let th = Instant::now();
+            let st = g.slots.entry((a, k)).or_insert((0, src));
+            if st.0 != 0 {
+                self.stats.dup.fetch_add(1, Ordering::Relaxed);
+                if is_ix {
+                    ix::note_cached();
+                }
+                drop(g);
+                self.note_hold(th);
+                return
+            }
+            st.0 = 1;
+            drop(g);
+            self.note_hold(th);
+        }
+        kt(|kt, t| {
+            kt.read.entry((a, k)).or_insert((t, 0));
+        });
+        reth_execution_cache::cc_set_tag_source(src);
+        let t0 = Instant::now();
+        // X-031: read always (a thread-local counter), for the backend reads counted below
+        let fills0 = Some(reth_execution_cache::cc_thread_storage_fills());
+        // Prologue (`rdnop`, X-031 diagnostic): the slot stays issued but is not read
+        if !self.mode.rdnop {
+            let _ = self.provider.storage(a, k);
+        }
+        let filled = fills0.is_some_and(|f| reth_execution_cache::cc_thread_storage_fills() > f);
+        if filled {
+            self.stats.rd_filled.fetch_add(1, Ordering::Relaxed);
+        }
+        {
+            let mut g = self.issued.lock();
+            let th = Instant::now();
+            g.slots.insert((a, k), (2, src));
+            if self.mode.iqc && filled {
+                g.iqc_disk.insert((a, k));
+            }
+            drop(g);
+            self.note_hold(th);
+        }
+        kt(|kt, t| {
+            if let Some(r) = kt.read.get_mut(&(a, k)) {
+                if r.1 == 0 {
+                    r.1 = t;
+                }
+            }
+        });
+        let ns = t0.elapsed().as_nanos() as u64;
+        self.stats.read_ns.fetch_add(ns, Ordering::Relaxed);
+        self.stats.reads.fetch_add(1, Ordering::Relaxed);
+        self.stats.reads_src[src_index(src)].fetch_add(1, Ordering::Relaxed);
+        if is_ix {
+            ix::note_read(filled, ns);
+        }
+    }
+
+    fn item(&mut self, it: Item) {
+        match it {
+            Item::Frame(job) => self.frame(&job),
+            Item::Slot(a, k, src, tx, t) => {
+                self.rq_wait(t);
+                // EXP-033 (`slstale=1`): a handed-out slot of a transaction the execution thread has passed
+                // (`EWB_KEYS`: always, in place of the per-block key budgets)
+                if (self.mode.slstale || self.bud(EWB_KEYS)) && self.stale_tx(tx) {
+                    self.stats.sl_stale.fetch_add(1, Ordering::Relaxed);
+                    return
+                }
+                // Prologue (`ixpf`): with `rdpeek`, an index-key extrapolation key already in the execution cache is not
+                // read, as the keys a reader spreads (the non-blocking pass looks its own slots up itself)
+                if src == reth_execution_cache::CC_SRC_EAP_IX &&
+                    self.peek(a, &[U256::from_be_bytes(k.0)], src).is_some_and(|kept| kept.is_empty())
+                {
+                    ix::note_cached();
+                    return
+                }
+                self.slot(a, k, src)
+            }
+            Item::Keys(k) => {
+                let (a, keys, tx, src, t) = *k;
+                self.rq_wait(t);
+                self.queue(a, &keys, src);
+                self.spread(a, &keys, src, tx);
+            }
+            Item::Follow(job) => {
+                self.follow_calls(&job.plan, &job.input, job.caller, job.origin, job.target, job.value, job.tx, 0);
+            }
+            Item::Lx(job) => {
+                if self.bud(EWB_KEYS) && self.stale_tx(job.tx) {
+                    self.stats.sl_stale.fetch_add(1, Ordering::Relaxed);
+                    return
+                }
+                self.lx_follow(*job, reth_execution_cache::CC_SRC_EAP_CT)
+            }
+            Item::Acct(a, src, tx) => {
+                if (self.mode.slstale || self.bud(EWB_KEYS)) && self.stale_tx(tx) {
+                    self.stats.sl_stale.fetch_add(1, Ordering::Relaxed);
+                    return
+                }
+                self.acct_prefetch(a, src)
+            }
+            Item::CtCalls(ch) => {
+                if self.stale(ch.tx) || ((self.mode.slstale || self.bud(EWB_KEYS)) && self.stale_tx(ch.tx)) {
+                    self.stats.sl_stale.fetch_add(1, Ordering::Relaxed);
+                    return
+                }
+                let t0 = Instant::now();
+                self.stats.ct_spread_done.fetch_add(1, Ordering::Relaxed);
+                self.follow_list(&ch.calls, ch.caller, ch.addr, ch.origin, ch.value, ch.tx, ch.depth);
+                self.stats.ct_ns.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+            }
+            Item::Code(h, src) => self.code_prefetch(h, src),
+        }
+    }
+
+    /// EXP-112: evaluates `plan`'s call records for the frame (`input`, `caller`, `origin`, storage context `addr`,
+    /// `value`; storage-read nodes by reading the slot when `ctsl`), and prefetches every resolved callee: its account
+    /// (which gives the code hash), its code, and, when the callee's code has a plan that passed the `pwmin` gate and the
+    /// payload evaluated, the callee plan's keys for that payload (storage context: the callee for CALL and STATICCALL,
+    /// this frame's context for DELEGATECALL and CALLCODE; caller: this frame's context). Follows the callee's own call
+    /// records while `depth + 1 < ctd`. Reads are tagged CC_SRC_EAP_CT.
+    #[expect(clippy::too_many_arguments)]
+    fn follow_calls(&mut self, plan: &Plan, input: &[u8], caller: Address, origin: Address, addr: Address, value: U256, tx: u32, depth: u32) {
+        if !plan_has_calls(plan) {
+            return
+        }
+        // EXP-201 (`ctbudget`): no new job once the block's budget is spent (`EWB_KEYS`: no budget)
+        if self.mode.ctbudget > 0 && !self.bud(EWB_KEYS) && self.stats.ct_keys_new.load(Ordering::Relaxed) >= self.mode.ctbudget {
+            self.stats.ct_drop.fetch_add(1, Ordering::Relaxed);
+            return
+        }
+        let t0 = Instant::now();
+        let src = reth_execution_cache::CC_SRC_EAP_CT;
+        self.stats.ct_jobs.fetch_add(1, Ordering::Relaxed);
+        let env = self.info.env(caller, origin, addr, value, input.len());
+        let sload_n = std::cell::Cell::new(0u64);
+        let calls = {
+            let provider = &self.provider;
+            let want = self.mode.ctsl;
+            let sl = |k: U256| -> Option<U256> {
+                if !want {
+                    return None
+                }
+                sload_n.set(sload_n.get() + 1);
+                reth_execution_cache::cc_set_tag_source(src);
+                provider.storage(addr, B256::from(k)).ok().flatten()
+            };
+            let f = Frame { calldata: input, env, sload: Some(&sl) };
+            self.sc.instantiate_calls(plan, &f, false);
+            self.stats.ct_fam_capped.fetch_add(u64::from(self.sc.c_family_capped), Ordering::Relaxed);
+            (std::mem::take(&mut self.sc.calls), std::mem::take(&mut self.sc.call_idx))
+        };
+        let (mut calls, call_idx) = calls;
+        self.stats.ct_sload.fetch_add(sload_n.get(), Ordering::Relaxed);
+        self.stats.ct_calls.fetch_add(calls.len() as u64, Ordering::Relaxed);
+        self.stats.ct_full.fetch_add(calls.iter().filter(|c| c.payload.is_some()).count() as u64, Ordering::Relaxed);
+        let fam = |i: usize| call_idx.get(i).is_some_and(|x| x.is_some());
+        self.stats.ct_fam.fetch_add((0..calls.len()).filter(|&i| fam(i)).count() as u64, Ordering::Relaxed);
+        self.stats.ct_fam_full.fetch_add(
+            (0..calls.len()).filter(|&i| fam(i) && calls[i].payload.is_some()).count() as u64,
+            Ordering::Relaxed,
+        );
+        // EXP-199 (`ctdedup`): repeats of a call of this frame dropped before the calls are spread (so no chunk carries one)
+        if self.mode.ctdedup {
+            self.stats.ct_dedup_skip.fetch_add(dedup_calls(&mut calls) as u64, Ordering::Relaxed);
+        }
+        // EXP-201 (`ctpay`): target-only calls dropped before the calls are spread
+        if self.mode.ctpay {
+            let n = calls.len();
+            calls.retain(|c| c.payload.is_some());
+            self.stats.ct_nopay.fetch_add((n - calls.len()) as u64, Ordering::Relaxed);
+        }
+        // EXP-199 round 3 (`ctspread`): calls beyond the first N go to the readers in chunks, through the block readers'
+        // prewarm-worker channel (ordered by transaction with `pwprio`, behind the execution thread's call-start frames;
+        // with `ctr` the follow jobs come from the dedicated readers, the chunks still reach the block's readers)
+        let send = pw_sender().unwrap_or_else(|| self.sl_tx.clone());
+        let calls = ct_spread(calls, &self.mode, &self.stats, &send, caller, addr, origin, value, tx, depth);
+        self.follow_list(&calls, caller, addr, origin, value, tx, depth);
+        // the time of the whole follow, counted once at the outermost level (deeper levels run inside it)
+        if depth == 0 {
+            self.stats.ct_ns.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        }
+    }
+
+    /// The per-call part of [`Self::follow_calls`] for a list of resolved calls of one frame (storage context `addr`):
+    /// the callee's account, code and, with a payload, plan keys, then its own call records while `depth + 1 < ctd`.
+    /// EXP-201 (ported): `ctbudget`, `ctpay` and `ctfan` checked per call. Also serves [`Item::CtCalls`].
+    #[expect(clippy::too_many_arguments)]
+    fn follow_list(&mut self, calls: &[frame_plan::CallOut], caller: Address, addr: Address, origin: Address, value: U256, tx: u32, depth: u32) {
+        let src = reth_execution_cache::CC_SRC_EAP_CT;
+        reth_execution_cache::cc_set_tag_source(src);
+        // EXP-201 (`ctfan`): distinct callees resolved on this thread so far
+        let mut resolved: HashSet<Address> = HashSet::new();
+        for (ci, c) in calls.iter().enumerate() {
+            if self.mode.rdstop && self.stop.load(Ordering::Relaxed) {
+                break
+            }
+            // EXP-201 (`ctbudget`): the block's budget of new keys from call records, checked before every call; `EWB_KEYS`:
+            // no budget, the calls of a transaction the execution thread has passed are dropped instead
+            if self.bud(EWB_KEYS) && self.stale_tx(tx) {
+                self.stats.ct_drop.fetch_add((calls.len() - ci) as u64, Ordering::Relaxed);
+                break
+            }
+            if self.mode.ctbudget > 0 && !self.bud(EWB_KEYS) && self.stats.ct_keys_new.load(Ordering::Relaxed) >= self.mode.ctbudget {
+                self.stats.ct_drop.fetch_add((calls.len() - ci) as u64, Ordering::Relaxed);
+                break
+            }
+            if self.mode.ctpay && c.payload.is_none() {
+                self.stats.ct_nopay.fetch_add(1, Ordering::Relaxed);
+                continue
+            }
+            let target = Address::from_slice(&c.target.to_be_bytes::<32>()[12..]);
+            if self.mode.ctfan > 0 && !self.bud(EWB_SPREAD) && !resolved.contains(&target) {
+                if resolved.len() >= self.mode.ctfan {
+                    // beyond the limit: the account goes to an idle reader, the callee's plan is not instantiated
+                    if self.issued.lock().accounts.insert(target) {
+                        self.stats.ct_fan_acct.fetch_add(1, Ordering::Relaxed);
+                        let _ = self.sl_tx.send(Item::Acct(target, src, tx));
+                    }
+                    continue
+                }
+                resolved.insert(target);
+            }
+            let first = self.issued.lock().accounts.insert(target);
+            let t1 = Instant::now();
+            let acc = self.provider.basic_account(&target).ok().flatten();
+            if first {
+                self.stats.ct_acct.fetch_add(1, Ordering::Relaxed);
+                self.stats.read_ns.fetch_add(t1.elapsed().as_nanos() as u64, Ordering::Relaxed);
+                self.stats.reads.fetch_add(1, Ordering::Relaxed);
+                self.stats.reads_src[src_index(src)].fetch_add(1, Ordering::Relaxed);
+            }
+            let Some(h) = acc.and_then(|a| a.bytecode_hash).filter(|h| *h != KECCAK256_EMPTY) else { continue };
+            if self.issued.lock().codes.insert(h) {
+                let t1 = Instant::now();
+                let _ = self.provider.bytecode_by_hash(&h);
+                self.stats.ct_code.fetch_add(1, Ordering::Relaxed);
+                self.stats.read_ns.fetch_add(t1.elapsed().as_nanos() as u64, Ordering::Relaxed);
+                self.stats.reads.fetch_add(1, Ordering::Relaxed);
+                self.stats.reads_src[src_index(src)].fetch_add(1, Ordering::Relaxed);
+            }
+            let Some(payload) = c.payload.as_ref() else { continue };
+            let Some(plans) = plans() else { continue };
+            // the callee's plan; an EIP-7702 designator resolves to the delegate's plan (code read through its account)
+            let mut h2 = h;
+            let mut p2 = plans.get(&h);
+            if let Some(p) = &p2 {
+                if p.kind == 1 {
+                    let d = Address::from_slice(&p.delegate);
+                    let hd = self.account(d);
+                    p2 = hd.and_then(|hd| plans.get(&hd));
+                    if let Some(hd) = hd {
+                        h2 = hd;
+                    }
+                }
+            }
+            let Some(p2) = p2.filter(|p| p.kind == 0) else { continue };
+            // the same gate as the callee's own call-start instantiation on the prewarm workers
+            if !compiled_peek(h2, self.mode.pwmin) {
+                continue
+            }
+            let (caller2, addr2, value2) = callee_frame(c.kind, caller, addr, value, target);
+            let env2 = self.info.env(caller2, origin, addr2, value2, payload.len());
+            self.stats.ct_plans.fetch_add(1, Ordering::Relaxed);
+            self.sc.instantiate(&p2, &Frame { calldata: payload, env: env2, sload: None });
+            let keys = std::mem::take(&mut self.sc.out);
+            self.stats.ct_keys.fetch_add(keys.len() as u64, Ordering::Relaxed);
+            let new = self.queue_new(addr2, &keys, src);
+            self.stats.ct_keys_new.fetch_add(new.len() as u64, Ordering::Relaxed);
+            if self.mode.pwtrace {
+                kt(|k, t| {
+                    for key in &new {
+                        k.issued.entry((addr2, B256::from(*key))).or_insert(t);
+                    }
+                });
+            }
+            self.spread(addr2, &new, src, tx);
+            self.sc.out = keys;
+            // `EWB_CTD`: one more level while this level issued new keys
+            let deeper = if self.bud(EWB_CTD) { !new.is_empty() && depth + 1 < CT_DEPTH_GUARD } else { depth + 1 < self.mode.ctd };
+            if deeper {
+                self.follow_calls(&p2, payload, caller2, origin, addr2, value2, tx, depth + 1);
+                reth_execution_cache::cc_set_tag_source(src);
+            }
+        }
+    }
+
+    /// Queues `keys` as [`Self::queue`] and returns the ones that were not issued before.
+    /// EXP-130: resolves every predicted call of `job` (account -> code hash -> plan, or the code hint), instantiates
+    /// the callee's plan with the predicted payload and queues the new keys in transaction order. Account and code
+    /// reads are cached within the job (a batch usually calls a handful of distinct callees).
+    fn lx_follow(&mut self, job: LxJob, src: u8) {
+        if self.mode.pwlxbudget > 0 && !self.bud(EWB_KEYS) && self.stats.lx_keys_new.load(Ordering::Relaxed) >= self.mode.pwlxbudget {
+            self.stats.lx_dropped.fetch_add(1, Ordering::Relaxed);
+            return
+        }
+        let t0 = Instant::now();
+        reth_execution_cache::cc_set_tag_source(src);
+        let Some(plans) = plans() else { return };
+        let mut hashes: HashMap<Address, Option<B256>> = HashMap::new();
+        let (mut done, mut keys_total) = (0usize, 0usize);
+        // an unbounded progression of computed addresses: the job ends at the first predicted address without code.
+        // Found by bisection on the probe addresses (about log2(n) account reads up front) rather than one read per
+        // call: a read per call put 50-100 us on the serial path of every key and let the execution thread overtake
+        // the job (EXP-130 c1)
+        let mut end = job.calls.len();
+        if job.calls.iter().any(|c| c.probe.is_some()) {
+            let has_code = |a: Address| self.account(a).is_some();
+            let probe_of = |i: usize| job.calls[i].probe;
+            if let Some(last) = probe_of(end - 1) && !has_code(last) {
+                let (mut lo, mut hi) = (0usize, end - 1); // lo: has code (or none probed), hi: no code
+                while hi > lo + 1 {
+                    let mid = (lo + hi) / 2;
+                    match probe_of(mid) { Some(a) if !has_code(a) => hi = mid, _ => lo = mid }
+                }
+                end = if probe_of(0).is_some_and(|a| !has_code(a)) { 0 } else { hi };
+                self.stats.lx_stopped_nocode.fetch_add(1, Ordering::Relaxed);
+            }
+        }
+        for (ci, c) in job.calls[..end].iter().enumerate() {
+            // EXP-151 (`pwlxbin`): the per-block budget before every predicted call; the rest of the job is dropped
+            if self.mode.pwlxbin && self.mode.pwlxbudget > 0 && !self.bud(EWB_KEYS) && self.stats.lx_keys_new.load(Ordering::Relaxed) >= self.mode.pwlxbudget {
+                let rest = (end - ci) as u64;
+                self.stats.lx_drop_calls.fetch_add(rest, Ordering::Relaxed);
+                let per = if done > 0 { keys_total as u64 / done as u64 } else { 0 };
+                self.stats.lx_drop_keys.fetch_add(rest * per, Ordering::Relaxed);
+                break
+            }
+            // predicted calls whose callees compute no keys (an entry whose transfers read nothing the plans know)
+            // only cost account reads: stop after 16 of them without a key
+            if self.mode.pwlxslots && done >= 16 && keys_total == 0 {
+                self.stats.lx_stopped.fetch_add(1, Ordering::Relaxed);
+                break
+            }
+            done += 1;
+            // EXP-172 (`pwlxacct`): the accounts the execution thread will load for this call and the job does not read
+            // itself: the callee's with a code hint, and a fitted caller's (a proxy calling the same contract in a loop);
+            // handed to idle readers ahead of this call's keys (same channel, transaction order), off the serial path
+            if self.mode.pwlxacct {
+                let callee = c.code_hint.is_some().then_some(c.target);
+                for a in [callee, c.caller.filter(|a| *a != job.caller)].into_iter().flatten() {
+                    if self.issued.lock().accounts.insert(a) {
+                        if self.mode.pwtrace {
+                            kt(|k, t| {
+                                k.acct.entry(a).or_insert((t, 0, 0, job.tx));
+                            });
+                        }
+                        let n = self.stats.lx_acct.fetch_add(1, Ordering::Relaxed) + 1;
+                        let _ = self.sl_tx.send(Item::Acct(a, src, job.tx));
+                        // EXP-177 (`pwlxrdacct`): the extra readers start once the block has handed out N accounts
+                        if self.mode.pwlxrdacct > 0 && n == u64::from(self.mode.pwlxrdacct) && !self.bud(EWB_RDGATE) {
+                            lx_gate_open();
+                        }
+                    }
+                }
+            }
+            let h = match c.code_hint {
+                Some(h) => h,
+                None => {
+                    let e = hashes.entry(c.target).or_insert_with(|| {
+                        self.issued.lock().accounts.insert(c.target);
+                        let t1 = Instant::now();
+                        let acc = self.provider.basic_account(&c.target).ok().flatten();
+                        self.stats.read_ns.fetch_add(t1.elapsed().as_nanos() as u64, Ordering::Relaxed);
+                        self.stats.reads.fetch_add(1, Ordering::Relaxed);
+                        self.stats.reads_src[src_index(src)].fetch_add(1, Ordering::Relaxed);
+                        acc.and_then(|a| a.bytecode_hash).filter(|h| *h != KECCAK256_EMPTY)
+                    });
+                    let Some(h) = *e else { continue };
+                    h
+                }
+            };
+            if self.issued.lock().codes.insert(h) {
+                let t1 = Instant::now();
+                let _ = self.provider.bytecode_by_hash(&h);
+                self.stats.read_ns.fetch_add(t1.elapsed().as_nanos() as u64, Ordering::Relaxed);
+                self.stats.reads.fetch_add(1, Ordering::Relaxed);
+                self.stats.reads_src[src_index(src)].fetch_add(1, Ordering::Relaxed);
+            }
+            let mut h2 = h;
+            let mut p2 = plans.get(&h);
+            if let Some(p) = &p2 {
+                if p.kind == 1 {
+                    let d = Address::from_slice(&p.delegate);
+                    let hd = self.account(d);
+                    p2 = hd.and_then(|hd| plans.get(&hd));
+                    if let Some(hd) = hd {
+                        h2 = hd;
+                    }
+                }
+            }
+            let Some(p2) = p2.filter(|p| p.kind == 0) else { continue };
+            if !self.mode.pwlxslots || !compiled_peek(h2, self.mode.pwmin) {
+                continue
+            }
+            let value = if c.kind == 2 || c.kind == 1 { job.value } else { U256::ZERO };
+            let caller = c.caller.unwrap_or(job.caller);
+            let env2 = self.info.env(caller, job.origin, c.context, value, c.payload.len());
+            self.stats.lx_plans.fetch_add(1, Ordering::Relaxed);
+            self.sc.instantiate(&p2, &Frame { calldata: &c.payload, env: env2, sload: None });
+            let keys = std::mem::take(&mut self.sc.out);
+            keys_total += keys.len();
+            self.stats.lx_keys.fetch_add(keys.len() as u64, Ordering::Relaxed);
+            let new = self.queue_new(c.context, &keys, src);
+            self.stats.lx_keys_new.fetch_add(new.len() as u64, Ordering::Relaxed);
+            if self.mode.pwtrace {
+                kt(|k, t| {
+                    for key in &new {
+                        k.issued.entry((c.context, B256::from(*key))).or_insert(t);
+                        k.lx.entry((c.context, B256::from(*key))).or_insert((t, job.tx));
+                    }
+                });
+            }
+            // EXP-199 (`rdpeek`): the slots already in the execution cache are marked read and left out, before the page
+            // walk and the hand-off (`pwlxnoself` hands them out without `spread`)
+            let new = self.peek(c.context, &new, src).unwrap_or(new);
+            if self.mode.pwlxnoself {
+                // EXP-181: every key to the readers' channel (transaction order kept), none read on this thread
+                for k in &new {
+                    let _ = self.sl_tx.send(Item::Slot(c.context, B256::from(*k), src, job.tx, rq_now()));
+                }
+            } else {
+                self.spread_now(c.context, &new, src, job.tx);
+            }
+            self.sc.out = keys;
+            // the callee's own call records (a proxy's delegate, nested transfers): as the transaction-arrival follow
+            if self.mode.ctd > 1 || self.bud(EWB_CTD) {
+                let (caller2, addr2) = if c.kind == 2 || c.kind == 1 { (caller, c.context) } else { (caller, c.target) };
+                self.follow_calls(&p2, &c.payload, caller2, job.origin, addr2, value, job.tx, 1);
+                reth_execution_cache::cc_set_tag_source(src);
+            }
+        }
+        self.stats.lx_ns.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        // X-027: the page walk of `pwlxpf` (EXP-181, `eap_pf`) is not ported
+    }
+
+    fn queue_new(&self, a: Address, keys: &[U256], src: u8) -> Vec<U256> {
+        let mut g = self.issued.lock();
+        let mut out = Vec::new();
+        for k in keys {
+            let kk = B256::from(*k);
+            if let std::collections::hash_map::Entry::Vacant(v) = g.slots.entry((a, kk)) {
+                v.insert((0, src));
+                note_issue(&g, &self.stats, a, kk, src);
+                out.push(*k);
+            }
+        }
+        out
+    }
+
+    /// EXP-199 (`rdpeek`): `keys` without the slots already in the execution cache (marked read), or `None` when the
+    /// switch is off or the block has no cache
+    fn peek(&self, a: Address, keys: &[U256], src: u8) -> Option<Vec<U256>> {
+        match &self.caches {
+            Some(c) if self.mode.rdpeek && !keys.is_empty() => Some(peek_filter(c, &self.issued, &self.stats, a, keys, src)),
+            _ => None,
+        }
+    }
+
+    /// Reads the first key itself and hands the others to idle readers (with `rdpeek`, those not in the execution
+    /// cache).
+    fn spread(&self, a: Address, keys: &[U256], src: u8, tx: u32) {
+        match self.peek(a, keys, src) {
+            Some(kept) => self.spread_now(a, &kept, src, tx),
+            None => self.spread_now(a, keys, src, tx),
+        }
+    }
+
+    fn spread_now(&self, a: Address, keys: &[U256], src: u8, tx: u32) {
+        if self.mode.sdlow && src == reth_execution_cache::CC_SRC_EAP_SD {
+            for k in keys {
+                let _ = self.lo_tx.send(Item::Slot(a, B256::from(*k), src, tx, rq_now()));
+            }
+            return
+        }
+        for k in keys.iter().skip(1) {
+            let _ = self.sl_tx.send(Item::Slot(a, B256::from(*k), src, tx, rq_now()));
+        }
+        if let Some(k) = keys.first() {
+            self.slot(a, B256::from(*k), src);
+        }
+    }
+
+    fn frame(&mut self, job: &FrameJob) {
+        let src = if job.nb {
+            reth_execution_cache::CC_SRC_EAP_NB
+        } else if job.pw {
+            reth_execution_cache::CC_SRC_EAP_PW
+        } else if job.depth == 0 {
+            reth_execution_cache::CC_SRC_EAP_CS0
+        } else {
+            reth_execution_cache::CC_SRC_EAP_CS1
+        };
+        let t0 = Instant::now();
+        let env = self.info.env(job.caller, job.origin, job.target, job.value, job.input.len());
+        self.sc.instantiate(&job.plan, &Frame { calldata: &job.input, env, sload: None });
+        let keys = std::mem::take(&mut self.sc.out);
+        self.stats.inst_ns.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        self.stats.cs_keys.fetch_add(keys.len() as u64, Ordering::Relaxed);
+        if job.nb {
+            // only the keys not issued before (the pass reruns each level; prewarm workers' frames cover the same calls)
+            self.stats.nbpl_jobs.fetch_add(1, Ordering::Relaxed);
+            let new = self.queue_new(job.target, &keys, src);
+            self.stats.nbpl_keys.fetch_add(new.len() as u64, Ordering::Relaxed);
+            self.spread(job.target, &new, src, job.tx);
+            self.sc.out = keys;
+            return
+        } else if job.pw {
+            self.stats.pw_keys.fetch_add(keys.len() as u64, Ordering::Relaxed);
+        } else if job.depth == 0 {
+            self.stats.cs_keys_d0.fetch_add(keys.len() as u64, Ordering::Relaxed);
+        } else {
+            self.stats.cs_keys_d1.fetch_add(keys.len() as u64, Ordering::Relaxed);
+        }
+        self.queue(job.target, &keys, src);
+        self.spread(job.target, &keys, src, job.tx);
+        self.sc.out = keys;
+    }
+
+    /// EXP-172: reads a predicted callee's account into the execution cache (handed out by `lx_follow`).
+    fn acct_prefetch(&self, a: Address, src: u8) {
+        if self.mode.rdstop && self.stop.load(Ordering::Relaxed) {
+            return
+        }
+        kt(|kt, t| {
+            if let Some(r) = kt.acct.get_mut(&a) {
+                r.1 = t;
+            }
+        });
+        reth_execution_cache::cc_set_tag_source(src);
+        let t0 = Instant::now();
+        let _ = self.provider.basic_account(&a);
+        kt(|kt, t| {
+            if let Some(r) = kt.acct.get_mut(&a) {
+                r.2 = t;
+            }
+        });
+        self.stats.read_ns.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        self.stats.reads.fetch_add(1, Ordering::Relaxed);
+        self.stats.reads_src[src_index(src)].fetch_add(1, Ordering::Relaxed);
+        self.stats.lx_acct_read.fetch_add(1, Ordering::Relaxed);
+    }
+
+    /// EXP-235 (`pl`): reads a code into the execution cache, once per block (`Issued::codes`).
+    fn code_prefetch(&self, h: B256, src: u8) {
+        if (self.mode.rdstop && self.stop.load(Ordering::Relaxed)) || !self.issued.lock().codes.insert(h) {
+            return
+        }
+        reth_execution_cache::cc_set_tag_source(src);
+        let t0 = Instant::now();
+        let _ = self.provider.bytecode_by_hash(&h);
+        self.stats.read_ns.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        self.stats.reads.fetch_add(1, Ordering::Relaxed);
+        self.stats.reads_src[src_index(src)].fetch_add(1, Ordering::Relaxed);
+    }
+
+    fn account(&self, a: Address) -> Option<B256> {
+        let first = self.issued.lock().accounts.insert(a);
+        let t0 = Instant::now();
+        let acc = self.provider.basic_account(&a).ok().flatten();
+        if first {
+            self.stats.read_ns.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+            self.stats.reads.fetch_add(1, Ordering::Relaxed);
+            self.stats.reads_src[0].fetch_add(1, Ordering::Relaxed);
+        }
+        acc.and_then(|a| a.bytecode_hash).filter(|h| *h != KECCAK256_EMPTY)
+    }
+
+    fn tx(&mut self, t: TxInfo) {
+        let src = reth_execution_cache::CC_SRC_EAP_TX;
+        reth_execution_cache::cc_set_tag_source(src);
+        self.stats.txs.fetch_add(1, Ordering::Relaxed);
+        if self.mode.noread || (self.mode.txmod == 2 && t.idx % 2 == 0) {
+            return
+        }
+        self.account(t.caller);
+        let Some(to) = t.to else { return };
+        // EXP-130 (merge of EXP-134): the inner calls the calldata gives in clear, through the shared extrapolation path
+        if self.mode.txdec && t.input.len() >= 4 && t.idx != usize::MAX {
+            let mut calls = Vec::new();
+            if eap_lx::txdec::txdec(to, to, &t.input, self.mode.txdecmax as usize, 3, &mut calls) && !calls.is_empty() {
+                if self.mode.pwlxrdacct == 0 && !self.bud(EWB_RDGATE) {
+                    lx_gate_open();
+                }
+                self.stats.txdec_txs.fetch_add(1, Ordering::Relaxed);
+                self.stats.txdec_calls.fetch_add(calls.len() as u64, Ordering::Relaxed);
+                let before = self.stats.lx_keys_new.load(Ordering::Relaxed);
+                self.lx_follow(LxJob { calls, caller: to, origin: t.caller, value: t.value, tx: t.idx as u32 }, src);
+                self.stats.txdec_keys_new.fetch_add(self.stats.lx_keys_new.load(Ordering::Relaxed).saturating_sub(before), Ordering::Relaxed);
+                reth_execution_cache::cc_set_tag_source(src);
+            }
+        }
+        let Some(h) = self.account(to) else { return };
+        if self.mode.code && self.issued.lock().codes.insert(h) {
+            let t0 = Instant::now();
+            let _ = self.provider.bytecode_by_hash(&h);
+            self.stats.read_ns.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+            self.stats.reads.fetch_add(1, Ordering::Relaxed);
+            self.stats.reads_src[0].fetch_add(1, Ordering::Relaxed);
+        }
+        if !self.mode.slots {
+            return
+        }
+        // X-027: the entry contract's plan at block arrival: a miss goes to the front of the load queue
+        let Some(plan) = plans().and_then(|p| p.get_with(&h, true)) else { return };
+        self.stats.txs_plan.fetch_add(1, Ordering::Relaxed);
+        let t0 = Instant::now();
+        let env = self.info.env(t.caller, t.caller, to, t.value, t.input.len());
+        self.sc.instantiate(&plan, &Frame { calldata: &t.input, env, sload: None });
+        let keys = std::mem::take(&mut self.sc.out);
+        self.stats.inst_ns.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        self.stats.tx_keys.fetch_add(keys.len() as u64, Ordering::Relaxed);
+        self.queue(to, &keys, src);
+        self.spread(to, &keys, src, u32::MAX);
+        self.sc.out = keys;
+        // EXP-112 (`cttx=1`): follow the target plan's call records with the transaction's input
+        if self.mode.cttx {
+            self.follow_calls(&plan, &t.input, t.caller, t.caller, to, t.value, t.idx as u32, 0);
+            reth_execution_cache::cc_set_tag_source(src);
+        }
+    }
+}
+
+/// EXP-199 round 3: logs a speculative-pass helper's CPU time and transactions when the helper exits (its thread is
+/// created per block and is gone before the driver samples the node's threads; with `ewpool` the helper's pool thread
+/// lives on, the CPU time counts from the job's start, and the driver's samples by thread name count it as well).
+#[derive(Debug)]
+pub struct NbExitLog {
+    /// the block of the helper
+    pub block: u64,
+    /// transactions it ran passes for
+    pub txs: std::cell::Cell<u32>,
+}
+
+impl Drop for NbExitLog {
+    fn drop(&mut self) {
+        info!(target: "reth::eap", block = self.block, txs = self.txs.get(), cpu_us = thread_cpu_ns() / 1000, "eap nb exit");
+    }
+}
+
+thread_local! {
+    /// EXP-199 (`ewpool`): this thread's CPU time when its current pool job started (0 on a thread made for one job).
+    static JOB_CPU0: std::cell::Cell<u64> = const { std::cell::Cell::new(0) };
+}
+
+/// CPU time this thread has run so far (`/proc/thread-self/schedstat`, ns); on a pool thread of `ewpool`, since its
+/// current job started, so the exit lines of a worker or helper count that job only, as on a thread made for it.
+fn thread_cpu_ns() -> u64 {
+    raw_thread_cpu_ns().saturating_sub(JOB_CPU0.with(|c| c.get()))
+}
+
+fn raw_thread_cpu_ns() -> u64 {
+    std::fs::read_to_string("/proc/thread-self/schedstat")
+        .ok()
+        .and_then(|s| s.split_whitespace().next().and_then(|x| x.parse().ok()))
+        .unwrap_or(0)
+}
+
+/// EXP-199 (`ewpool`): a pool thread starts a job; [`thread_cpu_ns`] counts from here until the next job.
+pub fn job_cpu_start() {
+    JOB_CPU0.with(|c| c.set(raw_thread_cpu_ns()));
+    JOB_RUNQ0.with(|c| c.set(raw_thread_runq_ns()));
+}
+
+thread_local! {
+    /// X-031: the thread's run-queue time (schedstat) at its current job's start (see [`job_cpu_start`]).
+    static JOB_RUNQ0: std::cell::Cell<u64> = const { std::cell::Cell::new(0) };
+}
+
+/// X-031: time this thread has waited on a run queue so far (`/proc/thread-self/schedstat`, second field, ns).
+fn raw_thread_runq_ns() -> u64 {
+    std::fs::read_to_string("/proc/thread-self/schedstat")
+        .ok()
+        .and_then(|s| s.split_whitespace().nth(1).and_then(|x| x.parse().ok()))
+        .unwrap_or(0)
+}
+
+/// X-031 (record only): the current block's prewarm worker exits summed: exits, runs, skipped, wait ns (dispatch to
+/// start), run ns, CPU ns, run-queue ns, heavy runs; reset at the block's validation start ([`xbtl2::begin`]).
+/// Indices 8 and 9: run-queue ns inside the runs, and before the first run (from the job's start).
+pub static EW_SUM: [AtomicU64; 10] = [const { AtomicU64::new(0) }; 10];
+
+/// X-031 (record only): this thread's run-queue ns since its current job's start.
+pub fn thread_runq_ns() -> u64 {
+    raw_thread_runq_ns().saturating_sub(JOB_RUNQ0.with(|c| c.get()))
+}
+
+/// X-031 (record only): a prewarm worker's run-queue ns inside its runs and before its first run, for the block's sum.
+pub fn ew_note_runq_split(in_runs_ns: u64, before_first_ns: u64) {
+    EW_SUM[8].fetch_add(in_runs_ns, Ordering::Relaxed);
+    EW_SUM[9].fetch_add(before_first_ns, Ordering::Relaxed);
+}
+
+
+/// Inspector of a prewarm worker's EVM (EXP-019): sends the call-start prediction of each call (inner calls only
+/// when `pwcs=1`) to the block's reader threads.
+///
+/// X-027 (evm2): the hooks get the calling frame's interpreter and the callee's [`Message`]: the code hash is
+/// `message.code.hash_slow()` (revm's `known_bytecode.0`; cached per bytecode), the depth [`msg_depth`], the origin
+/// `TxEnv::origin`; evm2's `TxEnv` has no recipient or calldata, so the transaction's (revm's `tx().kind()`,
+/// `tx().input()`) are taken from its outermost message. Frame recording (`trace19`), fresh-state runs (`fs`), the
+/// call records for `csd`, the dedicated follow readers (`ctr`), storage discovery's `sdgap` and the worker-side slot
+/// reads of `pwsl` are not ported.
+pub struct EapPwInspector {
+    tx: Option<Sender<Item>>,
+    stats: Option<Arc<Stats>>,
+    all_depths: bool,
+    mode: Mode,
+    exec_idx: Arc<AtomicUsize>,
+    info: BlockInfo,
+    /// EXP-130 (`pwlx`): per-transaction loop-call and CREATE2 tracker.
+    lx: eap_lx::LxTracker,
+    /// EXP-151: transaction (index + 1) whose decoder counts were set, whose salt templates were evaluated
+    lx_dec_done: u32,
+    c2_done: u32,
+    /// EXP-159: extrapolation time (ns) spent on the current transaction on this worker (`pwlxfitus`)
+    lx_tx_ns: u64,
+    /// EXP-159: the block's prewarm termination flag (set when the block's execution has ended): from then on the
+    /// inspector does nothing, so no prewarm worker keeps doing plan work into the next block
+    ended: Option<Arc<AtomicBool>>,
+    /// EXP-171: frame depth of the current run, so that the end of its top-level frame is seen (`reuse`)
+    rdepth: u32,
+    /// X-027: the current transaction's recipient (`None`: a creation) and calldata, from its outermost message
+    tx_to: Option<Address>,
+    tx_input: Bytes,
+    /// Prologue (`lxoff`): this inspector's key at its companion thread (0: nothing sent yet), and the transaction whose
+    /// start was sent last.
+    lxk: u64,
+    lx_sent_cur: u32,
+    /// Prologue (`lxoff`): KECCAK256 inputs kept until the next operation, and how many of this transaction were kept.
+    lx_kbuf: Vec<Vec<u8>>,
+    lx_kn: u32,
+    /// Prologue (`pwlxgate`): per (selector, calldata length) of the current transaction, the first inner call, kept
+    /// until a second one comes (then `None`: the group is handed over as it comes); and that transaction.
+    lx_gate: HashMap<(u32, usize), Option<LxGateCall>>,
+    lx_gate_cur: u32,
+}
+
+/// Prologue (`pwlxgate`): an inner call kept by the gate: target, code hash, caller, calldata, kind, origin, value.
+type LxGateCall = (Address, B256, Address, Bytes, u8, Address, U256);
+
+/// EXP-130: what a prewarm worker has seen of the current transaction's inner calls and creations.
+impl EapPwInspector {
+    /// EXP-206 (`reusebal` in this inspector's block mode): whether its runs record balance observations.
+    pub fn records_balances(&self) -> bool {
+        self.mode.reusebal
+    }
+
+    /// EXP-171: at the end of the run's top-level frame, records whether the beneficiary is in the transaction's state,
+    /// i.e. whether the body loaded it (the post-execution fee credit comes after this point). X-027: revm's journal
+    /// state is evm2's transaction overlay (`State::loaded_accounts`).
+    fn reuse_frame_end<T: EvmTypes>(&mut self, interp: &mut Interpreter<'_, '_, T>) {
+        self.rdepth = self.rdepth.saturating_sub(1);
+        if self.rdepth == 0 && crate::tree::reuse::mode() > 0 {
+            let host = interp.host();
+            let ben = host.block().beneficiary;
+            let loaded = host.state().loaded_accounts().any(|(a, _)| *a == ben);
+            crate::tree::reuse::body_end(loaded);
+        }
+    }
+
+    /// Prologue (`lxoff`): whether this inspector's extrapolation runs on a companion thread.
+    fn lx_off(&self) -> bool {
+        self.mode.lxoff && self.tx.is_some() && self.stats.is_some()
+    }
+
+    /// Prologue (`lxoff`): sends an operation to this inspector's companion (registering the inspector first).
+    fn lx_send(&mut self, body: LxBody) {
+        let (Some(tx), Some(stats)) = (&self.tx, &self.stats) else { return };
+        if self.lxk == 0 {
+            self.lxk = LXK.fetch_add(1, Ordering::Relaxed) + 1;
+            let _ = lx_companion(self.lxk).send((self.lxk, LxBody::Init(tx.clone(), stats.clone(), self.mode)));
+        }
+        // KECCAK256 inputs are kept and go before the next other operation, in order
+        if let LxBody::Keccak(m) = body {
+            if (m.len() == 85 && m[0] == 0xff) || self.lx_kn < 2048 {
+                self.lx_kn += 1;
+                self.lx_kbuf.push(m);
+            }
+            return
+        }
+        if let LxBody::Begin(_) = body {
+            self.lx_flush_keccak();
+            self.lx_kn = 0;
+        } else {
+            self.lx_flush_keccak();
+        }
+        let _ = lx_companion(self.lxk).send((self.lxk, body));
+    }
+
+    /// Prologue (`lxoff`): sends the kept KECCAK256 inputs as one operation.
+    fn lx_flush_keccak(&mut self) {
+        if !self.lx_kbuf.is_empty() {
+            let ms = std::mem::take(&mut self.lx_kbuf);
+            let _ = lx_companion(self.lxk).send((self.lxk, LxBody::Keccaks(ms)));
+        }
+    }
+
+    /// EXP-130: starts the extrapolation state of transaction `cur` (with the cross-transaction shift).
+    fn lx_begin(&mut self, cur: u32) {
+        // Prologue (`lxoff`): the companion starts the transaction
+        if self.lx_off() {
+            if self.lx_sent_cur != cur {
+                self.lx_sent_cur = cur;
+                self.lx_send(LxBody::Begin(cur));
+            }
+            return
+        }
+        // the inspector is created per block, so transaction 0 starts on a fresh tracker (its shift is 0); the
+        // creations the worker saw in the previous transaction are published for the later batches' shift
+        if self.lx.cur != cur {
+            if !self.lx.c2obs.is_empty() {
+                lx_note_created(self.lx.cur, self.lx.n_created);
+            }
+            self.lx.reset(cur);
+            self.lx.shift = lx_shift_for(cur);
+            self.lx_tx_ns = 0;
+        }
+    }
+
+    /// EXP-187 (`pwjitkec=1`): hands the KECCAK256 inputs compiled frames hashed since the last frame hook
+    /// ([`pw_keccak_hook`]) to the extrapolation, as `step` does in interpreted frames. Called at the start of every
+    /// frame hook, so an input reaches the extrapolation before any call that follows it (a minter computes a proxy's
+    /// address, then calls the proxy).
+    fn take_compiled_keccak(&mut self) {
+        if !self.mode.pwjitkec || !self.mode.pwlx || !self.mode.pwlxc2 {
+            return
+        }
+        let cur = PW_CUR_TX.with(|c| c.get());
+        let ms = pw_keccak_take(cur);
+        if ms.is_empty() {
+            return
+        }
+        self.lx_begin(cur);
+        if self.lx_off() {
+            for m in ms {
+                self.lx_send(LxBody::Keccak(m.to_vec()));
+            }
+            return
+        }
+        for m in &ms {
+            self.lx.keccak(m);
+        }
+    }
+
+    /// EXP-151: decoder counts (`pwlxcnt`) once per transaction, and the salt templates (`c2rec`) of the first frame in
+    /// the recipient's storage context whose code has records (the entry itself, or a proxy's implementation).
+    fn lx_tx_setup<T: EvmTypes>(&mut self, interp: &mut Interpreter<'_, '_, T>, message: &Message<T>, cur: u32, stats: &Arc<Stats>) {
+        self.lx_begin(cur);
+        let Some(to) = self.tx_to else { return };
+        if self.mode.pwlxcnt && self.lx_dec_done != cur + 1 {
+            self.lx_dec_done = cur + 1;
+            let txin = self.tx_input.clone();
+            if self.lx_off() {
+                self.lx_send(LxBody::Dec(to, txin));
+            } else {
+                self.lx.set_dec_counts(to, &txin);
+            }
+        }
+        if !self.mode.c2rec || self.c2_done == cur + 1 || message.destination != to {
+            return
+        }
+        let Some(recs) = c2records() else { return };
+        let input = &message.input;
+        let code = message.code.hash_slow();
+        let matching: Vec<&eap_lx::c2rec::Rec> = recs.matching(&code, input).collect();
+        if matching.is_empty() {
+            return
+        }
+        self.c2_done = cur + 1;
+        let sel = input.get(..4).map(|b| u32::from_be_bytes([b[0], b[1], b[2], b[3]])).unwrap_or(0);
+        let earlier = block_txs_before(cur, to, sel);
+        let earlier_refs: Vec<(Address, &[u8])> = earlier.iter().map(|(a, b)| (*a, &b[..])).collect();
+        let sender = interp.tx_env().origin;
+        // block-start state through the prewarm EVM's database (no transaction-overlay effects on the speculative run;
+        // X-027: revm's `db_mut()` is evm2's accepted-state overlay)
+        struct St<'a> {
+            db: &'a mut dyn DynDatabase,
+            addr: Address,
+        }
+        impl eap_lx::c2rec::State for St<'_> {
+            fn sload(&mut self, key: U256) -> U256 {
+                self.db.get_storage(&self.addr, &key).unwrap_or_default()
+            }
+            fn has_code(&mut self, a: Address) -> bool {
+                self.db.get_account(&a).ok().flatten().is_some_and(|i| i.code_hash != KECCAK256_EMPTY && i.code_hash != B256::ZERO)
+            }
+        }
+        let mut st = St { db: interp.host().state_mut().overlay_db_mut(), addr: to };
+        let env = eap_lx::c2rec::Env { address: to, caller: message.caller, origin: sender, input };
+        let mut lists = Vec::new();
+        let none = std::collections::HashMap::new();
+        for r in matching {
+            let ov = eap_lx::c2rec::overrides(r, to, &earlier_refs, &mut st);
+            stats.c2_evals.fetch_add(1, Ordering::Relaxed);
+            // the worker runs this transaction on the block-start state (it observes `view`); the execution thread runs
+            // it after the block's earlier transactions (`truth`, with their counter updates)
+            let truth = eap_lx::c2rec::enumerate(r, env, &mut st, &ov);
+            let view = if ov.is_empty() { truth.clone() } else { eap_lx::c2rec::enumerate(r, env, &mut st, &none) };
+            match (view, truth) {
+                (Some(v), Some(t)) => {
+                    stats.c2_addrs.fetch_add(t.len() as u64, Ordering::Relaxed);
+                    lists.push((v, t));
+                }
+                _ => {
+                    stats.c2_fail.fetch_add(1, Ordering::Relaxed);
+                }
+            }
+        }
+        if self.lx_off() {
+            self.lx_send(LxBody::Known(lists));
+        } else {
+            self.lx.set_known(lists);
+        }
+    }
+
+    /// EXP-130: records an inner call in its (selector, length) group; at the `pwlxn`-th call fits the group
+    /// ([`eap_lx::LxTracker::observe`]) and hands the predicted calls to a reader.
+    fn lx_observe<T: EvmTypes>(&mut self, interp: &mut Interpreter<'_, '_, T>, message: &Message<T>, code_hash: B256, cur: u32, tx: &Sender<Item>, stats: &Arc<Stats>) {
+        self.lx_begin(cur);
+        // EXP-159: per-transaction time limit of the extrapolation on this worker
+        if self.mode.pwlxfitus > 0 && self.lx_tx_ns >= self.mode.pwlxfitus.saturating_mul(1000) {
+            stats.lx_fit_over.fetch_add(1, Ordering::Relaxed);
+            return
+        }
+        let input = message.input.clone();
+        if input.len() < 4 {
+            return
+        }
+        let p = eap_lx::LxParams {
+            n: self.mode.pwlxn as usize,
+            max: self.mode.pwlxmax as usize,
+            c2: self.mode.pwlxc2,
+            v: self.mode.pwlxv as usize,
+            known_n: if self.mode.c2rec { 2 } else { 0 },
+            cnt: self.mode.pwlxcnt,
+        };
+        let txin: Bytes = self.tx_input.clone();
+        let Some(kind) = call_kind(message.kind) else { return };
+        if self.lx_off() {
+            let body = LxBody::Observe(Box::new(LxObs {
+                p,
+                target: message.destination,
+                code: code_hash,
+                caller: message.caller,
+                input,
+                kind,
+                txin,
+                origin: interp.tx_env().origin,
+                value: message.value,
+                cur,
+            }));
+            self.lx_send(body);
+            return
+        }
+        // Prologue (`pwlxgate`): a (selector, length) seen once in the transaction is kept; at the second call the kept
+        // one is handed over first
+        if self.mode.pwlxgate {
+            if self.lx_gate_cur != cur {
+                self.lx_gate_cur = cur;
+                self.lx_gate.clear();
+            }
+            let gk = (u32::from_be_bytes([input[0], input[1], input[2], input[3]]), input.len());
+            let first = match self.lx_gate.entry(gk) {
+                std::collections::hash_map::Entry::Vacant(e) => {
+                    e.insert(Some((message.destination, code_hash, message.caller, input, kind, interp.tx_env().origin, message.value)));
+                    stats.lx_gated.fetch_add(1, Ordering::Relaxed);
+                    return
+                }
+                std::collections::hash_map::Entry::Occupied(mut e) => e.get_mut().take(),
+            };
+            if let Some((a, h, c, inp, k, o, v)) = first {
+                stats.lx_gated.fetch_sub(1, Ordering::Relaxed);
+                let t0 = Instant::now();
+                let r = self.lx.observe(&p, a, h, c, inp, k, &txin, false);
+                self.lx_tx_ns = self.lx_tx_ns.saturating_add(t0.elapsed().as_nanos() as u64);
+                lx_after_observe(r, t0, stats, &self.mode, tx, o, v, cur);
+            }
+        }
+        let t0 = Instant::now();
+        let r = self.lx.observe(&p, message.destination, code_hash, message.caller, input, kind, &txin, false);
+        self.lx_tx_ns = self.lx_tx_ns.saturating_add(t0.elapsed().as_nanos() as u64);
+        lx_after_observe(r, t0, stats, &self.mode, tx, interp.tx_env().origin, message.value, cur);
+    }
+
+    /// EXP-105 (`pwtrace=1`): instantiates the plan of a call a gate stopped and records its keys with `reason`, without
+    /// issuing them.
+    fn trace_would<T: EvmTypes>(&self, interp: &Interpreter<'_, '_, T>, message: &Message<T>, reason: u8) {
+        let Some(plan) = plans().and_then(|p| p.get(&message.code.hash_slow())) else { return };
+        let input = &message.input;
+        let env = self.info.env(message.caller, interp.tx_env().origin, message.destination, message.value, input.len());
+        let keys = PW_SCRATCH.with(|sc| {
+            let mut sc = sc.borrow_mut();
+            let sc = scratch_for_block(&mut sc);
+            sc.instantiate(&plan, &Frame { calldata: input, env, sload: None });
+            sc.out.clone()
+        });
+        let a = message.destination;
+        kt(|k, t| {
+            for key in keys {
+                k.would.entry((a, B256::from(key))).or_insert((reason, t));
+            }
+        });
+    }
+
+    /// EXP-159: the block's prewarm termination flag; once it is set the inspector returns at once.
+    pub fn with_end(mut self, ended: Arc<AtomicBool>) -> Self {
+        self.ended = Some(ended);
+        self
+    }
+
+    /// X-027: records the transaction's recipient and calldata at its outermost message (revm's `tx().kind()`,
+    /// `tx().input()`; evm2's `TxEnv` carries neither).
+    fn note_tx<T: EvmTypes>(&mut self, interp: &Interpreter<'_, '_, T>, message: &Message<T>) {
+        if msg_depth(interp, message) == 0 {
+            self.tx_to = (!message.kind.is_create()).then_some(message.destination);
+            self.tx_input = message.input.clone();
+        }
+    }
+}
+
+/// X-027: revm's `CallScheme` as 2.5.1 numbered it for the extrapolation (`None` for a creation).
+const fn call_kind(kind: MessageKind) -> Option<u8> {
+    match kind {
+        MessageKind::Call => Some(0),
+        MessageKind::CallCode => Some(1),
+        MessageKind::DelegateCall => Some(2),
+        MessageKind::StaticCall => Some(3),
+        _ => None,
+    }
+}
