+/// Prologue (`exlead`): the longest wait for the block's pre-execution workers and the extra lead, in µs.
+pub const LEAD_CAP_US: u64 = 5_000;
+/// Prologue (`exlead`): the execution thread's sleep between two looks at the workers, in µs.
+const LEAD_STEP_US: u64 = 20;
+/// Prologue (`exlead`, `leadlog`): indices of [`Lead`]'s times.
+pub const LEAD_BEGIN: usize = 0;
+/// The prewarm task requested (`payload_processor` before `spawn_blocking_named("prewarm")`).
+pub const LEAD_PW_REQ: usize = 1;
+/// The prewarm task started on its named thread.
+pub const LEAD_PW_START: usize = 2;
+/// The pre-execution's dispatch task (`prewarm-txs`) started.
+pub const LEAD_TXS_START: usize = 3;
+/// Every worker job of the block submitted.
+pub const LEAD_SUBMIT: usize = 4;
+/// The last worker that built its EVM.
+pub const LEAD_BUILT: usize = 5;
+/// The execution thread began its wait (with `exlead`) or reached the point where it would wait.
+pub const LEAD_WAIT: usize = 6;
+/// The execution thread went on to the transactions.
+pub const LEAD_GO: usize = 7;
+const LEAD_N: usize = 8;
+
+static LEAD_BASE: std::sync::LazyLock<Instant> = std::sync::LazyLock::new(Instant::now);
+static LEAD_ON: AtomicBool = AtomicBool::new(false);
+static LEAD: Lead = Lead::new();
+
+/// Prologue (`exlead`, `leadlog`, EXP-254): the block start's times of one block (ns since a process-wide base, 0 = not
+/// reached), the number of pre-execution workers submitted and ready, and whether the execution thread's wait ended at
+/// [`LEAD_CAP_US`]. Marks of another block than the one begun are ignored.
+#[derive(Debug)]
+pub struct Lead {
+    block: AtomicU64,
+    submitted: AtomicU32,
+    built: AtomicU32,
+    timeout: AtomicBool,
+    t: [AtomicU64; LEAD_N],
+}
+
+impl Default for Lead {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl Lead {
+    /// An empty record (no block begun).
+    pub const fn new() -> Self {
+        Self {
+            block: AtomicU64::new(u64::MAX),
+            submitted: AtomicU32::new(0),
+            built: AtomicU32::new(0),
+            timeout: AtomicBool::new(false),
+            t: [const { AtomicU64::new(0) }; LEAD_N],
+        }
+    }
+
+    fn now() -> u64 {
+        (LEAD_BASE.elapsed().as_nanos() as u64).max(1)
+    }
+
+    /// Starts block `block`'s record (after `refresh`).
+    pub fn begin(&self, block: u64) {
+        self.submitted.store(0, Ordering::Relaxed);
+        self.built.store(0, Ordering::Relaxed);
+        self.timeout.store(false, Ordering::Relaxed);
+        for t in &self.t {
+            t.store(0, Ordering::Relaxed);
+        }
+        self.t[LEAD_BEGIN].store(Self::now(), Ordering::Relaxed);
+        self.block.store(block, Ordering::Release);
+    }
+
+    /// The first time block `block` reaches point `i`.
+    pub fn mark(&self, block: u64, i: usize) {
+        if self.block.load(Ordering::Acquire) == block {
+            let _ = self.t[i].compare_exchange(0, Self::now(), Ordering::Relaxed, Ordering::Relaxed);
+        }
+    }
+
+    /// Block `block` submitted `n` worker jobs.
+    pub fn submitted(&self, block: u64, n: u32) {
+        if self.block.load(Ordering::Acquire) == block {
+            self.submitted.store(n, Ordering::Release);
+            self.mark(block, LEAD_SUBMIT);
+        }
+    }
+
+    /// A worker of block `block` built its EVM.
+    pub fn built(&self, block: u64) {
+        if self.block.load(Ordering::Acquire) == block {
+            self.t[LEAD_BUILT].store(Self::now(), Ordering::Relaxed);
+            self.built.fetch_add(1, Ordering::AcqRel);
+        }
+    }
+
+    /// The execution thread of block `block`: with `on`, waits until every submitted worker is ready (a block that
+    /// submitted none waits for the cap: the dispatch may not have run yet) and `extra_us` more after the last one,
+    /// at most [`LEAD_CAP_US`] in all, sleeping [`LEAD_STEP_US`] at a time; returns whether it waited until the cap.
+    /// Without `on` it only marks the point.
+    pub fn wait(&self, block: u64, on: bool, extra_us: u32) -> bool {
+        if self.block.load(Ordering::Acquire) != block {
+            return false
+        }
+        let t0 = Self::now();
+        self.mark(block, LEAD_WAIT);
+        if !on {
+            return false
+        }
+        let cap = t0 + LEAD_CAP_US * 1_000;
+        let ready = || {
+            let s = self.submitted.load(Ordering::Acquire);
+            s > 0 && self.built.load(Ordering::Acquire) >= s
+        };
+        // sleeps of LEAD_STEP_US, not a busy wait: without `excore` the execution thread's core is not its own, and a
+        // real-time thread spinning there would keep the core's other threads off it (Master 21:2x)
+        while !ready() {
+            if Self::now() >= cap {
+                self.timeout.store(true, Ordering::Relaxed);
+                self.mark(block, LEAD_GO);
+                return true
+            }
+            thread::sleep(Duration::from_micros(LEAD_STEP_US));
+        }
+        let until = (self.t[LEAD_BUILT].load(Ordering::Relaxed) + u64::from(extra_us) * 1_000).min(cap);
+        loop {
+            let now = Self::now();
+            if now >= until {
+                break
+            }
+            thread::sleep(Duration::from_nanos((until - now).min(LEAD_STEP_US * 1_000)));
+        }
+        self.mark(block, LEAD_GO);
+        false
+    }
+
+    /// The `eap lead` line's values of block `block`: submitted, ready, timeout and the times in µs after the block's
+    /// begin (-1: not reached); `None` for another block.
+    pub fn snapshot(&self, block: u64) -> Option<(u32, u32, bool, [i64; LEAD_N])> {
+        if self.block.load(Ordering::Acquire) != block {
+            return None
+        }
+        let t0 = self.t[LEAD_BEGIN].load(Ordering::Relaxed);
+        let mut us = [-1i64; LEAD_N];
+        for (i, t) in self.t.iter().enumerate() {
+            let v = t.load(Ordering::Relaxed);
+            if v != 0 {
+                us[i] = (v as i64 - t0 as i64) / 1_000;
+            }
+        }
+        Some((self.submitted.load(Ordering::Relaxed), self.built.load(Ordering::Relaxed), self.timeout.load(Ordering::Relaxed), us))
+    }
+}
+
+/// Prologue (`exlead`, `leadlog`): begins block `block`'s record when either switch is on (called right after
+/// `refresh`); otherwise every lead call below returns after one relaxed load.
+pub fn lead_begin(block: u64) {
+    let m = current();
+    let on = m.active && (m.exlead || m.leadlog);
+    LEAD_ON.store(on, Ordering::Relaxed);
+    if on {
+        LEAD.begin(block);
+    }
+}
+
+/// Prologue (`exlead`, `leadlog`): block `block` reaches point `i` (the `LEAD_*` indices).
+pub fn lead_mark(block: u64, i: usize) {
+    if LEAD_ON.load(Ordering::Relaxed) {
+        LEAD.mark(block, i);
+    }
+}
+
+/// Prologue (`exlead`, `leadlog`): block `block` submitted `n` pre-execution worker jobs.
+pub fn lead_submitted(block: u64, n: u32) {
+    if LEAD_ON.load(Ordering::Relaxed) {
+        LEAD.submitted(block, n);
+    }
+}
+
+/// Prologue (`exlead`, `leadlog`): a pre-execution worker of block `block` built its EVM.
+pub fn lead_built(block: u64) {
+    if LEAD_ON.load(Ordering::Relaxed) {
+        LEAD.built(block);
+    }
+}
+
+/// Prologue (`exlead`): the execution thread's lead floor before the block's transactions (see [`Lead::wait`]).
+pub fn lead_wait(block: u64) {
+    if LEAD_ON.load(Ordering::Relaxed) {
+        let m = current();
+        LEAD.wait(block, m.exlead, m.exleadus);
+    }
+}
