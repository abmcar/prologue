+/// EXP-181 (`rdjoinlate`): reader threads of the previous block, joined at the next block's start, with that block's
+/// number and statistics (the counters the readers add after the block's line was written are logged when they end).
+static LATE_JOIN: Mutex<Option<(u64, Arc<Stats>, Vec<ReaderHandle>)>> = parking_lot::const_mutex(None);
+/// EXP-181 (`rdjoinlate`): the last late join: threads, threads still running when it began, its time (ns).
+static LATE_JOIN_LAST: (AtomicU64, AtomicU64, AtomicU64) = (AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0));
+
+/// EXP-181 (`rdjoinlate`): joins the previous block's reader threads (at the start of the next block's validation and
+/// again in `refresh`) and logs that block's reader counters as they stand once all its readers have ended
+/// (`eap late readers`: the block line was written before the late readers finished).
+pub fn late_join() {
+    // Prologue (`rddefer`): the previous block's drop on the helper thread is done before its readers are joined and
+    // anything of this block is reset (Master 11-07 18:1x)
+    wait_deferred_drops();
+    late_join_inner();
+}
+
+/// EXP-181 (`rdjoinlate`): the join and the `eap late readers` line of [`late_join`], without the wait for the helper
+/// thread (Prologue `prep` runs it on that thread).
+fn late_join_inner() {
+    let Some((block, stats, late)) = LATE_JOIN.lock().take() else { return };
+    let t0 = Instant::now();
+    let running = late.iter().filter(|t| !t.is_finished()).count();
+    let n = late.len();
+    for t in late {
+        t.join();
+    }
+    let join_ns = t0.elapsed().as_nanos() as u64;
+    LATE_JOIN_LAST.0.store(n as u64, Ordering::Relaxed);
+    LATE_JOIN_LAST.1.store(running as u64, Ordering::Relaxed);
+    LATE_JOIN_LAST.2.store(join_ns, Ordering::Relaxed);
+    let g = |a: &AtomicU64| a.load(Ordering::Relaxed);
+    eap_info!(
+        target: "reth::eap",
+        block,
+        threads = n,
+        running,
+        join_us = join_ns / 1000,
+        reads = g(&stats.reads),
+        read_us = g(&stats.read_ns) / 1000,
+        reader_cpu_us = g(&stats.reader_cpu_ns) / 1000,
+        lx_acct_read = g(&stats.lx_acct_read),
+        lx_pf_items = g(&stats.lx_pf_items),
+        lx_pf_willneed = g(&stats.lx_pf_willneed),
+        rd_pf_batches = g(&stats.rd_pf_batches),
+        rd_pf_items = g(&stats.rd_pf_items),
+        rd_pf_willneed = g(&stats.rd_pf_willneed),
+        rd_pf_left = g(&stats.rd_pf_left),
+        "eap late readers"
+    );
+}
