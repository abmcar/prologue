+static INF_ON: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static INF: LazyLock<(parking_lot::Mutex<std::collections::HashSet<(Address, StorageKey)>>, parking_lot::Condvar)> =
