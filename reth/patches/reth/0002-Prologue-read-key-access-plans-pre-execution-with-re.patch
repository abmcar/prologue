+/// EXP-240 (`srmk=1`, diagnostic, counting only): the finish marker's way through the state-root
+/// pipeline. The executor's state hook sends the marker when it is dropped at the executor's finish
+/// ([`crate::state_root_task`]); the hashing task forwards it to the sparse-trie task, which takes
+/// it after the messages queued before it and then leaves its streaming phase. Recorded per block
+/// only while the engine has turned it on ([`srmk::begin_block`]); every hook checks [`srmk::on`]
+/// first, so with it off nothing is recorded. Times are ns after a process-wide base plus one
+/// (0: not reached in this block).
+pub mod srmk {
+    use reth_primitives_traits::FastInstant as Instant;
+    use std::sync::{
+        atomic::{AtomicBool, AtomicU64, Ordering},
+        OnceLock,
+    };
+
+    /// Number of counters in [`STATS`].
+    pub const N: usize = 16;
+    /// The marker was sent (the state hook dropped).
+    pub const SEND_NS: usize = 0;
+    /// Messages queued in the updates channel, ahead of the marker, when it was sent.
+    pub const SEND_QLEN: usize = 1;
+    /// The hashing task forwarded the marker.
+    pub const FWD_NS: usize = 2;
+    /// Messages queued for the sparse-trie task, ahead of the marker, when it was forwarded.
+    pub const FWD_QLEN: usize = 3;
+    /// The sparse-trie task took the marker from its channel.
+    pub const RECV_NS: usize = 4;
+    /// The sparse-trie task left its streaming phase.
+    pub const LEAVE_NS: usize = 5;
+    /// Hashing task, after the send and before forwarding the marker: messages handled.
+    pub const HASH_MSGS: usize = 6;
+    /// Their handling time, ns.
+    pub const HASH_NS: usize = 7;
+    /// Sparse-trie task, after the send and before taking the marker: hashed state updates
+    /// handled.
+    pub const HASHED: usize = 8;
+    /// Their time from taking each to the end of the `make_progress` after it, ns.
+    pub const HASHED_NS: usize = 9;
+    /// The same for prefetch hints.
+    pub const HINTS: usize = 10;
+    /// Their time, ns.
+    pub const HINTS_NS: usize = 11;
+    /// The same for proof results.
+    pub const PROOFS: usize = 12;
+    /// Their time, ns.
+    pub const PROOFS_NS: usize = 13;
+    /// The same for storage-job returns.
+    pub const RETURNS: usize = 14;
+    /// Their time, ns.
+    pub const RETURNS_NS: usize = 15;
+
+    static ON: AtomicBool = AtomicBool::new(false);
+    static BASE: OnceLock<Instant> = OnceLock::new();
+    /// The counters of the current block.
+    pub static STATS: [AtomicU64; N] = [const { AtomicU64::new(0) }; N];
+
+    fn ns(t: Instant) -> u64 {
+        let base = *BASE.get_or_init(Instant::now);
+        1 + if t >= base { t.duration_since(base).as_nanos() as u64 } else { 0 }
+    }
+
+    fn add(i: usize, v: u64) {
+        STATS[i].fetch_add(v, Ordering::Relaxed);
+    }
+
+    /// Whether the current block records.
+    #[inline]
+    pub fn on() -> bool {
+        ON.load(Ordering::Relaxed)
+    }
+
+    /// Resets the counters and turns recording on or off for the next block.
+    pub fn begin_block(on: bool) {
+        BASE.get_or_init(Instant::now);
+        for s in &STATS {
+            s.store(0, Ordering::Relaxed);
+        }
+        ON.store(on, Ordering::Release);
+    }
+
+    /// The state hook sends the marker now, with `queued` messages ahead of it.
+    pub fn send(queued: usize) {
+        STATS[SEND_QLEN].store(queued as u64, Ordering::Relaxed);
+        STATS[SEND_NS].store(ns(Instant::now()), Ordering::Release);
+    }
+
+    fn sent() -> bool {
+        STATS[SEND_NS].load(Ordering::Acquire) != 0
+    }
+
+    /// Hashing task: forwards the marker now, with `queued` messages ahead of it.
+    pub fn forward(queued: usize) {
+        STATS[FWD_QLEN].store(queued as u64, Ordering::Relaxed);
+        STATS[FWD_NS].store(ns(Instant::now()), Ordering::Relaxed);
+    }
+
+    /// Hashing task: a message other than the marker, taken at `t0`, was handled (counted only
+    /// after the send).
+    pub fn hashed_msg(t0: Instant) {
+        if sent() {
+            add(HASH_MSGS, 1);
+            add(HASH_NS, t0.elapsed().as_nanos() as u64);
+        }
+    }
+
+    /// Sparse-trie task: took the marker now.
+    pub fn recv() {
+        STATS[RECV_NS].store(ns(Instant::now()), Ordering::Relaxed);
+    }
+
+    /// Sparse-trie task: left its streaming phase now.
+    pub fn leave() {
+        STATS[LEAVE_NS].store(ns(Instant::now()), Ordering::Relaxed);
+    }
+
+    /// Sparse-trie task: a message counted in `count` ([`HASHED`], [`HINTS`], [`PROOFS`] or
+    /// [`RETURNS`]; its time in the next counter), taken at `t0`, was handled up to the end of the
+    /// `make_progress` after it. Counted only after the send and before the marker was taken.
+    pub fn handled(count: usize, t0: Instant) {
+        if sent() && STATS[RECV_NS].load(Ordering::Relaxed) == 0 {
+            add(count, 1);
+            add(count + 1, t0.elapsed().as_nanos() as u64);
+        }
+    }
+
+    /// Microseconds from the send to now (`None`: not sent in this block).
+    pub fn us_since_send() -> Option<u64> {
+        let s = STATS[SEND_NS].load(Ordering::Acquire);
+        (s != 0).then(|| ns(Instant::now()).saturating_sub(s) / 1000)
+    }
+
+    /// The counters of the current block.
+    pub fn snapshot() -> [u64; N] {
+        core::array::from_fn(|i| STATS[i].load(Ordering::Relaxed))
+    }
+}
+
+/// EXP-240 (`srpf`, approach D of EngineAccessPlan, off unless the engine turns it on for a block):
+/// the keys of every proof job queued by [`ProofWorkerHandle::dispatch`] also go, in chunks of
+/// [`srpf::CHUNK`] targets, to a few persistent threads that look up the stored entries the proof
+/// will read ([`StateProofProvider::prefetch_proof_pages`] on a provider of the block's factory),
+/// so that a job waiting for a worker finds its database pages already read. A chunk is skipped
+/// once its job has finished or the block's handle is gone. The threads only read; nothing they do
+/// reaches a proof, the trie or the database. The engine sets the thread count before each block
+/// ([`srpf::begin_block`], 0: nothing is offered) and reads the counters once the root is known
+/// ([`srpf::snapshot`]). A block's handle can be made before the engine sets that block's count
+/// (the state-root job is prepared on another thread before the payload processor starts), so
+/// whether a job is offered is decided when it is dispatched: dispatches follow the messages the
+/// block's payload processor sends, after its count is set. With `from_marker` the chunks of jobs
+/// dispatched before the block's finish marker are kept until the marker reaches the state-root
+/// task ([`super::ProofWorkerHandle::srpf_marker`]), and only those of jobs not yet done are sent.
+pub mod srpf {
+    use super::{srtl, ProofV2Target, B256};
+    use crossbeam_channel::{unbounded, Receiver, Sender};
+    use reth_primitives_traits::FastInstant as Instant;
+    use reth_provider::{DatabaseProviderROFactory, ProviderResult, StateProofProvider};
+    use std::{
+        fmt,
+        sync::{
+            atomic::{AtomicBool, AtomicU64, AtomicUsize, Ordering},
+            Arc, Mutex, OnceLock,
+        },
+    };
+
+    /// Looks up the entries a proof of these targets reads (accounts, and hashed addresses with
+    /// their slot targets) on a provider opened for the call; returns the number of lookups.
+    pub type Walk =
+        Arc<dyn Fn(&[ProofV2Target], &[(B256, Vec<ProofV2Target>)]) -> ProviderResult<u64> + Send + Sync>;
+
+    /// Targets per chunk: a large job is spread over the threads.
+    pub const CHUNK: usize = 8;
+    /// Number of counters in [`STATS`].
+    pub const N: usize = 9;
+    /// Chunks handed to the threads in the block.
+    pub const OFFERED: usize = 0;
+    /// Chunks looked up.
+    pub const WALKED: usize = 1;
+    /// Chunks skipped: the job had finished, or the block's handle was gone.
+    pub const SKIPPED: usize = 2;
+    /// Cursor lookups of the walked chunks.
+    pub const LOOKUPS: usize = 3;
+    /// Their summed wall time, ns.
+    pub const WALK_NS: usize = 4;
+    /// Their summed processor time on the threads, ns.
+    pub const CPU_NS: usize = 5;
+    /// Major page faults of the threads during the lookups (pages read from disk).
+    pub const MAJFLT: usize = 6;
+    /// Chunks kept until the finish marker (`from_marker`).
+    pub const HELD: usize = 7;
+    /// Kept chunks sent at the marker: their job was not done yet.
+    pub const FLUSHED: usize = 8;
+    /// The counters of the current block.
+    pub static STATS: [AtomicU64; N] = [const { AtomicU64::new(0) }; N];
+
+    /// This block's thread count (0: off).
+    static THREADS: AtomicUsize = AtomicUsize::new(0);
+    /// Set once a block of this process turned the prefetch on: from then on every handle has a
+    /// prefetch, and each dispatch checks [`enabled`].
+    static USED: AtomicBool = AtomicBool::new(false);
+    /// Whether this block keeps its chunks until the finish marker.
+    static FROM_MARKER: AtomicBool = AtomicBool::new(false);
+    /// Threads started so far; they are never stopped.
+    static STARTED: Mutex<usize> = Mutex::new(0);
+    /// Run once by every thread when it starts (set by the engine: priority and core set).
+    static INIT: OnceLock<fn()> = OnceLock::new();
+
+    fn add(i: usize, v: u64) {
+        STATS[i].fetch_add(v, Ordering::Relaxed);
+    }
+
+    fn channel() -> &'static (Sender<Chunk>, Receiver<Chunk>) {
+        static CHANNEL: OnceLock<(Sender<Chunk>, Receiver<Chunk>)> = OnceLock::new();
+        CHANNEL.get_or_init(unbounded)
+    }
+
+    /// Sets the function every thread runs when it starts. The first call wins.
+    pub fn set_thread_init(init: fn()) {
+        let _ = INIT.set(init);
+    }
+
+    /// Resets the counters and sets the thread count for the next block (0: off), starting
+    /// threads up to that count. Threads started for an earlier block keep serving the queue, so
+    /// the count in force is the largest asked for so far. `from_marker`: the block offers the
+    /// keys of the jobs dispatched before its finish marker only at the marker.
+    pub fn begin_block(threads: usize, from_marker: bool) {
+        for s in &STATS {
+            s.store(0, Ordering::Relaxed);
+        }
+        FROM_MARKER.store(from_marker && threads > 0, Ordering::Release);
+        THREADS.store(threads, Ordering::Release);
+        if threads > 0 {
+            USED.store(true, Ordering::Release);
+            let mut started = STARTED.lock().unwrap_or_else(|e| e.into_inner());
+            while *started < threads {
+                let rx = channel().1.clone();
+                let name = format!("eap-srpf-{}", *started);
+                if std::thread::Builder::new().name(name).spawn(move || run(rx)).is_err() {
+                    break
+                }
+                *started += 1;
+            }
+        }
+    }
+
+    /// Whether the current block offers its proof jobs' keys.
+    pub fn enabled() -> bool {
+        THREADS.load(Ordering::Acquire) > 0
+    }
+
+    /// Threads started so far.
+    pub fn started() -> usize {
+        *STARTED.lock().unwrap_or_else(|e| e.into_inner())
+    }
+
+    /// The counters of the current block.
+    pub fn snapshot() -> [u64; N] {
+        core::array::from_fn(|i| STATS[i].load(Ordering::Relaxed))
+    }
+
+    /// One part of a proof job for a thread.
+    pub(super) struct Chunk {
+        walk: Walk,
+        /// False once the block's handle is dropped.
+        live: Arc<AtomicBool>,
+        /// Set by the worker once the job's proof is computed.
+        done: Arc<AtomicBool>,
+        pub(super) accounts: Vec<ProofV2Target>,
+        pub(super) storage: Option<(B256, Vec<ProofV2Target>)>,
+    }
+
+    /// The page prefetch of one block's proof jobs, held by its [`super::ProofWorkerHandle`].
+    pub(super) struct Prefetch {
+        walk: Walk,
+        live: Arc<AtomicBool>,
+        /// Chunks kept until the finish marker (`from_marker`).
+        held: Mutex<Vec<Chunk>>,
+        /// Set once the finish marker reached the state-root task.
+        marked: AtomicBool,
+    }
+
+    impl fmt::Debug for Prefetch {
+        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+            f.debug_struct("Prefetch").field("live", &self.live).finish_non_exhaustive()
+        }
+    }
+
+    impl Drop for Prefetch {
+        fn drop(&mut self) {
+            self.live.store(false, Ordering::Release);
+        }
+    }
+
+    impl Prefetch {
+        /// The prefetch of a block whose proofs are served by providers of `factory` (`None` while
+        /// no block of the process has turned the prefetch on). The handle can be made before the
+        /// block's count is set, so the offers check [`enabled`] themselves; the first block of a
+        /// process that turns the prefetch on may get none, when its handle came first.
+        pub(super) fn new<Factory>(factory: &Factory) -> Option<Self>
+        where
+            Factory: DatabaseProviderROFactory<Provider: StateProofProvider>
+                + Clone
+                + Send
+                + Sync
+                + 'static,
+        {
+            if !enabled() && !USED.load(Ordering::Acquire) {
+                return None
+            }
+            let factory = factory.clone();
+            Some(Self::with_walk(Arc::new(
+                move |accounts: &[ProofV2Target], storages: &[(B256, Vec<ProofV2Target>)]| {
+                    factory.database_provider_ro()?.prefetch_proof_pages(accounts, storages)
+                },
+            )))
+        }
+
+        pub(super) fn with_walk(walk: Walk) -> Self {
+            Self {
+                walk,
+                live: Arc::new(AtomicBool::new(true)),
+                held: Mutex::new(Vec::new()),
+                marked: AtomicBool::new(false),
+            }
+        }
+
+        fn chunk(
+            &self,
+            done: &Arc<AtomicBool>,
+            accounts: Vec<ProofV2Target>,
+            storage: Option<(B256, Vec<ProofV2Target>)>,
+        ) -> Chunk {
+            Chunk {
+                walk: self.walk.clone(),
+                live: self.live.clone(),
+                done: done.clone(),
+                accounts,
+                storage,
+            }
+        }
+
+        /// The chunks of a storage job (no slot targets: one chunk for the trie's first node).
+        pub(super) fn storage_chunks(
+            &self,
+            done: &Arc<AtomicBool>,
+            hashed_address: B256,
+            targets: &[ProofV2Target],
+        ) -> Vec<Chunk> {
+            if targets.is_empty() {
+                return vec![self.chunk(done, Vec::new(), Some((hashed_address, Vec::new())))]
+            }
+            targets
+                .chunks(CHUNK)
+                .map(|part| self.chunk(done, Vec::new(), Some((hashed_address, part.to_vec()))))
+                .collect()
+        }
+
+        /// The chunks of an account job.
+        pub(super) fn account_chunks(
+            &self,
+            done: &Arc<AtomicBool>,
+            targets: &[ProofV2Target],
+        ) -> Vec<Chunk> {
+            targets.chunks(CHUNK).map(|part| self.chunk(done, part.to_vec(), None)).collect()
+        }
+
+        /// Offers a storage job's keys; returns the flag its worker sets when the proof is done
+        /// (`None`: the current block does not offer its jobs' keys).
+        pub(super) fn offer_storage(
+            &self,
+            hashed_address: B256,
+            targets: &[ProofV2Target],
+        ) -> Option<Arc<AtomicBool>> {
+            if !enabled() {
+                return None
+            }
+            let done = Arc::new(AtomicBool::new(false));
+            self.place(
+                self.storage_chunks(&done, hashed_address, targets),
+                FROM_MARKER.load(Ordering::Acquire),
+            );
+            Some(done)
+        }
+
+        /// Offers an account job's keys; returns the flag its worker sets when the proof is done
+        /// (`None`: the current block does not offer its jobs' keys).
+        pub(super) fn offer_accounts(&self, targets: &[ProofV2Target]) -> Option<Arc<AtomicBool>> {
+            if !enabled() {
+                return None
+            }
+            let done = Arc::new(AtomicBool::new(false));
+            self.place(self.account_chunks(&done, targets), FROM_MARKER.load(Ordering::Acquire));
+            Some(done)
+        }
+
+        /// Sends the chunks to the threads; with `hold`, keeps them instead until [`Self::marker`]
+        /// unless the marker has already been seen.
+        pub(super) fn place(&self, chunks: Vec<Chunk>, hold: bool) {
+            if hold {
+                let mut held = self.held.lock().unwrap_or_else(|e| e.into_inner());
+                if !self.marked.load(Ordering::Relaxed) {
+                    add(HELD, chunks.len() as u64);
+                    held.extend(chunks);
+                    return
+                }
+            }
+            chunks.into_iter().for_each(send);
+        }
+
+        /// The block's finish marker reached the state-root task: sends the kept chunks whose job
+        /// is not done yet (in dispatch order) and returns their number; later chunks are sent at
+        /// once.
+        pub(super) fn marker(&self) -> usize {
+            let held = {
+                let mut held = self.held.lock().unwrap_or_else(|e| e.into_inner());
+                self.marked.store(true, Ordering::Relaxed);
+                std::mem::take(&mut *held)
+            };
+            let pending: Vec<_> =
+                held.into_iter().filter(|chunk| !chunk.done.load(Ordering::Acquire)).collect();
+            add(FLUSHED, pending.len() as u64);
+            let sent = pending.len();
+            pending.into_iter().for_each(send);
+            sent
+        }
+    }
+
+    fn send(chunk: Chunk) {
+        add(OFFERED, 1);
+        // The receivers live in the threads, which never exit, so the send does not fail.
+        let _ = channel().0.send(chunk);
+    }
+
+    /// Looks the chunk up unless its job has finished or its block's handle is gone; returns the
+    /// number of lookups, `None` when skipped. A failed lookup counts as none (it only prefetches).
+    pub(super) fn walk(chunk: &Chunk) -> Option<u64> {
+        if !chunk.live.load(Ordering::Acquire) || chunk.done.load(Ordering::Acquire) {
+            return None
+        }
+        Some((chunk.walk)(&chunk.accounts, chunk.storage.as_slice()).unwrap_or(0))
+    }
+
+    fn run(rx: Receiver<Chunk>) {
+        if let Some(init) = INIT.get() {
+            init();
+        }
+        while let Ok(chunk) = rx.recv() {
+            let (t0, cpu0, flt0) = (Instant::now(), thread_cpu_ns(), srtl::thread_majflt());
+            match walk(&chunk) {
+                None => add(SKIPPED, 1),
+                Some(lookups) => {
+                    add(WALKED, 1);
+                    add(LOOKUPS, lookups);
+                    add(WALK_NS, t0.elapsed().as_nanos() as u64);
+                    add(CPU_NS, thread_cpu_ns().saturating_sub(cpu0));
+                    add(MAJFLT, srtl::thread_majflt().saturating_sub(flt0));
+                }
+            }
+        }
+    }
+
+    /// The calling thread's processor time, ns (0 where unavailable).
+    fn thread_cpu_ns() -> u64 {
+        #[cfg(target_os = "linux")]
+        {
+            let mut ts = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+            // SAFETY: `clock_gettime` fills the timespec it is given and has no other effect.
+            if unsafe { libc::clock_gettime(libc::CLOCK_THREAD_CPUTIME_ID, &mut ts) } == 0 {
+                return ts.tv_sec as u64 * 1_000_000_000 + ts.tv_nsec as u64
+            }
+        }
+        0
+    }
+}
