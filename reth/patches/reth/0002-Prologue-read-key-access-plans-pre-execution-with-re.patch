+#[cfg(test)]
+mod reader_pool_tests {
+    use super::{LxGate, ReaderHandle, ReaderPool};
+    use alloy_primitives::{Address, B256, U256};
+    use std::{
+        collections::HashSet,
+        sync::{
+            atomic::{AtomicBool, AtomicUsize, Ordering},
+            Arc, Mutex,
+        },
+        thread::ThreadId,
+        time::{Duration, Instant},
+    };
+
+    /// Stand-in for a reader's provider: dropping it is what releases the read-only transaction.
+    struct Provider(Arc<AtomicBool>);
+
+    impl Drop for Provider {
+        fn drop(&mut self) {
+            self.0.store(true, Ordering::SeqCst);
+        }
+    }
+
+    fn wait_until(what: &str, f: impl Fn() -> bool) {
+        let t0 = Instant::now();
+        while !f() {
+            assert!(t0.elapsed() < Duration::from_secs(10), "timed out waiting for {what}");
+            std::thread::sleep(Duration::from_micros(200));
+        }
+    }
+
+    /// Joining a pooled reader returns only after the job's reader, with its provider (the read-only transaction), is
+    /// dropped: both a provider moved into the job's body and one only captured by the job's closure.
+    #[test]
+    fn join_returns_after_the_jobs_provider_is_dropped() {
+        let pool = ReaderPool::new();
+        let (moved, captured) = (Arc::new(AtomicBool::new(false)), Arc::new(AtomicBool::new(false)));
+        let (m, c) = (moved.clone(), captured.clone());
+        let held = Provider(c);
+        let h = pool
+            .submit(
+                "t",
+                Box::new(move || {
+                    let _p = Provider(m);
+                    let _keep = &held;
+                    std::thread::sleep(Duration::from_millis(5));
+                }),
+            )
+            .unwrap();
+        assert!(matches!(h, ReaderHandle::Pooled(_)));
+        h.join();
+        assert!(moved.load(Ordering::SeqCst), "the reader's provider outlived the join");
+        assert!(captured.load(Ordering::SeqCst), "a provider captured by the job outlived the join");
+    }
+
+    /// Every submitted job starts at once (a block reader runs until its block stops, so none may wait behind another):
+    /// 8 readers, then 8 more when the extrapolation gate opens, all running together on 16 threads; after the block the
+    /// threads wait, and the next block's 8 readers run on some of the same threads without creating new ones.
+    #[test]
+    fn every_job_starts_at_once_and_the_next_block_reuses_the_threads() {
+        let pool = ReaderPool::new();
+        let block = |n: usize, stop: &Arc<AtomicBool>, started: &Arc<AtomicUsize>, ids: &Arc<Mutex<HashSet<ThreadId>>>| {
+            (0..n)
+                .map(|_| {
+                    let (stop, started, ids) = (stop.clone(), started.clone(), ids.clone());
+                    pool.submit(
+                        "t",
+                        Box::new(move || {
+                            ids.lock().unwrap().insert(std::thread::current().id());
+                            started.fetch_add(1, Ordering::SeqCst);
+                            while !stop.load(Ordering::SeqCst) {
+                                std::thread::sleep(Duration::from_micros(100));
+                            }
+                        }),
+                    )
+                    .unwrap()
+                })
+                .collect::<Vec<_>>()
+        };
+        let (stop1, started1, ids1) = (Arc::new(AtomicBool::new(false)), Arc::new(AtomicUsize::new(0)), Arc::new(Mutex::new(HashSet::new())));
+        let mut h1 = block(8, &stop1, &started1, &ids1);
+        wait_until("8 readers running", || started1.load(Ordering::SeqCst) == 8);
+        h1.extend(block(8, &stop1, &started1, &ids1));
+        wait_until("16 readers running", || started1.load(Ordering::SeqCst) == 16);
+        assert_eq!(pool.threads(), 16);
+        assert_eq!(ids1.lock().unwrap().len(), 16);
+        stop1.store(true, Ordering::SeqCst);
+        for h in h1 {
+            h.join();
+        }
+        wait_until("16 idle threads", || pool.idle.load(Ordering::SeqCst) == 16);
+        let (stop2, started2, ids2) = (Arc::new(AtomicBool::new(false)), Arc::new(AtomicUsize::new(0)), Arc::new(Mutex::new(HashSet::new())));
+        let h2 = block(8, &stop2, &started2, &ids2);
+        wait_until("next block's 8 readers running", || started2.load(Ordering::SeqCst) == 8);
+        assert!(h2.iter().all(|h| !h.is_finished()), "a running reader reported finished");
+        stop2.store(true, Ordering::SeqCst);
+        for h in &h2 {
+            let t0 = Instant::now();
+            while !h.is_finished() {
+                assert!(t0.elapsed() < Duration::from_secs(10));
+                std::thread::sleep(Duration::from_micros(100));
+            }
+        }
+        for h in h2 {
+            h.join();
+        }
+        assert_eq!(pool.threads(), 16, "the next block created threads");
+        assert!(ids2.lock().unwrap().is_subset(&ids1.lock().unwrap()));
+    }
+
+    /// The cache generation guard still holds on a persistent thread: a block's reader records the generation when it
+    /// builds its provider (inside its job), so a fill that comes after the block's writes were applied is dropped, and
+    /// the next block's reader on the same thread fills for the new generation.
+    #[test]
+    fn a_late_fill_is_dropped_and_the_next_block_fills_on_the_same_thread() {
+        let pool = ReaderPool::new();
+        let caches = reth_execution_cache::ExecutionCache::new(1000);
+        let (a, k, v) = (Address::with_last_byte(7), B256::with_last_byte(9), U256::from(42));
+        let (built, advanced, filled) = (Arc::new(AtomicBool::new(false)), Arc::new(AtomicBool::new(false)), Arc::new(Mutex::new(None)));
+        let tid1 = Arc::new(Mutex::new(None));
+        let h1 = {
+            let (caches, built, advanced, filled, tid1) = (caches.clone(), built.clone(), advanced.clone(), filled.clone(), tid1.clone());
+            pool.submit(
+                "t",
+                Box::new(move || {
+                    *tid1.lock().unwrap() = Some(std::thread::current().id());
+                    let generation = caches.generation();
+                    built.store(true, Ordering::SeqCst);
+                    while !advanced.load(Ordering::SeqCst) {
+                        std::thread::sleep(Duration::from_micros(100));
+                    }
+                    *filled.lock().unwrap() = Some(caches.fill_storage(generation, a, k, v));
+                }),
+            )
+            .unwrap()
+        };
+        wait_until("block 1's provider", || built.load(Ordering::SeqCst));
+        // the block's writes are applied: the generation advances first
+        assert_eq!(caches.advance_generation(), 0);
+        advanced.store(true, Ordering::SeqCst);
+        h1.join();
+        assert_eq!(*filled.lock().unwrap(), Some(false), "the late fill was not dropped");
+        assert_eq!(caches.peek_storage(a, k), None);
+        wait_until("the thread idle again", || pool.idle.load(Ordering::SeqCst) == 1);
+        let (filled2, tid2) = (Arc::new(Mutex::new(None)), Arc::new(Mutex::new(None)));
+        let h2 = {
+            let (caches, filled2, tid2) = (caches.clone(), filled2.clone(), tid2.clone());
+            pool.submit(
+                "t",
+                Box::new(move || {
+                    *tid2.lock().unwrap() = Some(std::thread::current().id());
+                    let generation = caches.generation();
+                    *filled2.lock().unwrap() = Some(caches.fill_storage(generation, a, k, v));
+                }),
+            )
+            .unwrap()
+        };
+        h2.join();
+        assert_eq!(pool.threads(), 1);
+        assert_eq!(*tid2.lock().unwrap(), *tid1.lock().unwrap());
+        assert_eq!(*filled2.lock().unwrap(), Some(true));
+        assert_eq!(caches.peek_storage(a, k), Some(v));
+        // the dropped late fill was counted
+        assert_eq!(caches.advance_generation(), 1);
+    }
+
+    /// At its limit with no idle thread, the pool runs a job on a thread of its own (it still starts at once) and does not
+    /// grow; the busy peak records the most jobs running on pool threads at once.
+    #[test]
+    fn at_the_limit_a_job_runs_on_its_own_thread_and_the_pool_does_not_grow() {
+        let pool = ReaderPool::with_max(2);
+        let (stop, started) = (Arc::new(AtomicBool::new(false)), Arc::new(AtomicUsize::new(0)));
+        let hs: Vec<_> = (0..3)
+            .map(|_| {
+                let (stop, started) = (stop.clone(), started.clone());
+                pool.submit(
+                    "t",
+                    Box::new(move || {
+                        started.fetch_add(1, Ordering::SeqCst);
+                        while !stop.load(Ordering::SeqCst) {
+                            std::thread::sleep(Duration::from_micros(100));
+                        }
+                    }),
+                )
+                .unwrap()
+            })
+            .collect();
+        wait_until("3 jobs running", || started.load(Ordering::SeqCst) == 3);
+        assert_eq!(pool.threads(), 2);
+        assert_eq!(pool.overflow.load(Ordering::SeqCst), 1);
+        assert_eq!(hs.iter().filter(|h| matches!(h, ReaderHandle::Thread(_))).count(), 1);
+        assert_eq!(pool.busy_peak.load(Ordering::SeqCst), 2);
+        stop.store(true, Ordering::SeqCst);
+        for h in hs {
+            h.join();
+        }
+        wait_until("2 idle threads", || pool.idle.load(Ordering::SeqCst) == 2 && pool.busy.load(Ordering::SeqCst) == 0);
+    }
+
+    /// A new pool thread inherits its creator's nice value and could not lower it again: a submit from a thread with
+    /// another nice value (e.g. a dedicated heavy-transaction thread at `hvnice` opening the extrapolation gate) that
+    /// needs a new thread runs the job on a thread of its own, and every pool thread keeps the pool's nice value. Needs
+    /// headroom to raise the submitting thread's nice (skipped when the test already runs at nice 19).
+    #[test]
+    fn a_submit_from_a_thread_with_another_nice_value_does_not_grow_the_pool() {
+        let pool = Arc::new(ReaderPool::new());
+        if pool.nice >= 19 {
+            eprintln!("skipped: the test runs at nice {}", pool.nice);
+            return
+        }
+        let nices = Arc::new(Mutex::new(Vec::new()));
+        // a pool thread made from a thread with the pool's own nice value
+        let n0 = nices.clone();
+        pool.submit("t", Box::new(move || n0.lock().unwrap().push(super::own_nice()))).unwrap().join();
+        wait_until("one idle thread", || pool.idle.load(Ordering::SeqCst) == 1);
+        // from a thread at a higher nice value: two jobs at once, so one finds no idle thread
+        let (p, n1) = (pool.clone(), nices.clone());
+        let handles = std::thread::spawn(move || {
+            super::set_own_nice((p.nice + 5).min(19) as u32);
+            let (stop, started) = (Arc::new(AtomicBool::new(false)), Arc::new(AtomicUsize::new(0)));
+            let hs: Vec<_> = (0..2)
+                .map(|_| {
+                    let (stop, started, n1) = (stop.clone(), started.clone(), n1.clone());
+                    p.submit(
+                        "t",
+                        Box::new(move || {
+                            n1.lock().unwrap().push(super::own_nice());
+                            started.fetch_add(1, Ordering::SeqCst);
+                            while !stop.load(Ordering::SeqCst) {
+                                std::thread::sleep(Duration::from_micros(100));
+                            }
+                        }),
+                    )
+                    .unwrap()
+                })
+                .collect();
+            wait_until("2 jobs running", || started.load(Ordering::SeqCst) == 2);
+            stop.store(true, Ordering::SeqCst);
+            hs
+        })
+        .join()
+        .unwrap();
+        assert_eq!(handles.iter().filter(|h| matches!(h, ReaderHandle::Pooled(_))).count(), 1);
+        assert_eq!(handles.iter().filter(|h| matches!(h, ReaderHandle::Thread(_))).count(), 1);
+        for h in handles {
+            h.join();
+        }
+        assert_eq!(pool.threads(), 1);
+        assert_eq!(pool.nice_unpooled.load(Ordering::SeqCst), 1);
+        // the pooled jobs ran at the pool's nice value, the unpooled one at the submitting thread's
+        let v = nices.lock().unwrap().clone();
+        assert_eq!(v.iter().filter(|&&n| n == pool.nice).count(), 2, "{v:?}");
+        assert_eq!(v.len(), 3);
+    }
+
+    /// A pool thread keeps its thread-local state from one job to the next, so every reader job starts with
+    /// `reader_thread_reset`: what an earlier block's job left behind (tag source, discovery buffer, prewarm-transaction
+    /// trigger, prewarm transaction index) does not reach the next block's reader.
+    #[test]
+    fn thread_locals_of_one_block_do_not_reach_the_next_blocks_reader() {
+        use reth_execution_cache::{cc_discover_begin, cc_discovering, cc_set_tag_source, cc_tag_source, cc_tx_begin, cc_tx_disarm, CC_SRC_EAP_NB, CC_SRC_EAP_TX};
+        let pool = ReaderPool::new();
+        let tids = Arc::new(Mutex::new(Vec::new()));
+        let run = |f: Box<dyn FnOnce() + Send>| {
+            let tids = tids.clone();
+            pool.submit(
+                "t",
+                Box::new(move || {
+                    tids.lock().unwrap().push(std::thread::current().id());
+                    f()
+                }),
+            )
+            .unwrap()
+            .join()
+        };
+        // block 1's job leaves state behind
+        run(Box::new(|| {
+            super::reader_thread_reset();
+            cc_set_tag_source(CC_SRC_EAP_NB);
+            cc_discover_begin();
+            cc_tx_begin(5);
+            super::PW_CUR_TX.with(|c| c.set(7));
+        }));
+        // the state does persist on the thread (so the reset is needed) ...
+        let seen = Arc::new(Mutex::new(None));
+        let s = seen.clone();
+        run(Box::new(move || {
+            *s.lock().unwrap() = Some((cc_tag_source(), cc_discovering(), super::PW_CUR_TX.with(|c| c.get())));
+        }));
+        assert_eq!(*seen.lock().unwrap(), Some((CC_SRC_EAP_NB, true, 7)));
+        // ... and a reader job's reset clears it
+        let after = Arc::new(Mutex::new(None));
+        let a = after.clone();
+        run(Box::new(move || {
+            super::reader_thread_reset();
+            *a.lock().unwrap() = Some((cc_tag_source(), cc_discovering(), cc_tx_disarm(), super::PW_CUR_TX.with(|c| c.get())));
+        }));
+        assert_eq!(*after.lock().unwrap(), Some((CC_SRC_EAP_TX, false, false, u32::MAX)));
+        let t = tids.lock().unwrap();
+        assert!(t.windows(2).all(|w| w[0] == w[1]), "the jobs ran on different threads");
+    }
+
+    /// The extrapolation gate's extra readers go to the pool when it opens (once), are joined with the block's other
+    /// readers, and are not submitted at all once the block has stopped; a job that panics ends, its thread stays.
+    #[test]
+    fn gate_submits_extra_readers_once_and_a_panicking_job_keeps_its_thread() {
+        let pool = Arc::new(ReaderPool::new());
+        let ran = Arc::new(AtomicUsize::new(0));
+        let stop = Arc::new(AtomicBool::new(false));
+        let g = LxGate::new(stop.clone());
+        let (p, r) = (pool.clone(), ran.clone());
+        *g.spawner.lock() = Some(Box::new(move || {
+            (0..8)
+                .filter_map(|_| {
+                    let r = r.clone();
+                    p.submit(
+                        "t",
+                        Box::new(move || {
+                            r.fetch_add(1, Ordering::SeqCst);
+                        }),
+                    )
+                })
+                .collect()
+        }));
+        g.open();
+        g.open();
+        let t = g.take_spawned();
+        assert_eq!(t.len(), 8);
+        for h in t {
+            h.join();
+        }
+        assert_eq!(ran.load(Ordering::SeqCst), 8);
+        let before = pool.threads();
+        let stop2 = Arc::new(AtomicBool::new(false));
+        let g2 = LxGate::new(stop2.clone());
+        let p2 = pool.clone();
+        *g2.spawner.lock() = Some(Box::new(move || p2.submit("t", Box::new(|| {})).into_iter().collect()));
+        stop2.store(true, Ordering::SeqCst);
+        g2.open();
+        assert!(g2.take_spawned().is_empty());
+        assert_eq!(pool.threads(), before);
+        wait_until("idle threads", || pool.idle.load(Ordering::SeqCst) == before);
+        pool.submit("t", Box::new(|| panic!("reader job panics (expected in this test)"))).unwrap().join();
+        let ok = Arc::new(AtomicBool::new(false));
+        let o = ok.clone();
+        pool.submit("t", Box::new(move || o.store(true, Ordering::SeqCst))).unwrap().join();
+        assert!(ok.load(Ordering::SeqCst));
+        assert_eq!(pool.threads(), before, "a panicking job cost its thread");
+    }
+}
