+    /// EXP-212: a read-back inside [`outside_run`] neither marks the run nor enters the `ewredo` log, and both are restored
+    /// afterwards (also when the run had already read from the writes); reads after it are marked and logged as before.
+    #[test]
+    fn outside_run_keeps_the_runs_marks_and_log() {
+        let k = (Address::repeat_byte(1), B256::repeat_byte(2));
+        // what EwOverlay::storage does for a slot an earlier transaction wrote (version 3)
+        let overlay_read = || {
+            USED.with(|c| c.set(true));
+            if LOG_ON.with(|c| c.get()) {
+                READ_LOG.with(|r| r.borrow_mut().push((k, 3)));
+            }
+        };
+        run_begin_logged(true);
+        let v = outside_run(|| {
+            overlay_read();
+            assert!(!LOG_ON.with(|c| c.get()), "logging is off inside");
+            7
+        });
+        assert_eq!(v, 7);
+        assert!(!run_used_writes(), "the read-back did not mark the run");
+        assert!(LOG_ON.with(|c| c.get()), "logging restored");
+        assert!(READ_LOG.with(|r| r.borrow().is_empty()), "the read-back was not logged");
+        // the run's own read afterwards is marked and logged
+        overlay_read();
+        assert!(run_used_writes());
+        assert_eq!(take_read_log(), vec![(k, 3)]);
+        // a mark the run already had stays
+        outside_run(|| USED.with(|c| c.set(false)));
