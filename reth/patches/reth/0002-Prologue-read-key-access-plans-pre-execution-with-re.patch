+        for bad in ["", "x", "7 a", "7 x:00", "7 a:zz", "7 s:ab", "7 c:00"] {
+            assert_eq!(pl_parse_line(bad), None, "{bad}");
+        }
+        let path = std::env::temp_dir().join(format!("eap-plrec-test-{}.txt", std::process::id()));
+        let _ = std::fs::remove_file(&path);
+        pl_append(&path, 1, &keys);
+        pl_append(&path, 2, &[]);
+        let text = std::fs::read_to_string(&path).unwrap();
+        std::fs::remove_file(&path).unwrap();
+        let blocks: Vec<_> = text.lines().map(|l| pl_parse_line(l).unwrap()).collect();
+        assert_eq!(blocks, vec![(1, keys), (2, Vec::new())]);
+    }
+}
