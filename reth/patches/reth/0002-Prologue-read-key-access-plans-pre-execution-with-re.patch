+#[inline] fn mask_range(lo: u32, hi: u32) -> [u64; 8] {
+    let mut m = [0u64; 8];
+    if lo >= hi { return m; }
+    for w in 0..8u32 {
+        let (a, b) = (w * 64, w * 64 + 64);
+        let (l, h) = (lo.max(a), hi.min(b));
+        if l < h { let n = h - l; let bits = if n == 64 { u64::MAX } else { ((1u64 << n) - 1) << (l - a) }; m[w as usize] = bits; }
+    }
+    m
+}
