+#[cfg(test)]
+mod opt_get_tests {
+    use super::*;
+
+    /// Prologue (`exopt`, `fillopt`, X-031): the optimistic lookup finds what was inserted, misses what was not or was
+    /// removed, and sees a replaced value.
+    #[test]
+    fn get_seq_reads_without_locking() {
+        let cache: FixedCache<u64, u64> = FixedCache::new(1 << 12, Default::default());
+        assert_eq!(cache.get_seq(&1), None);
+        cache.insert(1, 10);
+        assert_eq!(cache.get_seq(&1), Some(10));
+        assert_eq!(cache.get_seq(&2), None);
+        cache.insert(1, 11);
+        assert_eq!(cache.get_seq(&1), Some(11));
+        assert_eq!(cache.remove(&1), Some(11));
+        assert_eq!(cache.get_seq(&1), None);
+    }
+
+    /// Prologue (`exopt`, `fillopt`, X-031): while another thread keeps rewriting the same entry with (v, v) pairs, an
+    /// optimistic lookup never returns a pair with unequal halves (no torn copy is kept).
+    #[test]
+    fn get_seq_never_sees_a_torn_entry() {
+        let cache: std::sync::Arc<FixedCache<u64, (u64, u64)>> = std::sync::Arc::new(FixedCache::new(1 << 12, Default::default()));
+        let stop = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let w = {
+            let (cache, stop) = (cache.clone(), stop.clone());
+            std::thread::spawn(move || {
+                let mut v = 0u64;
+                while !stop.load(Ordering::Relaxed) {
+                    v = v.wrapping_add(1);
+                    cache.insert(1, (v, v));
+                }
+            })
+        };
+        let mut seen = 0;
+        for _ in 0..200_000 {
+            if let Some((a, b)) = cache.get_seq(&1) {
+                assert_eq!(a, b);
+                seen += 1;
+            }
+        }
+        stop.store(true, Ordering::Relaxed);
+        w.join().unwrap();
+        assert!(seen > 0);
+    }
+
+    /// Prologue (`exopt`, `fillopt`, X-031): the switches pick the lookup; an account and a slot inserted are found both
+    /// ways.
+    #[test]
+    fn opt_switches_find_the_same_entries() {
+        let caches = ExecutionCache::new(1 << 10);
+        let a = Address::repeat_byte(7);
+        let k = StorageKey::repeat_byte(3);
+        caches.insert_account(a, Some(Account::default()));
+        caches.insert_storage(a, k, Some(StorageValue::from(5u8)));
+        for opt in [false, true] {
+            assert_eq!(acct_get(&caches, &a, opt), Some(Some(Account::default())));
+            assert_eq!(slot_get(&caches, a, k, opt), Some(StorageValue::from(5u8)));
+        }
+        opt_get_set(true, true);
+        assert_eq!(caches.peek_account(&a), Some(Some(Account::default())));
+        opt_get_set(false, false);
+    }
+}
