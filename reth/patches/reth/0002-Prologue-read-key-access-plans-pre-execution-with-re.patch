+        fast: bool,
+        bal: bool,
+        tag: u8,
+        record: bool,
+    ) -> Outcome {
+        let txs = txs_of(spec);
+        let cfg = EthEvmConfig::mainnet();
+        let block = B256::repeat_byte(tag);
+        set_mode(mode, chk, fast, bal, 0, false, 0);
+        begin_exec(block);
+        TRIPPED.store(false, Ordering::Relaxed);
+        if mode > 0 {
+            for (i, t) in txs.iter().enumerate() {
+                let mut evm = cfg.evm_with_env(parent.clone(), evm_env(true));
+                tx_begin();
+                let insp = ObsInspector { record, ..Default::default() };
+                let (_, res) = reth_evm::Evm::transact_with_inspector(&mut evm, &cfg.tx_env(t.clone()), insp).unwrap();
+                store_checked(block, i, &res, false, 0);
+            }
+        }
+        let evm = cfg.evm_with_env(parent.clone(), evm_env(false));
+        let mut ex = cfg.block_executor_factory().create_executor(evm, ctx());
+        if let Some(mut h) = wrap_hook(None) {
+            ex.set_state_hook(move |u| h(u));
+        }
+        ex.apply_pre_execution_changes().unwrap();
+        for (i, t) in txs.iter().enumerate() {
+            if let Some(tx) = run_tx(&mut ex, &cfg, block, 1, BEN, i, t.clone()).unwrap() {
+                ex.execute_transaction(tx).unwrap();
+            }
+        }
+        let output = ex.finish().unwrap();
+        let g = |a: &AtomicU64| a.load(Ordering::Relaxed);
+        let counts = [
+            g(&STATS.reused),
+            g(&STATS.bal_valid),
+            g(&STATS.mismatch),
+            g(&STATS.upd_mismatch),
+            g(&STATS.checked),
+            g(&STATS.bal_send),
+        ];
+        finish_exec(1, txs.len());
+        set_mode(0, 0, false, false, 0, false, 0);
+        Outcome { receipts: output.result.receipts, bundle: output.state, counts }
+    }
+
+    fn funded(senders: &[Address]) -> CacheDB<EmptyDB> {
+        let mut parent = CacheDB::new(EmptyDB::default());
+        for s in senders {
+            parent.insert_account_info(s, AccountInfo { balance: U256::from(10u128.pow(20)), ..Default::default() });
+        }
+        parent
+    }
+
+    fn contract(code: Vec<u8>) -> AccountInfo {
+        let b = Bytecode::new_raw(code.into());
+        AccountInfo { balance: U256::from(1000), nonce: 1, code_hash: b.hash_slow(), code: Some(b), ..Default::default() }
+    }
+
+    /// the observations of a run that read the balances of `addrs` and sent no value
+    fn reads(addrs: &[Address]) -> Option<AddressMap<BalObs>> {
+        Some(addrs.iter().map(|a| (*a, BalObs { bits: BalObs::READ, ..Default::default() })).collect())
+    }
+
+    /// X-027 (required by the coordinator): one set of dependent transactions (the same sender twice, a counter
+    /// incremented by three transactions, a value transfer to a contract another transaction then reads, and an
+    /// independent transfer) executed with reuse on (`reuse=2`, with and without the restricted check, and with the
+    /// in-block check every third transaction) gives exactly the receipts and the post-state (bundle, hence state root)
+    /// of executing it with reuse off; the independent transactions are reused, and check mode finds no difference.
+    #[test]
+    fn dependent_transactions_reuse_equals_no_reuse() {
+        let _g = GLOBAL.lock();
+        let (s1, s2, s3, s4) =
+            (Address::repeat_byte(0x11), Address::repeat_byte(0x22), Address::repeat_byte(0x23), Address::repeat_byte(0x24));
+        let (counter, reader, sink) = (Address::repeat_byte(0xc1), Address::repeat_byte(0xc2), Address::repeat_byte(0xc3));
+        let mut parent = funded(&[s1, s2, s3, s4]);
+        // COUNTER: slot 0 += 1
+        parent.insert_account_info(&counter, contract(vec![0x5f, 0x54, 0x60, 0x01, 0x01, 0x5f, 0x55, 0x00]));
+        // READER: stores BALANCE(SINK) in slot 0
+        let reader_code = [vec![0x73], sink.to_vec(), vec![0x31, 0x5f, 0x55, 0x00]].concat();
+        parent.insert_account_info(&reader, contract(reader_code));
+        parent.insert_account_info(&sink, AccountInfo { balance: U256::from(5), nonce: 1, ..Default::default() });
+        let n = Bytes::new();
+        let spec: Vec<TxSpec> = vec![
+            (s1, 0, counter, 0, 100_000, 10, n.clone()),
+            (s2, 0, counter, 0, 100_000, 11, n.clone()),
+            (s1, 1, sink, 3, 21_000, 10, n.clone()),
+            (s3, 0, reader, 0, 100_000, 10, n.clone()),
+            (s4, 0, Address::repeat_byte(0x99), 1, 21_000, 10, n.clone()),
+            (s3, 1, counter, 0, 100_000, 12, n.clone()),
+        ];
+        let reference = run_block(&parent, &spec, 0, 0, false, false, 0xa0, true);
+        assert_eq!(reference.receipts.len(), spec.len());
+        assert!(reference.receipts.iter().all(|r| r.success));
+        for (tag, chk, fast, bal) in [(0xa1, 0, true, true), (0xa2, 0, false, true), (0xa3, 3, true, true), (0xa4, 0, true, false)] {
+            let o = run_block(&parent, &spec, 2, chk, fast, bal, tag, true);
+            assert_eq!(o.receipts, reference.receipts, "receipts, chk {chk} fast {fast} bal {bal}");
+            assert_eq!(o.bundle, reference.bundle, "post-state, chk {chk} fast {fast} bal {bal}");
+            assert!(o.counts[0] > 0, "some transactions reused: {:?}", o.counts);
+            assert_eq!((o.counts[2], o.counts[3]), (0, 0), "no difference found: {:?}", o.counts);
+        }
+        // check mode: every valid result executed and compared, none differs
+        let o = run_block(&parent, &spec, 1, 0, true, true, 0xa5, true);
+        assert_eq!(o.receipts, reference.receipts);
+        assert_eq!(o.bundle, reference.bundle);
+        assert!(o.counts[4] > 0 && o.counts[0] == 0, "{:?}", o.counts);
+        assert_eq!((o.counts[2], o.counts[3]), (0, 0), "{:?}", o.counts);
+    }
+
+    /// EXP-206 (`reusebal`): the rule case by case: another account's balance-only change, unobserved by an observed run,
+    /// both views non-empty; not with the switch off, not the sender or the beneficiary, not when observed or when the
+    /// run was not observed, not with another field changed, not when the account did not exist or is empty now
+    #[test]
+    fn balance_change_rule() {
+        let _g = GLOBAL.lock();
+        let (a, sender, ben) = (Address::repeat_byte(0xaa), Address::repeat_byte(0x11), Address::repeat_byte(0xbe));
+        let info = |b: u64, n: u64| Some(AccountInfo { balance: U256::from(b), nonce: n, ..Default::default() });
+        let mut st = PendingState::default();
+        for x in [a, sender, ben] {
+            st.insert_account(x, info(5, 1), info(5, 1));
+        }
+        let entry = |obs: Option<AddressMap<BalObs>>| Entry {
+            state: st.clone(),
+            result: Box::new(()),
+            touched: Vec::new(),
+            fee_only: false,
+            full_check: false,
+            run: 0,
+            bal_obs: obs,
+        };
+        let relax = |e: &Entry, x: Address, cur: Option<AccountInfo>, exp: Option<AccountInfo>| {
+            bal_relax(e, &e.state.account_changes_for(&x).unwrap(), cur.as_ref(), exp.as_ref(), sender, ben)
+        };
+        set_mode(2, 0, true, false, 0, false, 0);
+        assert!(relax(&entry(reads(&[])), a, info(7, 1), info(5, 1)).is_none(), "switch off");
+        set_mode(2, 0, true, true, 0, false, 0);
+        assert_eq!(relax(&entry(reads(&[])), a, info(7, 1), info(5, 1)), Some((a, U256::from(5), U256::from(7))));
+        assert!(relax(&entry(reads(&[a])), a, info(7, 1), info(5, 1)).is_none(), "observed");
+        assert!(relax(&entry(None), a, info(7, 1), info(5, 1)).is_none(), "run not observed");
+        assert!(relax(&entry(reads(&[])), a, info(7, 2), info(5, 1)).is_none(), "nonce changed");
+        assert!(relax(&entry(reads(&[])), sender, info(7, 1), info(5, 1)).is_none(), "sender");
+        assert!(relax(&entry(reads(&[])), ben, info(7, 1), info(5, 1)).is_none(), "beneficiary");
+        assert!(relax(&entry(reads(&[])), a, info(7, 0), None).is_none(), "did not exist");
+        assert!(relax(&entry(reads(&[])), a, info(0, 0), info(5, 0)).is_none(), "empty now");
+        // the adjustment: the run's own credit kept on top of the current balance, loaded with the current balance
+        let mut st2 = PendingState::default();
+        st2.insert_account(a, info(5, 1), info(9, 1));
+        apply_adjust(&mut st2, &[(a, U256::from(5), U256::from(7))]);
+        let c = st2.account_changes_for(&a).unwrap();
+        assert_eq!((c.original.unwrap().balance, c.current.unwrap().balance), (U256::from(7), U256::from(11)));
+        set_mode(0, 0, false, false, 0, false, 0);
+    }
+
+    /// EXP-206, end to end on an Ethereum block executor, a write that changes only a balance: s1 pays C 7 wei, s2 pays C
+    /// 9 wei, s1 pays D 5 wei. Transaction 1's read of C changed only in balance and its run did not observe it.
+    /// - switch off: transaction 1 is executed (only transaction 0 reused; transaction 2 has its sender changed);
+    /// - switch on, reuse on: transaction 1 is reused, committed with C moved by +7 on top of its own +9;
+    /// - switch on, check mode (`reuse=1`): transaction 1's adjusted result is executed and compared: no difference in
+    ///   the result or the state-root update.
+    /// Every case gives exactly the bundle of the block without reuse.
+    #[test]
+    fn balance_only_write_is_accepted_as_an_increment() {
+        let _g = GLOBAL.lock();
+        let (s1, s2, c, d) = (Address::repeat_byte(0x11), Address::repeat_byte(0x22), Address::repeat_byte(0x33), Address::repeat_byte(0x44));
+        let mut parent = funded(&[s1, s2]);
+        // C exists and is not empty in both views (the rule needs it)
+        parent.insert_account_info(&c, AccountInfo { balance: U256::from(1000), nonce: 1, ..Default::default() });
+        let txs = transfers(&[(s1, 0u64, c, 7u64, 21_000u64), (s2, 0, c, 9, 21_000), (s1, 1, d, 5, 21_000)]);
+        let reference = run_block(&parent, &txs, 0, 0, true, false, 0xd0, true);
+        let o = run_block(&parent, &txs, 2, 0, true, false, 0xd1, true);
+        assert_eq!((o.bundle, o.receipts), (reference.bundle.clone(), reference.receipts.clone()));
+        assert_eq!((o.counts[0], o.counts[1]), (1, 0), "switch off: only transaction 0 reused");
+        let o = run_block(&parent, &txs, 2, 0, true, true, 0xd2, true);
+        assert_eq!((o.bundle, o.receipts), (reference.bundle.clone(), reference.receipts.clone()));
+        assert_eq!((o.counts[0], o.counts[1]), (2, 1), "switch on: transaction 1 reused with C's balance as an increment");
+        let o = run_block(&parent, &txs, 1, 0, true, true, 0xd3, true);
+        assert_eq!((o.bundle, o.receipts), (reference.bundle.clone(), reference.receipts.clone()));
+        assert_eq!(o.counts[1], 1, "check mode: transaction 1 accepted and compared");
+        assert_eq!((o.counts[2], o.counts[3]), (0, 0), "check mode: the adjusted result equals the execution thread's own run");
+        // runs the inspector did not record from their start (another block's inspector, the switch off there) carry no
+        // observations and accept nothing, even with the switch on
+        let o = run_block(&parent, &txs, 2, 0, true, true, 0xd4, false);
+        assert_eq!((o.bundle, o.receipts), (reference.bundle, reference.receipts));
+        assert_eq!((o.counts[0], o.counts[1]), (1, 0), "unrecorded runs: no balance change accepted");
+    }
+
+    /// EXP-206, end to end, balances read by the code: s1 pays C 7 wei first; then K stores BALANCE(C) in its slot 0,
+    /// E branches on BALANCE(C) == 1000 to store 1 in its slot 0, and (after s1 pays D 5 wei) D stores 1 at the key
+    /// SELFBALANCE. Each run observed the balance it read, so none of these results is accepted with the switch on: they
+    /// are executed again and the block equals the block without reuse.
+    #[test]
+    fn observed_balance_is_never_accepted() {
+        let _g = GLOBAL.lock();
+        let (s1, s2, s3, s4) = (Address::repeat_byte(0x11), Address::repeat_byte(0x22), Address::repeat_byte(0x23), Address::repeat_byte(0x24));
+        let (c, d, k, e) = (Address::repeat_byte(0x33), Address::repeat_byte(0x44), Address::repeat_byte(0x55), Address::repeat_byte(0x66));
+        let push20 = |a: Address| [vec![0x73], a.to_vec()].concat();
+        // K: PUSH20 C, BALANCE, PUSH1 0, SSTORE, STOP
+        let k_code = [push20(c), vec![0x31, 0x60, 0x00, 0x55, 0x00]].concat();
+        // E: PUSH20 C, BALANCE, PUSH2 1000, EQ, PUSH1 0x1e, JUMPI, STOP, JUMPDEST, PUSH1 1, PUSH1 0, SSTORE, STOP
+        let e_code = [push20(c), vec![0x31, 0x61, 0x03, 0xe8, 0x14, 0x60, 0x1e, 0x57, 0x00, 0x5b, 0x60, 0x01, 0x60, 0x00, 0x55, 0x00]].concat();
+        // D: PUSH1 1, SELFBALANCE, SSTORE (key: the balance), STOP
+        let d_code = vec![0x60, 0x01, 0x47, 0x55, 0x00];
+        let mut parent = funded(&[s1, s2, s3, s4]);
+        parent.insert_account_info(&c, AccountInfo { balance: U256::from(1000), nonce: 1, ..Default::default() });
+        parent.insert_account_info(&k, contract(k_code));
+        parent.insert_account_info(&e, contract(e_code));
+        parent.insert_account_info(&d, contract(d_code));
+        let txs = transfers(&[(s1, 0u64, c, 7u64, 21_000u64), (s2, 0, k, 0, 100_000), (s3, 0, e, 0, 100_000), (s1, 1, d, 5, 100_000), (s4, 0, d, 0, 100_000)]);
+        let reference = run_block(&parent, &txs, 0, 0, true, false, 0xe0, true);
+        // the reference really depends on the balances: K stored 1007, E did not store, D stored at key 1005
+        let slot = |a: Address, key: u64| {
+            reference.bundle.state.get(&a).and_then(|acc| acc.storage.get(&U256::from(key))).map(|s| s.present_value())
+        };
+        assert_eq!(slot(k, 0), Some(U256::from(1007)));
+        assert_eq!(slot(e, 0), None);
+        assert_eq!(slot(d, 1005), Some(U256::from(1)));
+        let o = run_block(&parent, &txs, 2, 0, true, true, 0xe1, true);
+        assert_eq!((o.bundle, o.receipts), (reference.bundle.clone(), reference.receipts.clone()));
+        assert_eq!(o.counts[1], 0, "no observed balance accepted");
+        assert_eq!(o.counts[0], 1, "only transaction 0 reused");
+        let o = run_block(&parent, &txs, 1, 0, true, true, 0xe2, true);
+        assert_eq!((o.bundle, o.receipts), (reference.bundle, reference.receipts));
+        assert_eq!((o.counts[1], o.counts[2], o.counts[3]), (0, 0, 0));
+    }
+
+    /// EXP-233: revmc's balance callback adds to the run being recorded, and does nothing without one
+    #[test]
+    fn compiled_balance_reads_are_observed() {
+        let (a, b) = (Address::repeat_byte(0x31), Address::repeat_byte(0x47));
+        tx_begin();
+        pw_balance_hook(a);
+        assert_eq!(take_obs(1), None, "not recording: nothing kept");
+        assert!(!OBS_LOST.with(|l| l.get()), "not recording is not a loss");
+        tx_begin();
+        obs_start();
+        pw_balance_hook(a);
+        pw_balance_hook(b);
+        pw_balance_hook(a);
+        assert_eq!(take_obs(1), reads(&[a, b]));
+        // the same observations as the interpreter's path (`obs_balance`)
+        obs_start();
+        obs_balance(a);
+        obs_balance(b);
+        assert_eq!(take_obs(1), reads(&[a, b]));
+        // a run not recorded to its top-level frame end keeps none
+        obs_start();
+        pw_balance_hook(a);
+        assert_eq!(take_obs(0), None);
+    }
+
+    /// EXP-233: an observation the callback cannot record (the observations borrowed) does not panic, and the run then
+    /// keeps no observations, so it accepts no balance change; the next run records again
+    #[test]
+    fn lost_compiled_balance_read_drops_the_run() {
+        let a = Address::repeat_byte(0x31);
+        tx_begin();
+        obs_start();
+        pw_balance_hook(a);
+        OBS.with(|o| {
+            let _held = o.borrow();
+            pw_balance_hook(Address::repeat_byte(0x47));
+        });
+        assert!(OBS_LOST.with(|l| l.get()));
+        assert_eq!(take_obs(1), None, "a run with a lost observation keeps none");
+        assert!(!OBS_LOST.with(|l| l.get()), "taken with the run");
+        tx_begin();
+        obs_start();
+        pw_balance_hook(a);
+        assert_eq!(take_obs(1), reads(&[a]));
+        // a loss before the run starts recording does not carry into it
+        tx_begin();
+        OBS.with(|o| {
+            let _held = o.borrow_mut();
+            pw_balance_hook(a);
+        });
+        obs_start();
+        pw_balance_hook(a);
+        assert_eq!(take_obs(1), reads(&[a]));
+    }
