+/// Prologue (`xbtl2`, X-031): finer record-only instants, the same clock and line form as [`xbtl`].
+pub mod xbtl2 {
+    use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+    use tracing::info;
+
+    pub const VAL: usize = 0;
+    pub const SP_SCHED: usize = 1;
+    pub const SP_REFRESH: usize = 2;
+    pub const SP_ACCFLT: usize = 3;
+    pub const SP_TXIT: usize = 4;
+    pub const SP_CACHE: usize = 5;
+    pub const PF_REUSE: usize = 6;
+    pub const PF_RCPT: usize = 7;
+    pub const DR_STOP: usize = 8;
+    pub const DR_JOIN: usize = 9;
+    pub const DR_LOG: usize = 10;
+    pub const DR_BODY: usize = 11;
+    pub const RF_JOIN: usize = 12;
+    pub const RF_READ: usize = 13;
+    pub const RF_SET: usize = 14;
+    pub const RF_REL: usize = 15;
+    pub const RF_SW: usize = 16;
+    pub const PF_START: usize = 17;
+    pub const PF_RET: usize = 18;
+    pub const EX_START: usize = 19;
+    pub const EX_END: usize = 20;
+    pub const N: usize = 21;
+    pub const NAMES: [&str; N] = [
+        "val", "sp_sched", "sp_refresh", "sp_accflt", "sp_txit", "sp_cache", "pf_reuse", "pf_rcpt", "dr_stop", "dr_join", "dr_log",
+        "dr_body", "rf_join", "rf_read", "rf_set", "rf_rel", "rf_sw", "pf_start", "pf_ret", "ex_start", "ex_end",
+    ];
