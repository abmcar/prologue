+    /// Prologue (`exphys` with `srrt`): the raised thread (a helper thread here, tracked as the raised one) moves to the
+    /// pin's set at the pin and back to its own set at the change back; joining while the pin is in force, it moves at
+    /// once and goes back when it leaves; while one thread is tracked a second is not, and a thread other than the
+    /// tracked one leaving changes nothing; a pin's set without a CPU of the thread's set leaves it alone; a thread that
+    /// no longer exists gives minus ESRCH. A slot of its own, so the node's `SR_PHYS` is not touched; skipped when the
+    /// test's CPU set has fewer than two CPUs.
+    #[test]
+    fn exphys_sr_thread_keeps_off_the_pinned_core() {
+        let full = own_affinity().expect("the thread's CPU set");
+        // SAFETY (this test): a zeroed cpu_set_t is valid; the CPU_* functions only read or write bits of the given
+        // sets; gettid has no preconditions.
+        let cpus: Vec<usize> =
+            (0..libc::CPU_SETSIZE as usize).filter(|c| unsafe { libc::CPU_ISSET(*c, &full) }).collect();
+        if cpus.len() < 2 {
+            return
+        }
+        // the pin's set: the test's set less its first CPU (the reserved one), as `reserve_exec_core` makes it
+        let (narrow, _) = reserved_set(&full, cpus[0], &[]);
+        let only_first = unsafe {
+            let mut s: libc::cpu_set_t = std::mem::zeroed();
+            libc::CPU_SET(cpus[0], &mut s);
+            s
+        };
+        let (stop_tx, stop_rx) = crossbeam_channel::bounded::<()>(0);
+        let (id_tx, id_rx) = crossbeam_channel::bounded::<libc::pid_t>(1);
+        let helper = std::thread::spawn(move || {
+            id_tx.send(unsafe { libc::gettid() }).unwrap();
+            let _ = stop_rx.recv();
+        });
+        let tid = id_rx.recv().unwrap();
+        let is = |s: &libc::cpu_set_t| unsafe { libc::CPU_EQUAL(&thread_affinity(tid).expect("the helper's set"), s) };
+        let slot = Mutex::new(SrPhys::NONE);
+        // no tracked thread: nothing moves
+        assert_eq!(sr_phys_pin(&slot, Some(narrow)), 0);
+        assert_eq!(sr_phys_unpin(&slot), 0);
+        // tracked without a pin: not moved; the pin moves it, once; the change back gives its set back, once
+        assert_eq!(sr_phys_join(&slot, tid), 0);
+        assert!(is(&full));
+        assert_eq!(sr_phys_pin(&slot, Some(narrow)), 1);
+        assert!(is(&narrow));
+        assert_eq!(sr_phys_pin(&slot, Some(narrow)), 0, "moved already");
+        assert!(is(&narrow));
+        assert_eq!(sr_phys_unpin(&slot), 1);
+        assert!(is(&full));
+        assert_eq!(sr_phys_unpin(&slot), 0);
+        // a second thread is not tracked while one is; its leaving changes nothing
+        let me = unsafe { libc::gettid() };
+        assert_eq!(sr_phys_join(&slot, me), 0);
+        sr_phys_leave(&slot, me);
