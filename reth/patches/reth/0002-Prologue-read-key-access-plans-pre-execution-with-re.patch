+        assert!(is(&narrow));
+        sr_phys_leave(&slot, tid);
+        assert!(is(&full));
+        // a set without a CPU of the pin's set: left alone
+        assert_eq!(sr_phys_join(&slot, tid), 1);
+        assert_eq!(sr_phys_unpin(&slot), 1);
+        assert!(set_thread_affinity(tid, &only_first));
+        assert_eq!(sr_phys_pin(&slot, Some(narrow)), 0);
+        assert!(is(&only_first));
+        assert_eq!(sr_phys_unpin(&slot), 0);
+        sr_phys_leave(&slot, tid);
+        assert!(set_thread_affinity(tid, &full));
