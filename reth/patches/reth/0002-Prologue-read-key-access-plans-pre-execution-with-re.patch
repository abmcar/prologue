+// ---- EXP-184 (`cdaddr`, `cdst`): the accounts the execution thread looks up, and a reader's backend reads ----
+
+static CD_BASE: LazyLock<Instant> = LazyLock::new(Instant::now);
+/// Accounts the execution thread looked up since it was marked (with the time of the lookup and whether it missed the
+/// execution cache).
+static CD_EXEC_LOG: parking_lot::Mutex<Vec<(Address, u64, bool)>> = parking_lot::const_mutex(Vec::new());
+/// Whether the marked execution thread reached the end of the block's execution ([`cd_exec_done`]).
+static CD_EXEC_DONE: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+thread_local! {
+    /// Whether this thread is the execution thread of a block that keeps the account log.
+    static CD_EXEC: Cell<bool> = const { Cell::new(false) };
+    /// This thread's backend reads of accounts and code, (count, ns), while counting (`cd_fill_begin`).
+    static CD_FILL: Cell<Option<[(u32, u64); 2]>> = const { Cell::new(None) };
+}
+
+/// EXP-184: ns since the process's first call; the common clock of the execution thread's account log and the readers.
+pub fn cd_now_ns() -> u64 {
+    CD_BASE.elapsed().as_nanos() as u64
+}
+
+/// EXP-184: marks this thread as the block's execution thread whose account lookups are logged (`on`, which also clears
+/// the log and the completion flag), or unmarks it.
+pub fn cd_exec_thread(on: bool) {
+    if on {
+        CD_EXEC_LOG.lock().clear();
+        CD_EXEC_DONE.store(false, Ordering::Relaxed);
+    }
+    CD_EXEC.with(|c| c.set(on));
+}
+
+/// EXP-184: marks the execution thread for the block's account log while it lives (`on`), and unmarks it when dropped,
+/// also when the block's execution returns early.
+#[derive(Debug)]
+#[must_use]
+pub struct CdExecGuard;
+
+impl CdExecGuard {
+    /// Marks this thread (`on`) or leaves it unmarked.
+    pub fn new(on: bool) -> Self {
+        cd_exec_thread(on);
+        Self
+    }
+}
+
+impl Drop for CdExecGuard {
+    fn drop(&mut self) {
+        CD_EXEC.with(|c| c.set(false));
+    }
+}
+
+/// EXP-184: the marked execution thread reached the end of the block's execution (no early return).
+pub fn cd_exec_done() {
+    if CD_EXEC.with(|c| c.get()) {
+        CD_EXEC_DONE.store(true, Ordering::Relaxed);
+    }
+}
+
+/// EXP-184: the accounts the execution thread looked up since it was marked, each with the time of the lookup
+/// ([`cd_now_ns`]) and whether the lookup missed the execution cache, and whether its execution completed
+/// ([`cd_exec_done`]); empties the log. revm keeps an account it read for the rest of the block, so an address appears
+/// about once per block.
+pub fn cd_exec_take() -> (Vec<(Address, u64, bool)>, bool) {
+    (std::mem::take(&mut *CD_EXEC_LOG.lock()), CD_EXEC_DONE.swap(false, Ordering::Relaxed))
+}
+
+#[inline]
+fn cd_exec_note(address: &Address) {
+    if CD_EXEC.with(|c| c.get()) {
+        CD_EXEC_LOG.lock().push((*address, cd_now_ns(), false));
+    }
+}
+
+/// EXP-184 (`cdlearn=1`): the marked execution thread's lookup of `address` (the log's last entry, noted at the start of
+/// the lookup) missed the execution cache.
+#[inline]
+fn cd_exec_mark_miss(address: &Address) {
+    if CD_EXEC.with(|c| c.get()) &&
+        let Some(e) = CD_EXEC_LOG.lock().last_mut().filter(|e| e.0 == *address)
+    {
+        e.2 = true;
+    }
+}
+
+/// EXP-184: starts counting this thread's backend reads of accounts and code (a cache-filling provider's misses).
+pub fn cd_fill_begin() {
+    CD_FILL.with(|c| c.set(Some([(0, 0); 2])));
+}
+
+/// EXP-184: this thread's backend reads of accounts and code since [`cd_fill_begin`] as (count, ns); stops counting.
+pub fn cd_fill_end() -> [(u32, u64); 2] {
+    CD_FILL.with(|c| c.take()).unwrap_or_default()
+}
+
+/// EXP-184: whether this thread counts its backend reads (between [`cd_fill_begin`] and [`cd_fill_end`]).
+pub fn cd_fill_counting() -> bool {
+    CD_FILL.with(|c| c.get().is_some())
+}
+
+#[inline]
+fn cd_fill_start() -> Option<Instant> {
+    CD_FILL.with(|c| c.get().is_some()).then(Instant::now)
+}
+
+#[inline]
+fn cd_fill_note(kind: usize, t0: Option<Instant>) {
+    let Some(t0) = t0 else { return };
+    let ns = t0.elapsed().as_nanos() as u64;
+    CD_FILL.with(|c| {
+        if let Some(mut v) = c.get() {
+            v[kind].0 += 1;
+            v[kind].1 += ns;
+            c.set(Some(v));
+        }
+    });
