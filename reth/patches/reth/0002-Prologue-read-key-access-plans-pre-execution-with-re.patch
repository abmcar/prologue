+        atomic::{AtomicBool, AtomicUsize, Ordering},
+        Arc,
+    };
+
+    /// EXP-182: the gate spawns its extra readers once, when it first opens, and not at all once the block has stopped.
+    #[test]
+    fn gate_spawns_once_and_not_after_stop() {
+        let calls = Arc::new(AtomicUsize::new(0));
