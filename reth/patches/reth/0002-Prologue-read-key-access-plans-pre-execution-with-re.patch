+/// After a run armed with [`cc_tx_begin`]: the keys wanted after the run was handed to discovery, `None` when it was
+/// not handed over. Disarms the trigger.
+pub fn cc_tx_take_handover() -> Option<Vec<(Address, StorageKey)>> {
