+#[cfg(test)]
+mod exrt_mode_tests {
+    use super::Mode;
+
+    /// EXP-199 (`exrt`, `srboost`): off by default and in the full method's line, parsed, capped at 49.
+    #[test]
+    fn exrt_switch_parses() {
+        assert_eq!(Mode::OFF.exrt, 0);
+        assert_eq!(Mode::parse("prewarm=1 tx=1 code=1 readers=8 pwcs=1 pwlx=1 txdec=1 reuse=2").exrt, 0);
+        assert_eq!(Mode::parse("prewarm=1 exrt=1").exrt, 1);
+        assert_eq!(Mode::parse("prewarm=1 exrt=90").exrt, 49);
+        assert_eq!(Mode::parse("prewarm=1 exrt=0").exrt, 0);
+        assert_eq!(Mode::OFF.srboost, 0);
+        assert_eq!(Mode::parse("prewarm=1 tx=1 code=1 readers=8").srboost, 0);
+        assert_eq!(Mode::parse("prewarm=1 srboost=1").srboost, 1);
+        assert_eq!(Mode::parse("prewarm=1 srboost=70").srboost, 49);
+        assert_eq!((Mode::OFF.ewnear, Mode::OFF.ewnearn), (0, 2));
+        assert_eq!(Mode::parse("prewarm=1 ew=12 ewov=1 exrt=1").ewnear, 0);
+        let m = Mode::parse("prewarm=1 ew=12 ewnear=1");
+        assert_eq!((m.ewnear, m.ewnearn), (1, 2));
+        assert_eq!(Mode::parse("prewarm=1 ewnear=80 ewnearn=3").ewnear, 49);
+        assert_eq!(Mode::parse("prewarm=1 ewnear=1 ewnearn=3").ewnearn, 3);
+        assert_eq!(Mode::parse("prewarm=1 ewnear=1 ewnearn=0").ewnearn, 1);
+        assert_eq!(Mode::parse("prewarm=1 ewnear=1 ewnearn=500").ewnearn, 64);
+        assert!(!Mode::OFF.ewnearkeep && !m.ewnearkeep);
+        assert!(Mode::parse("prewarm=1 ew=12 ewnear=1 ewnearkeep=1").ewnearkeep);
