+/// EXP-129 third segment: per-pass record for the key trace (`pwtrace=1`): transaction, level, duration, keys handed
+/// out, instructions, success, stop reason (0 no keys, 1 level cap, 2 budget, 3 execution thread passed, 255 continued).
+pub fn nb_record_pass(tx: u32, level: u8, dur_ns: u64, issued: u32, steps: u64, ok: bool, reason: u8) {
+    kt(|k, t| k.nb_passes.push((tx, level, t.saturating_sub(dur_ns), t, issued, steps, ok, reason)));
+}
+
+/// EXP-122: the readers' channel of the current block (set when `pwcs > 0`).
+pub fn pw_sender() -> Option<Sender<Item>> {
+    PW_TX.lock().clone()
+}
+
+thread_local! {
+    /// EXP-122: set by `NbDb` when the last storage read was answered as unknown.
+    static NB_UNKNOWN: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+    /// EXP-122: keys handed to the readers by `NbDb` in the current pass.
+    static NB_KEYS: std::cell::Cell<u64> = const { std::cell::Cell::new(0) };
+    /// EXP-129 fourth segment: the key operand of the SLOAD about to execute is tainted (set by the inspector's
+    /// `step`): `NbDb` must not hand such a key to the readers (it is computed from unknown values), only taint the
+    /// result; the offline model issues only keys that are untainted.
+    static NB_KEY_TAINTED: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+    /// EXP-129 fourth segment: tainted-key reads not handed out in the current pass.
+    static NB_TAINTED_KEYS: std::cell::Cell<u64> = const { std::cell::Cell::new(0) };
+    /// EXP-180: the prediction for the SLOAD about to execute (set by the inspector's `step`, taken by `NbDb` when the
+    /// slot is not cached, cleared in `step_end`).
+    static NB_PRED: std::cell::Cell<Option<U256>> = const { std::cell::Cell::new(None) };
+}
+
+/// EXP-122: direction history of branch sites (code hash, program counter) -> (taken, not taken, last), filled by
+/// the untainted branches of non-blocking passes; read for tainted branches when `pwnbhist=1`.
+static NB_HIST: OnceLock<parking_lot::RwLock<HashMap<(B256, usize), (u32, u32, bool)>>> = OnceLock::new();
+
+fn nb_hist() -> &'static parking_lot::RwLock<HashMap<(B256, usize), (u32, u32, bool)>> {
+    NB_HIST.get_or_init(|| parking_lot::RwLock::new(HashMap::new()))
+}
+
+/// EXP-129: counters of the post-block history pass, cumulative over the node's life (the pass runs after the block's
+/// stats line is written, so per-block stats cannot show it): passes (blocks), transactions, time, successes, and the
+/// time from the stop signal to the start of the last pass.
+pub static NB_BH_RUNS: AtomicU64 = AtomicU64::new(0);
+pub static NB_BH_TXS: AtomicU64 = AtomicU64::new(0);
+pub static NB_BH_NS: AtomicU64 = AtomicU64::new(0);
+pub static NB_BH_OK: AtomicU64 = AtomicU64::new(0);
+pub static NB_BH_WAIT_NS: AtomicU64 = AtomicU64::new(0);
+/// EXP-180 (`pwnbbhroot`): the last history pass's wait for the root after the execution ended, and the passes skipped
+/// because the root was not known in time.
+pub static NB_BH_ROOT_WAIT_NS: AtomicU64 = AtomicU64::new(0);
+pub static NB_BH_ROOT_SKIPPED: AtomicU64 = AtomicU64::new(0);
+
+/// EXP-129: size of the branch-history table.
+pub fn nb_hist_sites() -> usize {
+    nb_hist().read().len()
+}
+
+/// EXP-122: database of the non-blocking pass. Accounts, code and block hashes come from the inner (cached, blocking)
+/// provider; a storage slot comes from the execution cache when cached, otherwise it is handed to the readers and
+/// answered as zero with the unknown flag set (the inspector taints the result).
+///
+/// X-027 (evm2): an evm2 `Evm` keeps the values its database returned in its accepted-state overlay (a read cache that
+/// outlives the transaction), so a placeholder answered here would be read back by a later pass or transaction on the
+/// same EVM instead of reaching this database again. The pass's driver must empty that cache before every pass
+/// (`Evm::take_state_cache`, as 2.9.0's own prewarm does before every transaction); see the test
+/// `nb_tests::placeholders_do_not_survive_when_the_cache_is_taken`.
+pub struct NbDb<D> {
+    pub inner: D,
+    pub caches: Option<reth_execution_cache::ExecutionCache>,
+    pub tx: Sender<Item>,
+    /// EXP-129: bounded wait for a handed-out slot (nanoseconds, 0 = none).
+    pub wait_ns: u64,
+    /// EXP-129 second segment: hand slots to the readers' slot channel (`pwnbprio=1`).
+    pub prio: bool,
+    /// EXP-180: value-speculation mode of this pass (`pwnbval`, read once when the pass's EVM is built).
+    pub val: u8,
+    /// EXP-199 (`ewov`): the writes of the block's earlier transactions as EAP's own prewarm mechanism prewarmed them
+    /// (given by that mechanism's dispatch for its block only).
+    pub ew: Option<Arc<crate::tree::eap_ew::EwWrites>>,
+}
+
+impl<D> std::fmt::Debug for NbDb<D> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("NbDb")
+    }
+}
+
+impl<D: evm2::evm::Database> evm2::evm::Database for NbDb<D> {
+    type Error = D::Error;
+
+    fn is_fatal(error: &Self::Error) -> bool {
+        D::is_fatal(error)
+    }
+
+    fn get_account(&mut self, address: &Address) -> Result<Option<evm2::evm::AccountInfo>, Self::Error> {
+        self.inner.get_account(address)
+    }
+
+    fn get_code_by_hash(&mut self, code_hash: &B256) -> Result<evm2::bytecode::Bytecode, Self::Error> {
+        self.inner.get_code_by_hash(code_hash)
+    }
+
+    fn get_storage(&mut self, address: &Address, index: &U256) -> Result<U256, Self::Error> {
+        let (address, index) = (*address, *index);
+        // EXP-199 (`ewov`): a slot an earlier transaction of the block wrote is read from that write
+        if let Some(w) = &self.ew {
+            let cur = PW_CUR_TX.with(|c| c.get());
+            if cur != u32::MAX &&
+                let Some(v) = w.slot_before(address, B256::from(index), cur)
+            {
+                nb_log_read(address, index, v, 0);
+                return Ok(v)
+            }
+        }
+        let Some(caches) = &self.caches else { return self.inner.get_storage(&address, &index) };
+        if let Some(v) = caches.peek_storage(address, B256::from(index)) {
+            nb_log_read(address, index, v, 0);
+            return Ok(v)
+        }
+        let cur = PW_CUR_TX.with(|c| c.get());
+        let val = self.val;
+        if NB_KEY_TAINTED.with(|c| c.replace(false)) && nb_taintkey() && val == 0 {
+            // EXP-129 fourth segment: a key computed from unknown values: not handed out, not waited for
+            NB_TAINTED_KEYS.with(|c| c.set(c.get() + 1));
+            NB_UNKNOWN.with(|c| c.set(true));
+            nb_log_read(address, index, U256::ZERO, 3);
+            return Ok(U256::ZERO)
+        }
+        kt(|k, t| {
+            k.nb_issued.entry((address, B256::from(index))).or_insert(t);
+        });
+        let mut sent = false;
+        if self.prio {
+            if let Some(s) = NB_SL_TX.lock().as_ref() {
+                let _ = s.send(Item::Slot(address, B256::from(index), reth_execution_cache::CC_SRC_EAP_NB, cur, rq_now()));
+                sent = true;
+            }
+        }
+        if !sent {
+            let _ = self.tx.send(Item::Keys(Box::new((address, vec![index], cur, reth_execution_cache::CC_SRC_EAP_NB, rq_now()))));
+        }
+        NB_KEYS.with(|c| c.set(c.get() + 1));
+        NB_ISSUED.with(|v| v.borrow_mut().push((address, index)));
+        if self.wait_ns > 0 {
+            // EXP-129: wait up to `wait_ns` for the readers to put the slot into the execution cache
+            let t0 = Instant::now();
+            loop {
+                if let Some(v) = caches.peek_storage(address, B256::from(index)) {
+                    let ns = t0.elapsed().as_nanos() as u64;
+                    if let Some(stats) = PW_STATS.lock().clone() {
+                        stats.nb_wait_hit.fetch_add(1, Ordering::Relaxed);
+                        stats.nb_wait_ns.fetch_add(ns, Ordering::Relaxed);
+                    }
+                    nb_log_read(address, index, v, 1);
+                    return Ok(v)
+                }
+                if t0.elapsed().as_nanos() as u64 >= self.wait_ns {
+                    if let Some(stats) = PW_STATS.lock().clone() {
+                        stats.nb_wait_to.fetch_add(1, Ordering::Relaxed);
+                        stats.nb_wait_ns.fetch_add(self.wait_ns, Ordering::Relaxed);
+                    }
+                    break
+                }
+                // EXP-199 (`ewnear`): a raised worker sleeps instead of spinning
+                crate::tree::eap_ew::near_relax(std::hint::spin_loop);
+            }
+        }
+        // EXP-180: in value-speculation mode the read is answered with the inspector's prediction
+        let pred = if val != 0 { NB_PRED.with(|c| c.take()).unwrap_or(U256::ZERO) } else { U256::ZERO };
+        if val != 0 && let Some(stats) = PW_STATS.lock().clone() {
+            stats.nb_val_reads.fetch_add(1, Ordering::Relaxed);
+        }
+        NB_UNKNOWN.with(|c| c.set(true));
+        nb_log_read(address, index, pred, 2);
+        Ok(pred)
+    }
+
+    fn get_block_hash(&mut self, number: &U256) -> Result<B256, Self::Error> {
+        self.inner.get_block_hash(number)
+    }
+}
+
+enum NbPending {
+    None,
+    Pop(usize),
+    Push(bool),
+    PopPush(usize, usize, bool),
+    MemSet(usize, usize, bool, usize),
+    MemCopy(Vec<bool>, usize, usize),
+    Sload(Address, U256, bool, (B256, usize)),
+    /// X-027 (evm2): a CALL*/CREATE* popping this many operands. evm2 runs the callee inside the instruction, so the
+    /// frame's `step_end` comes after the callee's `call_end`/`create_end` (revm: before the callee started); the
+    /// callee's result taint is left in [`NbFrame::call_ret`] by that hook and pushed here after the operands are
+    /// popped, giving the same taint stack as 2.5.1's pop in `step_end` and push in `call_end`.
+    CallEnd(usize),
+}
+
+#[derive(Default)]
+struct NbFrame {
+    stack: Vec<bool>,
+    mem: Vec<bool>,
+    calldata: Vec<bool>,
+    ret: Vec<bool>,
+    ret_all: bool,
+    out: Vec<bool>,
+    out_all: bool,
+    pending: Option<NbPending>,
+    /// target tainted, calldata taint, and (X-027) the return-memory range taken from the operands
+    pending_call: Option<(bool, Vec<bool>, std::ops::Range<usize>)>,
+    nsteps: u64,
+    /// X-027: the return-memory range of the call that started this frame (evm2's messages carry none; revm's
+    /// `CallInputs::return_memory_offset`)
+    ret_to: std::ops::Range<usize>,
+    /// X-027: the result taint of the call or creation this frame just made, for its `step_end` ([`NbPending::CallEnd`])
+    call_ret: Option<bool>,
+}
+
+/// EXP-199 round 3 (`nbpl=1`): the readers' channel for the speculative pass's call-start plans, when the pass and the
+/// switch are on and the block has readers.
+fn nb_plan_sender() -> Option<Sender<Item>> {
+    let m = current();
+    if m.active && m.pwnb && m.nbpl { pw_sender() } else { None }
+}
+
+/// EXP-122: taint-tracking inspector of the non-blocking pass (the rules of EXP-119's offline tool): values read
+/// as unknown taint the stack, memory, calldata and return data they flow into; a tainted `JUMPI` condition is
+/// rewritten by the static revert rule, else by the branch history, else to fall through; a call with a tainted
+/// target is skipped (4 KiB of tainted zeros returned). Values are never changed otherwise.
+pub struct NbInspector {
+    frames: Vec<NbFrame>,
+    unknown: HashSet<(Address, U256)>,
+    tainted_slots: HashSet<(Address, U256)>,
+    use_hist: bool,
+    /// EXP-129: record the untainted branches of this pass into the history (false when the history comes from
+    /// the post-block history pass).
+    record: bool,
+    /// EXP-129: this inspector runs the post-block history pass (counted separately, records every branch).
+    bh: bool,
+    hist_new: HashMap<(B256, usize), (u32, u32, bool)>,
+    /// a skipped call's return-memory range until its `call_end` (2.5.1: a flag, the range came with the hook)
+    skip_pending: Option<std::ops::Range<usize>>,
+    steps: u64,
+    forced: u64,
+    hist_hits: u64,
+    skipped: u64,
+    /// EXP-180: value-speculation mode (`pwnbval`), this pass's cached reads per site, predictions found in a table.
+    val: u8,
+    site_cur: HashMap<(B256, usize), U256>,
+    site_hits: u64,
+    /// EXP-180: a pass is cut short (every frame halts) once it has run longer than the per-transaction budget or the
+    /// execution thread has passed its transaction; checked every 4,096 instructions (a predicted loop bound can make a
+    /// pass run many times longer than the real path, EXP-180 6.11)
+    abort: bool,
+    t_pass: Option<Instant>,
+    tx_pass: u32,
+    exec: Option<Arc<AtomicUsize>>,
+    aborted: u64,
+    /// EXP-199 round 3 (`nbpl=1`): the readers' channel for the plans of the calls this pass starts, and the `pwmin`
+    /// gate (`None`: off, and always for the post-block history pass)
+    plan_tx: Option<Sender<Item>>,
+    pwmin: u32,
+    /// `EWB_NBSTOP`: a pass is cut short only when the execution thread has passed its transaction (no time budget)
+    bud_stop: bool,
+    /// EXP-180 (`pwnbinterp`): every frame of the pass runs in the interpreter; off, compiled code runs where the EVM has
+    /// a runner (2.5.1: revmc ran compiled frames under an inspector without `step`; evm2 does so only when the inspector
+    /// allows it, [`Inspector::allows_compiled_frames`])
+    interp: bool,
+}
+
+fn nb_any(v: &[bool], off: usize, len: usize) -> bool {
+    if len == 0 {
+        return false
+    }
+    let end = off.saturating_add(len).min(v.len());
+    off < end && v[off..end].iter().any(|&b| b)
+}
+
+/// X-027: the return-memory range of a call from its offset and length operands (empty for a zero length), as revm built
+/// `CallInputs::return_memory_offset`.
+fn nb_range(off: U256, len: U256) -> std::ops::Range<usize> {
+    let len = nb_usz(len);
+    if len == 0 {
+        return 0..0
+    }
+    let off = nb_usz(off);
+    off..off.saturating_add(len)
+}
+
+fn nb_usz(v: U256) -> usize {
+    if v > U256::from(1u64 << 32) {
+        1 << 32
+    } else {
+        v.to::<usize>()
+    }
+}
+
+/// Does the instruction sequence at `start` reach REVERT/INVALID within 8 instructions before any JUMP/JUMPI/STOP/
+/// RETURN/SELFDESTRUCT?
+fn nb_arm_reverts(code: &[u8], start: usize) -> bool {
+    let mut pc = start;
+    for _ in 0..8 {
+        if pc >= code.len() {
+            return false
+        }
+        let o = code[pc];
+        match o {
+            op::REVERT | op::INVALID => return true,
+            op::JUMP | op::JUMPI | op::STOP | op::RETURN | op::SELFDESTRUCT => return false,
+            _ => {}
+        }
+        pc += if (op::PUSH1..=op::PUSH32).contains(&o) { 1 + (o - op::PUSH1 + 1) as usize } else { 1 };
+    }
+    false
+}
+
+/// EXP-180: does the code at `start` reach REVERT/INVALID within 64 instructions, following unconditional jumps to
+/// pushed destinations, before any JUMPI/STOP/RETURN/SELFDESTRUCT or a jump to a computed address? (Solidity's shared
+/// panic and custom-error blocks are reached through such a jump.) Same rule as the offline tool's `arm_reverts2`.
+fn nb_arm_reverts2(code: &[u8], start: usize) -> bool {
+    let mut pc = start;
+    let mut last_push: Option<usize> = None;
+    for _ in 0..64 {
+        if pc >= code.len() {
+            return false
+        }
+        let o = code[pc];
+        match o {
+            op::REVERT | op::INVALID => return true,
+            op::JUMPI | op::STOP | op::RETURN | op::SELFDESTRUCT => return false,
+            op::JUMP => match last_push {
+                Some(d) if d < code.len() && code[d] == op::JUMPDEST => {
+                    pc = d;
+                    last_push = None;
+                    continue
+                }
+                _ => return false,
+            },
+            _ => {}
+        }
+        if (op::PUSH1..=op::PUSH32).contains(&o) {
+            let n = (o - op::PUSH1 + 1) as usize;
+            let end = (pc + 1 + n).min(code.len());
+            last_push = if n <= 4 { Some(code[pc + 1..end].iter().fold(0usize, |a, b| (a << 8) | *b as usize)) } else { None };
+            pc += 1 + n;
+        } else {
+            last_push = None;
+            pc += 1;
+        }
+    }
+    false
+}
+
+const NB_MEM_LIMIT: usize = 1 << 26;
+
+impl NbInspector {
+    pub fn new(use_hist: bool) -> Self {
+        Self {
+            frames: Vec::new(),
+            unknown: HashSet::new(),
+            tainted_slots: HashSet::new(),
+            use_hist,
+            record: use_hist && !nb_bh(),
+            bh: false,
+            hist_new: HashMap::new(),
+            skip_pending: None,
+            steps: 0,
+            forced: 0,
+            hist_hits: 0,
+            skipped: 0,
+            val: nb_val(),
+            site_cur: HashMap::new(),
+            site_hits: 0,
+            abort: false,
+            t_pass: None,
+            tx_pass: u32::MAX,
+            exec: None,
+            aborted: 0,
+            plan_tx: nb_plan_sender(),
+            pwmin: current().pwmin,
+            bud_stop: ew_bud() & EWB_NBSTOP != 0,
+            interp: nb_interp(),
+        }
+    }
+
+    /// EXP-180: the block's execution progress (index of the transaction the execution thread is on), for cutting a
+    /// speculative pass short once the execution thread has passed its transaction.
+    pub fn with_exec(mut self, exec: Arc<AtomicUsize>) -> Self {
+        self.exec = Some(exec);
+        self
+    }
+
+    /// EXP-129 third segment: instructions of the current pass.
+    pub fn steps(&self) -> u64 {
+        self.steps
+    }
+
+    /// EXP-129: the inspector of the post-block history pass: no unknown values, every branch recorded.
+    pub fn recorder() -> Self {
+        let mut i = Self::new(true);
+        i.record = true;
+        i.bh = true;
+        i.plan_tx = None;
+        i
+    }
+
+    /// Resets the per-transaction state before a pass.
+    pub fn begin(&mut self) {
+        self.frames.clear();
+        self.unknown.clear();
+        self.tainted_slots.clear();
+        self.hist_new.clear();
+        self.skip_pending = None;
+        self.steps = 0;
+        self.forced = 0;
+        self.hist_hits = 0;
+        self.skipped = 0;
+        self.site_cur.clear();
+        self.site_hits = 0;
+        self.abort = false;
+        self.t_pass = Some(Instant::now());
+        self.tx_pass = PW_CUR_TX.with(|c| c.get());
+        NB_PRED.with(|c| c.set(None));
+        NB_KEYS.with(|c| c.set(0));
+        NB_UNKNOWN.with(|c| c.set(false));
+        NB_ISSUED.with(|v| v.borrow_mut().clear());
+        NB_KEY_TAINTED.with(|c| c.set(false));
+        NB_TAINTED_KEYS.with(|c| c.set(0));
+        NB_READS.with(|r| r.borrow_mut().clear());
+        NB_T0.with(|c| c.set(Some(Instant::now())));
+    }
+
+    /// Merges the branch history and adds the pass to the block's counters.
+    pub fn finish(&mut self, ok: bool, ns: u64) {
+        if self.val != 0 && !self.site_cur.is_empty() {
+            // EXP-180: the pass's cached reads (true values) go into the site-value table (bounded)
+            let mut t = nb_sites().write();
+            if t.len() > (1 << 20) {
+                t.clear();
+            }
+            t.extend(self.site_cur.drain());
+        }
+        if self.val != 0 && !self.bh && let Some(stats) = PW_STATS.lock().clone() {
+            stats.nb_val_site.fetch_add(self.site_hits, Ordering::Relaxed);
+            stats.nb_val_aborted.fetch_add(self.aborted, Ordering::Relaxed);
+        }
+        self.aborted = 0;
+        if self.use_hist && !self.hist_new.is_empty() {
+            let mut h = nb_hist().write();
+            for (k, (t, n, last)) in self.hist_new.drain() {
+                let e = h.entry(k).or_insert((0, 0, false));
+                e.0 += t;
+                e.1 += n;
+                e.2 = last;
+            }
+        }
+        if self.bh {
+            NB_BH_TXS.fetch_add(1, Ordering::Relaxed);
+            NB_BH_NS.fetch_add(ns, Ordering::Relaxed);
+            NB_BH_OK.fetch_add(ok as u64, Ordering::Relaxed);
+            return
+        }
+        if let Some(stats) = PW_STATS.lock().clone() {
+            stats.nb_txs.fetch_add(1, Ordering::Relaxed);
+            stats.nb_steps.fetch_add(self.steps, Ordering::Relaxed);
+            stats.nb_keys.fetch_add(NB_KEYS.with(|c| c.get()), Ordering::Relaxed);
+            stats.nb_tainted_keys.fetch_add(NB_TAINTED_KEYS.with(|c| c.get()), Ordering::Relaxed);
+            stats.nb_forced.fetch_add(self.forced, Ordering::Relaxed);
+            stats.nb_hist.fetch_add(self.hist_hits, Ordering::Relaxed);
+            stats.nb_skipped.fetch_add(self.skipped, Ordering::Relaxed);
+            stats.nb_ok.fetch_add(ok as u64, Ordering::Relaxed);
+            stats.nb_ns.fetch_add(ns, Ordering::Relaxed);
+        }
+    }
+}
+
+impl<T: EvmTypes> Inspector<T> for NbInspector {
+    fn allows_compiled_frames(&self) -> bool {
+        !self.interp
+    }
+
+    fn step(&mut self, interp: &mut Interpreter<'_, '_, T>) {
+        self.steps += 1;
+        // EXP-180: cut a speculative pass short (budget spent or the execution thread passed the transaction)
+        if self.val != 0 && !self.bh {
+            if !self.abort && self.steps % 4096 == 0 {
+                let over = !self.bud_stop && self.t_pass.is_some_and(|t| t.elapsed().as_nanos() as u64 > nb_levels().1);
+                let passed = self.tx_pass != u32::MAX && self.exec.as_ref().is_some_and(|e| (self.tx_pass as usize) < e.load(Ordering::Relaxed));
+                if over || passed {
+                    self.abort = true;
+                    self.aborted += 1;
+                }
+            }
+            if self.abort {
+                // evm2 honours a result set in `step`: the instruction is not run and the frame halts out of gas
+                interp.set_stop(InstrStop::OutOfGas);
+                return
+            }
+        }
+        let o = interp.opcode();
+        if self.frames.is_empty() {
+            let input_len = interp.message().input.len();
+            self.frames.push(NbFrame { calldata: vec![false; input_len], ..Default::default() });
+        }
+        let addr = interp.message().destination;
+        let pc = interp.pc();
+        let n = interp.stack().len();
+        // the operands read below (at most the seventh from the top, CALL's return length)
+        let top: [U256; 8] = {
+            let st = interp.stack();
+            std::array::from_fn(|i| st.peek(i).unwrap_or(U256::ZERO))
+        };
+        let ml = interp.memory().len();
+        let f = self.frames.last_mut().unwrap();
+        f.nsteps += 1;
+        if f.stack.len() != n {
+            f.stack.resize(n, false);
+        }
+        if f.mem.len() < ml && ml < NB_MEM_LIMIT {
+            f.mem.resize(ml, false);
+        }
+        let t = |i: usize| -> bool { if i < n { f.stack[n - 1 - i] } else { false } };
+        let v = |i: usize| -> U256 { if i < n && i < top.len() { top[i] } else { U256::ZERO } };
+        let mut pending = NbPending::None;
+        match o {
+            op::SLOAD => {
+                let key = v(0);
+                let kt = t(0) || self.tainted_slots.contains(&(addr, key)) || self.unknown.contains(&(addr, key));
+                NB_KEY_TAINTED.with(|c| c.set(t(0)));
+                let site = (interp.original_bytecode_hash(), pc);
+                if self.val != 0 {
+                    // EXP-180: the prediction in case the slot is not cached
+                    let p = if self.val == 1 {
+                        match self.site_cur.get(&site).copied().or_else(|| nb_sites().read().get(&site).copied()) {
+                            Some(x) => {
+                                self.site_hits += 1;
+                                x
+                            }
+                            None => U256::ZERO,
+                        }
+                    } else {
+                        U256::ZERO
+                    };
+                    NB_PRED.with(|c| c.set(Some(p)));
+                }
+                pending = NbPending::Sload(addr, key, kt, site);
+            }
+            op::SSTORE => {
+                if t(0) || t(1) {
+                    self.tainted_slots.insert((addr, v(0)));
+                }
+                pending = NbPending::Pop(2);
+            }
+            op::JUMPI => {
+                if t(1) && self.val != 0 {
+                    // EXP-180: a branch on a predicted condition follows the predicted values, except that an arm
+                    // reaching REVERT/INVALID (through unconditional jumps) is avoided
+                    let dir = {
+                        let code = interp.original_bytecode_slice();
+                        let dest = nb_usz(v(0));
+                        let fr = nb_arm_reverts2(code, pc + 1);
+                        let dr = if dest < code.len() && code[dest] == op::JUMPDEST { nb_arm_reverts2(code, dest) } else { true };
+                        let taken = v(1) != U256::ZERO;
+                        if fr && !dr { true } else if dr && !fr { false } else { taken }
+                    };
+                    if dir != (v(1) != U256::ZERO) {
+                        self.forced += 1;
+                        let mut sm = interp.stack_mut();
+                        let d = sm.as_slice_mut();
+                        let l = d.len();
+                        d[l - 2] = if dir { U256::from(1u8) } else { U256::ZERO };
+                    }
+                } else if t(1) {
+                    let (fr, dr) = {
+                        let code = interp.original_bytecode_slice();
+                        let dest = nb_usz(v(0));
+                        let fr = nb_arm_reverts(code, pc + 1);
+                        let dr = if dest < code.len() && code[dest] == op::JUMPDEST { nb_arm_reverts(code, dest) } else { true };
+                        (fr, dr)
+                    };
+                    let dir = if fr && !dr {
+                        true
+                    } else if dr && !fr {
+                        false
+                    } else if self.use_hist {
+                        let h = interp.original_bytecode_hash();
+                        match nb_hist().read().get(&(h, pc)) {
+                            Some(&(tk, nt, last)) => {
+                                self.hist_hits += 1;
+                                if tk == nt { last } else { tk > nt }
+                            }
+                            None => false,
+                        }
+                    } else {
+                        false
+                    };
+                    self.forced += 1;
+                    let mut sm = interp.stack_mut();
+                    let d = sm.as_slice_mut();
+                    let l = d.len();
+                    d[l - 2] = if dir { U256::from(1u8) } else { U256::ZERO };
+                } else if self.use_hist && self.record {
+                    let taken = v(1) != U256::ZERO;
+                    let h = interp.original_bytecode_hash();
+                    let e = self.hist_new.entry((h, pc)).or_insert((0, 0, false));
+                    if taken { e.0 += 1 } else { e.1 += 1 }
+                    e.2 = taken;
+                }
+                pending = NbPending::Pop(2);
+            }
+            op::MLOAD => {
+                let off = nb_usz(v(0));
+                pending = NbPending::PopPush(1, 1, t(0) || nb_any(&f.mem, off, 32));
+            }
+            op::MSTORE => pending = NbPending::MemSet(nb_usz(v(0)), 32, t(1) || t(0), 2),
+            op::MSTORE8 => pending = NbPending::MemSet(nb_usz(v(0)), 1, t(1) || t(0), 2),
+            op::CALLDATALOAD => {
+                let off = nb_usz(v(0));
+                pending = NbPending::PopPush(1, 1, t(0) || nb_any(&f.calldata, off, 32));
+            }
+            op::CALLDATACOPY => {
+                let (dst, src, len) = (nb_usz(v(0)), nb_usz(v(1)), nb_usz(v(2)).min(1 << 24));
+                let mut sl = vec![t(1) || t(2); len];
+                for (i, x) in sl.iter_mut().enumerate() {
+                    if src + i < f.calldata.len() && f.calldata[src + i] {
+                        *x = true;
+                    }
+                }
+                pending = NbPending::MemCopy(sl, dst, 3);
+            }
+            op::CODECOPY => pending = NbPending::MemSet(nb_usz(v(0)), nb_usz(v(2)).min(1 << 24), false, 3),
+            op::EXTCODECOPY => pending = NbPending::MemSet(nb_usz(v(1)), nb_usz(v(3)).min(1 << 24), false, 4),
+            op::RETURNDATACOPY => {
+                let (dst, src, len) = (nb_usz(v(0)), nb_usz(v(1)), nb_usz(v(2)).min(1 << 24));
+                let mut sl = vec![f.ret_all || t(1) || t(2); len];
+                if !f.ret_all {
+                    for (i, x) in sl.iter_mut().enumerate() {
+                        if src + i < f.ret.len() && f.ret[src + i] {
+                            *x = true;
+                        }
+                    }
+                }
+                pending = NbPending::MemCopy(sl, dst, 3);
+            }
+            op::RETURNDATASIZE => pending = NbPending::Push(f.ret_all),
+            op::MCOPY => {
+                let (dst, src, len) = (nb_usz(v(0)), nb_usz(v(1)), nb_usz(v(2)).min(1 << 24));
+                let mut sl = vec![t(0) || t(1) || t(2); len];
+                for (i, x) in sl.iter_mut().enumerate() {
+                    if src + i < f.mem.len() && f.mem[src + i] {
+                        *x = true;
+                    }
+                }
+                pending = NbPending::MemCopy(sl, dst, 3);
+            }
+            op::KECCAK256 => {
+                let (off, len) = (nb_usz(v(0)), nb_usz(v(1)));
+                pending = NbPending::PopPush(2, 1, t(0) || t(1) || nb_any(&f.mem, off, len));
+            }
+            op::RETURN | op::REVERT => {
+                let (off, len) = (nb_usz(v(0)), nb_usz(v(1)).min(1 << 24));
+                f.out = (0..len).map(|i| off + i < f.mem.len() && f.mem[off + i]).collect();
+                f.out_all = t(0) || t(1);
+            }
+            op::STOP | op::SELFDESTRUCT | op::INVALID => {}
+            op::CALL | op::CALLCODE => {
+                let (inoff, inlen) = (nb_usz(v(3)), nb_usz(v(4)).min(1 << 24));
+                let cd: Vec<bool> = (0..inlen).map(|i| inoff + i < f.mem.len() && f.mem[inoff + i]).collect();
+                f.pending_call = Some((t(1), cd, nb_range(v(5), v(6))));
+                pending = NbPending::CallEnd(7);
+            }
+            op::DELEGATECALL | op::STATICCALL => {
+                let (inoff, inlen) = (nb_usz(v(2)), nb_usz(v(3)).min(1 << 24));
+                let cd: Vec<bool> = (0..inlen).map(|i| inoff + i < f.mem.len() && f.mem[inoff + i]).collect();
+                f.pending_call = Some((t(1), cd, nb_range(v(4), v(5))));
+                pending = NbPending::CallEnd(6);
+            }
+            op::CREATE => {
+                f.pending_call = Some((false, Vec::new(), 0..0));
+                pending = NbPending::CallEnd(3);
+            }
+            op::CREATE2 => {
+                f.pending_call = Some((false, Vec::new(), 0..0));
+                pending = NbPending::CallEnd(4);
+            }
+            op::PUSH0..=op::PUSH32 => pending = NbPending::Push(false),
+            op::DUP1..=op::DUP16 => {
+                let k = (o - op::DUP1) as usize;
+                pending = NbPending::Push(t(k));
+            }
+            op::SWAP1..=op::SWAP16 => {
+                let k = (o - op::SWAP1 + 1) as usize;
+                if k < n {
+                    f.stack.swap(n - 1, n - 1 - k);
+                }
+            }
+            op::LOG0..=op::LOG4 => pending = NbPending::Pop(2 + (o - op::LOG0) as usize),
+            _ => {
+                if let Some(info) = OPCODE_INFO[o as usize] {
+                    let (ni, no) = (info.inputs() as usize, info.outputs() as usize);
+                    let mut tt = false;
+                    for i in 0..ni {
+                        tt |= t(i);
+                    }
+                    pending = NbPending::PopPush(ni, no, tt);
+                }
+            }
+        }
+        f.pending = Some(pending);
+    }
+
+    fn step_end(&mut self, interp: &mut Interpreter<'_, '_, T>) {
+        let Some(f) = self.frames.last_mut() else { return };
+        let Some(p) = f.pending.take() else { return };
+        let ml = interp.memory().len();
+        if f.mem.len() < ml && ml < NB_MEM_LIMIT {
+            f.mem.resize(ml, false);
+        }
+        let pop = |f: &mut NbFrame, k: usize| {
+            let l = f.stack.len();
+            f.stack.truncate(l.saturating_sub(k));
+        };
+        match p {
+            NbPending::None => {}
+            NbPending::Pop(k) => pop(f, k),
+            NbPending::Push(b) => f.stack.push(b),
+            NbPending::PopPush(k, m, b) => {
+                pop(f, k);
+                for _ in 0..m {
+                    f.stack.push(b);
+                }
+            }
+            NbPending::Sload(addr, key, kt, site) => {
+                let unknown = NB_UNKNOWN.with(|c| c.replace(false));
+                if unknown {
+                    self.unknown.insert((addr, key));
+                } else if self.val != 0 && !kt && let Some(x) = interp.stack().peek(0) {
+                    // EXP-180: a cached (true) value read at this site; not when the key is computed from predicted
+                    // values, the slot was written with such a value in this pass, or the slot was answered with a
+                    // prediction earlier in this pass (the journal then returns the prediction) (X-019 review)
+                    self.site_cur.insert(site, x);
+                }
+                NB_PRED.with(|c| c.set(None));
+                pop(f, 1);
+                f.stack.push(kt || unknown);
+            }
+            NbPending::MemSet(off, len, b, k) => {
+                pop(f, k);
+                if len > 0 && off < NB_MEM_LIMIT {
+                    let end = off.saturating_add(len);
+                    if f.mem.len() < end {
+                        f.mem.resize(end, false);
+                    }
+                    for x in &mut f.mem[off..end] {
+                        *x = b;
+                    }
+                }
+            }
+            NbPending::MemCopy(sl, dst, k) => {
+                pop(f, k);
+                if !sl.is_empty() && dst < NB_MEM_LIMIT {
+                    let end = dst.saturating_add(sl.len());
+                    if f.mem.len() < end {
+                        f.mem.resize(end, false);
+                    }
+                    f.mem[dst..end].copy_from_slice(&sl);
+                }
+            }
+            NbPending::CallEnd(k) => {
+                pop(f, k);
+                // no hook ran (the instruction failed before sending a message): untainted, as the stack resync gave
+                let b = f.call_ret.take().unwrap_or(false);
+                f.stack.push(b);
+            }
+        }
+        // a store of an untainted key may have loaded the slot's original value as unknown: clear the flag
+        NB_UNKNOWN.with(|c| c.set(false));
+    }
+
+    fn call(&mut self, interp: &mut Interpreter<'_, '_, T>, message: &mut Message<T>) -> Option<MessageResult<T>> {
+        let (tt, cd, ret) = self.frames.last_mut().and_then(|f| f.pending_call.take()).unwrap_or((false, Vec::new(), 0..0));
+        // EXP-180: in value-speculation mode a call to a predicted target is entered
+        if tt && self.val == 0 {
+            self.skipped += 1;
+            self.skip_pending = Some(ret);
+            let mut r = MessageResult::<T>::default();
+            r.stop = InstrStop::Return;
+            r.output = Bytes::from(vec![0u8; 4096]);
+            r.gas = evm2::interpreter::GasTracker::new(message.gas_limit);
+            return Some(r)
+        }
+        // EXP-199 round 3 (`nbpl=1`): the callee's plan with this call's arguments on the speculative path, for an inner
+        // call (the outermost call's plan is instantiated at transaction arrival), through the readers' frame jobs
+        // (with `pwnbtaintkey` and no value speculation, calldata computed from unknown values gives no plan, as `NbDb`
+        // holds back such keys; the taint bits are set by the step hook, so in compiled code the check passes)
+        if let Some(s) = &self.plan_tx &&
+            !(self.val == 0 && nb_taintkey() && cd.iter().any(|&b| b))
+        {
+            let depth = msg_depth(interp, message);
+            let h = message.code.hash_slow();
+            if depth >= 1 &&
+                let Some(plan) = plans().and_then(|p| p.get(&h)).filter(|p| p.kind == 0) &&
+                compiled_peek(h, self.pwmin)
+            {
+                let _ = s.send(Item::Frame(Box::new(FrameJob {
+                    plan,
+                    input: message.input.clone(),
+                    caller: message.caller,
+                    origin: interp.tx_env().origin,
+                    target: message.destination,
+                    value: message.value,
+                    depth,
+                    pw: true,
+                    nb: true,
+                    tx: PW_CUR_TX.with(|c| c.get()),
+                })));
+            }
+        }
+        self.frames.push(NbFrame { calldata: cd, ret_to: ret, ..Default::default() });
+        None
+    }
+
+    fn call_end(&mut self, _interp: &mut Interpreter<'_, '_, T>, _message: &Message<T>, _result: &mut MessageResult<T>) {
+        let (out, out_all, skipped, r) = if let Some(r) = self.skip_pending.take() {
+            (Vec::new(), true, true, r)
+        } else {
+            match self.frames.pop() {
+                Some(callee) if callee.nsteps == 0 => (Vec::new(), callee.calldata.iter().any(|&b| b), false, callee.ret_to),
+                Some(callee) => (callee.out, callee.out_all, false, callee.ret_to),
+                None => return,
+            }
+        };
+        if let Some(c) = self.frames.last_mut() {
+            c.ret = out.clone();
+            c.ret_all = out_all;
+            if r.end > r.start && r.end < NB_MEM_LIMIT {
+                if c.mem.len() < r.end {
+                    c.mem.resize(r.end, false);
+                }
+                for i in r.start..r.end {
+                    let j = i - r.start;
+                    c.mem[i] = out_all || (j < out.len() && out[j]);
+                }
+            }
+            c.call_ret = Some(skipped);
+        }
+    }
+
+    fn create(&mut self, _interp: &mut Interpreter<'_, '_, T>, _message: &mut Message<T>) -> Option<MessageResult<T>> {
+        if let Some(f) = self.frames.last_mut() {
+            f.pending_call.take();
+        }
+        self.frames.push(NbFrame::default());
+        None
+    }
+
+    fn create_end(&mut self, _interp: &mut Interpreter<'_, '_, T>, _message: &Message<T>, _result: &mut MessageResult<T>) {
+        self.frames.pop();
+        if let Some(c) = self.frames.last_mut() {
+            c.ret.clear();
+            c.ret_all = false;
+            c.call_ret = Some(false);
+        }
+    }
+}
+
+/// X-027: the inspector-visible depth of a message as revm's `journal().depth()` gave it in the call hooks (0 for a
+/// transaction's outermost call, >= 1 for inner calls): evm2 counts from `Version::initial_call_depth`.
+fn msg_depth<T: EvmTypes>(interp: &Interpreter<'_, '_, T>, message: &Message<T>) -> usize {
+    usize::from(message.depth.saturating_sub(interp.version().initial_call_depth))
+}
+
+pub fn pw_set_tx(idx: usize) {
+    PW_CUR_TX.with(|c| c.set(idx as u32));
+    PW_TX_JOBS.with(|c| c.set(0));
+    pw_keccak_reset();
+    // Prologue (`ixpf`): the transaction's index-key patterns, inputs and key count start empty
+    ix::tx_begin();
+}
+
+/// Prewarm worker: plan jobs issued since [`pw_set_tx`].
+pub fn pw_tx_jobs() -> u32 {
+    PW_TX_JOBS.with(|c| c.get())
+}
+
+/// Whether `code` has been called more than `pwmin` times, without counting this call (fresh-state runs).
+fn compiled_peek(code: B256, pwmin: u32) -> bool {
+    pwmin == 0 || reth_execution_cache::lkprof::lock(reth_execution_cache::lkprof::CALLS, &CALLS).get(&code).is_some_and(|c| *c > pwmin)
+}
+
+static LOAD: Once = Once::new();
+/// Blocks started ([`refresh`]); `sr_block_start` renews the proof workers' thread ids every 256 blocks.
+static BLOCKS: AtomicU64 = AtomicU64::new(0);
+/// Predicted-slot states and counters of the block being executed, for [`probe_storage_miss`].
+static PROBE: Mutex<Option<(Arc<Mutex<Issued>>, Arc<Stats>)>> = parking_lot::const_mutex(None);
+
+/// EXP-105 (`pwtrace=1`): per-key times of the block being processed (ns since [`refresh`]), written at block end.
+struct KeyTrace {
+    t0: Instant,
+    block: u64,
+    /// first gated instantiation of a key: reason (1 `pwk`, 2 discovery running, 3 `pwmin`, 4 outermost call, 5 `pwlag`), time
+    would: HashMap<(Address, B256), (u8, u64)>,
+    /// first issue by a prewarm worker
+    issued: HashMap<(Address, B256), u64>,
+    /// read start and end on a reader (end 0: not finished)
+    read: HashMap<(Address, B256), (u64, u64)>,
+    /// first drop of a job holding the key because the execution thread had passed its transaction
+    dropped: HashMap<(Address, B256), u64>,
+    /// EXP-122: first issue by the non-blocking pass
+    nb_issued: HashMap<(Address, B256), u64>,
+    /// EXP-129 third segment: passes of the level-by-level runahead: tx, level, start, end, keys handed out,
+    /// instructions, success, stop reason
+    nb_passes: Vec<(u32, u8, u64, u64, u32, u64, bool, u8)>,
+    /// execution-thread misses: address, key, time, probe state (0 not issued, 1 queued, 2 being read, 3 read), tx
+    misses: Vec<(Address, B256, u64, u8, u32)>,
+    /// EXP-130: keys the loop-call extrapolation issued first (new at issue): issue time, transaction
+    lx: HashMap<(Address, B256), (u64, u32)>,
+    /// EXP-172 (`pwlxacct`): callee accounts handed to the readers: issue time, read start, read end (0: not yet), tx
+    acct: HashMap<Address, (u64, u64, u64, u32)>,
+}
+
+static KEYTRACE: Mutex<Option<KeyTrace>> = parking_lot::const_mutex(None);
+
+/// Runs `f` on the block's key trace with the current time, when `pwtrace=1`.
+fn kt(f: impl FnOnce(&mut KeyTrace, u64)) {
+    if let Some(k) = KEYTRACE.lock().as_mut() {
+        let t = k.t0.elapsed().as_nanos() as u64;
+        f(k, t);
+    }
+}
+
+/// Records the keys of a dropped prewarm-worker job (`pwtrace=1`).
+fn kt_drop(it: &Item) {
+    if let Item::Keys(k) = it {
+        let a = k.0;
+        kt(|kt, t| {
+            for key in &k.1 {
+                kt.dropped.entry((a, B256::from(*key))).or_insert(t);
+            }
+        });
+    }
+}
+
+/// Writes the block's key trace to `EAP_KEYDIAG` (EXP-105).
+fn kt_write(k: KeyTrace) {
+    let Some(path) = std::env::var_os("EAP_KEYDIAG") else { return };
+    use std::fmt::Write as _;
+    let o = |v: Option<u64>| v.map_or(-1i64, |x| x as i64);
+    let mut out = String::with_capacity(160 * k.misses.len() + 128);
+    let _ = write!(out, "{{\"block\":{},\"would\":{},\"issued\":{},\"read\":{},\"dropped\":{},\"nb_issued\":{},\"misses\":[", k.block, k.would.len(), k.issued.len(), k.read.len(), k.dropped.len(), k.nb_issued.len());
+    for (i, (a, key, t, st, tx)) in k.misses.iter().enumerate() {
+        let id = (*a, *key);
+        let r = k.read.get(&id).copied();
+        let w = k.would.get(&id).copied();
+        let _ = write!(
+            out,
+            "{}[\"{a}\",\"{key}\",{t},{st},{},{},{},{},{},{},{},{}]",
+            if i > 0 { "," } else { "" },
+            if *tx == u32::MAX { -1 } else { *tx as i64 },
+            o(k.issued.get(&id).copied()),
+            o(r.map(|x| x.0)),
+            o(r.and_then(|x| (x.1 > 0).then_some(x.1))),
+            w.map_or(0, |x| x.0),
+            o(w.map(|x| x.1)),
+            o(k.dropped.get(&id).copied()),
+            o(k.nb_issued.get(&id).copied()),
+        );
+    }
+    // EXP-130: the keys the extrapolation issued, with their read times and whether the execution thread missed them
+    let missed: std::collections::HashSet<(Address, B256)> = k.misses.iter().map(|m| (m.0, m.1)).collect();
+    // EXP-158: per address, the first time a prewarm worker issued any of its keys this block (every issued key, not only
+    // the ones the execution thread later missed), for the plan-guided page-prefetch bound
+    let mut first_by_addr: HashMap<Address, u64> = HashMap::new();
+    for ((a, _), t) in &k.issued {
+        let e = first_by_addr.entry(*a).or_insert(*t);
+        if *t < *e {
+            *e = *t;
+        }
+    }
+    out.push_str("],\"iss_addr\":[");
+    for (i, (a, t)) in first_by_addr.iter().enumerate() {
+        let _ = write!(out, "{}[\"{a}\",{t}]", if i > 0 { "," } else { "" });
+    }
+    out.push_str("],\"lx_keys\":[");
+    for (i, ((a, key), (t, tx))) in k.lx.iter().enumerate() {
+        let r = k.read.get(&(*a, *key)).copied();
+        let _ = write!(out, "{}[\"{a}\",\"{key}\",{t},{tx},{},{},{}]", if i > 0 { "," } else { "" }, o(r.map(|x| x.0)), o(r.and_then(|x| (x.1 > 0).then_some(x.1))), u8::from(missed.contains(&(*a, *key))));
+    }
+    // EXP-172: callee accounts handed to the readers (`pwlxacct`): issue time, read start and end (-1: not), transaction
+    out.push_str("],\"lx_accts\":[");
+    for (i, (a, (t, rs, re, tx))) in k.acct.iter().enumerate() {
+        let z = |v: u64| if v == 0 { -1i64 } else { v as i64 };
+        let _ = write!(out, "{}[\"{a}\",{t},{},{},{tx}]", if i > 0 { "," } else { "" }, z(*rs), z(*re));
+    }
+    // EXP-122: every key the non-blocking pass issued, with its issue time and the reader's read end (0: not read)
+    out.push_str("],\"nb_keys\":[");
+    for (i, ((a, key), t)) in k.nb_issued.iter().enumerate() {
+        let r = k.read.get(&(*a, *key)).copied();
+        let _ = write!(out, "{}[\"{a}\",\"{key}\",{t},{},{}]", if i > 0 { "," } else { "" }, o(r.map(|x| x.0)), o(r.and_then(|x| (x.1 > 0).then_some(x.1))));
+    }
+    // EXP-129 third segment: per-pass records
+    out.push_str("],\"nb_passes\":[");
+    for (i, p) in k.nb_passes.iter().enumerate() {
+        let _ = write!(out, "{}[{},{},{},{},{},{},{},{}]", if i > 0 { "," } else { "" }, p.0, p.1, p.2, p.3, p.4, p.5, p.6 as u8, p.7);
+    }
+    out.push_str("]}\n");
+    use std::io::Write as _;
+    if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+        let _ = f.write_all(out.as_bytes());
+    }
+}
