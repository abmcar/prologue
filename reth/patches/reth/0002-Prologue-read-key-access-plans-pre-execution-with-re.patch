+        pw_keccak_hook(&[1; 64]);
+        pw_keccak_hook(&[1; 10]);
+        assert_eq!(PW_KECCAK_STAT.with(|s| s.get()), [3, 1, 1]);
+        assert_eq!(pw_keccak_take(7).len(), 1);
