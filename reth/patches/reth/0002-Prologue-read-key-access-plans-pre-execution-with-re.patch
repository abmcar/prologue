+#[cfg(test)]
+mod ct_spread_tests {
+    use super::*;
+    use crate::tree::plan_store::plan_header_ok;
+
+    fn call(i: u8) -> frame_plan::CallOut {
+        frame_plan::CallOut { kind: 0, target: U256::from(0x1000u32 + u32::from(i)), payload: Some(vec![i]) }
+    }
+
+    /// EXP-199 round 3 (`ctspread`): off or a short job keeps every call; otherwise the first N stay and the rest go to
+    /// the readers in chunks of N, in order, with the job's context
+    #[test]
+    fn keeps_first_n_and_chunks_the_rest() {
+        let (s, r) = crossbeam_channel::unbounded();
+        let stats = Stats::default();
+        let (a, o, u) = (Address::repeat_byte(1), Address::repeat_byte(2), Address::repeat_byte(3));
+        let mut m = Mode::OFF;
+        let calls: Vec<_> = (0..10).map(call).collect();
+        assert_eq!(ct_spread(calls.clone(), &m, &stats, &s, u, a, o, U256::ZERO, 3, 0).len(), 10);
+        m.ctspread = 10;
+        assert_eq!(ct_spread(calls.clone(), &m, &stats, &s, u, a, o, U256::ZERO, 3, 0).len(), 10);
+        assert!(r.try_recv().is_err());
+        m.ctspread = 4;
+        let kept = ct_spread(calls, &m, &stats, &s, u, a, o, U256::from(7u8), 3, 1);
+        assert_eq!(kept.iter().map(|c| c.payload.as_ref().unwrap()[0]).collect::<Vec<_>>(), vec![0, 1, 2, 3]);
+        let mut got = Vec::new();
+        while let Ok(Item::CtCalls(ch)) = r.try_recv() {
+            assert_eq!((ch.caller, ch.addr, ch.origin, ch.value, ch.tx, ch.depth), (u, a, o, U256::from(7u8), 3, 1));
+            got.push(ch.calls.iter().map(|c| c.payload.as_ref().unwrap()[0]).collect::<Vec<_>>());
+        }
+        assert_eq!(got, vec![vec![4, 5, 6, 7], vec![8, 9]]);
+        assert_eq!(stats.ct_spread.load(Ordering::Relaxed), 2);
+        assert_eq!(stats.ct_spread_calls.load(Ordering::Relaxed), 6);
+    }
+
+    /// EXP-199 round 3: format versions 1-3 pass the header check, others do not
+    #[test]
+    fn version_three_header() {
+        let mut b = b"EAPF".to_vec();
+        b.extend_from_slice(&3u32.to_le_bytes());
+        b.extend_from_slice(&0u32.to_le_bytes());
+        assert!(plan_header_ok(&b));
+        b[4] = 4;
+        assert!(!plan_header_ok(&b));
+        b[4] = 0;
+        assert!(!plan_header_ok(&b));
+    }
+}
