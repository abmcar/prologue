+/// EXP-130 (`pwlx`): the outcome of one observed inner call: the counters, and a fitted group's predicted calls handed to a
+/// reader (on the worker, or with `lxoff` on its companion thread).
+#[allow(clippy::too_many_arguments)]
+fn lx_after_observe(r: eap_lx::LxObserve, t0: Instant, stats: &Arc<Stats>, mode: &Mode, tx: &Sender<Item>, origin: Address, value: U256, cur: u32) {
+        let (key, seen, calls, info) = match r {
+            eap_lx::LxObserve::Skipped | eap_lx::LxObserve::Pending => return,
+            eap_lx::LxObserve::Rejected { reason, .. } => {
+                stats.lx_groups.fetch_add(1, Ordering::Relaxed);
+                stats.lx_fit_ns.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+                match reason {
+                    eap_lx::LxReject::Caller => &stats.lx_rej_caller,
+                    eap_lx::LxReject::Word => &stats.lx_rej_word,
+                    eap_lx::LxReject::Target => &stats.lx_rej_target,
+                    eap_lx::LxReject::Const => &stats.lx_rej_const,
+                    eap_lx::LxReject::Verify => &stats.lx_rej_verify,
+                }
+                .fetch_add(1, Ordering::Relaxed);
+                return
+            }
+            eap_lx::LxObserve::Fitted { key, seen, calls, info } => (key, seen, calls, info),
+        };
+        stats.lx_groups.fetch_add(1, Ordering::Relaxed);
+        stats.lx_fit_ns.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        stats.lx_fit.fetch_add(1, Ordering::Relaxed);
+        stats.lx_calls.fetch_add(calls.len() as u64, Ordering::Relaxed);
+        match info.target { 0 => &stats.lx_fit_const, 1 => &stats.lx_fit_cd, _ => &stats.lx_fit_create }.fetch_add(1, Ordering::Relaxed);
+        if info.target == 2 { stats.lx_c2.fetch_add(1, Ordering::Relaxed); }
+        if info.caller_fit { stats.lx_fit_caller.fetch_add(1, Ordering::Relaxed); }
+        if info.capped { stats.lx_capped.fetch_add(1, Ordering::Relaxed); }
+        if info.known { stats.lx_fit_known.fetch_add(1, Ordering::Relaxed); }
+        if info.dec_capped { stats.lx_dec_capped.fetch_add(1, Ordering::Relaxed); }
+        if mode.pwlxdbg {
+            info!(target: "eap::lx", tx = cur, sel = format!("{:08x}", key.0), len = key.1, ccr = key.2, n = calls.len(), caller = ?seen[0].2, target0 = ?seen[0].0, context = ?calls[0].context, caller_pred = ?calls[0].caller, hint = calls[0].code_hint.is_some(), "lx fit");
+        }
+                let job = LxJob { calls, caller: seen[0].2, origin, value, tx: cur };
+        let _ = tx.send(Item::Lx(Box::new(job)));
+        if mode.pwlxrdacct == 0 && !(mode.ew > 0 && mode.ewbud & EWB_RDGATE != 0) {
+            lx_gate_open();
+        }
+    }
+
+/// Prologue (`lxoff`, EXP-269): one inner call for a companion's tracker.
+struct LxObs {
+    p: eap_lx::LxParams,
+    target: Address,
+    code: B256,
+    caller: Address,
+    input: Bytes,
+    kind: u8,
+    txin: Bytes,
+    origin: Address,
+    value: U256,
+    cur: u32,
+}
+
+/// Prologue (`lxoff`, EXP-269): a tracker operation of one prewarm inspector, in its order.
+enum LxBody {
+    Init(Sender<Item>, Arc<Stats>, Mode),
+    Begin(u32),
+    Keccak(Vec<u8>),
+    Keccaks(Vec<Vec<u8>>),
+    Dec(Address, Bytes),
+    Known(Vec<(Vec<Address>, Vec<Address>)>),
+    Created(Address, U256, B256, Address),
+    Observe(Box<LxObs>),
+    End,
+}
+
+/// Prologue (`lxoff`): the companion threads, each serving the inspectors whose key maps to it; keys of inspectors.
+const LXC_N: usize = 8;
+static LXC: OnceLock<Vec<Sender<(u64, LxBody)>>> = OnceLock::new();
+static LXK: AtomicU64 = AtomicU64::new(0);
+
+fn lx_companion(key: u64) -> &'static Sender<(u64, LxBody)> {
+    let v = LXC.get_or_init(|| {
+        (0..LXC_N)
+            .map(|i| {
+                let (s, r) = crossbeam_channel::unbounded::<(u64, LxBody)>();
+                let _ = thread::Builder::new().name(format!("eap-lx-{i}")).spawn(move || lx_companion_run(r));
+                s
+            })
+            .collect()
+    });
+    &v[(key as usize) % LXC_N]
+}
+
+/// Prologue (`lxoff`): a companion thread: one tracker per inspector, the operations applied in their order.
+fn lx_companion_run(r: Receiver<(u64, LxBody)>) {
+    struct Side {
+        lx: eap_lx::LxTracker,
+        tx_ns: u64,
+        tx: Sender<Item>,
+        stats: Arc<Stats>,
+        mode: Mode,
+    }
+    let mut sides: HashMap<u64, Side> = HashMap::new();
+    for (key, body) in r {
+        match body {
+            LxBody::Init(tx, stats, mode) => {
+                // the readers' CPUs and scheduling class for this block (`rdsplit`, `rdidle`)
+                crate::tree::eap_ew::leave_exec_core_reader();
+                if mode.rdidle {
+                    set_own_idle();
+                    if mode.rdidleio {
+                        crate::tree::eap::rdidle_io();
+                    }
+                }
+                sides.insert(key, Side { lx: eap_lx::LxTracker::default(), tx_ns: 0, tx, stats, mode });
+            }
+            LxBody::End => {
+                sides.remove(&key);
+            }
+            body => {
+                let Some(s) = sides.get_mut(&key) else { continue };
+                match body {
+                    LxBody::Begin(cur) => {
+                        if s.lx.cur != cur {
+                            if !s.lx.c2obs.is_empty() {
+                                lx_note_created(s.lx.cur, s.lx.n_created);
+                            }
+                            s.lx.reset(cur);
+                            s.lx.shift = lx_shift_for(cur);
+                            s.tx_ns = 0;
+                        }
+                    }
+                    LxBody::Keccak(m) => s.lx.keccak(&m),
+                    LxBody::Keccaks(ms) => {
+                        for m in ms {
+                            s.lx.keccak(&m);
+                        }
+                    }
+                    LxBody::Dec(to, txin) => s.lx.set_dec_counts(to, &txin),
+                    LxBody::Known(lists) => s.lx.set_known(lists),
+                    LxBody::Created(caller, salt, h, created) => s.lx.created_real(caller, salt, h, created),
+                    LxBody::Observe(o) => {
+                        if s.mode.pwlxfitus > 0 && s.tx_ns >= s.mode.pwlxfitus.saturating_mul(1000) {
+                            s.stats.lx_fit_over.fetch_add(1, Ordering::Relaxed);
+                            continue
+                        }
+                        let t0 = Instant::now();
+                        let o = *o;
+                        let r = s.lx.observe(&o.p, o.target, o.code, o.caller, o.input, o.kind, &o.txin, false);
+                        s.tx_ns = s.tx_ns.saturating_add(t0.elapsed().as_nanos() as u64);
+                        lx_after_observe(r, t0, &s.stats, &s.mode, &s.tx, o.origin, o.value, o.cur);
+                    }
+                    LxBody::Init(..) | LxBody::End => {}
+                }
+            }
+        }
+    }
+}
