+
+/// Classifies the block's execution-thread storage misses against the insert times of the same keys and
+/// appends one JSON line to the `EAP_DIAG` file. Miss classes: 0 key not loaded into the execution cache by a
+/// prewarm worker or reader before this call; 1 loaded by a prewarm worker after the miss started; 2 loaded by an
+/// access-plan reader after the miss started; 3 loaded before the miss started (still missed).
+pub fn cc_diag_flush(block: u64, gas_used: u64) {
+    let Some(path) = DIAG_PATH.as_ref() else { return };
+    diag_exec_flush_counters();
+    DIAG_EXEC.with(|c| c.set(None));
+    DIAG_EXEC_BLOCK.with(|c| *c.borrow_mut() = None);
+    let Some(b) = DIAG_BLOCK.lock().take() else { return };
+    let t_flush = diag_now_ns();
+    let mut g = crate::lkprof::lock(crate::lkprof::DIAG, &b.inner);
+    b.settle(&mut g);
+    let us = |t: u64| -> i64 { if t == 0 { -1 } else { (t as i64 - b.t0 as i64) / 1000 } };
+    let mut out = String::with_capacity(64 * (g.txs.len() + g.misses.len()) + 256);
+    use std::fmt::Write as _;
+    let _ = write!(out, "{{\"block\":{block},\"gas\":{gas_used},\"flush_us\":{},\"pre\":{:?},\"post\":{:?},\"marks\":{{", us(t_flush), g.pre, g.post);
+    for (k, (n, v)) in g.marks.iter().enumerate() {
+        let v = if n.ends_with("_n") { *v as i64 } else { us(*v) };
+        let _ = write!(out, "{}\"{n}\":{v}", if k > 0 { "," } else { "" });
+    }
+    out.push_str("},\"tx\":[");
+    for (i, x) in g.txs.iter().enumerate() {
+        let _ = write!(
+            out,
+            "{}[{i},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{}]",
+            if i > 0 { "," } else { "" },
+            x.status, us(x.dispatch), us(x.ws), us(x.we),
+            x.pw[0].0, x.pw[0].1 / 1000, x.pw[1].0, x.pw[1].1 / 1000, x.pw[2].0, x.pw[2].1 / 1000,
+            us(x.es), us(x.ee), x.lk[0], x.lk[1], x.lk[2], x.lk[3]
+        );
+        // EXP-210 (`pwru`): positions 17-20 of the record, only in blocks recorded with the switch; EXP-199 (Master 11-02):
+        // position 21, the run's wait for a core (us)
+        if b.ru {
+            out.pop();
+            let _ = write!(out, ",{},{},{},{},{}]", x.ru[0], x.ru[1], x.ru[2], x.ru[3], x.ru[4]);
+        }
+    }
+    out.push_str("],\"miss\":[");
+    for (k, (i, t, a, key, _, _)) in g.misses.iter().enumerate() {
+        let (cls, dt) = match CC_TAGS.storage(*a, *key).as_ref() {
+            None => (0, 0i64),
+            Some(&(src, ti)) if ti > *t => (if src == CC_SRC_PREWARM { 1 } else { 2 }, (ti - t) as i64 / 1000),
+            Some(&(_, ti)) => (3, -((t - ti) as i64) / 1000),
+        };
+        let i = if *i == DIAG_PRE { -1 } else if *i == DIAG_POST { -2 } else { *i as i64 };
+        let _ = write!(out, "{}[{i},{},{cls},{dt}]", if k > 0 { "," } else { "" }, us(*t));
+    }
+    out.push(']');
+    // EXP-019: nanosecond records with keys, sources and frames
+    let ns = |t: u64| -> i64 { if t == 0 { -1 } else { t as i64 - b.t0 as i64 } };
+    let fr = |f: u32| -> i64 { if f == u32::MAX { -1 } else { f as i64 } };
+    let txi = |i: u32| -> i64 { if i == DIAG_PRE { -1 } else if i == DIAG_POST { -2 } else { i as i64 } };
+    out.push_str(",\"miss2\":[");
+    for (k, (i, t, a, key, dur, f)) in g.misses.iter().enumerate() {
+        let (cls, src, dt) = match CC_TAGS.storage(*a, *key).as_ref() {
+            None => (0, 0, 0i64),
+            Some(&(src, ti)) if ti > *t => (if src == CC_SRC_PREWARM { 1 } else { 2 }, src, (ti - t) as i64),
+            Some(&(src, ti)) => (3, src, -((t - ti) as i64)),
+        };
+        let _ = write!(out, "{}[{},{},{cls},{src},{dt},\"{a}\",\"{key}\",{dur},{}]", if k > 0 { "," } else { "" }, txi(*i), ns(*t), fr(*f));
+    }
+    out.push_str("],\"other\":[");
+    for (k, (i, t, kind, id, dur, f)) in g.other.iter().enumerate() {
+        let _ = write!(out, "{}[{},{},{kind},\"{id}\",{dur},{}]", if k > 0 { "," } else { "" }, txi(*i), ns(*t), fr(*f));
+    }
+    out.push_str("],\"events\":[");
+    for (k, (n, t)) in g.events.iter().enumerate() {
+        let _ = write!(out, "{}[\"{n}\",{}]", if k > 0 { "," } else { "" }, ns(*t));
+    }
+    out.push_str("],\"frames\":[");
+    for (k, r) in g.frames.iter().enumerate() {
+        let _ = write!(
+            out,
+            "{}[{},{},{},{},{},{},{},{},\"{}\",\"{}\",\"{}\",\"{:x}\",\"{}\"]",
+            if k > 0 { "," } else { "" },
+            r.role, r.tx, r.seq, fr(r.parent), r.depth, r.kind, ns(r.ts), ns(r.te),
+            r.code, r.target, r.caller, r.value, alloy_primitives::hex::encode(&r.input)
+        );
+    }
+    out.push_str("]}\n");
+    use std::io::Write as _;
+    if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+        let _ = f.write_all(out.as_bytes());
+    }
+}
