+impl<Tx> EwJob<Tx> {
+    /// `ewredo`: run `n` (from 1) of the redo runs of transaction `index`, whose first run had `heavy` and `prio`,
+    /// queued by `place` (`ewredoq`): 0 a first redo ahead of all other work, later redos (only without a cap,
+    /// `EWB_REDO`) in block order like first runs, so a hot slot written by many transactions cannot starve them; 1 as
+    /// 0 but behind every first run; 2 at its first run's place.
+    fn redo(index: usize, tx: Tx, n: u32, place: u32, heavy: bool, prio: u64) -> Self {
+        let (heavy, prio) = match place {
+            2 => (heavy, prio),
+            _ if n <= 1 => (true, u64::MAX),
+            _ => (false, 0),
