+        let mut moved = HashMap::new();
+        assert_eq!(ec_sweep(tids.clone(), &[c], &[tids[2]], &full, &mut moved), (3, 3), "the kept thread is not looked at");
+        assert!(!on_c(tids[0]) && !on_c(tids[1]) && on_c(tids[2]) && !on_c(tids[3]));
+        assert!(eq(&aff(tids[3]), &full_less_c), "a thread with the core alone goes to the full set less the core");
+        assert_eq!(ec_sweep(tids.clone(), &[c], &[tids[2]], &full, &mut moved).0, 0, "nothing left to move");
+        // with three CPUs or more, thread 1 changes its own set to another set without the core: the restore leaves it
+        let own = (cpus.len() >= 3).then(|| set(&[cpus[2]]));
+        if let Some(o) = &own {
+            assert!(set_thread_affinity(tids[1], o));
+        }
+        assert_eq!(ec_restore(&mut moved), if own.is_some() { 2 } else { 3 });
+        assert!(moved.is_empty());
+        assert!(eq(&aff(tids[0]), &full), "set given back");
+        assert!(eq(&aff(tids[3]), &full), "a thread that had the core alone gets the full set");
+        match &own {
+            Some(o) => assert!(eq(&aff(tids[1]), o), "own set kept"),
+            None => assert!(eq(&aff(tids[1]), &full)),
+        }
+        drop(gate);
+        for h in hs {
+            h.join().unwrap();
+        }
+    }
