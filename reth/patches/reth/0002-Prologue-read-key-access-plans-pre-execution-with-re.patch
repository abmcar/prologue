+#[cfg(test)]
+mod slot_read_hook_tests {
+    use super::*;
+    use reth_provider::test_utils::MockEthProvider;
+    use reth_storage_api::StateProvider;
+    use std::cell::RefCell;
+
+    thread_local! {
+        static SEEN: RefCell<Vec<(Address, StorageKey)>> = const { RefCell::new(Vec::new()) };
+    }
+
+    fn note(a: Address, k: StorageKey) {
+        SEEN.with(|s| s.borrow_mut().push((a, k)));
+    }
+
+    /// Prologue (`ixpf`): a thread's storage-read hook sees each storage read through a cache-filling or lookup-only
+    /// provider on that thread, cache hits included; not account or code reads, not another thread's reads and nothing
+    /// once it is cleared.
+    #[test]
+    fn slot_read_hook_sees_this_threads_storage_reads() {
+        let caches = ExecutionCache::new(1000);
+        let provider = MockEthProvider::default();
+        let prewarm = CachedStateProvider::new_prewarm(provider.clone().into_evm_state_provider(), caches.clone());
+        let lookup = CachedStateProvider::new(provider.clone().into_evm_state_provider(), caches.clone(), None);
+        let a = Address::repeat_byte(1);
+        let (k1, k2) = (StorageKey::repeat_byte(2), StorageKey::repeat_byte(3));
+        caches.insert_storage(a, k2, Some(U256::from(7)));
+        set_slot_read_hook(Some(note));
+        // a miss read from the backend, then a hit, then a hit of the lookup-only provider
+        prewarm.storage(a, k1).unwrap();
+        prewarm.storage(a, k1).unwrap();
+        lookup.storage(a, k2).unwrap();
+        prewarm.basic_account(&a).unwrap();
+        lookup.bytecode_by_hash(&B256::repeat_byte(4)).unwrap();
+        std::thread::spawn(move || {
+            CachedStateProvider::new_prewarm(provider.into_evm_state_provider(), caches).storage(a, k2).unwrap();
+        })
+        .join()
+        .unwrap();
+        set_slot_read_hook(None);
+        prewarm.storage(a, k2).unwrap();
+        assert_eq!(SEEN.with(|s| s.take()), vec![(a, k1), (a, k1), (a, k2)]);
+    }
+}
