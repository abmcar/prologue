+/// Ends the speculative run and returns the keys it wanted.
+pub fn cc_discover_end() -> Vec<(Address, StorageKey)> {
+    DIAG_PW_SUPPRESS.with(|c| c.set(false));
+    CC_DISCOVER.with(|d| d.borrow_mut().take()).unwrap_or_default()
