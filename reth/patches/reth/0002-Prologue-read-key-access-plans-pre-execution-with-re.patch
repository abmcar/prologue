+/// EXP-129 third segment: waits until the readers have put `keys` into the execution cache, at most `max_ns`;
+/// returns the number still missing.
+pub fn nb_wait_keys(caches: &reth_execution_cache::ExecutionCache, keys: &[(Address, U256)], max_ns: u64) -> usize {
+    let t0 = Instant::now();
+    let mut pending: Vec<(Address, B256)> = keys.iter().map(|(a, k)| (*a, B256::from(*k))).collect();
+    loop {
+        pending.retain(|(a, k)| caches.peek_storage(*a, *k).is_none());
+        if pending.is_empty() || t0.elapsed().as_nanos() as u64 >= max_ns {
+            break
+        }
+        std::thread::sleep(std::time::Duration::from_micros(5));
+    }
+    if let Some(stats) = PW_STATS.lock().clone() {
+        stats.nb_lvlwait_ns.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+    }
+    pending.len()
+}
+
+/// EXP-199 round 3 (`EWB_NBSTOP`): as [`nb_wait_keys`] without a time limit: waits until the keys are in the cache or
+/// `done()` (the execution thread has passed the transaction, or the block has ended).
+pub fn nb_wait_keys_until(caches: &reth_execution_cache::ExecutionCache, keys: &[(Address, U256)], done: &dyn Fn() -> bool) -> usize {
+    let t0 = Instant::now();
+    let mut pending: Vec<(Address, B256)> = keys.iter().map(|(a, k)| (*a, B256::from(*k))).collect();
+    loop {
+        pending.retain(|(a, k)| caches.peek_storage(*a, *k).is_none());
+        if pending.is_empty() || done() {
+            break
+        }
+        std::thread::sleep(std::time::Duration::from_micros(5));
+    }
+    if let Some(stats) = PW_STATS.lock().clone() {
+        stats.nb_lvlwait_ns.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+    }
+    pending.len()
+}
+
+/// EXP-129 third segment: counts a pass beyond the first level of a transaction.
+pub fn nb_count_level() {
+    if let Some(stats) = PW_STATS.lock().clone() {
+        stats.nb_levels.fetch_add(1, Ordering::Relaxed);
+    }
+}
