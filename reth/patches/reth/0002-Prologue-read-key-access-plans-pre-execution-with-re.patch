+    fn split_heavy_only_to_waiting_reserved() {
+        let q = Arc::new(EwQueue::<()>::with_split(true));
+        // no reserved worker waits: the heavy job joins the block-order queue
+        q.push(job(true, 7));
+        q.push(job(false, 3));
+        assert_eq!(q.pop(false).map(|j| j.index), Some(3));
+        assert_eq!(q.pop(false).map(|j| j.index), Some(7));
+        // a reserved worker waits: the next heavy job is handed to it, a light one is not
+        let q2 = q.clone();
+        let h = std::thread::spawn(move || q2.pop(true).map(|j| j.index));
+        while q.inner.lock().waiting_res == 0 {
+            std::thread::yield_now();
+        }
+        q.push(job(true, 9));
+        q.push(job(false, 1));
+        // the other workers take the block-order job, never the heavy one handed to the reserved worker
+        assert_eq!(q.pop(false).map(|j| j.index), Some(1));
+        assert_eq!(h.join().unwrap(), Some(9));
+        // after the close a reserved worker takes the block-order queue
+        q.push(job(false, 2));
