+            unsafe {
+                let mut ru: libc::rusage = core::mem::zeroed();
+                if libc::getrusage(libc::RUSAGE_THREAD, &mut ru) == 0 {
+                    return ru.ru_majflt.max(0) as u64
+                }
+            }
+        }
+        0
+    }
+
+    /// A proof job of the block finished: dispatched, started and ended at these instants, with
+    /// `majflt` major page faults on its worker thread.
+    pub(super) fn record(dispatched: Instant, start: Instant, end: Instant, majflt: u64, account: bool) {
+        let d = ns(dispatched);
+        if d < BLOCK_NS.load(Ordering::Relaxed) {
+            return
+        }
+        record_into(&STATS, MARK_NS.load(Ordering::Acquire), d, ns(start), ns(end), majflt, account);
+    }
+
+    /// Adds a job dispatched at `d`, started at `s` and ended at `e` (ns) to `stats`, split by the
+    /// finish marker at `m` (`u64::MAX`: not received yet).
+    pub(super) fn record_into(
+        stats: &[AtomicU64; N],
+        m: u64,
+        d: u64,
+        s: u64,
+        e: u64,
+        majflt: u64,
+        account: bool,
+    ) {
+        let add = |i: usize, v: u64| {
+            stats[i].fetch_add(v, Ordering::Relaxed);
+        };
+        add(JOBS, 1);
+        add(QUEUE_NS, s.saturating_sub(d));
+        add(RUN_NS, e.saturating_sub(s));
+        add(MAJFLT, majflt);
+        if account {
+            add(ACC_JOBS, 1);
+        }
+        if m == u64::MAX || e <= m {
+            return
+        }
+        if d <= m {
+            if s <= m {
+                add(PRE_RUNNING, 1);
+                add(PRE_RUNNING_AFTER_NS, e - m);
+                add(PRE_RUNNING_FLT, majflt);
+            } else {
+                add(PRE_QUEUED, 1);
+                add(PRE_QUEUED_WAIT_NS, s - m);
+                add(PRE_QUEUED_RUN_NS, e.saturating_sub(s));
+                add(PRE_QUEUED_FLT, majflt);
+            }
+            stats[PRE_LAST_END_NS].fetch_max(e - m, Ordering::Relaxed);
+        } else {
+            add(POST, 1);
+            add(POST_QUEUE_NS, s.saturating_sub(d));
+            add(POST_RUN_NS, e.saturating_sub(s));
+            add(POST_FLT, majflt);
+            stats[POST_LAST_END_NS].fetch_max(e - m, Ordering::Relaxed);
+            stats[POST_FIRST_DISPATCH_NS].fetch_min(d - m, Ordering::Relaxed);
+        }
+    }
+}
