+/// EXP-199 (X-020): parameters of EAP's own prewarm mechanism for the current block, when it is on (`ew > 0`).
+#[derive(Debug, Clone, Copy)]
+pub struct EwParams {
+    /// worker threads
+    pub threads: u32,
+    /// workers reserved for heavy transactions until the dispatch ends
+    pub reserved: u32,
+    /// gas-limit threshold of a heavy transaction
+    pub heavy_gas: u64,
+    /// nice value of the other workers
+    pub nice: u32,
+    /// the workers read the block's earlier writes (`ewov`)
+    pub overlay: bool,
+    /// heavy transactions by gas limit, largest first (`ewsort`)
+    pub sort: bool,
+    /// order by the plans' predicted uncached slots, with this many joining the heavy class (`ewprio`, 0: off)
+    pub prio: u32,
+    /// redo runs per transaction (`ewredo` with `ewov`, 0: off)
+    pub redo: u32,
+    /// where a redo run is queued (`ewredoq`)
+    pub redo_q: u32,
+    /// `ewbud` bits
+    pub bud: u32,
+    /// `ewsplit`: reth's division of the workers
+    pub split: bool,
+    /// `ewpool`: the block's workers and helpers on persistent threads
+    pub pool: bool,
+    /// `ewlf` bit 1: the block's writes in lock-free tables
+    pub lf: bool,
+}
+
+/// `ewlf` bit (see [`Mode::ewlf`]): the block's prewarm writes in lock-free tables.
+pub const EWLF_WRITES: u32 = 1;
+/// `ewlf` bit: the in-flight table as per-thread announcement cells.
+pub const EWLF_INFLIGHT: u32 = 2;
+/// `ewlf` bit: the mode from a per-thread copy.
+pub const EWLF_MODE: u32 = 16;
+const EWLF_ALL: u32 = EWLF_WRITES | EWLF_INFLIGHT | EWLF_MODE;
+
+/// `ewfeed` bit (X-029, see [`Mode::ewfeed`]): targeted wake-ups of the own prewarm's workers.
+pub const EWF_WAKE: u32 = 1;
+/// `ewfeed` bit: each transaction of a recovery window goes to the prewarm channel when its own recovery ends.
+pub const EWF_STREAM: u32 = 2;
+/// `ewfeed` bit: recovery claimed one transaction at a time in block order, without windows.
+pub const EWF_ORDER: u32 = 4;
+/// `ewfeed` bit: the own prewarm's dispatch thread at the `exrt` priority.
+pub const EWF_RT: u32 = 8;
+/// `ewfeed` bit: the recovery threads at the `exrt` priority, off the execution thread's core, while they recover the
+/// first window and the `pwheavyfirst` picks.
+pub const EWF_RECRT: u32 = 16;
+/// `ewfeed` bit: the raising of `EWF_RECRT` for every window and every ordered claim.
+pub const EWF_RECRTALL: u32 = 32;
+const EWF_ALL: u32 = EWF_WAKE | EWF_STREAM | EWF_ORDER | EWF_RT | EWF_RECRT | EWF_RECRTALL;
+
+/// `ewbud` bit (see [`Mode::ewbud`]): dispatch order by the slack, the time until the execution thread reaches the
+/// transaction less the time its predicted backend reads take (smallest first; round 3 after the first comparison).
+pub const EWB_ORDER: u32 = 1;
+/// `ewbud` bit: first recoveries as many as the workers.
+pub const EWB_RECOVER: u32 = 2;
+/// `ewbud` bit: speculative pass for transactions that would be late, on counted idle cores.
+pub const EWB_NBENTRY: u32 = 4;
+/// `ewbud` bit: speculative passes until arrival or no new key.
+pub const EWB_NBSTOP: u32 = 8;
+/// `ewbud` bit: call-start plans while the execution thread has not reached the transaction.
+pub const EWB_PWK: u32 = 16;
+/// `ewbud` bit: extra readers by the readers' backlog.
+pub const EWB_RDGATE: u32 = 32;
+/// `ewbud` bit: per-block key budgets replaced by dropping work of passed transactions.
+pub const EWB_KEYS: u32 = 64;
+/// `ewbud` bit: a follow job's calls spread over all readers.
+pub const EWB_SPREAD: u32 = 128;
+/// `ewbud` bit: worker threads = the execution thread's cores at the block's start less one (`ew` not used).
+pub const EWB_THREADS: u32 = 256;
+/// `ewbud` bit: speculative-pass helpers in the idle scheduling class (they run only on otherwise idle cores). Not used in
+/// the runs (review of c3bbbb0): a starved idle-class helper keeps its clone of the saved cache past the block's end, and
+/// the next block then finds the cache in use and starts empty.
+pub const EWB_IDLE: u32 = 512;
+/// `ewbud` bit: redo runs of a transaction until the execution thread arrives (`ewredo` not used as a cap).
+pub const EWB_REDO: u32 = 1024;
+/// `ewbud` bit: call records followed one more level while the level issued new keys (`ctd` not used; at most
+/// `CT_DEPTH_GUARD` levels, a stack guard).
+pub const EWB_CTD: u32 = 2048;
+/// `EWB_CTD`: recursion guard of the call-record follow (an implementation constant: each level needs new keys, and
+/// keys are issued once per block, so the depth is bounded by the block's keys; this only protects the stack).
+const CT_DEPTH_GUARD: u32 = 64;
+
+/// EXP-199 round 3 (`EWB_IDLE`): moves the calling thread into the idle scheduling class (SCHED_IDLE), which runs it only
+/// when a core has nothing else to run; its nice value is left as set (it does not matter in that class).
+pub fn set_own_idle() {
+    let p = libc::sched_param { sched_priority: 0 };
+    // SAFETY: sched_setscheduler with pid 0 changes only the calling thread's policy on Linux. With the reset-on-fork flag:
+    // a thread raised by `ewnear` keeps it after going back, and an unprivileged change may not clear it.
+    unsafe {
+        libc::sched_setscheduler(0, libc::SCHED_IDLE | libc::SCHED_RESET_ON_FORK, &p);
+    }
+}
+
+/// Prologue (`rdidleio`): threads whose I/O priority was set to best-effort, and refused changes (record only, xbtl2
+/// `rdio_set`, `rdio_fail`, totals since the start).
+pub(crate) static RDIO: [AtomicU64; 2] = [AtomicU64::new(0), AtomicU64::new(0)];
+
+/// Prologue (`rdidleio`): the calling SCHED_IDLE thread's own I/O priority to best-effort level 4.
+pub(crate) fn rdidle_io() {
+    let i = usize::from(crate::tree::eap_ew::set_own_io_best_effort().is_err());
+    RDIO[i].fetch_add(1, Ordering::Relaxed);
+}
+
+/// EXP-199 round 3: the `ewbud` bits in force (only with the mechanism on).
+pub fn ew_bud() -> u32 {
+    let m = current();
+    if m.active && m.ew > 0 { m.ewbud } else { 0 }
+}
+
+/// X-029 (`ewfeed`): the block's `EWF_*` bits (0 when EAP is not active for the block).
+pub fn ew_feed() -> u32 {
+    let m = current();
+    if m.active { m.ewfeed } else { 0 }
+}
+
+/// EXP-199: EAP's own prewarm mechanism (`ew`), `None` when reth's prewarm pool runs instead.
+pub fn ew() -> Option<EwParams> {
+    let m = current();
+    let bud = if m.ew > 0 { m.ewbud } else { 0 };
+    (m.active && m.ew > 0).then_some(EwParams {
+        threads: if bud & EWB_THREADS != 0 { crate::tree::eap_ew::exec_cores().saturating_sub(1).max(1) as u32 } else { m.ew },
+        // `EWB_ORDER`: no heavy class, so no worker is reserved for it
+        reserved: if bud & EWB_ORDER != 0 { 0 } else { m.ewded.min(m.ew.saturating_sub(1)) },
+        heavy_gas: m.ewgas,
+        nice: m.ewnice,
+        overlay: m.ewov,
+        sort: m.ewsort,
+        prio: m.ewprio,
+        // `EWB_REDO`: no cap per transaction (the execution thread's arrival ends the redos)
+        redo: if !m.ewov { 0 } else if bud & EWB_REDO != 0 && m.ewredo > 0 { u32::MAX } else { m.ewredo },
+        redo_q: m.ewredoq,
+        bud,
+        split: m.ewsplit && bud & EWB_ORDER == 0,
+        pool: m.ewpool,
+        lf: m.ewlf & EWLF_WRITES != 0,
+    })
+}
+
+/// EXP-141 third segment: whether recovered transactions go to the prewarm dispatch as soon as each is recovered.
+pub fn pw_early_dispatch() -> bool {
+    let m = current();
+    m.active && m.prewarm && m.pwearlydisp
+}
+
+/// EXP-179 (`pwheavyfirst=k`): (k, minimum gas limit) when the block's sender recovery hands its k largest transactions
+/// to the prewarm dispatch first.
+pub fn pw_heavy_first() -> Option<(usize, u64)> {
+    let m = current();
+    // `EWB_RECOVER`: as many as the mechanism's workers can start at once, the largest gas limits, no minimum
+    if m.active && m.ew > 0 && m.ewbud & EWB_RECOVER != 0 {
+        let workers = if m.ewbud & EWB_THREADS != 0 { crate::tree::eap_ew::exec_cores().saturating_sub(1).max(1) } else { m.ew as usize };
+        return Some((workers, 0))
+    }
+    (m.active && (m.prewarm || m.ew > 0) && m.pwheavyfirst > 0).then_some((m.pwheavyfirst as usize, m.pwheavyfirstgas))
+}
+
+/// EXP-179: the gas limit of a raw transaction of the Ethereum node: the EIP-2718 encoding (`Bytes`, newPayload), or the
+/// engine's `Either<Bytes, TransactionSigned>` (`payload_validator.rs` `tx_iterator_for`: payload or block); `None` for
+/// any other raw type or a malformed encoding (the transaction then keeps its window).
+pub fn raw_gas_limit(raw: &dyn std::any::Any) -> Option<u64> {
+    use alloy_consensus::{transaction::Either, Transaction as _};
+    if let Some(b) = raw.downcast_ref::<alloy_primitives::Bytes>() {
+        return gas_limit_2718(b)
+    }
+    match raw.downcast_ref::<Either<alloy_primitives::Bytes, reth_ethereum_primitives::TransactionSigned>>()? {
+        Either::Left(b) => gas_limit_2718(b),
+        Either::Right(tx) => Some(tx.gas_limit()),
+    }
+}
+
+/// EXP-179: reads only the RLP headers up to the gas-limit field: legacy `[nonce, gasPrice, gasLimit, ..]`, type 1
+/// `[chainId, nonce, gasPrice, gasLimit, ..]`, types 2-4 `[chainId, nonce, maxPriorityFee, maxFee, gasLimit, ..]`.
+pub fn gas_limit_2718(b: &[u8]) -> Option<u64> {
+    // (payload start, payload length, is list) of the RLP item at the start of `b`
+    fn item(b: &[u8]) -> Option<(usize, usize, bool)> {
+        let p = *b.first()?;
+        let r = match p {
+            0x00..=0x7f => (0, 1, false),
+            0x80..=0xb7 => (1, (p - 0x80) as usize, false),
+            0xb8..=0xbf => {
+                let ll = (p - 0xb7) as usize;
+                let n = b.get(1..1 + ll)?.iter().fold(0usize, |a, &x| (a << 8) | x as usize);
+                (1 + ll, n, false)
+            }
+            0xc0..=0xf7 => (1, (p - 0xc0) as usize, true),
+            _ => {
+                let ll = (p - 0xf7) as usize;
+                let n = b.get(1..1 + ll)?.iter().fold(0usize, |a, &x| (a << 8) | x as usize);
+                (1 + ll, n, true)
+            }
+        };
+        (b.len() >= r.0 + r.1).then_some(r)
+    }
+    let (ty, body) = match *b.first()? {
+        t if t < 0x7f => (Some(t), &b[1..]),
+        _ => (None, b),
+    };
+    let skip = match ty {
+        None => 2,
+        Some(1) => 3,
+        Some(2..=4) => 4,
+        _ => return None,
+    };
+    let (s, n, list) = item(body)?;
+    if !list {
+        return None
+    }
+    let mut f = &body[s..s + n];
+    for _ in 0..skip {
+        let (s, n, _) = item(f)?;
+        f = &f[s + n..];
+    }
+    let (s, n, list) = item(f)?;
+    if list || n > 8 {
+        return None
+    }
+    Some(f[s..s + n].iter().fold(0u64, |a, &x| (a << 8) | x as u64))
+}
