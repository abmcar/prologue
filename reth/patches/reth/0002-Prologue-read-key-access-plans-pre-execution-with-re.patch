+thread_local! {
+    /// this thread's home cell + 1 (0: not assigned yet)
+    static INF_HOME: Cell<usize> = const { Cell::new(0) };
+    /// whether this thread is the execution thread (set at its blocks' start): the only one that waits on the cells
+    static INF_EXEC: Cell<bool> = const { Cell::new(false) };
+}
