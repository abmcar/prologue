+/// EXP-210 (`ewlf` bit 2): one cache line per cell; a filling thread announces the 64-bit fingerprint of the slot it is
+/// reading in its own cell (it has at most one read in flight), so announcing and withdrawing write no line another
+/// thread writes. More threads than cells share cells by probing from their home cell.
+#[repr(align(64))]
+struct InfCell(AtomicU64);
+
+const INF_NCELLS: usize = 64;
+static INF_CELLS: [InfCell; INF_NCELLS] = [const { InfCell(AtomicU64::new(0)) }; INF_NCELLS];
+static INF_NEXT_HOME: AtomicUsize = AtomicUsize::new(0);
+/// The fingerprint the waiting execution thread waits for (0: none), and that thread.
+static INF_WAIT_FP: AtomicU64 = AtomicU64::new(0);
+static INF_WAITER: parking_lot::Mutex<Option<std::thread::Thread>> = parking_lot::const_mutex(None);
