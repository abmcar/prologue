+    /// X-027: the record from evm2's detached state: changed slots, the nonce and balance of an account whose code did
+    /// not change (an absent account counts as empty), nothing of the beneficiary, of an account whose code changed,
+    /// or of a loaded-only (untouched) account.
+    #[test]
+    fn record_from_pending_state() {
+        use evm2::evm::{AccountInfo, PendingState};
+        let (c, eoa, newbie, beneficiary, deployed) =
+            (Address::repeat_byte(0xc1), Address::repeat_byte(1), Address::repeat_byte(2), Address::repeat_byte(0xbe), Address::repeat_byte(3));
+        let code_hash = B256::repeat_byte(0xcc);
+        let info = |nonce: u64, balance: u64| AccountInfo { nonce, balance: U256::from(balance), ..Default::default() };
+        let mut st = PendingState::default();
+        st.insert_account(c, Some(AccountInfo { code_hash, code: None, ..info(1, 0) }), Some(AccountInfo { code_hash, code: None, ..info(1, 0) }));
+        st.insert_storage(c, U256::from(1), U256::from(5), U256::from(6));
+        st.insert_storage(c, U256::from(2), U256::from(7), U256::from(7));
+        st.insert_account(eoa, Some(info(3, 100)), Some(info(4, 90)));
+        st.insert_account(newbie, None, Some(info(0, 5)));
+        st.insert_account(beneficiary, Some(info(0, 1)), Some(info(0, 2)));
+        st.insert_account(deployed, None, Some(AccountInfo { code_hash, code: None, ..info(1, 0) }));
+        // `insert_account` does not mark accounts touched; the record needs the flag as evm2 sets it in execution, so
+        // the selection is checked on the lists directly with every account counted as touched ...
+        let all = st.account_changes().map(|mut a| {
+            a.touched = true;
+            a
+        });
+        let (mut slots, mut accounts) = changed_lists(all, beneficiary);
+        slots.sort();
+        accounts.sort_by_key(|(a, _)| *a);
+        assert_eq!(slots, vec![((c, B256::from(U256::from(1))), U256::from(6))]);
+        assert_eq!(
+            accounts,
+            vec![
+                (eoa, Account { nonce: 4, balance: U256::from(90), bytecode_hash: None, ..Default::default() }),
+                (newbie, Account { nonce: 0, balance: U256::from(5), bytecode_hash: None, ..Default::default() }),
+            ]
+        );
+        // ... and an untouched account is never recorded
+        let (s, a) = changed_lists(st.account_changes(), beneficiary);
+        assert!(s.is_empty() && a.is_empty());
+    }
