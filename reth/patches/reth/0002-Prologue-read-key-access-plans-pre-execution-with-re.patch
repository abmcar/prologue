+    /// `ewpool`: a job's captures are dropped before the latch lets the waiter go; idle threads are reused, a busy pool
+    /// grows; a panicking job is counted out and its thread ends; a pool's threads keep its nice value
+    #[test]
+    fn pool_reuses_threads_and_waits_for_drops() {
+        struct Slow(Arc<AtomicUsize>);
+        impl Drop for Slow {
+            fn drop(&mut self) {
+                std::thread::sleep(std::time::Duration::from_millis(5));
+                self.0.fetch_add(1, Ordering::SeqCst);
+            }
+        }
+        let pool_of = |name: &str| POOLS.lock().iter().find(|p| p.name == name).cloned();
+        let wait_idle = |name: &str, n: usize| {
+            let t = std::time::Instant::now();
+            while pool_of(name).map_or(0, |p| p.idle.load(Ordering::Acquire)) < n {
+                assert!(t.elapsed().as_secs() < 10, "pool threads did not become idle");
+                std::thread::yield_now();
+            }
+        };
+        let names = Arc::new(Mutex::new(std::collections::HashSet::new()));
+        let dropped = Arc::new(AtomicUsize::new(0));
+        // the jobs of a round all wait at a gate until every one of them is submitted, so they run at once whatever
+        // the load on the machine
+        let run_round = |k: usize| {
+            let latch = Arc::new(EwLatch::default());
+            let (gate, gate_rx) = crossbeam_channel::bounded::<()>(0);
+            for _ in 0..k {
+                let (d, n, g) = (Slow(dropped.clone()), names.clone(), gate_rx.clone());
+                assert!(pool_spawn(
+                    "ewp-test",
+                    0,
+                    false,
+                    Some(latch.clone()),
+                    Box::new(move || {
+                        let _d = d;
+                        n.lock().insert(std::thread::current().name().unwrap_or("").to_string());
+                        let _ = g.recv();
+                    })
+                ));
+            }
+            drop(gate);
+            latch.wait();
+        };
+        run_round(3);
+        assert_eq!(dropped.load(Ordering::SeqCst), 3, "captures dropped before the latch opened");
+        assert_eq!(names.lock().len(), 3, "three jobs at once on three threads");
+        // idle again before the latch opens
+        assert_eq!(pool_of("ewp-test").map(|p| p.idle.load(Ordering::Acquire)), Some(3));
+        run_round(3);
+        assert_eq!(dropped.load(Ordering::SeqCst), 6);
+        assert_eq!(names.lock().len(), 3, "the idle threads were reused");
+        run_round(4);
+        assert_eq!(names.lock().len(), 4, "one more thread for the fourth concurrent job");
+        // a panicking job is counted out; its thread ends and is not counted idle
+        assert_eq!(pool_of("ewp-test").map(|p| p.idle.load(Ordering::Acquire)), Some(4));
+        let latch = Arc::new(EwLatch::default());
+        assert!(pool_spawn("ewp-test", 0, false, Some(latch.clone()), Box::new(|| panic!("test panic"))));
+        latch.wait();
+        wait_idle("ewp-test", 3);
+        assert_eq!(pool_of("ewp-test").map(|p| p.idle.load(Ordering::Acquire)), Some(3));
+        // a pool's threads have its nice value (or the test's, if that is higher: it cannot be lowered)
+        let base = crate::tree::eap::own_nice();
+        let (tx, rx) = crossbeam_channel::bounded(1);
+        assert!(pool_spawn("ewp-nice", 5, false, None, Box::new(move || {
+            let _ = tx.send(crate::tree::eap::own_nice());
+        })));
+        assert_eq!(rx.recv().ok(), Some(base.max(5)));
+    }
