+        let cd = batch_cd(S, 3, 0);
+        let (k_on, c_on, _, _) = run(&p, &cd, false);
+        let fr = frame(&cd);
+        let mut sc = Scratch::default(); sc.interval = true; sc.no_cons = true;
+        sc.instantiate(&p, &fr);
+        let k_off = sc.out.clone();
+        sc.instantiate_calls(&p, &fr, true);
+        let c_off = sc.calls.clone();
+        let w3 = U256::from(3u8);
+        assert!(!k_on.contains(&w3) && k_off.contains(&w3), "index-free key CD(4): with checks {k_on:?}, without {k_off:?}");
+        assert_eq!(k_off.len(), k_on.len() + 1);
+        assert_eq!(c_off.len(), c_on.len() + 1);
+        for k in 0..3 { assert!(k_on.contains(&addr(k)) && k_off.contains(&addr(k)), "family key {k}"); }
+        assert_eq!(c_on.iter().filter(|c| c.target == addr(0) || c.target == addr(1) || c.target == addr(2)).count(), 3);
+    }
