+    /// A worker state of its own (block counts, slot channel) with `ixpf=n`.
+    fn state(n: u32) -> (IxState, Receiver<Item>, &'static IxBlock) {
+        let blk: &'static IxBlock = Box::leak(Box::new(IxBlock::new()));
+        let (tx, rx) = crossbeam_channel::unbounded();
