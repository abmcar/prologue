+// ---- EXP-235 (`plrec`, `pl`): the execution thread's reads of a block, recorded and handed back to the readers ----
+//
+// With `plrec=1` and `EAP_PLREC=<file>`, the execution thread records every account, storage slot and code it asks the
+// cache layer for during its block (hits and misses; reads the EVM serves from its own in-block state never get here),
+// each key once in the order of its first read, and appends the list to the file at the block's end ([`pl_line`]).
+// With `pl=1` and `EAP_PL=<file>` the engine hands a block's list to the readers at the block's start (`eap.rs`).
+
+/// EXP-235: a key of a block's read list.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum PlKey {
+    /// An account, by address.
+    Account(Address),
+    /// A storage slot, by address and slot.
+    Storage(Address, StorageKey),
+    /// A code, by code hash.
+    Code(B256),
+}
+
+/// EXP-235 (`plrec`): the keys the execution thread read in its block so far, each once, in first-read order.
+#[derive(Debug, Default)]
+struct PlRecord {
+    seen: alloy_primitives::map::HashSet<PlKey>,
+    keys: Vec<PlKey>,
+}
+
+impl PlRecord {
+    fn note(&mut self, key: PlKey) {
+        if self.seen.insert(key) {
+            self.keys.push(key);
+        }
+    }
+
+    fn clear(&mut self) {
+        self.seen.clear();
+        self.keys.clear();
+    }
+}
+
+/// EXP-235 (`plrec`): the file named by `EAP_PLREC`.
+static PLREC_PATH: LazyLock<Option<std::path::PathBuf>> =
+    LazyLock::new(|| std::env::var_os("EAP_PLREC").map(Into::into));
+/// EXP-235 (`plrec`): whether the execution thread records its reads of the block (set per block, only with a file).
+static PLREC_ON: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+thread_local! {
+    /// EXP-235 (`plrec`): set on the execution thread at its block's start when the block records its reads, cleared
+    /// when the record is taken at the block's end.
+    static PLREC_EXEC: Cell<bool> = const { Cell::new(false) };
+    /// EXP-235 (`plrec`): the execution thread's record of the block.
+    static PLREC: std::cell::RefCell<PlRecord> = std::cell::RefCell::new(PlRecord::default());
+}
+
+/// EXP-235 (`plrec`): turns the recording of the execution thread's reads on or off (set per block); without
+/// `EAP_PLREC` it stays off.
+pub fn plrec_enable(on: bool) {
+    PLREC_ON.store(on && PLREC_PATH.is_some(), Ordering::Relaxed);
+}
+
+/// EXP-235 (`plrec`): a read through the cache layer (before any early return); recorded on the execution thread only.
+#[inline]
+fn plrec_note(key: PlKey) {
+    if PLREC_EXEC.with(|c| c.get()) {
+        PLREC.with(|r| r.borrow_mut().note(key));
+    }
+}
+
+/// EXP-235 (`plrec`): the calling thread's record of its block, `None` when it did not record; stops the recording.
+fn plrec_take() -> Option<Vec<PlKey>> {
+    PLREC_EXEC.with(|c| c.replace(false)).then(|| {
+        PLREC.with(|r| {
+            let mut r = r.borrow_mut();
+            r.seen.clear();
+            std::mem::take(&mut r.keys)
+        })
+    })
+}
+
+/// EXP-235 (`plrec`): execution thread, after its block's execution (also when it failed): stops the recording and,
+/// when the block recorded and `write` is set (the execution succeeded), appends the block's line to `EAP_PLREC`.
+pub fn plrec_block_end(block: u64, write: bool) {
+    let Some(keys) = plrec_take() else { return };
+    if write && let Some(path) = PLREC_PATH.as_ref() {
+        pl_append(path, block, &keys);
+    }
+}
+
+fn pl_append(path: &std::path::Path, block: u64, keys: &[PlKey]) {
+    let line = pl_line(block, keys);
+    let r = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(path)
+        .and_then(|mut f| std::io::Write::write_all(&mut f, line.as_bytes()));
+    if let Err(err) = r {
+        error!(target: "reth::eap", %err, block, "cannot append to EAP_PLREC");
+    }
+}
+
+/// EXP-235: a block's read list as one line of an `EAP_PLREC` / `EAP_PL` file, newline included: the block number, then
+/// the keys in first-read order, each after one space: `a:<address>` for an account, `s:<address>:<slot>` for a storage
+/// slot, `c:<code hash>` for a code, in lowercase hex without `0x` (40, 40 and 64, and 64 digits). Example (hex
+/// shortened): `21000000 a:9522..afe5 s:c02a..6cc2:0000..0003 c:1f3b..9c0d`.
+pub fn pl_line(block: u64, keys: &[PlKey]) -> String {
+    let mut out = String::with_capacity(24 + keys.len() * 110);
+    out.push_str(&block.to_string());
+    for k in keys {
+        match k {
+            PlKey::Account(a) => {
+                out.push_str(" a:");
+                out.push_str(&alloy_primitives::hex::encode(a));
+            }
+            PlKey::Storage(a, slot) => {
+                out.push_str(" s:");
+                out.push_str(&alloy_primitives::hex::encode(a));
+                out.push(':');
+                out.push_str(&alloy_primitives::hex::encode(slot));
+            }
+            PlKey::Code(h) => {
+                out.push_str(" c:");
+                out.push_str(&alloy_primitives::hex::encode(h));
+            }
+        }
+    }
+    out.push('\n');
+    out
+}
+
+/// EXP-235: parses a line written by [`pl_line`] (the newline is optional); `None` when the line is malformed.
+pub fn pl_parse_line(line: &str) -> Option<(u64, Vec<PlKey>)> {
+    let mut toks = line.split_ascii_whitespace();
+    let block = toks.next()?.parse().ok()?;
+    let keys = toks
+        .map(|t| match t.split_once(':')? {
+            ("a", a) => a.parse().ok().map(PlKey::Account),
+            ("s", rest) => {
+                let (a, slot) = rest.split_once(':')?;
+                Some(PlKey::Storage(a.parse().ok()?, slot.parse().ok()?))
+            }
+            ("c", h) => h.parse().ok().map(PlKey::Code),
+            _ => None,
+        })
+        .collect::<Option<Vec<_>>>()?;
+    Some((block, keys))
+}
+
+#[cfg(test)]
+mod accflt_invalidate_tests {
+    use super::*;
+
+    /// EXP-232 (account filter off): a cached "absent" answer and a storage value are dropped; a fill by a provider
+    /// built before is dropped, one for the new generation lands; every cache made by `new` is registered for
+    /// `invalidate_all_execution_caches` (not called here: it would clear the caches of tests running alongside).
+    #[test]
+    fn invalidate_state_drops_cached_state_and_earlier_fills() {
+        let caches = ExecutionCache::new(1000);
+        let (a, k) = (Address::repeat_byte(9), StorageKey::repeat_byte(5));
+        let generation = caches.generation();
+        assert!(caches.fill_account(generation, a, None));
+        caches.insert_storage(a, k, Some(U256::from(1)));
+        assert_eq!(caches.peek_account(&a), Some(None));
+        caches.invalidate_state();
+        assert_eq!(caches.peek_account(&a), None);
+        assert_eq!(caches.peek_storage(a, k), None);
+        assert!(!caches.fill_account(generation, a, None));
+        assert_eq!(caches.peek_account(&a), None);
+        assert!(caches.fill_account(caches.generation(), a, Some(Account::default())));
+        assert_eq!(caches.peek_account(&a), Some(Some(Account::default())));
+        assert!(LIVE_CACHES.lock().iter().any(|w| w.upgrade().is_some_and(|c| Arc::ptr_eq(&c, &caches.0))));
+    }
