+    /// X-027 (required by the coordinator): a worker's EVM over [`EwOverlay`] (evm2, EthEvmConfig, nonce and balance
+    /// checks off as in prewarm). Transaction `i` reads the latest write of an earlier transaction recorded so far,
+    /// never its own and never a later one's; with [`fresh_reads`] before every transaction, a second transaction on the
+    /// same EVM does not see the values evm2 cached for the previous one; without it, it does (the hazard the call
+    /// prevents).
+    #[test]
+    fn overlay_reads_earlier_writes_and_fresh_reads_drop_evm_cache() {
+        use alloy_consensus::{transaction::Recovered, TxLegacy};
+        use alloy_primitives::{Bytes, Signature, TxKind};
+        use evm2::{EvmFeatures, SpecId};
+        use reth_ethereum_primitives::{Transaction, TransactionSigned};
+        use reth_evm::{ConfigureEvm, Evm};
+        use reth_evm_ethereum::{EthEvmConfig, EthEvmEnv};
+
+        // SSTORE(0, SLOAD(0) + CALLDATALOAD(0))
+        let (c, beneficiary) = (Address::repeat_byte(0xc1), Address::repeat_byte(0xbe));
+        let code = Bytecode::new_raw(Bytes::from_static(&[0x5f, 0x35, 0x5f, 0x54, 0x01, 0x5f, 0x55, 0x00]));
+        let code_hash = code.0.hash_slow();
+        let mut mem = MemProvider::default();
+        mem.accounts.insert(c, Account { nonce: 1, balance: U256::ZERO, bytecode_hash: Some(code_hash), ..Default::default() });
+        mem.code.insert(code_hash, code);
+        mem.storage.insert((c, B256::ZERO), U256::from(5));
+        for i in 1..=3u8 {
+            mem.accounts.insert(Address::repeat_byte(i), Account { balance: U256::from(10u64.pow(18)), ..Default::default() });
+        }
+        let writes = Arc::new(EwWrites::new(false));
+        let overlay = EwOverlay::new(Box::new(mem), writes.clone());
+        let mut env = EthEvmEnv::new(
+            SpecId::CANCUN,
+            evm2::env::BlockEnv::<evm2::BaseEvmTypes> {
+                number: U256::from(1),
+                beneficiary,
+                basefee: U256::ONE,
+                gas_limit: U256::from(30_000_000),
+                ..Default::default()
+            },
+            1,
+        );
+        env.version.features.remove(EvmFeatures::NONCE_CHECK | EvmFeatures::BALANCE_CHECK);
+        let config = EthEvmConfig::mainnet();
+        let mut evm = config.evm_with_env(reth_evm::database::StateProviderDatabase::new(overlay), env);
+        let tx = |from: u8, add: u64| {
+            let t = Transaction::Legacy(TxLegacy {
+                chain_id: Some(1),
+                nonce: 0,
+                gas_price: 2,
+                gas_limit: 100_000,
+                to: TxKind::Call(c),
+                value: U256::ZERO,
+                input: Bytes::from(B256::from(U256::from(add)).to_vec()),
+            });
+            config.tx_env(Recovered::new_unchecked(TransactionSigned::new_unhashed(t, Signature::test_signature()), Address::repeat_byte(from)))
+        };
+        // runs transaction `i` (adding `add`) as a worker does, records its writes; (value read, value written)
+        let mut run = |i: usize, add: u64, fresh: bool| {
+            crate::tree::eap::pw_set_tx(i);
+            if fresh {
+                fresh_reads(&mut evm);
+            }
+            run_begin();
+            let res = Evm::transact(&mut evm, &tx((i % 3) as u8 + 1, add)).expect("transact");
+            let slot = res.pending_state.account_changes_for(&c).expect("contract loaded").storage.slots[&U256::ZERO].value;
+            writes.record(i as u32, 1, &res.pending_state, beneficiary).expect("record");
+            crate::tree::eap::pw_set_tx(u32::MAX as usize);
+            (slot.original, slot.current, run_used_writes())
+        };
+        let u = U256::from;
+        assert_eq!(run(0, 1, true), (u(5), u(6), false), "parent state");
+        assert_eq!(run(2, 100, true), (u(6), u(106), true), "transaction 0's write");
+        assert_eq!(run(1, 10, true), (u(6), u(16), true), "transaction 0's write, not the later transaction 2's");
+        assert_eq!(run(2, 100, true), (u(16), u(116), true), "transaction 1's write, not its own");
+        assert_eq!(run(0, 1, true), (u(5), u(6), false), "never a later transaction's write");
+        assert_eq!(writes.slot_before(c, B256::ZERO, 3), Some(u(116)));
+        // without emptying evm2's cache, transaction 3 sees what transaction 0 read before (the parent value), not
+        // the latest earlier write (116)
+        assert_eq!(run(3, 1000, false).0, u(5), "evm2 keeps reads across transactions");
+        assert_eq!(run(3, 1000, true).0, u(116));
+    }
