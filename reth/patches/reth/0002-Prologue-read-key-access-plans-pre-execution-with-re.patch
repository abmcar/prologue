+/// EXP-169: this thread's cache-filling reads since the last call, (count, ns) for accounts, storage slots and code;
+/// resets them.
+pub fn cc_fill_take() -> [(u64, u64); 3] {
+    DIAG_FILL.with(|c| c.replace([(0, 0); 3]))
+}
