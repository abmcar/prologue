+        ("post_acc_sys", v[tl::POST_ACC_SYS]),
+        ("post_sto_hinted", v[tl::POST_STO_HINTED]),
+        ("post_sto_unhinted", v[tl::POST_STO_UNHINTED]),
+        ("post_sto_sys", v[tl::POST_STO_SYS]),
+        // Prologue (EXP-258): the sparse-trie task after the streaming phase
+        ("tail_wait_us", us(tl::TAIL_WAIT_NS)),
+        ("tail_work_us", us(tl::TAIL_WORK_NS)),
+        ("tail_promote_us", us(tl::TAIL_PROMOTE_NS)),
+        ("tail_rounds", v[tl::TAIL_ROUNDS]),
+        ("tail_root_us", us(tl::TAIL_ROOT_NS)),
+        ("srbatch_runs", v[tl::SRBATCH_RUNS]),
+    ] {
+        let _ = write!(line, " {name}={value}");
+    }
+    let w = SRTL_WORKERS.load(Ordering::Relaxed);
+    let _ = write!(line, " post_first_dispatch_us={first} storage_workers={} account_workers={}", w >> 32, w & 0xffff_ffff);
+    info!(target: "reth::eap", "{line}");
+}
