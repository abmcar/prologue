+//! X-027 (`accflt`): the filter of existing accounts on a temporary database, through the 2.9.0 read paths (the
+//! execution overlay and the latest-state provider) and the database provider's writers. One test: the process's filter
+//! can be installed once.
+
+use crate::{
+    acc_filter,
+    test_utils::{create_test_provider_factory, MockNodeTypesWithDB},
+    BlockWriter, HashingWriter, ProviderFactory, StageCheckpointWriter,
+    StorageSettingsCache,
+};
+use alloy_primitives::{Address, U256};
+use reth_db_api::{
+    cursor::DbCursorRO,
+    models::{AccountBeforeTx, StorageSettings},
+    tables,
+    transaction::DbTx,
+};
+use reth_primitives_traits::Account;
+use reth_stages_types::{StageCheckpoint, StageId};
+use reth_storage_api::{AccountReader, BlockHashReader, DatabaseProviderROFactory};
+use reth_storage_overlay::OverlayStateProviderFactory;
+use reth_testing_utils::generators::{self, random_block, BlockParams};
+
+fn account(nonce: u64) -> Account {
+    Account { nonce, balance: U256::from(nonce), ..Default::default() }
+}
+
+fn factory_with_genesis() -> ProviderFactory<MockNodeTypesWithDB> {
+    let factory = create_test_provider_factory();
+    // the hashed-state layout (v2), where latest-state account reads go to `HashedAccounts`
+    factory.set_storage_settings_cache(StorageSettings::v2());
+    let provider_rw = factory.provider_rw().unwrap();
+    let genesis = random_block(&mut generators::rng(), 0, BlockParams { tx_count: Some(0), ..Default::default() });
+    provider_rw.insert_block(&genesis.try_recover().unwrap()).unwrap();
+    provider_rw.save_stage_checkpoint(StageId::Finish, StageCheckpoint::new(0)).unwrap();
+    provider_rw.save_stage_checkpoint(StageId::Execution, StageCheckpoint::new(0)).unwrap();
+    provider_rw.commit().unwrap();
+    factory
+}
+
+/// Reads `address` through the execution overlay anchored at the database tip (the path 2.9.0's block execution takes,
+/// `OverlayStateProvider::basic_account` without a historical fallback) and through the latest-state provider; both
+/// must agree.
+fn read(factory: &ProviderFactory<MockNodeTypesWithDB>, address: &Address) -> Option<Account> {
+    let tip = factory.provider().unwrap().block_hash(0).unwrap().unwrap();
+    let overlay = OverlayStateProviderFactory::new(
+        factory.clone(),
+        factory.overlay_manager().overlay_builder(tip),
+    )
+    .database_provider_ro()
+    .unwrap();
+    let a = overlay.basic_account(address).unwrap();
+    let b = factory.latest().unwrap().basic_account(address).unwrap();
+    assert_eq!(a, b, "overlay and latest provider disagree for {address}");
+    a
+}
+
+#[test]
+fn filter_on_temp_db_lookups_check_mode_and_unwind_reinsert() {
+    acc_filter::test_gate_this_thread();
+    let factory = factory_with_genesis();
+    assert!(factory.provider().unwrap().cached_storage_settings().use_hashed_state());
+
+    // accounts written through the hashing writer before a filter exists
+    let present: Vec<(Address, Account)> = (1..=50u64).map(|i| (Address::random(), account(i))).collect();
+    let provider_rw = factory.provider_rw().unwrap();
+    provider_rw.insert_account_for_hashing(present.iter().map(|(a, acc)| (*a, Some(*acc)))).unwrap();
+    provider_rw.commit().unwrap();
+
+    // the filter as `reth db eap-acc-filter` builds it
+    let provider = factory.provider().unwrap();
+    let base = acc_filter::base_of(&provider).unwrap();
+    assert_eq!((base.block_number, base.execution_checkpoint, base.accounts), (0, 0, 50));
+    let filter = acc_filter::AccFilter::with_capacity(base.accounts, base);
+    for entry in provider.tx_ref().cursor_read::<tables::HashedAccounts>().unwrap().walk(None).unwrap() {
+        filter.insert(&entry.unwrap().0);
+    }
+    drop(provider);
+    // a file for the database's state is accepted (and logs `eap accflt loaded`)
+    assert!(acc_filter::install(filter, acc_filter::base_of(&factory.provider().unwrap()).unwrap(), 1));
+    acc_filter::set_use(true);
+    assert_eq!(acc_filter::state(), (true, true));
+
+    // check mode: every "absent" answer is looked up in the database too
+    acc_filter::set_check_every(1);
+    let _ = acc_filter::take_counters();
+    for (a, acc) in &present {
+        assert_eq!(read(&factory, a), Some(*acc));
+    }
+    let absent: Vec<Address> = (0..200).map(|_| Address::random()).collect();
+    for a in &absent {
+        assert_eq!(read(&factory, a), None);
+    }
+    let c = acc_filter::take_counters();
+    // two reads (overlay and latest provider) per address
+    assert_eq!(c.lookups, 2 * 250);
+    assert_eq!(c.check_mismatch, 0);
+    assert_eq!(c.checks, c.absent);
+    assert!(c.absent > 2 * 150, "most absent accounts are answered by the filter: {c:?}");
+    assert_eq!(acc_filter::state(), (true, true));
+
+    // a write through the hashed-state writer inserts the key before the entry exists
+    acc_filter::set_check_every(0);
+    let (new_addr, new_acc) = (Address::random(), account(77));
+    let provider_rw = factory.provider_rw().unwrap();
+    provider_rw.insert_account_for_hashing([(new_addr, Some(new_acc))]).unwrap();
+    provider_rw.commit().unwrap();
+    assert_eq!(read(&factory, &new_addr), Some(new_acc));
+
+    // an unwind re-inserts an account that was not in the filter (here: never in the table); without checks, a key
+    // missing from the filter would read as absent
+    let (old_addr, old_acc) = (Address::random(), account(99));
+    assert_eq!(read(&factory, &old_addr), None);
+    let provider_rw = factory.provider_rw().unwrap();
+    let changesets = [(1u64, AccountBeforeTx { address: old_addr, info: Some(old_acc) })];
+    provider_rw.unwind_account_hashing(changesets.iter()).unwrap();
+    provider_rw.commit().unwrap();
+    assert_eq!(read(&factory, &old_addr), Some(old_acc));
+    let c = acc_filter::take_counters();
+    assert_eq!((c.inserts, c.check_mismatch), (2, 0));
+
+    // EXP-240 (`accwarm`): an "absent" answer queues the address and stays absent; the readers' warm read (the database
+    // provider, as in the payload validator's factory) reads the table without the filter and queues nothing; switching
+    // off empties the queue and stops queueing
+    acc_filter::set_warm(true);
+    // an address both read paths answer "absent" (a false positive, about 1.2%, is looked up and queues nothing)
+    let (fresh, c) = (0..100)
+        .find_map(|_| {
+            let a = Address::random();
+            let _ = acc_filter::take_counters();
+            assert_eq!(read(&factory, &a), None);
+            let c = acc_filter::take_counters();
+            (c.absent == 2).then_some((a, c))
+        })
+        .expect("a random address the filter answers absent");
+    assert_eq!((c.warm_queued, c.warm_dropped), (2, 0));
+    let db = factory.provider().unwrap();
+    let mut popped = 0;
+    while let Some(a) = acc_filter::warm_pop() {
+        assert_eq!(a, fresh);
+        assert_eq!(db.basic_account(&a).unwrap(), None);
+        acc_filter::warm_done(true);
+        popped += 1;
+    }
+    assert_eq!(popped, 2);
+    assert_eq!(db.basic_account(&present[0].0).unwrap(), Some(present[0].1));
+    // a read that could not be done (the readers' provider failed to build) counts as an error, not as a read
+    acc_filter::warm_done(false);
+    let c = acc_filter::take_counters();
+    assert_eq!((c.lookups, c.warm_queued, c.warm_reads, c.warm_err), (0, 0, 2, 1));
+    // the node's warm read goes through the block's overlay provider, whose latest-state lookup is the filter's:
+    // without the bypass it is answered "absent" again and requeues the address (e240w); with it, it reads the table
+    // and is neither counted nor queued; the flag is cleared afterwards
+    let tip = factory.provider().unwrap().block_hash(0).unwrap().unwrap();
+    let overlay = OverlayStateProviderFactory::new(factory.clone(), factory.overlay_manager().overlay_builder(tip))
+        .database_provider_ro()
+        .unwrap();
+    assert_eq!(overlay.basic_account(&fresh).unwrap(), None);
+    let c = acc_filter::take_counters();
+    assert_eq!((c.lookups, c.absent, c.warm_queued), (1, 1, 1), "without the bypass the warm read requeues");
+    assert_eq!(acc_filter::warm_pop(), Some(fresh));
+    assert_eq!(acc_filter::bypassed(|| overlay.basic_account(&fresh).unwrap()), None);
+    assert_eq!(acc_filter::bypassed(|| overlay.basic_account(&present[0].0).unwrap()), Some(present[0].1));
+    let c = acc_filter::take_counters();
+    assert_eq!((c.lookups, c.absent, c.warm_queued), (0, 0, 0), "with the bypass nothing is counted or queued");
+    assert_eq!(acc_filter::warm_pop(), None);
+    assert_eq!(overlay.basic_account(&fresh).unwrap(), None);
+    assert_eq!(acc_filter::take_counters().warm_queued, 1, "the bypass ends with the call");
+    assert_eq!(acc_filter::warm_pop(), Some(fresh));
+    assert_eq!(read(&factory, &fresh), None);
+    acc_filter::set_warm(false);
+    assert_eq!(acc_filter::warm_pop(), None);
+    assert_eq!(read(&factory, &fresh), None);
+    assert_eq!(acc_filter::warm_pop(), None);
+    let c = acc_filter::take_counters();
+    assert_eq!((c.absent, c.warm_queued), (4, 2), "queued only while on");
+
+    // a writer that bypasses the insertions turns the filter off: lookups go to the database again
+    acc_filter::disable("test");
+    assert_eq!(acc_filter::state(), (false, false));
+    let _ = acc_filter::take_counters();
+    assert_eq!(read(&factory, &present[0].0), Some(present[0].1));
+    assert_eq!(acc_filter::take_counters().lookups, 0);
+}
