+
+/// A slot's in-flight fingerprint, never 0. Two slots with the same fingerprint only make the execution thread wait for
+/// the other slot's read and then read its own slot itself, as when nothing is in flight.
+fn inf_fingerprint(account: &Address, key: &StorageKey) -> u64 {
+    let mut h = 0x9e37_79b9_7f4a_7c15u64;
+    for c in account.as_slice().chunks(8).chain(key.as_slice().chunks(8)) {
+        let mut w = [0u8; 8];
+        w[..c.len()].copy_from_slice(c);
+        h = (h ^ u64::from_le_bytes(w)).wrapping_mul(0xbf58_476d_1ce4_e5b9).rotate_left(29);
+    }
+    h ^= h >> 31;
+    h.wrapping_mul(0x94d0_49bb_1331_11eb) | 1
+}
+
+fn inf_announced(fp: u64) -> bool {
+    // the cells in use are the threads' home cells, assigned from 0 up (a thread probes past its home only when more
+    // threads than cells share the homes, and then every cell is a home)
+    let n = INF_NEXT_HOME.load(Ordering::SeqCst).min(INF_NCELLS);
+    INF_CELLS[..n].iter().any(|c| c.0.load(Ordering::SeqCst) == fp)
+}
+
+/// Marks a slot in flight for the lifetime of the guard (a cache-filling read from the backend).
+struct InflightGuard(Inflight);
+
+/// What an [`InflightGuard`] holds (no `Drop` of its own, so the guard's drop can take it out).
+enum Inflight {
+    Off,
+    Set(Address, StorageKey),
+    /// `ewlf` bit 2: the cell index and the fingerprint announced in it
+    Cell(usize, u64),
+}
+
+impl InflightGuard {
+    fn begin(account: Address, key: StorageKey) -> Self {
+        Self(Self::announce(account, key))
+    }
+
+    fn announce(account: Address, key: StorageKey) -> Inflight {
+        if !INF_ON.load(Ordering::Relaxed) {
+            return Inflight::Off
+        }
+        if INF_CELLS_ON.load(Ordering::Relaxed) {
+            let fp = inf_fingerprint(&account, &key);
+            let mut i = INF_HOME.with(|h| {
+                if h.get() == 0 {
+                    h.set(INF_NEXT_HOME.fetch_add(1, Ordering::SeqCst) % INF_NCELLS + 1);
+                }
+                h.get() - 1
+            });
+            // the home cell is free unless more threads than cells are reading at once; after a full lap without a free
+            // cell the read is marked in the locked set instead (not seen by a join on the cells: that miss reads itself)
+            for _ in 0..INF_NCELLS {
+                if INF_CELLS[i].0.compare_exchange(0, fp, Ordering::SeqCst, Ordering::Relaxed).is_ok() {
+                    return Inflight::Cell(i, fp)
+                }
+                i = (i + 1) % INF_NCELLS;
+            }
+        }
+        crate::lkprof::lock(crate::lkprof::INFLIGHT, &INF.0).insert((account, key));
+        Inflight::Set(account, key)
+    }
+}
+
+impl Drop for InflightGuard {
+    fn drop(&mut self) {
+        match std::mem::replace(&mut self.0, Inflight::Off) {
+            Inflight::Off => {}
+            Inflight::Set(a, k) => {
+                crate::lkprof::lock(crate::lkprof::INFLIGHT, &INF.0).remove(&(a, k));
+                if INF_WAITERS.load(Ordering::Acquire) > 0 {
+                    INF.1.notify_all();
+                }
+            }
+            Inflight::Cell(i, fp) => {
+                // withdraw, then look for a waiter (both sequentially consistent, as the waiter's announcement of what it
+                // waits for and its scan: one of the two sides sees the other)
+                INF_CELLS[i].0.store(0, Ordering::SeqCst);
+                if INF_WAIT_FP.load(Ordering::SeqCst) == fp &&
+                    let Some(t) = INF_WAITER.lock().as_ref()
+                {
+                    t.unpark();
+                }
+            }
+        }
+    }
+}
+
+/// `ewlf` bit 2: [`inflight_join`] on the cells; the wait is bounded by [`inflight_wait`] as there.
+fn inflight_join_cells(caches: &ExecutionCache, account: Address, key: StorageKey) -> Option<StorageValue> {
+    let fp = inf_fingerprint(&account, &key);
+    if !inf_announced(fp) {
+        return None
+    }
+    // one waiter at a time, the execution thread (another cache-reading thread that misses reads the slot itself, as
+    // when nothing is in flight); the waiter is registered before the fingerprint is published
+    if !INF_EXEC.with(|c| c.get()) {
+        return None
+    }
+    let mut w = INF_WAITER.lock();
+    if INF_WAIT_FP.load(Ordering::SeqCst) != 0 {
+        return None
+    }
+    *w = Some(std::thread::current());
+    INF_WAIT_FP.store(fp, Ordering::SeqCst);
+    drop(w);
+    let (t0, limit) = (Instant::now(), inflight_wait());
+    INF_STATS[0].fetch_add(1, Ordering::Relaxed);
+    // X-029 (`infprobe`): the slot's state at the miss; no lock is held here, and a fill that ends meanwhile unparks
+    // this thread or is seen by the loop
+    if INF_HOOK_ON.load(Ordering::Relaxed) &&
+        let Some(f) = INF_JOIN_HOOK.get()
+    {
+        f(account, key);
+    }
+    while inf_announced(fp) {
+        let left = limit.saturating_sub(t0.elapsed());
+        if left.is_zero() {
+            INF_STATS[3].fetch_add(1, Ordering::Relaxed);
+            break
+        }
+        std::thread::park_timeout(left);
+    }
+    INF_WAIT_FP.store(0, Ordering::SeqCst);
+    INF_STATS[2].fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+    let v = caches.0.storage_cache.get(&(account, key))?;
+    INF_STATS[1].fetch_add(1, Ordering::Relaxed);
+    Some(v)
+}
+
+/// Execution-thread miss: when another thread is reading the slot, waits until that read ends (at most
+/// [`inflight_wait`]) and returns the value it put into the cache.
+fn inflight_join(caches: &ExecutionCache, account: Address, key: StorageKey) -> Option<StorageValue> {
+    if !INF_ON.load(Ordering::Relaxed) {
+        return None
+    }
+    if INF_CELLS_ON.load(Ordering::Relaxed) {
+        return inflight_join_cells(caches, account, key)
+    }
+    let (t0, limit) = (Instant::now(), inflight_wait());
+    {
+        let mut g = crate::lkprof::lock(crate::lkprof::INFLIGHT, &INF.0);
+        if !g.contains(&(account, key)) {
+            return None
+        }
+        INF_STATS[0].fetch_add(1, Ordering::Relaxed);
+        // registered under the table's lock, so a fill that removes the slot after this point sees the waiter
+        INF_WAITERS.fetch_add(1, Ordering::AcqRel);
+        // X-029 (`infprobe`; off: nothing is called and the table stays locked, as before): the slot's state at the
+        // miss, on the execution thread only (the probe's misses), with the table unlocked (the engine's hook takes its
+        // own locks); a fill that ends meanwhile removes the slot, and the loop below then does not wait
+        if INF_HOOK_ON.load(Ordering::Relaxed) &&
+            INF_EXEC.with(|c| c.get()) &&
+            let Some(f) = INF_JOIN_HOOK.get()
+        {
+            parking_lot::MutexGuard::unlocked(&mut g, || f(account, key));
+        }
+        while g.contains(&(account, key)) {
+            let left = limit.saturating_sub(t0.elapsed());
+            if left.is_zero() || INF.1.wait_for(&mut g, left).timed_out() {
+                if g.contains(&(account, key)) {
+                    INF_STATS[3].fetch_add(1, Ordering::Relaxed);
+                }
+                break
+            }
+        }
+        INF_WAITERS.fetch_sub(1, Ordering::AcqRel);
+    }
+    INF_STATS[2].fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+    let v = caches.0.storage_cache.get(&(account, key))?;
+    INF_STATS[1].fetch_add(1, Ordering::Relaxed);
+    Some(v)
+}
+
+/// EXP-199 (`iqc`): a lookup of a provider that does not fill the cache; recorded on the execution thread only.
+#[inline]
+fn iqc_note(account: Address, key: StorageKey) {
+    if IQC_EXEC.with(|c| c.get()) {
+        IQC_TOUCHED.lock().insert((account, key));
+    }
+}
