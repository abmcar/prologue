+    /// Whether reader threads run for this block.
+    pub const fn prefetch(&self) -> bool {
+        self.active &&
+            (self.cs || self.csd > 0 || self.tx || self.pwcs > 0 || self.sd > 0 || self.sds > 0 || self.cd() || self.pl)
+    }
+
+    /// EXP-184: whether the calldata-address channel runs for this block (`cdaddr`, `cdst` or `cdscan`).
+    pub const fn cd(&self) -> bool {
+        self.active && (self.cdaddr > 0 || self.cdst || self.cdscan > 0)
+    }
+
+    /// Whether the execution thread's cache misses are probed for this block (EXP-235: not with `pl` alone, whose
+    /// readers run without the probe).
+    pub const fn probe(&self) -> bool {
+        self.active && (self.cs || self.csd > 0 || self.tx || self.mp || self.pwcs > 0 || self.sd > 0 || self.sds > 0 || self.cd())
+    }
+}
