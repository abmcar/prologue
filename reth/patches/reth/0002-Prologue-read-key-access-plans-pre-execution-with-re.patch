+/// EXP-122: the EVM of the non-blocking pass (its own database over the execution cache and the readers) and its
+/// inspector. X-027: the inspector is handed to each pass ([`SharedInspector`]), and evm2's read cache is emptied before
+/// every pass, so no placeholder value answered by `NbDb` in one pass is read back in the next (see `eap::NbDb`).
+struct NbPass<Evm: ConfigureEvm> {
+    evm: EvmFor<'static, Evm>,
+    insp: Rc<RefCell<crate::tree::eap::NbInspector>>,
+}
+
+impl<Evm: ConfigureEvm> NbPass<Evm> {
+    fn begin(&mut self) {
+        self.insp.borrow_mut().begin();
+    }
+
+    /// Runs one pass of `tx_env`; whether it succeeded.
+    fn transact(&mut self, tx_env: &reth_evm::TxEnvFor<Evm>) -> bool {
+        crate::tree::eap_ew::fresh_reads(&mut self.evm);
+        EvmInstance::transact_with_inspector(&mut self.evm, tx_env, SharedInspector(self.insp.clone()))
+            .map(|(_, r)| r.result.is_success())
+            .unwrap_or(false)
+    }
+
+    fn steps(&self) -> u64 {
+        self.insp.borrow().steps()
+    }
+
+    fn finish(&mut self, ok: bool, ns: u64) {
+        self.insp.borrow_mut().finish(ok, ns);
+    }
+}
