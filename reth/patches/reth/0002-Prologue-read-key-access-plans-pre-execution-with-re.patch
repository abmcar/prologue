+/// Work for the reader threads. Call-start frames are instantiated by the readers, so the execution
+/// thread only looks the plan up and queues the frame's inputs.
+#[derive(Debug)]
+pub enum Item {
+    Frame(Box<FrameJob>),
+    /// A predicted slot with the tag source of the prediction that issued it, the block index of the
+    /// transaction it belongs to (`u32::MAX`: not tied to a transaction) and when it was handed to the readers
+    /// ([`rq_now`], for the readers' queue counters).
+    Slot(Address, B256, u8, u32, u64),
+    /// Keys a prewarm worker instantiated itself (`pwsync=1`): storage address, keys, transaction index, tag source and
+    /// when they were handed to the readers ([`rq_now`]).
+    Keys(Box<(Address, Vec<U256>, u32, u8, u64)>),
+    /// EXP-112: a frame whose plan's call records a reader evaluates to prefetch the callees (`pwct=1`).
+    Follow(Box<FrameJob>),
+    /// EXP-130: predicted inner calls of one transaction (loop-call extrapolation, CREATE2 progression, or any other
+    /// producer such as a transaction-arrival calldata decoder); a reader resolves each callee's plan and queues its keys.
+    Lx(Box<LxJob>),
+    /// EXP-172: the account of a predicted callee (`pwlxacct=1`), with the tag source and the transaction index
+    Acct(Address, u8, u32),
+    /// EXP-199 round 3 (`ctspread`): resolved calls of a follow job that a reader resolves (account, code, callee plan)
+    CtCalls(Box<CtChunk>),
+    /// EXP-235 (`pl`): a code to read by its hash, with the tag source
+    Code(B256, u8),
+}
+
+/// EXP-199 round 3 (`ctspread`): a chunk of one follow job's resolved calls with the job's frame context (CALLER `caller`,
+/// storage context `addr`, `origin`, `value`), transaction index and call-record depth.
+#[derive(Debug)]
+pub struct CtChunk {
+    calls: Vec<frame_plan::CallOut>,
+    caller: Address,
+    addr: Address,
+    origin: Address,
+    value: U256,
+    tx: u32,
+    depth: u32,
+}
+
+/// EXP-199 round 3 (`ctspread=N`): keeps the first N of a follow job's resolved calls for the caller and sends the rest
+/// to the readers in chunks of N (all of them when N is 0 or the job has at most N calls).
+#[expect(clippy::too_many_arguments)]
+fn ct_spread(
+    mut calls: Vec<frame_plan::CallOut>,
+    mode: &Mode,
+    stats: &Stats,
+    send: &Sender<Item>,
+    caller: Address,
+    addr: Address,
+    origin: Address,
+    value: U256,
+    tx: u32,
+    depth: u32,
+) -> Vec<frame_plan::CallOut> {
+    // `EWB_SPREAD`: one chunk per block reader (the job's thread keeps the first)
+    let n = if mode.ew > 0 && mode.ewbud & EWB_SPREAD != 0 { calls.len().div_ceil(mode.readers.max(1)) } else { mode.ctspread };
+    if n == 0 || calls.len() <= n {
+        return calls
+    }
+    let rest = calls.split_off(n);
+    for ch in rest.chunks(n) {
+        stats.ct_spread.fetch_add(1, Ordering::Relaxed);
+        stats.ct_spread_calls.fetch_add(ch.len() as u64, Ordering::Relaxed);
+        let _ = send.send(Item::CtCalls(Box::new(CtChunk { calls: ch.to_vec(), caller, addr, origin, value, tx, depth })));
+    }
+    calls
+}
