+/// Slots this thread has read from the backend in the current prewarm transaction.
+pub fn cc_tx_backend_slots() -> u32 {
+    CC_TX.with(|c| c.get().0)
+}
+
+/// EXP-212 (`pwsl=1`): the current prewarm transaction's backend-read state (count, discovery trigger, handed over), to be
+/// put back with [`cc_tx_restore`] after a plan's storage read-back that is not part of the run.
+pub fn cc_tx_save() -> (u32, u32, u8) {
+    CC_TX.with(|c| c.get())
+}
+
+/// EXP-212: puts back a state from [`cc_tx_save`].
