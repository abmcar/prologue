@@ -0,0 +1,90 @@
+//! EXP-232 (`accflt`): `reth db eap-acc-filter --out FILE` builds the filter of existing accounts from a read-only
+//! database and saves it with the block it describes (`reth_provider::acc_filter`). The node loads the file at start
+//! (`EAP_ACCFILTER=FILE`) only when its block, block hash and `HashedAccounts` entry count equal the database's.
+
+use crate::common::CliNodeTypes;
+use clap::Parser;
+use reth_db::DatabaseEnv;
+use reth_db_api::{cursor::DbCursorRO, tables, transaction::DbTx};
+use reth_db_common::DbTool;
+use reth_node_builder::NodeTypesWithDBAdapter;
+use reth_provider::{acc_filter, DBProvider, StageCheckpointReader, StorageSettingsCache};
+use reth_stages_types::{StageId, StageUnitCheckpoint};
+use std::{io::Write, path::PathBuf, time::Instant};
+use tracing::info;
+
+/// Keys between progress lines.
+const PROGRESS_KEYS: u64 = 25_000_000;
+
+#[derive(Parser, Debug)]
+/// The arguments for the `reth db eap-acc-filter` command
+pub struct Command {
+    /// The filter file to write (a `.json` file with the same stem describes it)
+    #[arg(long, value_name = "FILE")]
+    out: PathBuf,
+}
+
+impl Command {
+    /// Execute `db eap-acc-filter`
+    pub fn execute<N: CliNodeTypes>(
+        self,
+        tool: &DbTool<NodeTypesWithDBAdapter<N, DatabaseEnv>>,
+    ) -> eyre::Result<()> {
+        // one read transaction: the state, its block and the table walk are the same snapshot. The walk of a mainnet
+        // table outlasts the default read-transaction timeout (5 min); the node is offline, as for `db checksum`.
+        let provider = tool.provider_factory.provider()?.disable_long_read_transaction_safety();
+        eyre::ensure!(
+            provider.cached_storage_settings().use_hashed_state(),
+            "the filter covers HashedAccounts, which this database does not use for the latest state"
+        );
+        let base = acc_filter::base_of(&provider)?;
+        eyre::ensure!(
+            base.execution_checkpoint == base.block_number,
+            "Execution checkpoint {} differs from the Finish checkpoint {}",
+            base.execution_checkpoint,
+            base.block_number
+        );
+        // with partial persistence the hashed state can lag the Finish block; such a file would never match a node
+        let partial = match provider.get_stage_checkpoint(StageId::Finish)?.and_then(|c| c.stage_checkpoint) {
+            Some(StageUnitCheckpoint::Finish(f)) => f.partial_state_trie(),
+            _ => None,
+        };
+        eyre::ensure!(
+            partial.is_none_or(|p| p >= base.block_number),
+            "the persisted state is partial (up to {partial:?}, Finish {})",
+            base.block_number
+        );
+        info!(?base, "eap acc filter: building");
+        let t0 = Instant::now();
+        let filter = acc_filter::AccFilter::with_capacity(base.accounts, base);
+        let mut cursor = provider.tx_ref().cursor_read::<tables::HashedAccounts>()?;
+        let mut keys = 0u64;
+        for entry in cursor.walk(None)? {
+            let (key, _) = entry?;
+            filter.insert(&key);
+            keys += 1;
+            if keys.is_multiple_of(PROGRESS_KEYS) {
+                info!(keys, secs = t0.elapsed().as_secs(), "eap acc filter: scanning");
+            }
+        }
+        let scan_s = t0.elapsed().as_secs_f64();
+        eyre::ensure!(keys == base.accounts, "walked {keys} keys, the table has {} entries", base.accounts);
+        let t1 = Instant::now();
+        filter.save(&self.out)?;
+        let save_s = t1.elapsed().as_secs_f64();
+        let desc = format!(
+            "{{\"block_number\":{},\"block_hash\":\"{}\",\"execution_checkpoint\":{},\"accounts\":{},\"nblocks\":{},\"bytes\":{},\"scan_s\":{:.1},\"save_s\":{:.1}}}\n",
+            base.block_number,
+            base.block_hash,
+            base.execution_checkpoint,
+            base.accounts,
+            filter.nblocks(),
+            filter.bytes(),
+            scan_s,
+            save_s
+        );
+        std::fs::File::create(self.out.with_extension("json"))?.write_all(desc.as_bytes())?;
+        print!("{desc}");
+        Ok(())
+    }
+}
