+    }
+
+    /// Sets counter `i`.
+    #[inline]
+    pub fn set(i: usize, v: u64) {
+        STATS[i].store(v, Ordering::Relaxed);
+    }
+
+    /// The counters of the current block.
+    pub fn snapshot() -> [u64; N] {
+        core::array::from_fn(|i| STATS[i].load(Ordering::Relaxed))
+    }
