+    /// The KECCAK256 input of element `i` of the mapping at slot `c`.
+    fn input(i: U256, c: u64) -> [u8; 64] {
+        B256::from(i).concat_const::<32, 64>(B256::from(U256::from(c))).0
+    }
+
+    /// The worker reads field `j` of element `i` of the mapping at slot [`C`] of [`A`]: the input, then the read.
+    fn read(s: &mut IxState, i: u64, j: u64) {
+        s.input(&input(U256::from(i), C));
+        s.slot(A, slot_of(U256::from(i), U256::from(C)) + U256::from(j));
+    }
+
+    /// The keys handed to the readers since the last call, checked to be slots of `a` with the extrapolation's source.
+    fn sent_of(rx: &Receiver<Item>, a: Address) -> Vec<U256> {
+        rx.try_iter()
+            .map(|it| match it {
+                Item::Slot(sa, k, src, _, _) => {
+                    assert_eq!((sa, src), (a, CC_SRC_EAP_IX));
+                    U256::from_be_bytes(k.0)
+                }
+                other => panic!("a slot item, not {other:?}"),
+            })
+            .collect()
+    }
+
+    fn sent(rx: &Receiver<Item>) -> Vec<U256> {
+        sent_of(rx, A)
+    }
+
+    /// The keys of indices `idx` with offsets `offs`, in issue order.
+    fn keys(idx: impl IntoIterator<Item = U256>, offs: &[u64]) -> Vec<U256> {
+        idx.into_iter()
+            .flat_map(|i| offs.iter().map(move |j| slot_of(i, U256::from(C)) + U256::from(*j)))
+            .collect()
+    }
+
+    fn u(r: impl IntoIterator<Item = u64>) -> impl Iterator<Item = U256> {
+        r.into_iter().map(U256::from)
+    }
