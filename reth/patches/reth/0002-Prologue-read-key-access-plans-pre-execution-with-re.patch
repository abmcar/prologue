+        // delegate and no-summary files
+        let mut d = b"EAPF".to_vec(); d.extend_from_slice(&1u32.to_le_bytes()); d.extend_from_slice(&1u32.to_le_bytes()); d.extend_from_slice(&[7u8; 20]);
