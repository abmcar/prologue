+/// Execution-thread storage lookup: `hit` is `Some(tag source)` for a hit, `None` for a miss started at `t0`.
+#[inline]
+fn diag_exec_slot(hit: Option<Option<u8>>, account: Address, key: StorageKey, t0: u64) {
+    if DIAG_PATH.is_none() {
+        return
+    }
+    DIAG_EXEC.with(|c| {
+        let Some((i, mut lk)) = c.get() else { return };
+        match hit {
+            Some(Some(CC_SRC_PREWARM)) => lk[0] += 1,
+            Some(Some(_)) => lk[1] += 1,
+            Some(None) => lk[2] += 1,
+            None => {
+                lk[3] += 1;
+                let dur = diag_now_ns().saturating_sub(t0);
+                let fr = diag_cur_frame();
+                DIAG_MISSES.with(|m| m.borrow_mut().push((i, t0, account, key, dur, fr)));
+            }
+        }
+        c.set(Some((i, lk)));
+    });
+}
+
+/// The execution thread's block diagnostics: the one taken at its block start, else the current block's.
+fn diag_exec_block() -> Option<Arc<DiagBlock>> {
+    DIAG_EXEC_BLOCK.with(|b| b.borrow().clone()).or_else(cc_diag_block)
+}
+
+fn diag_exec_flush_counters() {
+    let Some((i, lk)) = DIAG_EXEC.with(|c| c.get()) else { return };
+    let Some(b) = diag_exec_block() else { return };
+    let misses = DIAG_MISSES.with(|m| std::mem::take(&mut *m.borrow_mut()));
+    let other = DIAG_OTHER.with(|m| std::mem::take(&mut *m.borrow_mut()));
+    let frames = DIAG_FRAMES.with(|f| std::mem::take(&mut *f.borrow_mut()));
+    DIAG_STACK.with(|st| st.borrow_mut().clear());
+    b.push(DiagEv::Exec { i, t: diag_now_ns(), lk, misses, other, frames });
+}
+
+/// Starts the diagnostics of a new block (called with [`cc_prewarm_tags_reset`]).
+pub fn cc_diag_reset() {
+    if DIAG_PATH.is_some() {
+        *DIAG_BLOCK.lock() =
+            Some(Arc::new(DiagBlock::new(diag_now_ns(), PWRU_ON.load(Ordering::Relaxed))));
+    }
+}
+
+/// Diagnostics of the current block, when enabled.
+pub fn cc_diag_block() -> Option<Arc<DiagBlock>> {
+    if DIAG_PATH.is_some() { DIAG_BLOCK.lock().clone() } else { None }
+}
+
+/// Execution thread: the block's execution starts (pre-execution changes follow).
+pub fn cc_diag_exec_block_start() {
+    // EXP-199 (`iqc`): independent of the diagnostics file
+    IQC_EXEC.with(|c| c.set(IQC_ON.load(Ordering::Relaxed)));
+    // EXP-210 (`ewlf` bit 2): the thread that waits for in-flight reads
+    INF_EXEC.with(|c| c.set(true));
+    IQC_TOUCHED.lock().clear();
+    // EXP-235 (`plrec`): independent of the diagnostics file
+    let plrec = PLREC_ON.load(Ordering::Relaxed);
+    PLREC_EXEC.with(|c| c.set(plrec));
+    if plrec {
+        PLREC.with(|r| r.borrow_mut().clear());
+    }
+    if DIAG_PATH.is_some() {
+        DIAG_MISSES.with(|m| m.borrow_mut().clear());
+        DIAG_EXEC.with(|c| c.set(Some((DIAG_PRE, [0; 4]))));
+        let b = cc_diag_block();
+        if let Some(b) = &b {
+            b.mark("exec_block_start", diag_now_ns());
+        }
+        DIAG_EXEC_BLOCK.with(|c| *c.borrow_mut() = b);
+    }
