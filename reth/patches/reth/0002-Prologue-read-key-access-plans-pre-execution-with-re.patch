+/// Disarms the discovery trigger of the current prewarm transaction if it has not been handed over yet (EXP-078).
+/// Returns whether a trigger was disarmed.
+pub fn cc_tx_disarm() -> bool {
+    CC_TX.with(|c| {
+        let (n, t, h) = c.get();
+        if t > 0 && h == 0 {
+            c.set((n, 0, 0));
+            true
+        } else {
+            false
+        }
+    })
+}
