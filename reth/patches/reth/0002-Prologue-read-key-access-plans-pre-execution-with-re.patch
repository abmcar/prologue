+    /// Prologue (`exphys`): the mechanism's set leaves the reserved CPU and those of its siblings that are in the set;
+    /// siblings outside it are not counted; when nothing would be left, only the reserved CPU leaves (the fallback);
+    /// without siblings, or with the reserved CPU alone, the set is the one without the switch. The siblings read from
+    /// this machine's sysfs list the CPU itself (or nothing, when unreadable) and are read once.
+    #[test]
+    fn exphys_reserved_set_leaves_the_siblings() {
+        // SAFETY (this test): a zeroed cpu_set_t is valid; CPU_SET and CPU_ISSET only touch bits of the given sets.
+        let set = |cpus: &[usize]| {
+            let mut s: libc::cpu_set_t = unsafe { std::mem::zeroed() };
+            for &c in cpus {
+                unsafe { libc::CPU_SET(c, &mut s) };
+            }
+            s
+        };
+        let cpus = |s: &libc::cpu_set_t| {
+            (0..libc::CPU_SETSIZE as usize).filter(|c| unsafe { libc::CPU_ISSET(*c, s) }).collect::<Vec<_>>()
+        };
+        let node = set(&(0..28).collect::<Vec<_>>());
+        let (others, removed) = reserved_set(&node, 0, &[0, 1]);
+        assert_eq!((cpus(&others), removed), ((2..28).collect::<Vec<_>>(), Some(1)));
+        // one physical core: the fallback leaves the sibling to the mechanism's threads.
+        let (others, removed) = reserved_set(&set(&[0, 1]), 0, &[0, 1]);
+        assert_eq!((cpus(&others), removed), (vec![1], None));
+        // siblings outside the set (the other numbering, 0 and 16) and beyond `CPU_SETSIZE` are ignored.
+        let (others, removed) = reserved_set(&set(&[0, 2, 3]), 0, &[0, 16, 5000]);
+        assert_eq!((cpus(&others), removed), (vec![2, 3], Some(0)));
+        // two siblings in the set, listed twice.
+        let (others, removed) = reserved_set(&set(&[4, 5, 6, 9]), 4, &[4, 5, 6, 5]);
+        assert_eq!((cpus(&others), removed), (vec![9], Some(2)));
+        for siblings in [vec![], vec![0]] {
+            let (others, removed) = reserved_set(&node, 0, &siblings);
+            assert_eq!((cpus(&others), removed), ((1..28).collect::<Vec<_>>(), Some(0)), "{siblings:?}");
+        }
+        let own = cpus(&own_affinity().expect("the thread's CPU set"));
+        let siblings = thread_siblings(own[0]);
+        assert!(siblings.is_empty() || siblings.contains(&own[0]), "{siblings:?}");
+        assert_eq!(thread_siblings(own[0]), siblings);
+    }
