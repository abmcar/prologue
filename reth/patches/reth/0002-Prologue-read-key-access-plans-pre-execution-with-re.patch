+    /// The `eap sched` line's keys (2.5.1 6388aae).
+    const SCHED_KEYS: &str = "block exrt exrt_state exrt_refused ewnear ewnear_prio ewnear_raised ewnear_refused ewnear_back ewnear_us exslice exslice_set ewcore excore core_reserved ewpool ccv ccv_hits";
+    /// X-029: the keys appended to the `eap sched` line after 2.5.1's.
+    const SCHED_KEYS_X029: &str = "exio exio_state";
+    /// Prologue (`exphys`): the keys appended to the `eap sched` line after X-029's.
+    const SCHED_KEYS_EXPHYS: &str = "exphys exphys_sib exphys_fb exphys_pin exphys_back exphys_sr exphys_sr_back";
+    /// The `eap accflt` line's keys (2.5.1 6388aae).
+    const ACCFLT_KEYS: &str = "block accflt accfltchk valid lookups absent false_positive inserts checks check_mismatch inserted_total load_us";
+
+    fn want_block_keys() -> HashSet<&'static str> {
+        BLOCK_KEYS.split_whitespace().filter(|k| *k != "block").collect()
+    }
+
+    /// A `tracing` writer into a shared buffer.
+    #[derive(Clone, Default)]
+    struct Buf(Arc<std::sync::Mutex<Vec<u8>>>);
+
+    impl std::io::Write for Buf {
+        fn write(&mut self, b: &[u8]) -> std::io::Result<usize> {
+            self.0.lock().unwrap().extend_from_slice(b);
+            Ok(b.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+
+    /// ab199check.py's `KV`: the line's `key=value` pairs with a number or boolean value, in order.
+    fn kv(line: &str) -> Vec<(String, String)> {
+        let mut out = Vec::new();
+        for tok in line.split_whitespace() {
+            if let Some((k, v)) = tok.split_once('=') &&
+                !k.is_empty() &&
+                k.chars().all(|c| c.is_ascii_alphanumeric() || c == '_') &&
+                (v == "true" || v == "false" || v.trim_start_matches('-').parse::<u64>().is_ok())
+            {
+                out.push((k.to_string(), v.to_string()));
+            }
+        }
+        out
+    }
+
+    /// ab199check.py's rule for the switches a line echoes: a value equals the configuration's token (absent: 0), as a
+    /// number, and as on/off for booleans.
+    fn echo_ok(toks: &HashMap<&str, &str>, k: &str, v: &str) -> bool {
+        let want: u64 = toks.get(k).map_or(0, |x| x.parse().unwrap());
+        let got: u64 = match v {
+            "true" => 1,
+            "false" => 0,
+            x => x.parse().unwrap(),
+        };
+        (got != 0) == (want != 0) && (v == "true" || v == "false" || got == want)
+    }
+
+    /// X-027: the `eap block`, `eap sched` and `eap accflt` lines rendered through `tracing`'s formatter (as reth's log)
+    /// carry 2.5.1's keys in 2.5.1's order with `block` first right after the message (the driver's and ab199check.py's
+    /// `<message> block=` match; then EXP-235's and Prologue's `ixpf` keys on the `eap block` line, X-029's and
+    /// Prologue's `exphys` keys on the `eap sched` line), and the
+    /// switches they echo equal the row's
+    /// tokens (row 5, AB5ng; checker rule).
+    #[test]
+    fn block_sched_and_accflt_lines_match_the_checker() {
+        let (_, row) = AB_NG[4];
+        let ctrl = format!("tag=777 {row}");
+        let toks: HashMap<&str, &str> = row.split_whitespace().filter_map(|t| t.split_once('=')).collect();
+        let buf = Buf::default();
+        let w = buf.clone();
+        let sub = tracing_subscriber::fmt().with_ansi(false).with_max_level(tracing::Level::INFO).with_writer(move || w.clone()).finish();
+        let _mode = MODE_TEST_LOCK.lock();
+        tracing::subscriber::with_default(sub, || {
+            set_mode_for_test(&ctrl);
+            let info = BlockInfo {
+                number: U256::from(777u64),
+                timestamp: U256::from(1u8),
+                coinbase: Address::ZERO,
+                gas_limit: 30_000_000,
+                basefee: 7,
+                prevrandao: U256::ZERO,
+            };
+            // no provider factory: the block has no readers, its `eap block` line is logged when it is dropped
+            let bp = BlockPrefetch::start(Mode::parse(&ctrl), None, None, info).expect("tx=1 starts the probe");
+            drop(bp);
+            // the `eap sched` and `eap accflt` lines of a block are logged when the next block starts
+            sched_block(777);
+            sched_block(778);
+            // SAFETY: test-only; no other code of this test binary reads `EAP_ACCFILTER`.
+            unsafe { std::env::set_var("EAP_ACCFILTER", "/nonexistent") };
+            accflt_block(777);
+            accflt_block(778);
+            *MODE.lock() = Mode::OFF;
+        });
+        let text = String::from_utf8(buf.0.lock().unwrap().clone()).unwrap();
+        let find = |msg: &str| -> String {
+            let pat = format!("{msg} block=777 ");
+            text.lines().find(|l| l.contains(&pat)).unwrap_or_else(|| panic!("no `{pat}` line in\n{text}")).to_string()
+        };
+        let block_keys = format!("{BLOCK_KEYS} {BLOCK_KEYS_X235} {BLOCK_KEYS_IXPF}");
+        let sched_keys = format!("{SCHED_KEYS} {SCHED_KEYS_X029} {SCHED_KEYS_EXPHYS}");
+        for (msg, want_keys) in
+            [("eap block", block_keys.as_str()), ("eap sched", sched_keys.as_str()), ("eap accflt", ACCFLT_KEYS)]
+        {
+            let line = find(msg);
+            assert!(line.contains(&format!(" INFO reth::eap: {msg} block=777 ")), "{line}");
+            let got: Vec<String> = kv(&line).into_iter().map(|(k, _)| k).collect();
+            let want: Vec<&str> = want_keys.split_whitespace().collect();
+            assert_eq!(got, want, "{msg}: keys differ from 2.5.1");
+        }
+        let blk = kv(&find("eap block"));
+        assert_eq!(blk.len(), 330);
+        let mut checked = 0;
+        for (k, v) in &blk {
+            if k != "block" && toks.contains_key(k.as_str()) {
+                assert!(echo_ok(&toks, k, v), "eap block {k}={v}, switch {}", toks[k.as_str()]);
+                checked += 1;
+            }
+        }
+        // every key of the row that is also a key of 2.5.1's line (36 of AB5ng's 79 tokens; the rest are echoed on
+        // other lines or not at all)
+        let on_line = toks.keys().filter(|k| want_block_keys().contains(*k)).count();
+        assert_eq!(checked, on_line);
+        assert_eq!(checked, 36);
+        assert!(blk.contains(&("tag".to_string(), "777".to_string())));
+        let sch = kv(&find("eap sched"));
+        for k in ["exrt", "ewnear", "exslice", "ewcore", "excore", "ewpool", "ccv", "exio", "exphys"] {
+            let v = &sch.iter().find(|(x, _)| x == k).unwrap().1;
+            assert!(echo_ok(&toks, k, v), "eap sched {k}={v}");
+        }
+        let acc = kv(&find("eap accflt"));
+        assert_eq!(acc.iter().find(|(k, _)| k == "accflt").map(|x| x.1.as_str()), Some("false"), "no filter loaded");
+        let _ = std::io::stdout().flush();
+    }
