+            let parent = chain_spec.sealed_genesis_header();
+            let db =
+                StateProviderDatabase::new(provider.latest().unwrap().into_evm_state_provider());
+            let mut builder = evm_config
+                .builder_for_next_block(
+                    db,
+                    &parent,
+                    NextBlockEnvAttributes {
+                        timestamp: parent.timestamp + 12,
+                        suggested_fee_recipient: Address::repeat_byte(0xbe),
+                        prev_randao: B256::ZERO,
+                        gas_limit: parent.gas_limit,
+                        parent_beacon_block_root: None,
+                        withdrawals: Some(Withdrawals::default()),
+                        extra_data: Bytes::new(),
+                        slot_number: None,
+                    },
+                )
+                .unwrap();
+            builder.apply_pre_execution_changes().unwrap();
+            for tx in &txs {
+                builder.execute_transaction(tx.clone()).unwrap();
+            }
+            let built = builder.finish(provider.latest().unwrap(), None).unwrap();
+
+            let runtime = reth_tasks::Runtime::test();
+            let overlay_manager = OverlayManager::new(runtime.state_trie_overlay_worker_pool());
+            let config = TreeConfig::default().with_has_enough_parallelism(true);
+            let invalid_hooks = Arc::new(AtomicUsize::new(0));
+            let calls = Arc::clone(&invalid_hooks);
+            let invalid_block_hook = move |_: &SealedHeader<Header>,
+                                           _: &RecoveredBlock<Block>,
+                                           _: &BlockExecutionOutput<Receipt>,
+                                           _: Option<(&TrieUpdates, B256)>| {
+                calls.fetch_add(1, Ordering::Relaxed);
+            };
+            let validator = BasicEngineValidator::new(
+                provider.clone(),
+                Arc::new(EthBeaconConsensus::new(chain_spec.clone())),
+                evm_config.clone(),
+                EthereumEngineValidator::new(chain_spec),
+                config.clone(),
+                Box::new(invalid_block_hook),
+                overlay_manager.clone(),
+                runtime,
+            );
+            let tree_state = EngineApiTreeState::new(
+                10,
+                10,
+                config.invalid_header_hit_eviction_threshold(),
+                parent.num_hash(),
+                EngineApiKind::Ethereum,
+                overlay_manager,
+            );
+            Self {
+                validator,
+                provider,
+                evm_config,
+                tree_state,
+                canonical: CanonicalInMemoryState::with_head(parent, None, None),
+                invalid_hooks,
+                txs,
+                block: built.block,
+                receipts: built.execution_result.receipts,
+                state: built.execution_state,
+            }
+        }
+
+        /// Validates `block` (block 1 or a variant of it) with the control line `ctrl`. With `wrong`, a reused result of
+        /// its first transaction is stored first: the transaction run on the parent state as the prewarm workers run
+        /// it, then made wrong. Returns the outcome, the log written during the validation and the number of calls of
+        /// the invalid-block hook.
+        fn validate(
+            &mut self,
+            block: &RecoveredBlock<Block>,
+            ctrl: &str,
+            wrong: Option<Wrong>,
+        ) -> (ValidationOutcome<EthPrimitives>, String, usize) {
+            *crate::tree::eap::CTRL_FOR_TEST.lock() = Some(ctrl.to_string());
+            if let Some(wrong) = wrong {
+                // the store keeps results only while reuse is on; `refresh` sets the block's mode again
+                crate::tree::reuse::set_mode(2, 0, false, false, 0, false, 0);
+                let db = StateProviderDatabase::new(
+                    self.provider.latest().unwrap().into_evm_state_provider(),
+                );
+                let evm_env = self.evm_config.evm_env(block.header()).unwrap();
+                let mut evm = self.evm_config.evm_with_env(db, evm_env);
+                let tx = &self.txs[0];
+                crate::tree::reuse::tx_begin();
+                let mut res =
+                    reth_evm::Evm::transact(&mut evm, &self.evm_config.tx_env(tx.clone())).unwrap();
+                match wrong {
+                    Wrong::Balance => change_account(&mut res.pending_state, RECIPIENT, |account| {
+                        account.balance += U256::from(1)
+                    }),
+                    Wrong::Gas => res.result.total_gas_spent += EXTRA_GAS,
+                    Wrong::Nonce => {
+                        change_account(&mut res.pending_state, tx.signer(), |account| {
+                            account.nonce += 1
+                        })
+                    }
+                }
+                crate::tree::reuse::store_checked(block.hash(), 0, &res, false, 0);
+            }
+            let log = LogBuf::default();
+            let writer = log.clone();
+            let subscriber = tracing_subscriber::fmt()
+                .with_ansi(false)
+                .with_max_level(Level::INFO)
+                .with_writer(move || writer.clone())
+                .finish();
+            let input = BlockOrPayload::<EthEngineTypes>::Block(
+                SealedBlockWithAccessList::from_block(block.clone_sealed_block()),
+            );
+            let hooks = self.invalid_hooks.load(Ordering::Relaxed);
+            let outcome = tracing::subscriber::with_default(subscriber, || {
+                self.validator.validate_block_with_state(
+                    input,
+                    TreeCtx::new(&mut self.tree_state, &self.canonical),
+                )
+            });
+            let hooks = self.invalid_hooks.load(Ordering::Relaxed) - hooks;
+            *crate::tree::eap::CTRL_FOR_TEST.lock() = None;
+            crate::tree::reuse::set_mode(0, 0, false, false, 0, false, 0);
+            crate::tree::eap::set_mode_for_test("");
+            let log = String::from_utf8(log.0.lock().unwrap().clone()).unwrap();
+            (outcome, log, hooks)
+        }
+
+        /// Asserts that `block` was accepted with the receipts and post-state it was built with, and that the execution
+        /// cache keeps no post-state of the block under its hash.
+        fn assert_accepted(
+            &self,
+            outcome: ValidationOutcome<EthPrimitives>,
+            block: &RecoveredBlock<Block>,
+        ) {
+            let executed =
+                outcome.expect("accepted after the execution without reuse").executed_block;
+            assert_eq!(executed.recovered_block.hash(), block.hash());
+            assert_eq!(executed.execution_output.result.receipts, self.receipts);
+            assert_eq!(executed.execution_output.state, self.state);
+            let cache = self.validator.payload_processor.cache_for(block.hash());
+            assert_eq!(
+                cache.cache().peek_account(&RECIPIENT),
+                None,
+                "the first attempt's post-state is not cached"
+            );
+        }
+    }
+
+    /// Changes the account `address` as `state` leaves it with `f`.
+    fn change_account(
+        state: &mut PendingState,
+        address: Address,
+        f: impl FnOnce(&mut AccountInfo),
+    ) {
+        let (original, mut current) = {
+            let changes = state.account_changes_for(&address).unwrap();
+            (changes.original.cloned(), changes.current.cloned().unwrap())
+        };
+        f(&mut current);
+        state.insert_account(address, original, Some(current));
+    }
+
+    /// The state-root difference a validation was rejected with.
+    fn root_diff(outcome: ValidationOutcome<EthPrimitives>) -> GotExpected<B256> {
+        let Err(InsertPayloadError::Block(err)) = outcome else {
+            panic!("the block was not rejected")
+        };
+        let InsertBlockErrorKind::Consensus(ConsensusError::BodyStateRootDiff(diff)) = err.kind()
+        else {
+            panic!("not a state-root difference: {err:?}")
+        };
+        (**diff).clone()
+    }
+
+    /// The block gas difference a validation was rejected with.
+    fn gas_diff(outcome: ValidationOutcome<EthPrimitives>) -> GotExpected<u64> {
+        let Err(InsertPayloadError::Block(err)) = outcome else {
+            panic!("the block was not rejected")
+        };
+        let InsertBlockErrorKind::Consensus(ConsensusError::BlockGasUsed { gas, .. }) = err.kind()
+        else {
+            panic!("not a gas difference: {err:?}")
+        };
+        gas.clone()
+    }
+
+    /// Prologue (`reusefb`): a reused result that credits the recipient one wei too many passes the read-set check and
+    /// makes the valid block's root differ. Without the switch the block is rejected with `BodyStateRootDiff` and
+    /// reported to the invalid-block hook; with it, the block executed again without reuse is accepted with its own
+    /// receipts and post-state and not reported, the first attempt's post-state is not left in the execution cache, and
+    /// one `eap reusefb` line reports the fallback. The tests that set the process-wide EAP mode run in their own
+    /// process or with a filter (`tree::payload_validator::eap_tests`): block validation elsewhere in the crate resets
+    /// the mode and the stored results.
+    #[test]
+    fn reuse_fallback_accepts_valid_block_after_wrong_reused_result() {
+        let _mode = EAP_MODE_TEST.write();
+        let mut fx = ReuseFallback::new(1);
+        let block = fx.block.clone();
+        let root = block.header().state_root;
+
+        let (outcome, log, hooks) = fx.validate(&block, "tag=1 reuse=2", Some(Wrong::Balance));
+        let diff = root_diff(outcome);
+        assert_eq!(diff.expected, root);
+        assert_ne!(diff.got, root, "the wrong reused result reached the state root");
+        assert!(!log.contains("eap reusefb"), "{log}");
+        assert_eq!(hooks, 1);
+
+        let (outcome, log, hooks) =
+            fx.validate(&block, "tag=1 reuse=2 reusefb=1", Some(Wrong::Balance));
+        fx.assert_accepted(outcome, &block);
+        assert!(log.contains("eap reusefb block=1 reused=1 outcome=accepted "), "{log}");
+        assert!(log.contains(" at=root first="), "{log}");
+        assert_eq!(hooks, 0, "a valid block is not reported invalid");
+    }
+
+    /// Prologue (`reusefb`): a block whose header carries a wrong state root stays invalid with the switch. With a wrong
+    /// reused result, the block executed again without reuse is rejected with its own root (the root of the valid
+    /// block) and reported once, where without the switch the root of the first attempt is reported; a mismatch without
+    /// a reused result does not execute the block again. Run as
+    /// [`reuse_fallback_accepts_valid_block_after_wrong_reused_result`].
+    #[test]
+    fn reuse_fallback_keeps_invalid_block_invalid() {
+        let _mode = EAP_MODE_TEST.write();
+        let mut fx = ReuseFallback::new(1);
+        let root = fx.block.header().state_root;
+        let header_root = B256::repeat_byte(0x5a);
+        let (mut block, senders) = fx.block.clone().split();
+        block.header.state_root = header_root;
+        let block = RecoveredBlock::new_unhashed(block, senders);
+
+        let (outcome, log, hooks) = fx.validate(&block, "tag=1 reuse=2", Some(Wrong::Balance));
+        let diff = root_diff(outcome);
+        assert_eq!(diff.expected, header_root);
+        assert_ne!(diff.got, root, "the first attempt's root is reported");
+        assert!(!log.contains("eap reusefb"), "{log}");
+        assert_eq!(hooks, 1);
+
+        let (outcome, log, hooks) =
+            fx.validate(&block, "tag=1 reuse=2 reusefb=1", Some(Wrong::Balance));
+        assert_eq!(root_diff(outcome), GotExpected { got: root, expected: header_root });
+        assert!(log.contains("eap reusefb block=1 reused=1 outcome=invalid "), "{log}");
+        assert_eq!(hooks, 1, "reported once, with the execution without reuse");
+
+        let (outcome, log, hooks) = fx.validate(&block, "tag=1 reuse=2 reusefb=1", None);
+        assert_eq!(root_diff(outcome), GotExpected { got: root, expected: header_root });
+        assert!(!log.contains("eap reusefb"), "{log}");
+        assert_eq!(hooks, 1);
+    }
+
+    /// Prologue (`reusefb`): a reused result that spends more gas than its transaction passes the read-set check and
+    /// makes the block's gas used differ, which the post-execution checks reject before the state root. Without the
+    /// switch the valid block is rejected with `BlockGasUsed` and reported to the invalid-block hook; with it, the block
+    /// executed again without reuse is accepted and not reported. A block whose header gas is wrong stays invalid, with
+    /// the gas of the execution without reuse, reported once. Run as
+    /// [`reuse_fallback_accepts_valid_block_after_wrong_reused_result`].
+    #[test]
+    fn reuse_fallback_accepts_valid_block_after_wrong_reused_gas() {
+        let _mode = EAP_MODE_TEST.write();
+        let mut fx = ReuseFallback::new(1);
+        let block = fx.block.clone();
+        let gas_used = block.header().gas_used;
+
+        let (outcome, log, hooks) = fx.validate(&block, "tag=1 reuse=2", Some(Wrong::Gas));
+        assert_eq!(
+            gas_diff(outcome),
+            GotExpected { got: gas_used + EXTRA_GAS, expected: gas_used }
+        );
+        assert!(!log.contains("eap reusefb"), "{log}");
+        assert_eq!(hooks, 1);
+
+        let (outcome, log, hooks) =
+            fx.validate(&block, "tag=1 reuse=2 reusefb=1", Some(Wrong::Gas));
+        fx.assert_accepted(outcome, &block);
+        assert!(log.contains("eap reusefb block=1 reused=1 outcome=accepted "), "{log}");
+        assert!(log.contains(" at=post first="), "{log}");
+        assert_eq!(hooks, 0, "a valid block is not reported invalid");
+
+        let (mut wrong_gas, senders) = block.split();
+        wrong_gas.header.gas_used += 1;
+        let wrong_gas = RecoveredBlock::new_unhashed(wrong_gas, senders);
+        let (outcome, log, hooks) =
+            fx.validate(&wrong_gas, "tag=1 reuse=2 reusefb=1", Some(Wrong::Gas));
+        assert_eq!(gas_diff(outcome), GotExpected { got: gas_used, expected: gas_used + 1 });
+        assert!(log.contains("eap reusefb block=1 reused=1 outcome=invalid "), "{log}");
+        assert_eq!(hooks, 1, "reported once, with the execution without reuse");
+    }
+
+    /// Prologue (`reusefb`): a reused result that leaves its sender's nonce one too high passes the read-set check and
+    /// makes the sender's next transaction in the block fail to execute. Without the switch the valid block is rejected
+    /// with that transaction's nonce error (execution errors are not reported to the invalid-block hook); with it, the
+    /// block executed again without reuse is accepted. Run as
+    /// [`reuse_fallback_accepts_valid_block_after_wrong_reused_result`].
+    #[test]
+    fn reuse_fallback_accepts_valid_block_after_execution_error() {
+        let _mode = EAP_MODE_TEST.write();
+        let mut fx = ReuseFallback::new(2);
+        let block = fx.block.clone();
+
+        let (outcome, log, hooks) = fx.validate(&block, "tag=1 reuse=2", Some(Wrong::Nonce));
+        let Err(InsertPayloadError::Block(err)) = outcome else {
+            panic!("the block was not rejected")
+        };
+        assert_matches!(
+            err.kind(),
+            InsertBlockErrorKind::Execution(BlockExecutionError::Validation(
+                BlockValidationError::InvalidTx { hash, error }
+            )) if hash == fx.txs[1].tx_hash() && error.is_nonce_too_low()
+        );
+        assert!(!log.contains("eap reusefb"), "{log}");
+        assert_eq!(hooks, 0);
+
+        let (outcome, log, hooks) =
+            fx.validate(&block, "tag=1 reuse=2 reusefb=1", Some(Wrong::Nonce));
+        fx.assert_accepted(outcome, &block);
+        assert!(log.contains("eap reusefb block=1 reused=1 outcome=accepted "), "{log}");
+        assert!(log.contains(" at=exec first="), "{log}");
+        assert_eq!(hooks, 0);
+    }
+}
diff --git a/crates/engine/tree/src/tree/plan_store.rs b/crates/engine/tree/src/tree/plan_store.rs
new file mode 100644
index 0000000000000000000000000000000000000000..fe51d6656a08ed291e11bf35533958c8249c8934
--- /dev/null
+++ b/crates/engine/tree/src/tree/plan_store.rs
@@ -0,0 +1,503 @@
+//! X-027 (Master 11-02, researcher's request): on-demand loading of the access plans.
+//!
+//! Before: every `<code hash>.eapf` of `EAP_PLANS` was read and analysed at start into one table that stayed resident
+//! (plans_final: 51,794 plans, 9.0 GB resident with jemalloc, ~/Lab/work/20261102_port290/planmem). Now the start only
+//! lists the directory (code hash -> file); a plan is read the first time a lookup asks for it, by one of the loader
+//! threads (`eap-plan-ld`), and kept in a cache capped in bytes (`EAP_PLAN_CACHE_MB`, default 5120; least recently used
+//! plans leave first). A lookup that misses returns no plan (this call goes on as if the code had none) and queues the
+//! load; loads in flight are deduplicated by hash. Lookups from the readers' transaction step (entry contracts at block
+//! arrival) go to the front of the queue. A plan's content and its evaluation are unchanged: a loaded plan is
+//! `Plan::parse_analyzed` of the same bytes, behind an `Arc` so that eviction never frees a plan in use.
+//! `EAP_PLAN_PRELOAD=1` restores the old behaviour (everything loaded and kept, no eviction) for comparison.
+//! One `eap plans` line per block reports the cache (see [`PlanStore::log_block`]).
+
+use alloy_primitives::B256;
+use frame_plan::Plan;
+use parking_lot::{Condvar, Mutex};
+use std::{
+    collections::{BTreeMap, HashMap, HashSet, VecDeque},
+    path::PathBuf,
+    sync::{
+        atomic::{AtomicU64, Ordering},
+        Arc,
+    },
+    time::Instant,
+};
+use tracing::{info, warn};
+
+/// Roles of the thread whose lookup missed (by thread name): pre-execution / prewarm workers, speculative-pass helpers,
+/// readers, the prewarm dispatch thread, any other.
+const ROLES: [&str; 5] = ["pw", "nb", "rd", "ds", "ot"];
+
+fn role_of_current_thread() -> usize {
+    let t = std::thread::current();
+    let n = t.name().unwrap_or("");
+    let p = |x: &str| n.starts_with(x);
+    if p("prewarm-txs") {
+        3
+    } else if p("prewarm") || p("eap-warm") || p("eap-heavy") || p("eap-split") {
+        0
+    } else if p("eap-nb") {
+        1
+    } else if p("eap-read") {
+        2
+    } else {
+        4
+    }
+}
+
+#[derive(Default)]
+struct Cache {
+    /// hash -> (plan, bytes, tick of the last use)
+    map: HashMap<B256, (Arc<Plan>, usize, u64)>,
+    /// tick of the last use -> hash (least recent first)
+    order: BTreeMap<u64, B256>,
+    tick: u64,
+    bytes: usize,
+    /// files that failed the header check or the parse (never retried)
+    rejected: HashSet<B256>,
+}
+
+/// What the cache holds for a code hash ([`PlanStore::lookup`]).
+enum Cached {
+    Hit(Arc<Plan>),
+    /// the file failed the header check or the parse
+    Rejected,
+    No,
+}
+
+#[derive(Default)]
+struct Queue {
+    hi: VecDeque<B256>,
+    lo: VecDeque<B256>,
+    /// queued or being loaded
+    pending: HashSet<B256>,
+    closed: bool,
+}
+
+#[derive(Default)]
+struct Counters {
+    hits: AtomicU64,
+    misses: AtomicU64,
+    /// lookups of code without a plan file
+    absent: AtomicU64,
+    loads: AtomicU64,
+    load_ns: AtomicU64,
+    load_max_ns: AtomicU64,
+    evicted: AtomicU64,
+    rejected: AtomicU64,
+    /// misses whose load was already queued or running
+    dedup: AtomicU64,
+    /// EXP-236: lookups by [`PlanStore::try_get`] that found the cache's or the queue's lock held and gave up
+    busy: AtomicU64,
+    miss_role: [AtomicU64; 5],
+}
+
+/// The plan table: an index of the library's files and a byte-capped cache of the loaded plans.
+pub(crate) struct PlanStore {
+    files: HashMap<B256, PathBuf>,
+    cap: usize,
+    cache: Mutex<Cache>,
+    queue: Mutex<Queue>,
+    cv: Condvar,
+    c: Counters,
+    preload: bool,
+}
+
+impl std::fmt::Debug for PlanStore {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("PlanStore").field("files", &self.files.len()).field("cap", &self.cap).finish_non_exhaustive()
+    }
+}
+
+/// Header check before a plan file is parsed: magic `EAPF`, format version 1, 2 or 3, at least the kind word.
+pub(crate) fn plan_header_ok(b: &[u8]) -> bool {
+    b.len() >= 12 && &b[0..4] == b"EAPF" && matches!(u32::from_le_bytes([b[4], b[5], b[6], b[7]]), 1..=3)
+}
+
+/// Reads and parses one plan file as the old loader did (EXP-147: a bad file is rejected, not a panic).
+pub(crate) fn load_plan_file(path: &std::path::Path) -> Option<Plan> {
+    let b = std::fs::read(path).ok()?;
+    if !plan_header_ok(&b) {
+        return None
+    }
+    std::panic::catch_unwind(|| Plan::parse_analyzed(&b)).ok()
+}
+
+impl PlanStore {
+    fn empty(files: HashMap<B256, PathBuf>, cap: usize, preload: bool) -> Self {
+        Self {
+            files,
+            cap,
+            cache: Mutex::new(Cache::default()),
+            queue: Mutex::new(Queue::default()),
+            cv: Condvar::new(),
+            c: Counters::default(),
+            preload,
+        }
+    }
+
+    /// Lists `<hash>.eapf` in `dir` (the names only).
+    pub(crate) fn index(dir: &std::path::Path) -> HashMap<B256, PathBuf> {
+        let mut files = HashMap::new();
+        if let Ok(rd) = std::fs::read_dir(dir) {
+            for e in rd.flatten() {
+                let name = e.file_name();
+                let Some(stem) = name.to_str().and_then(|n| n.strip_suffix(".eapf")) else { continue };
+                let Ok(h) = stem.trim_start_matches("0x").parse::<B256>() else { continue };
+                files.insert(h, e.path());
+            }
+        }
+        files
+    }
+
+    /// The node's table from `EAP_PLANS`: the index, the cap and (`EAP_PLAN_PRELOAD=1`) every plan loaded now; with
+    /// loading on demand, `loaders` threads are started.
+    pub(crate) fn open(dir: &std::path::Path, cap_mb: usize, preload: bool, loaders: usize) -> Arc<Self> {
+        let t0 = Instant::now();
+        let files = Self::index(dir);
+        let store = Arc::new(Self::empty(files, if preload { usize::MAX } else { cap_mb << 20 }, preload));
+        if preload {
+            let mut paths: Vec<_> = store.files.iter().map(|(h, p)| (*h, p.clone())).collect();
+            paths.sort();
+            for (h, p) in paths {
+                store.load_now(h, &p);
+            }
+        } else {
+            for i in 0..loaders {
+                let s = store.clone();
+                let _ = std::thread::Builder::new().name(format!("eap-plan-ld{i}")).spawn(move || s.loader());
+            }
+        }
+        info!(target: "reth::eap", files = store.files.len(), preload, cap_mb, loaders, loaded = store.cache.lock().map.len(),
+            rejected = store.c.rejected.load(Ordering::Relaxed), elapsed_ms = t0.elapsed().as_millis() as u64,
+            "access plans indexed");
+        store
+    }
+
+    /// A table holding `plans` (tests): no files, nothing to load, no eviction.
+    #[cfg(test)]
+    pub(crate) fn preloaded(plans: HashMap<B256, Plan>) -> Self {
+        let s = Self::empty(HashMap::new(), usize::MAX, true);
+        for (h, p) in plans {
+            s.insert(h, p);
+        }
+        s
+    }
+
+    /// The plan of code `h`: `None` when the library has no plan for it, or (loading on demand) when it is not loaded
+    /// yet, in which case its load is queued (`entry`: ahead of the other loads).
+    pub(crate) fn get_with(&self, h: &B256, entry: bool) -> Option<Arc<Plan>> {
+        match self.lookup(&mut self.cache.lock(), h) {
+            Cached::Hit(p) => return Some(p),
+            Cached::Rejected => return None,
+            Cached::No => {}
+        }
+        if self.preload || !self.files.contains_key(h) {
+            self.c.absent.fetch_add(1, Ordering::Relaxed);
+            return None
+        }
+        self.c.misses.fetch_add(1, Ordering::Relaxed);
+        self.c.miss_role[role_of_current_thread()].fetch_add(1, Ordering::Relaxed);
+        self.request(*h, entry);
+        None
+    }
+
+    /// [`Self::get_with`] for a call-start lookup.
+    pub(crate) fn get(&self, h: &B256) -> Option<Arc<Plan>> {
+        self.get_with(h, false)
+    }
+
+    /// EXP-236: [`Self::get`] for the block executor's call-start hook, which must not wait for another thread: when the
+    /// cache's lock is held the lookup gives `None` (counted as `busy`), and the load of a plan not loaded yet is queued
+    /// only when the queue's lock is free.
+    pub(crate) fn try_get(&self, h: &B256) -> Option<Arc<Plan>> {
+        let Some(mut c) = self.cache.try_lock() else {
+            self.c.busy.fetch_add(1, Ordering::Relaxed);
+            return None
+        };
+        match self.lookup(&mut c, h) {
+            Cached::Hit(p) => return Some(p),
+            Cached::Rejected => return None,
+            Cached::No => {}
+        }
+        drop(c);
+        if self.preload || !self.files.contains_key(h) {
+            self.c.absent.fetch_add(1, Ordering::Relaxed);
+            return None
+        }
+        self.c.misses.fetch_add(1, Ordering::Relaxed);
+        self.c.miss_role[role_of_current_thread()].fetch_add(1, Ordering::Relaxed);
+        let Some(mut q) = self.queue.try_lock() else {
+            self.c.busy.fetch_add(1, Ordering::Relaxed);
+            return None
+        };
+        if !q.pending.insert(*h) {
+            self.c.dedup.fetch_add(1, Ordering::Relaxed);
+            return None
+        }
+        q.lo.push_back(*h);
+        drop(q);
+        self.cv.notify_one();
+        None
+    }
+
+    /// The cached part of a lookup; on a hit the plan's last use moves to now.
+    fn lookup(&self, c: &mut Cache, h: &B256) -> Cached {
+        c.tick += 1;
+        let tick = c.tick;
+        if let Some(e) = c.map.get_mut(h) {
+            c.order.remove(&e.2);
+            e.2 = tick;
+            c.order.insert(tick, *h);
+            self.c.hits.fetch_add(1, Ordering::Relaxed);
+            return Cached::Hit(e.0.clone())
+        }
+        if c.rejected.contains(h) { Cached::Rejected } else { Cached::No }
+    }
+
+    fn request(&self, h: B256, entry: bool) {
+        let mut q = self.queue.lock();
+        if !q.pending.insert(h) {
+            self.c.dedup.fetch_add(1, Ordering::Relaxed);
+            return
+        }
+        if entry {
+            q.hi.push_back(h);
+        } else {
+            q.lo.push_back(h);
+        }
+        drop(q);
+        self.cv.notify_one();
+    }
+
+    fn loader(&self) {
+        loop {
+            let h = {
+                let mut q = self.queue.lock();
+                loop {
+                    if let Some(h) = q.hi.pop_front().or_else(|| q.lo.pop_front()) {
+                        break h
+                    }
+                    if q.closed {
+                        return
+                    }
+                    self.cv.wait(&mut q);
+                }
+            };
+            if let Some(p) = self.files.get(&h) {
+                self.load_now(h, p);
+            }
+            // removed only after the plan is in the cache (or rejected), so a lookup in between finds it pending
+            self.queue.lock().pending.remove(&h);
+        }
+    }
+
+    /// Stops the loader threads once the queue is empty (tests).
+    #[cfg(test)]
+    pub(crate) fn close(&self) {
+        self.queue.lock().closed = true;
+        self.cv.notify_all();
+    }
+
+    fn load_now(&self, h: B256, path: &std::path::Path) {
+        let t0 = Instant::now();
+        let plan = load_plan_file(path);
+        let ns = t0.elapsed().as_nanos() as u64;
+        self.c.load_ns.fetch_add(ns, Ordering::Relaxed);
+        self.c.load_max_ns.fetch_max(ns, Ordering::Relaxed);
+        match plan {
+            Some(p) => {
+                self.c.loads.fetch_add(1, Ordering::Relaxed);
+                self.insert(h, p);
+            }
+            None => {
+                self.c.rejected.fetch_add(1, Ordering::Relaxed);
+                self.cache.lock().rejected.insert(h);
+                warn!(target: "reth::eap", file = %path.display(), "access plan rejected (bad header or parse failure)");
+            }
+        }
+    }
+
+    fn insert(&self, h: B256, p: Plan) {
+        let bytes = p.heap_bytes();
+        let mut c = self.cache.lock();
+        let c = &mut *c;
+        if c.map.contains_key(&h) {
+            return
+        }
+        c.tick += 1;
+        let tick = c.tick;
+        c.map.insert(h, (Arc::new(p), bytes, tick));
+        c.order.insert(tick, h);
+        c.bytes += bytes;
+        // evict the least recently used plans while over the cap; the plan just loaded stays
+        while c.bytes > self.cap && c.order.len() > 1 {
+            let Some((&t, &old)) = c.order.iter().next() else { break };
+            if old == h {
+                break
+            }
+            c.order.remove(&t);
+            if let Some((_, b, _)) = c.map.remove(&old) {
+                c.bytes -= b;
+                self.c.evicted.fetch_add(1, Ordering::Relaxed);
+            }
+        }
+    }
+
+    /// Plans held and their bytes.
+    pub(crate) fn held(&self) -> (usize, usize) {
+        let c = self.cache.lock();
+        (c.map.len(), c.bytes)
+    }
+
+    /// Loads queued or running.
+    pub(crate) fn queued(&self) -> usize {
+        self.queue.lock().pending.len()
+    }
+
+    /// One `eap plans` line for block `block`: this block's lookups (hits, misses by the role of the missing thread,
+    /// lookups of code without a plan), loads (count, time, longest), evictions, deduplicated misses, rejected files;
+    /// the plans and bytes held, the loads still queued, and the process's resident memory. The counters restart.
+    pub(crate) fn log_block(&self, block: u64) {
+        let t = |a: &AtomicU64| a.swap(0, Ordering::Relaxed);
+        // Prologue (`logq`, X-031): no line; the counters still restart
+        if crate::tree::eap::logq() {
+            for a in [&self.c.hits, &self.c.misses, &self.c.absent, &self.c.loads, &self.c.load_ns, &self.c.load_max_ns, &self.c.evicted, &self.c.dedup, &self.c.rejected, &self.c.busy] {
+                t(a);
+            }
+            for a in &self.c.miss_role {
+                t(a);
+            }
+            return
+        }
+        let (n_held, bytes) = self.held();
+        let roles: Vec<String> = ROLES.iter().zip(&self.c.miss_role).map(|(r, a)| format!("{r}:{}", t(a))).collect();
+        info!(target: "reth::eap",
+            "eap plans block={block} preload={} hits={} misses={} absent={} loads={} load_us={} load_max_us={} evicted={} dedup={} rejected={} busy={} held={} held_mb={} cap_mb={} queued={} rss_mb={} miss_roles={}",
+            self.preload, t(&self.c.hits), t(&self.c.misses), t(&self.c.absent), t(&self.c.loads), t(&self.c.load_ns) / 1000,
+            t(&self.c.load_max_ns) / 1000, t(&self.c.evicted), t(&self.c.dedup), t(&self.c.rejected), t(&self.c.busy), n_held, bytes >> 20,
+            if self.cap == usize::MAX { 0 } else { self.cap >> 20 }, self.queued(), rss_mb(), roles.join(","));
+    }
+}
+
+/// This process's resident memory in MB (`/proc/self/statm`, second field, in pages of 4 KB).
+fn rss_mb() -> u64 {
+    std::fs::read_to_string("/proc/self/statm")
+        .ok()
+        .and_then(|s| s.split_whitespace().nth(1).and_then(|v| v.parse::<u64>().ok()))
+        .map_or(0, |pages| pages * 4096 >> 20)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Writes `n` small plan files with distinct contents into a fresh directory; returns it and the hashes.
+    fn library(n: usize) -> (PathBuf, Vec<B256>) {
+        let dir = std::env::temp_dir().join(format!("x027-plans-{}-{n}-{:?}", std::process::id(), std::thread::current().id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        let mut hs = Vec::new();
+        for i in 0..n {
+            let mut p = Plan::default();
+            p.version = 1;
+            p.consts = vec![alloy_primitives::U256::from(i as u64 + 1); i + 1];
+            p.nodes = vec![frame_plan::Node { w0: 0, a: 0, b: 0, n: 0 }; 2];
+            p.side = vec![0, 1];
+            p.list_off = vec![0, 0];
+            p.sgroups = vec![2, 3];
+            p.salts = vec![[0, 0, 0, 0], [1, 0, 0, 0]];
+            let h = B256::with_last_byte(i as u8 + 1);
+            std::fs::write(dir.join(format!("{h:x}.eapf")), p.to_bytes()).unwrap();
+            hs.push(h);
+        }
+        (dir, hs)
+    }
+
+    fn wait_loaded(s: &PlanStore, h: &B256) -> Arc<Plan> {
+        let t0 = Instant::now();
+        loop {
+            if let Some(p) = s.get(h) {
+                return p
+            }
+            assert!(t0.elapsed().as_secs() < 10, "plan {h} not loaded");
+            std::thread::sleep(std::time::Duration::from_millis(2));
+        }
+    }
+
+    /// A plan loaded on demand is field for field the plan of the old full preload (the same file through
+    /// `Plan::parse_analyzed`); the first lookup misses and queues the load.
+    #[test]
+    fn on_demand_equals_preload() {
+        let (dir, hs) = library(4);
+        let pre = PlanStore::open(&dir, 0, true, 0);
+        let lazy = PlanStore::open(&dir, 5120, false, 2);
+        for h in &hs {
+            let a = pre.get(h).expect("preloaded");
+            assert!(lazy.get(h).is_none() || lazy.held().0 > 0);
+            let b = wait_loaded(&lazy, h);
+            assert_eq!(format!("{a:?}"), format!("{b:?}"));
+            assert_eq!(format!("{b:?}"), format!("{:?}", Plan::parse_analyzed(&std::fs::read(&pre.files[h]).unwrap())));
+        }
+        assert!(lazy.get(&B256::repeat_byte(0xee)).is_none(), "code without a plan file");
+        assert_eq!(lazy.c.absent.load(Ordering::Relaxed), 1);
+        lazy.close();
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    /// With a cap that holds one plan, loading a second evicts the first; the first loads again on its next lookup and
+    /// is the same plan as before.
+    #[test]
+    fn evicted_plan_reloads_unchanged() {
+        let (dir, hs) = library(2);
+        let s = PlanStore::open(&dir, 0, false, 1);
+        let a0 = format!("{:?}", wait_loaded(&s, &hs[0]));
+        let _ = wait_loaded(&s, &hs[1]);
+        assert_eq!(s.held().0, 1, "cap 0 MB keeps only the plan just loaded");
+        assert!(s.c.evicted.load(Ordering::Relaxed) >= 1);
+        assert_eq!(format!("{:?}", wait_loaded(&s, &hs[0])), a0);
+        s.close();
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    /// EXP-236: `try_get` finds what `get` finds; while another thread holds the cache's lock it gives up at once
+    /// (counted as busy) instead of waiting, and a plan not loaded yet is queued and then found.
+    #[test]
+    fn try_get_never_waits() {
+        let (dir, hs) = library(2);
+        let s = PlanStore::open(&dir, 5120, false, 1);
+        let p = wait_loaded(&s, &hs[0]);
+        assert_eq!(format!("{:?}", s.try_get(&hs[0]).expect("loaded")), format!("{p:?}"));
+        let held = s.cache.lock();
+        assert!(s.try_get(&hs[0]).is_none());
+        assert_eq!(s.c.busy.load(Ordering::Relaxed), 1);
+        drop(held);
+        let t0 = Instant::now();
+        while s.try_get(&hs[1]).is_none() {
+            assert!(t0.elapsed().as_secs() < 10, "plan not loaded");
+            std::thread::sleep(std::time::Duration::from_millis(2));
+        }
+        assert!(s.try_get(&B256::repeat_byte(0xee)).is_none(), "code without a plan file");
+        s.close();
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    /// Many misses of one plan while its load is queued queue it once.
+    #[test]
+    fn loads_in_flight_are_deduplicated() {
+        let (dir, hs) = library(1);
+        // no loader threads: the request stays queued
+        let s = PlanStore::open(&dir, 5120, false, 0);
+        for _ in 0..10 {
+            assert!(s.get(&hs[0]).is_none());
+        }
+        assert_eq!(s.queued(), 1);
+        assert_eq!(s.c.misses.load(Ordering::Relaxed), 10);
+        assert_eq!(s.c.dedup.load(Ordering::Relaxed), 9);
+        let q = s.queue.lock();
+        assert_eq!(q.lo.len() + q.hi.len(), 1);
+        drop(q);
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+}
