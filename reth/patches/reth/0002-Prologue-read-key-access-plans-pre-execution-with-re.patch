+    /// EXP-199 (`eap sched` line): the reserved core reported is the core of the execution thread's set that the others'
+    /// set leaves out, none without a reservation; the slice of a thread that never set one is 0.
+    #[test]
+    fn reserved_core_is_the_core_others_leave() {
+        // the sets as `reserve_exec_core` leaves them, built here: other tests validating blocks reset the global
+        // reservation (`refresh`), so the global is not used
+        // SAFETY: zeroed, CPU_ZERO, CPU_SET and CPU_CLR only write bits of the local sets (an all-zero cpu_set_t is valid).
+        let (full, others) = unsafe {
+            let mut full: libc::cpu_set_t = std::mem::zeroed();
+            libc::CPU_ZERO(&mut full);
