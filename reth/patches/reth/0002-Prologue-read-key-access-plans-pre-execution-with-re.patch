+    /// Prologue (`exsmt`, X-031): a set without any CPU to clear is left alone (`None`); otherwise the CPUs to clear
+    /// leave it; a set left empty takes the fallback less those CPUs, and gets nothing without a fallback or when the
+    /// fallback has no other CPU.
+    #[test]
+    fn exsmt_clear_cpus() {
+        // SAFETY (this test): a zeroed cpu_set_t is valid; CPU_SET and CPU_ISSET only touch bits of the given sets.
+        let set = |cpus: &[usize]| {
+            let mut s: libc::cpu_set_t = unsafe { std::mem::zeroed() };
+            for &c in cpus {
+                unsafe { libc::CPU_SET(c, &mut s) };
+            }
+            s
+        };
+        let list = |s: &libc::cpu_set_t| (0..64).filter(|c| unsafe { libc::CPU_ISSET(*c, s) }).collect::<Vec<_>>();
+        let full = set(&(0..28).collect::<Vec<_>>());
+        assert!(clear_cpus(&set(&[1, 2, 3]), &[0, 16], Some(&full)).is_none());
+        assert_eq!(list(&clear_cpus(&set(&[0, 1, 16, 17]), &[0, 16], Some(&full)).unwrap()), vec![1, 17]);
+        assert_eq!(list(&clear_cpus(&set(&[0, 1]), &[0], None).unwrap()), vec![1]);
+        let rest = clear_cpus(&set(&[0, 16]), &[0, 16], Some(&full)).unwrap();
+        assert_eq!(list(&rest), (1..28).filter(|c| *c != 16).collect::<Vec<_>>());
+        assert!(clear_cpus(&set(&[0, 16]), &[0, 16], None).is_none());
+        assert!(clear_cpus(&set(&[0]), &[0, 16], Some(&set(&[0, 16]))).is_none());
+    }
