+        let cs = [U256::ZERO, one, U256::from(5u8), U256::from(33u8), t, t + one, t - one, U256::MAX, U256::MAX - one];
+        let (mut n, mut s1, mut s2) = (0u64, 0u64, 0u64);
+        for &a in &[U256::MAX, U256::MAX - one] {
