+    /// Prologue (`exphys`): the execution thread's pin to one CPU of its set and the change back. Pinned, the thread
+    /// runs on that CPU alone; the change back gives it the set it had; an execution start that finds a pin kept (its
+    /// end was not reached) changes it back first, also when the block has no pin; a pin while a set is still kept
+    /// (its change back was refused) keeps that set to go back to; a refused pin leaves the thread as it was. A thread
+    /// of its own; skipped when its set has fewer than two CPUs.
+    #[test]
+    fn exphys_pin_and_change_back() {
+        std::thread::spawn(|| {
+            let full = own_affinity().expect("the thread's CPU set");
+            // SAFETY (this test): a zeroed cpu_set_t is valid; the CPU_* functions only read or write bits of the given
+            // sets; sched_getcpu and sysconf have no preconditions.
+            let cpus: Vec<usize> =
+                (0..libc::CPU_SETSIZE as usize).filter(|c| unsafe { libc::CPU_ISSET(*c, &full) }).collect();
+            if cpus.len() < 2 {
+                return
+            }
+            let now = || own_affinity().expect("the thread's CPU set");
+            let only = |c: usize| {
+                let s = now();
+                unsafe { libc::CPU_COUNT(&s) == 1 && libc::CPU_ISSET(c, &s) }
+            };
+            let same = |s: &libc::cpu_set_t| unsafe { libc::CPU_EQUAL(&now(), s) };
+            assert_eq!(exphys_unpin(), 0, "not pinned: nothing to change back");
+            assert_eq!(exphys_exec_start_with(None), 0, "no pin asked");
+            assert!(same(&full));
+            assert_eq!(exphys_exec_start_with(Some(cpus[1])), 1);
+            assert!(only(cpus[1]));
+            assert_eq!(unsafe { libc::sched_getcpu() }, cpus[1] as i32, "running on the CPU");
+            // the next execution start without the end: back first, so the set to go back to is still the full one.
+            assert_eq!(exphys_exec_start_with(Some(cpus[0])), 1);
+            assert!(only(cpus[0]));
+            assert_eq!(exphys_unpin(), 1);
+            assert!(same(&full));
+            assert_eq!(exphys_unpin(), 0);
+            assert!(same(&full) && PHYS_BEFORE.with(|b| b.get()).is_none());
+            // a block without a pin: its execution start gives a kept pin back.
+            assert_eq!(exphys_exec_start_with(Some(cpus[1])), 1);
+            assert_eq!(exphys_exec_start_with(None), 0);
+            assert!(same(&full) && PHYS_BEFORE.with(|b| b.get()).is_none());
+            // a set still kept from a refused change back stays the one to go back to.
+            let kept = unsafe {
+                let mut s: libc::cpu_set_t = std::mem::zeroed();
+                libc::CPU_SET(cpus[1], &mut s);
+                s
+            };
+            PHYS_BEFORE.with(|b| b.set(Some(kept)));
+            assert_eq!(exphys_pin(cpus[0]), 1);
+            assert_eq!(exphys_unpin(), 1);
+            assert!(same(&kept));
+            assert!(set_own_affinity(&full));
+            // a CPU this machine does not have: refused with EINVAL, the thread keeps its set, nothing is kept.
+            let configured = unsafe { libc::sysconf(libc::_SC_NPROCESSORS_CONF) };
+            if configured < 1024 {
+                assert_eq!(exphys_pin(1023), -i64::from(libc::EINVAL));
+                assert!(same(&full) && PHYS_BEFORE.with(|b| b.get()).is_none());
+            }
+        })
+        .join()
+        .unwrap();
+    }
