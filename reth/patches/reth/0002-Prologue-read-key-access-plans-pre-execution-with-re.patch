+/// Retention occurs at the scratch field's original drop position, after the provider.
+struct ReaderScratch {
+    inner: Scratch,
+    retained_stats: Option<Arc<Stats>>,
+}
+
+impl std::ops::Deref for ReaderScratch {
+    type Target = Scratch;
+
+    fn deref(&self) -> &Self::Target {
+        &self.inner
+    }
+}
+
+impl std::ops::DerefMut for ReaderScratch {
+    fn deref_mut(&mut self) -> &mut Self::Target {
+        &mut self.inner
+    }
+}
+
+impl Drop for ReaderScratch {
+    fn drop(&mut self) {
+        if let Some(stats) = &self.retained_stats {
+            retain_reader_scratch(std::mem::take(&mut self.inner), stats);
+        }
+    }
+}
+
+/// Maximum solver vector capacity retained by a pooled reader.
+const READER_SCRATCH_LIMIT: usize = 16 * 1024 * 1024;
+
+thread_local! {
+    static READER_SCRATCH: std::cell::RefCell<Option<Scratch>> = const { std::cell::RefCell::new(None) };
+}
+
+fn reader_scratch(mode: Mode, stats: &Arc<Stats>) -> ReaderScratch {
+    let kept = READER_SCRATCH.with(|slot| slot.borrow_mut().take());
+    let keep = mode.rdscratch && mode.rdpool && mode.rdnice == 0;
+    let mut sc = if keep {
+        if let Some(sc) = kept {
+            stats.scratch_reused.fetch_add(1, Ordering::Relaxed);
+            sc
+        } else {
+            Scratch::default()
+        }
+    } else {
+        // A block that disables reuse releases this thread's previous retained allocation.
+        drop(kept);
+        Scratch::default()
+    };
+    sc.interval = true;
+    sc.improved = mode.fpimp;
+    sc.sat_classes = mode.satcls;
+    sc.no_cons = mode.nocons;
+    ReaderScratch { inner: sc, retained_stats: keep.then(|| Arc::clone(stats)) }
+}
+
+fn retain_reader_scratch(mut sc: Scratch, stats: &Stats) {
+    // No predicted keys or generated call payloads survive the job. Memo tables keep only
+    // capacity; their contents cannot be used without the next instantiate's new stamp.
+    sc.out.clear();
+    sc.calls.clear();
+    sc.call_idx.clear();
+    sc.call_holes.clear();
+    sc.chk_log.clear();
+    sc.chk_first_bad = None;
+    let bytes = sc.retained_bytes();
+    if bytes > READER_SCRATCH_LIMIT {
+        stats.scratch_discarded.fetch_add(1, Ordering::Relaxed);
+        return;
+    }
+    stats.scratch_retained.fetch_add(1, Ordering::Relaxed);
+    stats.scratch_bytes.fetch_add(bytes as u64, Ordering::Relaxed);
+    READER_SCRATCH.with(|slot| *slot.borrow_mut() = Some(sc));
+}
