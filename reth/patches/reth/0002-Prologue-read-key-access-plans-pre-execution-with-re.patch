+        let mut calls = vec![
+            c(0, 1, None),
+            c(0, 1, None),
+            c(0, 1, Some(&[1, 2])),
+            c(0, 1, Some(&[1, 2])),
+            c(0, 1, Some(&[1, 3])),
+            c(3, 1, Some(&[1, 2])),
+            c(0, 2, None),
+            c(0, 1, None),
+        ];
+        assert_eq!(dedup_calls(&mut calls), 3);
+        let left: Vec<(u8, U256, Option<Vec<u8>>)> = calls.iter().map(|x| (x.kind, x.target, x.payload.clone())).collect();
+        let (t1, t2) = (U256::from(1u8), U256::from(2u8));
+        assert_eq!(
+            left,
+            vec![(0, t1, None), (0, t1, Some(vec![1, 2])), (0, t1, Some(vec![1, 3])), (3, t1, Some(vec![1, 2])), (0, t2, None)]
+        );
+        let mut one = vec![c(0, 1, None)];
+        assert_eq!(dedup_calls(&mut one), 0);
+        assert_eq!(one.len(), 1);
+        let mut none: Vec<frame_plan::CallOut> = Vec::new();
+        assert_eq!(dedup_calls(&mut none), 0);
+        assert!(!Mode::OFF.ctdedup && !Mode::parse("prewarm=1").ctdedup);
+        let on = Mode::parse("prewarm=1 ctdedup=1 ctpay=1");
+        assert!(on.ctdedup && on.ctpay);
+    }
+
+    /// EXP-199 (`rdpeek`): the queued or unlisted slots in the execution cache (a cached zero too) are left out and marked
+    /// read, with the source they were queued under; a slot being read or read is kept, unchanged and not looked up; the
+    /// others stay, in order and unmarked; another address's slot is not cached; the counters; the switch is off by default
+    /// and parses
+    #[test]
+    fn peek_filter_leaves_out_cached_slots() {
+        // 8 MiB (the size is in bytes): at least 32,768 storage entries, so two of the 5 cached slots share a bucket (one
+        // entry each, randomly seeded hash) and evict each other with a chance below 0.04%
+        let c = reth_execution_cache::ExecutionCache::new(8 << 20);
+        let a = Address::repeat_byte(7);
+        let k = |n: u64| U256::from(n);
+        let b = |n: u64| B256::from(U256::from(n));
+        for n in [2u64, 4, 5] {
+            c.insert_storage(a, b(n), Some(U256::from(n * 10)));
+        }
+        c.insert_storage(a, b(6), None);
+        c.insert_storage(a, b(7), Some(U256::from(70u8)));
+        let issued = Mutex::new(Issued::default());
+        {
+            let mut g = issued.lock();
+            g.slots.insert((a, b(2)), (0, 3));
+            g.slots.insert((a, b(5)), (1, 3));
+            g.slots.insert((a, b(7)), (2, 3));
+            g.slots.insert((a, b(1)), (0, 3));
+        }
+        let stats = Stats::default();
+        let kept = peek_filter(&c, &issued, &stats, a, &[k(1), k(2), k(3), k(4), k(5), k(6), k(7)], 9);
+        // 5 (being read) and 7 (read) are kept without a lookup; 2, 4, 6 are cached; 1 and 3 are not
+        assert_eq!(kept, vec![k(1), k(3), k(5), k(7)]);
+        {
+            let g = issued.lock();
+            assert_eq!(g.slots.get(&(a, b(2))), Some(&(2, 3)));
+            assert_eq!(g.slots.get(&(a, b(4))), Some(&(2, 9)));
+            assert_eq!(g.slots.get(&(a, b(5))), Some(&(1, 3)));
+            assert_eq!(g.slots.get(&(a, b(6))), Some(&(2, 9)));
+            assert_eq!(g.slots.get(&(a, b(7))), Some(&(2, 3)));
+            assert_eq!(g.slots.get(&(a, b(1))), Some(&(0, 3)));
+            assert_eq!(g.slots.get(&(a, b(3))), None);
+        }
+        assert_eq!(stats.rd_peek_keys.load(Ordering::Relaxed), 5);
+        assert_eq!(stats.rd_peek_skip.load(Ordering::Relaxed), 3);
+        assert_eq!(peek_filter(&c, &issued, &stats, Address::repeat_byte(8), &[k(2)], 9), vec![k(2)]);
+        assert_eq!(stats.rd_peek_keys.load(Ordering::Relaxed), 6);
+        assert_eq!(stats.rd_peek_skip.load(Ordering::Relaxed), 3);
+        assert!(!Mode::OFF.rdpeek && !Mode::parse("prewarm=1").rdpeek);
+        assert!(Mode::parse("prewarm=1 rdpeek=1").rdpeek);
+    }
+
+    /// EXP-199 (`fpimp`): the improved solver gives the same index sets as the interval solver where that one solves and
+    /// as the value-by-value check (direct evaluation of the affine value, what the fallback evaluates) everywhere it
+    /// solves, so on and off give the same keys (a port of frame_plan's `solve_affine2_matches_valuewise`, which the build
+    /// does not run), with the count-down loop condition that wraps once as a fixed case; the switch is off by default and
+    /// parses; a kept scratch takes the block's choice when taken
+    #[test]
+    fn fpimp_solver_gives_the_same_sets_and_follows_the_block() {
+        let mut x: u64 = 0x2545F4914F6CDD1D;
+        let mut rnd = || {
+            x ^= x << 13;
+            x ^= x >> 7;
+            x ^= x << 17;
+            x
+        };
+        let picks = |r: u64, r2: u64| -> U256 {
+            let k = U256::from(r2 % 1000);
+            match r % 9 {
+                0 => k,
+                1 => U256::MAX - k,
+                2 => (U256::from(1u8) << 255) - k,
+                3 => (U256::from(1u8) << 255) + k,
+                4 => U256::from(r2),
+                5 => U256::from(r2) << 128,
+                6 => U256::ZERO.wrapping_sub(U256::from(r2 % 64)),
+                7 => U256::ZERO.wrapping_sub(U256::from(32u8 * (r2 % 4) as u8)),
+                _ => U256::from(r2 % 200),
+            }
+        };
+        // the satisfying set over [0, cap) by direct evaluation of the affine value, nothing at or above cap
+        let check = |a: U256, b: U256, c: U256, op: u8, signed: bool, want: bool, cap: u32, m: [u64; 8]| {
+            for v in 0..cap {
+                let f = a.wrapping_mul(U256::from(v)).wrapping_add(b);
+                let (fx, cx) = if signed {
+                    let t = U256::from(1u8) << 255;
+                    (f ^ t, c ^ t)
+                } else {
+                    (f, c)
+                };
+                let r = (match op { 0 => fx < cx, 1 => fx > cx, _ => fx == cx }) == want;
+                assert_eq!(r, (m[(v / 64) as usize] >> (v % 64)) & 1 == 1, "a={a:x} b={b:x} c={c:x} op={op} s={signed} w={want} cap={cap} v={v}");
+            }
+            for v in cap..512 {
+                assert_eq!((m[(v / 64) as usize] >> (v % 64)) & 1, 0, "cap={cap} v={v}");
+            }
+        };
+        // a count-down loop's condition (i = n - k > 0) wrapping once: the second piece starts at 2^256 - 1 (review of
+        // 5d9f3a2c: frame_plan_v3 solve_unsigned2's `q + 1` wrapped to 0 there and the piece came out empty or full)
+        // (signed: b ^ 2^255 = 5 and c ^ 2^255 = 0 after the solver's transform, i.e. c = INT_MIN)
+        for (b, c, signed) in [(U256::from(5u8), U256::ZERO, false), ((U256::from(1u8) << 255) + U256::from(5u8), U256::from(1u8) << 255, true)] {
+            for want in [false, true] {
+                for op in [0u8, 1] {
+                    let m = frame_plan::solve_affine2(U256::MAX, b, c, op, signed, want, 34).expect("one wrap is solved");
+                    check(U256::MAX, b, c, op, signed, want, 34, m);
+                }
+            }
+        }
+        let (mut solved, mut extra) = (0u64, 0u64);
+        for _ in 0..20_000 {
+            let (a, b, c) = (picks(rnd(), rnd()), picks(rnd(), rnd()), picks(rnd(), rnd()));
+            let cap = [34u32, 35, 37, 64, 65, 100, 128, 511, 512][(rnd() % 9) as usize];
+            for op in 0..3u8 {
+                for signed in [false, true] {
+                    for want in [false, true] {
+                        let old = frame_plan::solve_affine(a, b, c, op, signed, want, cap);
+                        let Some(m) = frame_plan::solve_affine2(a, b, c, op, signed, want, cap) else {
+                            assert!(old.is_none());
+                            continue
+                        };
+                        solved += 1;
+                        match old {
+                            Some(o) => assert_eq!(o, m),
+                            None => extra += 1,
+                        }
+                        check(a, b, c, op, signed, want, cap, m);
+                    }
+                }
+            }
+        }
+        assert!(solved > 0 && extra > 0, "solved {solved}, solved only by the improved solver {extra}");
+        assert!(!Mode::OFF.fpimp && !Mode::parse("prewarm=1").fpimp);
+        assert!(Mode::parse("prewarm=1 fpimp=1").fpimp);
+        // a kept scratch follows the block's choice each time it is taken (the choice given, not the global, which
+        // other tests' blocks may set)
+        let mut kept: Option<Scratch> = None;
+        assert!(scratch_with(&mut kept, true, false).improved);
+        assert!(!scratch_with(&mut kept, false, false).improved && kept.as_ref().is_some_and(|s| s.interval));
+        assert!(scratch_with(&mut kept, true, false).improved);
+        // EXP-199 (`satcls`): parsed, off by default, and the kept scratch follows the choice given in both directions
+        assert!(!Mode::OFF.satcls && !Mode::parse("prewarm=1 fpimp=1").satcls);
+        assert!(Mode::parse("prewarm=1 satcls=1").satcls);
+        let s = scratch_with(&mut kept, false, true);
+        assert!(s.sat_classes && !s.improved && s.interval);
+        assert!(!scratch_with(&mut kept, true, false).sat_classes);
+        // Prologue (`nocons`): parsed, off by default
+        assert!(!Mode::OFF.nocons && !Mode::parse("prewarm=1 fpimp=1").nocons);
+        assert!(Mode::parse("prewarm=1 nocons=1").nocons);
+    }
+
+    /// EXP-215 (`reusechkbg`, `reusechkbgtail`): off by default, tail 16; 1 and 2 (larger values are 2); parse with the
+    /// reuse switches
+    #[test]
+    fn reuse_background_check_switch_is_off_by_default() {
+        let base = Mode::parse("prewarm=1 reuse=2 reusechk=16 reusefast=1");
