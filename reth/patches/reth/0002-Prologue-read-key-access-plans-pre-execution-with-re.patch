+    /// EXP-240 (`srmk`): off, nothing is counted; on, only the messages handled after the send and
+    /// before the marker was taken count, and the marker's times are kept in order.
+    #[test]
+    fn srmk_counts_between_send_and_marker() {
+        srmk::begin_block(false);
+        assert!(!srmk::on());
+        srmk::begin_block(true);
+        assert!(srmk::on());
+        let t0 = reth_primitives_traits::FastInstant::now();
+        srmk::handled(srmk::HINTS, t0);
+        srmk::hashed_msg(t0);
+        assert_eq!(srmk::us_since_send(), None);
+        srmk::send(3);
+        srmk::hashed_msg(t0);
+        srmk::forward(2);
+        srmk::handled(srmk::HINTS, t0);
+        srmk::handled(srmk::PROOFS, t0);
+        srmk::recv();
+        srmk::handled(srmk::HASHED, t0);
+        srmk::leave();
+        let s = srmk::snapshot();
+        assert_eq!((s[srmk::SEND_QLEN], s[srmk::FWD_QLEN]), (3, 2));
+        assert_eq!(
+            (s[srmk::HASH_MSGS], s[srmk::HINTS], s[srmk::PROOFS], s[srmk::HASHED], s[srmk::RETURNS]),
+            (1, 1, 1, 0, 0)
+        );
+        assert!(s[srmk::SEND_NS] > 0);
+        assert!(s[srmk::SEND_NS] <= s[srmk::FWD_NS] && s[srmk::FWD_NS] <= s[srmk::RECV_NS]);
+        assert!(s[srmk::RECV_NS] <= s[srmk::LEAVE_NS]);
+        assert!(srmk::us_since_send().is_some());
+        srmk::begin_block(false);
+        assert_eq!(srmk::snapshot(), [0; srmk::N]);
+    }
+
+    /// EXP-240 (`srpf`): a job's keys are split into chunks of `CHUNK` targets (a storage job
+    /// without slots into one chunk for its trie's first node); a chunk is looked up while its job
+    /// is pending and the handle's prefetch is alive, and skipped afterwards. No thread is started:
+    /// the chunks are walked here with a walk that counts its calls.
+    #[test]
+    fn srpf_chunks_and_skips() {
+        let calls = Arc::new(AtomicUsize::new(0));
+        let walk: srpf::Walk = {
+            let calls = calls.clone();
+            Arc::new(move |accounts: &[ProofV2Target], storages: &[(B256, Vec<ProofV2Target>)]| {
+                calls.fetch_add(1, Ordering::Relaxed);
+                let n = accounts.len() + storages.iter().map(|(_, s)| s.len().max(1)).sum::<usize>();
+                Ok::<u64, ProviderError>(n as u64)
+            })
+        };
+        let prefetch = srpf::Prefetch::with_walk(walk);
+        let targets: Vec<_> = (0..20u8).map(|i| ProofV2Target::new(B256::repeat_byte(i))).collect();
+        let pending = || Arc::new(AtomicBool::new(false));
+
+        let done = pending();
+        let chunks = prefetch.storage_chunks(&done, B256::ZERO, &targets);
+        let lens: Vec<_> = chunks.iter().map(|c| c.storage.as_ref().unwrap().1.len()).collect();
+        assert_eq!(lens, [8, 8, 4]);
+        assert!(chunks.iter().all(|c| c.accounts.is_empty()));
+        assert_eq!(srpf::walk(&chunks[0]), Some(8));
+        done.store(true, Ordering::Relaxed);
+        assert_eq!(srpf::walk(&chunks[1]), None);
+
+        let root_only = prefetch.storage_chunks(&pending(), B256::ZERO, &[]);
+        assert_eq!(root_only.len(), 1);
+        assert_eq!(srpf::walk(&root_only[0]), Some(1));
+
+        let accounts = prefetch.account_chunks(&pending(), &targets[..9]);
+        let lens: Vec<_> = accounts.iter().map(|c| c.accounts.len()).collect();
+        assert_eq!(lens, [8, 1]);
+        assert!(accounts.iter().all(|c| c.storage.is_none()));
+        assert_eq!(srpf::walk(&accounts[1]), Some(1));
+
+        // the handle (and its prefetch) is gone: nothing is looked up any more
+        drop(prefetch);
+        assert_eq!(srpf::walk(&accounts[0]), None);
+        assert_eq!(calls.load(Ordering::Relaxed), 3);
+    }
+
+    /// EXP-240 (`srpfmk`): kept chunks wait for the marker, which sends only those of jobs not yet
+    /// done; after the marker, chunks are sent at once and nothing is kept.
+    #[test]
+    fn srpf_keeps_chunks_until_the_marker() {
+        let walk: srpf::Walk = Arc::new(|_: &[ProofV2Target], _: &[(B256, Vec<ProofV2Target>)]| {
+            Ok::<u64, ProviderError>(0)
+        });
+        let prefetch = srpf::Prefetch::with_walk(walk);
+        let targets: Vec<_> = (0..10u8).map(|i| ProofV2Target::new(B256::repeat_byte(i))).collect();
+        let (running, done) = (Arc::new(AtomicBool::new(false)), Arc::new(AtomicBool::new(false)));
+        prefetch.place(prefetch.account_chunks(&running, &targets), true);
+        prefetch.place(prefetch.storage_chunks(&done, B256::ZERO, &[]), true);
+        done.store(true, Ordering::Release);
+        assert_eq!(prefetch.marker(), 2);
+        prefetch.place(prefetch.storage_chunks(&running, B256::ZERO, &targets), true);
+        assert_eq!(prefetch.marker(), 0);
+    }
+
+    /// EXP-240 (`srpf`): the overlay provider looks up each account's leaf and its account trie
+    /// path below the known parent (lengths 1..=7 without one), each slot's leaf and its storage
+    /// trie path (1..=6), and the first node of a storage trie without slot targets.
+    #[test]
+    fn srpf_prefetch_counts_the_lookups_of_each_target() {
+        let provider_factory =
+            create_test_provider_factory_with_chain_spec(Arc::new(ChainSpec::default()));
+        let anchor_hash = reth_db_common::init::init_genesis(&provider_factory).unwrap();
+        let factory = reth_storage_overlay::OverlayStateProviderFactory::new(
+            provider_factory,
+            reth_storage_overlay::OverlayManager::<reth_ethereum_primitives::EthPrimitives>::default()
+                .overlay_builder(anchor_hash),
+        );
+        let provider = factory.database_provider_ro().unwrap();
+        let account = ProofV2Target::new(B256::repeat_byte(1));
+        let below_3 = ProofV2Target::new(B256::repeat_byte(2))
+            .with_parent(reth_trie::ProofV2TargetParent::new(3));
+        assert_eq!(provider.prefetch_proof_pages(&[account, below_3], &[]).unwrap(), (1 + 7) + (1 + 4));
+        let storages = [(B256::ZERO, vec![account]), (B256::repeat_byte(3), Vec::new())];
+        assert_eq!(provider.prefetch_proof_pages(&[], &storages).unwrap(), (1 + 6) + 1);
+        assert_eq!(provider.prefetch_proof_pages(&[], &[]).unwrap(), 0);
+    }
+
+    /// EXP-240 (`srtl`): jobs are split by the finish marker into running, queued and later
+    /// dispatched ones (on a local array: the global counters are shared with the other tests).
+    #[test]
+    fn srtl_splits_jobs_at_the_finish_marker() {
+        let stats = [const { std::sync::atomic::AtomicU64::new(0) }; srtl::N];
+        stats[srtl::POST_FIRST_DISPATCH_NS].store(u64::MAX, Ordering::Relaxed);
+        let m = 1_000;
+        // ends before the marker: totals only
+        srtl::record_into(&stats, m, 100, 200, 300, 0, false);
+        // dispatched and started before the marker, ends after it
+        srtl::record_into(&stats, m, 100, 200, 1_500, 2, false);
+        // dispatched before the marker, starts after it
+        srtl::record_into(&stats, m, 100, 1_200, 1_700, 1, true);
+        // dispatched after the marker
+        srtl::record_into(&stats, m, 1_100, 1_300, 2_000, 3, false);
+        // no marker yet: totals only
+        srtl::record_into(&stats, u64::MAX, 100, 200, 5_000, 0, false);
+        let v: Vec<u64> = stats.iter().map(|s| s.load(Ordering::Relaxed)).collect();
+        assert_eq!((v[srtl::JOBS], v[srtl::ACC_JOBS], v[srtl::MAJFLT]), (5, 1, 6));
+        assert_eq!((v[srtl::PRE_RUNNING], v[srtl::PRE_RUNNING_AFTER_NS], v[srtl::PRE_RUNNING_FLT]), (1, 500, 2));
+        assert_eq!(
+            (v[srtl::PRE_QUEUED], v[srtl::PRE_QUEUED_WAIT_NS], v[srtl::PRE_QUEUED_RUN_NS], v[srtl::PRE_QUEUED_FLT]),
+            (1, 200, 500, 1)
+        );
+        assert_eq!((v[srtl::POST], v[srtl::POST_QUEUE_NS], v[srtl::POST_RUN_NS], v[srtl::POST_FLT]), (1, 200, 700, 3));
+        assert_eq!((v[srtl::PRE_LAST_END_NS], v[srtl::POST_LAST_END_NS], v[srtl::POST_FIRST_DISPATCH_NS]), (700, 1_000, 100));
+    }
 }
