+impl Drop for EapPwInspector {
+    /// Prologue (`lxoff`): the companion drops this inspector's tracker.
+    fn drop(&mut self) {
+        if self.lxk != 0 {
+            self.lx_flush_keccak();
+            let _ = lx_companion(self.lxk).send((self.lxk, LxBody::End));
+        }
+    }
+}
+
+impl<T: EvmTypes> Inspector<T> for EapPwInspector {
+    /// EXP-180 (`pwjitreal`): with the JIT configuration, compiled frames run as compiled code and only the message hooks
+    /// fire (revmc's behaviour in 2.5.1; KECCAK256 inputs of compiled frames come through [`pw_keccak_hook`], balance
+    /// reads through `reuse::pw_balance_hook`); otherwise, and with `pwjit=0`, every frame runs in the interpreter.
+    fn allows_compiled_frames(&self) -> bool {
+        pw_jit_real(&self.mode, true)
+    }
+
+    fn call(&mut self, interp: &mut Interpreter<'_, '_, T>, message: &mut Message<T>) -> Option<MessageResult<T>> {
+        self.take_compiled_keccak();
+        self.note_tx(interp, message);
+        self.rdepth += 1;
+        // EXP-206 (`reusebal`): recording starts at the run's top-level frame; a call sending value observes the
+        // sender's balance and (`reusebalsend`) what the transfer leaves of it (nothing to do with the switch off)
+        if self.mode.reusebal {
+            if self.rdepth == 1 {
+                crate::tree::reuse::obs_start();
+            }
+            crate::tree::reuse::obs_call(interp, message);
+        }
+        // EXP-159: the block's execution has ended; this worker's run is no longer useful
+        if let Some(e) = &self.ended &&
+            e.load(Ordering::Relaxed)
+        {
+            if let Some(s) = &self.stats {
+                s.pw_after_end.fetch_add(1, Ordering::Relaxed);
+            }
+            return None
+        }
+        let depth = msg_depth(interp, message);
+        let code_hash = message.code.hash_slow();
+        // calls are counted before any gate, in every block that runs this inspector (`cnt=1` or `pwmin`)
+        let compiled_ok = if (self.mode.cnt || self.mode.pwmin > 0) && (depth >= 1 || self.all_depths) {
+            compiled(code_hash, self.mode.pwmin)
+        } else {
+            true
+        };
+        let (Some(tx), Some(stats)) = (&self.tx, &self.stats) else { return None };
+        let t0 = Instant::now();
+        stats.pw_frames.fetch_add(1, Ordering::Relaxed);
+        let cur = PW_CUR_TX.with(|c| c.get());
+        // `pwk`: plans only once this worker has read `pwk` slots of the transaction from the backend; `EWB_PWK`: only while
+        // the execution thread has not reached the transaction (keys already issued are dropped as before)
+        let k_gated = if self.mode.ew > 0 && self.mode.ewbud & EWB_PWK != 0 {
+            (cur as usize) < self.exec_idx.load(Ordering::Relaxed)
+        } else {
+            self.mode.pwk > 0 && reth_execution_cache::cc_tx_backend_slots() < self.mode.pwk
+        };
+        if k_gated || (self.mode.pwnodisc && reth_execution_cache::cc_discovering()) {
+            stats.pw_gated.fetch_add(1, Ordering::Relaxed);
+            // EXP-105: record what the gated call would have issued
+            if self.mode.pwtrace && (depth >= 1 || self.all_depths) && compiled_ok {
+                let r = if k_gated { 1 } else { 2 };
+                self.trace_would(interp, message, r);
+            }
+        } else if self.mode.pwlag > 0 && cur as usize > self.exec_idx.load(Ordering::Relaxed) + self.mode.pwlag as usize {
+            stats.pw_far.fetch_add(1, Ordering::Relaxed);
+            if self.mode.pwtrace && (depth >= 1 || self.all_depths) && compiled_ok {
+                self.trace_would(interp, message, 5);
+            }
+        } else if (depth >= 1 || self.all_depths) &&
+            compiled_ok &&
+            let Some(plan) = plans().and_then(|p| p.get(&code_hash))
+        {
+            stats.pw_jobs.fetch_add(1, Ordering::Relaxed);
+            PW_TX_JOBS.with(|c| c.set(c.get().saturating_add(1)));
+            if self.mode.pwsync {
+                let input = message.input.clone();
+                let env = self.info.env(message.caller, interp.tx_env().origin, message.destination, message.value, input.len());
+                // X-027: `pwsl` (EXP-212, storage-read nodes of site keys read on the worker) is not ported; its keys stay
+                // unknown, as with `pwsl=0`
+                let ti = Instant::now();
+                let keys = PW_SCRATCH.with(|sc| {
+                    let mut sc = sc.borrow_mut();
+                    let sc = scratch_for_block(&mut sc);
+                    sc.instantiate(&plan, &Frame { calldata: &input, env, sload: None });
+                    sc.out.clone()
+                });
+                stats.pw_inst_ns.fetch_add(ti.elapsed().as_nanos() as u64, Ordering::Relaxed);
+                stats.pw_sync_keys.fetch_add(keys.len() as u64, Ordering::Relaxed);
+                stats.pw_keys.fetch_add(keys.len() as u64, Ordering::Relaxed);
+                let mut keys = keys;
+                let tl = Instant::now();
+                if self.mode.pwdedup &&
+                    let Some((issued, _)) = PROBE.lock().clone()
+                {
+                    let a = message.destination;
+                    let before = keys.len();
+                    let mut g = issued.lock();
+                    let td = Instant::now();
+                    stats.pw_lockw_ns.fetch_add(td.duration_since(tl).as_nanos() as u64, Ordering::Relaxed);
+                    keys.retain(|k| {
+                        let kk = B256::from(*k);
+                        let e = g.slots.entry((a, kk));
+                        match e {
+                            std::collections::hash_map::Entry::Occupied(_) => false,
+                            std::collections::hash_map::Entry::Vacant(v) => {
+                                v.insert((0, reth_execution_cache::CC_SRC_EAP_PW));
+                                true
+                            }
+                        }
+                    });
+                    for k in &keys {
+                        note_issue(&g, stats, a, B256::from(*k), reth_execution_cache::CC_SRC_EAP_PW);
+                    }
+                    drop(g);
+                    stats.pw_dedup_ns.fetch_add(td.elapsed().as_nanos() as u64, Ordering::Relaxed);
+                    stats.pw_dedup.fetch_add((before - keys.len()) as u64, Ordering::Relaxed);
+                }
+                if !keys.is_empty() {
+                    if self.mode.pwtrace {
+                        let a = message.destination;
+                        kt(|k, t| {
+                            for key in &keys {
+                                k.issued.entry((a, B256::from(*key))).or_insert(t);
+                            }
+                        });
+                    }
+                    let _ = tx.send(Item::Keys(Box::new((message.destination, keys, cur, reth_execution_cache::CC_SRC_EAP_PW, rq_now()))));
+                }
+                // EXP-112 (`pwct`): the plan's call records give the callees; a reader (1) or this worker (2) resolves
+                // them with this call's arguments and prefetches the callees' accounts, codes and plan keys
+                if self.mode.pwct > 0 && plan_has_calls(&plan) {
+                    if self.mode.pwct == 1 {
+                        let _ = tx.send(Item::Follow(Box::new(FrameJob {
+                            plan,
+                            input,
+                            caller: message.caller,
+                            origin: interp.tx_env().origin,
+                            target: message.destination,
+                            value: message.value,
+                            depth,
+                            pw: true,
+                            nb: false,
+                            tx: cur,
+                        })));
+                    } else {
+                        let origin = interp.tx_env().origin;
+                        let db = interp.host().state_mut().overlay_db_mut();
+                        pw_follow_calls(db, origin, tx, stats, &self.mode, &self.info, &plan, &input, message.caller, message.destination, message.value, cur, 0, &self.exec_idx);
+                    }
+                }
+            } else {
+                let _ = tx.send(Item::Frame(Box::new(FrameJob {
+                    plan,
+                    input: message.input.clone(),
+                    caller: message.caller,
+                    origin: interp.tx_env().origin,
+                    target: message.destination,
+                    value: message.value,
+                    depth,
+                    pw: true,
+                    nb: false,
+                    tx: cur,
+                })));
+            }
+        } else if self.mode.pwtrace {
+            // EXP-105: an outermost call (`pwcs=1`) or a code called too few times (`pwmin`)
+            if !(depth >= 1 || self.all_depths) {
+                self.trace_would(interp, message, 4);
+            } else if !compiled_ok {
+                self.trace_would(interp, message, 3);
+            }
+        }
+        stats.pw_hook_ns.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        if self.mode.pwlx {
+            let tx0 = Instant::now();
+            let (tx2, stats2) = (tx.clone(), stats.clone());
+            // EXP-151: per-transaction setup at the entry's frame (depth 0) or a proxy's delegate frame (depth 1)
+            if depth <= 1 && (self.mode.pwlxcnt || self.mode.c2rec) {
+                self.lx_tx_setup(interp, message, cur, &stats2);
+            }
+            if depth >= 1 {
+                self.lx_observe(interp, message, code_hash, cur, &tx2, &stats2);
+            }
+            stats2.pw_lx_ns.fetch_add(tx0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        }
+        None
+    }
+
+    fn call_end(&mut self, interp: &mut Interpreter<'_, '_, T>, _message: &Message<T>, _result: &mut MessageResult<T>) {
+        self.take_compiled_keccak();
+        self.reuse_frame_end(interp);
+    }
+
+    /// EXP-130 (`pwlxc2`): a KECCAK256 over an 85-byte 0xff-prefixed buffer is a CREATE2 address computation (a batch
+    /// minter deriving its existing proxies' addresses); the address and its salt are kept for the target fit.
+    fn step(&mut self, interp: &mut Interpreter<'_, '_, T>) {
+        // EXP-206 (`reusebal`): BALANCE, SELFBALANCE and SELFDESTRUCT observe a balance (with the switch off, every
+        // instruction costs only this field read)
+        if self.mode.reusebal {
+            crate::tree::reuse::obs_step(interp);
+        }
+        // Prologue (`ixpf`): a 64-byte input goes to the worker's index-key extrapolation
+        if self.mode.ixpf > 0 &&
+            interp.opcode() == op::KECCAK256 &&
+            let Some((off, len)) = keccak_input(interp, |len| len == 64)
+        {
+            ix::keccak_input(interp.memory().slice(off, len));
+        }
+        if !self.mode.pwlx || !self.mode.pwlxc2 {
+            return
+        }
+        if interp.opcode() != op::KECCAK256 {
+            return
+        }
+        let Some((off, len)) = keccak_input(interp, |len| len == 85 || (32..=160).contains(&len)) else { return };
+        let ts = Instant::now();
+        let cur = PW_CUR_TX.with(|c| c.get());
+        self.lx_begin(cur);
+        let m = interp.memory().slice(off, len).to_vec();
+        if self.lx_off() {
+            self.lx_send(LxBody::Keccak(m));
+        } else {
+            self.lx.keccak(&m);
+        }
+        if let Some(s) = &self.stats {
+            s.pw_lxstep_ns.fetch_add(ts.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        }
+    }
+
+    fn create(&mut self, interp: &mut Interpreter<'_, '_, T>, message: &mut Message<T>) -> Option<MessageResult<T>> {
+        self.take_compiled_keccak();
+        self.note_tx(interp, message);
+        self.rdepth += 1;
+        // EXP-206 (`reusebal`): recording starts at the run's top-level frame; a creation sending value observes the
+        // creator's balance and (`reusebalsend`) what the transfer leaves of it
+        if self.mode.reusebal {
+            if self.rdepth == 1 {
+                crate::tree::reuse::obs_start();
+            }
+            crate::tree::reuse::obs_create(interp, message);
+        }
+        None
+    }
+
+    fn selfdestruct(&mut self, contract: &Address, _target: &Address, _value: &U256, _host: &mut T::Host<'_>) {
+        // EXP-206 (`reusebal`): SELFDESTRUCT moves the whole balance of the contract
+        if self.mode.reusebal {
+            crate::tree::reuse::obs_balance(*contract);
+        }
+    }
+
+    fn create_end(&mut self, interp: &mut Interpreter<'_, '_, T>, message: &Message<T>, result: &mut MessageResult<T>) {
+        self.take_compiled_keccak();
+        self.reuse_frame_end(interp);
+        if self.mode.pwlx && self.mode.pwlxc2 && let Some(created) = result.created_address {
+            let cur = PW_CUR_TX.with(|c| c.get());
+            self.lx_begin(cur);
+            match message.kind {
+                MessageKind::Create2 => {
+                    let init_code_hash = alloy_primitives::keccak256(&message.input);
+                    if self.lx_off() {
+                        self.lx_send(LxBody::Created(message.caller, U256::from_be_bytes(message.salt.0), init_code_hash, created));
+                    } else {
+                        self.lx.created_real(message.caller, U256::from_be_bytes(message.salt.0), init_code_hash, created);
+                    }
+                }
+                MessageKind::Create => {
+                    // plain CREATE: the address follows the creator's nonce, which the transaction's state holds (already
+                    // incremented); recorded as a progression with step 1 and an all-zero "init-code hash"
+                    if let Ok(Some(acc)) = interp.host().state_mut().account_info_untracked(&message.caller) {
+                        let nonce = acc.nonce.saturating_sub(1);
+                        if self.lx_off() {
+                            self.lx_send(LxBody::Created(message.caller, U256::from(nonce), B256::ZERO, created));
+                        } else {
+                            self.lx.created_real(message.caller, U256::from(nonce), B256::ZERO, created);
+                        }
+                    }
+                }
+                _ => {}
+            }
+        }
+    }
+}
