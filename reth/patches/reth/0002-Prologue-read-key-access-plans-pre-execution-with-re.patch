+        let r = blk.recs.lock()[0].clone();
+        assert_eq!((r.a, r.c, r.i0, r.d, r.keys.load(Ordering::Relaxed)), (A, U256::from(C), U256::from(100), 1, 67));
+        assert_eq!(step(r.i0, r.d, r.pos.load(Ordering::Relaxed)), Some(U256::from(108)));
