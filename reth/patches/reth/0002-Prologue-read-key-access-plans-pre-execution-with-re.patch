+    /// `ewbud`: passes take counted cores until one is left for the execution thread, a running worker takes one too;
+    /// nothing is late before the rates are known, then the comparison of expected reads with the time to arrival
+    #[test]
+    fn counted_cores_and_lateness() {
+        let n = exec_cores();
+        let mut held = Vec::new();
+        while let Some(g) = nb_try_core(n) {
+            held.push(g);
+            assert!(held.len() <= n, "more passes than cores");
+        }
+        assert_eq!(held.len(), n.saturating_sub(1));
+        if !held.is_empty() {
+            drop(held.pop());
+            let w = worker_busy();
+            assert!(nb_try_core(n).is_none(), "the running worker holds the freed core");
+            drop(w);
+            assert!(nb_try_core(n).is_some());
+        }
+        drop(held);
+        assert!(!late(1_000, 0), "no rates yet");
+        note_exec(1_000, 1_000);
+        note_run(10, 1_000);
