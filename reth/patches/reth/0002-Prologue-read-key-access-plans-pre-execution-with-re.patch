+/// Prologue (`logq`, X-031): the per-block `eap` info lines are left out for the current block.
+static LOGQ: AtomicBool = AtomicBool::new(false);
+
+/// Prologue (`logq`): whether the per-block `eap` info lines are left out (the block whose mode was installed last).
+pub fn logq() -> bool {
+    LOGQ.load(Ordering::Relaxed)
+}
+
+/// Prologue (`logq`): `info!` for a per-block `eap` line, skipped (arguments not evaluated) while [`logq`] is on.
+macro_rules! eap_info {
+    ($($t:tt)*) => {
+        if !logq() {
+            info!($($t)*);
+        }
+    };
+}
