+//! Exclusive CPU and wall time for the sparse-trie coordinator thread.
+
+use std::{
+    cell::RefCell,
+    time::{Instant, SystemTime, UNIX_EPOCH},
+};
+
+const COUNT: usize = 16;
+
+#[derive(Clone, Copy, Debug)]
+pub(in crate::tree::state_root_strategy) enum Phase {
+    Other,
+    Wait,
+    Input,
+    Proof,
+    Candidates,
+    StorageReady,
+    StorageInline,
+    AccountLeaf,
+    Promotion,
+    Dispatch,
+    IdleHash,
+    FinalHash,
+    Diagnostic,
+    Setup,
+    Handoff,
+    Preserve,
+}
+
+const NAMES: [&str; COUNT] = [
+    "other",
+    "wait",
+    "input",
+    "proof",
+    "candidates",
+    "storage_ready",
+    "storage_inline",
+    "account_leaf",
+    "promotion",
+    "dispatch",
+    "idle_hash",
+    "final_hash",
+    "diagnostic",
+    "setup",
+    "handoff",
+    "preserve",
+];
+
+#[derive(Clone, Copy, Debug, Default)]
+struct Sample {
+    cpu: u64,
+    wall: u64,
+    tail_cpu: u64,
+    tail_wall: u64,
+    calls: u64,
+    items: u64,
+}
+
+struct State {
+    block: u32,
+    phase: Phase,
+    tail: bool,
+    cpu_start: u64,
+    wall_start: Instant,
+    cpu_last: u64,
+    wall_last: Instant,
+    clock_errors: u64,
+    start_unix_ns: u64,
+    ready_cpu: u64,
+    ready_wall: u64,
+    samples: [Sample; COUNT],
+}
+
+impl State {
+    fn charge(&mut self, cpu: u64, wall: Instant, error: bool) {
+        let sample = &mut self.samples[self.phase as usize];
+        let cpu_delta = cpu.saturating_sub(self.cpu_last);
+        let wall_delta = wall.duration_since(self.wall_last).as_nanos() as u64;
+        sample.cpu += cpu_delta;
+        sample.wall += wall_delta;
+        if self.tail {
+            sample.tail_cpu += cpu_delta;
+            sample.tail_wall += wall_delta;
+        }
+        self.cpu_last = cpu;
+        self.wall_last = wall;
+        self.clock_errors += u64::from(error);
+    }
+}
+
+thread_local! {
+    static STATE: RefCell<Option<State>> = const { RefCell::new(None) };
+}
+
+pub(in crate::tree::state_root_strategy) struct Session(bool);
+
+pub(in crate::tree::state_root_strategy) fn start(block: Option<u32>) -> Session {
+    STATE.with(|cell| {
+        *cell.borrow_mut() = block.map(|block| {
+            let (cpu, wall, error) = stamp();
+            State {
+                block,
+                phase: Phase::Other,
+                tail: false,
+                cpu_start: cpu,
+                wall_start: wall,
+                cpu_last: cpu,
+                wall_last: wall,
+                clock_errors: u64::from(error),
+                start_unix_ns: SystemTime::now()
+                    .duration_since(UNIX_EPOCH)
+                    .unwrap_or_default()
+                    .as_nanos() as u64,
+                ready_cpu: 0,
+                ready_wall: 0,
+                samples: [Sample::default(); COUNT],
+            }
+        });
+    });
+    Session(block.is_some())
+}
+
+impl Session {
+    pub(in crate::tree::state_root_strategy) fn finish(mut self) {
+        if !self.0 {
+            return;
+        }
+        self.0 = false;
+        let state = STATE.with(|cell| {
+            let mut state = cell.borrow_mut().take().expect("active profile session");
+            let (cpu, wall, error) = stamp();
+            state.charge(cpu, wall, error);
+            state
+        });
+        for (name, sample) in NAMES.iter().zip(state.samples) {
+            tracing::info!(target: "reth::eap", block = state.block, phase = *name,
+                cpu_ns = sample.cpu, wall_ns = sample.wall, tail_cpu_ns = sample.tail_cpu,
+                tail_wall_ns = sample.tail_wall, calls = sample.calls, items = sample.items,
+                "eap srphase");
+        }
+        tracing::info!(target: "reth::eap", block = state.block,
+            cpu_ns = state.cpu_last.saturating_sub(state.cpu_start),
+            wall_ns = state.wall_last.duration_since(state.wall_start).as_nanos() as u64,
+            clock_errors = state.clock_errors, start_unix_ns = state.start_unix_ns,
+            ready_cpu_ns = state.ready_cpu, ready_wall_ns = state.ready_wall, "eap srphase total");
+    }
+}
+
+impl Drop for Session {
+    fn drop(&mut self) {
+        if self.0 {
+            STATE.with(|cell| {
+                cell.borrow_mut().take();
+            });
+        }
+    }
+}
+
+pub(in crate::tree::state_root_strategy) struct Guard(Option<Phase>);
+
+pub(in crate::tree::state_root_strategy) fn enter(phase: Phase) -> Guard {
+    Guard(STATE.with(|cell| {
+        let mut slot = cell.borrow_mut();
+        let state = slot.as_mut()?;
+        let (cpu, wall, error) = stamp();
+        state.charge(cpu, wall, error);
+        let previous = state.phase;
+        state.phase = phase;
+        state.samples[phase as usize].calls += 1;
+        Some(previous)
+    }))
+}
+
+impl Drop for Guard {
+    fn drop(&mut self) {
+        if let Some(previous) = self.0 {
+            STATE.with(|cell| {
+                if let Some(state) = cell.borrow_mut().as_mut() {
+                    let (cpu, wall, error) = stamp();
+                    state.charge(cpu, wall, error);
+                    state.phase = previous;
+                }
+            });
+        }
+    }
+}
+
+pub(in crate::tree::state_root_strategy) fn mark() {
+    STATE.with(|cell| {
+        if let Some(state) = cell.borrow_mut().as_mut() {
+            let (cpu, wall, error) = stamp();
+            state.charge(cpu, wall, error);
+            state.tail = true;
+        }
+    });
+}
+
+pub(in crate::tree::state_root_strategy) fn items(n: usize) {
+    STATE.with(|cell| {
+        if let Some(state) = cell.borrow_mut().as_mut() {
+            state.samples[state.phase as usize].items += n as u64;
+        }
+    });
+}
+
+pub(in crate::tree::state_root_strategy) fn root_ready() {
+    STATE.with(|cell| {
+        if let Some(state) = cell.borrow_mut().as_mut() {
+            let (cpu, wall, error) = stamp();
+            state.charge(cpu, wall, error);
+            state.ready_cpu = cpu.saturating_sub(state.cpu_start);
+            state.ready_wall = wall.duration_since(state.wall_start).as_nanos() as u64;
+        }
+    });
+}
+
+fn stamp() -> (u64, Instant, bool) {
+    let mut ts = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    // SAFETY: ts is writable; the clock measures only the calling thread.
+    let error = unsafe { libc::clock_gettime(libc::CLOCK_THREAD_CPUTIME_ID, &mut ts) } != 0;
+    (ts.tv_sec as u64 * 1_000_000_000 + ts.tv_nsec as u64, Instant::now(), error)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::time::Duration;
+
+    #[test]
+    fn srphase_exclusive_totals_and_finish_boundary_balance() {
+        let now = Instant::now();
+        let mut state = State {
+            block: 1,
+            phase: Phase::Other,
+            tail: false,
+            cpu_start: 0,
+            wall_start: now,
+            cpu_last: 0,
+            wall_last: now,
+            clock_errors: 0,
+            start_unix_ns: 0,
+            ready_cpu: 0,
+            ready_wall: 0,
+            samples: [Sample::default(); COUNT],
+        };
+        state.charge(10, now + Duration::from_nanos(20), false);
+        state.phase = Phase::Proof;
+        state.charge(30, now + Duration::from_nanos(80), false);
+        state.phase = Phase::Candidates;
+        state.charge(35, now + Duration::from_nanos(90), false);
+        state.tail = true;
+        state.charge(40, now + Duration::from_nanos(100), false);
+        state.phase = Phase::Proof;
+        state.charge(50, now + Duration::from_nanos(130), false);
+        assert_eq!(state.samples.iter().map(|s| s.cpu).sum::<u64>(), 50);
+        assert_eq!(state.samples.iter().map(|s| s.wall).sum::<u64>(), 130);
+        assert_eq!(state.samples[Phase::Candidates as usize].cpu, 10);
+        assert_eq!(state.samples[Phase::Candidates as usize].tail_cpu, 5);
+        assert_eq!(state.samples[Phase::Proof as usize].tail_wall, 30);
+    }
+
+    #[test]
+    fn srphase_nested_guards_restore_and_aborted_sessions_clear() {
+        let session = start(Some(1));
+        {
+            let _proof = enter(Phase::Proof);
+            {
+                let _candidate = enter(Phase::Candidates);
+                items(7);
+            }
+            STATE.with(|s| assert!(matches!(s.borrow().as_ref().unwrap().phase, Phase::Proof)));
+        }
+        STATE.with(|s| {
+            let s = s.borrow();
+            let s = s.as_ref().unwrap();
+            assert!(matches!(s.phase, Phase::Other));
+            assert_eq!(s.samples[Phase::Candidates as usize].items, 7);
+            assert_eq!(s.samples[Phase::Proof as usize].calls, 1);
+        });
+        drop(session);
+        let _disabled = start(None);
+        let _guard = enter(Phase::FinalHash);
+        STATE.with(|s| assert!(s.borrow().is_none()));
+    }
+}
