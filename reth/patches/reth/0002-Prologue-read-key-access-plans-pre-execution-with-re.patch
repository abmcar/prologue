+    /// X-027: `apply_exec_slice_us` sets the slice through sched_setattr and keeps the policy and the nice value; read
+    /// back with sched_getattr. Skipped when the kernel refuses sched_getattr.
+    #[test]
+    fn exec_slice_round_trip_under_sched_getattr() {
+        std::thread::spawn(|| {
+            let get = || {
+                let mut a = SchedAttr::default();
+                let size = std::mem::size_of::<SchedAttr>() as u32;
+                // SAFETY: pid 0 (the calling thread), a valid sched_attr buffer of `size` bytes.
+                let r = unsafe { libc::syscall(libc::SYS_sched_getattr, 0, &mut a as *mut SchedAttr, size, 0) };
+                (r == 0).then_some(a)
+            };
+            let Some(a0) = get() else { return };
+            if a0.policy != libc::SCHED_OTHER as u32 && a0.policy != libc::SCHED_BATCH as u32 {
+                return
+            }
+            apply_exec_slice_us(250);
+            let a1 = get().expect("sched_getattr");
+            assert_eq!(exec_slice_set(), 250);
+            assert_eq!(a1.runtime, 250_000, "slice in ns");
+            assert_eq!((a1.policy, a1.nice), (a0.policy, a0.nice), "policy and nice kept");
+            // the same slice again makes no call; back to the default
+            apply_exec_slice_us(250);
+            apply_exec_slice_us(0);
+            assert_eq!(exec_slice_set(), 0);
+            let a2 = get().expect("sched_getattr");
+            assert_eq!((a2.policy, a2.nice), (a0.policy, a0.nice));
+        })
+        .join()
+        .unwrap();
+    }
