+/// EXP-180 (`pwjitreal=1`): whether a cache-filling prewarm run uses the EVM configuration with JIT support on;
+/// `inspected`: the run has the EAP prewarm inspector (then `pwjit=0` keeps the interpreter).
+pub fn pw_jit_real(m: &Mode, inspected: bool) -> bool {
+    m.pwjitreal && (!inspected || m.pwjit)
