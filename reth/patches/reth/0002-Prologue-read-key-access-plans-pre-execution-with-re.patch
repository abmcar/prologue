+        diag_exec_flush_counters();
+        let t = diag_now_ns();
+        DIAG_EXEC.with(|c| c.set(Some((i as u32, [0; 4]))));
+        if let Some(b) = diag_exec_block() {
+            b.push(DiagEv::ExecStart { i: i as u32, t });
+        }
+    }
