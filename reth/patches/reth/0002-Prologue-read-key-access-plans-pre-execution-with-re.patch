+static STATS: LazyLock<Stats> = LazyLock::new(Stats::default);
+
+/// Sets the mode, the in-block check interval and (EXP-206) whether unobserved balance changes are accepted as
+/// increments for the next block (called from `eap::refresh`).
+/// `bg`, `bg_pool`, `bg_tail` (EXP-215 `reusechkbg`): parsed by the caller but not ported; no background checks run.
+pub fn set_mode(m: u8, chk: u64, fast: bool, bal: bool, bg: u8, bg_pool: bool, bg_tail: u64) {
+    let _ = (bg, bg_pool, bg_tail);
+    MODE.store(m.min(2), Ordering::Relaxed);
+    CHK.store(chk, Ordering::Relaxed);
+    FAST.store(fast, Ordering::Relaxed);
+    BAL.store(bal && m > 0, Ordering::Relaxed);
+}
+
+/// Mode of the current block.
+pub fn mode() -> u8 {
+    MODE.load(Ordering::Relaxed)
+}
+
+/// Prewarm worker: a transaction run starts.
+pub fn tx_begin() {
+    CB_BODY.with(|c| c.set(0));
+    // EXP-206: no balance observations until the inspector starts recording for this run
+    OBS.with(|o| *o.borrow_mut() = None);
+    OBS_LOST.with(|l| l.set(false));
+}
+
+/// Prewarm inspector: the top-level frame of the current run ended.
+pub fn body_end(beneficiary_loaded: bool) {
+    CB_BODY.with(|c| c.set(if beneficiary_loaded { 1 } else { 2 }));
+}
+
+/// Prewarm worker: keeps a successful run's result for transaction `index` of block `block`.
+pub fn store<T: EvmTypes>(block: B256, index: usize, res: &TxResultWithState<T>)
+where
+    TxResult<T>: Send,
+{
+    store_checked(block, index, res, false, 0);
+}
+
+/// EXP-199 (`ewov`): as [`store`]; with `full_check` the entry is always checked against every key it read, since its run
+/// read values written by earlier transactions' prewarm runs, which the restricted check (`reusefast`, written keys only)
+/// would not compare when the execution thread did not write them.
+/// `run` (EXP-199 `ewredo`): the prewarm run's number; an entry from an older run than the stored one is not kept.
+pub fn store_checked<T: EvmTypes>(block: B256, index: usize, res: &TxResultWithState<T>, full_check: bool, run: u32)
+where
+    TxResult<T>: Send,
+{
+    if mode() == 0 {
+        return
+    }
+    let t0 = std::time::Instant::now();
+    let body = CB_BODY.with(|c| c.get());
+    let fee_only = body == 2;
+    let bal_obs = take_obs(body);
+    let e = Box::new(Entry {
+        state: res.pending_state.clone(),
+        result: Box::new(res.result.clone()),
+        touched: touched_of(&res.pending_state),
+        fee_only,
+        full_check,
+        run,
+        bal_obs,
+    });
+    {
+        let mut g = reth_execution_cache::lkprof::lock(reth_execution_cache::lkprof::REUSE, &SLOTS);
+        if g.get(&(block, index)).is_some_and(|old| old.run > run) {
+            return
+        }
+        g.insert((block, index), e);
+    }
+    STATS.stored.fetch_add(1, Ordering::Relaxed);
+    STATS.store_ns.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+    // Prologue (record only): the block's first stored result
+    let _ = FIRST_STORE_NS.compare_exchange(0, mono_ns(), Ordering::Relaxed, Ordering::Relaxed);
+}
+
+/// Prologue (record only, X-031 round 3): a process-wide monotonic clock in ns (+1, so 0 means "not set").
+fn mono_ns() -> u64 {
+    static BASE: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();
+    BASE.get_or_init(std::time::Instant::now).elapsed().as_nanos() as u64 + 1
+}
+
+fn thread_cpu_ns() -> u64 {
+    let mut ts = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    // SAFETY: clock_gettime writes the given timespec only.
+    unsafe { libc::clock_gettime(libc::CLOCK_THREAD_CPUTIME_ID, &mut ts) };
+    ts.tv_sec as u64 * 1_000_000_000 + ts.tv_nsec as u64
+}
+
+/// Prologue (record only): when the block's first prewarm result was stored, and when [`begin_exec`] ran (`mono_ns`).
+static FIRST_STORE_NS: AtomicU64 = AtomicU64::new(0);
+static EXEC_BEGIN_NS: AtomicU64 = AtomicU64::new(0);
+/// Prologue (record only): the first store relative to [`begin_exec`] in ns, kept by [`finish_exec`] before it resets the
+/// store counters (`i64::MIN`: no result stored).
+static BLOCK_FIRST_REL_NS: std::sync::atomic::AtomicI64 = std::sync::atomic::AtomicI64::new(i64::MIN);
+/// Prologue (record only): the execution thread's CPU time (ns) between one [`prepare`] call and the next, by the outcome
+/// of the first: 0 reused (result valid), 1 executed itself with no result stored, 2 executed itself after a failed check.
+/// The interval after the block's last transaction is not counted.
+static RZ_CPU: [AtomicU64; 3] = [const { AtomicU64::new(0) }; 3];
+/// Prologue (record only): the indices of transactions with no result stored, in buckets 0-7, 8-15, 16-31, 32-63,
+/// 64-127, 128-255, 256 and more.
+static MISS_POS: [AtomicU64; 7] = [const { AtomicU64::new(0) }; 7];
+thread_local!(static RZ_LAST: std::cell::Cell<(u64, u8)> = const { std::cell::Cell::new((0, u8::MAX)) });
+
+/// Prologue (record only): (CPU ns by outcome, missing-index buckets, first store relative to the execution start in ns).
+pub fn exec_split() -> ([u64; 3], [u64; 7], i64) {
+    let g = |a: &AtomicU64| a.load(Ordering::Relaxed);
+    (
+        core::array::from_fn(|i| g(&RZ_CPU[i])),
+        core::array::from_fn(|i| g(&MISS_POS[i])),
+        BLOCK_FIRST_REL_NS.load(Ordering::Relaxed),
+    )
+}
+
+/// Hash of the block the execution thread is executing (set by [`begin_exec`]).
+static EXEC_BLOCK: Mutex<B256> = parking_lot::const_mutex(B256::ZERO);
+
+/// The block hash set by [`begin_exec`].
+pub fn exec_block() -> B256 {
+    *EXEC_BLOCK.lock()
+}
+
+/// Execution thread: the block's execution starts; entries of other blocks are dropped and the counters reset.
+pub fn begin_exec(block: B256) {
+    *EXEC_BLOCK.lock() = block;
+    // Prologue (record only)
+    EXEC_BEGIN_NS.store(mono_ns(), Ordering::Relaxed);
+    BLOCK_FIRST_REL_NS.store(i64::MIN, Ordering::Relaxed);
+    for a in RZ_CPU.iter().chain(MISS_POS.iter()) {
+        a.store(0, Ordering::Relaxed);
+    }
+    RZ_LAST.with(|c| c.set((0, u8::MAX)));
+    SLOTS.lock().retain(|k, _| k.0 == block);
+    *MODIFIED.lock() = Modified::default();
+    // `reusediag`: the commits from here are the block's pre-block system calls until its first transaction
+    if DIAG_ON.load(Ordering::Relaxed) {
+        *DIAG.lock() = Diag::default();
+    }
+    LEAD.0.store(0, Ordering::Relaxed);
+    LEAD.1.store(0, Ordering::Relaxed);
+    LEAD.2.store(0, Ordering::Relaxed);
+    let s = &*STATS;
+    for a in [&s.found, &s.missing, &s.valid, &s.reused, &s.mismatch, &s.upd_mismatch, &s.fee_only, &s.checked, &s.fast_diff, &s.nonconsensus, &s.validate_ns, &s.reuse_ns, &s.full_found, &s.full_valid, &s.bal_relaxed, &s.bal_valid, &s.bal_send, &s.bg_checks, &s.bg_diff, &s.bg_err, &s.bg_wait_ns, &s.bg_cpu_ns, &s.log_n, &s.log_ns] {
+        a.store(0, Ordering::Relaxed);
+    }
+    for a in s.fail.iter().chain(s.nc_kind.iter()) {
+        a.store(0, Ordering::Relaxed);
+    }
+}
+
+/// X-031 (record only): at each transaction the execution thread starts, the results stored so far minus the
+/// transaction's index (summed), the transactions counted, and those started with no result stored beyond them.
+static LEAD: (std::sync::atomic::AtomicI64, AtomicU64, AtomicU64) =
+    (std::sync::atomic::AtomicI64::new(0), AtomicU64::new(0), AtomicU64::new(0));
+
+/// X-031 (record only): the execution thread starts transaction `index`; counts the prewarm lead.
+pub fn note_exec_start(index: usize) {
+    let stored = STATS.stored.load(Ordering::Relaxed) as i64;
+    LEAD.0.fetch_add(stored - index as i64, Ordering::Relaxed);
+    LEAD.1.fetch_add(1, Ordering::Relaxed);
+    if stored <= index as i64 {
+        LEAD.2.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// X-031 (record only): the block's lead sum, transactions counted, and those with no result stored beyond them.
+pub fn lead() -> (i64, u64, u64) {
+    (LEAD.0.load(Ordering::Relaxed), LEAD.1.load(Ordering::Relaxed), LEAD.2.load(Ordering::Relaxed))
+}
+
+/// X-031 (record only): the current block's reuse outcomes since [`begin_exec`]: results found, missing (none stored for
+/// the transaction when the execution thread asked), valid, reused, failed (any failure kind), checked (mode 1).
+pub fn block_counts() -> [u64; 6] {
+    let s = &*STATS;
+    let g = |a: &AtomicU64| a.load(Ordering::Relaxed);
+    [g(&s.found), g(&s.missing), g(&s.valid), g(&s.reused), s.fail.iter().map(g).sum(), g(&s.checked)]
+}
+
+/// `reusefast=1`: in mode 2 the read set is checked only on the keys written so far in the block (see [`wrap_hook`]);
+/// in mode 1 both checks run and their decisions are compared.
+static FAST: AtomicBool = AtomicBool::new(false);
+
+/// Keys committed so far in the block on the execution thread, system calls included: accounts touched, accounts
+/// created or destroyed (every slot of such an account counts as written), storage slots changed.
+#[derive(Default)]
+struct Modified {
+    accts: std::collections::HashSet<Address>,
+    wiped: std::collections::HashSet<Address>,
+    slots: std::collections::HashSet<(Address, U256)>,
+}
+
+static MODIFIED: LazyLock<Mutex<Modified>> = LazyLock::new(|| Mutex::new(Modified::default()));
+
+/// A state-hook callback of the block executor.
+pub type StateHook = Box<dyn FnMut(StateUpdate) + Send>;
+
+/// Records every committed state change of the block (the executor's state hook, which sees the pre-execution system
+/// calls, every transaction and the post-execution changes) before passing it on. Installed only when the block reuses
+/// prewarm results. With `reusediag`, also which commit made each change ([`Diag::record`]).
+///
+/// X-027: reth 2.9.0's hook gets only the accounts a commit changed (2.5.1's also got accounts touched without a
+/// change); an unchanged account still holds the parent value, so leaving it out changes no decision of the
+/// restricted check.
+fn record_update(update: &StateUpdate) {
+    if DIAG_ON.load(Ordering::Relaxed) {
+        DIAG.lock().record(update);
+    }
+    let mut m = MODIFIED.lock();
+    for a in &update.accounts {
+        m.accts.insert(a.address);
+        if a.created || a.wiped || a.current.is_none() {
+            m.wiped.insert(a.address);
+        }
+        for (k, _) in &a.storage {
+            m.slots.insert((a.address, *k));
+        }
+    }
+}
+
+/// Wraps the executor's state hook with the key recorder when the block reuses prewarm results.
+pub fn wrap_hook(inner: Option<StateHook>) -> Option<StateHook> {
+    if mode() == 0 {
+        return inner
+    }
+    let mut inner = inner;
+    Some(Box::new(move |update: StateUpdate| {
+        record_update(&update);
+        if let Some(h) = &mut inner {
+            h(update);
+        }
+    }))
+}
+
+/// What the execution thread knows about the transaction before running it.
+pub struct TxFacts {
+    pub sender: Address,
+    pub nonce: u64,
+    /// gas limit times max fee per gas, plus value, plus blob gas times max fee per blob gas ([`tx_max_cost`]; a
+    /// transaction whose maximum cost exceeds `U256::MAX` gets no facts and is not reused)
+    pub max_cost: U256,
+}
+
+/// The transaction's maximum cost, gas limit times max fee per gas, plus value, plus blob gas times max fee per blob
+/// gas, or `None` when it exceeds `U256::MAX`: no balance covers it, and the usual execution rejects the transaction.
+///
+/// Safety fix of the 11-03 review (PORT_X027.md item 1): the sum used `U256`'s wrapping `*` and `+`, so a value close
+/// to 2^256 gave a small maximum cost that the balance checks of [`prepare`] passed, and with `reuse=2` the execution
+/// thread committed the prewarm run (which had no balance check) instead of rejecting the transaction. For every cost
+/// that fits in `U256` the checked sum equals the wrapping one, so no decision on such a transaction changes.
+fn tx_max_cost(
+    gas_limit: u64,
+    max_fee_per_gas: u128,
+    value: U256,
+    blob_gas: u64,
+    max_fee_per_blob_gas: u128,
+) -> Option<U256> {
+    U256::from(gas_limit)
+        .checked_mul(U256::from(max_fee_per_gas))?
+        .checked_add(value)?
+        .checked_add(U256::from(blob_gas).checked_mul(U256::from(max_fee_per_blob_gas))?)
+}
+
+/// Failure kinds of [`prepare`]: 1 sender changed, 2 beneficiary changed, 3 other account changed, 4 slot changed,
+/// 5 nonce differs from the transaction's, 6 balance does not cover the maximum cost (also counted by [`run_tx`] for a
+/// maximum cost beyond `U256::MAX`), 7 database error; 0: valid but not committed here (block gas limit, transaction
+/// type, result type). Counts kind `k` and returns it with `addr`, the account whose check failed (`None` for kind 0).
+fn fail(k: usize, addr: Option<Address>) -> Failure {
+    STATS.fail[k].fetch_add(1, Ordering::Relaxed);
+    Failure { kind: k, addr, slot: None, diff: None, obs: None, covers: None }
+}
+
+/// A failed check of [`prepare`] or [`run_tx`], as `reusediag` records it ([`diag_record`]).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct Failure {
+    /// The failure kind ([`fail`]).
+    kind: usize,
+    /// The account whose check failed: the account read (kinds 1-3; for 7 also the account of a slot read), the sender
+    /// (5 and 6), the slot's account (4); `None` for kind 0.
+    addr: Option<Address>,
+    /// Kind 4: the slot whose value changed.
+    slot: Option<U256>,
+    /// Kinds 1-3: the fields of the account's current info that differ from the info the run read ([`info_diff`]);
+    /// `None` for kind 1 when the run did not load the sender.
+    diff: Option<u8>,
+    /// Kinds 1-3: how the run observed the account's balance ([`BalObs::bits`], 0 not observed); `None` when the run's
+    /// observations were not recorded ([`Entry::bal_obs`]).
+    obs: Option<u8>,
+    /// Kinds 1-3, when the run observed the balance only by sending value out of the account: whether the current
+    /// balance the check read covers the total the run sent ([`BalObs::sent`]); `None` otherwise, and for kind 1 when
+    /// the run did not load the sender.
+    covers: Option<bool>,
+}
+
+impl Failure {
+    /// Kinds 1-3: the failure with how the run behind `e` observed the balance of its account and, when only by sending
+    /// value out of it, whether `balance` covers the total sent (`balance`: the current balance the check read, `None`
+    /// when it read none).
+    fn observed(mut self, e: &Entry, balance: Option<U256>) -> Self {
+        if let Some(m) = &e.bal_obs {
+            let x = self.addr.and_then(|a| m.get(&a).copied()).unwrap_or_default();
+            self.obs = Some(x.bits);
+            self.covers = balance.filter(|_| x.bits == BalObs::SENT).map(|b| b >= x.sent);
+        }
+        self
+    }
+}
+
+fn same(cur: Option<&AccountInfo>, exp: Option<&AccountInfo>) -> bool {
+    match (cur, exp) {
+        (None, None) => true,
+        (Some(a), Some(b)) => a.balance == b.balance && a.nonce == b.nonce && a.code_hash == b.code_hash,
+        _ => false,
+    }
+}
+
+/// `reusediag`: the fields in which the current info `cur` differs from the info `exp` a run read, an absent account
+/// taken as empty: 1 balance, 2 nonce, 4 code hash, 8 existence.
+fn info_diff(cur: Option<&AccountInfo>, exp: Option<&AccountInfo>) -> u8 {
+    let empty = AccountInfo::default();
+    let (c, e) = (cur.unwrap_or(&empty), exp.unwrap_or(&empty));
+    u8::from(c.balance != e.balance) |
+        (u8::from(c.nonce != e.nonce) << 1) |
+        (u8::from(c.code_hash != e.code_hash) << 2) |
+        (u8::from(cur.is_some() != exp.is_some()) << 3)
+}
+
+/// The failed check of an account whose info changed since the run read it (`acc.original`, `cur` now): kind 1 for the
+/// sender, 2 for the beneficiary, 3 for another account, with the differing fields and how the run observed the
+/// account's balance (an absent account's balance taken as 0).
+fn changed_info(
+    e: &Entry,
+    acc: &AccountChanges<'_>,
+    cur: Option<&AccountInfo>,
+    sender: Address,
+    beneficiary: Address,
+) -> Failure {
+    let addr = acc.address;
+    let k = if addr == sender { 1 } else if addr == beneficiary { 2 } else { 3 };
+    let f = Failure { diff: Some(info_diff(cur, acc.original)), ..fail(k, Some(addr)) };
+    f.observed(e, Some(cur.map_or(U256::ZERO, |c| c.balance)))
+}
+
+/// Execution thread: takes the prewarm result of transaction `index` and checks its read set against `db` (the
+/// execution thread's state before the transaction: the executor's accepted state overlay). Returns the entry and
+/// whether it is valid. With `reusediag`, a missing or invalid result is recorded.
+pub fn prepare<DB: DynDatabase + ?Sized>(
+    block: B256,
+    index: usize,
+    beneficiary: Address,
+    facts: &TxFacts,
+    db: &mut DB,
+) -> Option<(Box<Entry>, bool)> {
+    // Prologue (record only): the CPU time since the previous transaction's `prepare`, by that transaction's outcome
+    let now = thread_cpu_ns();
+    RZ_LAST.with(|c| {
+        let (t, k) = c.get();
+        if (k as usize) < RZ_CPU.len() && t > 0 {
+            RZ_CPU[k as usize].fetch_add(now.saturating_sub(t), Ordering::Relaxed);
+        }
+    });
+    let r = prepare_inner(block, index, beneficiary, facts, db);
+    let k = match &r {
+        None => {
+            let b = match index {
+                0..8 => 0,
+                8..16 => 1,
+                16..32 => 2,
+                32..64 => 3,
+                64..128 => 4,
+                128..256 => 5,
+                _ => 6,
+            };
+            MISS_POS[b].fetch_add(1, Ordering::Relaxed);
+            1
+        }
+        Some((_, true)) => 0,
+        Some((_, false)) => 2,
+    };
+    RZ_LAST.with(|c| c.set((now, k)));
+    r
+}
+
+fn prepare_inner<DB: DynDatabase + ?Sized>(
+    block: B256,
+    index: usize,
+    beneficiary: Address,
+    facts: &TxFacts,
+    db: &mut DB,
+) -> Option<(Box<Entry>, bool)> {
+    let e = SLOTS.lock().remove(&(block, index));
+    let Some(mut e) = e else {
+        STATS.missing.fetch_add(1, Ordering::Relaxed);
+        diag_record(index, None, None);
+        return None
+    };
+    STATS.found.fetch_add(1, Ordering::Relaxed);
+    let t0 = std::time::Instant::now();
+    let fast = FAST.load(Ordering::Relaxed);
+    // EXP-206 (`reusebal`): accounts accepted with their balance change applied as an increment
+    let mut adj = Vec::new();
+    let checked = if fast && mode() == 2 && !e.full_check {
+        validate_fast(&e, beneficiary, facts, db, &mut adj)
+    } else {
+        let full = validate(&e, beneficiary, facts, db, &mut adj);
+        // EXP-199: an entry that read the block's earlier prewarm writes may legitimately fail only the restricted check's
+        // assumption (unwritten keys hold the parent value), so it is not compared
+        if fast && !e.full_check && validate_fast(&e, beneficiary, facts, db, &mut Vec::new()).is_ok() != full.is_ok() {
+            let n = STATS.fast_diff.fetch_add(1, Ordering::Relaxed);
+            if n < 5 {
+                warn!(target: "reth::eap", tx = index, full = full.is_ok(), "eap reuse restricted check differs");
+            }
+        }
+        full
+    };
+    STATS.validate_ns.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+    let ok = checked.is_ok();
+    if e.full_check {
+        STATS.full_found.fetch_add(1, Ordering::Relaxed);
+        if ok {
+            STATS.full_valid.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+    if ok {
+        STATS.valid.fetch_add(1, Ordering::Relaxed);
+        if e.fee_only {
+            STATS.fee_only.fetch_add(1, Ordering::Relaxed);
+        }
+        // EXP-206: applied before the result is committed, or in check mode executed and compared
+        if !adj.is_empty() {
+            STATS.bal_relaxed.fetch_add(adj.len() as u64, Ordering::Relaxed);
+            STATS.bal_valid.fetch_add(1, Ordering::Relaxed);
+            // `reusebalsend`: `bal_relax` accepts an account the run observed only with that switch
+            if let Some(obs) = &e.bal_obs {
+                let n = adj.iter().filter(|(a, ..)| obs.contains_key(a)).count();
+                STATS.bal_send.fetch_add(n as u64, Ordering::Relaxed);
+            }
+            apply_adjust(&mut e.state, &adj);
+        }
+    }
+    if let Err(f) = checked {
+        diag_record(index, Some(f), Some(e.run));
+    }
+    Some((e, ok))
+}
+
+fn validate<DB: DynDatabase + ?Sized>(
+    e: &Entry,
+    beneficiary: Address,
+    facts: &TxFacts,
+    db: &mut DB,
+    adj: &mut Vec<(Address, U256, U256)>,
+) -> Result<(), Failure> {
+    let mut sender_seen = false;
+    for acc in e.state.account_changes() {
+        let addr = acc.address;
+        if addr == beneficiary && e.fee_only {
+            continue
+        }
+        let Ok(cur) = db.get_account(&addr) else {
+            return Err(fail(7, Some(addr)))
+        };
+        let exp = acc.original;
+        if !same(cur.as_ref(), exp) {
+            if let Some(x) = bal_relax(e, &acc, cur.as_ref(), exp, facts.sender, beneficiary) {
+                adj.push(x);
+            } else {
+                return Err(changed_info(e, &acc, cur.as_ref(), facts.sender, beneficiary))
+            }
+        }
+        if addr == facts.sender {
+            sender_seen = true;
+            let Some(c) = &cur else {
+                return Err(fail(6, Some(addr)))
+            };
+            if c.nonce != facts.nonce {
+                return Err(fail(5, Some(addr)))
+            }
+            if c.balance < facts.max_cost {
+                return Err(fail(6, Some(addr)))
+            }
+        }
+        for (k, s) in &acc.storage.slots {
+            match db.get_storage(&addr, k) {
+                Ok(v) if v == s.value.original => {}
+                Ok(_) => return Err(Failure { slot: Some(*k), ..fail(4, Some(addr)) }),
+                Err(_) => return Err(fail(7, Some(addr))),
+            }
+        }
+    }
+    if !sender_seen {
+        return Err(fail(1, Some(facts.sender)).observed(e, None))
+    }
+    Ok(())
+}
+
+/// The check restricted to the keys written so far in the block: a key that no transaction or system call of this block
+/// has committed still holds the parent state's value on the execution thread, which is what the prewarm run read (the
+/// prewarm workers read the parent state through the execution cache, which holds the state after the parent block and
+/// never this block's writes), so only written keys are compared. The sender's nonce and balance are checked as in the
+/// full check, from the current value when the sender was written, else from the value the run read.
+fn validate_fast<DB: DynDatabase + ?Sized>(
+    e: &Entry,
+    beneficiary: Address,
+    facts: &TxFacts,
+    db: &mut DB,
+    adj: &mut Vec<(Address, U256, U256)>,
+) -> Result<(), Failure> {
+    let m = MODIFIED.lock();
+    let mut sender_seen = false;
+    for acc in e.state.account_changes() {
+        let addr = acc.address;
+        if addr == beneficiary && e.fee_only {
+            continue
+        }
+        let exp = acc.original;
+        let written = m.accts.contains(&addr) || m.wiped.contains(&addr);
+        let cur = if written {
+            let Ok(cur) = db.get_account(&addr) else {
+                return Err(fail(7, Some(addr)))
+            };
+            if !same(cur.as_ref(), exp) {
+                if let Some(x) = bal_relax(e, &acc, cur.as_ref(), exp, facts.sender, beneficiary) {
+                    adj.push(x);
+                } else {
+                    return Err(changed_info(e, &acc, cur.as_ref(), facts.sender, beneficiary))
+                }
+            }
+            cur
+        } else {
+            exp.cloned()
+        };
+        if addr == facts.sender {
+            sender_seen = true;
+            let Some(c) = &cur else {
+                return Err(fail(6, Some(addr)))
+            };
+            if c.nonce != facts.nonce {
+                return Err(fail(5, Some(addr)))
+            }
+            if c.balance < facts.max_cost {
+                return Err(fail(6, Some(addr)))
+            }
+        }
+        let wiped = m.wiped.contains(&addr);
+        for (k, s) in &acc.storage.slots {
+            if !wiped && !m.slots.contains(&(addr, *k)) {
+                continue
+            }
+            match db.get_storage(&addr, k) {
+                Ok(v) if v == s.value.original => {}
+                Ok(_) => return Err(Failure { slot: Some(*k), ..fail(4, Some(addr)) }),
+                Err(_) => return Err(fail(7, Some(addr))),
+            }
+        }
+    }
+    if !sender_seen {
+        return Err(fail(1, Some(facts.sender)).observed(e, None))
+    }
+    Ok(())
+}
+
+/// Execution thread: the result to commit for a valid entry; the beneficiary's fee credit is applied as an increment on
+/// its current balance when the run's body did not load it. `None` when the result is not of the executor's types, the
+/// beneficiary cannot be read, or the commit cannot be expressed as detached state ([`as_committed`]).
+pub fn into_result<T: EvmTypes, DB: DynDatabase + ?Sized>(
+    e: Box<Entry>,
+    beneficiary: Address,
+    db: &mut DB,
+) -> Option<TxResultWithState<T>> {
+    let Entry { mut state, result, fee_only, .. } = *e;
+    let result = *result.downcast::<TxResult<T>>().ok()?;
+    if fee_only && state.account_changes_for(&beneficiary).is_some() {
+        let cur = db.get_account(&beneficiary).ok()?;
+        if !as_committed(&mut state, beneficiary, cur) {
+            return None
+        }
+    }
+    Some(TxResultWithState { result, pending_state: state, _non_exhaustive: () })
+}
+
+/// The fee-only beneficiary of a prewarm state as it is committed, from its current info `cur`: the run's increment on the
+/// current balance, nonce and code from the current state, and (EXP-179) the current info as the info it was loaded with.
+/// The execution thread's own run loads the beneficiary with its current info, so with a zero priority fee the account is
+/// unchanged there and the state-root task leaves it out of the update; with the prewarm's loaded info (the parent
+/// block's) it was sent as changed.
+///
+/// X-027: returns false when the committed account would be empty while it exists now: the execution thread's own run
+/// touches it and deletes it (EIP-161), which evm2's detached state cannot express (the caller executes the transaction
+/// instead). An absent beneficiary that stays empty is left absent (unchanged), as the own run leaves it.
+fn as_committed(state: &mut PendingState, beneficiary: Address, cur: Option<AccountInfo>) -> bool {
+    let Some(acc) = state.account_changes_for(&beneficiary) else { return true };
+    let empty = AccountInfo::default();
+    let (now, loaded) = (acc.current.unwrap_or(&empty), acc.original.unwrap_or(&empty));
+    let delta = now.balance.wrapping_sub(loaded.balance);
+    let mut info = cur.clone().unwrap_or_default();
+    info.balance = info.balance.wrapping_add(delta);
+    let current = if info.is_empty() {
+        if cur.is_some() {
+            return false
+        }
+        None
+    } else {
+        Some(info)
+    };
+    state.insert_account(beneficiary, cur, current);
+    true
+}
+
+/// The state-root task's view of a committed transaction state: the update the executor's state hook would stream for
+/// it (accounts the commit changes, without code; their changed slots), hashed as the state-root task hashes it
+/// (`state_update_to_hashed_post_state`).
+fn state_update(st: &PendingState) -> reth_trie::HashedPostState {
+    let mut block = reth_execution_types::BlockState::default();
+    let mut update = StateUpdate::default();
+    for changes in st.account_changes() {
+        block.commit_account_changes(changes, Some(&mut update));
+    }
+    reth_execution_types::state_update_to_hashed_post_state(&update)
+}
+
+/// Execution thread: transaction `index` of the block with hash `block_hash` (number `number`, beneficiary
+/// `beneficiary`). Returns the transaction back when it was not handled here (mode off, no prewarm result, read set
+/// changed, or not applicable), so that the caller executes it as usual; in check mode a valid entry is executed here and
+/// compared.
+pub fn run_tx<'a, C, Tx>(
+    executor: &mut BlockExecutorFor<'a, C>,
+    evm_config: &C,
+    block_hash: B256,
+    number: u64,
+    beneficiary: Address,
+    index: usize,
+    tx: Tx,
+) -> Result<Option<Tx>, BlockExecutionError>
+where
+    C: ConfigureEvm + 'a,
+    Tx: ExecutableTxFor<C>,
+{
+    let mut m = mode();
+    if m == 0 {
+        return Ok(Some(tx))
+    }
+    // `reusediag`: the state hook reports this transaction's commits from here
+    let diag = DIAG_ON.load(Ordering::Relaxed);
+    if diag {
+        DIAG.lock().cur = Writer::Tx { index, reused: false };
+    }
+    let chk = CHK.load(Ordering::Relaxed);
+    let picked = chk > 0 && index as u64 % chk == 0;
+    if m == 2 && (TRIPPED.load(Ordering::Relaxed) || picked) {
+        m = 1;
+    }
+    let ben = beneficiary;
+    let (facts, gas_limit) = {
+        let itx = RecoveredTx::tx(&tx);
+        let max_cost = tx_max_cost(
+            itx.gas_limit(),
+            itx.max_fee_per_gas(),
+            itx.value(),
+            itx.blob_gas_used().unwrap_or(0),
+            itx.max_fee_per_blob_gas().unwrap_or(0),
+        );
+        (
+            max_cost.map(|max_cost| TxFacts { sender: *RecoveredTx::signer(&tx), nonce: itx.nonce(), max_cost }),
+            itx.gas_limit(),
+        )
+    };
+    // a maximum cost beyond U256::MAX: no balance covers it (failure kind 6); the usual execution rejects it
+    let Some(facts) = facts else {
+        diag_record(index, Some(fail(6, Some(*RecoveredTx::signer(&tx)))), None);
+        return Ok(Some(tx))
+    };
+    let Some((e, ok)) = prepare(block_hash, index, ben, &facts, executor.evm_mut().state_db_mut()) else {
+        return Ok(Some(tx))
+    };
+    if !ok {
+        return Ok(Some(tx))
+    }
+    if m == 1 {
+        let cur = executor.evm_mut().state_db_mut().get_account(&ben).ok().flatten();
+        let before = cur.as_ref().map(|c| c.balance).unwrap_or_default();
+        let out = executor.execute_transaction_without_commit(tx)?;
+        STATS.checked.fetch_add(1, Ordering::Relaxed);
+        {
+            let res = reth_evm::BlockTransactionResult::result(&out);
+            let _ = compare(number, index, &e, res, ben, before);
+            // EXP-179: the state-root update the reused result would send against the one of this run
+            let mut st = e.state.clone();
+            let expressible = !e.fee_only || as_committed(&mut st, ben, cur);
+            if !expressible || state_update(&st) != state_update(&res.pending_state) {
+                let n = STATS.upd_mismatch.fetch_add(1, Ordering::Relaxed);
+                if n < 5 {
+                    warn!(target: "reth::eap", block = number, tx = index, "eap reuse state-root update differs");
+                }
+            }
+        }
+        executor.commit_transaction(out)?;
+        return Ok(None)
+    }
+    let t0 = std::time::Instant::now();
+    // the block gas check of `execute_transaction_without_commit`; the transaction cannot exceed the block's gas left
+    if executor.validate_transaction_gas_limit(gas_limit).is_err() {
+        diag_record(index, Some(fail(0, None)), Some(e.run));
+        return Ok(Some(tx))
+    }
+    // `reusediag`: the run number of the result, which `into_result` takes
+    let run = Some(e.run);
+    let Some(res) = into_result::<EvmTypesFor<C>, _>(e, ben, executor.evm_mut().state_db_mut()) else {
+        diag_record(index, Some(fail(0, None)), run);
+        return Ok(Some(tx))
+    };
+    // the executor's per-transaction result; an EVM configuration without one keeps executing as usual
+    let Some(out) = evm_config.prewarm_tx_result(RecoveredTx::tx(&tx), res) else {
+        diag_record(index, Some(fail(0, None)), run);
+        return Ok(Some(tx))
+    };
+    // `reusediag`: this transaction's commit is its prewarm result
+    if diag {
+        DIAG.lock().cur = Writer::Tx { index, reused: true };
+    }
+    executor.commit_transaction(out)?;
+    STATS.reused.fetch_add(1, Ordering::Relaxed);
+    STATS.reuse_ns.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+    Ok(None)
+}
+
+/// The accounts a run touched, sorted.
+fn touched_of(st: &PendingState) -> Vec<Address> {
+    let mut v: Vec<Address> = st.account_changes().filter(|a| a.touched).map(|a| a.address).collect();
+    v.sort();
+    v
+}
+
+/// The changed slots of an account in a run, sorted: (key, value after the run).
+fn changed_slots(acc: &AccountChanges<'_>) -> Vec<(U256, U256)> {
+    let mut v: Vec<(U256, U256)> =
+        acc.storage.slots.iter().filter(|(_, s)| s.value.is_changed()).map(|(k, s)| (*k, s.value.current)).collect();
+    v.sort();
+    v
+}
+
+/// Check mode: compares a valid prewarm result with the execution thread's own result (`ser`, executed on `before`, the
+/// beneficiary's balance before the transaction); counts and logs the first difference.
+pub fn compare<T: EvmTypes>(
+    block_number: u64,
+    index: usize,
+    e: &Entry,
+    ser: &TxResultWithState<T>,
+    beneficiary: Address,
+    ben_before: U256,
+) -> bool {
+    let f = compare_found(e, ser, beneficiary, ben_before);
+    let differs = f.differs();
+    f.apply(block_number, index);
+    differs
+}
+
+/// What comparing a reused result with a run found ([`compare`] applies it).
+#[derive(Debug, Default)]
+pub struct Found {
+    /// differs outside the block's fields: kind (1 reason, 2 output, 3 revert against halt), and the prewarm and run
+    /// results while fewer than five are logged
+    nc: Option<(usize, Option<(String, String)>)>,
+    /// differs in what reaches the block (the field, account or slot)
+    mismatch: Option<String>,
+    /// background check: the state-root update differs (EXP-215, not ported: always false)
+    upd: bool,
+}
+
+impl Found {
+    /// Whether the reused result differs from the run.
+    pub fn differs(&self) -> bool {
+        self.mismatch.is_some() || self.upd
+    }
+
+    /// Counts and logs the findings; a difference trips reuse for the process.
+    fn apply(self, block_number: u64, index: usize) {
+        if let Some((kind, ab)) = self.nc {
+            STATS.nc_kind[kind].fetch_add(1, Ordering::Relaxed);
+            let n = STATS.nonconsensus.fetch_add(1, Ordering::Relaxed);
+            if let Some((a, b)) = ab.filter(|_| n < 5) {
+                warn!(target: "reth::eap", block = block_number, tx = index, prewarm = %a, exec = %b,
+                    "eap reuse result differs outside the block's fields");
+            }
+        }
+        if let Some(w) = self.mismatch {
+            TRIPPED.store(true, Ordering::Relaxed);
+            let n = STATS.mismatch.fetch_add(1, Ordering::Relaxed);
+            if n < 5 {
+                warn!(target: "reth::eap", block = block_number, tx = index, what = %w, "eap reuse mismatch");
+            }
+        }
+        if self.upd {
+            TRIPPED.store(true, Ordering::Relaxed);
+            let n = STATS.upd_mismatch.fetch_add(1, Ordering::Relaxed);
+            if n < 5 {
+                warn!(target: "reth::eap", block = block_number, tx = index, "eap reuse background check: state-root update differs");
+            }
+        }
+    }
+}
+
+/// [`compare`] without its effects.
+///
+/// X-027: the fields of evm2's [`TxResult`] that reach the block are the success flag, the gas accounting (total,
+/// state gas, refund, floor) and the logs; the stop reason and the output (with the created address) are reported
+/// separately, as revm's halt or success reason and output were.
+fn compare_found<T: EvmTypes>(e: &Entry, ser: &TxResultWithState<T>, beneficiary: Address, ben_before: U256) -> Found {
+    let mut found = Found::default();
+    let what: Option<String> = (|| {
+        let (Some(pr), sr) = (e.result.downcast_ref::<TxResult<T>>(), &ser.result) else {
+            return Some("result type".to_string())
+        };
+        let gas = |r: &TxResult<T>| (r.total_gas_spent, r.state_gas_spent, r.refunded, r.floor_gas);
+        if pr.status != sr.status || gas(pr) != gas(sr) || pr.logs != sr.logs {
+            return Some(format!("result {:.300} vs {:.300}", format!("{pr:?}"), format!("{sr:?}")))
+        }
+        // the rest of the result (the extension data is not compared)
+        if (pr.stop, &pr.output, pr.created_address) != (sr.stop, &sr.output, sr.created_address) {
+            let kind = if pr.status {
+                if pr.stop != sr.stop { 1 } else if (&pr.output, pr.created_address) != (&sr.output, sr.created_address) { 2 } else { 0 }
+            } else if pr.is_revert() != sr.is_revert() {
+                3
+            } else if pr.stop != sr.stop {
+                1
+            } else if pr.output != sr.output {
+                2
+            } else {
+                2
+            };
+            // 1 reason, 2 output, 3 kind (revert against halt); 0 cannot occur after the checks above
+            let logged = STATS.nonconsensus.load(Ordering::Relaxed) < 5;
+            found.nc = Some((kind, logged.then(|| (format!("{:.300}", format!("{pr:?}")), format!("{:.300}", format!("{sr:?}"))))));
+        }
+        let (tp, ts) = (&e.touched, touched_of(&ser.pending_state));
+        if *tp != ts {
+            return Some(format!("touched {} vs {}", tp.len(), ts.len()))
+        }
+        let empty = AccountInfo::default();
+        for a in ts {
+            let (Some(x), Some(y)) = (e.state.account_changes_for(&a), ser.pending_state.account_changes_for(&a)) else {
+                return Some(format!("touched {a}"))
+            };
+            let (xi, yi) = (x.current.unwrap_or(&empty), y.current.unwrap_or(&empty));
+            if a == beneficiary && e.fee_only {
+                let xo = x.original.unwrap_or(&empty);
+                let dx = xi.balance.wrapping_sub(xo.balance);
+                let dy = yi.balance.wrapping_sub(ben_before);
+                if dx != dy || xi.nonce != xo.nonce {
+                    return Some(format!("beneficiary {a}"))
+                }
+            } else if (xi.balance, xi.nonce, xi.code_hash) != (yi.balance, yi.nonce, yi.code_hash) ||
+                x.current.is_some() != y.current.is_some()
+            {
+                return Some(format!("info {a}"))
+            }
+            if (x.created, x.selfdestructed) != (y.created, y.selfdestructed) {
+                return Some(format!("status {a}"))
+            }
+            if changed_slots(&x) != changed_slots(&y) {
+                return Some(format!("storage {a}"))
+            }
+        }
+        None
+    })();
+    found.mismatch = what;
+    found
+}
+
+/// Execution thread: the block's transactions are done; one log line, and with `reusediag` a second one with the
+/// block's records (kept until the next block's [`begin_exec`]).
+pub fn finish_exec(block_number: u64, txs: usize) {
+    let m = mode();
+    if m == 0 {
+        return
+    }
+    let s = &*STATS;
+    let g = |a: &AtomicU64| a.load(Ordering::Relaxed);
+    // EXP-215 (`reusechkbg`) is not ported: its fields are printed as with the switch off
+    let bg_on = false;
+    if !crate::tree::eap::logq() {
+        info!(
+            target: "reth::eap",
+            block = block_number,
+            mode = m,
+            txs,
+            stored = g(&s.stored),
+            found = g(&s.found),
+            missing = g(&s.missing),
+            valid = g(&s.valid),
+            reused = g(&s.reused),
+            fee_only = g(&s.fee_only),
+            checked = g(&s.checked),
+            fast = FAST.load(Ordering::Relaxed),
+            fast_diff = g(&s.fast_diff),
+            full_found = g(&s.full_found),
+            full_valid = g(&s.full_valid),
+            bal = BAL.load(Ordering::Relaxed),
+            balsend = BAL_SEND.load(Ordering::Relaxed),
+            bal_relaxed = g(&s.bal_relaxed),
+            bal_valid = g(&s.bal_valid),
+            bal_send = g(&s.bal_send),
+            bg = 0u8,
+            bg_checks = g(&s.bg_checks),
+            bg_diff = g(&s.bg_diff),
+            bg_err = g(&s.bg_err),
+            bg_wait_us = g(&s.bg_wait_ns) / 1000,
+            bg_cpu_us = g(&s.bg_cpu_ns) / 1000,
+            log_n = g(&s.log_n),
+            log_us = g(&s.log_ns) / 1000,
+            exec_runq_us = if bg_on {
+                crate::tree::eap::thread_sched_ns().1.saturating_sub(g(&s.exec_runq0_ns)) / 1000
+            } else {
+                0
+            },
+            nonconsensus = g(&s.nonconsensus),
+            nc_reason = g(&s.nc_kind[1]),
+            nc_output = g(&s.nc_kind[2]),
+            nc_kind = g(&s.nc_kind[3]),
+            tripped = TRIPPED.load(Ordering::Relaxed),
+            f_sender = g(&s.fail[1]),
+            f_benef = g(&s.fail[2]),
+            f_acct = g(&s.fail[3]),
+            f_slot = g(&s.fail[4]),
+            f_nonce = g(&s.fail[5]),
+            f_bal = g(&s.fail[6]),
+            f_db = g(&s.fail[7]),
+            mismatch = g(&s.mismatch),
+            upd_mismatch = g(&s.upd_mismatch),
+            validate_us = g(&s.validate_ns) / 1000,
+            reuse_us = g(&s.reuse_ns) / 1000,
+            store_us = g(&s.store_ns) / 1000,
+            "eap reuse"
+        );
+    }
+    if DIAG_ON.load(Ordering::Relaxed) {
+        let d = DIAG.lock();
+        let missing = d.items.iter().filter(|x| x.failure.is_none()).count();
+        info!(
+            target: "reth::eap",
+            block = block_number,
+            fails = d.items.len() - missing,
+            missing,
+            items = %diag_items(&d.items),
+            "eap reusediag"
+        );
+    }
+    // Prologue (record only): kept for the block's xbtl2 line before the store counters reset
+    let (f, b) = (FIRST_STORE_NS.swap(0, Ordering::Relaxed), EXEC_BEGIN_NS.load(Ordering::Relaxed));
+    BLOCK_FIRST_REL_NS.store(if f == 0 || b == 0 { i64::MIN } else { f as i64 - b as i64 }, Ordering::Relaxed);
+    s.stored.store(0, Ordering::Relaxed);
+    s.store_ns.store(0, Ordering::Relaxed);
+}
+
+/// Prologue (`reusefb=1`, researcher 11-05): whether a failed validation of the block with hash `block` is made again on
+/// the block executed without reused prewarm results ([`fallback_reused`]): the switch is on for the block and at least
+/// one prewarm result was committed in its execution in place of running the transaction, not yet taken. The count is the
+/// block's only when [`begin_exec`] started its execution (reuse on for the block): the counters are reset there and
+/// belong to the last block it started, so they are read before the next block's execution starts. Changes nothing.
+pub fn fallback_pending(block: B256) -> bool {
+    let m = crate::tree::eap::current();
+    m.active &&
+        m.reusefb &&
+        mode() != 0 &&
+        exec_block() == block &&
+        STATS.reused.load(Ordering::Relaxed) > 0
+}
+
+/// Prologue (`reusefb=1`): called when the validation of the block with hash `block` fails (execution error,
+/// post-execution checks or state root). When [`fallback_pending`], takes the count of prewarm results committed in its
+/// execution (a second call returns `None`) and drops the block's remaining prewarm results, so that the caller executes
+/// the block again without them; otherwise returns `None` and changes nothing.
+pub fn fallback_reused(block: B256) -> Option<u64> {
+    if !fallback_pending(block) {
+        return None
+    }
+    SLOTS.lock().retain(|k, _| k.0 != block);
+    Some(STATS.reused.swap(0, Ordering::Relaxed))
+}
+
+// ---- EXP-206 (`reusebal`): balance changes of unobserved accounts accepted as increments ----
+
+/// EXP-206 (`reusebal=1`): accept unobserved balance changes of accounts other than the sender and the beneficiary.
+static BAL: AtomicBool = AtomicBool::new(false);
+
+/// Prologue (`reusebalsend=1`, with `reusebal`): also accept the balance changes of accounts that the run observed only
+/// by sending value out of them, when every such transfer still has enough balance ([`bal_relax`]).
+static BAL_SEND: AtomicBool = AtomicBool::new(false);
+
+/// Prologue (`reusebalsend=1`): sets the switch for the next block (called from `eap::refresh`, on only with
+/// `reusebal`). Off: [`bal_relax`] refuses every account the run observed, as without the switch.
+pub fn set_bal_send(on: bool) {
+    BAL_SEND.store(on, Ordering::Relaxed);
+}
+
+/// EXP-206 (`reusebal`): how a run observed an account's balance. The reuse decision takes whether it did and, with
+/// `reusebalsend`, what its transfers out of the account left ([`bal_relax`]); `reusediag` reports how for the account
+/// of a failed check ([`Failure::observed`]).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct BalObs {
+    /// [`BalObs::READ`] and [`BalObs::SENT`], or-ed.
+    bits: u8,
+    /// The total value of the calls and creations that sent value out of the account, added when their frame starts
+    /// (also when its transfer then fails for lack of balance).
+    sent: U256,
+    /// `reusebalsend`: the least balance a transfer of value out of the account left in the run, its balance in the run
+    /// just before the transfer minus the value (`U256::MAX` before the first transfer); `None` when a transfer had too
+    /// little balance or its balance could not be read.
+    min_slack: Option<U256>,
+}
+
+impl BalObs {
+    /// BALANCE, SELFBALANCE or SELFDESTRUCT read the balance (interpreted or compiled).
+    const READ: u8 = 1;
+    /// A call or creation sent value out of the account, which checks its balance.
+    const SENT: u8 = 2;
+}
+
+/// Not observed.
+impl Default for BalObs {
+    fn default() -> Self {
+        Self { bits: 0, sent: U256::ZERO, min_slack: Some(U256::MAX) }
+    }
+}
+
+/// Prewarm inspector with `reusebal` in its block's mode, at the top-level frame of a run: records this run's balance
+/// observations from here on. A run that the inspector did not record from its start (another block's inspector, or the
+/// switch changed between blocks) stores no observations and accepts no balance change.
+pub fn obs_start() {
+    OBS.with(|o| *o.borrow_mut() = Some(AddressMap::default()));
+    OBS_LOST.with(|l| l.set(false));
+}
+
+/// The current run's balance observations, as stored with its result (and cleared). EXP-206: they count only when the
+/// inspector recorded the run from its top-level frame start (with `reusebal` in its block's mode) to its top-level
+/// frame end (`body` not 0); EXP-233: and when none of them was lost ([`pw_balance_hook`]).
+fn take_obs(body: u8) -> Option<AddressMap<BalObs>> {
+    let lost = OBS_LOST.with(|l| l.replace(false)) || OBS_NO_HOOK.with(|c| c.get());
+    OBS.with(|o| o.borrow_mut().take()).filter(|_| body != 0 && !lost)
+}
+
+/// EXP-233: set whenever a prewarm thread builds its EVM for a block: whether its compiled runs record balance
+/// observations without the balance callback (the backend could not install it); then they store none.
+pub fn set_obs_hook_missing(missing: bool) {
+    OBS_NO_HOOK.with(|c| c.set(missing));
+}
+
+/// Prewarm inspector: whether balance observations are being recorded on this thread for the current run.
+pub fn bal_obs_on() -> bool {
+    OBS.with(|o| o.borrow().is_some())
+}
+
+/// Prewarm inspector: the current run read the balance of `a` (BALANCE, SELFBALANCE, SELFDESTRUCT).
+pub fn obs_balance(a: Address) {
+    obs_add(a, |x| x.bits |= BalObs::READ);
+}
+
+/// Adds an observation of the balance of `a` to the current run's with `f`, when they are recorded.
+fn obs_add(a: Address, f: impl FnOnce(&mut BalObs)) {
+    OBS.with(|o| {
+        if let Some(m) = o.borrow_mut().as_mut() {
+            f(m.entry(a).or_default());
+        }
+    });
+}
+
+/// A transfer of `value` out of `a` starts in the frame of `interp`, when the current run's observations are recorded:
+/// observes the balance of `a` ([`BalObs::SENT`]), adds `sent` to the total sent out of it, and keeps the balance the
+/// transfer leaves ([`BalObs::min_slack`]). The balance before the transfer is read in the run's own state, the
+/// transaction overlay with the run's earlier changes (`Evm::read_account_info`, which neither loads, warms nor
+/// journals the account); a balance that cannot be read counts as too little.
+fn obs_send<T: EvmTypes>(interp: &mut Interpreter<'_, '_, T>, a: Address, value: U256, sent: U256) {
+    if !bal_obs_on() {
+        return
+    }
+    let balance = interp.host().read_account_info(&a).ok().map(|info| info.map_or(U256::ZERO, |i| i.balance));
+    obs_add(a, |x| {
+        x.bits |= BalObs::SENT;
+        x.sent = x.sent.saturating_add(sent);
+        x.min_slack = x.min_slack.zip(balance.and_then(|b| b.checked_sub(value))).map(|(m, s)| m.min(s));
+    });
+}
+
+/// EXP-233 (`reusebal` with `pwjitreal`): revmc's balance callback (`set_balance_hook`) on the prewarm threads whose
+/// inspected runs use compiled code: the account whose balance compiled BALANCE, SELFBALANCE or SELFDESTRUCT reads
+/// (before the read, so also when the instruction then fails), as [`obs_step`] takes it in interpreted frames. Without
+/// a recording run on this thread it does nothing.
+///
+/// It is called from inside compiled code (a revmc builtin), where a panic cannot unwind and aborts the process, so it
+/// uses only non-panicking accessors. An observation that cannot be recorded (the observations are borrowed, the
+/// thread-local storage is gone) marks the run's observations lost ([`OBS_LOST`]): it then stores none and accepts no
+/// balance change, rather than one with an observation missing.
+pub fn pw_balance_hook(a: Address) {
+    let kept = OBS
+        .try_with(|o| match o.try_borrow_mut() {
+            Ok(mut o) => {
+                if let Some(m) = o.as_mut() {
+                    m.entry(a).or_default().bits |= BalObs::READ;
+                }
+                true
+            }
+            Err(_) => false,
+        })
+        .unwrap_or(false);
+    if !kept {
+        let _ = OBS_LOST.try_with(|l| l.set(true));
+    }
+}
+
+/// Prewarm inspector, every interpreted instruction: BALANCE observes the balance of the account on the stack,
+/// SELFBALANCE and SELFDESTRUCT the frame's own, and CALL, CALLCODE, CREATE and CREATE2 with a non-zero value operand the
+/// frame's own (the sender of the value). These are taken here, before the instruction, as well as in the inspector's
+/// frame and `selfdestruct` hooks, since some paths check the balance without reaching a hook: revm charges
+/// SELFDESTRUCT's new-account gas only for a non-zero balance and calls the hook only on success, and with Amsterdam
+/// (EIP-8037) CREATE checks the creator's balance itself and pushes 0 without starting a frame. The value is added to
+/// the sender's total only by the frame hooks ([`obs_call`], [`obs_create`]), so that it counts once: a frame that sends
+/// value reaches them before its transfer checks the balance, and an observation taken only here (no frame started)
+/// sent nothing. The balance the send leaves ([`obs_send`]) is kept here as well, read before the instruction, which
+/// changes no balance before the transfer or CREATE's own check: a CREATE that Amsterdam refuses for lack of balance
+/// counts as a failed transfer, and a frame hook keeps the same balance again. An instruction that stops before its
+/// transfer for another reason (out of gas) is kept too, which can only refuse more.
+pub fn obs_step<T: EvmTypes>(interp: &mut Interpreter<'_, '_, T>) {
+    if !bal_obs_on() {
+        return
+    }
+    match interp.opcode() {
+        op::BALANCE => {
+            if let Some(v) = interp.stack().peek(0) {
+                obs_balance(v.to_address());
+            }
+        }
+        op::SELFBALANCE | op::SELFDESTRUCT => obs_balance(interp.message().destination),
+        // the value operand: the top for CREATE and CREATE2 (value, offset, size[, salt]), the third for CALL and CALLCODE
+        // (gas, address, value, ...)
+        op::CREATE | op::CREATE2 | op::CALL | op::CALLCODE => {
+            let depth = if matches!(interp.opcode(), op::CALL | op::CALLCODE) { 3 } else { 1 };
+            if let Some(value) = interp.stack().peek(depth - 1).filter(|v| !v.is_zero()) {
+                let a = interp.message().destination;
+                obs_send(interp, a, value, U256::ZERO);
+            }
+        }
+        _ => {}
+    }
+}
+
+/// Prewarm inspector, `interp` the frame whose instruction sent the message (for the top-level message, a frame
+/// initialized with it): a call that sends value observes the sender's balance (it fails when the balance is short),
+/// adds the value to the total sent out of it and keeps the balance the transfer leaves. The hook runs before the
+/// call's depth check and its transfer, for interpreted and compiled frames alike: compiled code sends its messages
+/// through the host, and the JIT runner prepares the frame's host before running it.
+pub fn obs_call<T: EvmTypes>(interp: &mut Interpreter<'_, '_, T>, message: &Message<T>) {
+    if matches!(message.kind, MessageKind::Call | MessageKind::CallCode) && !message.value.is_zero() {
+        obs_send(interp, message.caller, message.value, message.value);
+    }
+}
+
+/// Prewarm inspector: a creation that sends value observes the creator's balance, adds the value to the total sent out
+/// of it and keeps the balance the transfer leaves, as [`obs_call`] (before the creation's own balance check).
+pub fn obs_create<T: EvmTypes>(interp: &mut Interpreter<'_, '_, T>, message: &Message<T>) {
+    if message.value > U256::ZERO {
+        obs_send(interp, message.caller, message.value, message.value);
+    }
+}
+
+/// EXP-206 (`reusebal`): an account whose read changed is accepted when only its balance changed, it is neither the
+/// sender nor the beneficiary, it exists and is not empty in both views (an empty account changes EXTCODEHASH and the
+/// new-account gas of a value transfer), and the run was observed and did not observe this balance. Such a run only
+/// credited the account (value sent out or SELFDESTRUCT would have observed it), so its result is the same for any
+/// starting balance except the balance itself. Returns (account, balance the run read, current balance).
+///
+/// Prologue (`reusebalsend`): also an account whose balance the run observed only by sending value out of it, when
+/// every such transfer had enough balance and still has after the change: applied as an increment, the change moves
+/// the account's balance by the same amount before each transfer, so a decrease must not exceed the least balance a
+/// transfer left ([`BalObs::min_slack`]). Without the switch every observed account is refused, so [`prepare`] counts
+/// the accepted observed accounts as the switch's.
+///
+/// X-027: not for an account created or destroyed in the run, or whose storage it wiped: its commit is rewritten as
+/// detached state, which cannot keep those flags.
+fn bal_relax(
+    e: &Entry,
+    acc: &AccountChanges<'_>,
+    cur: Option<&AccountInfo>,
+    exp: Option<&AccountInfo>,
+    sender: Address,
+    beneficiary: Address,
+) -> Option<(Address, U256, U256)> {
+    let a = acc.address;
+    if !BAL.load(Ordering::Relaxed) || a == sender || a == beneficiary {
+        return None
+    }
+    let obs = e.bal_obs.as_ref()?;
+    // `reusebalsend`: the least balance the run's transfers out of the account left; `None` when it was not observed
+    let min_slack = match obs.get(&a) {
+        None => None,
+        Some(o) if BAL_SEND.load(Ordering::Relaxed) && o.bits == BalObs::SENT && o.min_slack.is_some() => o.min_slack,
+        Some(_) => return None,
+    };
+    if acc.created || acc.selfdestructed || acc.storage.wiped {
+        return None
+    }
+    let (Some(c), Some(x)) = (cur, exp) else { return None };
+    if c.is_empty() || x.is_empty() || c.nonce != x.nonce || c.code_hash != x.code_hash || c.balance == x.balance {
+        return None
+    }
+    if let Some(m) = min_slack &&
+        let Some(decrease) = x.balance.checked_sub(c.balance) &&
+        m < decrease
+    {
+        return None
+    }
+    Some((a, x.balance, c.balance))
+}
+
+/// EXP-206: the accepted accounts' balances moved by their change since the run read them (the run's own change to them
+/// is kept on top), loaded with the current balance as the execution thread's own run would load them.
+fn apply_adjust(state: &mut PendingState, adj: &[(Address, U256, U256)]) {
+    for (a, read, cur) in adj {
+        let Some(acc) = state.account_changes_for(a) else { continue };
+        let mut current = acc.current.cloned();
+        if let Some(c) = &mut current {
+            c.balance = c.balance.wrapping_sub(*read).wrapping_add(*cur);
+        }
+        let mut original = acc.original.cloned();
+        if let Some(o) = &mut original {
+            o.balance = *cur;
+        }
+        state.insert_account(*a, original, current);
+    }
+}
+
+// ---- Prologue (`reusediag`): why a transaction's prewarm result was not committed ----
+
+/// `reusediag=1` for the block being processed ([`set_diag`]).
+static DIAG_ON: AtomicBool = AtomicBool::new(false);
+
+/// Prologue (`reusediag=1`): sets the switch for the next block (called from `eap::refresh`). With it, every
+/// transaction whose prewarm result is not committed is recorded (by [`prepare`] and [`run_tx`]) with the block's last
+/// commit before it that changed the account or slot whose check failed, for an account with how the run observed its
+/// balance, and [`finish_exec`] logs the block's records in one `eap reusediag` line. Off: nothing is recorded.
+pub fn set_diag(on: bool) {
+    DIAG_ON.store(on, Ordering::Relaxed);
+}
+
+/// `reusediag`: a commit of the block's execution thread; the derived order is the commit order.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
+enum Writer {
+    /// The pre-block system calls.
+    #[default]
+    PreBlock,
+    /// Transaction `index`; `reused` when its prewarm result was committed in place of running it.
+    Tx { index: usize, reused: bool },
+}
+
+/// `reusediag`: a transaction of the block whose prewarm result was not committed.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct DiagItem {
+    /// The transaction's index in the block.
+    index: usize,
+    /// The check that failed; `None` when the prewarm left no result.
+    failure: Option<Failure>,
+    /// The block's last commit before the transaction that changed the failure's slot, or else its account's info;
+    /// `None` when none did (the run read a value that the execution thread did not commit).
+    writer: Option<Writer>,
+    /// The run number of the prewarm result ([`Entry::run`]); `None` when no result was taken.
+    run: Option<u32>,
+}
+
+/// `i,k,w,wr,f,run,o,s,addr[,slot]`: the transaction index; the failure kind, `m` without a result; the last writer's
+/// transaction index, -2 for the pre-block system calls, -1 for none; 1 when that transaction was committed from its
+/// prewarm result, 0 when it was executed; the differing fields of kinds 1-3 ([`info_diff`]); the prewarm run number;
+/// for kinds 1-3, how the run observed the account's balance (1 read, 2 value sent out of it, 0 not observed;
+/// [`Failure::obs`]) and, when only by sending value, `y` when the current balance covers the total sent, else `n`
+/// ([`Failure::covers`]); the account and, for kind 4, the slot, in hex. A field that does not apply, or observations
+/// the run did not record, is `-`.
+impl fmt::Display for DiagItem {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let x = self.failure.as_ref();
+        match x {
+            Some(x) => write!(f, "{},{}", self.index, x.kind)?,
+            None => write!(f, "{},m", self.index)?,
+        }
+        match self.writer {
+            Some(Writer::Tx { index, reused }) => write!(f, ",{index},{}", u8::from(reused))?,
+            Some(Writer::PreBlock) => f.write_str(",-2,-")?,
+            None => f.write_str(",-1,-")?,
+        }
+        match x.and_then(|x| x.diff) {
+            Some(d) => write!(f, ",{d}")?,
+            None => f.write_str(",-")?,
+        }
+        match self.run {
+            Some(r) => write!(f, ",{r}")?,
+            None => f.write_str(",-")?,
+        }
+        match x.and_then(|x| x.obs) {
+            Some(o) => write!(f, ",{o}")?,
+            None => f.write_str(",-")?,
+        }
+        match x.and_then(|x| x.covers) {
+            Some(c) => f.write_str(if c { ",y" } else { ",n" })?,
+            None => f.write_str(",-")?,
+        }
+        match x.and_then(|x| x.addr) {
+            Some(a) => write!(f, ",{a:#x}")?,
+            None => f.write_str(",-")?,
+        }
+        match x.and_then(|x| x.slot) {
+            Some(k) => write!(f, ",{k:#x}"),
+            None => Ok(()),
+        }
+    }
+}
+
+/// `reusediag`: the commits of the block's execution thread that changed each key, and the block's records; reset by
+/// [`begin_exec`].
+#[derive(Debug, Default)]
+struct Diag {
+    /// The commit the state hook reports: the pre-block system calls, then the transaction [`run_tx`] is at.
+    cur: Writer,
+    /// The last commit that changed each account's info (what [`same`] compares).
+    accts: AddressMap<Writer>,
+    /// The last commit that created or destroyed each account or wiped its storage, which changes every slot of it.
+    wiped: AddressMap<Writer>,
+    /// The last commit that changed each slot.
+    slots: HashMap<(Address, U256), Writer>,
+    /// The transactions whose prewarm result was not committed, in order.
+    items: Vec<DiagItem>,
+}
+
+impl Diag {
+    /// Records the keys that `update` changed as changed by the current commit.
+    fn record(&mut self, update: &StateUpdate) {
+        for a in &update.accounts {
+            if !same(a.original.as_ref(), a.current.as_ref()) {
+                self.accts.insert(a.address, self.cur);
+            }
+            if a.created || a.wiped || a.current.is_none() {
+                self.wiped.insert(a.address, self.cur);
+            }
+            for (k, _) in &a.storage {
+                self.slots.insert((a.address, *k), self.cur);
+            }
+        }
+    }
+
+    /// The last commit that changed the info of `addr`, or with `slot` that slot: the later of its own last change and
+    /// the account's last wipe.
+    fn writer(&self, addr: Address, slot: Option<U256>) -> Option<Writer> {
+        match slot {
+            Some(k) => self.slots.get(&(addr, k)).max(self.wiped.get(&addr)).copied(),
+            None => self.accts.get(&addr).copied(),
+        }
+    }
+}
+
+/// `reusediag`: the state of the block being executed, touched only with the switch on.
+static DIAG: LazyLock<Mutex<Diag>> = LazyLock::new(|| Mutex::new(Diag::default()));
+
+/// `reusediag`: transaction `index` is not committed from its prewarm result because of `failure` (`None`: there is no
+/// result); `run` is the result's run number (`None` when no result was taken). Recorded with the last writer of the
+/// failure's account or slot.
+fn diag_record(index: usize, failure: Option<Failure>, run: Option<u32>) {
+    if !DIAG_ON.load(Ordering::Relaxed) {
+        return
+    }
+    let mut d = DIAG.lock();
+    let writer = failure.and_then(|f| d.writer(f.addr?, f.slot));
+    d.items.push(DiagItem { index, failure, writer, run });
+}
+
+/// `reusediag`: the block's records as [`DiagItem`] displays them, joined by `;`.
+fn diag_items(items: &[DiagItem]) -> String {
+    items.iter().map(DiagItem::to_string).collect::<Vec<_>>().join(";")
+}
