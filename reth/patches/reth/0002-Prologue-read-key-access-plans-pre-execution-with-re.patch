+/// Reader threads of one block. Dropping it stops and joins them.
+#[derive(Debug)]
+pub struct BlockPrefetch {
+    mode: Mode,
+    number: u64,
+    /// The readers' frame channel, also the execution-thread inspector's (`cs`, EXP-236 [`EapExecInspector`]); `sysk` slots.
+    cs_tx: Option<Sender<Item>>,
+    stop: Arc<AtomicBool>,
+    /// EXP-150: sender of the readers' stop channel (dropped at block end when `rdstop=1`)
+    stop_tx: Option<Sender<()>>,
+    threads: Vec<ReaderHandle>,
+    stats: Arc<Stats>,
+    started: Instant,
+}
+
+impl BlockPrefetch {
+    /// Starts the probe, and the reader threads when this block's configuration asks for
+    /// prefetch (`factory` builds their cache-filling providers). EXP-235: with `pl` alone (readers without the
+    /// probe) it starts too; the execution thread's provider is then not wrapped in the probe (`payload_validator.rs`).
+    ///
+    /// `caches`: the block's execution cache, kept by the readers only with `rdpeek=1` (looked up before a read).
+    pub fn start(
+        mode: Mode,
+        factory: Option<ProviderFactory>,
+        caches: Option<reth_execution_cache::ExecutionCache>,
+        info: BlockInfo,
+    ) -> Option<Self> {
+        let caches = caches.filter(|_| mode.rdpeek);
+        if !mode.probe() && !mode.prefetch() {
+            return None
+        }
+        let txs = TX_RX.lock().take();
+        // EXP-183: the pool's busy peak of this block (threads still busy with the previous block's late readers count)
+        READER_POOL.busy_peak.store(READER_POOL.busy.load(Ordering::Relaxed), Ordering::Relaxed);
+        let (cs_tx, cs_rx) = crossbeam_channel::unbounded::<Item>();
+        let stop = Arc::new(AtomicBool::new(false));
+        // EXP-150: dropping `stop_tx` wakes every reader of the block at once (`rdstop=1`)
+        let (stop_tx, stop_rx) = crossbeam_channel::bounded::<()>(1);
+        let stats = PW_STATS.lock().clone().unwrap_or_default();
+        let pw_rx = PW_RX.lock().take();
+        // X-027: no mempool stage, so the block starts with an empty issued table (2.5.1: inherited from the stage)
+        let issued: Arc<Mutex<Issued>> = Arc::default();
+        *PROBE.lock() = Some((issued.clone(), stats.clone()));
+        PROBE_GEN.fetch_add(1, Ordering::Release);
+        if let Some(k) = KEYTRACE.lock().as_mut() {
+            k.block = info.number.saturating_to();
+        }
+        let threads = match factory.filter(|_| mode.prefetch()) {
+            // X-027: the dedicated readers of `ctr` (worker-side call records) and `csr` (execution-thread inspector) are not
+            // ported
+            Some(factory) => spawn_readers(
+                    "eap-read",
+                    mode,
+                    factory.clone(),
+                    info,
+                    &stats,
+                    &issued,
+                    cs_rx,
+                    pw_rx,
+                    txs,
+                    &stop,
+                    None,
+                    &stop_rx,
+                    caches,
+                ),
+            None => Vec::new(),
+        };
+        // EXP-160 (`sysk=1`): the slots the block-start system calls write, handed to the readers before execution starts
+        if mode.sysk && !threads.is_empty() {
+            for (a, keys) in sys_slots(&info) {
+                let _ = cs_tx.send(Item::Keys(Box::new((a, keys, u32::MAX, reth_execution_cache::CC_SRC_EAP_TX, rq_now()))));
+            }
+        }
+        // EXP-235 (`pl=1`): the block's recorded read list, handed to the readers before execution starts
+        if mode.pl && !threads.is_empty() {
+            pl_send(&cs_tx, &stats, pl_lists().get(&info.number.saturating_to::<u64>()).map(|k| &**k));
+        }
+        Some(Self {
+            mode,
+            number: info.number.saturating_to(),
+            cs_tx: Some(cs_tx),
+            stop,
+            stop_tx: Some(stop_tx),
+            threads,
+            stats,
+            started: Instant::now(),
+        })
+    }
+}
+
+/// Prologue (`rdasync`, `rddefer`, EXP-258): the block's [`BlockPrefetch`], possibly still being started on the helper
+/// thread. The execution thread holds it from the block's start; [`Self::stop_readers`] at the execution's end, and the
+/// drop (now, or after the root with `rddefer`) wait for the start to finish first.
+pub struct PendingPrefetch {
+    mode: Mode,
+    rx: Option<Receiver<Option<BlockPrefetch>>>,
+    pf: Option<BlockPrefetch>,
+}
+
+impl PendingPrefetch {
+    fn resolve(&mut self) -> Option<&mut BlockPrefetch> {
+        if let Some(rx) = self.rx.take() {
+            // Prologue (`rdkick`): a start job the converting thread never took (it stopped before sending the block's
+            // last transaction) is handed over here, so the wait below always ends
+            if self.mode.rdkick {
+                kick_reclaim();
+            }
+            self.pf = rx.recv().ok().flatten();
+        }
+        self.pf.as_mut()
+    }
+
+    /// The execution-thread inspector (`cs=1` only; waits for the start then, and returns at once otherwise).
+    pub fn exec_inspector(&mut self) -> Option<EapExecInspector> {
+        if !self.mode.cs {
+            return None
+        }
+        self.resolve()?.exec_inspector()
+    }
+
+    /// The readers are told to stop (the first part of the drop; the drop repeats it harmlessly).
+    pub fn stop_readers(&mut self) {
+        if let Some(p) = self.resolve() {
+            p.stop_readers();
+        }
+    }
+
+}
+
+/// Prologue (`rdasync`): the resident helper thread that runs the readers' starts in arrival order.
+static RDSTART: OnceLock<Sender<Box<dyn FnOnce() + Send>>> = OnceLock::new();
+
+/// Prologue (`rdasync`): hands `job` to the helper thread (created at the first call); runs it here when the helper
+/// cannot take it.
+fn rdstart(job: Box<dyn FnOnce() + Send>) {
+    let tx = RDSTART.get_or_init(|| {
+        let (tx, rx) = crossbeam_channel::unbounded::<Box<dyn FnOnce() + Send>>();
+        let _ = thread::Builder::new().name("eap-rdstart".into()).spawn(move || {
+            for job in rx {
+                job();
+            }
+        });
+        tx
+    });
+    if let Err(e) = tx.send(job) {
+        (e.0)();
+    }
+}
+
+/// Prologue (`ctlcache`, X-031): the control text `s` parsed, or, when its part after the leading `tag=N` is the same as
+/// the previous call's and that mode has `ctlcache`, the previous mode with tag `N`. A text without a leading `tag=` is
+/// always parsed and not kept.
+fn parse_ctl_cached(s: &str) -> Mode {
+    static CACHE: Mutex<Option<(String, Mode)>> = parking_lot::const_mutex(None);
+    let (tag, rest) = match s.split_once(char::is_whitespace) {
+        Some((t, r)) if t.starts_with("tag=") => (Some(t[4..].parse::<u64>().unwrap_or(0)), r),
+        _ => (None, s),
+    };
+    let mut cache = CACHE.lock();
+    if let (Some(tag), Some((text, m))) = (tag, cache.as_ref()) &&
+        m.ctlcache &&
+        text == rest
+    {
+        return Mode { tag: tag as u32, ..*m }
+    }
+    let m = Mode::parse(s);
+    *cache = tag.map(|_| (rest.to_string(), m));
+    m
+}
+
+/// Prologue (`prerel`): the resident helper thread that drops the previous block's per-block structures.
+static PREREL: OnceLock<Sender<Box<dyn FnOnce() + Send>>> = OnceLock::new();
+
+/// Prologue (`prerel`): hands `job` to the `eap-prerel` thread (created at the first call); runs it here when the helper
+/// cannot take it.
+fn prerel_drop(job: Box<dyn FnOnce() + Send>) {
+    let tx = PREREL.get_or_init(|| {
+        let (tx, rx) = crossbeam_channel::unbounded::<Box<dyn FnOnce() + Send>>();
+        let _ = thread::Builder::new().name("eap-prerel".into()).spawn(move || {
+            for job in rx {
+                job();
+            }
+        });
+        tx
+    });
+    if let Err(e) = tx.send(job) {
+        (e.0)();
+    }
+}
+
+/// Prologue (`rddefer`): a block's readers' drop was handed to the helper thread and the next block has not waited for
+/// it yet ([`wait_deferred_drops`]).
+static DEFER_PENDING: AtomicBool = AtomicBool::new(false);
+
+/// Prologue (`rddefer`): ends the block's readers. With `rddefer` the execution thread only tells them to stop and the
+/// helper thread drops them (in order after the block's own start); without, all here. `rddefer` needs `rdasync`: the
+/// next block's [`late_join`] waits for the helper, so the drop is done before that block joins and resets anything.
+pub fn end_prefetch(p: Option<PendingPrefetch>) {
+    match p {
+        Some(mut p) if p.mode.rddefer => {
+            p.stop_readers();
+            let prep = p.mode.prep && p.mode.rdjoinlate;
+            DEFER_PENDING.store(true, Ordering::Release);
+            rdstart(Box::new(move || drop(p)));
+            if prep {
+                PREP_DONE.store(false, Ordering::Release);
+                PREP_QUEUED.store(true, Ordering::Release);
+                rdstart(Box::new(prep_next_block));
+            }
+        }
+        p => drop(p),
+    }
+}
+
+/// Prologue (`prep`): a preparation was queued on the helper thread for the next block, not yet taken by its `refresh`.
+static PREP_QUEUED: AtomicBool = AtomicBool::new(false);
+/// Prologue (`prep`): the helper finished the queued preparation.
+static PREP_DONE: AtomicBool = AtomicBool::new(false);
+/// Prologue (`prep`): the preparation was done when the block's validation started (no wait for the helper).
+static PREP_READY_AT_JOIN: AtomicBool = AtomicBool::new(false);
+/// Prologue (`prep`): this block's state for the `eap xbtl2` line: 1 prepared in time, 0 waited for, -1 not prepared.
+pub static PREP_STATE: std::sync::atomic::AtomicI64 = std::sync::atomic::AtomicI64::new(-1);
+/// Prologue (`prep`): the next block's pre-execution channel and statistics, built on the helper thread.
+static PREP_PW: Mutex<Option<(Sender<Item>, Receiver<Item>, Arc<Stats>)>> = parking_lot::const_mutex(None);
+
+/// Prologue (`prep`): on the helper thread `eap-rdstart`, after the block's readers' drop: the late join of the readers,
+/// the release of the block's per-block structures and the reset of the index-extrapolation records (what `refresh`
+/// does otherwise), and the next block's pre-execution channel and statistics; then marks the preparation done.
+fn prep_next_block() {
+    late_join_inner();
+    let old = {
+        let mut txs = BLOCK_TXS.lock();
+        let cap = txs.capacity();
+        (TX_RX.lock().take(), std::mem::replace(&mut *txs, Vec::with_capacity(cap)), NB_SL_TX.lock().take())
+    };
+    drop(old);
+    ix::block_start();
+    let (s, r) = crossbeam_channel::unbounded();
+    *PREP_PW.lock() = Some((s, r, Arc::new(Stats::default())));
+    *PREP_TXCH.lock() = Some(crossbeam_channel::unbounded());
+    PREP_DONE.store(true, Ordering::Release);
+}
+
+/// Prologue (`rddefer`): when a readers' drop was handed to the helper thread, waits until the helper has done every
+/// job given to it so far (an empty job queued behind them), so the previous block's hand-off and block-end statistics
+/// are done before the caller goes on. Returns at once otherwise.
+pub fn wait_deferred_drops() {
+    // Prologue (`prep`): the preparation is the helper's last job of the block, so when it is done every job before it
+    // is done too, and nothing is waited for
+    if PREP_QUEUED.load(Ordering::Acquire) && DEFER_PENDING.load(Ordering::Acquire) {
+        let done = PREP_DONE.load(Ordering::Acquire);
+        PREP_READY_AT_JOIN.store(done, Ordering::Release);
+        if done {
+            DEFER_PENDING.store(false, Ordering::Release);
+            return
+        }
+    }
+    if !DEFER_PENDING.swap(false, Ordering::AcqRel) {
+        return
+    }
+    let (tx, rx) = crossbeam_channel::bounded::<()>(1);
+    rdstart(Box::new(move || {
+        let _ = tx.send(());
+    }));
+    let _ = rx.recv();
+}
+
+impl BlockPrefetch {
+    /// Prologue (`rdasync`): [`Self::start`] on the helper thread when `rdasync` is on, here otherwise.
+    pub fn start_pending(
+        mode: Mode,
+        factory: Option<ProviderFactory>,
+        caches: Option<reth_execution_cache::ExecutionCache>,
+        info: BlockInfo,
+    ) -> PendingPrefetch {
+        if !(mode.rdasync || mode.exclean) {
+            return PendingPrefetch { mode, rx: None, pf: Self::start(mode, factory, caches, info) }
+        }
+        let (tx, rx) = crossbeam_channel::bounded(1);
+        if mode.rdkick && mode.tx {
+            // Prologue (`rdkick`): the converting thread hands the job over; it also drops the previous block's
+            // pre-execution structures, after the start
+            let old = KICK_OLD.lock().take();
+            let job: Box<dyn FnOnce() + Send> = Box::new(move || {
+                let _ = tx.send(Self::start(mode, factory, caches, info));
+                drop(old);
+            });
+            match kick_post(job) {
+                Ok(()) => KICK_STATE.store(1, Ordering::Relaxed),
+                Err(job) => {
+                    KICK_STATE.store(0, Ordering::Relaxed);
+                    rdstart(job);
+                }
+            }
+            return PendingPrefetch { mode, rx: Some(rx), pf: None }
+        }
+        rdstart(Box::new(move || {
+            let _ = tx.send(Self::start(mode, factory, caches, info));
+        }));
+        PendingPrefetch { mode, rx: Some(rx), pf: None }
+    }
+
+    /// The readers are told to stop: the stop flag, the frame channel and (`rdstop`) the stop channel. The drop does the
+    /// same first, so calling this before the drop changes nothing but the time.
+    fn stop_readers(&mut self) {
+        self.stop.store(true, Ordering::Relaxed);
+        self.cs_tx = None;
+        if self.mode.rdstop {
+            self.stop_tx = None;
+        }
+    }
+}
+
+impl Drop for BlockPrefetch {
+    fn drop(&mut self) {
+        let t_drop = Instant::now();
+        let wall = self.started.elapsed();
+        let probe = PROBE.lock().take();
+        PROBE_GEN.fetch_add(1, Ordering::Release);
+        self.stop.store(true, Ordering::Relaxed);
+        // EXP-174 (`pwlxrd`): extra readers still waiting for an extrapolation job see the stop flag and exit
+        let gate = LX_GATE.lock().take();
+        let lx_rd_open_us = gate.as_ref().map_or(0, |g| g.release());
+        // EXP-182: the extra readers spawned when the gate opened are joined with the others
+        if let Some(g) = &gate {
+            self.threads.extend(g.take_spawned());
+        }
+        self.cs_tx = None;
+        let busy_at_stop = self.stats.readers_busy.load(Ordering::Relaxed);
+        if self.mode.rdstop {
+            self.stop_tx = None;
+        }
+        // EXP-240 (`rdspawn`): the readers the helper created (waits until it has created them all; a reader created after
+        // the stop above exits at once)
+        if self.mode.rdspawn {
+            let t_wait = Instant::now();
+            let (mut lag_us, mut spawn_us) = (0, 0);
+            let threads = std::mem::take(&mut self.threads);
+            for t in threads {
+                match t {
+                    ReaderHandle::Spawning(rx) => {
+                        let (v, lag, spawn) = rx.recv().unwrap_or_default();
+                        (lag_us, spawn_us) = (lag, spawn);
+                        self.threads.extend(v);
+                    }
+                    t => self.threads.push(t),
+                }
+            }
+            info!(
+                target: "reth::eap",
+                block = self.number,
+                lag_us,
+                spawn_us,
+                wait_us = t_wait.elapsed().as_micros() as u64,
+                readers = self.threads.len(),
+                "eap rdspawn"
+            );
+        }
+        xbtl2::mark(xbtl2::DR_STOP);
+        let t_join = Instant::now();
+        let mut late_running = 0usize;
+        if self.mode.rdjoinlate {
+            // EXP-181: joined at the next block's start (`late_join`); the generation guard drops their late cache fills
+            late_running = self.threads.iter().filter(|t| !t.is_finished()).count();
+            let threads: Vec<_> = self.threads.drain(..).collect();
+            let mut g = LATE_JOIN.lock();
+            // a previous block's readers still pending (no next block started in between): join them first
+            if let Some((_, _, old)) = g.take() {
+                for t in old {
+                    t.join();
+                }
+            }
+            *g = Some((self.number, self.stats.clone(), threads));
+        } else {
+            for t in self.threads.drain(..) {
+                t.join();
+            }
+        }
+        let join_threads = t_join.elapsed();
+        xbtl2::mark(xbtl2::DR_JOIN);
+        // EXP-199 (`iqc`): the readers' slots by issue source and outcome (after the join, so no read is still running;
+        // with `rdjoinlate` the late readers' last reads are counted as unfinished)
+        if self.mode.iqc &&
+            let Some((issued, _)) = &probe
+        {
+            iqc_log(self.number, &issued.lock());
+        }
+        drop(probe);
+        if self.mode.srdiag {
+            // EXP-182: the drop up to the readers' join (or hand-off)
+            XB_TIMES[5].store(t_drop.elapsed().as_micros() as u64, Ordering::Relaxed);
+        }
+        let t_tail = Instant::now();
+        // EXP-105: the block's key trace (only the block it was started for)
+        let t_kt = Instant::now();
+        let k = KEYTRACE.lock().take_if(|k| k.block == self.number);
+        if let Some(k) = k {
+            kt_write(k);
+        }
+        let kt_us = t_kt.elapsed().as_micros() as u64;
+        // EXP-167: the call-count table (`cnt`, `pwmin`): codes counted so far and codes past this block's `pwmin`; only
+        // the `eap block` line reads them, so with `logq` the table is neither locked nor scanned
+        let (calls_codes, calls_ready) = if logq() {
+            (0, 0)
+        } else {
+            let g = CALLS.lock();
+            (g.len(), g.values().filter(|c| **c > self.mode.pwmin).count())
+        };
+        let s = &self.stats;
+        let g = |a: &AtomicU64| a.load(Ordering::Relaxed);
+        // EXP-199 round 3 (`ewbud`): the readers' time per backend read, for the runtime rates
+        crate::tree::eap_ew::note_reads(g(&s.read_ns), g(&s.reads));
+        // EXP-199 (`ewnear`): the block's counts, read once
+        let near_counts = crate::tree::eap_ew::near_counts();
+        // Prologue (`ixpf`): the index-key extrapolation's counts (0 when off)
+        let ixc = ix::counts();
+        eap_info!(
+            target: "reth::eap",
+            block = self.number,
+            tag = self.mode.tag,
+            cs = self.mode.cs,
+            tx = self.mode.tx,
