+    caller: Address,
+    origin: Address,
+    target: Address,
+    value: U256,
+    /// Call depth at the call-start hook: 0 for a transaction's outermost call.
+    depth: usize,
+    /// Issued from a prewarm worker (EXP-019).
+    pw: bool,
+    /// EXP-199 round 3 (`nbpl`): issued from the speculative pass (with `pw`; tagged with the pass's source)
+    nb: bool,
+    /// Block index of the prewarm worker's transaction (`u32::MAX` for execution-thread jobs).
