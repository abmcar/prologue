+/// EXP-158 (`bigra=N` in `EAP_CTRL`, set per block by the engine): before a value larger than one page is decoded, the
+/// whole page range it occupies in the memory map is advised with `MADV_WILLNEED`, so the kernel reads the remaining
+/// pages of the large value (contract code) in one round instead of one page fault per page (the map is opened with
+/// read-ahead off). 0 off; 1 every thread (node-level setting, the same for the original configuration); 2 only threads
+/// marked with [`set_thread_large_readahead`] (the access-plan readers: code reads guided by the plans and extrapolation).
+pub static LARGE_READAHEAD: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(0);
+
+thread_local! {
+    static READAHEAD_THREAD: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+/// EXP-158: marks the calling thread for `LARGE_READAHEAD` mode 2.
+pub fn set_thread_large_readahead(on: bool) {
+    READAHEAD_THREAD.with(|c| c.set(on));
+}
+
+unsafe extern "C" {
+    #[link_name = "madvise"]
+    fn sys_madvise(addr: *mut c_void, len: usize, advice: std::ffi::c_int) -> std::ffi::c_int;
+}
+
+/// Advises the pages of `val` with `MADV_WILLNEED` when [`LARGE_READAHEAD`] applies to this thread and the value spans
+/// more than one page.
+#[inline]
+fn large_readahead(val: &ffi::MDBX_val) {
+    const PAGE: usize = 4096;
+    if val.iov_len <= PAGE {
+        return
+    }
+    let m = LARGE_READAHEAD.load(std::sync::atomic::Ordering::Relaxed);
+    if m == 1 || (m == 2 && READAHEAD_THREAD.with(|c| c.get())) {
+        let start = val.iov_base as usize & !(PAGE - 1);
+        let end = (val.iov_base as usize + val.iov_len + PAGE - 1) & !(PAGE - 1);
+        // SAFETY: the range lies within the database's read-only shared map (the value points into it); madvise only
+        // hints the kernel and never changes the mapping's contents.
+        unsafe { sys_madvise(start as *mut c_void, end - start, 3 /* MADV_WILLNEED */) };
+    }
+}
