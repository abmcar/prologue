+/// Called by `eap_probe::EapProbe` (2.5.1) for every execution-thread storage read that missed
+/// the execution cache: counts whether the slot was predicted, and how far its read had got.
+pub fn probe_storage_miss(account: Address, key: B256) {
+    let t_probe = Instant::now();
+    let lite = PRLITE.load(Ordering::Relaxed);
+    let Some((issued, stats)) = (if lite { probe_cached() } else { PROBE.lock().clone() }) else { return };
+    probe_storage_miss_in(account, key, &issued, &stats, lite);
+    stats.probe_n.fetch_add(1, Ordering::Relaxed);
+    stats.probe_ns.fetch_add(t_probe.elapsed().as_nanos() as u64, Ordering::Relaxed);
+}
+
+/// Prologue (`prlite`): this thread's copy of [`PROBE`], refreshed only when [`PROBE_GEN`] changed.
+fn probe_cached() -> Option<(Arc<Mutex<Issued>>, Arc<Stats>)> {
+    type Cached = (u64, Option<(Arc<Mutex<Issued>>, Arc<Stats>)>);
+    thread_local!(static C: std::cell::RefCell<Cached> = const { std::cell::RefCell::new((u64::MAX, None)) });
+    let g = PROBE_GEN.load(Ordering::Acquire);
+    C.with(|c| {
+        let mut c = c.borrow_mut();
+        if c.0 != g {
+            *c = (g, PROBE.lock().clone());
+        }
+        c.1.clone()
+    })
+}
+
+fn probe_storage_miss_in(account: Address, key: B256, issued: &Arc<Mutex<Issued>>, stats: &Arc<Stats>, lite: bool) {
+    let e = {
+        let tl = Instant::now();
+        let mut g = if lite {
+            match issued.try_lock() {
+                Some(g) => g,
+                None => {
+                    stats.probe_busy.fetch_add(1, Ordering::Relaxed);
+                    return
+                }
+            }
+        } else {
+            issued.lock()
+        };
+        stats.ex_lockw_ns.fetch_add(tl.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        let e = g.slots.get(&(account, key)).copied();
+        if e.is_none() && LIC.load(Ordering::Relaxed) {
+            g.missed.insert((account, key));
+        }
+        // EXP-033 (`claim=1`): the execution thread reads a queued slot itself, so a reader must not read it later
+        if CLAIM.load(Ordering::Relaxed) &&
+            let Some((0, src)) = e
+        {
+            g.slots.insert((account, key), (2, src));
+            stats.claimed.fetch_add(1, Ordering::Relaxed);
+        }
+        e
+    };
+    let st = e.map(|(s, _)| s);
+    // EXP-105: the miss and the key's state at that moment
+    kt(|k, t| k.misses.push((account, key, t, st.map_or(0, |s| s.min(2) + 1), fs_exec_current())));
+    let c = match st {
+        None => &stats.miss_unpred,
+        Some(0) => &stats.miss_queued,
+        Some(1) => &stats.miss_inflight,
+        Some(_) => &stats.miss_done,
+    };
+    c.fetch_add(1, Ordering::Relaxed);
+    if let Some((0 | 1, src)) = e {
+        stats.miss_late_src[src_index(src)].fetch_add(1, Ordering::Relaxed);
+    }
+    if st == Some(1) {
+        // a reader is reading this slot: wait for it (bounded) instead of reading the same pages again; the
+        // caller's own read then finds the pages in memory
+        let (t0, limit) = (Instant::now(), reth_execution_cache::inflight_wait());
+        while issued.lock().slots.get(&(account, key)).map(|(s, _)| *s) == Some(1) && t0.elapsed() < limit {
+            // EXP-199 (`exrt`): a real-time thread's yield would not let the reader run if it shares the core
+            if crate::tree::eap_ew::exec_rt_on() {
+                thread::sleep(Duration::from_micros(10));
+            } else {
+                thread::yield_now();
+            }
+        }
+        stats.join_wait_ns.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+    }
+}
+
+/// X-029 (Master 11-04, `ewinf` with `infprobe`): the execution thread's misses that found their slot in flight on
+/// another thread and waited for that read, by the slot's state among the block's slots handed to the readers at the
+/// miss: not handed out, queued, being read, read. Such a miss never reaches [`probe_storage_miss`] (the probe is below
+/// the execution cache). Counted by [`probe_inflight_join`]; taken and reset by [`inflight_log`] at every block, as the
+/// execution cache's in-flight counters.
+static INF_PROBE: [AtomicU64; 4] = [const { AtomicU64::new(0) }; 4];
+
+/// X-029 (Master 11-04): called by the execution cache ([`reth_execution_cache::set_inflight_join_hook`]) when an
+/// execution-thread miss finds its slot in flight on another thread and is about to wait for that read; counts the
+/// slot's state as [`probe_storage_miss`] classifies it, and does nothing else (no wait, no claim, no record of the
+/// miss).
+pub fn probe_inflight_join(account: Address, key: B256) {
+    let probe = PROBE.lock().clone();
+    let _ = count_inflight_join(probe, &INF_PROBE, account, key);
+}
+
+/// [`probe_inflight_join`] on a given probe and counters: the index counted (0 not handed out, 1 queued, 2 being read,
+/// 3 read), or none without a probe (no block being executed).
+fn count_inflight_join(
+    probe: Option<(Arc<Mutex<Issued>>, Arc<Stats>)>,
+    counts: &[AtomicU64; 4],
+    account: Address,
+    key: B256,
+) -> Option<usize> {
+    let (issued, _) = probe?;
+    let i = match issued.lock().slots.get(&(account, key)).map(|(s, _)| *s) {
+        None => 0,
+        Some(0) => 1,
+        Some(1) => 2,
+        Some(_) => 3,
+    };
+    counts[i].fetch_add(1, Ordering::Relaxed);
+    Some(i)
+}
+
+/// X-029: the counts of [`count_inflight_join`] since the last call; resets them.
+fn take_inflight_counts(counts: &[AtomicU64; 4]) -> [u64; 4] {
+    [0usize, 1, 2, 3].map(|i| counts[i].swap(0, Ordering::Relaxed))
+}
+
+/// EXP-199 (final ablation, Master 11-02): the previous block of [`sched_block`] and the running total of victim-cache
+/// hits at its start; returns that block and its hits once a block has been seen, and records `number` and `total` for
+/// the next call.
+fn sched_prev(prev: &Mutex<Option<(u64, u64)>>, number: u64, total: u64) -> Option<(u64, u64)> {
+    prev.lock().replace((number, total)).map(|(block, t0)| (block, total.wrapping_sub(t0)))
+}
+
+/// EXP-199 (final ablation, Master 11-02): one `eap sched` line per block in every configuration with a control file,
+/// whatever its plans (the `eap block` line is logged by the block's readers, so a block without readers has none).
+/// Called by the engine thread right before [`refresh`] for the block that starts now (`number`), it logs the previous
+/// block: its scheduling and read-path switches (still in force: `refresh` has not run yet) and what they did, read
+/// before `refresh` resets them: the execution thread's real-time state and the refused changes so far (`exrt`), the
+/// near workers' priority in force and their raises, refused raises, changes back and microseconds raised (`ewnear`),
+/// the slice the execution thread last set for itself (`exslice`), the core reserved for it (`ewcore`, `excore`; -1:
+/// none), the code lookups the victim cache served from that block's start to now (`ccv`; from a running total, so
+/// the `eap block` line taking its own counter does not change it) and, after these, the I/O class the execution thread
+/// set for itself (`exio`), then the `exphys` switch with the SMT siblings it removed from the mechanism's set, its
+/// fallback, the outcomes of the execution thread's pin and change back, and those of moving the thread `srrt` raised
+/// to the mechanism's set for the pin and back (all happen before this call, at the block's execution start and end).
+/// Logging only: nothing is set or reset.
+pub fn sched_block(number: u64) {
+    static PREV: Mutex<Option<(u64, u64)>> = parking_lot::const_mutex(None);
+    let Some((block, ccv_hits)) = sched_prev(&PREV, number, reth_execution_cache::code_victim_hits_total()) else {
+        return
+    };
+    let m = current();
+    if !m.active {
+        return
+    }
+    let (exrt_state, exrt_refused) = crate::tree::eap_ew::exec_rt_state();
+    let near = crate::tree::eap_ew::near_counts();
+    let phys = crate::tree::eap_ew::exphys_state();
+    eap_info!(
+        target: "reth::eap",
+        block,
+        exrt = m.exrt,
+        exrt_state,
+        exrt_refused,
+        ewnear = m.ewnear,
+        ewnear_prio = crate::tree::eap_ew::near_prio(),
+        ewnear_raised = near[0],
+        ewnear_refused = near[1],
+        ewnear_back = near[2],
+        ewnear_us = near[3],
+        exslice = m.exslice,
+        exslice_set = crate::tree::eap_ew::exec_slice_set(),
+        ewcore = m.ewcore,
+        excore = m.excore,
+        core_reserved = crate::tree::eap_ew::exec_core_reserved().map_or(-1, |c| c as i64),
+        ewpool = m.ewpool,
+        ccv = m.ccv,
+        ccv_hits,
+        exio = m.exio,
+        exio_state = crate::tree::eap_ew::exec_io_state(),
+        exphys = m.exphys,
+        exphys_sib = phys.siblings,
+        exphys_fb = phys.fallback,
+        exphys_pin = phys.pin,
+        exphys_back = phys.back,
+        exphys_sr = phys.sr,
+        exphys_sr_back = phys.sr_back,
+        "eap sched"
+    );
+}
+
+/// EXP-232 (`accflt`): the block whose execution starts now (called right after `refresh`). Logs the `eap accflt` line
+/// of the previous block, with the filter's counters since that block started (lookups by its execution and prewarm
+/// threads; insertions by the persistence thread, which writes earlier blocks meanwhile), when a filter file was given.
+/// `accflt` and `accfltchk` are the previous block's; `valid` is read now. The switch is process-wide, so RPC and
+/// pipeline lookups through the latest state in that interval are counted (and filtered) too. EXP-240: a previous block
+/// with `accwarm` also gets an `eap accwarm` line with the warm queue's counters (the `eap accflt` line keeps 2.5.1's
+/// keys).
+pub fn accflt_block(number: u64) {
+    static PREV: Mutex<Option<(u64, bool, u64, bool)>> = parking_lot::const_mutex(None);
+    if std::env::var_os("EAP_ACCFILTER").is_none() {
+        return
+    }
+    let m = current();
+    let (valid, on) = reth_provider::acc_filter::state();
+    let c = reth_provider::acc_filter::take_counters();
+    if let Some((block, used, chk, warm)) =
+        PREV.lock().replace((number, on, if on { m.accfltchk } else { 0 }, on && m.accwarm))
+    {
+        eap_info!(
+            target: "reth::eap",
+            block,
+            accflt = used,
+            accfltchk = chk,
+            valid,
+            lookups = c.lookups,
+            absent = c.absent,
+            false_positive = c.false_positive,
+            inserts = c.inserts,
+            checks = c.checks,
+            check_mismatch = c.check_mismatch,
+            inserted_total = reth_provider::acc_filter::inserted_total(),
+            load_us = reth_provider::acc_filter::load_us(),
+            "eap accflt"
+        );
+        if warm {
+            eap_info!(
+                target: "reth::eap",
+                block,
+                warm_queued = c.warm_queued,
+                warm_dropped = c.warm_dropped,
+                warm_reads = c.warm_reads,
+                warm_err = c.warm_err,
+                "eap accwarm"
+            );
+        }
+    }
+}
+
+/// EXP-240 (`srwk`): set once a block of this process used `srwk`; until then [`peek_srwk`] reads nothing.
+static SRWK_SEEN: AtomicBool = AtomicBool::new(false);
+
+/// EXP-240 (`srwk`): whether the block about to be validated uses the whole proof worker pools. The state-root job is
+/// prepared before [`refresh`] reads this block's `EAP_CTRL`, so the file is read here as well (only once some block used
+/// the switch: a run without it reads nothing, and the first block that turns it on keeps reth's counts).
+pub fn peek_srwk() -> bool {
+    if !SRWK_SEEN.load(Ordering::Relaxed) {
+        return false
+    }
+    std::env::var_os("EAP_CTRL").and_then(|path| std::fs::read_to_string(path).ok()).is_some_and(|s| Mode::parse(&s).srwk)
+}
+
+/// EXP-240 (`srtl`): the proof worker counts (storage, account) of the block being validated.
+static SRTL_WORKERS: AtomicU64 = AtomicU64::new(0);
+
+/// EXP-240 (`srtl`): records the proof worker counts the state-root job of the block uses.
+pub fn srtl_workers(storage: usize, account: usize) {
+    SRTL_WORKERS.store(((storage as u64) << 32) | (account as u64 & 0xffff_ffff), Ordering::Relaxed);
+}
+
+/// Reads `EAP_CTRL` for the next block. Called once per block before the payload processor starts.
+pub fn refresh() -> Mode {
+    // X-027: the state-root boost (`srboost`, EXP-199) is not ported (eap_ew.rs), so no boost is left open here
+    // EXP-181 (`rdjoinlate`): the previous block's readers are joined here, before this block's mode, key trace,
+    // statistics and gate are set up, so a late reader can never see or change this block's state
+    late_join();
+    xbtl2::mark(xbtl2::RF_JOIN);
+    // X-027: the proof-hint counters (`srh`) and the mempool stage (`mp`) are not ported
+    BLOCKS.fetch_add(1, Ordering::AcqRel);
+    let m = match std::env::var_os("EAP_CTRL") {
+        None => Mode::OFF,
+        Some(path) => {
+            start_loading_plans();
+            match std::fs::read_to_string(&path) {
+                Ok(s) => parse_ctl_cached(&s),
+                Err(err) => {
+                    warn!(target: "reth::eap", %err, "cannot read EAP_CTRL, prefetch off");
+                    Mode { active: true, ..Mode::OFF }
+                }
+            }
+        }
+    };
+    // Prologue (`reusefb`) unit tests: a test's control line replaces `EAP_CTRL`
+    #[cfg(test)]
+    let m = CTRL_FOR_TEST.lock().as_deref().map_or(m, Mode::parse);
+    *MODE.lock() = m;
+    xbtl2::mark(xbtl2::RF_READ);
+    if m.active && m.srwk {
+        SRWK_SEEN.store(true, Ordering::Relaxed);
+    }
+    // EXP-240 (`srtl`): the proof-job timeline of this block, reset before its state-root task receives anything
+    reth_trie_parallel::proof_task::srtl::begin_block(m.active && m.srtl);
+    // Prologue (`hashpre`): the sparse-trie task's timed pre-computation of subtrie hashes for this block
+    HASHPRE_US.store(if m.active { m.hashpre } else { 0 }, Ordering::Relaxed);
+    // Prologue (`srbatch`): the sparse-trie task's streaming applications for this block
+    SRBATCH.store(if m.active { m.srbatch } else { 0 }, Ordering::Relaxed);
+    // Prologue (`logq`): whether this block's per-block `eap` info lines are left out
+    LOGQ.store(m.active && m.logq, Ordering::Relaxed);
+    // Prologue (`drainnopre`, `srrt`): the sparse-trie task's drain and the priority of its thread for this block
+    DRAIN_NOPRE.store(m.active && m.drainnopre, Ordering::Relaxed);
+    // Prologue (`srlate`): the sparse-trie task's classification of the late proof targets (with `srtl` only)
+    SRLATE.store(m.active && m.srlate && m.srtl, Ordering::Relaxed);
+    SRRT.store(if m.active { m.srrt } else { 0 }, Ordering::Relaxed);
+    // EXP-240 (`srmk`): the finish marker's way through the state-root pipeline, counting only
+    reth_trie_parallel::proof_task::srmk::begin_block(m.active && m.srmk);
+    // EXP-240 (`srpf`): the page prefetch of this block's proof jobs (0: nothing offered)
+    reth_trie_parallel::proof_task::srpf::set_thread_init(srpf_thread_init);
+    reth_trie_parallel::proof_task::srpf::begin_block(if m.active { m.srpf as usize } else { 0 }, m.active && m.srpfmk);
+    // EXP-232 (`accflt`): whether this block's latest-state account lookups consult the filter
+    reth_provider::acc_filter::set_use(m.active && m.accflt);
+    reth_provider::acc_filter::set_check_every(if m.active && m.accflt { m.accfltchk } else { 0 });
+    // EXP-240 (`accwarm`): also empties the queue the previous block left
+    reth_provider::acc_filter::set_warm(m.active && m.accflt && m.accwarm);
+    // EXP-210 (`ewlf` bit 16): a new mode generation invalidates every thread's copy; the copies are used only with the bit
+    MODE_GEN.fetch_add(1, Ordering::Release);
+    MODE_COPIED.store(m.active && m.ewlf & EWLF_MODE != 0, Ordering::Relaxed);
+    // EXP-210 (`ewlf` bit 2): in-flight reads announced in per-thread cells
+    reth_execution_cache::inflight_set_cells(m.active && m.ewlf & EWLF_INFLIGHT != 0);
+    // EXP-199 (`iqc`): the execution thread records its storage lookups of this block
+    reth_execution_cache::iqc_enable(m.active && m.iqc);
+    // EXP-235 (`plrec`): the execution thread records its reads of this block
+    reth_execution_cache::plrec_enable(m.active && m.plrec);
+    // EXP-199 (`fpimp`): the plan solver of this block's instantiations
+    FPIMP.store(m.active && m.fpimp, Ordering::Relaxed);
+    // Prologue (`nocons`): the path conditions of this block's instantiations
+    NOCONS.store(m.active && m.nocons, Ordering::Relaxed);
+    // EXP-199 (`satcls`): the satisfying-set cache by class for this block's instantiations
+    SATCLS.store(m.active && m.satcls, Ordering::Relaxed);
+    // EXP-199 (`ewinf`): cache-filling reads mark their slots in flight, execution-thread misses join them
+    reth_execution_cache::inflight_enable(m.active && m.ewinf);
+    // Prologue (`infwait`): the bound of those joins and of the probe's wait for a reader's read (2 ms by default)
+    reth_execution_cache::inflight_set_wait_us(u64::from(m.infwait));
+    // Prologue (`exopt`, `fillopt`): which lookups of the execution cache do not write the bucket
+    reth_execution_cache::opt_get_set(m.active && m.exopt, m.active && m.fillopt);
+    // X-029 (`infprobe`, Master 11-04): with the switch, the joins are counted by the slot's state among the readers'
+    // slots (counting only); off, the join path calls nothing
+    let infprobe = m.active && m.ewinf && m.infprobe;
+    if infprobe {
+        reth_execution_cache::set_inflight_join_hook(probe_inflight_join);
+    }
+    reth_execution_cache::inflight_hook_enable(infprobe);
+    // EXP-210 (`pwru`, `lkprof`): counting only, set before the block's diagnostics and threads start
+    reth_execution_cache::pwru_enable(m.active && m.pwru);
+    reth_execution_cache::lkprof::enable(m.active && m.lkprof);
+    // EXP-199 (`ewcore`): set before the block's prewarm and reader threads start (`spawn_with_state_root_streams` calls
+    // this first); the CPU set is the calling thread's, the execution thread's
+    // EXP-199 (`excore`): the execution thread alone on one core during the block; first, so that `reserve_exec_core` takes
+    // the set the execution thread had before it was first pinned and the mechanism's threads leave the same core
+    // Prologue (`exphys`): before both, a pin whose execution end was not reached goes back, so both take the thread's
+    // own set; with the switch the reservation also leaves the core's SMT siblings and, without `excore`, the execution
+    // thread pins itself to the core at its execution start.
+    crate::tree::eap_ew::exphys_block_start();
+    crate::tree::eap_ew::excore_block_start(m.active && m.excore, m.active && m.excore && m.exsmt, u64::from(m.tag));
+    crate::tree::eap_ew::reserve_exec_core(m.active && (m.ewcore || m.excore), m.active && m.exphys, m.excore);
+    crate::tree::eap_ew::split_readers(if m.active { m.rdsplit } else { 0 });
+    // Prologue (`spin`, X-031 diagnostic): after the reservation, so the spin threads leave the execution core
+    crate::tree::eap_ew::spin_block(if m.active && m.spinus > 0 { m.spin } else { 0 }, m.spinus, m.spinwin);
+    // EXP-218 (`exslice`, `pwbatch`): applied by the execution thread at its block start and by each prewarm thread at
+    // the start of its block's work
+    crate::tree::eap_ew::set_sched(
+        if m.active { m.exslice } else { 0 },
+        if m.active { m.pwbatch } else { 0 },
+        if m.active { m.exrt } else { 0 },
+        m.active && m.exio,
+    );
+    // `refresh` runs on the engine thread, which executes the block: its slice follows the block's switch from here (also
+    // on paths that do not reach `execute_transactions`); the call at the execution start is then a no-op
+    crate::tree::eap_ew::apply_exec_slice();
+    // EXP-199 (`ewnear`): the own prewarm's workers near the execution thread at a real-time priority. A raised worker
+    // must not take the execution thread's core. With `excore` the execution thread is pinned to a core the other threads
+    // leave (`ewcore` alone does not pin it). Otherwise with `exrt`: the execution thread runs real-time too, so a worker
+    // at no higher priority is placed elsewhere when it wakes; a worker is then raised only while the execution thread
+    // actually runs real-time (from its execution start; not when `exrt` was refused). Without either, `ewnear` stays off.
+    let (near, needs_exrt) = if !m.active || m.ew == 0 || m.ewnear == 0 {
+        (0, false)
+    } else if m.excore {
+        (if m.exrt > 0 { m.ewnear.min(m.exrt) } else { m.ewnear }, false)
+    } else if m.exrt > 0 {
+        (m.ewnear.min(m.exrt), true)
+    } else {
+        static WARNED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+        if !WARNED.swap(true, Ordering::Relaxed) {
+            warn!(target: "reth::eap", ewnear = m.ewnear, "eap ewnear off: needs exrt or excore");
+        }
+        (0, false)
+    };
+    crate::tree::eap_ew::set_near(near, m.ewnearn, m.ewnearkeep, needs_exrt);
+    xbtl2::mark(xbtl2::RF_SET);
+    *KEYTRACE.lock() = (m.active && m.pwtrace).then(|| KeyTrace {
+        t0: Instant::now(),
+        block: 0,
+        would: HashMap::new(),
+        issued: HashMap::new(),
+        read: HashMap::new(),
+        dropped: HashMap::new(),
+        nb_issued: HashMap::new(),
+        nb_passes: Vec::new(),
+        misses: Vec::new(),
+        lx: HashMap::new(),
+        acct: HashMap::new(),
+    });
+    // Prologue (`prep`): the previous block's structures were released on the helper thread (after the wait in the late
+    // join when it had not finished); -1 when not prepared
+    let prepped = PREP_QUEUED.swap(false, Ordering::AcqRel);
+    PREP_STATE.store(if !prepped { -1 } else if PREP_READY_AT_JOIN.load(Ordering::Acquire) { 1 } else { 0 }, Ordering::Relaxed);
+    // Prologue (`prerel`): the previous block's per-block structures go to the helper thread to be dropped there
+    if !prepped && m.active && (m.prerel || m.exclean) {
+        let old = {
+            let mut txs = BLOCK_TXS.lock();
+            let cap = txs.capacity();
+            (
+                TX_RX.lock().take(),
+                std::mem::replace(&mut *txs, Vec::with_capacity(cap)),
+                NB_SL_TX.lock().take(),
+                PW_TX.lock().take(),
+                PW_RX.lock().take(),
+                PW_STATS.lock().take(),
+                PW_EXEC.lock().take(),
+            )
+        };
+        prerel_drop(Box::new(move || drop(old)));
+    }
+    if !prepped {
+        *TX_RX.lock() = None;
+        BLOCK_TXS.lock().clear();
+        *NB_SL_TX.lock() = None;
+        // Prologue (`ixpf`): the previous block's workers stop issuing; this block's counts and key budget start at 0
+        ix::block_start();
+    }
+    xbtl2::mark(xbtl2::RF_REL);
+    // EXP-110: the execution thread's transaction index must not carry over from the previous block
+    FS_EXEC.store(u32::MAX, Ordering::Relaxed);
+    reth_execution_cache::cc_diag_set_trace(m.active && m.trace);
+    // EXP-158: per-block switches of the storage layer, applied before the block's first read
+    reth_db::mdbx::LARGE_READAHEAD.store(if m.active { m.bigra } else { 0 }, Ordering::Relaxed);
+    // X-027: the BN254 GLV switch (`glv`) and `eap_zk::block_start` are not ported (Master 11-02: no GLV, nothing zk)
+    reth_execution_cache::CODE_VICTIM.store(m.active && m.ccv, Ordering::Relaxed);
+    let _ = reth_execution_cache::code_victim_hits_take();
+    CLAIM.store(m.active && m.claim, Ordering::Relaxed);
+    PRLITE.store(m.active && m.prlite, Ordering::Relaxed);
+    crate::tree::reuse::set_mode(
+        if m.active { m.reuse } else { 0 },
+        m.reusechk,
+        m.active && m.reusefast,
+        reuse_bal_on(&m),
+        if m.active { m.reusechkbg } else { 0 },
+        // `reusechkbg=2`: the checks' pool, with the prewarm workers' pools
+        m.ew > 0 && m.ewpool,
+        m.reusechkbgtail,
+    );
+    crate::tree::reuse::set_diag(m.active && m.reusediag);
+    crate::tree::reuse::set_bal_send(reuse_bal_on(&m) && m.reusebalsend);
+    LIC.store(m.active && m.lic, Ordering::Relaxed);
+    xbtl2::mark(xbtl2::RF_SW);
+    let need_pw = m.active && (m.pwcs > 0 || m.sd > 0 || m.sds > 0);
+    if prepped {
+        // Prologue (`prep`): the prepared channel and statistics swap in; the old ones are dropped on `eap-prerel`
+        let new = if need_pw {
+            PREP_PW.lock().take().or_else(|| {
+                let (s, r) = crossbeam_channel::unbounded();
+                Some((s, r, Arc::new(Stats::default())))
+            })
+        } else {
+            None
+        };
+        let old = (PW_TX.lock().take(), PW_RX.lock().take(), PW_STATS.lock().take(), PW_EXEC.lock().take());
+        if let Some((s, r, st)) = new {
+            *PW_TX.lock() = Some(s);
+            *PW_RX.lock() = Some(r);
+            *PW_STATS.lock() = Some(st);
+        }
+        // Prologue (`rdkick`): dropped by this block's readers' start job on the helper thread, without a wake-up here
+        let mut k = KICK_OLD.lock();
+        if m.active && m.rdkick && m.tx {
+            if let Some(prev) = k.replace(Box::new(old)) {
+                prerel_drop(Box::new(move || drop(prev)));
+            }
+        } else {
+            drop(k);
+            prerel_drop(Box::new(move || drop(old)));
+        }
+    } else if need_pw {
+        let (s, r) = crossbeam_channel::unbounded();
+        *PW_TX.lock() = Some(s);
+        *PW_RX.lock() = Some(r);
+        *PW_STATS.lock() = Some(Arc::new(Stats::default()));
+    } else {
+        *PW_TX.lock() = None;
+        *PW_RX.lock() = None;
+        *PW_STATS.lock() = None;
+    }
+    *PW_EXEC.lock() = None;
+    m
+}
+
+/// Configuration of the block being processed.
+pub fn current() -> Mode {
+    if MODE_COPIED.load(Ordering::Relaxed) {
+        // the generation is read before the mode, so a copy is never newer than its generation says: a mode set in
+        // between is copied under the old generation and copied again at the next call
+        let g = MODE_GEN.load(Ordering::Acquire);
+        let (cg, m) = MODE_COPY.with(|c| c.get());
+        if cg == g {
+            return m
+        }
+        let m = *reth_execution_cache::lkprof::lock(reth_execution_cache::lkprof::MODE, &MODE);
+        MODE_COPY.with(|c| c.set((g, m)));
+        return m
+    }
+    *reth_execution_cache::lkprof::lock(reth_execution_cache::lkprof::MODE, &MODE)
+}
+
+/// EXP-210 (`ewlf` bit 16): the generation of [`MODE`], advanced each time a mode is set, and whether threads read the
+/// mode from their own copy of the current generation.
+static MODE_GEN: AtomicU64 = AtomicU64::new(0);
+static MODE_COPIED: AtomicBool = AtomicBool::new(false);
+
+thread_local! {
+    /// EXP-210 (`ewlf` bit 16): this thread's copy of the mode and its generation (`u64::MAX`: none yet).
+    static MODE_COPY: std::cell::Cell<(u64, Mode)> = const { std::cell::Cell::new((u64::MAX, Mode::OFF)) };
+}
+
+/// EXP-087: whether a prewarm worker runs a transaction with this gas limit under the EAP inspector (`pwgas`).
+pub fn pw_inspect(gas_limit: u64) -> bool {
+    let m = current();
+    !m.active || gas_limit >= m.pwgas
+}
+
+/// EXP-120: reads `EAP_CTRL` without replacing the current mode (used before `refresh` for the next block).
+pub fn peek() -> Mode {
+    match std::env::var_os("EAP_CTRL") {
+        None => Mode::OFF,
+        Some(path) => std::fs::read_to_string(&path).map(|s| Mode::parse(&s)).unwrap_or(Mode::OFF),
+    }
+}
+
+fn start_loading_plans() {
+    LOAD.call_once(|| {
+        let Some(dir) = std::env::var_os("EAP_PLANS") else { return };
+        // EXP-199 (`satcls`): the lists are classed when a plan is analysed, so this is set before any plan is loaded
+        let sat_classes = std::env::var_os("EAP_SAT_CLASSES").is_some_and(|v| v == "1");
+        frame_plan::set_sat_classes(sat_classes);
+        // X-027 (on-demand loading): the cap of the loaded plans in MB (default 5120) and the old full preload
+        let cap_mb = std::env::var("EAP_PLAN_CACHE_MB").ok().and_then(|v| v.parse::<usize>().ok()).unwrap_or(5120);
+        let preload = std::env::var_os("EAP_PLAN_PRELOAD").is_some_and(|v| v == "1");
+        let _ = thread::Builder::new().name("eap-plans".into()).spawn(move || {
+            let _ = PLANS.set(PlanStore::open(std::path::Path::new(&dir), cap_mb, preload, PLAN_LOADERS));
+        });
+    });
+}
+
+/// X-027: loader threads of the on-demand plan table.
+const PLAN_LOADERS: usize = 2;
+
+/// EXP-199 round 3 (as eap-x201): whether a plan has call records, the groups without a loop index (version 2) or the
+/// loop-indexed family groups (version 3); `Scratch::instantiate_calls` evaluates both.
+fn plan_has_calls(p: &Plan) -> bool {
+    !p.cgroups.is_empty() || !p.fcgroups.is_empty()
+}
+
+fn plans() -> Option<&'static PlanStore> {
+    PLANS.get().map(|s| &**s)
+}
