+/// EXP-129 fifth segment: writes one JSON line per pass to `EAP_NBDUMP` with the pass's reads and takes them.
+pub fn nb_dump_pass(block: u64, tx: u32, level: u8, ok: bool, steps: u64, reason: u8) {
+    if !nb_dump() {
+        return
+    }
+    let reads = NB_READS.with(|r| std::mem::take(&mut *r.borrow_mut()));
+    let Some(path) = std::env::var_os("EAP_NBDUMP") else { return };
+    use std::fmt::Write as _;
+    let mut out = String::with_capacity(64 + reads.len() * 180);
+    let _ = write!(out, "{{\"block\":{block},\"tx\":{tx},\"level\":{level},\"ok\":{},\"steps\":{steps},\"reason\":{reason},\"reads\":[", ok as u8);
+    for (i, (a, k, v, src, t)) in reads.iter().enumerate() {
+        let _ = write!(out, "{}[\"{a}\",\"{:#x}\",\"{:#x}\",{src},{t}]", if i > 0 { "," } else { "" }, k, v);
+    }
+    out.push_str("]}\n");
+    use std::io::Write as _;
+    if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+        let _ = f.write_all(out.as_bytes());
+    }
+}
