+/// The offset and length of the input of the KECCAK256 an interpreted frame is about to run, when `len_ok` accepts the
+/// length and the input lies inside the frame's memory as it stands before the instruction expands it (X-027: evm2's
+/// `Memory::slice` panics outside it; an input reaching past it is not taken).
+fn keccak_input<T: EvmTypes>(interp: &Interpreter<'_, '_, T>, len_ok: impl FnOnce(usize) -> bool) -> Option<(usize, usize)> {
+    let st = interp.stack();
+    let len = usize::try_from(st.peek(1)?).ok()?;
+    let off = usize::try_from(st.peek(0)?).ok()?;
+    (len_ok(len) && off.checked_add(len).is_some_and(|end| end <= interp.memory().len())).then_some((off, len))
+}
+
+/// The frame a call record starts, from the calling frame (CALLER `caller`, storage address `addr`, CALLVALUE `value`):
+/// (CALLER, storage address, CALLVALUE) of the callee. A DELEGATECALL (kind 2) runs the callee's code in the calling
+/// frame's context, with its caller and value; a CALLCODE (1) in the calling frame's storage, called by that frame; a
+/// CALL or STATICCALL at the target, called by the calling frame (the value of a CALL is not taken from the record: 0).
+/// X-023 (10-31): the call-record follows used the calling frame's address as CALLER for every kind, so through a proxy's
+/// DELEGATECALL the implementation's keys on msg.sender were computed for the proxy.
+fn callee_frame(kind: u8, caller: Address, addr: Address, value: U256, target: Address) -> (Address, Address, U256) {
+    match kind {
+        2 => (caller, addr, value),
+        1 => (addr, addr, value),
+        _ => (addr, target, U256::ZERO),
+    }
+}
+
+/// EXP-199 (`rdpeek`): of the slots `keys` of `a` about to be read, those to read, in their order: a slot a reader would
+/// read (queued, state 0, or not listed) is looked up in the execution cache `c` and left out when found there; it is then
+/// marked read (state 2) unless a reader took it meanwhile, and its read is recorded at once in the key trace
+/// (`pwtrace`). A slot being read (1) or read (2) is kept without a lookup (`slot` counts it as a repeat, as without the
+/// filter), so the cache sees no lookup taking a bucket's lock bit (a hit) that a reader would not have made. Counts the
+/// slots looked up and those left out.
+fn peek_filter(
+    c: &reth_execution_cache::ExecutionCache,
+    issued: &Mutex<Issued>,
+    stats: &Stats,
+    a: Address,
+    keys: &[U256],
+    src: u8,
+) -> Vec<U256> {
+    let look: Vec<bool> = {
+        let g = issued.lock();
+        keys.iter().map(|k| g.slots.get(&(a, B256::from(*k))).is_none_or(|s| s.0 == 0)).collect()
+    };
+    let mut kept = Vec::with_capacity(keys.len());
+    let mut hit = Vec::new();
+    let mut looked = 0u64;
+    for (k, l) in keys.iter().zip(look) {
+        let kk = B256::from(*k);
+        if l {
+            looked += 1;
+            if c.peek_storage(a, kk).is_some() {
+                hit.push(kk);
+                continue
+            }
+        }
+        kept.push(*k);
+    }
+    stats.rd_peek_keys.fetch_add(looked, Ordering::Relaxed);
+    if !hit.is_empty() {
+        stats.rd_peek_skip.fetch_add(hit.len() as u64, Ordering::Relaxed);
+        {
+            let mut g = issued.lock();
+            hit.retain(|kk| {
+                let st = g.slots.entry((a, *kk)).or_insert((0, src));
+                let mark = st.0 == 0;
+                if mark {
+                    st.0 = 2;
+                }
+                mark
+            });
+        }
+        if !hit.is_empty() {
+            kt(|kt, t| {
+                for kk in &hit {
+                    kt.read.entry((a, *kk)).or_insert((t, t));
+                }
+            });
+        }
+    }
+    kept
+}
+
+/// EXP-199 (`ctdedup`): keeps the first of a frame's resolved calls with the same kind, target and payload, in their order;
+/// returns how many were left out. With the calling frame fixed, the three give the same callee frame
+/// ([`callee_frame`]), account, code and plan keys.
+fn dedup_calls(calls: &mut Vec<frame_plan::CallOut>) -> usize {
+    if calls.len() < 2 {
+        return 0
+    }
+    let keep: Vec<bool> = {
+        let mut seen = HashSet::with_capacity(calls.len());
+        calls.iter().map(|c| seen.insert((c.kind, c.target, c.payload.as_deref()))).collect()
+    };
+    let n = calls.len();
+    let mut i = 0;
+    calls.retain(|_| {
+        i += 1;
+        keep[i - 1]
+    });
+    n - calls.len()
+}
+
+/// EXP-112 (`pwct=2`): [`Reader::follow_calls`] done on the prewarm worker itself through its EVM's database
+/// (storage values, accounts and code read by the worker); the callee plans' keys go to the readers as `Item::Keys`.
+/// X-027: `db` is the worker EVM's accepted-state overlay (revm's `db_mut()`), `origin` the transaction's sender.
+#[expect(clippy::too_many_arguments)]
+fn pw_follow_calls(
+    db: &mut dyn DynDatabase,
+    origin: Address,
+    tx: &Sender<Item>,
+    stats: &Arc<Stats>,
+    mode: &Mode,
+    info: &BlockInfo,
+    plan: &Plan,
+    input: &[u8],
+    caller: Address,
+    addr: Address,
+    value: U256,
+    cur: u32,
+    depth: u32,
+    exec_idx: &AtomicUsize,
+) {
+    if !plan_has_calls(plan) {
+        return
+    }
+    let bud_keys = mode.ew > 0 && mode.ewbud & EWB_KEYS != 0;
+    if mode.ctbudget > 0 && !bud_keys && stats.ct_keys_new.load(Ordering::Relaxed) >= mode.ctbudget {
+        stats.ct_drop.fetch_add(1, Ordering::Relaxed);
+        return
+    }
+    let t0 = Instant::now();
+    let src = reth_execution_cache::CC_SRC_EAP_CT;
+    stats.ct_jobs.fetch_add(1, Ordering::Relaxed);
+    let env = info.env(caller, origin, addr, value, input.len());
+    let sload_n = std::cell::Cell::new(0u64);
+    let calls = {
+        let ctx = std::cell::RefCell::new(&mut *db);
+        PW_SCRATCH.with(|sc| {
+            let mut sc = sc.borrow_mut();
+            let sc = scratch_for_block(&mut sc);
+            let want = mode.ctsl;
+            let sl = |k: U256| -> Option<U256> {
+                if !want {
+                    return None
+                }
+                sload_n.set(sload_n.get() + 1);
+                ctx.borrow_mut().get_storage(&addr, &k).ok()
+            };
+            sc.instantiate_calls(plan, &Frame { calldata: input, env, sload: Some(&sl) }, false);
+            stats.ct_fam_capped.fetch_add(u64::from(sc.c_family_capped), Ordering::Relaxed);
+            (std::mem::take(&mut sc.calls), std::mem::take(&mut sc.call_idx))
+        })
+    };
+    let (mut calls, call_idx) = calls;
+    stats.ct_sload.fetch_add(sload_n.get(), Ordering::Relaxed);
+    stats.ct_calls.fetch_add(calls.len() as u64, Ordering::Relaxed);
+    stats.ct_full.fetch_add(calls.iter().filter(|c| c.payload.is_some()).count() as u64, Ordering::Relaxed);
+    let fam = |i: usize| call_idx.get(i).is_some_and(|x| x.is_some());
+    stats.ct_fam.fetch_add((0..calls.len()).filter(|&i| fam(i)).count() as u64, Ordering::Relaxed);
+    stats.ct_fam_full.fetch_add((0..calls.len()).filter(|&i| fam(i) && calls[i].payload.is_some()).count() as u64, Ordering::Relaxed);
+    if mode.ctdedup {
+        stats.ct_dedup_skip.fetch_add(dedup_calls(&mut calls) as u64, Ordering::Relaxed);
+    }
+    if mode.ctpay {
+        let n = calls.len();
+        calls.retain(|c| c.payload.is_some());
+        stats.ct_nopay.fetch_add((n - calls.len()) as u64, Ordering::Relaxed);
+    }
+    let Some(plans) = plans() else { return };
+    // EXP-199 round 3 (`ctspread`): calls beyond the first N are resolved by the readers, not on this worker
+    let calls = ct_spread(calls, mode, stats, tx, caller, addr, origin, value, cur, depth);
+    for (ci, c) in calls.iter().enumerate() {
+        // `EWB_KEYS`: the calls of a transaction the execution thread has passed are dropped
+        if bud_keys && (cur as usize) < exec_idx.load(Ordering::Relaxed) {
+            stats.ct_drop.fetch_add((calls.len() - ci) as u64, Ordering::Relaxed);
+            break
+        }
+        // EXP-201 (`ctbudget`, `ctpay`, ported): as in Reader::follow_list
+        if mode.ctbudget > 0 && !bud_keys && stats.ct_keys_new.load(Ordering::Relaxed) >= mode.ctbudget {
+            stats.ct_drop.fetch_add((calls.len() - ci) as u64, Ordering::Relaxed);
+            break
+        }
+        if mode.ctpay && c.payload.is_none() {
+            stats.ct_nopay.fetch_add(1, Ordering::Relaxed);
+            continue
+        }
+        let target = Address::from_slice(&c.target.to_be_bytes::<32>()[12..]);
+        // the account read (code hash) and the code read go through the worker's own database
+        // counted only the first time this block (the worker reaches the callee's account anyway at the call)
+        let first = PROBE.lock().clone().is_some_and(|(issued, _)| issued.lock().accounts.insert(target));
+        let Ok(Some(acc)) = db.get_account(&target) else { continue };
+        if first {
+            stats.ct_acct.fetch_add(1, Ordering::Relaxed);
+        }
+        let h = acc.code_hash;
+        if h == KECCAK256_EMPTY {
+            continue
+        }
+        if acc.code.is_none() {
+            let _ = db.get_code_by_hash(&h);
+            if PROBE.lock().clone().is_some_and(|(issued, _)| issued.lock().codes.insert(h)) {
+                stats.ct_code.fetch_add(1, Ordering::Relaxed);
+            }
+        }
+        let Some(payload) = c.payload.as_ref() else { continue };
+        let mut h2 = h;
+        let mut p2 = plans.get(&h);
+        if let Some(p) = &p2 {
+            if p.kind == 1 {
+                let d = Address::from_slice(&p.delegate);
+                let hd = db.get_account(&d).ok().flatten().map(|a| a.code_hash).filter(|h| *h != KECCAK256_EMPTY);
+                p2 = hd.and_then(|hd| plans.get(&hd));
+                if let Some(hd) = hd {
+                    h2 = hd;
+                }
+            }
+        }
+        let Some(p2) = p2.filter(|p| p.kind == 0) else { continue };
+        if !compiled_peek(h2, mode.pwmin) {
+            continue
+        }
+        let (caller2, addr2, value2) = callee_frame(c.kind, caller, addr, value, target);
+        let env2 = info.env(caller2, origin, addr2, value2, payload.len());
+        stats.ct_plans.fetch_add(1, Ordering::Relaxed);
+        let keys = PW_SCRATCH.with(|sc| {
+            let mut sc = sc.borrow_mut();
+            let sc = scratch_for_block(&mut sc);
+            sc.instantiate(&p2, &Frame { calldata: payload, env: env2, sload: None });
+            sc.out.clone()
+        });
+        stats.ct_keys.fetch_add(keys.len() as u64, Ordering::Relaxed);
+        let mut keys = keys;
+        if let Some((issued, _)) = PROBE.lock().clone() {
+            let mut g = issued.lock();
+            keys.retain(|k| match g.slots.entry((addr2, B256::from(*k))) {
+                std::collections::hash_map::Entry::Occupied(_) => false,
+                std::collections::hash_map::Entry::Vacant(v) => {
+                    v.insert((0, src));
+                    true
+                }
+            });
+            for k in &keys {
+                note_issue(&g, stats, addr2, B256::from(*k), src);
+            }
+        }
+        stats.ct_keys_new.fetch_add(keys.len() as u64, Ordering::Relaxed);
+        let had_new = !keys.is_empty();
+        if !keys.is_empty() {
+            if mode.pwtrace {
+                kt(|k, t| {
+                    for key in &keys {
+                        k.issued.entry((addr2, B256::from(*key))).or_insert(t);
+                    }
+                });
+            }
+            let _ = tx.send(Item::Keys(Box::new((addr2, keys, cur, src, rq_now()))));
+        }
+        let deeper = if mode.ew > 0 && mode.ewbud & EWB_CTD != 0 { had_new && depth + 1 < CT_DEPTH_GUARD } else { depth + 1 < mode.ctd };
+        if deeper {
+            pw_follow_calls(db, origin, tx, stats, mode, info, &p2, payload, caller2, addr2, value2, cur, depth + 1, exec_idx);
+        }
+    }
+    if depth == 0 {
+        stats.ct_ns.fetch_add(t0.elapsed().as_nanos() as u64, Ordering::Relaxed);
+    }
+}
+
+/// EXP-174 (`pwlxrd`): the block's gate for the extra readers, opened by the first extrapolation job (EXP-177
+/// `pwlxrdacct`: by the N-th handed-out account).
+struct LxGate {
+    open: Mutex<bool>,
+    cv: parking_lot::Condvar,
+    t0: Instant,
+    /// microseconds after the gate was made at which it opened, plus 1 (0: never)
+    open_us: AtomicU64,
+    /// EXP-182: the extra readers are spawned when the gate opens (not at the block's start, where in a block whose gate
+    /// never opens they cost thread creation, provider builds and wake-ups); the spawner and the spawned threads
+    spawner: Mutex<Option<Box<dyn FnOnce() -> Vec<ReaderHandle> + Send>>>,
+    spawned: Mutex<Vec<ReaderHandle>>,
+    /// the block's stop flag: no extra reader is spawned once the block has stopped
+    stop: Arc<AtomicBool>,
+}
+
+impl LxGate {
+    fn new(stop: Arc<AtomicBool>) -> Self {
+        Self {
+            open: parking_lot::const_mutex(false),
+            cv: parking_lot::Condvar::new(),
+            t0: Instant::now(),
+            open_us: AtomicU64::new(0),
+            spawner: parking_lot::const_mutex(None),
+            spawned: parking_lot::const_mutex(Vec::new()),
+            stop,
+        }
+    }
+
+    fn open(&self) {
+        let first = {
+            let mut g = self.open.lock();
+            let first = !*g;
+            if first {
+                *g = true;
+                self.open_us.store(self.t0.elapsed().as_micros() as u64 + 1, Ordering::Relaxed);
+                self.cv.notify_all();
+            }
+            first
+        };
+        if first {
+            // the block's end sets the stop flag before it takes the spawned threads (under the same lock), so a spawn
+            // either lands before that and is joined, or sees the flag and does not happen
+            let mut sp = self.spawned.lock();
+            if !self.stop.load(Ordering::Relaxed) &&
+                let Some(f) = self.spawner.lock().take()
+            {
+                sp.extend(f());
+            }
+        }
+    }
+
+    /// The extra readers spawned when the gate opened (called at the block's end, after the stop flag is set).
+    fn take_spawned(&self) -> Vec<ReaderHandle> {
+        std::mem::take(&mut *self.spawned.lock())
+    }
+
+    /// Wakes every waiting reader (they then see the block's stop flag); returns when the gate opened (0: never).
+    fn release(&self) -> u64 {
+        let _g = self.open.lock();
+        self.cv.notify_all();
+        self.open_us.load(Ordering::Relaxed)
+    }
+
+    /// Waits until the gate opens (true) or the block stops (false).
+    fn wait(&self, stop: &AtomicBool) -> bool {
+        let mut g = self.open.lock();
+        loop {
+            if *g {
+                return true
+            }
+            if stop.load(Ordering::Relaxed) {
+                return false
+            }
+            self.cv.wait_for(&mut g, Duration::from_millis(5));
+        }
+    }
+}
+
+static LX_GATE: Mutex<Option<Arc<LxGate>>> = parking_lot::const_mutex(None);
