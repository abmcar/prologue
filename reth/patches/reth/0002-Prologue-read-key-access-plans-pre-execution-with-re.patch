+    /// EXP-199 (`ewnear`): a worker raises itself to SCHED_FIFO and goes back to the class and nice value it had (normal
+    /// and batch), also through the run guard; or the raise is refused (no RLIMIT_RTPRIO) and the thread stays as it was.
+    /// Uses the thread-local state only (the block's counts are shared with other tests).
+    #[test]
+    fn ewnear_raises_and_sets_back_or_is_refused() {
+        std::thread::spawn(|| {
+            // SAFETY: getpriority / sched_getscheduler / sched_setscheduler act on the calling thread only.
+            let nice = || unsafe { libc::getpriority(libc::PRIO_PROCESS, 0) };
+            let pol = || unsafe { libc::sched_getscheduler(0) } & !libc::SCHED_RESET_ON_FORK;
+            let pol0 = pol();
+            if pol0 != libc::SCHED_OTHER && pol0 != libc::SCHED_BATCH {
+                return
+            }
+            let nice0 = nice();
+            for batch in [false, true] {
+                if batch {
+                    // with the reset-on-fork flag: after a raise and the change back it stays set, and an unprivileged
+                    // thread may not clear it
+                    let p = libc::sched_param { sched_priority: 0 };
+                    let pol = libc::SCHED_BATCH | libc::SCHED_RESET_ON_FORK;
+                    assert_eq!(unsafe { libc::sched_setscheduler(0, pol, &p) }, 0);
+                }
+                let before = pol();
+                let state = near_raise(1);
+                if state < 0 {
+                    assert_eq!(pol(), before);
+                    assert_eq!(NEAR_SET.with(|c| c.get()), 0);
+                    return
+                }
+                assert_eq!(state, 1);
+                assert_eq!(pol(), libc::SCHED_FIFO);
+                if batch {
+                    // the guard of a watched run sets the thread back when dropped
+                    NEAR_TX.with(|c| c.set(7));
+                    drop(NearRun(true));
+                    assert_eq!(NEAR_TX.with(|c| c.get()), u32::MAX);
+                } else {
+                    assert!(near_back());
+                }
+                assert_eq!(pol(), before);
+                assert_eq!(nice(), nice0);
+                assert_eq!(NEAR_SET.with(|c| c.get()), 0);
+            }
+        })
+        .join()
+        .unwrap();
+    }
