+    pub tx: u32,
+}
+
+impl Item {
+    /// Block index of the transaction a prewarm-worker job belongs to (`u32::MAX` for other items).
+    fn pw_tx(&self) -> u32 {
+        match self {
+            Self::Frame(j) if j.pw => j.tx,
+            Self::Keys(k) => k.2,
+            Self::Follow(j) => j.tx,
+            Self::Lx(j) => j.tx,
+            Self::CtCalls(j) => j.tx,
+            _ => u32::MAX,
+        }
+    }
+}
+
+/// A prewarm-worker job in the readers' priority queue (`pwprio=1`): lowest transaction index first, then oldest.
+struct PwEntry(u32, u64, Item);
+
+impl PartialEq for PwEntry {
+    fn eq(&self, o: &Self) -> bool {
+        (self.0, self.1) == (o.0, o.1)
+    }
+}
+impl Eq for PwEntry {}
+impl PartialOrd for PwEntry {
+    fn partial_cmp(&self, o: &Self) -> Option<std::cmp::Ordering> {
+        Some(self.cmp(o))
+    }
+}
+impl Ord for PwEntry {
+    fn cmp(&self, o: &Self) -> std::cmp::Ordering {
+        // BinaryHeap is a max-heap: the smallest (tx, seq) must compare greatest
+        (o.0, o.1).cmp(&(self.0, self.1))
+    }
+}
