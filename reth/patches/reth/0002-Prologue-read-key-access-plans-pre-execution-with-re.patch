+/// Recording inspectors: a call (`kind` 0) or create (`kind` 1) frame starts on this thread. Frames are kept
+/// only on the execution thread inside a transaction and on a prewarm worker inside a transaction.
+#[expect(clippy::too_many_arguments)]
+pub fn diag_frame_start(
+    kind: u8,
+    depth: usize,
+    code: B256,
+    target: Address,
+    caller: Address,
+    value: U256,
+    input: &[u8],
+) {
+    if !cc_diag_trace() {
+        return
+    }
+    let role_tx = match DIAG_EXEC.with(|c| c.get()) {
+        Some((i, _)) if i != DIAG_PRE && i != DIAG_POST => Some((0u8, i)),
+        Some(_) => None,
+        None => {
+            let i = DIAG_PW_TX.with(|c| c.get());
+            (i != u32::MAX).then_some((1u8, i))
+        }
+    };
+    let Some((role, tx)) = role_tx else { return };
+    if DIAG_PW_SUPPRESS.with(|c| c.get()) {
+        return
+    }
+    let ts = diag_now_ns();
+    DIAG_FRAMES.with(|f| {
+        let mut f = f.borrow_mut();
+        let seq = f.len() as u32;
+        let parent = DIAG_STACK.with(|st| {
+            let mut st = st.borrow_mut();
+            let p = st.last().copied().unwrap_or(u32::MAX);
+            st.push(seq);
+            p
+        });
+        f.push(FrameRec {
+            role,
+            tx,
+            seq,
+            parent,
+            depth: depth as u16,
+            kind,
+            ts,
+            te: 0,
+            code,
+            target,
+            caller,
+            value,
+            input: input.to_vec(),
+        });
+    });
+}
+
+/// Recording inspectors: the innermost open frame on this thread ends.
+pub fn diag_frame_end() {
+    if !cc_diag_trace() || DIAG_PW_SUPPRESS.with(|c| c.get()) {
+        return
+    }
+    let Some(seq) = DIAG_STACK.with(|st| st.borrow_mut().pop()) else { return };
+    let te = diag_now_ns();
+    DIAG_FRAMES.with(|f| {
+        if let Some(r) = f.borrow_mut().get_mut(seq as usize) {
+            r.te = te;
+        }
+    });
+}
+
+#[inline]
+fn diag_cur_frame() -> u32 {
+    DIAG_STACK.with(|st| st.borrow().last().copied().unwrap_or(u32::MAX))
+}
+
+/// Execution-thread account (`kind` 0) or code (`kind` 2) read that missed the execution cache, started at `t0`.
+#[inline]
+fn diag_exec_other(kind: u8, id: B256, t0: u64) {
+    if DIAG_PATH.is_none() {
+        return
+    }
+    let dur = diag_now_ns().saturating_sub(t0);
+    DIAG_EXEC.with(|c| {
+        let Some((i, _)) = c.get() else { return };
+        let fr = diag_cur_frame();
+        DIAG_OTHER.with(|m| m.borrow_mut().push((i, t0, kind, id, dur, fr)));
+    });
+}
