+struct EwJob<Tx> {
+    heavy: bool,
+    /// order among the heavy transactions: the gas limit with `ewsort` (largest first), else 0 (block order)
+    prio: u64,
+    index: usize,
+    tx: Tx,
+    t: Instant,
+    /// `ewredo`: a redo run (not the transaction's first run; it leaves the diagnostics' per-transaction times alone)
+    redo: bool,
+    /// `ewredoq=1`: queued behind every job without it (a redo run waits until no first run is queued)
+    behind: bool,
