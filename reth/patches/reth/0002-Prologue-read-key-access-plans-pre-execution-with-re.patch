+/// Execution thread: transaction `i` finished; later lookups count as post-execution.
+pub fn cc_diag_exec_end(i: usize) {
+    if DIAG_PATH.is_some() {
+        let t = diag_now_ns();
+        diag_exec_flush_counters();
+        DIAG_EXEC.with(|c| c.set(Some((DIAG_POST, [0; 4]))));
+        if let Some(b) = diag_exec_block() {
+            b.push(DiagEv::ExecEnd { i: i as u32, t });
+        }
+    }
