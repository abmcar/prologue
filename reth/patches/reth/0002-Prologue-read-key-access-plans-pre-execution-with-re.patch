+        assert_eq!(reserved_core(Some(full), None), None);
+        assert_eq!(reserved_core(None, Some(others)), None);
+        assert_eq!(reserved_core(Some(full), Some(full)), None);
+        // a thread that never set its slice reports the kernel's default
+        assert_eq!(std::thread::spawn(exec_slice_set).join().unwrap(), 0);
