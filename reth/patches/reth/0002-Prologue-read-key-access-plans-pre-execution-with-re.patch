+/// Prologue (`exlead`, `leadlog`): the `eap lead` line of the block just executed.
+pub fn lead_log(block: u64) {
+    if !LEAD_ON.load(Ordering::Relaxed) {
+        return
+    }
+    let m = current();
+    if let Some((submitted, built, timeout, us)) = LEAD.snapshot(block) {
+        info!(
+            target: "reth::eap",
+            block,
+            exlead = m.exlead,
+            exleadus = m.exleadus,
+            submitted,
+            built,
+            timeout,
+            pw_req_us = us[LEAD_PW_REQ],
+            pw_start_us = us[LEAD_PW_START],
+            txs_start_us = us[LEAD_TXS_START],
+            submit_us = us[LEAD_SUBMIT],
+            built_us = us[LEAD_BUILT],
+            wait_us = us[LEAD_WAIT],
+            go_us = us[LEAD_GO],
+            "eap lead"
+        );
+    }
+}
