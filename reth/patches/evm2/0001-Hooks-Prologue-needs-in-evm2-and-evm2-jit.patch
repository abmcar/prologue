+// EngineAccessPlan (ported from revmc-x233 491378d): lookups through a non-observing handle.
+#[test]
+#[cfg(feature = "llvm")]
+fn unobserved_lookups_neither_count_nor_compile() {
+    let tb =
+        TestBackend::with_tuning_1w(RuntimeTuning { jit_hot_threshold: 1, ..Default::default() });
+    let unobserved = tb.with_observation(false);
+    assert!(tb.observes());
+    assert!(!unobserved.observes());
+
+    // Past the hot threshold many times over: no event, so nothing is counted or compiled.
+    for _ in 0..10 {
+        assert!(matches!(
+            unobserved.lookup(TestBackend::req_cancun(BYTECODE_RET42)),
+            LookupDecision::Unavailable(LookupMissReason::NotReady)
+        ));
+    }
+    std::thread::sleep(std::time::Duration::from_millis(200));
+    let stats = tb.stats();
+    assert_eq!((stats.lookup_hits, stats.lookup_misses), (0, 0));
+    assert_eq!(stats.compilations_dispatched, 0);
+    assert_eq!(stats.resident_entries, 0);
+    assert_eq!((stats.unobserved_hits, stats.unobserved_misses), (0, 10));
+
+    // Compiled through the observing handle, the unobserved one runs it.
+    tb.trigger_jit_cancun(BYTECODE_RET42);
+    assert!(matches!(
+        unobserved.lookup(TestBackend::req_cancun(BYTECODE_RET42)),
+        LookupDecision::Compiled(_)
+    ));
+    assert_eq!(tb.stats().unobserved_hits, 1);
+    assert!(unobserved.with_observation(true).observes());
+}
+
+// A non-observing handle of a blocking backend never blocks (and so never compiles).
+#[test]
+fn unobserved_lookup_on_blocking_backend_does_not_compile() {
+    let backend =
+        JitBackend::new(RuntimeConfig { enabled: true, blocking: true, ..RuntimeConfig::default() })
+            .unwrap();
+    let unobserved = backend.with_observation(false);
+    assert!(matches!(
+        unobserved.lookup(TestBackend::req_cancun(BYTECODE_RET42)),
+        LookupDecision::Unavailable(LookupMissReason::NotReady)
+    ));
+    assert_eq!(backend.stats().compilations_dispatched, 0);
+    assert_eq!(backend.stats().unobserved_misses, 1);
+}
