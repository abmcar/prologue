 #[auto_impl(&mut, Box)]
 pub trait Inspector<T: EvmTypesHost>: NonStaticAny {
+    /// Whether frames may run through the interpreter runner (compiled code) while this inspector
+    /// is attached.
+    ///
+    /// Defaults to `false`: every frame runs through the interpreter so that [`step`](Self::step)
+    /// and [`step_end`](Self::step_end) see each instruction. An inspector that returns `true`
