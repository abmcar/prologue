 use utils::*;
 pub use utils::{BuiltinError, BuiltinResult};
 
+#[cfg(feature = "std")]
+mod keccak_hook {
+    use core::{
+        cell::Cell,
+        sync::atomic::{AtomicBool, Ordering},
+    };
+
+    /// A callback that receives the input of every KECCAK256 that compiled code executes on the
+    /// thread it is set on.
+    pub type KeccakHook = fn(&[u8]);
+
+    /// Set once any thread installed a hook, so threads without one skip the thread-local lookup.
+    static ANY: AtomicBool = AtomicBool::new(false);
+
+    std::thread_local! {
+        static HOOK: Cell<Option<KeccakHook>> = const { Cell::new(None) };
+    }
+
+    /// Installs (`Some`) or removes (`None`) this thread's KECCAK256 input callback.
+    ///
+    /// Compiled code does not call an inspector's `step`, so an inspector that watches KECCAK256
+    /// inputs in the interpreter sees none in compiled frames; this callback is the compiled-code
+    /// counterpart. It is called with the hashed memory before the hash is computed, on the
+    /// executing thread. (EngineAccessPlan, ported from revmc-x233 4453f60.)
+    pub fn set_keccak_hook(hook: Option<KeccakHook>) {
+        if hook.is_some() {
+            ANY.store(true, Ordering::Relaxed);
+        }
+        HOOK.with(|h| h.set(hook));
+    }
+
+    #[inline]
+    pub(crate) fn call(data: &[u8]) {
+        if ANY.load(Ordering::Relaxed)
+            && let Some(hook) = HOOK.with(|h| h.get())
+        {
+            hook(data);
+        }
+    }
+}
+#[cfg(feature = "std")]
+pub use keccak_hook::{KeccakHook, set_keccak_hook};
+
+#[cfg(feature = "std")]
+mod balance_hook {
+    use alloy_primitives::Address;
+    use core::cell::Cell;
+
+    /// A callback that receives the address of every account whose balance compiled code reads on
+    /// the thread it is set on: BALANCE's operand, and the executing account for SELFBALANCE and
+    /// SELFDESTRUCT.
+    pub type BalanceHook = fn(Address);
+
+    std::thread_local! {
+        static HOOK: Cell<Option<BalanceHook>> = const { Cell::new(None) };
+    }
+
+    /// Installs (`Some`) or removes (`None`) this thread's balance-read callback.
+    ///
+    /// Compiled code does not call an inspector's `step`, so an inspector that records which
+    /// balances an execution observed sees no BALANCE or SELFBALANCE in compiled frames, and no
+    /// SELFDESTRUCT that fails after reading the balance (its gas depends on whether the contract
+    /// had value); this callback is the compiled-code counterpart. It is called on the executing
+    /// thread before the balance is read, so it also sees reads whose instruction then fails.
+    ///
+    /// Unlike the KECCAK256 callback there is no process-wide flag: a thread without a callback
+    /// pays one thread-local load per such instruction and touches no shared cache line.
+    /// (EngineAccessPlan, ported from revmc-x233 f3518f3.)
+    pub fn set_balance_hook(hook: Option<BalanceHook>) {
+        let _ = HOOK.try_with(|h| h.set(hook));
+    }
+
+    #[inline]
+    pub(crate) fn call(address: Address) {
+        if let Ok(Some(hook)) = HOOK.try_with(|h| h.get()) {
+            hook(address);
+        }
+    }
+}
+#[cfg(feature = "std")]
+pub use balance_hook::{BalanceHook, set_balance_hook};
+
