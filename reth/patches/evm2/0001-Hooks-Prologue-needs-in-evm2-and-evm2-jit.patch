diff --git a/crates/jit/runtime/src/evm2_evm.rs b/crates/jit/runtime/src/evm2_evm.rs
index 69e704bbd67f81e953a338f81ba4ef0abb4580f4..e5bc413dbe029e5c7a31ff1131b5df5cc4612fa4 100644
--- a/crates/jit/runtime/src/evm2_evm.rs
+++ b/crates/jit/runtime/src/evm2_evm.rs
@@ -252,6 +252,202 @@ mod tests {
         ]
     }
 
+    // EngineAccessPlan: an inspector that allows compiled frames keeps its message hooks while
+    // compiled code runs; one that does not (the default) forces the interpreter.
+    #[cfg(feature = "llvm")]
+    #[derive(Default)]
+    struct CountingInspector {
+        allow: bool,
+        calls: Vec<(Address, u16)>,
+        call_ends: usize,
+        steps: usize,
+    }
+
+    #[cfg(feature = "llvm")]
+    impl evm2::Inspector<BaseEvmTypes> for CountingInspector {
+        fn allows_compiled_frames(&self) -> bool {
+            self.allow
+        }
+        fn step(&mut self, _interp: &mut Interpreter<'_, '_, BaseEvmTypes>) {
+            self.steps += 1;
+        }
+        fn call(
+            &mut self,
+            _interp: &mut Interpreter<'_, '_, BaseEvmTypes>,
+            message: &mut evm2::interpreter::Message<BaseEvmTypes>,
+        ) -> Option<evm2::interpreter::MessageResult<BaseEvmTypes>> {
+            self.calls.push((message.destination, message.depth));
+            None
+        }
+        fn call_end(
+            &mut self,
+            _interp: &mut Interpreter<'_, '_, BaseEvmTypes>,
+            _message: &evm2::interpreter::Message<BaseEvmTypes>,
+            _result: &mut evm2::interpreter::MessageResult<BaseEvmTypes>,
+        ) {
+            self.call_ends += 1;
+        }
+    }
+
+    /// Runs a top-level call from `caller` (whose code CALLs `target`, which returns 0x42)
+    /// through `Host::execute_message` with `inspector` attached and a blocking JIT runner.
+    #[cfg(feature = "llvm")]
+    fn run_inspected_call(inspector: CountingInspector) -> (CountingInspector, Bytes, u64, u64) {
+        let target = Address::from([0x22; 20]);
+        let caller = Address::from([0x11; 20]);
+        let mut code = vec![op::PUSH1, 0x69, op::PUSH0, op::MSTORE];
+        code.extend([op::PUSH1, 0x20, op::PUSH0, op::PUSH0, op::PUSH0, op::PUSH0]);
+        push20(&mut code, target);
+        code.extend([
+            op::PUSH2, 0x27, 0x10, op::CALL, op::PUSH0, op::MLOAD, op::PUSH0, op::MSTORE,
+            op::PUSH1, 0x20, op::PUSH0, op::RETURN,
+        ]);
+        let mut database = InMemoryDB::default();
+        database.insert_account_info(
+            &caller,
+            AccountInfo::default().with_code(Bytecode::new_legacy(code.clone().into())),
+        );
+        database.insert_account_info(
+            &target,
+            AccountInfo::default()
+                .with_code(Bytecode::new_legacy(Bytes::copy_from_slice(BYTECODE_RET42))),
+        );
+        let backend = blocking_backend();
+        let mut host = Evm::<BaseEvmTypes>::new(
+            SpecId::CANCUN,
+            BlockEnvExt::default(),
+            ethereum_tx_registry(SpecId::CANCUN),
+            database,
+            Precompiles::base(SpecId::CANCUN),
+        );
+        host.set_interpreter_runner(JitInterpreterRunner::new(backend.clone()));
+        host.set_inspector(inspector);
+        let tx_env = TxEnvExt::default();
+        let mut message = MessageExt {
+            gas_limit: 1_000_000,
+            destination: caller,
+            code_address: caller,
+            code: Bytecode::new_legacy(code.into()),
+            ..MessageExt::default()
+        };
+        let result = Host::execute_message(&mut host, &tx_env, &mut message).unwrap();
+        assert_eq!(result.stop, InstrStop::Return);
+        let output = Bytes::copy_from_slice(&result.output);
+        let gas = result.gas.spent();
+        let compiled = backend.stats().compilations_succeeded;
+        let inspector = host.clear_inspector_as::<CountingInspector>().unwrap();
+        (*inspector, output, gas, compiled)
+    }
+
+    #[test]
+    #[cfg(feature = "llvm")]
+    fn inspector_allowing_compiled_frames_keeps_message_hooks() {
+        let (compiled, out_c, gas_c, n_c) =
+            run_inspected_call(CountingInspector { allow: true, ..Default::default() });
+        let (interp, out_i, gas_i, n_i) = run_inspected_call(CountingInspector::default());
+        // Same result either way.
+        assert_eq!(out_c, out_i);
+        assert_eq!(out_c[31], 0x42);
+        assert_eq!(gas_c, gas_i);
+        // Both inspectors see the top-level and the nested call, with their ends.
+        let target = Address::from([0x22; 20]);
+        assert_eq!(compiled.calls.len(), 2);
+        assert_eq!(compiled.calls, interp.calls);
+        assert_eq!(compiled.calls[1].0, target);
+        assert_eq!(compiled.call_ends, 2);
+        assert_eq!(interp.call_ends, 2);
+        // Compiled frames call no step hook; the default inspector forced the interpreter.
+        assert!(n_c >= 2, "both frames compiled, got {n_c}");
+        assert_eq!(compiled.steps, 0);
+        assert_eq!(n_i, 0, "the default inspector never reaches the runner");
+        assert!(interp.steps > 0);
+    }
+
+    // EngineAccessPlan (ported from revmc-x233 4453f60 / f3518f3): the KECCAK256 input and
+    // balance-read callbacks of compiled code.
+    #[cfg(feature = "llvm")]
+    std::thread_local! {
+        static KEC_SEEN: std::cell::RefCell<Vec<Vec<u8>>> = const { std::cell::RefCell::new(Vec::new()) };
+        static BAL_SEEN: std::cell::RefCell<Vec<Address>> = const { std::cell::RefCell::new(Vec::new()) };
+    }
+
+    #[cfg(feature = "llvm")]
+    fn kec_hook(data: &[u8]) {
+        KEC_SEEN.with(|v| v.borrow_mut().push(data.to_vec()));
+    }
+
+    #[cfg(feature = "llvm")]
+    fn bal_hook(address: Address) {
+        BAL_SEEN.with(|v| v.borrow_mut().push(address));
+    }
+
+    #[test]
+    #[cfg(feature = "llvm")]
+    fn compiled_keccak_and_balance_reads_reach_thread_hooks() {
+        use evm2_jit_builtins::{set_balance_hook, set_keccak_hook};
+        let me = Address::from([0x11; 20]);
+        let other = Address::from([0x33; 20]);
+        let heir = Address::from([0x44; 20]);
+        // MSTORE8 0xab at 0; KECCAK256(0, 1); BALANCE(other); SELFBALANCE; SELFDESTRUCT(heir)
+        let mut code = vec![op::PUSH1, 0xab, op::PUSH0, op::MSTORE8];
+        code.extend([op::PUSH1, 1, op::PUSH0, op::KECCAK256, op::POP]);
+        push20(&mut code, other);
+        code.extend([op::BALANCE, op::POP, op::SELFBALANCE, op::POP]);
+        push20(&mut code, heir);
+        code.push(op::SELFDESTRUCT);
+        let run = |with_jit: bool| {
+            let mut database = InMemoryDB::default();
+            database.insert_account_info(&me, AccountInfo::default().with_balance(Word::from(7)));
+            database.insert_account_info(&other, AccountInfo::default());
+            let backend = blocking_backend();
+            let mut host = Evm::<BaseEvmTypes>::new(
+                SpecId::CANCUN,
+                BlockEnvExt::default(),
+                ethereum_tx_registry(SpecId::CANCUN),
+                database,
+                Precompiles::base(SpecId::CANCUN),
+            );
+            let tx_env = TxEnvExt::default();
+            let message = MessageExt {
+                gas_limit: 1_000_000,
+                destination: me,
+                code_address: me,
+                code: Bytecode::new_legacy(code.clone().into()),
+                ..MessageExt::default()
+            };
+            let mut interpreter = Interpreter::<BaseEvmTypes>::new(&tx_env, &message);
+            if with_jit {
+                run_interpreter(&backend, &mut interpreter, &mut host).unwrap()
+            } else {
+                interpreter.run(&mut host).unwrap()
+            }
+        };
+        set_keccak_hook(Some(kec_hook));
+        set_balance_hook(Some(bal_hook));
+        // The interpreter does not call the hooks (it has the inspector's step for that).
+        assert_eq!(run(false), InstrStop::SelfDestruct);
+        assert!(KEC_SEEN.with(|v| v.borrow().is_empty()));
+        assert!(BAL_SEEN.with(|v| v.borrow().is_empty()));
+        assert_eq!(run(true), InstrStop::SelfDestruct);
+        assert_eq!(KEC_SEEN.with(|v| v.take()), vec![vec![0xab]]);
+        assert_eq!(BAL_SEEN.with(|v| v.take()), vec![other, me, me]);
+        // Removed hooks are not called.
+        set_keccak_hook(None);
+        set_balance_hook(None);
+        assert_eq!(run(true), InstrStop::SelfDestruct);
+        assert!(KEC_SEEN.with(|v| v.borrow().is_empty()));
+        assert!(BAL_SEEN.with(|v| v.borrow().is_empty()));
+        // Another thread without hooks is unaffected by this thread's.
+        set_keccak_hook(Some(kec_hook));
+        std::thread::scope(|s| {
+            s.spawn(|| {
+                assert_eq!(run(true), InstrStop::SelfDestruct);
+                assert!(KEC_SEEN.with(|v| v.borrow().is_empty()));
+            });
+        });
+        set_keccak_hook(None);
+    }
+
     #[test]
     fn disabled_backend_falls_back_to_interpreter() {
         let tx_env = TxEnvExt::default();
