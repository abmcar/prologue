+    /// sends nested messages and logs through the host. Frames the runner declines still run in
+    /// the interpreter with every hook. (EngineAccessPlan: the behaviour revmc had in reth 2.5.1.)
+    #[inline]
+    fn allows_compiled_frames(&self) -> bool {
